+        api: { type: "openai-responses", baseUrl: "https://api.openai.com/v1" },
+      },
+    };
+  const fetcher = vi.fn<typeof fetch>();
+  const merge = vi.fn(async (input: { assertCurrent: () => void }) => {
+    input.assertCurrent();
+  });
+  const auth = vi.fn(async () => ({ apiKey: "fixture-token" }));
+  const owner = createProviderModelDiscovery({
