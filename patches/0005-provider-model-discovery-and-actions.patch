new file mode 100644
index 0000000000000000000000000000000000000000..4d3c9b45b9b652231ae107cfccb766e7a9fb02eb
--- /dev/null
+++ b/packages/services/src/provider-model-discovery/directory.ts
@@ -0,0 +1,208 @@
+import type { ModelConfigObject, ProviderConfigObject } from "@zcode/provider";
+import { modelConfigDataSchema } from "@zcode/shared/model-config";
+import type { DiscoveredProviderModel, ProviderModelDiscoveryState } from "./contract.js";
+
+export class DiscoveryError extends Error {
+  constructor(
+    readonly code: ProviderModelDiscoveryState["error"],
+    readonly unsupported = false,
+  ) {
+    super(code);
+  }
+}
+const invalid = () => new DiscoveryError("invalid-response");
+function object(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw invalid();
+  return value as Record<string, unknown>;
+}
+function id(value: unknown): string {
+  if (
+    typeof value !== "string" ||
+    !value.trim() ||
+    value !== value.trim() ||
+    value.length > 300 ||
+    [...value].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127)
+  )
+    throw invalid();
+  return value;
+}
+function positive(value: unknown): number | undefined {
+  if (value == null) return undefined;
+  if (typeof value !== "number" || !Number.isSafeInteger(value) || value <= 0) throw invalid();
+  return value;
+}
+function configFor(row: Record<string, unknown>, api: string, codex: boolean): ModelConfigObject {
+  // 这里只产生接口事实；本地兜底属于 Resolver，否则会污染来源计数并冻结后续刷新。
+  const context = positive(row.context_window ?? row.context_length ?? row.max_input_tokens);
+  const output = positive(
+    row.max_output_tokens ?? (api === "anthropic-messages" ? row.max_tokens : undefined),
+  );
+  const properties: Record<string, unknown> = {};
+  const optionSpecs: Record<string, unknown> = {};
+  if (context !== undefined) properties.contextWindow = context;
+  if (row.input_modalities != null) {
+    if (
+      !Array.isArray(row.input_modalities) ||
+      !row.input_modalities.every((v) => typeof v === "string")
+    )
+      throw invalid();
+    const values = row.input_modalities;
+    properties.inputFormat = Object.fromEntries(
+      ["Text", "Image", "Video", "Audio", "Pdf"].map((v) => [
+        `supports${v}`,
+        values.includes(v.toLowerCase()),
+      ]),
+    );
+  }
+  if (output !== undefined) {
+    const field =
+      api === "openai-responses"
+        ? "max_output_tokens"
+        : api === "anthropic-messages"
+          ? "max_tokens"
+          : "max_completion_tokens";
+    optionSpecs.maxOutputTokens = { max: output, map: `{"${field}":maxOutputTokens}` };
+  }
+  if (codex && row.supported_reasoning_levels != null) {
+    if (!Array.isArray(row.supported_reasoning_levels)) throw invalid();
+    const values = [...new Set(row.supported_reasoning_levels.map((v) => id(object(v).effort)))];
+    // 保持供应商公开的档位顺序；不从模型名称推断不存在的档位。
+    if (values.length)
+      optionSpecs.reasoningLevel = { values, map: '{"reasoning":{"effort":reasoningLevel}}' };
+  }
+  const parsed = modelConfigDataSchema.safeParse({
+    ...(Object.keys(properties).length ? { properties } : {}),
+    ...(Object.keys(optionSpecs).length ? { optionSpecs } : {}),
+  });
+  if (!parsed.success) throw invalid();
+  return parsed.data;
+}
+
+export function directoryURL(config: ProviderConfigObject): URL {
+  const api = config.api;
+  if (!api?.type || !api.baseUrl) throw invalid();
+  let url: URL;
+  try {
+    url = new URL(api.baseUrl);
+  } catch {
+    throw invalid();
+  }
+  if (
+    !["https:", "http:"].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  )
+    throw invalid();
+  if (
+    config.access?.type === "codex-oauth" &&
+    (api.type !== "openai-responses" || api.baseUrl !== "https://api.openai.com/v1")
+  )
+    throw invalid();
+  const base = url.pathname.replace(/\/+$/, "");
+  url.pathname = `${base}${api.type === "anthropic-messages" && !base.endsWith("/v1") ? "/v1" : ""}/models`;
+  if (api.type === "anthropic-messages") url.searchParams.set("limit", "100");
+  return url;
+}
+
+/** Complete bounded directory only: callers must not persist partial pages. */
+export async function readDirectory(
+  config: ProviderConfigObject,
+  key: string,
+  fetcher: typeof fetch,
+  signal: AbortSignal,
+  auth?: { codexMode?: "device"; headers?: Record<string, string>; clientVersion?: string },
+): Promise<DiscoveredProviderModel[]> {
+  const codex = config.access?.type === "codex-oauth";
+  const anthropic = config.api?.type === "anthropic-messages";
+  const url = directoryURL(config);
+  if (auth?.codexMode === "device") {
+    if (!codex) throw invalid();
+    url.href = "https://chatgpt.com/backend-api/codex/models";
+    url.searchParams.set("client_version", auth.clientVersion ?? "0.0.0");
+  }
+  const headers = new Headers(codex ? undefined : (config.api?.headers ?? undefined));
+  if (codex && auth?.codexMode === "device")
+    for (const [name, value] of Object.entries(auth.headers ?? {})) headers.set(name, value);
+  headers.set("Accept", "application/json");
+  headers.set("User-Agent", "ZCode");
+  if (anthropic) {
+    headers.set("x-api-key", key);
+    if (!headers.has("anthropic-version")) headers.set("anthropic-version", "2023-06-01");
+  } else headers.set("Authorization", `Bearer ${key}`);
+  let bytes = 0;
+  let entries = 0;
+  const models = new Map<string, DiscoveredProviderModel>();
+  const cursors = new Set<string>();
+  for (let page = 0; page < 10; page++) {
+    const response = await fetcher(url.toString(), { headers, signal, redirect: "error" });
+    if (!response.ok) {
+      void response.body?.cancel().catch(() => {});
+      throw new DiscoveryError(
+        response.status === 401 || response.status === 403 ? "auth" : "network",
+        response.status === 404 || response.status === 405,
+      );
+    }
+    if (!response.body) throw invalid();
+    const reader = response.body.getReader();
+    const cancelReader = () => {
+      void reader.cancel().catch(() => {});
+    };
+    signal.addEventListener("abort", cancelReader, { once: true });
+    const chunks: Uint8Array[] = [];
+    try {
+      while (true) {
+        signal.throwIfAborted();
+        const { done, value } = await reader.read();
+        if (done) break;
+        bytes += value.byteLength;
+        if (bytes > 4 * 1024 * 1024) throw invalid();
+        chunks.push(value);
+      }
+    } finally {
+      signal.removeEventListener("abort", cancelReader);
+      void reader.cancel().catch(() => {});
+    }
+    const size = chunks.reduce((n, chunk) => n + chunk.length, 0);
+    const buffer = new Uint8Array(size);
+    let offset = 0;
+    for (const chunk of chunks) {
+      buffer.set(chunk, offset);
+      offset += chunk.length;
+    }
+    let data: Record<string, unknown>;
+    try {
+      data = object(JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(buffer)));
+    } catch {
+      throw invalid();
+    }
+    const rows = data[codex ? "models" : "data"];
+    if (!Array.isArray(rows)) throw invalid();
+    entries += rows.length;
+    if (entries > 1000) throw invalid();
+    for (const raw of rows) {
+      const row = object(raw);
+      if (
+        codex &&
+        (row.visibility !== "list" ||
+          (auth?.codexMode !== "device" && row.supported_in_api !== true))
+      )
+        continue;
+      const modelId = id(row[codex ? "slug" : "id"]);
+      const modelConfig = configFor(row, config.api?.type ?? "", codex);
+      if (!models.has(modelId)) models.set(modelId, { modelId, config: modelConfig });
+    }
+    if (anthropic && typeof data.has_more !== "boolean") throw invalid();
+    if (!anthropic && data.has_more === true) throw invalid();
+    if (!data.has_more) {
+      if (!models.size) throw new DiscoveryError("empty");
+      return [...models.values()];
+    }
+    const cursor = id(data.last_id);
+    if (!rows.length || cursors.has(cursor)) throw invalid();
+    cursors.add(cursor);
+    url.searchParams.set("after_id", cursor);
+  }
+  throw invalid();
+}
diff --git a/packages/services/src/provider-model-discovery/discovery.ts b/packages/services/src/provider-model-discovery/discovery.ts
