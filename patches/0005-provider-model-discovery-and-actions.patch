@@ -0,0 +1,48 @@
+// @vitest-environment jsdom
+import { createElement } from "react";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ProviderModelDiscoveryPanel } from "@/provider-model-discovery/contract.js";
+
+const service = vi.hoisted(() => ({ getModelDiscoveryState: vi.fn(), refreshModels: vi.fn() }));
+vi.mock("@/hooks/useServices.js", () => ({
+  useServices: () => ({ providerSettingsService: service }),
+}));
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    intl: { formatMessage: ({ id }: { id: string }) => id.split(".").at(-1) },
+  }),
+}));
+beforeEach(() => {
+  vi.clearAllMocks();
+  service.getModelDiscoveryState.mockResolvedValue({ status: "idle" });
+  service.refreshModels.mockResolvedValue({ status: "ready", count: 2, reportedParameters: 1 });
+});
+afterEach(cleanup);
+describe("model discovery status", () => {
+  it("mount only reads status; explicit refresh waits for Host", async () => {
+    render(createElement(ProviderModelDiscoveryPanel, { providerId: "p" }));
+    await waitFor(() => expect(service.getModelDiscoveryState).toHaveBeenCalledWith("p"));
+    expect(service.refreshModels).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByTestId("provider-model-discovery-refresh"));
+    await waitFor(() =>
+      expect(screen.getByTestId("provider-model-discovery").dataset.status).toBe("ready"),
+    );
+    expect(service.refreshModels).toHaveBeenCalledWith("p");
+  });
+  it("rejects stale results after switching Provider and never cancels the Host task", async () => {
+    let finish!: (value: { status: string }) => void;
+    service.refreshModels.mockImplementation(
+      () =>
+        new Promise((resolve) => {
+          finish = resolve;
+        }),
+    );
+    const view = render(createElement(ProviderModelDiscoveryPanel, { providerId: "p" }));
+    fireEvent.click(screen.getByTestId("provider-model-discovery-refresh"));
+    view.rerender(createElement(ProviderModelDiscoveryPanel, { providerId: "q" }));
+    await waitFor(() => expect(service.getModelDiscoveryState).toHaveBeenCalledWith("q"));
+    await act(async () => finish({ status: "ready" }));
+    expect(screen.getByTestId("provider-model-discovery").dataset.status).toBe("idle");
+  });
+});
