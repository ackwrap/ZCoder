index 0000000000000000000000000000000000000000..8ce264009669fe6c4b9ce2fe90047fcbc3b7bc6a
--- /dev/null
+++ b/packages/services/src/provider-model-discovery/discovery.ts
@@ -0,0 +1,187 @@
+import {
+  parseProviderConfig,
+  type ProviderConfigObject,
+  type ProviderSettingsProviderView,
+} from "@zcode/provider";
+import type {
+  ProviderModelDiscovery,
+  ProviderModelDiscoveryOptions,
+  ProviderModelDiscoveryState,
+} from "./contract.js";
+import { DiscoveryError, directoryURL, readDirectory } from "./directory.js";
+
+function identity(provider: ProviderSettingsProviderView | undefined): string {
+  const config = provider?.effectiveConfig;
+  return JSON.stringify([
+    provider?.enabled,
+    config?.access,
+    config?.api?.type,
+    config?.api?.baseUrl,
+    Object.entries(config?.api?.headers ?? {}).sort(([a], [b]) => a.localeCompare(b)),
+  ]);
+}
+function eligible(provider: ProviderSettingsProviderView | undefined): boolean {
+  const access = provider?.effectiveConfig.access;
+  return (
+    provider?.enabled === true &&
+    (access?.type === "codex-oauth" ||
+      ((access?.type === "api-key" || access?.type === "zhipu-coding-plan-api-key") &&
+        !!access.apiKey?.trim()))
+  );
+}
+/** Abort races also bound non-cooperative transports / credential reads. */
+function abortable<T>(work: Promise<T>, signal: AbortSignal): Promise<T> {
+  return new Promise((resolve, reject) => {
+    const abort = () => reject(signal.reason);
+    if (signal.aborted) {
+      reject(signal.reason);
+    } else {
+      signal.addEventListener("abort", abort, { once: true });
+    }
+    void work.then(resolve, reject).finally(() => signal.removeEventListener("abort", abort));
+  });
+}
+
+export function createProviderModelDiscovery(
+  options: ProviderModelDiscoveryOptions,
+): ProviderModelDiscovery {
+  const states = new Map<string, ProviderModelDiscoveryState>();
+  const jobs = new Map<
+    string,
+    { abort: AbortController; task: Promise<ProviderModelDiscoveryState> }
+  >();
+  const generations = new Map<string, number>();
+  let disposed = false;
+  const owner: ProviderModelDiscovery = {
+    getState: (id) => states.get(id) ?? { status: "idle" },
+    refresh(id) {
+      if (disposed) return Promise.resolve({ status: "idle" });
+      const existing = jobs.get(id);
+      if (existing) return existing.task;
+      const abort = new AbortController();
+      const timeout = setTimeout(() => abort.abort(new DiscoveryError("timeout")), 20_000);
+      const assertCurrent = () => {
+        if (disposed || abort.signal.aborted || jobs.get(id)?.abort !== abort)
+          throw new DiscoveryError("stale");
+      };
+      states.set(id, { status: "loading" });
+      const task = Promise.resolve()
+        .then(async (): Promise<ProviderModelDiscoveryState> => {
+          try {
+            const view = await abortable(options.getView(), abort.signal);
+            const provider = view.providers.find((p) => p.providerId === id);
+            if (!eligible(provider)) return { status: "unsupported" };
+            const config = provider!.effectiveConfig;
+            // 验证固定 origin 必须早于凭据解析，避免改端点后向第三方发送 OAuth token。
+            directoryURL(config);
+            const auth =
+              config.access?.type === "codex-oauth"
+                ? await abortable(
+                    options.codexAuth(id).catch(() => {
+                      throw new DiscoveryError("auth");
+                    }),
+                    abort.signal,
+                  )
+                : { apiKey: (config.access as { apiKey: string }).apiKey };
+            assertCurrent();
+            const models = await abortable(
+              readDirectory(config, auth.apiKey, options.fetch, abort.signal, {
+                ...auth,
+                clientVersion: options.clientVersion,
+              }),
+              abort.signal,
+            );
+            assertCurrent();
+            const current = await abortable(options.getView(), abort.signal);
+            if (
+              current.revision !== view.revision ||
+              identity(current.providers.find((p) => p.providerId === id)) !== identity(provider)
+            )
+              throw new DiscoveryError("stale");
+            try {
+              await options.merge({
+                providerId: id,
+                basedOnRevision: view.revision,
+                models,
+                assertCurrent,
+              });
+            } catch {
+              throw new DiscoveryError("stale");
+            }
+            assertCurrent();
+            return {
+              status: "ready",
+              count: models.length,
+              reportedParameters: models.filter((m) => Object.keys(m.config).length > 0).length,
+            };
+          } catch (error) {
+            if (
+              abort.signal.aborted &&
+              !(
+                abort.signal.reason instanceof DiscoveryError &&
+                abort.signal.reason.code === "timeout"
+              )
+            )
+              return { status: "idle" };
+            const failure = abort.signal.aborted ? abort.signal.reason : error;
+            return {
+              status:
+                failure instanceof DiscoveryError && failure.unsupported ? "unsupported" : "error",
+              error: failure instanceof DiscoveryError ? failure.code : "network",
+            };
+          }
+        })
+        .then((state) => {
+          clearTimeout(timeout);
+          if (!disposed && jobs.get(id)?.abort === abort) {
+            jobs.delete(id);
+            states.set(id, state);
+          }
+          return state;
+        });
+      jobs.set(id, { abort, task });
+      return task;
+    },
+    schedule(id) {
+      if (!disposed) void owner.refresh(id);
+    },
+    async cancel(id) {
+      const generation = (generations.get(id) ?? 0) + 1;
+      generations.set(id, generation);
+      const job = jobs.get(id);
+      job?.abort.abort();
+      if (job) await job.task;
+      if (generations.get(id) === generation) states.delete(id);
+    },
+    async beforeSave(id, config: ProviderConfigObject, enabled) {
+      const before = (await options.getView()).providers.find((p) => p.providerId === id);
+      if (!before) return;
+      const effectiveConfig = parseProviderConfig(before.effectiveBuiltinConfig ?? {})
+        .overlay(parseProviderConfig(config))
+        .toJSON();
+      if (
+        identity(before) !==
+        identity({ ...before, enabled: enabled ?? before.enabled, effectiveConfig })
+      )
+        await owner.cancel(id);
+    },
+    saved(before, after) {
+      if (!eligible(after) || identity(before) === identity(after)) return;
+      const id = after!.providerId;
+      const generation = (generations.get(id) ?? 0) + 1;
+      generations.set(id, generation);
+      const previous = jobs.get(id);
+      // 两次保存可在各自 beforeSave 之后交错；最终保存仍须取消中途启动的旧 Key 任务，不能仅合并触发。
+      previous?.abort.abort();
+      void (previous?.task ?? Promise.resolve()).then(() => {
+        if (!disposed && generations.get(id) === generation) owner.schedule(id);
+      });
+    },
+    dispose() {
+      disposed = true;
+      for (const job of jobs.values()) job.abort.abort();
+      states.clear();
+    },
+  };
+  return owner;
+}
