+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { Button } from "@/components/ui/button.js";
+import { useProviderModelDiscovery } from "@/hooks/provider-model-discovery/index.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+
+export function ProviderModelDiscoveryPanel({ providerId }: { providerId: string }) {
+  const { intl } = useZCodeIntl();
+  const { state, refresh } = useProviderModelDiscovery(providerId);
+  const statusText = intl.formatMessage(
+    { id: `settings.modelDiscovery.${state.status}` },
+    { count: state.count ?? 0, parameters: state.reportedParameters ?? 0 },
+  );
+  return (
+    <div
+      className="inline-flex items-center"
+      data-testid="provider-model-discovery"
+      data-status={state.status}
+    >
+      <ControlHintTooltip
+        standalone
+        title={statusText}
+        description={intl.formatMessage({ id: "settings.modelDiscovery.hint" })}
+      >
+        <Button
+          type="button"
+          variant="secondary"
+          size="default"
+          className="rounded-lg"
+          disabled={state.status === "loading"}
+          onClick={() => void refresh()}
+          data-testid="provider-model-discovery-refresh"
+        >
+          {intl.formatMessage({
+            id:
+              state.status === "loading"
+                ? "settings.modelDiscovery.loading"
+                : state.status === "error"
+                  ? "settings.modelDiscovery.retry"
+                  : "settings.modelDiscovery.refresh",
+          })}
+        </Button>
+      </ControlHintTooltip>
+      <span className="sr-only" role="status" aria-live="polite">
+        {statusText}
+      </span>
+    </div>
+  );
+}
