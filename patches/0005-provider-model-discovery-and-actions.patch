diff --git a/packages/ui/test/providerModelDiscovery.test.ts b/packages/ui/test/providerModelDiscovery.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bbf1bc1c2db0322eeb8590e6b63512b5e26b6031
--- /dev/null
