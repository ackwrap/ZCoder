diff --git a/packages/ui/src/hooks/provider-model-discovery/index.ts b/packages/ui/src/hooks/provider-model-discovery/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..234d8a51a7d6296387e04fe6e2b1e579fbde1bed
--- /dev/null
+++ b/packages/ui/src/hooks/provider-model-discovery/index.ts
@@ -0,0 +1,56 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useServices } from "../useServices.js";
+
+/** Read projection only. Mount/unmount never starts or stops Host directory work. */
+export function useProviderModelDiscovery(providerId: string) {
+  const { providerSettingsService: service } = useServices();
+  type ProviderModelDiscoveryState = Awaited<ReturnType<typeof service.getModelDiscoveryState>>;
+  const [state, setState] = useState<ProviderModelDiscoveryState>({ status: "idle" });
+  const generation = useRef(0);
+  const sequence = useRef(0);
+  const pending = useRef(false);
+  useEffect(() => {
+    generation.current += 1;
+    pending.current = false;
+    setState({ status: "idle" });
+    let ignore = false;
+    let reading = false;
+    const read = async () => {
+      if (reading || pending.current) return;
+      reading = true;
+      const current = ++sequence.current;
+      try {
+        const next = await service.getModelDiscoveryState(providerId);
+        if (!ignore && current === sequence.current) setState(next);
+      } catch {
+        if (!ignore && current === sequence.current)
+          setState({ status: "error", error: "network" });
+      } finally {
+        reading = false;
+      }
+    };
+    void read();
+    const timer = setInterval(() => void read(), 1000);
+    return () => {
+      ignore = true;
+      generation.current += 1;
+      clearInterval(timer);
+    };
+  }, [providerId, service]);
+  const refresh = useCallback(async () => {
+    if (pending.current) return;
+    pending.current = true;
+    sequence.current += 1;
+    const current = generation.current;
+    setState({ status: "loading" });
+    try {
+      const next = await service.refreshModels(providerId);
+      if (current === generation.current) setState(next);
+    } catch {
+      if (current === generation.current) setState({ status: "error", error: "network" });
+    } finally {
+      if (current === generation.current) pending.current = false;
+    }
+  }, [providerId, service]);
+  return { state, refresh };
+}
