+#!/usr/bin/env node
+/**
+ * 验证「不开 ZCODE_CUA_DEV_MODE」时 Helper 能否服务 —— 这决定开源版默认启动是否开箱可用。
+ * 与 test/integration.windows.mjs 的差别只有 env：不注入 ZCODE_CUA_DEV_MODE。
+ */
+import { spawn } from "node:child_process";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { mintBrokerSocketPath, probeHelperHealth } from "../broker.js";
+import { createComputerUseRuntime } from "../index.js";
+
+const packageRoot = join(fileURLToPath(import.meta.url), "..", "..");
+const entry = join(packageRoot, "helper", "dist", "windows-helper.js");
+const addon = join(packageRoot, "helper", "build", "Release", "ax_native.node");
+const socketPath = mintBrokerSocketPath();
+
+const helper = spawn(process.execPath, [entry, "--socket", socketPath, "--parent-pid", String(process.pid)], {
+  cwd: join(entry, ".."),
+  env: { ...process.env, ZCODE_CUA_HELPER_ADDON: addon },
+  stdio: ["ignore", "pipe", "pipe"],
+});
+let output = "";
+helper.stdout.on("data", (chunk) => (output += chunk));
+helper.stderr.on("data", (chunk) => (output += chunk));
+
+const runtime = createComputerUseRuntime({ brokerSocketPath: socketPath, connectTimeoutMs: 2_000 });
+const context = { sessionId: "no-dev-mode", runtimeScope: "main", workspaceKey: "no-dev-mode" };
+let ok = false;
+try {
+  const health = await probeHelperHealth(socketPath, { timeoutMs: 20_000 });
+  console.log("health:", JSON.stringify(health));
+  const result = await runtime.execute({ toolName: "list_apps", context });
+  const apps = JSON.parse(result.content[0].text);
+  console.log("list_apps:", apps.length);
+  ok = apps.length > 0;
+} catch (error) {
+  console.error("FAILED:", error?.code ?? "", error?.message ?? String(error));
+} finally {
+  await runtime.dispose().catch(() => {});
+  helper.kill();
+  if (output) console.log("helper_output_head:", output.slice(0, 300));
+  console.log(ok ? "RESULT: OK (dev mode not required)" : "RESULT: FAILED");
+  process.exit(ok ? 0 : 1);
+}
