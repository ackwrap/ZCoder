index 0000000000000000000000000000000000000000..51997255060310ce83e6a59fa891d5c7226d5192
--- /dev/null
+++ b/packages/zcode-cua/runtime/envelope.js
@@ -0,0 +1,91 @@
+/**
+ * 结果信封：与官方 node_repl 工具层同形，SDK（computer-use-client.mjs）按这些字段解析。
+ *
+ *   观察：content=[树文本(+图片)]，structuredContent={state_id, app, window, elements, text, snapshot_mode}
+ *   动作：content=[说明, 收据JSON]，structuredContent={action_sent, dispatch_status, ...}
+ *   失败：{isError:true, content=[{code,message,details}]}
+ *   冷启动：非 error，单块 {kind:"CUA_NOT_READY", reasonCode, retryable, message} —— SDK 会重试
+ */
+
+export const NOT_READY_KIND = "CUA_NOT_READY";
+
+function textBlock(text) {
+  return { type: "text", text };
+}
+
+export function notReadyEnvelope({ reasonCode, message, retryable = true }) {
+  return {
+    content: [
+      textBlock(JSON.stringify({ kind: NOT_READY_KIND, reasonCode, retryable, message })),
+    ],
+  };
+}
+
+export function errorEnvelope(code, message, details) {
+  return {
+    isError: true,
+    content: [
+      textBlock(
+        JSON.stringify({
+          code,
+          message,
+          ...(details === undefined ? {} : { details }),
+        }),
+      ),
+    ],
+    ...(details !== undefined && details !== null && typeof details === "object"
+      ? { structuredContent: { code, message, ...details } }
+      : {}),
+  };
+}
+
+export function jsonEnvelope(value) {
+  return { content: [textBlock(typeof value === "string" ? value : JSON.stringify(value))] };
+}
+
+export function observationEnvelope({ raw, observation, includeScreenshot }) {
+  const content = [textBlock(observation.text)];
+  const format = typeof raw?.screenshot?.format === "string" ? raw.screenshot.format : "png";
+  const data = raw?.screenshot?.data;
+  if (includeScreenshot && typeof data === "string" && data.length > 0) {
+    content.push({ type: "image", data, mimeType: `image/${format}` });
+  }
+  if (raw?.screenshot_blank === true) {
+    content.push(textBlock("[screenshot_blank] the captured raster was blank"));
+  }
+  return {
+    content,
+    structuredContent: {
+      state_id: observation.stateId,
+      app: observation.app,
+      window: observation.window,
+      elements: observation.elements,
+      text: observation.text,
+      snapshot_mode: typeof raw?.snapshot_mode === "string" ? raw.snapshot_mode : "full",
+      ...(typeof raw?.base_state_id === "string" ? { base_state_id: raw.base_state_id } : {}),
+      ...(raw?.screenshot_blank === true ? { screenshot_blank: true } : {}),
+    },
+  };
+}
+
+export function actionEnvelope(note, raw) {
+  const receipt = {
+    action_sent: raw?.action_sent === false ? false : true,
+    dispatch_status:
+      typeof raw?.dispatch_status === "string"
+        ? raw.dispatch_status
+        : raw?.action_sent === false
+          ? "not_sent"
+          : "accepted",
+    ...(typeof raw?.target_verification_status === "string"
+      ? { target_verification_status: raw.target_verification_status }
+      : {}),
+    ...(typeof raw?.ax_error === "string" ? { ax_error: raw.ax_error } : {}),
+    ...(raw?.resolved_app_ref ? { resolved_app_ref: raw.resolved_app_ref } : {}),
+  };
+  return {
+    ...(receipt.action_sent === false ? { isError: true } : {}),
+    content: [textBlock(note), textBlock(JSON.stringify({ action_receipt: receipt }))],
+    structuredContent: receipt,
+  };
+}
