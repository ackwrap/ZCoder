+  let recipe;
+  try {
+    recipe = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (!recipe || typeof recipe !== "object" || Array.isArray(recipe)) return null;
+  const ok =
+    typeof recipe.command === "string" &&
+    recipe.command.length > 0 &&
+    typeof recipe.entryPath === "string" &&
+    recipe.entryPath.length > 0 &&
+    typeof recipe.root === "string" &&
+    recipe.root.length > 0 &&
+    typeof recipe.addonPath === "string" &&
+    recipe.addonPath.length > 0 &&
+    recipe.commandEnv &&
+    typeof recipe.commandEnv === "object" &&
+    Number.isInteger(recipe.hostPid) &&
+    recipe.hostPid > 0;
+  return ok ? recipe : null;
+}
+
+/** 官方 `ensureWindowsHelperForked`：按配方 detached fork，stdio 全 ignore。 */
+export function ensureWindowsHelperForked(socketPath, env, spawnImpl) {
+  const recipe = parseRecipe(env?.[ZCODE_CUA_WIN_HELPER_RECIPE_ENV]);
+  if (!recipe) return null;
+  const run = spawnImpl ?? spawn;
+  try {
+    const child = run(
+      recipe.command,
+      [recipe.entryPath, "--socket", socketPath, "--parent-pid", String(recipe.hostPid)],
+      {
+        cwd: recipe.root,
+        detached: true,
+        stdio: "ignore",
+        env: {
+          ...process.env,
+          ...recipe.commandEnv,
+          [HELPER_ADDON_ENV]: recipe.addonPath,
+          ELECTRON_RUN_AS_NODE: "1",
+        },
+      },
+    );
+    child.once?.("error", () => {});
+    child.unref?.();
+    return child;
+  } catch {
+    return null;
+  }
+}
+
+function probePipe(socketPath, timeoutMs = 500) {
+  return new Promise((resolve) => {
+    let settled = false;
+    const socket = connect(socketPath);
+    const finish = (ok) => {
+      if (settled) return;
+      settled = true;
+      socket.destroy();
+      resolve(ok);
+    };
+    const timer = setTimeout(() => finish(false), timeoutMs);
+    socket.once("connect", () => finish(true));
+    socket.once("error", () => finish(false));
+  });
+}
+
+async function waitForPipe(socketPath, deadlineMs) {
+  const deadline = Date.now() + deadlineMs;
+  while (Date.now() < deadline) {
+    if (await probePipe(socketPath)) return true;
+    await new Promise((resolve) => {
+      const timer = setTimeout(resolve, HELPER_READY_POLL_MS);
+    });
+  }
+  return false;
+}
+
+/**
+ * macOS：官方走 `open -n -g <Helper.app> --args --socket ...`。
+ * 这里只在存在独立 Helper.app 候选时尝试（Windows 主线不受影响）。
+ */
+async function ensureDarwinHelperLaunched(socketPath, env) {
+  const { standaloneHelperCandidatePaths, buildHelperOpenArgs } = await import(
+    "../broker-server.js"
+  );
+  const candidate = standaloneHelperCandidatePaths(env).find((path) => existsSync(path));
+  if (!candidate) return false;
+  const { execFile } = await import("node:child_process");
+  const args = buildHelperOpenArgs({
+    appPath: candidate,
+    socketPath,
+    pipMode: true,
+    ghostCursorOverlay: true,
+  });
+  await new Promise((resolve) => {
+    execFile("/usr/bin/open", args, { timeout: 5_000 }, () => resolve());
+  }).catch(() => {});
+  return true;
+}
+
+/**
+ * 确保 socket 那头有 Helper：没起就按配方起，并等到管道真的可连。
+ *
+ * 与官方唯一的有意差异：官方 fork 完立刻返回、靠 SDK 的 6 次退避覆盖冷启动；这里显式
+ * 等到管道可连（上限 15s），因为开源树的调用方（node_repl 宿主）没有别的重试层兜底。
+ */
+export async function ensureStandaloneHelperLaunched(socketPath, env = process.env) {
+  if (typeof socketPath !== "string" || !socketPath.trim()) return false;
+  if (process.platform !== "win32" && process.platform !== "darwin") return false;
+
+  const state = launchState.get(socketPath);
+  if (state && Date.now() - state.launchedAt < LAUNCH_RETRY_COOLDOWN_MS) {
+    // 冷却期内不重复 fork；但如果管道此刻已就绪，直接放行。
+    if (await probePipe(socketPath)) return true;
+    return false;
+  }
+
+  if (await probePipe(socketPath)) {
+    launchState.set(socketPath, { launchedAt: Date.now(), ok: true });
+    return true;
+  }
+
+  let spawned = false;
+  if (process.platform === "win32") {
+    // 只对 Windows 命名管道按配方 fork；其它形态交给调用方。
+    const forked = Boolean(ensureWindowsHelperForked(socketPath, env));
+    if (forked && isWindowsNamedPipePath(socketPath)) {
+      await waitForPipe(socketPath, HELPER_READY_WAIT_MS);
+    }
+    spawned = forked;
+  } else {
+    spawned = await ensureDarwinHelperLaunched(socketPath, env);
+  }
+
+  const ready = await probePipe(socketPath);
+  launchState.set(socketPath, { launchedAt: Date.now(), ok: ready });
+  return ready;
+}
+
+/** 仅供测试：清空去重状态。 */
+export function __resetHelperLaunchStateForTest() {
+  launchState.clear();
+}
diff --git a/packages/zcode-cua/runtime/session.js b/packages/zcode-cua/runtime/session.js
new file mode 100644
index 0000000000000000000000000000000000000000..379ceabfcf9f14c151e48c89729155ef90f91a4d
--- /dev/null
+++ b/packages/zcode-cua/runtime/session.js
@@ -0,0 +1,440 @@
+/**
+ * 一个 CUA 会话的状态：per-app 最新观察（element index → native token）+ 14 个工具的语义。
+ *
+ * 为什么状态在会话里而不是在工具调用里：模型的 element target 只带 index，
+ * index 的作用域是「该 app 最近一次 get_app_state」。官方把这本台账放在 shared host 的
+ * runtime session 里，我们照抄——node_repl 每个 cell 都是新 Worker，跨 cell 存活只能靠宿主侧。
+ */
+
+import { elementCenter, renderTreeText } from "./tree-text.js";
+
+const MODIFIER_ALIASES = {
+  cmd: "cmd",
+  command: "cmd",
+  super: "cmd",
+  meta: "cmd",
+  win: "win",
+  shift: "shift",
+  opt: "opt",
+  option: "opt",
+  alt: "alt",
+  ctrl: "ctrl",
+  control: "ctrl",
+};
+
+function normalizeModifiers(value, method) {
+  if (!value) return "";
+  const out = [];
+  const seen = new Set();
+  for (const raw of String(value).split("+")) {
+    const token = raw.trim().toLowerCase();
+    if (!token || token === "none") continue;
+    const canonical = MODIFIER_ALIASES[token];
+    if (!canonical) {
+      throw coded(
+        "invalid_modifiers",
+        `${method} modifiers must be a '+'-separated chord (got '${token}')`,
+      );
+    }
+    if (!seen.has(canonical)) {
+      seen.add(canonical);
+      out.push(canonical);
+    }
+  }
+  return out.join("+");
+}
+
+function coded(code, message, details) {
+  const error = new Error(message);
+  error.code = code;
+  if (details !== undefined) error.details = details;
+  return error;
+}
+
+const DIRECTIONS = {
+  up: "up",
+  u: "up",
+  down: "down",
+  d: "down",
+  left: "left",
+  l: "left",
+  right: "right",
+  r: "right",
+};
+
+function normalizeDirection(value) {
+  const direction = DIRECTIONS[String(value ?? "").toLowerCase()];
+  if (!direction) throw coded("bad_request", "scroll_direction must be up|down|left|right");
+  return direction;
+}
+
+function clampScrollAmount(value) {
+  const amount = Number(value);
+  if (!Number.isFinite(amount)) return 0;
+  return Math.max(0, Math.min(100, Math.round(amount)));
+}
+
+function appKeyOf(appRef) {
+  if (!appRef) return "default";
+  if (typeof appRef === "number") return `pid:${appRef}`;
+  if (typeof appRef === "string") return `bundle:${appRef}`;
+  if (typeof appRef.pid === "number") {
+    return appRef.window_id === undefined
+      ? `pid:${appRef.pid}`
+      : `pid:${appRef.pid}:w${appRef.window_id}`;
+  }
+  if (appRef.window_id !== undefined) return `win:${appRef.window_id}`;
+  if (appRef.bundle_id) return `bundle:${appRef.bundle_id}`;
+  if (appRef.name) return `name:${appRef.name}`;
+  return "default";
+}
+
+/** 元素 index → native 必须在「该 app 最新观察」里查，不能跨 app 兜底。 */
+function elementAt(observation, index) {
+  if (!observation) {
+    throw coded(
+      "element_unavailable",
+      "no observation is registered for this app; call get_app_state first",
+    );
+  }
+  const element = observation.elements[index];
+  if (!element) {
+    throw coded(
+      "element_unavailable",
+      `element index ${index} is not in the latest observation of this app (0..${observation.elements.length - 1}); call get_app_state again`,
+    );
+  }
+  return element;
+}
+
+export class ComputerUseSession {
+  constructor({ connection, sessionId, workspaceKey }) {
+    this.connection = connection;
+    this.sessionId = sessionId;
+    this.workspaceKey = workspaceKey;
+    /** @type {Map<string, {elements:any[], stateId:string|null, app:any, window:any, text:string}>} */
+    this.observations = new Map();
+    this.stopped = false;
+  }
+
+  #assertLive() {
+    if (this.stopped) {
+      throw coded("controller_stopped", "Computer Use was stopped; start a new computer-use session");
+    }
+    if (this.connection.closed) {
+      throw coded("broker_unavailable", "Computer Use broker connection is closed");
+    }
+  }
+
+  #observation(appRef) {
+    return this.observations.get(appKeyOf(appRef)) ?? null;
+  }
+
+  #remember(appRef, raw) {
+    const observation = {
+      elements: Array.isArray(raw?.elements) ? raw.elements : [],
+      stateId: typeof raw?.state_id === "string" ? raw.state_id : null,
+      app: raw?.app ?? null,
+      window: raw?.window ?? null,
+      text: "",
+    };
+    observation.text = renderTreeText(observation.elements, observation.window);
+    this.observations.set(appKeyOf(appRef ?? { pid: raw?.app?.pid }), observation);
+    return observation;
+  }
+
+  #resolveElement(appRef, target) {
+    if (!target || target.type !== "element") return null;
+    const observation = this.#observation(appRef);
+    const element = elementAt(observation, target.index);
+    return { element, observation };
+  }
+
+  // ─────────────────────────────────────────────────────────── 观察
+
+  async listApps() {
+    this.#assertLive();
+    const apps = await this.connection.request("list_applications", {});
+    return (Array.isArray(apps) ? apps : []).map((app) => ({
+      pid: app?.pid ?? null,
+      name: app?.name ?? null,
+      bundle_id: app?.bundle_id ?? null,
+      active: app?.active === true,
+    }));
+  }
+
+  async listWindows(appRef) {
+    this.#assertLive();
+    if (!appRef) throw coded("bad_request", "list_windows requires app_ref");
+    return await this.connection.request("list_windows", { app_ref: appRef });
+  }
+
+  async getAppState(args = {}) {
+    this.#assertLive();
+    const params = { app_ref: args.app_ref };
+    if (args.include_screenshot !== undefined) params.include_screenshot = args.include_screenshot;
+    if (args.disable_diffing === true) params.force_full = true;
+    const raw = await this.connection.request("capture_app", params, { timeoutMs: 20_000 });
+    const observation = this.#remember(args.app_ref, raw);
+    return { raw, observation };
+  }
+
+  // ─────────────────────────────────────────────────────────── 指针
+
+  async click(args = {}) {
+    this.#assertLive();
+    const chord = normalizeModifiers(args.modifiers, "left_click");
+    const button = args.mouse_button ?? "left";
+    const clicks = Math.max(1, Math.min(3, Number(args.click_count) || 1));
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (resolved) {
+      const { element } = resolved;
+      const canPress = button === "left" && clicks === 1 && !chord && element.pressable === true;
+      if (canPress) {
+        const result = await this.connection.request("element_perform_action", {
+          native: element.native,
+          action: "AXPress",
+        });
+        return {
+          note: `Pressed element ${args.target.index} via accessibility (AXPress); no coordinate hit-test.`,
+          raw: result,
+        };
+      }
+      const point = elementCenter(element.bounds);
+      if (!point) {
+        throw coded("not_selectable", `element ${args.target.index} has no on-screen bounds`);
+      }
+      const result = await this.connection.request("click", {
+        point,
+        button,
+        clicks,
+        ...(chord ? { modifiers: chord } : {}),
+        ...(element.owner_pid ? { expected_pid: element.owner_pid } : {}),
+        ...(args.app_ref ? { app_ref: args.app_ref } : {}),
+      });
+      return {
+        note: `Clicked element ${args.target.index} at its center (coordinate dispatch).`,
+        raw: result,
+      };
+    }
+    if (!args.target || args.target.type !== "coordinate") {
+      throw coded("bad_request", "left_click requires an element or coordinate target");
+    }
+    const result = await this.connection.request("click", {
+      point: { x: args.target.x, y: args.target.y },
+      button,
+      clicks,
+      ...(chord ? { modifiers: chord } : {}),
+      ...(args.app_ref ? { app_ref: args.app_ref } : {}),
+    });
+    return { note: `Clicked (${args.target.x}, ${args.target.y}).`, raw: result };
+  }
+
+  async drag(args = {}) {
+    this.#assertLive();
+    const start = this.#pointerOf(args.from_target, args.app_ref, "drag from");
+    const end = this.#pointerOf(args.to, args.app_ref, "drag to");
+    const chord = normalizeModifiers(args.modifiers, "drag");
+    const result = await this.connection.request("drag", {
+      start,
+      end,
+      ...(chord ? { modifiers: chord } : {}),
+      ...(args.app_ref ? { app_ref: args.app_ref } : {}),
+    });
+    return { note: "Dragged.", raw: result };
+  }
+
+  #pointerOf(target, appRef, label) {
+    if (!target) throw coded("bad_request", `${label} target is required`);
+    if (target.type === "coordinate") return { x: target.x, y: target.y };
+    const resolved = this.#resolveElement(appRef, target);
+    const point = elementCenter(resolved.element.bounds);
+    if (!point) throw coded("not_selectable", `${label} element has no on-screen bounds`);
+    return point;
+  }
+
+  async scroll(args = {}) {
+    this.#assertLive();
+    const direction = normalizeDirection(args.scroll_direction);
+    const amount = clampScrollAmount(args.scroll_amount);
+    if (amount < 1) {
+      return { note: "Scrolled 0 (nothing to scroll).", raw: null };
+    }
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (resolved) {
+      const result = await this.connection.request("element_scroll", {
+        native: resolved.element.native,
+        direction,
+        amount,
+      });
+      return { note: `Scrolled ${amount} via accessibility on the element container.`, raw: result };
+    }
+    if (!args.target || args.target.type !== "coordinate") {
+      throw coded("bad_request", "scroll requires an element or coordinate target");
+    }
+    const result = await this.connection.request("scroll", {
+      point: { x: args.target.x, y: args.target.y },
+      direction,
+      amount,
+      ...(args.app_ref ? { app_ref: args.app_ref } : {}),
+    });
+    return { note: `Scrolled ${amount}.`, raw: result };
+  }
+
+  // ─────────────────────────────────────────────────────────── 键盘 / 文本
+
+  async type(args = {}) {
+    this.#assertLive();
+    if (typeof args.text !== "string") throw coded("bad_request", "type requires text");
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (resolved && resolved.element.editable === true && args.strategy !== "event") {
+      const result = await this.connection.request("element_set_value", {
+        native: resolved.element.native,
+        value: args.text,
+      });
+      return { note: "Set the element value via accessibility.", raw: result };
+    }
+    const result = args.app_ref
+      ? await this.connection.request("type_text_to_app", {
+          app_ref: args.app_ref,
+          text: args.text,
+          ...(args.strategy ? { strategy: args.strategy } : {}),
+        })
+      : await this.connection.request("type_text", { text: args.text });
+    return { note: "Typed text.", raw: result };
+  }
+
+  async setValue(args = {}) {
+    this.#assertLive();
+    if (typeof args.value !== "string") throw coded("bad_request", "set_value requires value");
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (!resolved) throw coded("not_settable", "set_value requires an element target");
+    if (resolved.element.editable !== true) {
+      throw coded("not_settable", `element ${args.target.index} is not settable`);
+    }
+    const result = await this.connection.request("element_set_value", {
+      native: resolved.element.native,
+      value: args.value,
+    });
+    return { note: "Set the element value.", raw: result };
+  }
+
+  async selectText(args = {}) {
+    this.#assertLive();
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (!resolved) throw coded("not_selectable", "select_text requires an element target");
+    let range = args.text_range;
+    if (typeof range === "string") {
+      try {
+        range = JSON.parse(range);
+      } catch {
+        throw coded("bad_request", "text_range must be [start, length]");
+      }
+    }
+    const params = { native: resolved.element.native };
+    if (Array.isArray(range)) {
+      if (range.length !== 2 || !range.every((n) => Number.isInteger(n) && n >= 0)) {
+        throw coded("bad_request", "text_range must be [start, length] with non-negative integers");
+      }
+      params.text_range = range;
+    }
+    const result = await this.connection.request("element_select_text", params);
+    return { note: "Selected text.", raw: result };
+  }
+
+  async key(args = {}) {
+    this.#assertLive();
+    if (typeof args.text !== "string" || !args.text.trim()) {
+      throw coded("bad_request", "key requires a key or chord");
+    }
+    const repeat = Math.max(1, Math.min(100, Number(args.repeat) || 1));
+    const holdMs =
+      typeof args.hold_seconds === "number" && args.hold_seconds > 0
+        ? Math.round(Math.min(30, args.hold_seconds) * 1000)
+        : undefined;
+    let last = null;
+    for (let index = 0; index < repeat; index += 1) {
+      if (holdMs !== undefined) {
+        last = args.app_ref
+          ? await this.connection.request("hold_key_to_app", {
+              app_ref: args.app_ref,
+              text: args.text,
+              duration: holdMs,
+            })
+          : await this.connection.request("hold_key", { text: args.text, duration: holdMs });
+      } else {
+        last = args.app_ref
+          ? await this.connection.request("press_key_to_app", {
+              app_ref: args.app_ref,
+              text: args.text,
+              ...(args.strategy ? { strategy: args.strategy } : {}),
+            })
+          : await this.connection.request("press_key", {
+              text: args.text,
+              ...(args.strategy ? { strategy: args.strategy } : {}),
+            });
+      }
+    }
+    return { note: `Pressed ${args.text}${repeat > 1 ? ` ×${repeat}` : ""}.`, raw: last };
+  }
+
+  async paste(args = {}) {
+    this.#assertLive();
+    if (typeof args.text !== "string") throw coded("bad_request", "paste requires text");
+    const result = await this.connection.request("paste", {
+      text: args.text,
+      format: args.format ?? "text",
+      ...(args.app_ref ? { app_ref: args.app_ref } : {}),
+    });
+    return { note: "Pasted text through the system pasteboard.", raw: result };
+  }
+
+  async performAction(args = {}) {
+    this.#assertLive();
+    if (typeof args.action !== "string" || !args.action) {
+      throw coded("bad_request", "perform_action requires action");
+    }
+    const resolved = this.#resolveElement(args.app_ref, args.target);
+    if (!resolved) throw coded("bad_request", "perform_action requires an element target");
+    const actions = Array.isArray(resolved.element.actions) ? resolved.element.actions : [];
+    if (!actions.includes(args.action)) {
+      throw coded(
+        "action_unavailable",
+        `action ${JSON.stringify(args.action)} is not advertised by this element; allowed: ${JSON.stringify(actions)}`,
+        { allowed_actions: actions },
+      );
+    }
+    const result = await this.connection.request("element_perform_action", {
+      native: resolved.element.native,
+      action: args.action,
+    });
+    return { note: `Performed ${args.action}.`, raw: result };
+  }
+
+  // ─────────────────────────────────────────────────────────── 运行时
+
+  async requestAccess(capabilities = []) {
+    if (!Array.isArray(capabilities)) {
+      try {
+        capabilities = JSON.parse(capabilities);
+      } catch {
+        throw coded("bad_request", "capabilities must be a string array");
+      }
+    }
+    const result = await this.connection.request("request_access", { capabilities });
+    return { raw: result };
+  }
+
+  async permissionStatus() {
+    return await this.connection.request("permission_status", {});
+  }
+
+  async stop(reason = "user requested") {
+    this.stopped = true;
+    try {
+      return await this.connection.request("controller_stop", { reason });
+    } catch {
+      return null;
+    }
+  }
+}
diff --git a/packages/zcode-cua/runtime/tree-text.js b/packages/zcode-cua/runtime/tree-text.js
new file mode 100644
index 0000000000000000000000000000000000000000..44c2fe58a0db3e1a2f16bc9589616895347ca31a
--- /dev/null
+++ b/packages/zcode-cua/runtime/tree-text.js
@@ -0,0 +1,54 @@
+/**
+ * computer-use 观察结果的文本渲染（官方单层 AX 树风格）。
+ *
+ * 只服务于模型阅读：结构化事实走 structuredContent，这里的文本不参与寻址。
+ * 每个元素前缀的整数就是 element index —— 与 structuredContent.elements 的数组下标一致。
+ */
+
+const FLAG_ORDER = ["pressable", "editable", "has_menu", "focused", "disabled"];
+
+export function renderTreeText(elements, window) {
+  const lines = [];
+  if (window) {
+    lines.push(
+      `window: ${JSON.stringify({
+        window_id: window.window_id ?? null,
+        title: window.title ?? null,
+        bounds: window.bounds ?? null,
+        focused: window.focused ?? null,
+      })}`,
+    );
+  }
+  const list = Array.isArray(elements) ? elements : [];
+  list.forEach((element, index) => {
+    const kind = element?.kind || element?.role || "unknown";
+    const title = element?.title ? ` ${JSON.stringify(element.title)}` : "";
+    const value =
+      element?.value === null || element?.value === undefined
+        ? ""
+        : ` = ${JSON.stringify(element.value)}`;
+    const flags = [];
+    if (element?.pressable) flags.push("pressable");
+    if (element?.editable) flags.push("editable");
+    if (element?.has_menu) flags.push("has_menu");
+    if (element?.focused) flags.push("focused");
+    if (element?.enabled === false) flags.push("disabled");
+    void FLAG_ORDER;
+    const actions =
+      Array.isArray(element?.actions) && element.actions.length > 0
+        ? ` actions=[${element.actions.join(",")}]`
+        : "";
+    lines.push(
+      `${index}\t${kind}${title}${value}${flags.length > 0 ? ` [${flags.join(",")}]` : ""}${actions}`,
+    );
+  });
+  return lines.join("\n");
+}
+
+/** 元素在屏幕上的中心点（坐标目标回落用）。 */
+export function elementCenter(bounds) {
+  if (!Array.isArray(bounds) || bounds.length !== 4) return null;
+  const [x, y, width, height] = bounds.map(Number);
+  if (![x, y, width, height].every(Number.isFinite)) return null;
+  return { x: Math.round(x + width / 2), y: Math.round(y + height / 2) };
+}
