@@ -0,0 +1,56 @@
+#!/usr/bin/env node
+/**
+ * 集成验证：用 services 真实的 WindowsCuaHelperHost + windowsCuaDevRuntime 拉起 Helper，
+ * 再把拿到的 socketPath 交给 @zcode/zcode-cua 的 runtime 跑一次 list_apps。
+ *
+ * 这条链路等价于开源版 dev 启动时 desktop/services 实际走的路径。
+ */
+import { resolveWindowsCuaRuntime } from "../../services/dist/cua-permission-broker/windowsCuaDevRuntime.js";
+import { WindowsCuaHelperHost } from "../../services/dist/cua-permission-broker/windowsCuaDevHelperHost.js";
+import { mintBrokerSocketPath, probeHelperHealth } from "../broker.js";
+import { createComputerUseRuntime } from "../index.js";
+
+const logger = {
+  debug: () => {},
+  info: () => {},
+  warn: () => {},
+  error: () => {},
+};
+
+const runtime = await resolveWindowsCuaRuntime({
+  platform: "win32",
+  env: { ...process.env, ZCODE_CUA_DEV_ROOT: process.cwd() },
+});
+
+const host = new WindowsCuaHelperHost({
+  runtime,
+  logger,
+  mintSocketPath: () => mintBrokerSocketPath(),
+});
+
+let ok = false;
+try {
+  await host.start();
+  const transport = await host.waitForTransport(30_000);
+  console.log("transport:", JSON.stringify({ socketPath: transport.socketPath }));
+  const health = await probeHelperHealth(transport.socketPath, { timeoutMs: 10_000 });
+  console.log("health:", JSON.stringify(health));
+  const cuaWithTransport = createComputerUseRuntime({
+    brokerSocketPath: transport.socketPath,
+    connectTimeoutMs: 3_000,
+  });
+  const result = await cuaWithTransport.execute({
+    toolName: "list_apps",
+    context: { sessionId: "host-it", runtimeScope: "main", workspaceKey: process.cwd() },
+  });
+  const apps = JSON.parse(result.content[0].text);
+  console.log("list_apps:", Array.isArray(apps) ? apps.length : JSON.stringify(apps));
+  ok = Array.isArray(apps) && apps.length > 0 && health.pid !== null;
+  await cuaWithTransport.dispose();
+} catch (error) {
+  console.error("FAILED:", error?.code ?? "", error?.message ?? String(error));
+} finally {
+  await host.stop().catch(() => {});
+  console.log(ok ? "RESULT: OK (services host → zcode-cua runtime)" : "RESULT: FAILED");
+  process.exit(ok ? 0 : 1);
+}
diff --git a/packages/zcode-cua/test/integration.windows.mjs b/packages/zcode-cua/test/integration.windows.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6c4e1e7f5aabe3f5cbbe8efccdcfa08df49dd7d0
--- /dev/null
+++ b/packages/zcode-cua/test/integration.windows.mjs
@@ -0,0 +1,142 @@
+#!/usr/bin/env node
+/**
+ * Windows 端到端自检：真起 Helper → createComputerUseRuntime → 驱动记事本。
+ *
+ *   node packages/zcode-cua/test/integration.windows.mjs          # 只读 + AX 动作
+ *   node packages/zcode-cua/test/integration.windows.mjs --shot   # 额外验证截图
+ *
+ * 这不是 vitest 用例（需要真机 UI），是接入开源版后的手工验收脚本。
+ */
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { mintBrokerSocketPath, probeHelperHealth } from "../broker.js";
+import { createComputerUseRuntime } from "../index.js";
+
+const packageRoot = join(fileURLToPath(import.meta.url), "..", "..");
+const entry = join(packageRoot, "helper", "dist", "windows-helper.js");
+const addon = join(packageRoot, "helper", "build", "Release", "ax_native.node");
+const withShot = process.argv.includes("--shot");
+
+const log = (label, value) =>
+  console.log(`${label}: ${typeof value === "string" ? value : JSON.stringify(value)}`);
+
+async function waitForHealth(socketPath, deadlineMs = 30_000) {
+  const deadline = Date.now() + deadlineMs;
+  let last;
+  while (Date.now() < deadline) {
+    try {
+      return await probeHelperHealth(socketPath, { timeoutMs: 1_000 });
+    } catch (error) {
+      last = error;
+      await new Promise((resolve) => setTimeout(resolve, 200));
+    }
+  }
+  throw last ?? new Error("helper health probe timed out");
+}
+
+const socketPath = mintBrokerSocketPath();
+const workDir = mkdtempSync(join(tmpdir(), "zcode-cua-it-"));
+const helper = spawn(process.execPath, [entry, "--socket", socketPath, "--parent-pid", String(process.pid)], {
+  cwd: join(entry, ".."),
+  env: {
+    ...process.env,
+    ZCODE_CUA_HELPER_ADDON: addon,
+    // Windows 上 peer identity 校验尚未落地，本地验收必须显式打开 dev 位
+    ZCODE_CUA_DEV_MODE: "1",
+  },
+  stdio: ["ignore", "pipe", "pipe"],
+});
+let helperOutput = "";
+helper.stdout.on("data", (chunk) => (helperOutput += chunk));
+helper.stderr.on("data", (chunk) => (helperOutput += chunk));
+
+const runtime = createComputerUseRuntime({ brokerSocketPath: socketPath });
+const context = { sessionId: "it-session", runtimeScope: "main", workspaceKey: workDir };
+let failed = false;
+
+try {
+  log("socket_path", socketPath);
+  const health = await waitForHealth(socketPath);
+  log("helper_health", health);
+
+  const tools = await runtime.execute({ toolName: "list_apps", context });
+  const apps = JSON.parse(tools.content[0].text);
+  log("list_apps_count", apps.length);
+
+  execFileSync("cmd", ["/c", "start", "", "notepad"], { stdio: "ignore" });
+  await new Promise((resolve) => setTimeout(resolve, 1500));
+
+  const again = JSON.parse(
+    (await runtime.execute({ toolName: "list_apps", context })).content[0].text,
+  );
+  const notepad = again.find((app) => /notepad\.exe$/i.test(app.bundle_id ?? ""));
+  if (!notepad) throw new Error("notepad 未出现在 list_apps 中");
+  log("notepad_pid", notepad.pid);
+
+  const windows = await runtime.execute({
+    toolName: "list_windows",
+    arguments: { app_ref: { pid: notepad.pid } },
+    context,
+  });
+  log("list_windows", JSON.parse(windows.content[0].text));
+
+  const state = await runtime.execute({
+    toolName: "get_app_state",
+    arguments: { app_ref: { pid: notepad.pid }, include_screenshot: withShot },
+    context,
+  });
+  log("state_id", state.structuredContent?.state_id);
+  log("element_count", state.structuredContent?.elements?.length);
+  log("tree_head", String(state.structuredContent?.text ?? "").split("\n").slice(0, 3).join(" | "));
+  if (withShot) {
+    const image = (state.content ?? []).find((block) => block.type === "image");
+    log("screenshot_bytes", image ? image.data.length : 0);
+  }
+
+  const menuIndex = (state.structuredContent?.elements ?? []).findIndex(
+    (element) => element.kind === "menuitem" && (element.actions ?? []).includes("AXExpand"),
+  );
+  log("expandable_menu_index", menuIndex);
+  if (menuIndex >= 0) {
+    const action = await runtime.execute({
+      toolName: "perform_action",
+      arguments: { app_ref: { pid: notepad.pid }, target: { type: "element", index: menuIndex }, action: "AXExpand" },
+      context,
+    });
+    log("perform_action_receipt", action.structuredContent);
+    const after = await runtime.execute({
+      toolName: "get_app_state",
+      arguments: { app_ref: { pid: notepad.pid } },
+      context,
+    });
+    log("elements_after_expand", after.structuredContent?.elements?.length);
+  }
+
+  // 元素不存在时必须 fail closed（旧索引不可跨观察复用）
+  const stale = await runtime.execute({
+    toolName: "perform_action",
+    arguments: { app_ref: { pid: notepad.pid }, target: { type: "element", index: 9999 }, action: "AXPress" },
+    context,
+  });
+  log("stale_index_isError", stale.isError === true);
+  log("stale_index_code", JSON.parse(stale.content[0].text).code);
+
+  const unknown = await runtime.execute({ toolName: "computer_use", context });
+  log("unknown_method_isError", unknown.isError === true);
+
+  execFileSync("taskkill", ["/PID", String(notepad.pid), "/F"], { stdio: "ignore" });
+  console.log("RESULT: OK");
+} catch (error) {
+  failed = true;
+  console.error(`RESULT: FAILED ${error?.code ? `[${error.code}] ` : ""}${error?.message ?? String(error)}`);
+  if (helperOutput) console.error(`helper_output:\n${helperOutput.slice(-1500)}`);
+} finally {
+  await runtime.dispose().catch(() => {});
+  helper.kill();
+  rmSync(workDir, { recursive: true, force: true });
+  process.exit(failed ? 1 : 0);
+}
