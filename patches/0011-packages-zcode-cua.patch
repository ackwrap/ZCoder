@@ -0,0 +1,59 @@
+#!/usr/bin/env node
+/**
+ * 复现「装好的 app 里首个 CUA 调用失败」的链路，并验证懒启动修复：
+ *
+ *   仅给 socket 名 + 配方（等价 services 写进 agent spawn env 的东西），不预先起 Helper；
+ *   runtime 首次调用应自己 fork Helper，然后 list_apps 成功。
+ */
+import { randomBytes } from "node:crypto";
+import { createComputerUseRuntime } from "../index.js";
+
+const ROOT = process.env.ZCODE_CUA_TEST_INSTALL_ROOT;
+if (process.platform !== "win32" || !ROOT) {
+  console.error("Manual Windows probe: set ZCODE_CUA_TEST_INSTALL_ROOT to an authorized installation.");
+  process.exit(1);
+}
+const HELPER = `${ROOT}/resources/tools/cua-helper/helper/dist/windows-helper.js`;
+const ADDON = `${ROOT}/resources/tools/cua-helper/helper/build/Release/ax_native.node`;
+const prefix = String.raw`\\.\pipe\zcode-cua-helper-`;
+const socketPath = `${prefix}${randomBytes(8).toString("hex")}`;
+
+const recipe = {
+  command: `${ROOT}/ZCode.exe`,
+  entryPath: HELPER,
+  root: `${ROOT}/resources/tools/cua-helper/helper/dist`,
+  addonPath: ADDON,
+  commandEnv: { ELECTRON_RUN_AS_NODE: "1" },
+  hostPid: process.pid,
+};
+
+const env = {
+  ...process.env,
+  ZCODE_CUA_PERMISSION_BROKER_SOCKET: socketPath,
+  ZCODE_CUA_WIN_HELPER_RECIPE: JSON.stringify(recipe),
+};
+
+console.log("socket:", socketPath);
+
+const runtime = createComputerUseRuntime({ env });
+const started = Date.now();
+const result = await runtime.execute({
+  toolName: "list_apps",
+  arguments: {},
+  context: { sessionId: "lazy-launch", runtimeScope: "main", workspaceKey: "lazy-launch" },
+});
+const elapsed = Date.now() - started;
+await runtime.dispose();
+
+const text = result?.content?.[0]?.text ?? "";
+if (result?.isError) {
+  console.log("FAILED:", text.slice(0, 300));
+  process.exit(1);
+}
+const apps = JSON.parse(text);
+if (!Array.isArray(apps)) {
+  console.log("NOT_READY:", text.slice(0, 300));
+  process.exit(1);
+}
+console.log(`RESULT: OK (lazy launch + list_apps, ${apps.length} apps, ${elapsed}ms)`);
+process.exit(0);
