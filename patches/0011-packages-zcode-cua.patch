+#!/usr/bin/env node
+/**
+ * 产品链路验收（不含 Electron UI）：node_repl 宿主照正式方式跑起来，模型侧 `js` 工具里
+ * 用官方插件 SDK 驱动本机应用。
+ *
+ *   node packages/zcode-cua/test/product-loop.windows.mjs
+ *
+ * 结构：
+ *   Helper(真实进程) ──命名管道──> node_repl 宿主(products 里的 dist/mcp/server.js)
+ *                                  ├─ createComputerUseRuntime({ZCODE_CUA_PERMISSION_BROKER_SOCKET})
+ *                                  └─ cua-broker → Worker 里的 bridge 符号
+ *   模型侧：mcp tools/call "js" ⇒ setupComputerUseRuntime ⇒ agent.computerUse.listApps()
+ */
+import { spawn } from "node:child_process";
+import { createInterface } from "node:readline";
+import { existsSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { mintBrokerSocketPath, probeHelperHealth } from "../broker.js";
+
+const repoRoot = resolve("G:/tools/ZCode-plus/ZCode");
+const glmRoot = join(repoRoot, "packages/desktop/bundled-agents/win32-x64/glm");
+const hostEntry = join(glmRoot, "packages/node-repl-host/dist/mcp/server.js");
+const pluginClient = join(glmRoot, "packages/zcode-cua-plugin/scripts/computer-use-client.mjs");
+const helperRoot = join(repoRoot, "packages/zcode-cua/helper");
+const helperEntry = join(helperRoot, "dist/windows-helper.js");
+const helperAddon = join(helperRoot, "build/Release/ax_native.node");
+
+for (const path of [hostEntry, pluginClient, helperEntry, helperAddon]) {
+  if (!existsSync(path)) {
+    console.error(`missing: ${path}`);
+    process.exit(2);
+  }
+}
+
+const socketPath = mintBrokerSocketPath();
+const helper = spawn(process.execPath, [helperEntry, "--socket", socketPath, "--parent-pid", String(process.pid)], {
+  cwd: join(helperEntry, ".."),
+  env: { ...process.env, ZCODE_CUA_HELPER_ADDON: helperAddon },
+  stdio: ["ignore", "pipe", "pipe"],
+});
+let helperOutput = "";
+helper.stdout.on("data", (chunk) => (helperOutput += chunk));
+helper.stderr.on("data", (chunk) => (helperOutput += chunk));
+
+let ok = false;
+const host = spawn(process.execPath, [hostEntry], {
+  cwd: join(hostEntry, ".."),
+  env: {
+    ...process.env,
+    // 宿主唯一的 CUA 输入：broker 传输。官方 services 在 Agent spawn 时注入同名变量。
+    ZCODE_CUA_PERMISSION_BROKER_SOCKET: socketPath,
+    ZCODE_CUA_PLUGIN_ROOT: join(glmRoot, "packages/zcode-cua-plugin"),
+  },
+  stdio: ["pipe", "pipe", "pipe"],
+});
+let hostStderr = "";
+host.stderr.on("data", (chunk) => (hostStderr += chunk));
+
+const rl = createInterface({ input: host.stdout, crlfDelay: Infinity });
+const pending = new Map();
+let nextId = 1;
+rl.on("line", (line) => {
+  if (!line.trim()) return;
+  let message;
+  try {
+    message = JSON.parse(line);
+  } catch {
+    return;
+  }
+  const waiter = pending.get(message.id);
+  if (!waiter) return;
+  pending.delete(message.id);
+  waiter(message);
+});
+
+function request(method, params, timeoutMs = 120_000) {
+  const id = nextId++;
+  return new Promise((resolvePromise) => {
+    const timer = setTimeout(() => {
+      pending.delete(id);
+      resolvePromise({ error: { message: `timeout after ${timeoutMs}ms` } });
+    }, timeoutMs);
+    pending.set(id, (message) => {
+      clearTimeout(timer);
+      resolvePromise(message);
+    });
+    host.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`);
+  });
+}
+
+function notify(method, params) {
+  host.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", method, params })}\n`);
+}
+
+function textOf(result) {
+  const blocks = Array.isArray(result?.content) ? result.content : [];
+  return blocks
+    .filter((block) => block?.type === "text")
+    .map((block) => block.text)
+    .join("\n");
+}
+
+try {
+  const health = await probeHelperHealth(socketPath, { timeoutMs: 25_000 });
+  console.log("helper_health:", JSON.stringify(health));
+
+  // 2026-07-28 版协议取消了 initialize：客户端直接在每帧的 _meta 里声明版本/身份/能力。
+  const envelope = {
+    "io.modelcontextprotocol/protocolVersion": "2026-07-28",
+    "io.modelcontextprotocol/clientInfo": { name: "cua-product-loop", version: "0.0.0" },
+    "io.modelcontextprotocol/clientCapabilities": { tools: {} },
+  };
+
+  const list = await request("tools/list", { _meta: envelope });
+  const tools = (list.result?.tools ?? []).map((tool) => tool.name);
+  console.log("host_tools:", tools.join(","));
+
+  const code = `
+const { setupComputerUseRuntime } = await import(${JSON.stringify(pathToFileURL(pluginClient).href)});
+await setupComputerUseRuntime({ globals: globalThis });
+const apps = await agent.computerUse.listApps();
+const target = apps.find((app) => /notepad\\.exe$/i.test(app.bundle_id ?? ""));
+return {
+  target: agent.computerUse.computer.target,
+  appCount: apps.length,
+  notepad: target ?? null,
+};
+`;
+  const callMeta = {
+    ...envelope,
+    // 宿主只认这个命名空间：node_repl 用它构造 CUA/browser 的 request context。
+    "com.zcode/request-context": {
+      session_id: "product-loop",
+      turn_id: "turn-1",
+      runtime_scope: "main",
+      workspace_path: process.cwd(),
+      workspace_key: process.cwd(),
+    },
+  };
+  const called = await request("tools/call", { name: "js", arguments: { code }, _meta: callMeta });
+  const payload = textOf(called.result);
+  console.log("js_result:", payload.slice(0, 700));
+  // 模型侧拿到真实应用清单（含 notepad）就说明 bridge → runtime → Helper 整条链路通了。
+  ok = /notepad\.exe/i.test(payload) && /"apps"|appCount/.test(payload);
+  console.log("RESULT:", ok ? "OK (正式链路：host → bridge → runtime → Helper)" : "FAILED");
+} catch (error) {
+  console.error("FAILED:", error?.message ?? String(error));
+  if (hostStderr) console.error("host_stderr:", hostStderr.slice(-1500));
+  if (helperOutput) console.error("helper_output:", helperOutput.slice(-800));
+} finally {
+  host.kill();
+  helper.kill();
+  process.exit(ok ? 0 : 1);
+}
diff --git a/packages/zcode-cua/test/reconnect.test.ts b/packages/zcode-cua/test/reconnect.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f75adca1e05c0c78637422b8553bede7b368745a
--- /dev/null
+++ b/packages/zcode-cua/test/reconnect.test.ts
@@ -0,0 +1,148 @@
+import { randomUUID } from "node:crypto";
+import { createServer, type Server, type Socket } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { BrokerConnection } from "../broker.js";
+import { createComputerUseRuntime, type ComputerUseRuntime } from "../index.js";
+
+const context = { sessionId: "reconnect", runtimeScope: "main" as const, workspaceKey: "fixture" };
+type Request = { id: number; method: string; params: Record<string, unknown> };
+type Result = { isError?: boolean; content: Array<{ text: string }> };
+
+function payload(result: unknown) {
+  return JSON.parse((result as Result).content[0]!.text);
+}
+
+describe("Computer Use broker reconnect", () => {
+  let server: Server;
+  let runtime: ComputerUseRuntime;
+  let sockets: Set<Socket>;
+  let connections: BrokerConnection[];
+  let requests: Request[];
+  let intercept: ((request: Request, socket: Socket) => boolean) | undefined;
+
+  beforeEach(async () => {
+    sockets = new Set();
+    connections = [];
+    requests = [];
+    intercept = undefined;
+    const connect = BrokerConnection.connect.bind(BrokerConnection);
+    vi.spyOn(BrokerConnection, "connect").mockImplementation(async (...args) => {
+      const connection = await connect(...args);
+      connections.push(connection);
+      return connection;
+    });
+    const socketPath = process.platform === "win32"
+      ? `\\\\.\\pipe\\zcode-reconnect-${randomUUID()}`
+      : join(tmpdir(), `zcode-reconnect-${randomUUID()}.sock`);
+    server = createServer((socket) => {
+      sockets.add(socket);
+      socket.on("close", () => sockets.delete(socket));
+      socket.on("error", () => {});
+      socket.setEncoding("utf8");
+      let buffer = "";
+      socket.on("data", (chunk) => {
+        buffer += chunk;
+        for (;;) {
+          const end = buffer.indexOf("\n");
+          if (end < 0) break;
+          const request = JSON.parse(buffer.slice(0, end)) as Request;
+          buffer = buffer.slice(end + 1);
+          requests.push(request);
+          if (intercept?.(request, socket)) continue;
+          const result = request.method === "authenticate"
+            ? { authenticated: true }
+            : request.method === "capture_app"
+              ? { app: { pid: 7 }, state_id: "old-state", elements: [{ native: "old-token", editable: true }] }
+              : request.method === "list_applications"
+                ? [{ pid: 7, name: "Fixture", active: true }]
+                : { ok: true };
+          socket.write(`${JSON.stringify({ id: request.id, ok: true, result })}\n`);
+        }
+      });
+    });
+    await new Promise<void>((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(socketPath, resolve);
+    });
+    runtime = createComputerUseRuntime({
+      brokerSocketPath: socketPath,
+      ensureBrokerAvailable: async () => {},
+      connectTimeoutMs: 200,
+    });
+  });
+
+  afterEach(async () => {
+    await runtime?.dispose();
+    for (const socket of sockets) socket.destroy();
+    if (server.listening) {
+      await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    }
+    vi.restoreAllMocks();
+  });
+
+  async function disconnect() {
+    for (const socket of sockets) socket.destroy();
+    await expect.poll(() => connections.every((connection) => connection.closed)).toBe(true);
+  }
+
+  it("reconnects an existing session after the transport closes", async () => {
+    expect(payload(await runtime.execute({ toolName: "list_apps", context }))).toHaveLength(1);
+    await disconnect();
+    expect(payload(await runtime.execute({ toolName: "list_apps", context }))).toHaveLength(1);
+    expect(connections).toHaveLength(2);
+    expect(requests.filter((request) => request.method === "authenticate")).toHaveLength(2);
+  });
+
+  it("does not replay an action whose reply was lost, but reconnects on the next call", async () => {
+    intercept = (request, socket) => {
+      if (request.method !== "type_text") return false;
+      socket.destroy();
+      return true;
+    };
+    const failed = await runtime.execute({ toolName: "type", arguments: { text: "once" }, context });
+    expect((failed as Result).isError).toBe(true);
+    expect(payload(failed).code).toBe("broker_unavailable");
+    expect(requests.filter((request) => request.method === "type_text")).toHaveLength(1);
+    expect(connections).toHaveLength(1);
+    await expect.poll(() => connections[0]!.closed).toBe(true);
+    expect(payload(await runtime.execute({ toolName: "list_apps", context }))).toHaveLength(1);
+    expect(connections).toHaveLength(2);
+    expect(requests.filter((request) => request.method === "type_text")).toHaveLength(1);
+  });
+
+  it("drops stale element observations and requires a fresh capture after reconnect", async () => {
+    await runtime.execute({ toolName: "get_app_state", arguments: { app_ref: { pid: 7 } }, context });
+    await disconnect();
+    const input = {
+      toolName: "type",
+      arguments: { app_ref: { pid: 7 }, target: { type: "element", index: 0 }, text: "fresh only" },
+      context,
+    };
+    expect(payload(await runtime.execute(input)).code).toBe("element_unavailable");
+    expect(requests.some((request) => request.method === "element_set_value")).toBe(false);
+    await runtime.execute({ toolName: "get_app_state", arguments: { app_ref: { pid: 7 } }, context });
+    expect((await runtime.execute(input) as Result).isError).toBeFalsy();
+    expect(requests.filter((request) => request.method === "element_set_value")).toHaveLength(1);
+  });
+
+  it("returns retryable not-ready when the broker remains unavailable", async () => {
+    await runtime.execute({ toolName: "list_apps", context });
+    await disconnect();
+    await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    const result = await runtime.execute({ toolName: "list_apps", context });
+    expect((result as Result).isError).toBeFalsy();
+    expect(payload(result)).toMatchObject({ kind: "CUA_NOT_READY", retryable: true });
+  });
+
+  it("refreshes every stale session while reusing the new live connection", async () => {
+    const otherContext = { ...context, sessionId: "other" };
+    await runtime.execute({ toolName: "list_apps", context });
+    await runtime.execute({ toolName: "list_apps", context: otherContext });
+    await disconnect();
+    expect(payload(await runtime.execute({ toolName: "list_apps", context }))).toHaveLength(1);
+    expect(payload(await runtime.execute({ toolName: "list_apps", context: otherContext }))).toHaveLength(1);
+    expect(connections).toHaveLength(2);
+  });
+});
diff --git a/packages/zcode-cua/test/staged-runtime.windows.mjs b/packages/zcode-cua/test/staged-runtime.windows.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e269d71fd6f6f346df7df6cd1afc55c0ee11ac55
--- /dev/null
+++ b/packages/zcode-cua/test/staged-runtime.windows.mjs
@@ -0,0 +1,79 @@
+#!/usr/bin/env node
+/**
+ * 验证「打包后」的 Helper 运行时（staging 产物）能独立跑起来：entry + node_modules 闭包 + addon。
+ *
+ *   node packages/zcode-cua/test/staged-runtime.windows.mjs \
+ *        packages/desktop/bundled-tools/win32-x64/cua-helper
+ *
+ * 与 integration.windows.mjs 的区别：这里用的是 electron-builder 会打进安装包的那份目录，
+ * 所以它验证的是 PE 校验、sharp/@img 闭包、runtime-manifest 之后的产品形态。
+ */
+import { spawn } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+import { mintBrokerSocketPath, probeHelperHealth } from "../broker.js";
+import { createComputerUseRuntime } from "../index.js";
+
+const root = resolve(process.argv[2] ?? "packages/desktop/bundled-tools/win32-x64/cua-helper");
+const manifestPath = join(root, "runtime-manifest.json");
+if (!existsSync(manifestPath)) {
+  console.error(`missing runtime manifest: ${manifestPath}`);
+  process.exit(2);
+}
+const manifest = JSON.parse(readFileSync(manifestPath, "utf8"));
+const entry = join(root, manifest.entry);
+const addon = join(root, manifest.addon);
+const packageJson = JSON.parse(readFileSync(join(root, "package.json"), "utf8"));
+
+console.log("root:", root);
+console.log("manifest:", JSON.stringify({ packageVersion: manifest.packageVersion, electronVersion: manifest.electronVersion, entry: manifest.entry, addon: manifest.addon }));
+console.log("staged_package_json:", JSON.stringify({ name: packageJson.name, type: packageJson.type, main: packageJson.main }));
+
+const socketPath = mintBrokerSocketPath();
+const helper = spawn(process.execPath, [entry, "--socket", socketPath, "--parent-pid", String(process.pid)], {
+  cwd: root,
+  env: { ...process.env, ZCODE_CUA_HELPER_ADDON: addon },
+  stdio: ["ignore", "pipe", "pipe"],
+});
+let output = "";
+helper.stdout.on("data", (chunk) => (output += chunk));
+helper.stderr.on("data", (chunk) => (output += chunk));
+
+const runtime = createComputerUseRuntime({ brokerSocketPath: socketPath, connectTimeoutMs: 3_000 });
+const context = { sessionId: "staged", runtimeScope: "main", workspaceKey: root };
+let ok = false;
+try {
+  const health = await probeHelperHealth(socketPath, { timeoutMs: 25_000 });
+  console.log("health:", JSON.stringify(health));
+
+  const apps = JSON.parse(
+    (await runtime.execute({ toolName: "list_apps", context })).content[0].text,
+  );
+  console.log("list_apps:", apps.length);
+  const target = apps.find((app) => app.pid && app.bundle_id) ?? apps[0];
+  const state = await runtime.execute({
+    toolName: "get_app_state",
+    arguments: { app_ref: { pid: target.pid }, include_screenshot: true },
+    context,
+  });
+  const elements = state.structuredContent?.elements?.length ?? 0;
+  const image = (state.content ?? []).find((block) => block.type === "image");
+  console.log("elements:", elements, "| screenshot_bytes:", image ? image.data.length : 0);
+
+  // 打包形态里 sharp 必须真的可加载：Helper 若退回内置编码，说明闭包有问题。
+  const sharpDir = join(root, "node_modules", "sharp");
+  const sharpPlatformDir = join(root, "node_modules", "@img", "sharp-win32-x64");
+  console.log("sharp_present:", existsSync(sharpDir), "| sharp_platform_binary:", existsSync(sharpPlatformDir));
+  console.log("sharp_warning:", /sharp/i.test(output) ? output.split("\n").filter((line) => /sharp/i.test(line)).slice(0, 2) : "<none>");
+
+  ok = apps.length > 0 && elements > 0 && existsSync(sharpDir) && existsSync(sharpPlatformDir);
+} catch (error) {
+  console.error("FAILED:", error?.code ?? "", error?.message ?? String(error));
+  if (output) console.error("helper_output:", output.slice(-1200));
+} finally {
+  await runtime.dispose().catch(() => {});
+  helper.kill();
+  console.log(ok ? "RESULT: OK (staged runtime)" : "RESULT: FAILED (staged runtime)");
+  process.exit(ok ? 0 : 1);
+}
