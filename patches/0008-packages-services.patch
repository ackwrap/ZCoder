+import { createServiceDescriptor } from "../descriptors.js";
+import { ServiceChannels } from "@zcode/shared";
+
+/** No authorization_code, device_auth_id, tokens or client secrets. user_code is an explicit short-lived UI projection. */
+export interface CodexConnectionStatus {
+  connected: boolean;
+  method?: "browser" | "device";
+  loginAvailable: boolean;
+  flow?: {
+    id: string;
+    state: "waiting" | "connected" | "cancelled" | "failed";
+    error?: string;
+    device?: CodexDeviceCode;
+  };
+}
+
+/** Only the short-lived user-facing code, never the device authorization secret. */
+export interface CodexDeviceCode {
+  verificationUrl: string;
+  userCode: string;
+  expiresAt: number;
+}
+
+export interface ICodexProviderService {
+  status(providerId: string): Promise<CodexConnectionStatus>;
+  start(providerId: string): Promise<{ flowId: string; authorizeUrl: string }>;
+  startDevice(providerId: string): Promise<{ flowId: string } & CodexDeviceCode>;
+  cancel(providerId: string, flowId: string): Promise<void>;
+  disconnect(providerId: string): Promise<void>;
+}
+
+export const ICodexProviderService = createServiceDescriptor<ICodexProviderService>(
+  ServiceChannels.CodexProvider,
+);
+
+export interface CodexRequestAuthResolver {
+  resolve(
+    providerId: string,
+    sessionId: string,
+  ): Promise<{ apiKey: string; headers: Record<string, string>; codexMode?: "device" }>;
+}
diff --git a/packages/services/src/codex-provider/device.ts b/packages/services/src/codex-provider/device.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a1355aef3177306eee1154b7d87bba12c0fd856
--- /dev/null
+++ b/packages/services/src/codex-provider/device.ts
@@ -0,0 +1,140 @@
+// Device protocol reference: OpenCode v2.1.4 provider/openai.ts (MIT), explicit legacy method.
+import { z } from "zod";
+import {
+  CODEX_ISSUER,
+  CODEX_CLIENT_ID,
+  CODEX_HTTP_TIMEOUT_MS,
+  codexHeaders,
+  readCodexJson,
+  exchangeCodexCode,
+} from "./protocol.js";
+export const DEVICE_VERIFICATION_URL = `${CODEX_ISSUER}/codex/device`;
+const MAX_TIMER_MS = 2_147_483_647;
+const deviceSchema = z.object({
+  device_auth_id: z.string().min(1).max(4096),
+  user_code: z.string().regex(/^[A-Za-z0-9-]{4,64}$/),
+  interval: z.union([z.string().regex(/^\d+$/), z.number().int().positive()]).optional(),
+  expires_in: z.number().positive().optional(),
+});
+type Fetch = typeof globalThis.fetch;
+function wait(ms: number, signal: AbortSignal): Promise<void> {
+  signal.throwIfAborted();
+  return new Promise((resolve, reject) => {
+    const abort = () => {
+      clearTimeout(timer);
+      reject(signal.reason);
+    };
+    const timer = setTimeout(
+      () => {
+        signal.removeEventListener("abort", abort);
+        if (ms > MAX_TIMER_MS) resolve(wait(ms - MAX_TIMER_MS, signal));
+        else resolve();
+      },
+      Math.min(ms, MAX_TIMER_MS),
+    );
+    signal.addEventListener("abort", abort, { once: true });
+  });
+}
+async function post(
+  fetcher: Fetch,
+  path: string,
+  body: object | URLSearchParams,
+  signal: AbortSignal,
+): Promise<Response> {
+  signal.throwIfAborted();
+  return fetcher(`${CODEX_ISSUER}${path}`, {
+    method: "POST",
+    redirect: "error",
+    signal: AbortSignal.any([signal, AbortSignal.timeout(CODEX_HTTP_TIMEOUT_MS)]),
+    headers: codexHeaders(
+      body instanceof URLSearchParams ? "application/x-www-form-urlencoded" : "application/json",
+    ),
+    body: body instanceof URLSearchParams ? body.toString() : JSON.stringify(body),
+  });
+}
+export async function requestDeviceCode(fetcher: Fetch, signal: AbortSignal) {
+  const response = await post(
+    fetcher,
+    "/api/accounts/deviceauth/usercode",
+    { client_id: CODEX_CLIENT_ID },
+    signal,
+  );
+  if (!response.ok) {
+    void response.body?.cancel().catch(() => {});
+    throw new Error(
+      response.status === 404 ? "codex-device-unavailable" : "codex-device-request-failed",
+    );
+  }
+  const parsed = deviceSchema.safeParse(await readCodexJson(response));
+  if (!parsed.success) throw new Error("codex-device-response-invalid");
+  const intervalMs = Math.max(Number.parseInt(String(parsed.data.interval)) || 5, 1) * 1000 + 3000;
+  if (!Number.isFinite(intervalMs)) throw new Error("codex-device-response-invalid");
+  return {
+    ...parsed.data,
+    intervalMs,
+    expiresMs: Math.min(900, parsed.data.expires_in ?? 900) * 1000,
+  };
+}
+export async function pollDeviceTokens(
+  fetcher: Fetch,
+  device: Awaited<ReturnType<typeof requestDeviceCode>>,
+  signal: AbortSignal,
+) {
+  let interval = device.intervalMs;
+  while (true) {
+    signal.throwIfAborted();
+    const response = await post(
+      fetcher,
+      "/api/accounts/deviceauth/token",
+      { device_auth_id: device.device_auth_id, user_code: device.user_code },
+      signal,
+    );
+    if (response.ok) {
+      const parsed = z
+        .object({ authorization_code: z.string().min(1), code_verifier: z.string().min(1) })
+        .safeParse(await readCodexJson(response));
+      if (!parsed.success) throw new Error("codex-device-response-invalid");
+      return exchangeCodexCode(
+        fetcher,
+        parsed.data.authorization_code,
+        `${CODEX_ISSUER}/deviceauth/callback`,
+        { verifier: parsed.data.code_verifier },
+        signal,
+      );
+    }
+    const retryHeader = response.headers.get("retry-after");
+    const retryAfter =
+      retryHeader && Number.isNaN(Number(retryHeader))
+        ? (Date.parse(retryHeader) - Date.now()) / 1000
+        : Number(retryHeader);
+    let error: unknown;
+    try {
+      const value = await readCodexJson(response);
+      const raw = value && typeof value === "object" && "error" in value ? value.error : undefined;
+      error =
+        typeof raw === "string"
+          ? raw
+          : raw && typeof raw === "object" && "code" in raw
+            ? raw.code
+            : undefined;
+    } catch {
+      /* Legacy pending replies may have no JSON body. */
+    }
+    if (error === "access_denied" || error === "authorization_declined")
+      throw new Error("codex-authorization-denied");
+    if (error === "expired_token" || error === "expired_device_code")
+      throw new Error("codex-device-expired");
+    if (error === "slow_down" || response.status === 429)
+      interval = Math.max(
+        interval + 5000,
+        Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : 0,
+      );
+    else if (
+      error !== "authorization_pending" &&
+      response.status !== 403 &&
+      response.status !== 404
+    )
+      throw new Error("codex-device-poll-failed");
+    await wait(interval, signal);
+  }
+}
