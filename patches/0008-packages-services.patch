@@ -0,0 +1,311 @@
+import { describe, expect, it, vi } from "vitest";
+import { zcodeProtocolMethods, type AppCompactionPolicy } from "@zcode/shared";
+import { offPeakSelectionView } from "./fixtures/offPeakSelection.js";
+
+// docs/compaction-profiles.md「Host → CLI 同步」：压缩策略是 workspace 级事实，每个 workspace
+// 复用已有 client 串行同步；执行队列时读取最新持久化设置（Host 为权威），成功才记录已发策略。
+
+const WORKSPACE_PATH = "/workspace/compaction";
+const OTHER_WORKSPACE_PATH = "/workspace/other";
+
+const COMPACT: AppCompactionPolicy = {
+  profile: "compact",
+  tailBudgetTokens: 32_000,
+  summaryMaxOutputTokens: 12_000,
+};
+
+const DETAILED_DEFAULTS: AppCompactionPolicy = {
+  profile: "detailed",
+  tailBudgetTokens: 15_000,
+  summaryMaxOutputTokens: 8_000,
+};
+
+class MockProcessManagerBase {
+  onRuntimeLifecycle() {
+    return { dispose() {} };
+  }
+  onRuntimeRestarted() {
+    return { dispose() {} };
+  }
+  markReady() {}
+  getRuntimeIdentity(workspace: { workspacePath: string }) {
+    return {
+      generation: 1,
+      identity: "test-runtime",
+      workspaceKey: workspace.workspacePath,
+    };
+  }
+}
+
+function createFakeClient(request: (method: string, requestParams?: unknown) => Promise<unknown>) {
+  return {
+    request: vi.fn(request),
+    transportKind: "stdio" as const,
+    onNotification: () => ({ dispose() {} }),
+    onRequest: () => ({ dispose() {} }),
+    onClose: () => ({ dispose() {} }),
+  };
+}
+
+async function setup(params: {
+  resolver?: () => Promise<AppCompactionPolicy | undefined>;
+  policyResponse?: (requestParams: unknown) => unknown | Promise<unknown>;
+  requestsByWorkspace?: Map<string, (method: string, requestParams?: unknown) => Promise<unknown>>;
+}) {
+  const request = vi.fn(async (method: string, requestParams?: unknown) => {
+    if (method === zcodeProtocolMethods.workspaceUpdateCompactionPolicy) {
+      if (params.policyResponse) return params.policyResponse(requestParams);
+      return requestParams;
+    }
+    throw new Error(`Unexpected method ${method}`);
+  });
+  const clientsByWorkspace = new Map<string, ReturnType<typeof createFakeClient>>();
+  const getClient = vi.fn(async (workspace: { workspacePath: string }) => {
+    let client = clientsByWorkspace.get(workspace.workspacePath);
+    if (!client) {
+      const workspaceRequest = params.requestsByWorkspace?.get(workspace.workspacePath);
+      client = createFakeClient(workspaceRequest ?? request);
+      clientsByWorkspace.set(workspace.workspacePath, client);
+    }
+    return client;
+  });
+  vi.resetModules();
+  vi.doMock("../src/zcode-agent/zcodeAgentProcessManager.js", () => ({
+    ZCodeAgentProcessManager: class extends MockProcessManagerBase {
+      getClient = getClient;
+      getExistingClient = (workspace: { workspacePath: string }) =>
+        clientsByWorkspace.get(workspace.workspacePath) ?? null;
+      disposeWorkspace = async (workspace: { workspacePath: string }) => {
+        clientsByWorkspace.delete(workspace.workspacePath);
+      };
+      disposeAll() {}
+    },
+  }));
+  const { createZCodeAgentService } = await import("../src/zcode-agent/zcodeAgentService.js");
+  const service = createZCodeAgentService({
+    modelSelectionReadinessSource: { getView: async () => offPeakSelectionView() },
+    ...(params.resolver ? { resolveCompactionPolicy: params.resolver } : {}),
+  });
+  return { service, getClient, clientsByWorkspace, request };
+}
+
+function compactionCalls(request: ReturnType<typeof vi.fn>) {
+  return request.mock.calls.filter(
+    ([method]) => method === zcodeProtocolMethods.workspaceUpdateCompactionPolicy,
+  );
+}
+
+describe("workspace/updateCompactionPolicy 同步（Host 权威）", () => {
+  it("未装配 resolver 时首次连接仍推送一次默认 detailed 策略", async () => {
+    const { service, request } = await setup({});
+    try {
+      await expect(service.initialize({ workspacePath: WORKSPACE_PATH })).resolves.toEqual(
+        expect.objectContaining({ available: true }),
+      );
+      expect(compactionCalls(request)).toHaveLength(1);
+      expect(compactionCalls(request)[0]?.[1]).toMatchObject(DETAILED_DEFAULTS);
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("默认值也在首次连接时推送一次，之后相同值去重", async () => {
+    const { service, request } = await setup({
+      resolver: async () => DETAILED_DEFAULTS,
+    });
+    try {
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(1);
+      await service.syncCompactionPolicy(DETAILED_DEFAULTS);
+      expect(compactionCalls(request)).toHaveLength(1);
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("resolver 返回非整数/越界值时归一为默认，不把脏值下发给 strict CLI", async () => {
+    const { service, request } = await setup({
+      resolver: async () =>
+        ({
+          profile: "compact",
+          tailBudgetTokens: 1.2,
+          summaryMaxOutputTokens: 99_999,
+        }) as unknown as AppCompactionPolicy,
+    });
+    try {
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(1);
+      expect(compactionCalls(request)[0]?.[1]).toMatchObject({
+        profile: "compact",
+        tailBudgetTokens: 15_000,
+        summaryMaxOutputTokens: 8_000,
+      });
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("客户端就绪前推送当前策略；相同值再次同步时去重", async () => {
+    const { service, request } = await setup({
+      resolver: async () => COMPACT,
+    });
+    try {
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(1);
+      expect(compactionCalls(request)[0]?.[1]).toEqual({
+        workspace: expect.objectContaining({ workspacePath: WORKSPACE_PATH }),
+        profile: "compact",
+        tailBudgetTokens: 32_000,
+        summaryMaxOutputTokens: 12_000,
+      });
+
+      await service.syncCompactionPolicy(COMPACT);
+      expect(compactionCalls(request)).toHaveLength(1);
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("同一 workspace 串行：慢请求返回前不发下一条，最后落地的是最新设置", async () => {
+    let policy: AppCompactionPolicy = DETAILED_DEFAULTS;
+    let releaseFirst: (() => void) | undefined;
+    let compactionRequests = 0;
+    const { service, request } = await setup({
+      resolver: async () => policy,
+      policyResponse: async (value) => {
+        compactionRequests += 1;
+        // 第 1 次是首次连接的默认策略推送；让第 2 次（第一次设置变化）保持未完成。
+        if (compactionRequests === 2) {
+          await new Promise<void>((resolve) => {
+            releaseFirst = resolve;
+          });
+        }
+        return value;
+      },
+    });
+    try {
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(1);
+
+      policy = COMPACT;
+      const slow = service.syncCompactionPolicy(COMPACT);
+      await vi.waitFor(() => expect(releaseFirst).toBeDefined());
+      expect(compactionCalls(request)).toHaveLength(2);
+
+      const latest: AppCompactionPolicy = {
+        profile: "compact",
+        tailBudgetTokens: 40_000,
+        summaryMaxOutputTokens: 10_000,
+      };
+      policy = latest;
+      const fast = service.syncCompactionPolicy(latest);
+      // 第一条请求未返回时，下一次同步只能排队，不能并发覆盖。
+      expect(compactionCalls(request)).toHaveLength(2);
+
+      releaseFirst?.();
+      await Promise.all([slow, fast]);
+      const sent = compactionCalls(request).map(([, value]) => value);
+      expect(sent).toHaveLength(3);
+      expect(sent[2]).toMatchObject({
+        profile: "compact",
+        tailBudgetTokens: 40_000,
+        summaryMaxOutputTokens: 10_000,
+      });
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("existing-only 提升的 client 不假设 CLI 缺省：创建/恢复前补推一次（含默认值）", async () => {
+    const { service, getClient, request } = await setup({
+      resolver: async () => DETAILED_DEFAULTS,
+    });
+    try {
+      // 先让 processManager 持有一个已有 client（不经过 service 的 active entry）。
+      await getClient({ workspacePath: WORKSPACE_PATH });
+      await service.getWorkspaceRuntimeIdentity({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(0);
+
+      // 提升后的 entry key 未知，initialize（创建/恢复前）必须真实推送一次。
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(1);
+      expect(compactionCalls(request)[0]?.[1]).toMatchObject({
+        workspace: expect.objectContaining({ workspacePath: WORKSPACE_PATH }),
+        ...DETAILED_DEFAULTS,
+      });
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("-32601 后同一 client 不再重试；新 client 重建 entry 后重新尝试一次", async () => {
+    const { service, request } = await setup({
+      resolver: async () => COMPACT,
+      policyResponse: () => {
+        throw Object.assign(new Error("Method not found"), { code: -32601 });
+      },
+    });
+    try {
+      await expect(service.initialize({ workspacePath: WORKSPACE_PATH })).resolves.toEqual(
+        expect.objectContaining({ available: true }),
+      );
+      expect(compactionCalls(request)).toHaveLength(1);
+
+      // 同一 client 生命周期内设置变化/重复同步都不再发送未知方法（避免风暴）。
+      await service.syncCompactionPolicy(COMPACT);
+      await service.syncCompactionPolicy(DETAILED_DEFAULTS);
+      expect(compactionCalls(request)).toHaveLength(1);
+
+      // 新 client 重建 entry：unsupported 标记随之清除，再尝试一次。
+      await service.disposeWorkspace({ workspacePath: WORKSPACE_PATH });
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      expect(compactionCalls(request)).toHaveLength(2);
+    } finally {
+      service.disposeAll();
+    }
+  });
+
+  it("非 -32601 失败只告警且不影响其它 workspace 的同步", async () => {
+    const failing = vi.fn(async (method: string) => {
+      if (method === zcodeProtocolMethods.workspaceUpdateCompactionPolicy) {
+        throw new Error("request timed out");
+      }
+      throw new Error(`Unexpected method ${method}`);
+    });
+    const succeeding = vi.fn(async (method: string, requestParams?: unknown) => {
+      if (method === zcodeProtocolMethods.workspaceUpdateCompactionPolicy) return requestParams;
+      throw new Error(`Unexpected method ${method}`);
+    });
+    const { service, clientsByWorkspace } = await setup({
+      resolver: async () => COMPACT,
+      requestsByWorkspace: new Map([
+        [WORKSPACE_PATH, failing],
+        [OTHER_WORKSPACE_PATH, succeeding],
+      ]),
+    });
+    try {
+      await service.initialize({ workspacePath: WORKSPACE_PATH });
+      await service.initialize({ workspacePath: OTHER_WORKSPACE_PATH });
+      await expect(service.syncCompactionPolicy(COMPACT)).resolves.toBeUndefined();
+
+      // 失败方首次就绪同步 + 显式同步各尝试一次，都没有写入已接受缓存。
+      expect(clientsByWorkspace.get(WORKSPACE_PATH)?.request).toHaveBeenCalledTimes(2);
+      const otherCalls = clientsByWorkspace.get(OTHER_WORKSPACE_PATH)?.request.mock.calls ?? [];
+      expect(
+        otherCalls.filter(
+          ([method]) => method === zcodeProtocolMethods.workspaceUpdateCompactionPolicy,
+        ),
+      ).toEqual([
+        [
+          zcodeProtocolMethods.workspaceUpdateCompactionPolicy,
+          expect.objectContaining({
+            workspace: expect.objectContaining({ workspacePath: OTHER_WORKSPACE_PATH }),
+          }),
+          expect.anything(),
+        ],
+      ]);
+    } finally {
+      service.disposeAll();
+    }
+  });
+});
