+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { createServer, type Server, type ServerResponse } from "node:http";
+import { setTimeout as delay } from "node:timers/promises";
+import { createRemoteJWKSet, customFetch, jwtVerify } from "jose";
+import { z } from "zod";
+import { DEVICE_VERIFICATION_URL, requestDeviceCode, pollDeviceTokens } from "./device.js";
+import {
+  CODEX_ISSUER,
+  CODEX_CLIENT_ID,
+  CODEX_ORIGINATOR,
+  CODEX_USER_AGENT,
+  CODEX_CALLBACK_HOST,
+  CODEX_CALLBACK_PORTS,
+  CODEX_HTTP_TIMEOUT_MS,
+  generatePKCE,
+  authorizeURL,
+  exchangeCodexCode,
+  refreshCodexTokens,
+  accountIDFromVerifiedClaims,
+  type CodexTokens,
+} from "./protocol.js";
+import type {
+  CodexConnectionStatus,
+  CodexRequestAuthResolver,
+  ICodexProviderService,
+} from "./contract.js";
+
+const FLOW_TIMEOUT_MS = 10 * 60_000;
+const REFRESH_MARGIN_MS = 60_000;
+const CALLBACK_BIND_ATTEMPTS = 10;
+const CALLBACK_BIND_RETRY_DELAY_MS = 200;
+const providerIdSchema = z.string().trim().min(1).max(200);
+const storedSchema = z
+  .object({
+    hostID: z.string().min(1),
+    revision: z.string().min(1),
+    clientID: z.string().min(1).optional(),
+    tokens: z
+      .object({
+        access: z.string().min(1),
+        refresh: z.string().min(1),
+        expires: z.number().finite(),
+        scopes: z.array(z.string()),
+        method: z.enum(["browser", "device"]).optional(),
+        accountID: z.string().min(1).optional(),
+      })
+      .optional(),
+  })
+  .strict();
+type Stored = z.infer<typeof storedSchema>;
+interface Flow {
+  id: string;
+  state: "waiting" | "connected" | "cancelled" | "failed";
+  error?: string;
+  server?: Server;
+  device?: { verificationUrl: string; userCode: string; expiresAt: number };
+  abort: AbortController;
+  timer?: ReturnType<typeof setTimeout>;
+  completing: boolean;
+}
+interface Options {
+  onConnected?(providerId: string): void;
+  beforeIdentityChange?(providerId: string): Promise<void>;
+  credentials: {
+    load(key: string): Promise<string | null>;
+    save(key: string, value: string, assertCurrent?: () => void): Promise<void>;
+    delete(key: string): Promise<void>;
+  };
+  assertProvider(providerId: string): Promise<void>;
+  withLock<T>(providerId: string, run: () => Promise<T>): Promise<T>;
+  fetch: typeof globalThis.fetch;
+  /** Only the owning local desktop Host can start a loopback flow. */
+  canLogin: boolean;
+}
+
+export function createCodexProviderService(
+  options: Options,
+): ICodexProviderService &
+  CodexRequestAuthResolver & { dispose(): void; forget(providerId: string): Promise<void> } {
+  const flows = new Map<string, Flow>();
+  let disposed = false;
+  // 同一 Host 先排队，再进入跨进程锁，避免同窗并发 refresh 轮换同一令牌。
+  let queue: Promise<unknown> = Promise.resolve();
+  const locked = <T>(id: string, run: () => Promise<T>): Promise<T> => {
+    const result = queue.then(() => options.withLock(id, run));
+    queue = result.catch(() => {});
+    return result;
+  };
+  const key = (id: string) => `codex:${createHash("sha256").update(id).digest("hex")}`;
+  const load = async (id: string): Promise<Stored | null> => {
+    const raw = await options.credentials.load(key(id));
+    if (raw === null) return null;
+    // 不吞掉损坏记录，也不把可能含 token 的 schema issues 暴露给 UI / 日志。
+    try {
+      return storedSchema.parse(JSON.parse(raw));
+    } catch {
+      throw new Error("codex-credential-invalid");
+    }
+  };
+  const save = (id: string, record: Stored, assertCurrent?: () => void) =>
+    options.credentials.save(key(id), JSON.stringify(record), assertCurrent);
+  const assertLive = () => {
+    if (disposed) throw new Error("codex-host-closed");
+  };
+  const stop = (flow: Flow) => {
+    if (flow.timer) clearTimeout(flow.timer);
+    flow.abort.abort();
+    flow.server?.close();
+    flow.server?.closeIdleConnections();
+    delete flow.device;
+  };
+  const cancelFlow = (id: string) => {
+    const flow = flows.get(id);
+    if (flow?.state === "waiting") {
+      flow.state = "cancelled";
+      stop(flow);
+    }
+  };
+  const jwks = createRemoteJWKSet(new URL(`${CODEX_ISSUER}/.well-known/jwks.json`), {
+    timeoutDuration: CODEX_HTTP_TIMEOUT_MS,
+    [customFetch]: (url, init) => {
+      const headers = new Headers(init?.headers);
+      headers.set("User-Agent", CODEX_USER_AGENT);
+      return options.fetch(url, { ...init, headers, redirect: "error" });
+    },
+  });
+  const material = (tokens: CodexTokens, scopes?: string[]): NonNullable<Stored["tokens"]> => ({
+    access: tokens.access_token,
+    refresh: tokens.refresh_token,
+    expires: Date.now() + (tokens.expires_in ?? 3600) * 1000,
+    scopes: tokens.scope?.split(" ").filter(Boolean) ?? scopes ?? [],
+  });
+  const accountFromIDToken = async (token: string | undefined): Promise<string> => {
+    if (!token) throw new Error("codex-id-token-invalid");
+    try {
+      const { payload } = await jwtVerify(token, jwks, {
+        issuer: CODEX_ISSUER,
+        audience: CODEX_CLIENT_ID,
+        algorithms: ["RS256"],
+        requiredClaims: ["exp", "sub"],
+      });
+      if (typeof payload.sub !== "string" || !payload.sub.trim()) throw new Error();
+      return accountIDFromVerifiedClaims(payload);
+    } catch {
+      throw new Error("codex-id-token-invalid");
+    }
+  };
+
+  return {
+    async status(rawId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      await options.assertProvider(id);
+      const record = await load(id);
+      const flow = flows.get(id);
+      return {
+        connected: Boolean(record?.tokens?.accountID),
+        ...(record?.tokens
+          ? {
+              method:
+                record.tokens.method === "device" ? ("device" as const) : ("browser" as const),
+            }
+          : {}),
+        loginAvailable: options.canLogin,
+        ...(flow
+          ? {
+              flow: {
+                id: flow.id,
+                state: flow.state,
+                ...(flow.error ? { error: flow.error } : {}),
+                ...(flow.state === "waiting" && flow.device ? { device: { ...flow.device } } : {}),
+              },
+            }
+          : {}),
+      } satisfies CodexConnectionStatus;
+    },
+    async start(rawId) {
+      assertLive();
+      if (!options.canLogin) throw new Error("codex-local-desktop-required");
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await options.assertProvider(id);
+      return locked(id, async () => {
+        assertLive();
+        cancelFlow(id);
+        const previous = await load(id);
+        const record: Stored = {
+          ...previous,
+          hostID: previous?.hostID ?? `urn:uuid:${randomUUID()}`,
+          revision: randomUUID(),
+        };
+        await save(id, record);
+        const state = randomBytes(32).toString("base64url");
+        const pkce = await generatePKCE();
+        assertLive();
+        let redirect = "";
+        const flow: Flow = {
+          id: record.revision,
+          state: "waiting",
+          completing: false,
+          abort: new AbortController(),
+          server: createServer((req, res) => {
+            const url = new URL(req.url ?? "/", `http://${CODEX_CALLBACK_HOST}`);
+            if (req.method !== "GET" || url.pathname !== "/auth/callback") {
+              res.writeHead(404).end();
+              return;
+            }
+            // 必须先校验 state，错误回调同样受 CSRF 约束。
+            if (url.searchParams.get("state") !== state) {
+              respond(res, false);
+              return;
+            }
+            if (flow.state !== "waiting" || flow.completing) {
+              res.writeHead(409).end();
+              return;
+            }
+            flow.completing = true;
+            void (async () => {
+              try {
+                if (url.searchParams.has("error")) throw new Error("codex-authorization-denied");
+                const code = url.searchParams.get("code");
+                if (!code) throw new Error("codex-callback-incomplete");
+                // Codex 浏览器登录：官方 Codex client + PKCE，换完 token 后直接走
+                // chatgpt.com/backend-api/codex；这里不要求 token-sharing scope。
+                const tokens = await exchangeCodexCode(
+                  options.fetch,
+                  code,
+                  redirect,
+                  pkce,
+                  flow.abort.signal,
+                );
+                if (flow.abort.signal.aborted) throw new Error("codex-login-cancelled");
+                if (!tokens.id_token) throw new Error("codex-id-token-invalid");
+                const accountID = await accountFromIDToken(tokens.id_token);
+                await locked(id, async () => {
+                  assertLive();
+                  const current = await load(id);
+                  if (
+                    flow.state !== "waiting" ||
+                    flows.get(id) !== flow ||
+                    current?.revision !== record.revision
+                  )
+                    throw new Error("codex-login-cancelled");
+                  const assertAttempt = () => {
+                    assertLive();
+                    if (flow.state !== "waiting" || flows.get(id) !== flow)
+                      throw new Error("codex-login-cancelled");
+                  };
+                  await options.assertProvider(id);
+                  assertAttempt();
+                  try {
+                    // CredentialService 在其文件锁内复核代次；外层锁同时排除跨 Host 刷新。
+                    await save(
+                      id,
+                      { ...current, tokens: { ...material(tokens), method: "browser", accountID } },
+                      assertAttempt,
+                    );
+                    assertAttempt();
+                  } catch (error) {
+                    // 原子写入期间的取消无法撤回 IO；仍持有外层锁时恢复本次提交前的凭据，
+                    // 不用开始登录时的旧快照覆盖等待期间已经轮换过的 refresh token。
+                    if (flow.state !== "waiting" || disposed) await save(id, current);
+                    throw error;
+                  }
+                });
+                flow.state = "connected";
+                options.onConnected?.(id);
+                respond(res, true);
+              } catch (error) {
+                if (flow.state === "waiting") {
+                  flow.state = "failed";
+                  flow.error =
+                    error instanceof Error && /^codex-[a-z-]+(?:-\d{3})?$/.test(error.message)
+                      ? error.message
+                      : "codex-login-failed";
+                }
+                respond(res, false);
+              } finally {
+                stop(flow);
+              }
+            })();
+          }),
+        };
+        // 先登记 owner，端口绑定/重试期间的取消或 Host dispose 也必须能释放本次 listener。
+        flows.set(id, flow);
+        let port: number;
+        try {
+          port = await listenLoopback(flow.server!, flow.abort.signal);
+          assertLive();
+          if (flow.state !== "waiting" || flows.get(id) !== flow)
+            throw new Error("codex-login-cancelled");
+        } catch {
+          const message = disposed
+            ? "codex-host-closed"
+            : flow.abort.signal.aborted
+              ? "codex-login-cancelled"
+              : "codex-loopback-unavailable";
+          flow.state = flow.abort.signal.aborted ? "cancelled" : "failed";
+          flow.error = message;
+          stop(flow);
+          throw new Error(message);
+        }
+        redirect = `http://${CODEX_CALLBACK_HOST}:${port}/auth/callback`;
+        flow.timer = setTimeout(() => {
+          if (flow.state === "waiting") {
+            flow.state = "failed";
+            flow.error = "codex-login-timeout";
+            stop(flow);
+          }
+        }, FLOW_TIMEOUT_MS);
+        flow.timer.unref();
+        // 与 opencode openai.ts 的 Codex 浏览器登录保持一致：官方 Codex client、
+        // 固定 loopback 端口、简化授权流程，登录后走 Codex 后端而不是 token sharing。
+        return { flowId: flow.id, authorizeUrl: authorizeURL(redirect, pkce, state) };
+      });
+    },
+    async startDevice(rawId) {
+      assertLive();
+      if (!options.canLogin) throw new Error("codex-local-desktop-required");
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await options.assertProvider(id);
+      const flow = await locked(id, async () => {
+        assertLive();
+        cancelFlow(id);
+        const previous = await load(id);
+        const revision = randomUUID();
+        await save(id, {
+          ...previous,
+          hostID: previous?.hostID ?? `urn:uuid:${randomUUID()}`,
+          revision,
+        });
+        const next: Flow = {
+          id: revision,
+          state: "waiting",
+          abort: new AbortController(),
+          completing: false,
+        };
+        flows.set(id, next);
+        next.timer = setTimeout(() => {
+          if (next.state === "waiting") {
+            next.state = "failed";
+            next.error = "codex-device-expired";
+            stop(next);
+          }
+        }, 900_000);
+        next.timer.unref();
+        return next;
+      });
+      const assertAttempt = () => {
+        assertLive();
+        if (flow.state !== "waiting" || flows.get(id) !== flow)
+          throw new Error("codex-login-cancelled");
+      };
+      const fail = (error: unknown) => {
+        if (flow.state === "waiting") {
+          flow.state = "failed";
+          flow.error =
+            error instanceof Error && /^codex-[a-z-]+$/.test(error.message)
+              ? error.message
+              : "codex-device-login-failed";
+        }
+        stop(flow);
+      };
+      try {
+        const device = await requestDeviceCode(options.fetch, flow.abort.signal);
+        assertAttempt();
+        if (flow.timer) clearTimeout(flow.timer);
+        flow.device = {
+          verificationUrl: DEVICE_VERIFICATION_URL,
+          userCode: device.user_code,
+          expiresAt: Date.now() + device.expiresMs,
+        };
+        flow.timer = setTimeout(() => {
+          if (flow.state === "waiting") {
+            flow.state = "failed";
+            flow.error = "codex-device-expired";
+            stop(flow);
+          }
+        }, device.expiresMs);
+        flow.timer.unref();
+        const result = { flowId: flow.id, ...flow.device };
+        void (async () => {
+          try {
+            const tokens = await pollDeviceTokens(options.fetch, device, flow.abort.signal);
+            assertAttempt();
+            const accountID = await accountFromIDToken(tokens.id_token);
+            await locked(id, async () => {
+              assertAttempt();
+              await options.assertProvider(id);
+              const current = await load(id);
+              if (!current || current.revision !== flow.id)
+                throw new Error("codex-login-cancelled");
+              try {
+                await save(
+                  id,
+                  { ...current, tokens: { ...material(tokens), method: "device", accountID } },
+                  assertAttempt,
+                );
+                assertAttempt();
+              } catch (error) {
+                if (flow.state !== "waiting" || disposed) await save(id, current);
+                throw error;
+              }
+            });
+            flow.state = "connected";
+            options.onConnected?.(id);
+            stop(flow);
+          } catch (error) {
+            fail(error);
+          }
+        })();
+        return result;
+      } catch (error) {
+        fail(error);
+        throw new Error(flow.error ?? "codex-device-login-failed");
+      }
+    },
+    async cancel(rawId, flowId) {
+      const id = providerIdSchema.parse(rawId);
+      const flow = flows.get(id);
+      if (!flow || flow.id !== flowId || flow.state !== "waiting") return;
+      cancelFlow(id);
+      await locked(id, async () => {
+        const record = await load(id);
+        if (record?.revision === flowId) await save(id, { ...record, revision: randomUUID() });
+      });
+    },
+    async disconnect(rawId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await locked(id, async () => {
+        const record = await load(id);
+        if (!record) return;
+        const { tokens: _, ...identity } = record;
+        await save(id, { ...identity, revision: randomUUID() });
+      });
+    },
+    async forget(rawId) {
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await locked(id, () => options.credentials.delete(key(id)));
+    },
+    async resolve(rawId, sessionId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      await options.assertProvider(id);
+      return locked(id, async (): ReturnType<CodexRequestAuthResolver["resolve"]> => {
+        assertLive();
+        const record = await load(id);
+        let tokens = record?.tokens;
+        if (!record || !tokens?.accountID) throw new Error("codex-login-required");
+        const method = tokens.method ?? "browser";
+        const accountID = tokens.accountID;
+        if (tokens.expires <= Date.now() + REFRESH_MARGIN_MS) {
+          const refreshed = await refreshCodexTokens(options.fetch, tokens.refresh);
+          const refreshedAccount = refreshed.id_token
+            ? await accountFromIDToken(refreshed.id_token)
+            : accountID;
+          if (refreshedAccount !== accountID) throw new Error(`codex-${method}-account-mismatch`);
+          assertLive();
+          await options.assertProvider(id);
+          tokens = { ...material(refreshed, tokens.scopes), method, accountID };
+          await save(id, { ...record, tokens });
+        }
+        // 浏览器 Codex 登录同样使用 Codex 后端：请求头、账号 ID 与 device 分支一致。
+        return {
+          apiKey: tokens.access,
+          codexMode: "device" as const,
+          headers: {
+            "chatgpt-account-id": accountID,
+            originator: CODEX_ORIGINATOR,
+            "User-Agent": CODEX_USER_AGENT,
+            "x-codex-beta-features": "remote_compaction_v2",
+            "session-id": sessionId,
+            "thread-id": sessionId,
+            "x-client-request-id": sessionId,
+          },
+        };
+      });
+    },
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      for (const id of flows.keys()) cancelFlow(id);
+      flows.clear();
+    },
+  };
+}
+
+async function listenLoopback(server: Server, signal: AbortSignal): Promise<number> {
+  for (const port of CODEX_CALLBACK_PORTS) {
+    for (let attempt = 0; attempt < CALLBACK_BIND_ATTEMPTS; attempt++) {
+      signal.throwIfAborted();
+      try {
+        await new Promise<void>((resolve, reject) => {
+          const onError = (error: Error) => {
+            server.off("listening", onListening);
+            reject(error);
+          };
+          const onListening = () => {
+            server.off("error", onError);
+            if (signal.aborted) {
+              server.close();
+              reject(signal.reason);
+            } else resolve();
+          };
+          server.once("error", onError);
+          server.once("listening", onListening);
+          server.listen(port, CODEX_CALLBACK_HOST);
+        });
+        return port;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "EADDRINUSE") throw error;
+        // 只重试自己拥有的绑定，不向未知端口发送上游的 /cancel 请求。
+        if (attempt + 1 < CALLBACK_BIND_ATTEMPTS)
+          await delay(CALLBACK_BIND_RETRY_DELAY_MS, undefined, { signal });
+      }
+    }
+  }
+  throw new Error("codex-loopback-unavailable");
+}
+
+function respond(response: ServerResponse, success: boolean) {
+  response
+    .writeHead(success ? 200 : 400, {
+      "Content-Type": "text/html; charset=utf-8",
+      "Cache-Control": "no-store",
+      "Content-Security-Policy": "default-src 'none'; frame-ancestors 'none'",
+      "Referrer-Policy": "no-referrer",
+    })
+    .end(
+      `<!doctype html><title>ZCode Codex</title><p>${success ? "Authorization complete. Return to ZCode." : "Authorization failed. Return to ZCode and try again."}</p>`,
+    );
+}
