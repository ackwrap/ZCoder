+        refresh_token: "test-refresh",
+        ...(omitID ? {} : { id_token: id }),
+        expires_in: 3600,
+        scope: CODEX_SCOPES,
+      });
+    },
+  };
+  const service = createCodexProviderService(options);
+  services.push(service);
+  return {
+    service,
+    values,
+    calls,
+    onConnected,
+    beforeIdentityChange,
+    async start() {
+      const result = await service.start("test-codex");
+      return { ...result, url: new URL(result.authorizeUrl) };
