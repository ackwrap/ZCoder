+describe("Codex loopback ownership", () => {
+  it("falls back to 1457 without sending /cancel to an unrelated listener", async () => {
+    const requests: string[] = [];
+    const blocker = createServer((request, response) => {
+      requests.push(request.url ?? "");
+      response.end();
+    });
+    await occupyCallbackPort(blocker);
+    try {
+      const f = await fixture();
+      const started = await f.start();
+      expect(new URL(started.url.searchParams.get("redirect_uri")!).port).toBe("1457");
+      expect(requests).toEqual([]);
+      await f.service.cancel("test-codex", started.flowId);
+    } finally {
+      await new Promise<void>((resolve) => blocker.close(() => resolve()));
+    }
+  });
+
+  it("aborts binding retries when the Host owner is disposed", async () => {
+    const blocker = createServer();
+    await occupyCallbackPort(blocker);
+    try {
+      const f = await fixture();
+      const rejected = expect(f.start()).rejects.toThrow("codex-host-closed");
+      await vi.waitFor(async () =>
+        expect((await f.service.status("test-codex")).flow?.state).toBe("waiting"),
+      );
+      f.service.dispose();
+      await rejected;
+      expect(blocker.listening).toBe(true);
+      expect(f.calls).toHaveLength(0);
+    } finally {
+      await new Promise<void>((resolve) => blocker.close(() => resolve()));
+    }
+  });
