@@ -0,0 +1,154 @@
+// OAuth wire helpers adapted from anomalyco/opencode v2.1.4,
+// packages/core/src/plugin/provider/openai.ts (MIT; see docs/third-party/opencode-codex-MIT.txt).
+// ZCode retains its existing bounded IO, JWT verification and credential lifecycle protections.
+import { z } from "zod";
+
+export const CODEX_ISSUER = "https://auth.openai.com";
+export const CODEX_CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann";
+export const CODEX_SCOPES = "openid profile email offline_access";
+export const CODEX_ORIGINATOR = "opencode";
+export const CODEX_CALLBACK_HOST = "localhost";
+export const CODEX_CALLBACK_PORTS = [1455, 1457] as const;
+// 本机 opencode v2.1.4 内嵌的实际 UA，不使用 App.make() 的 unknown 缺省占位值。
+export const CODEX_USER_AGENT = "opencode/latest/2.1.4/cli";
+export const CODEX_HTTP_TIMEOUT_MS = 20_000;
+const MAX_JSON_BYTES = 64 * 1024;
+const PKCE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
+const tokenSchema = z.object({
+  access_token: z.string().min(1),
+  refresh_token: z.string().min(1),
+  id_token: z.string().min(1).optional(),
+  expires_in: z.number().positive().optional(),
+  scope: z.string().optional(),
+});
+export type CodexTokens = z.infer<typeof tokenSchema>;
+
+export async function generatePKCE() {
+  const verifier = Array.from(
+    crypto.getRandomValues(new Uint8Array(43)),
+    (byte) => PKCE_CHARS[byte % PKCE_CHARS.length],
+  ).join("");
+  const challenge = Buffer.from(
+    await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier)),
+  ).toString("base64url");
+  return { verifier, challenge };
+}
+
+export function authorizeURL(redirect: string, pkce: { challenge: string }, state: string) {
+  return `${CODEX_ISSUER}/oauth/authorize?${new URLSearchParams({
+    response_type: "code",
+    client_id: CODEX_CLIENT_ID,
+    redirect_uri: redirect,
+    scope: CODEX_SCOPES,
+    code_challenge: pkce.challenge,
+    code_challenge_method: "S256",
+    id_token_add_organizations: "true",
+    codex_cli_simplified_flow: "true",
+    state,
+    originator: CODEX_ORIGINATOR,
+  })}`;
+}
+
+export function codexHeaders(contentType: string) {
+  return { "Content-Type": contentType, "User-Agent": CODEX_USER_AGENT };
+}
+
+export async function readCodexJson(response: Response): Promise<unknown> {
+  if (!response.body) throw new Error("codex-device-response-invalid");
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      length += value.length;
+      if (length > MAX_JSON_BYTES) throw new Error("codex-device-response-invalid");
+      chunks.push(value);
+    }
+    try {
+      return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    } catch {
+      throw new Error("codex-device-response-invalid");
+    }
+  } finally {
+    void reader.cancel().catch(() => {});
+  }
+}
+
+async function requestTokens(
+  fetcher: typeof globalThis.fetch,
+  body: URLSearchParams,
+  signal?: AbortSignal,
+): Promise<CodexTokens> {
+  signal?.throwIfAborted();
+  const response = await fetcher(`${CODEX_ISSUER}/oauth/token`, {
+    method: "POST",
+    redirect: "error",
+    headers: codexHeaders("application/x-www-form-urlencoded"),
+    body: body.toString(),
+    signal: signal
+      ? AbortSignal.any([signal, AbortSignal.timeout(CODEX_HTTP_TIMEOUT_MS)])
+      : AbortSignal.timeout(CODEX_HTTP_TIMEOUT_MS),
+  });
+  if (!response.ok) {
+    void response.body?.cancel().catch(() => {});
+    throw new Error(`codex-token-http-${response.status}`);
+  }
+  const parsed = tokenSchema.safeParse(await readCodexJson(response));
+  if (!parsed.success) throw new Error("codex-token-invalid");
+  return parsed.data;
+}
+
+export function exchangeCodexCode(
+  fetcher: typeof globalThis.fetch,
+  code: string,
+  redirect: string,
+  pkce: { verifier: string },
+  signal: AbortSignal,
+) {
+  return requestTokens(
+    fetcher,
+    new URLSearchParams({
+      grant_type: "authorization_code",
+      code,
+      redirect_uri: redirect,
+      client_id: CODEX_CLIENT_ID,
+      code_verifier: pkce.verifier,
+    }),
+    signal,
+  );
+}
+
+export function refreshCodexTokens(
+  fetcher: typeof globalThis.fetch,
+  refreshToken: string,
+  signal?: AbortSignal,
+) {
+  return requestTokens(
+    fetcher,
+    new URLSearchParams({
+      grant_type: "refresh_token",
+      refresh_token: refreshToken,
+      client_id: CODEX_CLIENT_ID,
+    }),
+    signal,
+  );
+}
+
+const accountID = z.string().trim().min(1).max(300);
+const claimsSchema = z.object({
+  chatgpt_account_id: accountID.optional(),
+  "https://api.openai.com/auth": z.object({ chatgpt_account_id: accountID.optional() }).optional(),
+  organizations: z.array(z.object({ id: accountID })).optional(),
+});
+/** 取值顺序沿用上游；输入必须由调用方先做 JWT 签名/issuer/audience/exp/sub 校验。 */
+export function accountIDFromVerifiedClaims(payload: unknown) {
+  const claims = claimsSchema.parse(payload);
+  const value =
+    claims.chatgpt_account_id ??
+    claims["https://api.openai.com/auth"]?.chatgpt_account_id ??
+    claims.organizations?.[0]?.id;
+  if (!value) throw new Error("codex-id-token-invalid");
+  return value;
+}
