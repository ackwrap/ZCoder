index 0000000000000000000000000000000000000000..a2a17314deb8fcd735803f2fd8620c9d7cbce8a8
--- /dev/null
+++ b/packages/services/src/provider-model-discovery/contract.ts
@@ -0,0 +1,44 @@
+import type {
+  ModelConfigObject,
+  ProviderConfigObject,
+  ProviderSettingsProviderView,
+  ProviderSettingsView,
+} from "@zcode/provider";
+
+export interface DiscoveredProviderModel {
+  readonly modelId: string;
+  readonly config: ModelConfigObject;
+}
+export interface ProviderModelDiscoveryState {
+  readonly status: "idle" | "loading" | "ready" | "error" | "unsupported";
+  readonly count?: number;
+  readonly reportedParameters?: number;
+  readonly error?: "auth" | "network" | "invalid-response" | "empty" | "timeout" | "stale";
+}
+/** Host-private owner. Only getState / refresh are projected through ProviderSettings RPC. */
+export interface ProviderModelDiscovery {
+  getState(providerId: string): ProviderModelDiscoveryState;
+  refresh(providerId: string): Promise<ProviderModelDiscoveryState>;
+  schedule(providerId: string): void;
+  cancel(providerId: string): Promise<void>;
+  beforeSave(providerId: string, config: ProviderConfigObject, enabled?: boolean): Promise<void>;
+  saved(
+    before: ProviderSettingsProviderView | undefined,
+    after: ProviderSettingsProviderView | undefined,
+  ): void;
+  dispose(): void;
+}
+export interface ProviderModelDiscoveryOptions {
+  readonly getView: () => Promise<ProviderSettingsView>;
+  readonly merge: (input: {
+    providerId: string;
+    basedOnRevision: number;
+    models: readonly DiscoveredProviderModel[];
+    assertCurrent: () => void;
+  }) => Promise<unknown>;
+  readonly fetch: typeof globalThis.fetch;
+  readonly codexAuth: (
+    providerId: string,
+  ) => Promise<{ apiKey: string; codexMode?: "device"; headers?: Record<string, string> }>;
+  readonly clientVersion?: string;
