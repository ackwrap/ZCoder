index 0000000000000000000000000000000000000000..0b1d31effc42166cfdd95d557d84565fd7abf3ae
--- /dev/null
+++ b/packages/ui/test/browser/manual-review/pending/work-history.fixture.tsx
@@ -0,0 +1,104 @@
+import { useState } from "react";
+import { createRoot } from "react-dom/client";
+import type { ConversationRow, TurnHeaderRow } from "@zcode/shared/zcode-protocol-v4";
+import { TooltipProvider } from "@/components/ui/tooltip.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+import { ConversationTurnGroup } from "@/v4/ConversationTurnGroup.js";
+import { buildConversationTurnRenderUnits } from "@/v4/conversationTurnRenderUnits.js";
+import "@/styles.css";
+
+const query = new URLSearchParams(location.search);
+const mobile = query.get("mobile") === "true";
+const theme = query.get("theme") === "light" ? "light" : "dark";
+document.documentElement.className = `${theme} theme-zai-${theme}`;
+const startedAt = 1_700_000_000_000;
+function at(rowId: number) {
+  return { rowId, turnId: "work-history", createdAt: startedAt + rowId, createdAtSeq: rowId };
+}
+
+function Fixture() {
+  const [state, setState] = useState<TurnHeaderRow["state"]>(
+    query.get("running") === "true" ? "running" : "completedSuccess",
+  );
+  const [revision, setRevision] = useState(0);
+  const [guided, setGuided] = useState(false);
+  const rows: ConversationRow[] = [
+    {
+      ...at(1),
+      kind: "turnHeader",
+      origin: "userInput",
+      state,
+      startedAt,
+      ...(state === "running" ? {} : { endedAt: startedAt + 2_000 }),
+    },
+    { ...at(2), kind: "userInput", origin: "realUser", text: "Inspect project" },
+    { ...at(3), kind: "assistantText", state: "complete", text: "First work detail" },
+    { ...at(4), kind: "reasoning", state: "complete", text: "Nested reasoning detail" },
+    {
+      ...at(5),
+      kind: "assistantText",
+      entityId: "answer-first",
+      state: state === "running" ? "streaming" : "complete",
+      text: `Final answer ${revision}`,
+    },
+    ...(guided
+      ? [
+          {
+            ...at(6),
+            kind: "userInput" as const,
+            origin: "realUser" as const,
+            guided: true,
+            entityId: "guide-1",
+            text: "Continue",
+          },
+          {
+            ...at(7),
+            kind: "assistantText" as const,
+            state: "complete" as const,
+            text: "Second work detail",
+          },
+          {
+            ...at(8),
+            kind: "assistantText" as const,
+            state: "complete" as const,
+            text: "Second final answer",
+          },
+        ]
+      : []),
+  ];
+  const [unit] = buildConversationTurnRenderUnits(rows);
+  return (
+    <main className="min-h-dvh bg-background text-foreground @container/conversation">
+      <div className="flex flex-wrap gap-2 p-4">
+        <button data-testid="complete" onClick={() => setState("completedSuccess")}>
+          Complete
+        </button>
+        <button data-testid="refresh" onClick={() => setRevision((value) => value + 1)}>
+          Refresh snapshot
+        </button>
+        <button data-testid="add-guide" onClick={() => setGuided(true)}>
+          Add guide
+        </button>
+        <output data-testid="phase">{state}</output>
+      </div>
+      <ConversationTurnGroup
+        unit={unit!}
+        context={{
+          workspacePath: "/fixture",
+          theme,
+          codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+          compactForRemoteControl: mobile,
+        }}
+      />
+    </main>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(
+  <TooltipProvider>
+    <ZCodeIntlProvider initialLocale={mobile ? "en-US" : "zh-CN"}>
+      <Fixture />
+    </ZCodeIntlProvider>
+  </TooltipProvider>,
+);
diff --git a/packages/ui/test/browser/manual-review/pending/work-history.test.mjs b/packages/ui/test/browser/manual-review/pending/work-history.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fd9356d59fd3a493286b42787c436cb999359f88
--- /dev/null
+++ b/packages/ui/test/browser/manual-review/pending/work-history.test.mjs
@@ -0,0 +1,132 @@
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/work-history.fixture.tsx";
+const artifacts = join(root, "packages/desktop/.e2e-artifacts/work-history-default-open");
+let server, browser, origin;
+before(async () => {
+  await mkdir(artifacts, { recursive: true });
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      react(),
+      tailwindcss(),
+      {
+        name: "work-history-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: {
+      host: "127.0.0.1",
+      port: 0,
+      hmr: false,
+      watch: { ignored: ["**/.e2e-artifacts/**"] },
+    },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+
+for (const mobile of [false, true])
+  for (const theme of ["light", "dark"])
+    for (const running of [false, true]) {
+      test(`work history ${mobile ? "mobile" : "desktop"}/${theme}/${running ? "running-to-complete" : "history-and-guide"}`, async () => {
+        const page = await browser.newPage({
+          viewport: { width: mobile ? 390 : 1200, height: 900 },
+          isMobile: mobile,
+          hasTouch: mobile,
+        });
+        const errors = [];
+        page.on("pageerror", (error) => errors.push(String(error)));
+        try {
+          await page.goto(
+            `${origin}fixture?${new URLSearchParams({ mobile: String(mobile), theme, running: String(running) })}`,
+          );
+          const history = page.getByTestId("chat-assistant-history-trigger-work-history");
+          const detail = page.getByTestId("v4-row-3");
+          await history.waitFor();
+          assert.equal(await history.getAttribute("aria-expanded"), "true");
+          await detail.waitFor({ state: "visible" });
+          if (running) {
+            await page.getByTestId("complete").click();
+            await page.getByTestId("phase").filter({ hasText: "completedSuccess" }).waitFor();
+            assert.equal(await history.getAttribute("aria-expanded"), "true");
+            await detail.waitFor({ state: "visible" });
+          }
+          assert.equal(
+            await page.getByTestId("v4-row-4").locator('[aria-expanded="false"]').count(),
+            1,
+          );
+          await page
+            .getByTestId("chat-assistant-history-content-work-history")
+            .evaluate(async (element) => {
+              await Promise.all(
+                element.getAnimations({ subtree: true }).map((animation) => animation.finished),
+              );
+            });
+          await page.screenshot({
+            path: join(
+              artifacts,
+              `${mobile ? "mobile" : "desktop"}-${theme}-${running ? "completed" : "history"}.png`,
+            ),
+          });
+          await history.click();
+          await detail.waitFor({ state: "hidden" });
+          await page.getByTestId("v4-row-5").waitFor({ state: "visible" });
+          await page.getByTestId("refresh").click();
+          await page.getByTestId("v4-row-5").filter({ hasText: "Final answer 1" }).waitFor();
+          assert.equal(await history.getAttribute("aria-expanded"), "false");
+          await history.focus();
+          await page.keyboard.press("Enter");
+          await detail.waitFor({ state: "visible" });
+          await history.click();
+          await detail.waitFor({ state: "hidden" });
+          await page.getByTestId("add-guide").click();
+          const next = page.getByTestId(
+            "chat-assistant-history-trigger-work-history:guide:guide-1",
+          );
+          await next.waitFor();
+          assert.equal(await history.getAttribute("aria-expanded"), "false");
+          assert.equal(await next.getAttribute("aria-expanded"), "true");
+          await page.getByTestId("v4-row-7").waitFor({ state: "visible" });
+          assert.equal(
+            await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+            true,
+          );
+          assert.deepEqual(errors, []);
+        } finally {
+          await page.close();
+        }
+      });
+    }
