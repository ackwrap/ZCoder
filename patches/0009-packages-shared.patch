new file mode 100644
index 0000000000000000000000000000000000000000..61cb4fb6adf50648c5d43563a671155b519ff83a
--- /dev/null
+++ b/packages/shared/test/requestVerificationPolicy.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  isRequestSecurityFailure,
+  requestSecuritySensitiveHeaders,
+} from "../src/request-security-edition/policy.js";
+import {
+  CAPTCHA_VERIFY_PARAM_HEADER,
+  CAPTCHA_VERIFY_REGION_HEADER,
+  REQUEST_VERIFICATION_REQUIRED,
+  allowRequestVerificationHeaders,
+  isRequestVerificationMessage,
+  readRequestVerificationConfig,
+  requestVerificationClaimHeaders,
+  requestVerificationDiagnostics,
+  requestVerificationInteractionAvailable,
+  requestVerificationReasons,
+  requestVerificationTimeoutMessage,
+  requiresRequestVerification,
+  summarizeRequestVerificationHeaders,
+  withoutRequestVerificationHeaders,
+} from "../src/request-security-edition/verification-policy.js";
+
+describe("request verification policy", () => {
+  it("没有 captcha 段即未启用", () => {
+    expect(readRequestVerificationConfig(null)).toBeNull();
+    expect(readRequestVerificationConfig({})).toBeNull();
+    expect(readRequestVerificationConfig({ captcha: null })).toBeNull();
+  });
+
+  it("把服务端 snake_case 配置归一化", () => {
+    expect(
+      readRequestVerificationConfig({
+        captcha: {
+          enabled: true,
+          region: "cn",
+          prefix: "abc",
+          sceneId: "scene-1",
+          skip_model_request: true,
+        },
+      }),
+    ).toEqual({
+      enabled: true,
+      region: "cn",
+      prefix: "abc",
+      sceneId: "scene-1",
+      skipModelRequest: true,
+    });
+  });
+
+  it("proof 转请求头，region 可选", () => {
+    expect(requestVerificationClaimHeaders({ captchaVerifyParam: "p" })).toEqual({
+      [CAPTCHA_VERIFY_PARAM_HEADER]: "p",
+    });
+    expect(requestVerificationClaimHeaders({ captchaVerifyParam: "p", captchaRegion: "cn" })).toEqual({
+      [CAPTCHA_VERIFY_PARAM_HEADER]: "p",
+      [CAPTCHA_VERIFY_REGION_HEADER]: "cn",
+    });
+  });
+
+  it("允许/剥离验证码头，大小写不敏感", () => {
+    const mixed = {
+      "x-aliyun-captcha-verify-param": "  p  ",
+      "X-Aliyun-Captcha-Verify-Region": "cn",
+      Authorization: "Bearer t",
+    };
+    expect(allowRequestVerificationHeaders(mixed)).toEqual({
+      [CAPTCHA_VERIFY_PARAM_HEADER]: "p",
+      [CAPTCHA_VERIFY_REGION_HEADER]: "cn",
+    });
+    expect(withoutRequestVerificationHeaders(mixed)).toEqual({ Authorization: "Bearer t" });
+  });
+
+  it("只有 start-plan 账号需要验证码，且服务端可关闭/跳过模型请求", () => {
+    expect(requiresRequestVerification({ mode: "start-plan" })).toBe(true);
+    expect(requiresRequestVerification({ mode: "api-key" })).toBe(false);
+    expect(requiresRequestVerification({ mode: "start-plan" }, { enabled: false })).toBe(false);
+    expect(requiresRequestVerification({ mode: "start-plan" }, { skipModelRequest: true })).toBe(
+      false,
+    );
+    expect(requiresRequestVerification(undefined)).toBe(false);
+  });
+
+  it("识别网关的验证码拒绝文案", () => {
+    expect(isRequestVerificationMessage("请完成安全验证后重试")).toBe(true);
+    expect(isRequestVerificationMessage("Security verification required")).toBe(true);
+    expect(isRequestVerificationMessage("model overloaded")).toBe(false);
+  });
+
+  it("诊断只暴露长度，不暴露材料", () => {
+    const summary = summarizeRequestVerificationHeaders({
+      [CAPTCHA_VERIFY_PARAM_HEADER]: "abcdef",
+    });
+    expect(summary).toEqual({ hasCaptchaVerifyParam: true, captchaParamLength: 6 });
+    expect(requestVerificationDiagnostics(summary)).toEqual(summary);
+  });
+
+  it("常量与官方对齐", () => {
+    expect(requestVerificationReasons).toEqual(["model-request", "captcha-retry"]);
+    expect(REQUEST_VERIFICATION_REQUIRED).toBe("coding_plan_security_verification_required");
+    expect(requestVerificationTimeoutMessage).toContain("Captcha verification request timed out");
+    expect(requestVerificationInteractionAvailable).toBe(true);
+  });
+});
+
+describe("request security failure policy", () => {
+  it("识别签名/凭据失效原因（任意一层 envelope）", () => {
+    expect(isRequestSecurityFailure({ reason: "VERIFY_SIGNATURE_INVALID" }, [])).toBe(true);
+    expect(isRequestSecurityFailure({ data: { reason: "VERIFY_APIKEY_EXPIRED" } }, [])).toBe(true);
+    expect(isRequestSecurityFailure({ error: { message: "VERIFY_SIGNATURE_INVALID" } }, [])).toBe(
+      true,
+    );
+    expect(isRequestSecurityFailure({ message: "model overloaded" }, [])).toBe(false);
+  });
+
+  it("业务码侧认 3007 / 两种 VERIFY 码", () => {
+    expect(isRequestSecurityFailure(null, ["3007"])).toBe(true);
+    expect(isRequestSecurityFailure(null, ["CAPTCHA_VERIFY_FAILED"])).toBe(false);
+    expect(isRequestSecurityFailure(null, ["1005"])).toBe(false);
+    expect(isRequestSecurityFailure(null, [undefined])).toBe(false);
+  });
+
+  it("验证码证明属于敏感头，不能被记录", () => {
+    expect(requestSecuritySensitiveHeaders).toContain("x-aliyun-captcha-verify-param");
+    expect(requestSecuritySensitiveHeaders).toContain("x-client-sig");
+  });
+});
