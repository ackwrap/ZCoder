+import { describe, expect, it } from "vitest";
+import {
+  V4_METHODS,
+  v4ConversationCompactSummaryParamsSchema,
+  v4ConversationCompactSummaryResultSchema,
+} from "../src/zcode-protocol-v4/index.js";
+
+const identity = {
+  sessionId: "session-1",
+  baseLogEpoch: "epoch-1",
+  branchGeneration: 2,
+  rowId: 12,
+  operationId: "compact-1",
+  summaryRef: "summary-1",
+};
+
+describe("V4 compact summary read boundary", () => {
+  it("requires an exact bounded identity and no arbitrary path", () => {
+    expect(V4_METHODS.conversationCompactSummary).toBe("v4/conversation/compactSummary");
+    expect(v4ConversationCompactSummaryParamsSchema.parse(identity)).toEqual(identity);
+    for (const key of Object.keys(identity)) {
+      const invalid = { ...identity } as Record<string, unknown>;
+      delete invalid[key];
+      expect(v4ConversationCompactSummaryParamsSchema.safeParse(invalid).success).toBe(false);
+    }
+    expect(
+      v4ConversationCompactSummaryParamsSchema.safeParse({ ...identity, path: "/db" }).success,
+    ).toBe(false);
+    expect(
+      v4ConversationCompactSummaryParamsSchema.safeParse({ ...identity, branchGeneration: -1 })
+        .success,
+    ).toBe(false);
+  });
+
+  it("distinguishes saved Markdown from unavailable without accepting model content", () => {
+    expect(
+      v4ConversationCompactSummaryResultSchema.parse({ status: "available", markdown: "# Saved" }),
+    ).toEqual({ status: "available", markdown: "# Saved" });
+    expect(
+      v4ConversationCompactSummaryResultSchema.parse({
+        status: "unavailable",
+        reason: "missingBody",
+      }),
+    ).toEqual({ status: "unavailable", reason: "missingBody" });
+    expect(
+      v4ConversationCompactSummaryResultSchema.safeParse({ status: "available", content: "early" })
+        .success,
+    ).toBe(false);
+    expect(
+      v4ConversationCompactSummaryResultSchema.safeParse({
+        status: "unavailable",
+        reason: "missingBody",
+        markdown: "fake",
+      }).success,
+    ).toBe(false);
+  });
+});
