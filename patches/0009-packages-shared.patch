+
+describe("model system prompt settings contract", () => {
+  it("normalizes CRLF while preserving internal blank lines and indentation", () => {
+    expect(normalizeModelSystemPromptText("  line one\r\n\r\n  line two\r  ")).toBe(
+      "line one\n\n  line two",
