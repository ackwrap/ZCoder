+import { describe, expect, it } from "vitest";
+import { appSettingsPatchSchema, appSettingsSchema } from "../validationAppSettings.js";
+import { commandPayloadSchemas } from "../zcode-protocol-v4/command.js";
+import { conversationInputIntentSchema } from "../zcode-protocol-v4/input-intent.js";
+import {
+  MODEL_SYSTEM_PROMPT_MAX_ENTRIES,
+  modelSystemPromptEntriesPatchSchema,
+  modelSystemPromptEntriesSchema,
+  normalizeModelSystemPromptText,
+  resolveModelSystemPromptEntry,
+} from "./contract.js";
+
+describe("model system prompt settings contract", () => {
+  it("normalizes CRLF while preserving internal blank lines and indentation", () => {
+    expect(normalizeModelSystemPromptText("  line one\r\n\r\n  line two\r  ")).toBe(
+      "line one\n\n  line two",
+    );
+  });
+
+  it("sanitizes full settings values and keeps last duplicate", () => {
+    expect(
+      modelSystemPromptEntriesSchema.parse([
+        { providerId: " deepseek ", modelId: " chat ", text: " first " },
+        { providerId: "deepseek", modelId: "chat", text: " second " },
+        { providerId: "", modelId: "x", text: "drop" },
+        { providerId: "x", modelId: "y", text: "   " },
+      ]),
+    ).toEqual([{ providerId: "deepseek", modelId: "chat", text: "second" }]);
+  });
+
+  it("keeps entry text beyond 8000 characters without truncation", () => {
+    const longText = "x".repeat(8_001);
+    expect(
+      modelSystemPromptEntriesSchema.parse([
+        { providerId: "p", modelId: "m", text: longText },
+      ]),
+    ).toEqual([{ providerId: "p", modelId: "m", text: longText }]);
+    expect(
+      modelSystemPromptEntriesPatchSchema.safeParse([
+        { providerId: "p", modelId: "m", text: longText },
+      ]).success,
+    ).toBe(true);
+  });
+
+  it("caps full settings entries", () => {
+    const entries = Array.from({ length: MODEL_SYSTEM_PROMPT_MAX_ENTRIES + 5 }, (_, index) => ({
+      providerId: "p",
+      modelId: `m-${index}`,
+      text: "text",
+    }));
+    expect(modelSystemPromptEntriesSchema.parse(entries)).toHaveLength(
+      MODEL_SYSTEM_PROMPT_MAX_ENTRIES,
+    );
+  });
+
+  it("rejects duplicate pairs and invalid text in patches", () => {
+    expect(
+      modelSystemPromptEntriesPatchSchema.safeParse([
+        { providerId: "p", modelId: "m", text: "a" },
+        { providerId: "p", modelId: "m", text: "b" },
+      ]).success,
+    ).toBe(false);
+    expect(
+      modelSystemPromptEntriesPatchSchema.safeParse([{ providerId: "p", modelId: "m", text: " " }])
+        .success,
+    ).toBe(false);
+  });
+
+  it("resolves only the exact provider/model pair", () => {
+    const entries = [
+      { providerId: "deepseek", modelId: "deepseek-chat", text: "target" },
+      { providerId: "deepseek", modelId: "deepseek-reasoner", text: "other" },
+    ];
+    expect(
+      resolveModelSystemPromptEntry(entries, {
+        providerId: "deepseek",
+        modelId: "deepseek-chat",
+      })?.text,
+    ).toBe("target");
+    expect(
+      resolveModelSystemPromptEntry(entries, {
+        providerId: "deepseek",
+        modelId: "unknown",
+      }),
+    ).toBeUndefined();
+    expect(resolveModelSystemPromptEntry(entries, null)).toBeUndefined();
+  });
+});
+
+describe("model system prompt AppSettings integration", () => {
+  it("defaults to an empty list and normalizes full settings", () => {
+    expect(appSettingsSchema.parse({}).modelSystemPromptAppends).toEqual([]);
+    expect(
+      appSettingsSchema.parse({
+        modelSystemPromptAppends: [
+          { providerId: " deepseek ", modelId: " chat ", text: " a\r\nb " },
+          { providerId: "deepseek", modelId: "chat", text: " later " },
+        ],
+      }).modelSystemPromptAppends,
+    ).toEqual([{ providerId: "deepseek", modelId: "chat", text: "later" }]);
+  });
+
+  it("accepts valid patches and rejects duplicate pairs", () => {
+    expect(
+      appSettingsPatchSchema.safeParse({
+        modelSystemPromptAppends: [{ providerId: "deepseek", modelId: "chat", text: "a" }],
+      }).success,
+    ).toBe(true);
+    expect(
+      appSettingsPatchSchema.safeParse({
+        modelSystemPromptAppends: [
+          { providerId: "deepseek", modelId: "chat", text: "a" },
+          { providerId: "deepseek", modelId: "chat", text: "b" },
+        ],
+      }).success,
+    ).toBe(false);
+  });
+});
+
+describe("model system prompt wire schemas", () => {
+  const longText = "L".repeat(9_000);
+  const longEntry = { providerId: "deepseek", modelId: "chat", text: longText };
+
+  it("preserves long text through sendText, sendGoalCommand and createSession.firstInput", () => {
+    const sendText = commandPayloadSchemas.sendText.parse({
+      text: "send",
+      modelSystemPromptEnabled: true,
+      modelSystemPrompt: longEntry,
+    });
+    expect(sendText.modelSystemPrompt?.text).toBe(longText);
+
+    const goal = commandPayloadSchemas.sendGoalCommand.parse({
+      text: "goal",
+      modelSystemPromptEnabled: true,
+      modelSystemPrompt: longEntry,
+    });
+    expect(goal.modelSystemPrompt?.text).toBe(longText);
+
+    const create = commandPayloadSchemas.createSession.parse({
+      workspaceId: "/workspace",
+      firstInput: {
+        text: "first",
+        modelSystemPromptEnabled: true,
+        modelSystemPrompt: longEntry,
+      },
+    });
+    expect(create.firstInput?.modelSystemPrompt?.text).toBe(longText);
+  });
+
+  it("preserves long text through the canonical conversation input intent", () => {
+    const intent = conversationInputIntentSchema.parse({
+      sourceCommandId: "command-long",
+      queueItemId: "queue-long",
+      clientId: "desktop-long",
+      kind: "sendText",
+      text: "hello",
+      modelSystemPromptEnabled: true,
+      modelSystemPrompt: longEntry,
+      delivery: { requested: "startNow", admitted: "startNow" },
+      order: { admissionSeq: 1 },
+      steer: { state: "notRequested" },
+      dispatch: { state: "drained" },
+      admittedAt: 1,
+    });
+    expect(intent.modelSystemPrompt?.text).toBe(longText);
+  });
+});
diff --git a/packages/shared/src/model-system-prompts/contract.ts b/packages/shared/src/model-system-prompts/contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d7dba231fef058b174dec6fabe10585eb50d0261
--- /dev/null
+++ b/packages/shared/src/model-system-prompts/contract.ts
@@ -0,0 +1,95 @@
+import { z } from "zod";
+
+export const MODEL_SYSTEM_PROMPT_MAX_ENTRIES = 20;
+
+export interface ModelSystemPromptEntry {
+  providerId: string;
+  modelId: string;
+  text: string;
+}
+
+export interface ModelSystemPromptTarget {
+  providerId: string;
+  modelId: string;
+}
+
+/** CRLF/CR 统一为 LF，只裁剪首尾空白；内部换行与缩进保留。 */
+export function normalizeModelSystemPromptText(value: string): string {
+  return value.replace(/\r\n?/g, "\n").trim();
+}
+
+const providerIdSchema = z.string().trim().min(1);
+const modelIdSchema = z.string().trim().min(1);
+
+/** 单条严格契约：patch 写入与协议透传共用。 */
+export const modelSystemPromptEntrySchema = z
+  .object({
+    providerId: providerIdSchema,
+    modelId: modelIdSchema,
+    // 正文不设应用层字符上限；体积由模型上下文与实际请求负责，不再静默截断/拒绝。
+    text: z.string().transform(normalizeModelSystemPromptText).pipe(z.string().min(1)),
+  })
+  .strict();
+export type ModelSystemPromptEntryInput = z.input<typeof modelSystemPromptEntrySchema>;
+
+function normalizeEntries(value: unknown): unknown {
+  if (!Array.isArray(value)) return value;
+  const byTarget = new Map<string, ModelSystemPromptEntry>();
+  for (const raw of value) {
+    if (!raw || typeof raw !== "object") continue;
+    const candidate = raw as Record<string, unknown>;
+    if (
+      typeof candidate.providerId !== "string" ||
+      typeof candidate.modelId !== "string" ||
+      typeof candidate.text !== "string"
+    ) {
+      continue;
+    }
+    const providerId = candidate.providerId.trim();
+    const modelId = candidate.modelId.trim();
+    const text = normalizeModelSystemPromptText(candidate.text);
+    if (!providerId || !modelId || !text) {
+      continue;
+    }
+    // 同一精确 pair 只保留最后一条；磁盘脏值不能因为一条坏记录拖垮整份设置。
+    byTarget.set(`${providerId}\u0000${modelId}`, { providerId, modelId, text });
+  }
+  return [...byTarget.values()].slice(0, MODEL_SYSTEM_PROMPT_MAX_ENTRIES);
+}
+
+/** 完整设置读取：过滤非法/空/重复条目，不因单条脏值丢弃整份列表。 */
+export const modelSystemPromptEntriesSchema = z.preprocess(
+  normalizeEntries,
+  z.array(modelSystemPromptEntrySchema).max(MODEL_SYSTEM_PROMPT_MAX_ENTRIES),
+);
+
+/** patch 写入：严格校验，重复 pair 与越界条目数直接拒绝，避免持久化歧义。 */
+export const modelSystemPromptEntriesPatchSchema = z
+  .array(modelSystemPromptEntrySchema)
+  .max(MODEL_SYSTEM_PROMPT_MAX_ENTRIES)
+  .superRefine((entries, context) => {
+    const seen = new Set<string>();
+    for (const entry of entries) {
+      const key = `${entry.providerId}\u0000${entry.modelId}`;
+      if (seen.has(key)) {
+        context.addIssue({
+          code: z.ZodIssueCode.custom,
+          message: "modelSystemPromptAppends contains a duplicate provider/model pair",
+          path: [],
+        });
+        return;
+      }
+      seen.add(key);
+    }
+  });
+
+export function resolveModelSystemPromptEntry(
+  entries: readonly ModelSystemPromptEntry[] | undefined,
+  selection: ModelSystemPromptTarget | null | undefined,
+): ModelSystemPromptEntry | undefined {
+  if (!entries || !selection) return undefined;
+  return entries.find(
+    (entry) =>
+      entry.providerId === selection.providerId && entry.modelId === selection.modelId,
+  );
+}
