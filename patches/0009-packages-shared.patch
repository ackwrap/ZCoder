+import {
+  modelSystemPromptEntriesSchema,
+  normalizeModelSystemPromptText,
+  resolveModelSystemPromptEntry,
+} from "./contract.js";
+
+export function exampleModelSystemPromptConfig() {
+  const entry = modelSystemPromptEntriesSchema.parse([
+    {
+      providerId: "deepseek",
+      modelId: "deepseek-chat",
+      text: "Keep answers brief.\r\nUse complete sentences.",
+    },
+  ]);
+  return {
+    entry,
+    normalized: normalizeModelSystemPromptText(entry[0]?.text ?? ""),
+    resolved: resolveModelSystemPromptEntry(entry, {
+      providerId: "deepseek",
+      modelId: "deepseek-chat",
+    }),
+  };
+}
