+// At most 128 Ki UTF-16 code units: even JSON's six-byte escaping fits below 1 MiB.
+export const COMPACT_SUMMARY_MAX_CHARS = 128 * 1024;
+
+export const v4ConversationCompactSummaryParamsSchema = z.strictObject({
+  sessionId: z.string().min(1).max(1024),
+  baseLogEpoch: z.string().min(1).max(1024),
+  branchGeneration: z.number().int().nonnegative(),
+  rowId: z.number().int().nonnegative(),
+  operationId: z.string().min(1).max(1024),
+  summaryRef: z.string().min(1).max(1024),
+});
+export type V4ConversationCompactSummaryParams = z.infer<
+  typeof v4ConversationCompactSummaryParamsSchema
+>;
+
+export const v4ConversationCompactSummaryResultSchema = z.discriminatedUnion("status", [
+  z.strictObject({
+    status: z.literal("available"),
+    markdown: z.string().min(1).max(COMPACT_SUMMARY_MAX_CHARS),
+  }),
+  z.strictObject({
+    status: z.literal("unavailable"),
+    reason: z.enum(["notAuthorized", "staleIdentity", "missingBody", "unsupported", "tooLarge"]),
+  }),
+]);
+export type V4ConversationCompactSummaryResult = z.infer<
+  typeof v4ConversationCompactSummaryResultSchema
