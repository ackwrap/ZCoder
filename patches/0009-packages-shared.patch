+
+const godDepartmentConfigSchema = z.object({
+  modelSelection: modelSelectionSchema.optional(),
+  useModelSystemPrompt: z.boolean().optional(),
+  systemPrompt: z.string().trim().min(1).max(100_000).optional(),
+}).strict();
+
+export const godDepartmentsConfigSchema = z.object({
+  taizi: godDepartmentConfigSchema,
+  zhongshu: godDepartmentConfigSchema,
+  menxia: godDepartmentConfigSchema,
+  shangshu: godDepartmentConfigSchema,
+  hubu: godDepartmentConfigSchema,
+  libu: godDepartmentConfigSchema,
+  bingbu: godDepartmentConfigSchema,
+  xingbu: godDepartmentConfigSchema,
+  gongbu: godDepartmentConfigSchema,
+  libu_hr: godDepartmentConfigSchema,
+  zaochao: godDepartmentConfigSchema,
+}).partial().strict();
+export type GodDepartmentsConfig = z.infer<typeof godDepartmentsConfigSchema>;
+export type GodDepartmentConfig = z.infer<typeof godDepartmentConfigSchema>;
+
+export function normalizeGodDepartmentsConfig(input: unknown): GodDepartmentsConfig {
+  if (!input || typeof input !== "object" || Array.isArray(input)) return {};
+  const entries = input as Record<string, unknown>;
+  const result: GodDepartmentsConfig = {};
+  for (const id of GOD_DEPARTMENT_IDS) {
+    const parsed = godDepartmentConfigSchema.safeParse(entries[id]);
+    if (parsed.success) result[id] = parsed.data;
+  }
+  return result;
+}
