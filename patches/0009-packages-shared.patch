+/**
+ * 上下文压缩策略变化的跨窗口广播。独立于 app-runtime-preferences：旧渲染进程对该 payload 的
+ * strict 校验不认新字段，混进旧频道会让它们连同已有两个交互偏好一起丢弃。
+ */
+export const COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL = "settings:compaction-policy";
 export const ASK_USER_QUESTION_E2E_CLOCK_SCALE_ENV = "ZCODE_E2E_ASK_USER_QUESTION_CLOCK_SCALE";
 
 export const appRuntimePreferencesChangedBroadcastPayloadSchema = z
@@ -16,3 +21,64 @@ export const appRuntimePreferencesChangedBroadcastPayloadSchema = z
 export type AppRuntimePreferencesChangedBroadcastPayload = z.infer<
   typeof appRuntimePreferencesChangedBroadcastPayloadSchema
 >;
+
+/**
+ * Host → CLI 的上下文压缩策略（docs/compaction-profiles.md「Host → CLI 同步」）。
+ * 三个值在离开 Host 前已归一：profile 只允许 detailed/compact，两个 token 数落在设置契约范围内。
+ */
+export const appCompactionProfileSchema = z.enum(["detailed", "compact"]);
+export type AppCompactionProfile = z.infer<typeof appCompactionProfileSchema>;
+
+export const appCompactionPolicySchema = z
+  .object({
+    profile: appCompactionProfileSchema,
+    tailBudgetTokens: z.number().int().min(1_000).max(100_000),
+    summaryMaxOutputTokens: z.number().int().min(1_000).max(20_000),
+  })
+  .strict();
+export type AppCompactionPolicy = z.infer<typeof appCompactionPolicySchema>;
+
+export const DEFAULT_APP_COMPACTION_POLICY: AppCompactionPolicy = {
+  profile: "detailed",
+  tailBudgetTokens: 15_000,
+  summaryMaxOutputTokens: 8_000,
+};
+
+function resolveCompactionTokenValue(value: unknown, min: number, max: number, fallback: number) {
+  // 与 core `resolveCompactionPolicy` / AppSettings `.catch(default)` 同语义：非整数或越界一律
+  // 回退默认，不做截断或夹紧，避免 Host 与 CLI 对同一脏值得出不同事实。
+  return typeof value === "number" && Number.isInteger(value) && value >= min && value <= max
+    ? value
+    : fallback;
+}
+
+/**
+ * 归一到 strict CLI 接受的形状：未知/非法 profile 回退 detailed，非整数/越界 token 回退默认。
+ * Host 侧保持与 AppSettings 的 `.catch(default)` 及 core `resolveCompactionPolicy` 同向，
+ * 避免把磁盘脏值原样推给 CLI。
+ */
+export function normalizeAppCompactionPolicy(
+  policy:
+    | {
+        profile?: unknown;
+        tailBudgetTokens?: unknown;
+        summaryMaxOutputTokens?: unknown;
+      }
+    | undefined,
+): AppCompactionPolicy {
+  return {
+    profile: policy?.profile === "compact" ? "compact" : "detailed",
+    tailBudgetTokens: resolveCompactionTokenValue(
+      policy?.tailBudgetTokens,
+      1_000,
+      100_000,
+      DEFAULT_APP_COMPACTION_POLICY.tailBudgetTokens,
+    ),
+    summaryMaxOutputTokens: resolveCompactionTokenValue(
+      policy?.summaryMaxOutputTokens,
+      1_000,
+      20_000,
+      DEFAULT_APP_COMPACTION_POLICY.summaryMaxOutputTokens,
+    ),
+  };
+}
