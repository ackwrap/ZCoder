+import { describe, expect, expectTypeOf, it } from "vitest";
+import {
+  COMPACT_SUMMARY_MAX_CHARS,
+  contextSourceUpdateSchema,
+  v4ConversationCompactSummaryParamsSchema,
+  v4ConversationCompactSummaryResultSchema,
+  type ContextSourceUpdateProjection,
+  type V4ConversationCompactSummaryParams,
+  type V4ConversationCompactSummaryResult,
+} from "../../src/zcode-protocol-v4/context-schemas/contract.js";
+import {
+  exampleCompactSummaryParams,
+  exampleCompactSummaryResult,
+  exampleContextSourceUpdate,
+} from "../../src/zcode-protocol-v4/context-schemas/contract.example.js";
+
+describe("v4 context schemas contract", () => {
+  it("exports the real schemas and their inferred types for the narrow examples", () => {
+    const params = v4ConversationCompactSummaryParamsSchema.parse(exampleCompactSummaryParams);
+    const result = v4ConversationCompactSummaryResultSchema.parse(exampleCompactSummaryResult);
+    const update = contextSourceUpdateSchema.parse(exampleContextSourceUpdate);
+    expectTypeOf(params).toEqualTypeOf<V4ConversationCompactSummaryParams>();
+    expectTypeOf(result).toEqualTypeOf<V4ConversationCompactSummaryResult>();
+    expectTypeOf(update).toEqualTypeOf<ContextSourceUpdateProjection>();
+    expect(params).toEqual(exampleCompactSummaryParams);
+    expect(result).toEqual(exampleCompactSummaryResult);
+    expect(update).toEqual(exampleContextSourceUpdate);
+  });
+
+  it("requires every identity field and rejects paths, invalid counters and oversized refs", () => {
+    for (const key of Object.keys(exampleCompactSummaryParams)) {
+      const missing: Record<string, unknown> = { ...exampleCompactSummaryParams };
+      delete missing[key];
+      expect(v4ConversationCompactSummaryParamsSchema.safeParse(missing).success).toBe(false);
+    }
+    for (const patch of [
+      { path: "/private/session.db" },
+      { sessionId: "" },
+      { baseLogEpoch: "e".repeat(1025) },
+      { branchGeneration: -1 },
+      { branchGeneration: 0.5 },
+      { rowId: -1 },
+      { rowId: 1.5 },
+      { operationId: "" },
+      { summaryRef: "r".repeat(1025) },
+    ]) {
+      expect(
+        v4ConversationCompactSummaryParamsSchema.safeParse({
+          ...exampleCompactSummaryParams,
+          ...patch,
+        }).success,
+      ).toBe(false);
+    }
+  });
+
+  it("bounds saved Markdown and refuses bodies on unavailable results", () => {
+    expect(COMPACT_SUMMARY_MAX_CHARS).toBe(128 * 1024);
+    expect(
+      v4ConversationCompactSummaryResultSchema.safeParse({
+        status: "available",
+        markdown: "x".repeat(COMPACT_SUMMARY_MAX_CHARS),
+      }).success,
+    ).toBe(true);
+    for (const invalid of [
+      { status: "available", markdown: "" },
+      { status: "available", markdown: "x".repeat(COMPACT_SUMMARY_MAX_CHARS + 1) },
+      { status: "available", content: "not saved Markdown" },
+      { status: "unavailable", reason: "missingBody", markdown: "private body" },
+      { status: "unavailable", reason: "private storage error" },
+    ]) {
+      expect(v4ConversationCompactSummaryResultSchema.safeParse(invalid).success).toBe(false);
+    }
+    for (const reason of [
+      "notAuthorized",
+      "staleIdentity",
+      "missingBody",
+      "unsupported",
+      "tooLarge",
+    ] as const) {
+      expect(
+        v4ConversationCompactSummaryResultSchema.parse({ status: "unavailable", reason }),
+      ).toEqual({ status: "unavailable", reason });
+    }
+  });
+
+  it.each(["skills", "agents", "mcp_tools", "instructions"] as const)(
+    "keeps only safe %s metadata, stripping unknown top-level and nested bodies",
+    (kind) => {
+      const expected = { ...exampleContextSourceUpdate, kind };
+      const parsed = contextSourceUpdateSchema.parse({
+        ...expected,
+        content: "PRIVATE PROMPT",
+        runtimeCheckpoint: { credentials: "PRIVATE TOKEN" },
+        changes: expected.changes.map((change) => ({ ...change, body: "PRIVATE SOURCE BODY" })),
+      });
+      expect(parsed).toEqual(expected);
+      expect(JSON.stringify(parsed)).not.toContain("PRIVATE");
+    },
+  );
+
+  it("rejects malformed or oversized audit metadata rather than exposing a body fallback", () => {
+    const change = exampleContextSourceUpdate.changes[0]!;
+    for (const patch of [
+      { version: 2 },
+      { kind: "runtime" },
+      { sourceKey: "" },
+      { sourceKey: "s".repeat(4097) },
+      { revision: "not-a-hash" },
+      { revision: "A".repeat(64) },
+      { changes: [{ ...change, label: "" }] },
+      { changes: [{ ...change, label: "x".repeat(1025) }] },
+      { changes: [{ ...change, change: "updated" }] },
+      { changes: Array.from({ length: 2049 }, () => change) },
+    ]) {
+      expect(
+        contextSourceUpdateSchema.safeParse({ ...exampleContextSourceUpdate, ...patch }).success,
+      ).toBe(false);
+    }
+  });
+});
