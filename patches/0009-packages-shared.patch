+  tailBudgetTokens: 15_000,
+  summaryMaxOutputTokens: 8_000,
+};
+
+function resolveCompactionTokenValue(value: unknown, min: number, max: number, fallback: number) {
+  // 与 core `resolveCompactionPolicy` / AppSettings `.catch(default)` 同语义：非整数或越界一律
+  // 回退默认，不做截断或夹紧，避免 Host 与 CLI 对同一脏值得出不同事实。
+  return typeof value === "number" && Number.isInteger(value) && value >= min && value <= max
+    ? value
+    : fallback;
+}
+
+/**
+ * 归一到 strict CLI 接受的形状：未知/非法 profile 回退 detailed，非整数/越界 token 回退默认。
+ * Host 侧保持与 AppSettings 的 `.catch(default)` 及 core `resolveCompactionPolicy` 同向，
+ * 避免把磁盘脏值原样推给 CLI。
+ */
+export function normalizeAppCompactionPolicy(
+  policy:
