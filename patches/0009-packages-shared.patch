+import { describe, expect, it } from "vitest";
+import {
+  DEFAULT_APP_COMPACTION_POLICY,
+  appCompactionPolicySchema,
+  normalizeAppCompactionPolicy,
+} from "#src/app-runtime-preferences.js";
+
+// docs/compaction-profiles.md「设置契约」：无效整数/越界值回退默认，不截断、不夹紧。
+// 必须与 AppSettings `.catch(default)` 和 core `resolveCompactionPolicy` 保持同一事实。
+
+describe("normalizeAppCompactionPolicy", () => {
+  it("缺失值使用 detailed / 15000 / 8000", () => {
+    expect(normalizeAppCompactionPolicy(undefined)).toEqual(DEFAULT_APP_COMPACTION_POLICY);
+    expect(normalizeAppCompactionPolicy({})).toEqual(DEFAULT_APP_COMPACTION_POLICY);
+  });
+
+  it("未知 profile 回退 detailed", () => {
+    expect(normalizeAppCompactionPolicy({ profile: "verbose" }).profile).toBe("detailed");
+    expect(normalizeAppCompactionPolicy({ profile: "compact" }).profile).toBe("compact");
+  });
+
+  it("非整数与越界值回退默认，而不是截断或夹紧", () => {
+    expect(
+      normalizeAppCompactionPolicy({
+        tailBudgetTokens: 1.2,
+        summaryMaxOutputTokens: 8_000.5,
+      }),
+    ).toMatchObject({ tailBudgetTokens: 15_000, summaryMaxOutputTokens: 8_000 });
+    expect(normalizeAppCompactionPolicy({ tailBudgetTokens: 999 }).tailBudgetTokens).toBe(15_000);
+    expect(normalizeAppCompactionPolicy({ tailBudgetTokens: 100_001 }).tailBudgetTokens).toBe(
+      15_000,
+    );
+    expect(
+      normalizeAppCompactionPolicy({ summaryMaxOutputTokens: 20_001 }).summaryMaxOutputTokens,
+    ).toBe(8_000);
+    expect(normalizeAppCompactionPolicy({ tailBudgetTokens: Number.NaN }).tailBudgetTokens).toBe(
+      15_000,
+    );
+  });
+
+  it("合法边界值原样保留", () => {
+    expect(
+      normalizeAppCompactionPolicy({
+        profile: "compact",
+        tailBudgetTokens: 1_000,
+        summaryMaxOutputTokens: 20_000,
+      }),
+    ).toEqual({ profile: "compact", tailBudgetTokens: 1_000, summaryMaxOutputTokens: 20_000 });
+    expect(
+      normalizeAppCompactionPolicy({ tailBudgetTokens: 100_000, summaryMaxOutputTokens: 1_000 }),
+    ).toMatchObject({ tailBudgetTokens: 100_000, summaryMaxOutputTokens: 1_000 });
+  });
+
+  it("归一结果满足 strict 协议 schema", () => {
+    expect(
+      appCompactionPolicySchema.safeParse(
+        normalizeAppCompactionPolicy({ profile: "compact", tailBudgetTokens: 1.2 }),
+      ).success,
+    ).toBe(true);
+    expect(
+      appCompactionPolicySchema.safeParse({ profile: "compact", tailBudgetTokens: 1.2 }).success,
+    ).toBe(false);
+  });
+});
