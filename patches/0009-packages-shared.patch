@@ -1,7 +1,64 @@
-export const requestSecuritySensitiveHeaders: readonly string[] = [];
+/**
+ * 请求安全失败（客户端签名 / 网关安全校验）的判定与敏感头清单。
+ *
+ * 官方 3.16.3 对齐：
+ *   - 失败原因从响应包 `msg` / `reason` / `data.reason` / `error.reason` / `error.message`
+ *     里取，只有 `VERIFY_SIGNATURE_INVALID` 与 `VERIFY_APIKEY_EXPIRED` 两种算安全失败
+ *   - 业务码侧同样认 `VERIFY_APIKEY_EXPIRED` / `VERIFY_SIGNATURE_INVALID` / `3007`
+ *   - 敏感头（禁止落日志/网络抓包）：客户端签名三元 + 阿里云验证码证明
+ */
+
+const VERIFY_SIGNATURE_INVALID = "VERIFY_SIGNATURE_INVALID";
+const VERIFY_APIKEY_EXPIRED = "VERIFY_APIKEY_EXPIRED";
+
+/** 客户端签名握手用头，读完后从请求里剔除。 */
+export const clientSigningHeaders: readonly string[] = [
+  "X-Client-Ts",
+  "X-Client-Version",
+  "X-Client-Sig",
+  "X-Client-Nonce",
+  "X-Client-Pow",
+  "X-App-Id",
+  "X-Client-Sign-Verified",
+];
+
+/**
+ * 不得出现在日志 / 网络抓包里的请求头（小写比较）。
+ *
+ * `x-aliyun-captcha-verify-param` 是验证码证明：它等同于一次验证的凭证，
+ * 泄漏后可在有效期内被复用，所以与客户端签名同等对待。
+ */
+export const requestSecuritySensitiveHeaders: readonly string[] = [
+  "x-client-sig",
+  "x-client-pow",
+  "x-aliyun-captcha-verify-param",
+];
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+/** 从响应包任意一层读出签名/凭据失效原因。 */
+function readClientSignatureFailureReason(body: unknown): string | undefined {
+  const outer = asRecord(body);
+  if (!outer) return undefined;
+  const data = asRecord(outer.data);
+  const error = asRecord(outer.error);
+  const reason = [outer.msg, outer.reason, data?.reason, error?.reason, error?.message].find(
+    (value) => value === VERIFY_SIGNATURE_INVALID || value === VERIFY_APIKEY_EXPIRED,
+  );
+  return typeof reason === "string" ? reason : undefined;
+}
+
+/** 这次 provider 失败是否属于"请求安全"（签名/凭据/网关 3007），可据此换一份新证明重试。 */
 export function isRequestSecurityFailure(
-  _body: unknown,
-  _codes: readonly (string | undefined)[],
+  body: unknown,
+  codes: readonly (string | undefined)[],
 ): boolean {
-  return false;
+  if (readClientSignatureFailureReason(body)) return true;
+  return codes.some((code) =>
+    [VERIFY_APIKEY_EXPIRED, VERIFY_SIGNATURE_INVALID, "3007"].includes(code ?? ""),
+  );
 }
