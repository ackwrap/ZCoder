@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+import { contextSourceUpdateSchema } from "../src/zcode-protocol-v4/index.js";
+
+const update = {
+  version: 1,
+  kind: "skills",
+  sourceKey: "skills:catalog",
+  revision: "a".repeat(64),
+  changes: [
+    { sourceKey: "skills:one", label: "One", change: "added" },
+    { sourceKey: "skills:two", label: "Two", change: "replaced" },
+    { sourceKey: "skills:old", label: "Old", change: "removed" },
+  ],
+};
+
+describe("V4 context source update metadata", () => {
+  it.each(["skills", "agents", "mcp_tools", "instructions"])(
+    "accepts the %s source category",
+    (kind) => {
+      expect(contextSourceUpdateSchema.parse({ ...update, kind })).toEqual({ ...update, kind });
+    },
+  );
+
+  it("projects only allowlisted metadata, including nested changes", () => {
+    const parsed = contextSourceUpdateSchema.parse({
+      ...update,
+      content: "HIDDEN PROMPT",
+      runtimeMessage: { credentials: "PRIVATE" },
+      changes: update.changes.map((change) => ({ ...change, body: "SKILL BODY" })),
+    });
+    expect(parsed).toEqual(update);
+    expect(JSON.stringify(parsed)).not.toContain("HIDDEN PROMPT");
+    expect(JSON.stringify(parsed)).not.toContain("PRIVATE");
+    expect(JSON.stringify(parsed)).not.toContain("SKILL BODY");
+  });
+
+  it.each([
+    { ...update, version: 2 },
+    { ...update, kind: "unknown" },
+    { ...update, sourceKey: "" },
+    { ...update, revision: "not-a-hash" },
+    { ...update, changes: [{ sourceKey: "one", label: "", change: "added" }] },
+    { ...update, changes: [{ sourceKey: "one", label: "One", change: "updated" }] },
+    { ...update, changes: [{ sourceKey: "one", label: "x".repeat(1025), change: "added" }] },
+    { ...update, changes: Array.from({ length: 2049 }, () => update.changes[0]) },
+  ])("rejects malformed or oversized metadata", (invalid) => {
+    expect(contextSourceUpdateSchema.safeParse(invalid).success).toBe(false);
+  });
+});
