@@ -0,0 +1,90 @@
+import { NodePersonalProviderConfigRepository } from "@zcode/provider-node";
+import {
+  TID_MODEL_PROVIDER_ADD_PROVIDER_BUTTON,
+  TID_MODEL_PROVIDER_TEMPLATE_ITEM,
+  TID_MODEL_PROVIDER_API_KEY_INPUT,
+  TID_MODEL_PROVIDER_BASE_URL_INPUT,
+  TID_SETTINGS_SECTION_NAV,
+  TID_TASK_SETTINGS_BUTTON,
+  testId,
+} from "@zcode/shared/test-ids";
+import {
+  clearAppData,
+  clickTestIdByDom,
+  getE2EAppDataPaths,
+} from "../../../helpers/desktop-app.js";
+import { prepareV4ConversationE2E } from "../../../helpers/v4-conversation.js";
+
+describe("Codex provider entry and browser OAuth", () => {
+  after(async () => {
+    await browser.electron.restoreAllMocks();
+    await clearAppData();
+  });
+  it("creates Codex separately from OpenAI and handles denial/cancellation without real authorization", async function () {
+    this.timeout(150_000);
+    await prepareV4ConversationE2E({ skipProvider: true });
+    const openExternal = await browser.electron.mock("shell", "openExternal");
+    await openExternal.mockResolvedValue(undefined);
+    await clickTestIdByDom(TID_TASK_SETTINGS_BUTTON);
+    await clickTestIdByDom(testId(TID_SETTINGS_SECTION_NAV, "modelProvider"));
+    await clickTestIdByDom(TID_MODEL_PROVIDER_ADD_PROVIDER_BUTTON);
+    await $(`[data-testid="${testId(TID_MODEL_PROVIDER_TEMPLATE_ITEM, "openai")}"]`).waitForExist({
+      timeout: 15_000,
+    });
+    await clickTestIdByDom(testId(TID_MODEL_PROVIDER_TEMPLATE_ITEM, "codex"));
+    await $('[data-testid="codex-connection"]').waitForExist({ timeout: 15_000 });
+    expect(await $(`[data-testid="${TID_MODEL_PROVIDER_API_KEY_INPUT}"]`).isExisting()).toBe(false);
+    expect(await $(`[data-testid="${TID_MODEL_PROVIDER_BASE_URL_INPUT}"]`).isExisting()).toBe(
+      false,
+    );
+    const login = $('[data-testid="codex-login"]');
+    const deviceLogin = $('[data-testid="codex-device-login"]');
+    await deviceLogin.waitForEnabled({ timeout: 15_000 });
+    expect(await $('[data-testid="codex-device-details"]').isExisting()).toBe(false);
+    await login.waitForEnabled({ timeout: 15_000 });
+    await login.click();
+    await browser.waitUntil(
+      async () => {
+        await openExternal.update();
+        return openExternal.mock.calls.length === 1;
+      },
+      { timeout: 15_000 },
+    );
+    const url = new URL(String(openExternal.mock.calls[0]?.[0]));
+    expect(url.origin + url.pathname).toBe("https://auth.openai.com/oauth/authorize");
+    expect(url.searchParams.get("client_id")).toBe("app_EMoamEEZ73f0CkXaXp7hrann");
+    expect(url.searchParams.get("scope")).toBe("openid profile email offline_access");
+    expect(url.searchParams.get("originator")).toBe("opencode");
+    expect(url.searchParams.get("codex_cli_simplified_flow")).toBe("true");
+    expect(url.searchParams.has("resource")).toBe(false);
+    const callback = new URL(url.searchParams.get("redirect_uri")!);
+    expect(callback.hostname).toBe("localhost");
+    expect(["1455", "1457"]).toContain(callback.port);
+    callback.search = new URLSearchParams({
+      state: url.searchParams.get("state")!,
+      error: "access_denied",
+    }).toString();
+    expect((await fetch(callback)).status).toBe(400);
+    await $('[data-testid="codex-connection"] [role="alert"]').waitForExist({ timeout: 10_000 });
+    await login.waitForEnabled({ timeout: 10_000 });
+    await login.click();
+    const cancel = $('[data-testid="codex-cancel"]');
+    await cancel.waitForExist({ timeout: 10_000 });
+    await cancel.click();
+    await login.waitForEnabled({ timeout: 10_000 });
+    const repository = new NodePersonalProviderConfigRepository({
+      filePath: getE2EAppDataPaths().configFile,
+      pollingIntervalMs: false,
+    });
+    try {
+      const provider = (await repository.read()).providers
+        .entries()
+        .find(([, config]) => config.access?.type === "codex-oauth")?.[1];
+      expect(provider?.access?.toJSON()).toEqual({ type: "codex-oauth" });
+      expect(provider?.api?.baseUrl).toBe("https://api.openai.com/v1");
+      expect(provider?.personalModelIds?.length).toBe(4);
+    } finally {
+      repository.dispose();
+    }
+  });
+});
