@@ -0,0 +1,161 @@
+import { createServer, type Server } from "node:http";
+import { NodePersonalProviderConfigRepository } from "@zcode/provider-node";
+import {
+  TID_MODEL_PROVIDER_ADD_PROVIDER_BUTTON,
+  TID_MODEL_PROVIDER_ADD_MODEL_BUTTON,
+  TID_MODEL_PROVIDER_TEMPLATE_ITEM,
+  TID_MODEL_PROVIDER_API_KEY_INPUT,
+  TID_MODEL_PROVIDER_BASE_URL_INPUT,
+  TID_MODEL_PROVIDER_NAV_ITEM,
+  TID_SETTINGS_SECTION_NAV,
+  TID_TASK_SETTINGS_BUTTON,
+  testId,
+} from "@zcode/shared/test-ids";
+import {
+  clearAppData,
+  clickTestIdByDom,
+  getE2EAppDataPaths,
+} from "../../../helpers/desktop-app.js";
+import { prepareV4ConversationE2E } from "../../../helpers/v4-conversation.js";
+
+describe("Automatic model discovery after saving a key", () => {
+  let server: Server | undefined;
+  after(async () => {
+    await new Promise<void>((resolve) => {
+      if (server) {
+        server.closeAllConnections();
+        server.close(() => resolve());
+      } else resolve();
+    });
+    await clearAppData();
+  });
+  it("fetches IDs and parameters, preserves config on error, and supports manual refresh", async function () {
+    this.timeout(150_000);
+    let fail = false;
+    let contextWindow = 123456;
+    const requests: string[] = [];
+    server = createServer((req, res) => {
+      requests.push(req.url ?? "");
+      if (fail) {
+        res.writeHead(401).end();
+        return;
+      }
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(
+        JSON.stringify({
+          data: [
+            {
+              id: "discovered-fixture-model",
+              context_window: contextWindow,
+              max_output_tokens: 8192,
+              input_modalities: ["text", "image"],
+            },
+          ],
+        }),
+      );
+    });
+    await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+    const address = server.address();
+    if (!address || typeof address === "string") throw new Error("fixture-listener-unavailable");
+    await prepareV4ConversationE2E({ skipProvider: true });
+    await clickTestIdByDom(TID_TASK_SETTINGS_BUTTON);
+    await clickTestIdByDom(testId(TID_SETTINGS_SECTION_NAV, "modelProvider"));
+    await clickTestIdByDom(TID_MODEL_PROVIDER_ADD_PROVIDER_BUTTON);
+    await clickTestIdByDom(testId(TID_MODEL_PROVIDER_TEMPLATE_ITEM, "openai"));
+    const endpoint = $(`[data-testid="${TID_MODEL_PROVIDER_BASE_URL_INPUT}"]`);
+    await endpoint.waitForExist({ timeout: 15000 });
+    await endpoint.setValue(`http://127.0.0.1:${address.port}/v1`);
+    await browser.keys("Tab");
+    const key = $(`[data-testid="${TID_MODEL_PROVIDER_API_KEY_INPUT}"]`);
+    await key.setValue("e2e-discovery-key");
+    await browser.keys("Tab");
+    const panel = $('[data-testid="provider-model-discovery"]');
+    await browser.waitUntil(async () => (await panel.getAttribute("data-status")) === "ready", {
+      timeout: 20000,
+    });
+    await $('[data-model-provider-model-id="discovered-fixture-model"]').waitForExist({
+      timeout: 15000,
+    });
+    expect(requests).toEqual(["/v1/models"]);
+    expect(
+      await browser.execute((addId) => {
+        const refresh = document.querySelector('[data-testid="provider-model-discovery-refresh"]');
+        const actions = refresh?.closest("[data-model-provider-actions]");
+        return !!actions && actions.contains(document.querySelector(`[data-testid="${addId}"]`));
+      }, TID_MODEL_PROVIDER_ADD_MODEL_BUTTON),
+    ).toBe(true);
+    const repository = new NodePersonalProviderConfigRepository({
+      filePath: getE2EAppDataPaths().configFile,
+      pollingIntervalMs: false,
+    });
+    try {
+      const saved = await repository.read();
+      const providerId = saved.providers
+        .entries()
+        .find(([, p]) => p.api?.baseUrl === `http://127.0.0.1:${address.port}/v1`)?.[0];
+      expect(providerId).toBeTruthy();
+      let config = saved.models
+        .getDiscoveredExact(providerId!, "discovered-fixture-model")
+        ?.toJSON();
+      expect(config).toMatchObject({
+        properties: { contextWindow: 123456 },
+        optionSpecs: { maxOutputTokens: { max: 8192 } },
+      });
+      expect(
+        saved.models.getExact(providerId!, "discovered-fixture-model")?.properties?.contextWindow,
+      ).toBeUndefined();
+      contextWindow = 64000;
+      await clickTestIdByDom("provider-model-discovery-refresh");
+      const modelRow = $('[data-model-provider-model-id="discovered-fixture-model"]');
+      await browser.waitUntil(async () => (await modelRow.getText()).includes("64K"), {
+        timeout: 20000,
+      });
+      config = (await repository.read()).models
+        .getDiscoveredExact(providerId!, "discovered-fixture-model")
+        ?.toJSON();
+      expect(config?.properties?.contextWindow).toBe(64000);
+      fail = true;
+      await clickTestIdByDom("provider-model-discovery-refresh");
+      await browser.waitUntil(async () => (await panel.getAttribute("data-status")) === "error", {
+        timeout: 20000,
+      });
+      expect(
+        (await repository.read()).models
+          .getDiscoveredExact(providerId!, "discovered-fixture-model")
+          ?.toJSON(),
+      ).toEqual(config);
+      fail = false;
+      await clickTestIdByDom("provider-model-discovery-refresh");
+      await browser.waitUntil(async () => (await panel.getAttribute("data-status")) === "ready", {
+        timeout: 20000,
+      });
+      expect(requests).toHaveLength(4);
+      await clickTestIdByDom(TID_MODEL_PROVIDER_ADD_PROVIDER_BUTTON);
+      await clickTestIdByDom(testId(TID_MODEL_PROVIDER_TEMPLATE_ITEM, "codex"));
+      await $('[data-testid="codex-connection"]').waitForExist({ timeout: 15000 });
+      expect(await $$('[data-testid="provider-model-discovery"]').length).toBe(1);
+      const codexId = (await repository.read()).providers
+        .entries()
+        .find(([, p]) => p.access?.type === "codex-oauth")?.[0];
+      expect(codexId).toBeTruthy();
+      const astra = $('[data-model-provider-model-id="gpt-6-astra"]');
+      await browser.waitUntil(async () => (await astra.getText()).includes("272K"), {
+        timeout: 15000,
+      });
+      for (const id of [providerId!, codexId!, providerId!, codexId!, providerId!]) {
+        await clickTestIdByDom(testId(TID_MODEL_PROVIDER_NAV_ITEM, `custom:${id}`));
+        if (id === codexId)
+          await $('[data-testid="codex-connection"]').waitForExist({ timeout: 15000 });
+        else
+          await $('[data-model-provider-model-id="discovered-fixture-model"]').waitForExist({
+            timeout: 15000,
+          });
+        expect(await $$('[data-testid="provider-model-discovery"]').length).toBe(1);
+        expect(await $$('[data-testid="provider-model-discovery-refresh"]').length).toBe(1);
+      }
+      expect(requests).toHaveLength(4);
+    } finally {
+      repository.dispose();
+    }
+  });
+});
diff --git a/packages/desktop/test/e2e/settings/manual-review/pending/session-diagnostics.test.ts b/packages/desktop/test/e2e/settings/manual-review/pending/session-diagnostics.test.ts
