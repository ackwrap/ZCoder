index 0000000000000000000000000000000000000000..576ffbda47e389e037247e6da38152cc6193f560
--- /dev/null
+++ b/packages/desktop/test/e2e/settings/manual-review/pending/session-diagnostics.test.ts
@@ -0,0 +1,137 @@
+import { createServer, type Server } from "node:http";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { ModelConfig } from "@zcode/provider";
+import { NodePersonalProviderConfigRepository } from "@zcode/provider-node";
+import {
+  TID_CHAT_CONTEXT_USAGE_TRIGGER,
+  TID_SETTINGS_SECTION_NAV,
+  testId,
+} from "@zcode/shared/test-ids";
+import {
+  clearAppData,
+  clickTestIdByDom,
+  getE2EAppDataPaths,
+} from "../../../helpers/desktop-app.js";
+import { prepareV4ConversationE2E, sendV4Prompt } from "../../../helpers/v4-conversation.js";
+import { UPSTREAM_MODEL, UPSTREAM_PROVIDER_ID } from "../../../helpers/upstream-provider.js";
+import { handlePlainHttpMcpRequest } from "../../../helpers/mcp-plain-http-fixture.js";
+
+describe("Session context and MCP diagnostics", () => {
+  let server: Server | undefined;
+  after(async () => {
+    await new Promise<void>((resolve) => {
+      if (!server) return resolve();
+      server.closeAllConnections();
+      server.close(() => resolve());
+    });
+    await clearAppData();
+  });
+
+  it("explains configured context and keeps MCP inspection separate from connection checks", async function () {
+    this.timeout(180000);
+    const state = { plainHttpInitializeCount: 0, plainHttpToolCallMarkers: [] as string[] };
+    server = createServer((request, response) => {
+      void handlePlainHttpMcpRequest(request, response, state);
+    });
+    await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+    const address = server.address();
+    if (!address || typeof address === "string") throw new Error("fixture-address-unavailable");
+    const paths = getE2EAppDataPaths();
+    const configPath = join(paths.homeDir, ".zcode", "cli", "config.json");
+    await mkdir(join(paths.homeDir, ".zcode", "cli"), { recursive: true });
+    const config = JSON.parse(await readFile(configPath, "utf8").catch(() => "{}"));
+    config.mcp ??= {};
+    config.mcp.servers ??= {};
+    config.mcp.servers["diagnostic-fixture"] = {
+      type: "http",
+      url: `http://127.0.0.1:${address.port}/mcp`,
+      headers: { "X-Fixture-Key": "diagnostic-private-value" },
+    };
+    await writeFile(configPath, JSON.stringify(config), "utf8");
+    await browser.refresh();
+    await prepareV4ConversationE2E();
+    const repository = new NodePersonalProviderConfigRepository({
+      filePath: paths.configFile,
+      pollingIntervalMs: false,
+    });
+    try {
+      await repository.update((current) => {
+        const personal =
+          current.models.getExact(UPSTREAM_PROVIDER_ID, UPSTREAM_MODEL)?.toJSON() ?? {};
+        if (personal.properties) delete personal.properties.contextWindow;
+        return {
+          ...current,
+          models: current.models
+            .setExact(UPSTREAM_PROVIDER_ID, UPSTREAM_MODEL, ModelConfig.fromData(personal), true)
+            .setDiscoveredExact(
+              UPSTREAM_PROVIDER_ID,
+              UPSTREAM_MODEL,
+              ModelConfig.fromData({ properties: { contextWindow: 272000 } }),
+            ),
+        };
+      });
+      const trigger = $(`[data-testid="${TID_CHAT_CONTEXT_USAGE_TRIGGER}"]`);
+      await trigger.waitForExist({ timeout: 20000 });
+      await trigger.moveTo();
+      const configured = $('[data-testid="context-configured-window"]');
+      await configured.waitForDisplayed({ timeout: 15000 });
+      await browser.waitUntil(
+        async () => (await configured.getAttribute("data-source")) === "discovered",
+        { timeout: 15000 },
+      );
+      expect(await configured.getAttribute("data-model")).toBe(UPSTREAM_MODEL);
+      expect(await configured.getText()).toContain(UPSTREAM_MODEL);
+      await repository.update((current) => ({
+        ...current,
+        models: current.models.setDiscoveredExact(
+          UPSTREAM_PROVIDER_ID,
+          UPSTREAM_MODEL,
+          ModelConfig.fromData({ properties: { contextWindow: 64000 } }),
+        ),
+      }));
+      await browser.waitUntil(async () => /64K|6.4万/.test(await configured.getText()), {
+        timeout: 15000,
+      });
+      await browser.keys("Escape");
+      await sendV4Prompt("/mcp");
+      const dialog = $('[data-testid="mcp-status-dialog"]');
+      await dialog.waitForDisplayed({ timeout: 15000 });
+      await browser.waitUntil(async () => (await dialog.getText()).includes("diagnostic-fixture"), {
+        timeout: 15000,
+      });
+      const rowId = await browser.execute(
+        () =>
+          [...document.querySelectorAll<HTMLElement>('[data-testid^="mcp-status-row-"]')].find(
+            (row) => row.textContent?.includes("diagnostic-fixture"),
+          )?.dataset.testid,
+      );
+      const row = $(`[data-testid="${rowId}"]`);
+      await row.waitForDisplayed({ timeout: 15000 });
+      const before = state.plainHttpInitializeCount;
+      const refresh = $('[data-testid="mcp-status-refresh"]');
+      await browser.waitUntil(async () => await refresh.isEnabled(), { timeout: 15000 });
+      await refresh.click();
+      await browser.waitUntil(async () => await refresh.isEnabled(), { timeout: 15000 });
+      expect(state.plainHttpInitializeCount).toBe(before);
+      const connect = $('[data-testid="mcp-status-connect"]');
+      await connect.click();
+      await browser.waitUntil(async () => await connect.isEnabled(), { timeout: 30000 });
+      const details = await row.$("details");
+      await details.$("summary").click();
+      const report = await details.$("pre").getText();
+      expect(report).toContain("name: diagnostic-fixture");
+      expect(report).toContain("toolCount: 1");
+      expect(report).not.toContain("diagnostic-private-value");
+      await details.$("button").click();
+      await details.$('[role="status"]').waitForDisplayed({ timeout: 5000 });
+      await clickTestIdByDom("mcp-status-settings");
+      await dialog.waitForDisplayed({ reverse: true, timeout: 10000 });
+      await $(`[data-testid="${testId(TID_SETTINGS_SECTION_NAV, "mcp")}"]`).waitForDisplayed({
+        timeout: 10000,
+      });
+    } finally {
+      repository.dispose();
+    }
+  });
+});
