+
+describe("pushCompactionPolicyToRemoteHosts", () => {
+  const POLICY = {
+    profile: "compact" as const,
+    tailBudgetTokens: 30_000,
+    summaryMaxOutputTokens: 9_000,
+  };
+
+  function compactionAgent() {
+    return { syncCompactionPolicy: vi.fn(async (_policy: typeof POLICY) => undefined) };
+  }
+
+  it("推给 SSH/WSL/Docker 连接，跳过 standalone server", async () => {
+    const ssh = compactionAgent();
+    const wsl = compactionAgent();
+    const server = compactionAgent();
+    const targets: Array<{
+      target: RemoteTarget;
+      zcodeAgentService: ReturnType<typeof compactionAgent>;
+    }> = [
+      { target: { kind: "ssh", host: "h", username: "u" }, zcodeAgentService: ssh },
+      { target: { kind: "wsl", distro: "Ubuntu" }, zcodeAgentService: wsl },
+      { target: { kind: "server", url: "https://s.example.com" }, zcodeAgentService: server },
+    ];
+    await pushCompactionPolicyToRemoteHosts(targets, POLICY, vi.fn());
+    expect(ssh.syncCompactionPolicy).toHaveBeenCalledWith(POLICY);
+    expect(wsl.syncCompactionPolicy).toHaveBeenCalledWith(POLICY);
+    expect(server.syncCompactionPolicy).not.toHaveBeenCalled();
+  });
+
+  it("握手中尚未进入 ready 列表的连接（无 target）也会推送", async () => {
+    const pending = compactionAgent();
+    await pushCompactionPolicyToRemoteHosts([{ zcodeAgentService: pending }], POLICY, vi.fn());
+    expect(pending.syncCompactionPolicy).toHaveBeenCalledWith(POLICY);
+  });
+
+  it("单个远程 Host 失败只报错，不影响其它连接也不抛出", async () => {
+    const broken = {
+      syncCompactionPolicy: vi.fn(async () => {
+        throw new Error("Unknown command");
+      }),
+    };
+    const ok = compactionAgent();
+    const onError = vi.fn();
+    await expect(
+      pushCompactionPolicyToRemoteHosts(
+        [
+          { target: { kind: "wsl", distro: "Ubuntu" }, zcodeAgentService: broken },
+          { target: { kind: "ssh", host: "h", username: "u" }, zcodeAgentService: ok },
+        ],
+        POLICY,
+        onError,
+      ),
+    ).resolves.toBeUndefined();
+    expect(onError).toHaveBeenCalledTimes(1);
+    expect(ok.syncCompactionPolicy).toHaveBeenCalledWith(POLICY);
+  });
+});
