diff --git a/packages/ui/test/mcpStatusDialog.test.ts b/packages/ui/test/mcpStatusDialog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6d6e9e2d3354c604cebc637d03888344687b1d5d
--- /dev/null
+++ b/packages/ui/test/mcpStatusDialog.test.ts
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+
+import { cleanup, render } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { isMcpStatusCommand } from "@/lib/mcpStatusCommand.js";
+import { useMcpStore } from "@/store/mcpStore.js";
+
+const listWorkspaceMcpServerStatuses = vi.fn(async () => ({ statuses: {} }));
+
+vi.mock("@/hooks/useWorkspaceServices.js", () => ({
+  useBaseWorkspaceServices: () => ({
+    mcpSyncService: { listWorkspaceMcpServerStatuses },
+  }),
+}));
+
+import { McpStatusDialog } from "@/McpStatusDialog.js";
+
+beforeAll(() => {
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  );
+  Object.defineProperty(window, "matchMedia", {
+    configurable: true,
+    value: (query: string) => ({
+      matches: false,
+      media: query,
+      onchange: null,
+      addEventListener() {},
+      removeEventListener() {},
+      addListener() {},
+      removeListener() {},
+      dispatchEvent: () => false,
+    }),
+  });
+});
+
+afterEach(() => {
+  cleanup();
+});
+
+describe("isMcpStatusCommand", () => {
+  it("matches /mcp and its /mcps alias only", () => {
+    expect(isMcpStatusCommand("/mcp")).toBe(true);
+    expect(isMcpStatusCommand("/mcps")).toBe(true);
+    expect(isMcpStatusCommand("  /MCP  ")).toBe(true);
+    expect(isMcpStatusCommand("/mcp list")).toBe(false);
+    expect(isMcpStatusCommand("/mcps list")).toBe(false);
+    expect(isMcpStatusCommand("mcp")).toBe(false);
+  });
+});
+
+describe("McpStatusDialog", () => {
+  it("lists configured MCP servers with their status", () => {
+    useMcpStore.setState({
+      isConfigLoaded: true,
+      servers: [
+        {
+          id: "server-a",
+          name: "fixture-server",
+          enabled: true,
+          status: "connected",
+          toolCount: 3,
+          source: "zcode",
+          scope: "user",
+          config: { command: "node", args: ["server.js"] },
+        },
+      ],
+    } as never);
+
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(McpStatusDialog, {
+          open: true,
+          onOpenChange: vi.fn(),
+          workspacePath: "/workspace",
+        }),
+      ),
+    );
+
+    expect(view.getByTestId("mcp-status-dialog")).toBeTruthy();
+    expect(view.getByText("fixture-server")).toBeTruthy();
+    expect(view.getByText("已连接")).toBeTruthy();
+    expect(view.getByText("3 个工具")).toBeTruthy();
+    expect(listWorkspaceMcpServerStatuses).toHaveBeenCalledWith({ workspacePath: "/workspace" });
+  });
+
+  it("shows the empty state when no servers are configured", () => {
+    useMcpStore.setState({ isConfigLoaded: true, servers: [] } as never);
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(McpStatusDialog, {
+          open: true,
+          onOpenChange: vi.fn(),
+          workspacePath: "/workspace",
+        }),
+      ),
+    );
+    expect(view.getByText("当前工作区没有配置 MCP 服务器。")).toBeTruthy();
+  });
+});
