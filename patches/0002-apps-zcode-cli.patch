+import type { TextStreamPart, ToolSet } from "ai";
+import type { Logger, ModelStatusSink, ModelStreamEvent } from "@zcode/contracts";
+import {
+  ModelFailureReason as ModelFailureReasonValue,
+  ModelRetryReason,
