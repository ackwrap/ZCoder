+      signal: options.signal,
+      timeoutMs: ripgrepTimeoutMsForTests ?? DEFAULT_RIPGREP_TIMEOUT_MS,
+    });
+  } catch (error) {
+    if (isAbortError(error) || error instanceof RipgrepTimeoutFailure) {
+      throw error;
+    }
+    throw new RipgrepRuntimeFailure(error);
+  }
