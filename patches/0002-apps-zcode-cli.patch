+  const target = rootInfo.isDirectory() ? "." : basename(path);
+  const args: RgArg[] = [
+    "--no-config",
+    "--hidden",
+    "--color",
+    "never",
+    "--no-heading",
+    "--with-filename",
+    "--max-columns",
+    "500",
+  ];
