+import { describe, expect, it, vi } from "vitest";
+import {
+  createRootTraceContext,
+  createSessionId,
+  SessionEventType,
+  type McpPort,
+  type McpToolDescriptor,
+  type ModelRequest,
+  type SkillMetadata,
+  type SkillPort,
+} from "@zcode/contracts";
+import { createTestAgentRuntime } from "./test-agent-runtime.js";
+import { createTestSessionEventStore } from "./test-event-store.js";
+import { createTestModelFactory } from "./test-runtime-model.js";
+import { createRecordingSubagentSessionStore } from "./subagent-test-store.js";
+import type { AgentRuntimeInternal } from "../src/runtime/internal.js";
+import { createToolRegistry } from "../src/tool/registry.js";
+import { createTestRuntimeModel } from "./test-runtime-model.js";
+import { stableSourceRevision } from "../src/agent/context-source-metadata.js";
+
+const result = {
+  text: "done",
+  finishReason: "stop" as const,
+  usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
+};
+const skill = (name: string, description = name): SkillMetadata => ({
+  name,
+  description,
+  path: `/workspace/skills/${name}/SKILL.md`,
+  directory: `/workspace/skills/${name}`,
+  rootPath: "/workspace/skills",
+  scope: "project",
+  source: "zcode",
+  safeToAutoLoad: true,
+  frontmatterKeys: ["name", "description"],
+});
+function fixture() {
+  let skills = [skill("one", "ORIGINAL_SKILL")];
+  let failScan = false;
+  const loadSkill = vi.fn<SkillPort["loadSkill"]>();
+  const discoverSkills = vi.fn<SkillPort["discoverSkills"]>(async () => {
+    if (failScan) throw new Error("temporary scan failure");
+    return { skills: structuredClone(skills), diagnostics: [], totalDiscovered: skills.length };
+  });
+  const store = createRecordingSubagentSessionStore();
+  const readMessages = store.messages.bind(store);
+  store.messages = async (input) => [
+    ...new Map((await readMessages(input)).map((message) => [message.info.id, message])).values(),
+  ];
+  const session = createSessionId();
+  const requests: ModelRequest[] = [];
+  let duringRequest: (() => void) | undefined;
+  const create = () =>
+    createTestAgentRuntime(
+      session,
+      {
+        workingDirectory: "/workspace",
+        mode: "yolo",
+        compact: { enabled: false },
+        titleGeneration: { enabled: false },
+      },
+      {
+        eventStore: createTestSessionEventStore(),
+        sessionStore: store,
+        skillPort: { discoverSkills, loadSkill },
+        modelFactory: createTestModelFactory({
+          async generateText(request, observation) {
+            requests.push(structuredClone(request));
+            duringRequest?.();
+            duringRequest = undefined;
+            return {
+              ...result,
+              text:
+                observation.invocationContext?.metadata?.querySource === "compact"
+                  ? "<summary>Work summary</summary>"
+                  : "done",
+            };
+          },
+        }),
+      },
+    );
+  return {
+    create,
+    store,
+    requests,
+    session,
+    loadSkill,
+    discoverSkills,
+    set(value: SkillMetadata[]) {
+      skills = value;
+    },
+    fail(value: boolean) {
+      failScan = value;
+    },
+    during(fn: () => void) {
+      duringRequest = fn;
+    },
+  };
+}
+const updates = (runtime: ReturnType<typeof createTestAgentRuntime>) =>
+  (runtime as unknown as AgentRuntimeInternal).messageHistory
+    .toRuntimeEntries()
+    .filter((e) => e.metadata?.sourceUpdate?.kind === "skills");
+
+describe("dynamic context sources", () => {
+  it("publishes metadata replacements, additions and removals at the next request without loading bodies", async () => {
+    const f = fixture();
+    const runtime = f.create();
+    try {
+      await runtime.executeTurn("first");
+      f.during(() => f.set([skill("one", "CHANGED_SKILL"), skill("two")]));
+      await runtime.executeTurn("in flight");
+      expect(JSON.stringify(f.requests.at(-1)!.messages)).not.toContain("CHANGED_SKILL");
+      await runtime.executeTurn("next boundary");
+      expect(
+        updates(runtime)
+          .at(-1)
+          ?.metadata?.sourceUpdate?.changes.map((c) => c.change)
+          .sort(),
+      ).toEqual(["added", "replaced"]);
+      expect(JSON.stringify(f.requests.at(-1)!.messages)).toContain("CHANGED_SKILL");
+      f.set([skill("two"), skill("one", "CHANGED_SKILL")]);
+      await runtime.executeTurn("stable reordered");
+      expect(updates(runtime)).toHaveLength(1);
+      f.set([]);
+      await runtime.executeTurn("removed");
+      expect(
+        updates(runtime)
+          .at(-1)
+          ?.metadata?.sourceUpdate?.changes.every((c) => c.change === "removed"),
+      ).toBe(true);
+      expect(f.loadSkill).not.toHaveBeenCalled();
+      const part = (await f.store.messages({ sessionID: f.session }))
+        .flatMap((m) => m.parts)
+        .find((p) => p.type === "text" && p.metadata?.sourceUpdate);
+      expect(part?.type === "text" ? part.metadata?.sourceUpdate : undefined).toMatchObject({
+        version: 1,
+        kind: "skills",
+        sourceKey: "skills:catalog",
+      });
+      const internal = runtime as unknown as AgentRuntimeInternal;
+      const audits = (await internal.eventStore.getEvents(f.session)).filter(
+        (event) =>
+          event.type === SessionEventType.SystemMessage &&
+          (event.payload as { type?: string }).type === "context_source_update",
+      );
+      expect(audits).toHaveLength(2);
+      expect(audits[0]?.payload).toMatchObject({
+        messageId: part?.messageID,
+        partId: part?.id,
+        sourceUpdate: { kind: "skills" },
+      });
+      expect(JSON.stringify(audits)).not.toContain("CHANGED_SKILL");
+    } finally {
+      runtime.beginShutdown();
+    }
+  });
+
+  it("retains last trusted catalog on discovery failure and does not reset session deny", async () => {
+    const f = fixture();
+    const runtime = f.create();
+    try {
+      await runtime.executeTurn("first");
+      const internal = runtime as unknown as AgentRuntimeInternal;
+      await internal.sessionResources.set("skill", "one", false);
+      f.set([skill("one", "CHANGED_SKILL")]);
+      f.fail(true);
+      await runtime.executeTurn("scan failure");
+      expect(updates(runtime)).toHaveLength(0);
+      f.fail(false);
+      await runtime.executeTurn("retry");
+      expect(updates(runtime)).toHaveLength(1);
+      await expect(internal.sessionResources.assertEnabled("skill", "one")).rejects.toThrow(
+        "disabled",
+      );
+    } finally {
+      runtime.beginShutdown();
+    }
+  });
+
+  it("does not advance catalog after an exact update-part write failure and retries once", async () => {
+    const f = fixture();
+    const runtime = f.create();
+    const save = f.store.savePart.bind(f.store);
+    try {
+      await runtime.executeTurn("first");
+      f.set([skill("one", "CHANGED_SKILL")]);
+      f.store.savePart = async (part) => {
+        if (
+          part.type === "text" &&
+          (part.metadata?.sourceUpdate as { kind?: string } | undefined)?.kind === "skills"
+        )
+          throw new Error("update disk full");
+        await save(part);
+      };
+      await expect(runtime.executeTurn("input persisted before update")).rejects.toThrow();
+      expect(updates(runtime)).toHaveLength(0);
+      expect(
+        (await runtime.getSkillCatalog(createRootTraceContext({ sessionId: f.session }))).skills[0]
+          ?.description,
+      ).toBe("ORIGINAL_SKILL");
+      f.store.savePart = save;
+      await runtime.executeTurn("retry");
+      expect(updates(runtime)).toHaveLength(1);
+      expect(
+        (await f.store.messages({ sessionID: f.session }))
+          .flatMap((m) => m.parts)
+          .filter(
+            (p) =>
+              p.type === "text" &&
+              (p.metadata?.sourceUpdate as { kind?: string } | undefined)?.kind === "skills",
+          ),
+      ).toHaveLength(1);
+    } finally {
+      runtime.beginShutdown();
+    }
+  });
+
+  it("retains the durable update after audit-event failure without repeating model updates", async () => {
+    const f = fixture();
+    const runtime = f.create();
+    const internal = runtime as unknown as AgentRuntimeInternal;
+    try {
+      await runtime.executeTurn("first");
+      f.set([skill("one", "CHANGED_SKILL")]);
+      const append = internal.appendEvent.bind(internal);
+      const event = vi.spyOn(internal, "appendEvent").mockImplementation(async (value, trace) => {
+        if (
+          value.type === SessionEventType.SystemMessage &&
+          (value.payload as { type?: string }).type === "context_source_update"
+        )
+          throw new Error("audit sink failed");
+        await append(value, trace);
+      });
+      await runtime.executeTurn("event delivery failure");
+      event.mockRestore();
+      await runtime.executeTurn("next boundary");
+      expect(updates(runtime)).toHaveLength(1);
+      expect(internal.skillCatalogState?.applied?.skills[0]?.description).toBe("CHANGED_SKILL");
+      expect(
+        (await f.store.messages({ sessionID: f.session }))
+          .flatMap((message) => message.parts)
+          .filter(
+            (part) =>
+              part.type === "text" &&
+              (part.metadata?.sourceUpdate as { kind?: string } | undefined)?.kind === "skills",
+          ),
+      ).toHaveLength(1);
+    } finally {
+      runtime.beginShutdown();
+    }
+  });
+
+  it("keeps the previous cycle baseline when compact summary persistence fails", async () => {
+    const f = fixture();
+    const runtime = f.create();
+    const save = f.store.saveMessage.bind(f.store);
+    try {
+      await runtime.executeTurn("first");
+      f.set([skill("one", "CHANGED_SKILL")]);
+      await runtime.executeTurn("second");
+      const internal = runtime as unknown as AgentRuntimeInternal;
+      const baseline = structuredClone(internal.skillCatalogState?.baseline);
+      f.store.saveMessage = async (message, copyFrom) => {
+        if (message.role === "user" && message.semantics?.kind === "compact_summary")
+          throw new Error("summary write failed");
+        await save(message, copyFrom);
+      };
+      await runtime.executeTurn("/compact").catch(() => {});
+      expect(internal.skillCatalogState?.baseline).toEqual(baseline);
+      expect(internal.skillCatalogState?.applied?.skills[0]?.description).toBe("CHANGED_SKILL");
+      expect(updates(runtime)).toHaveLength(1);
+    } finally {
+      f.store.saveMessage = save;
+      runtime.beginShutdown();
+    }
+  });
+
+  it("restores a copied history with the same source versions without duplicate announcements", async () => {
+    const f = fixture();
+    const live = f.create();
+    let fork: ReturnType<typeof f.create> | undefined;
+    try {
+      await live.executeTurn("first");
+      f.set([skill("one", "CHANGED_SKILL")]);
+      await live.executeTurn("second");
+      const copiedStore = createRecordingSubagentSessionStore();
+      const session = await f.store.getSession(f.session);
+      await copiedStore.createSession(session!);
+      for (const message of await f.store.messages({ sessionID: f.session })) {
+        await copiedStore.saveMessage(structuredClone(message.info));
+        for (const part of message.parts) await copiedStore.savePart(structuredClone(part));
+      }
+      fork = createTestAgentRuntime(
+        f.session,
+        {
+          workingDirectory: "/workspace",
+          mode: "yolo",
+          compact: { enabled: false },
+          titleGeneration: { enabled: false },
+        },
+        {
+          eventStore: createTestSessionEventStore(),
+          sessionStore: copiedStore,
+          skillPort: { discoverSkills: f.discoverSkills, loadSkill: f.loadSkill },
+          modelFactory: createTestModelFactory({
+            async generateText() {
+              return result;
+            },
+          }),
+        },
+      );
+      await fork.resumeFromStore();
+      await fork.executeTurn("copied continuation");
+      expect(updates(fork)).toHaveLength(1);
+    } finally {
+      live.beginShutdown();
+      fork?.beginShutdown();
+    }
+  });
+
+  it.each([false, true])(
+    "restores the durable baseline and deduplicates updates (compact=%s)",
+    async (compact) => {
+      const f = fixture();
+      const live = f.create();
+      let cold: ReturnType<typeof f.create> | undefined;
+      try {
+        await live.executeTurn("first");
+        f.set([skill("one", "CHANGED_SKILL")]);
+        await live.executeTurn("second");
+        if (compact) await live.executeTurn("/compact");
+        cold = f.create();
+        await cold.resumeFromStore();
+        await cold.executeTurn("cold continuation");
+        const current = updates(cold);
+        expect(current).toHaveLength(compact ? 0 : 1);
+        expect(JSON.stringify(f.requests.at(-1)!.messages)).toContain("CHANGED_SKILL");
+        f.set([skill("one", "LATEST_SKILL")]);
+        await cold.executeTurn("new revision");
+        expect(updates(cold)).toHaveLength(compact ? 1 : 2);
+      } finally {
+        live.beginShutdown();
+        cold?.beginShutdown();
+      }
+    },
+  );
+});
+
+function mcpReviewFixture(mode: "local" | "native" | "auto", controls = true) {
+  let revision = 0;
+  let descriptors: McpToolDescriptor[] = [
+    { serverName: "review", toolName: "query", inputSchema: { type: "object" } },
+  ];
+  const port: McpPort = {
+    connectConfiguredServers: vi.fn(),
+    connectServer: vi.fn(),
+    disconnectServer: vi.fn(),
+    status: vi.fn(async () => ({})),
+    listTools: vi.fn(async () => structuredClone(descriptors)),
+    toolListRevision: () => revision,
+    callTool: vi.fn(),
+    close: vi.fn(),
+  };
+  const requests: ModelRequest[] = [];
+  const runtime = createTestAgentRuntime(
+    createSessionId(),
+    {
+      mode: "yolo",
+      subagents: { enabled: false },
+      compact: { enabled: false },
+      titleGeneration: { enabled: false },
+      toolSearch: { mode },
+    },
+    {
+      eventStore: createTestSessionEventStore(),
+      sessionStore: createRecordingSubagentSessionStore(),
+      toolRegistry: createToolRegistry(),
+      mcpPort: port,
+      modelFactory: () => ({
+        ...createTestRuntimeModel({
+          generateText: async (request) => {
+            requests.push(request);
+            return result;
+          },
+        }),
+        requestCapabilities: { toolSearch: { protocolSupported: true, defaultEnabled: true } },
+      }),
+    },
+  );
+  const internal = runtime as unknown as AgentRuntimeInternal;
+  const allTools = internal.getTools.bind(internal);
+  vi.spyOn(internal, "getTools").mockImplementation((model) =>
+    allTools(model).filter(
+      (tool) =>
+        tool.name.startsWith("mcp__review__") ||
+        ["ToolSearch", "DeferredToolCall"].includes(tool.name),
+    ),
+  );
+  return {
+    runtime,
+    internal,
+    requests,
+    controls,
