+import { describe, expect, it } from "vitest";
+import { SessionEventType, createSessionId, type ModelRequest } from "@zcode/contracts";
+import { createTestAgentRuntime } from "./test-agent-runtime.js";
+import { createTestModelFactory } from "./test-runtime-model.js";
+import { createTestSessionEventStore } from "./test-event-store.js";
+import { createToolRegistry } from "../src/tool/registry.js";
+import {
+  createRecordingMessageStore,
+  registerReadOnlyTool,
+  requestText,
+  stopResult,
+} from "./runtime-output-token-continuation-test-helpers.js";
+
+describe("long tool turn automatic compaction", () => {
+  it.each([true, false])("compacts mid-turn and resumes the same tail with MCS=%s", async (mcs) => {
+    const sessionId = createSessionId(`long-tool-turn-${mcs}`);
+    const store = createRecordingMessageStore();
+    await store.createSession({ id: sessionId, directory: "/workspace", path: "/workspace" });
+    const eventStore = createTestSessionEventStore();
+    const requests: ModelRequest[] = [];
+    let steps = 0;
+    let summaries = 0;
+    const config = {
+      systemPrompt: "Long tool turn compaction test",
+      modelStreaming: "off" as const,
+      titleGeneration: { enabled: false as const },
+      mode: "yolo" as const,
+      compact: {
+        profile: "compact" as const,
+        contextWindow: 20_000,
+        bufferTokens: 1_000,
+        tailBudgetTokens: 1_000,
+        microcompact: { enabled: false },
+      },
+    };
+    const factory = createTestModelFactory({
+      maxOutputTokens: 1_000,
+      properties: { supportsMidConversationSystem: mcs, contextWindow: 20_000 },
+      generateText: async (request) => {
+        const prompt = requestText(request.messages.slice(-1));
+        if (prompt.includes("Summarize the conversation into one structured checkpoint")) {
+          summaries++;
+          return stopResult("## Objective\n- loop-checkpoint: finish the original task safely", 50);
+        }
+        requests.push(request);
+        steps++;
+        if (steps <= 5) {
+          return {
+            finishReason: "tool-calls",
+            text: "",
+            toolCalls: [{ id: `loop-${steps}`, name: "LargeRead", input: {} }],
+            usage: { inputTokens: steps === 3 ? 19_000 : 10, outputTokens: 1, totalTokens: steps === 3 ? 19_001 : 11 },
+          };
+        }
+        return stopResult("completed", 10);
+      },
+    });
+    const makeRuntime = (sessionStore = store) => {
+      const registry = createToolRegistry();
+      registerReadOnlyTool(registry, "LargeRead", `loop-tool-payload ${"x".repeat(2_400)}`);
+      return createTestAgentRuntime(sessionId, config, {
+        sessionStore: { ...sessionStore, getProjectPermission: async () => null } as never,
+        eventStore,
+        modelFactory: factory,
+        toolRegistry: registry,
+      });
+    };
+    const runtime = makeRuntime();
+    const result = await runtime.executeTurn("original task with many tool steps");
+    const events = await eventStore.getEvents(sessionId);
+    expect(result.response).toBe("completed");
+    expect(summaries).toBe(1);
+    expect(events.filter((event) => event.type === SessionEventType.CompactBoundary)).toHaveLength(1);
+    expect(events.filter((event) => event.type === SessionEventType.CompactCompleted).map((event) => (event.payload as { status: string }).status)).toEqual(["completed"]);
+    const firstAfterCompact = requests.find((request) => requestText(request.messages).includes("loop-checkpoint"))!;
+    expect(firstAfterCompact).toBeDefined();
+    expect(firstAfterCompact.messages.filter((message) => message.role === "tool").map((message) => message.toolCallId)).toEqual(["loop-3"]);
+    expect(requestText(firstAfterCompact.messages)).not.toContain("original task with many tool steps");
+    const persisted = await store.messages();
+    const boundary = persisted.flatMap((message) => message.parts).find((part) => part.type === "compaction" && part.compactBoundary)?.compactBoundary;
+    expect(boundary.preservedSegment).toBeDefined();
+    const coldStore = createRecordingMessageStore();
+    await coldStore.createSession(structuredClone(await store.getSession(sessionId)));
+    coldStore.savedMessages.push(...structuredClone(store.savedMessages));
+    coldStore.savedParts.push(...structuredClone(store.savedParts));
+    await runtime.executeTurn("compare retained tail");
+    const liveRequest = requests.at(-1)!;
+    const cold = makeRuntime(coldStore);
+    await cold.resumeFromStore();
+    await cold.executeTurn("compare retained tail");
+    const coldRequest = requests.at(-1)!;
+    const relevant = (request: ModelRequest) => request.messages.filter((message) => message.role === "tool" || message.toolCalls?.length || requestText([message]).includes("loop-checkpoint"));
+    expect(relevant(coldRequest)).toEqual(relevant(liveRequest));
+    for (const request of [liveRequest, coldRequest]) {
+      expect(request.messages.filter((message) => message.role === "tool").map((message) => message.toolCallId)).toEqual(["loop-3", "loop-4", "loop-5"]);
+      expect(requestText(request.messages)).not.toContain("original task with many tool steps");
+    }
+  });
+});
