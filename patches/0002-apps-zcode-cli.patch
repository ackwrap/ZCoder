@@ -0,0 +1,66 @@
+import type { MessageId, SessionId, SessionStorePort } from "@zcode/contracts";
+import {
+  COMPACT_SUMMARY_MAX_CHARS,
+  type V4ConversationCompactSummaryResult,
+} from "@zcode/shared/zcode-protocol-v4";
+
+/** Only called after the gateway authorizes the exact active successful marker. */
+export async function readPersistedCompactSummary(
+  store: Pick<SessionStorePort, "getSession" | "messageWithParts">,
+  identity: {
+    sessionId: string;
+    operationId: string;
+    summaryRef: string;
+    branchGeneration: number;
+  },
+): Promise<V4ConversationCompactSummaryResult> {
+  const sessionID = identity.sessionId as SessionId;
+  const session = await store.getSession(sessionID);
+  if (!session || String(session.id) !== identity.sessionId || session.time?.deleted) {
+    return { status: "unavailable", reason: "notAuthorized" };
+  }
+  if ((session.revert?.branchGeneration ?? 0) !== identity.branchGeneration) {
+    return { status: "unavailable", reason: "staleIdentity" };
+  }
+  const message = await store.messageWithParts({
+    sessionID,
+    messageID: identity.summaryRef as MessageId,
+  });
+  const info = message?.info;
+  if (
+    !message ||
+    !info ||
+    String(info.id) !== identity.summaryRef ||
+    String(info.sessionID) !== identity.sessionId ||
+    info.role !== "user" ||
+    info.semantics?.origin !== "agent_runtime" ||
+    info.semantics.kind !== "compact_summary" ||
+    info.semantics.uiVisibility !== "hidden" ||
+    info.semantics.transcriptVisibility !== "hidden"
+  ) {
+    return { status: "unavailable", reason: "missingBody" };
+  }
+  const boundary = message.parts.find(
+    (part) =>
+      part.type === "compaction" &&
+      String(part.sessionID) === identity.sessionId &&
+      String(part.messageID) === identity.summaryRef &&
+      part.operationId === identity.operationId &&
+      part.compactBoundary?.summaryMessageIds?.some((id) => String(id) === identity.summaryRef),
+  );
+  if (!boundary) return { status: "unavailable", reason: "missingBody" };
+  const markdown = info.summary?.body;
+  if (!markdown?.trim()) return { status: "unavailable", reason: "missingBody" };
+  if (markdown.length > COMPACT_SUMMARY_MAX_CHARS)
+    return { status: "unavailable", reason: "tooLarge" };
+  // Branch commit can race the message read; never return bytes from a retired branch.
+  const latest = await store.getSession(sessionID);
+  if (
+    !latest ||
+    latest.time?.deleted ||
+    (latest.revert?.branchGeneration ?? 0) !== identity.branchGeneration
+  ) {
+    return { status: "unavailable", reason: "staleIdentity" };
+  }
+  return { status: "available", markdown };
+}
