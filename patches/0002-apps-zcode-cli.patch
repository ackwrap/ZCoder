@@ -0,0 +1,276 @@
+import { EventEmitter } from "node:events";
+import { watch, type FSWatcher } from "node:fs";
+import { mkdir, mkdtemp, rename, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createNodeContextSourceAdapter } from "../src/context/index.js";
+
+vi.mock("node:fs", async (original) => {
+  const actual = await original<typeof import("node:fs")>();
+  return { ...actual, watch: vi.fn(actual.watch) };
+});
+
+afterEach(() => vi.mocked(watch).mockReset());
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "zcode-instruction-watch-"));
+  const workspace = join(root, "workspace");
+  await mkdir(workspace);
+  await mkdir(join(workspace, ".git"));
+  const events = new Map<string, (event: string, name: string | null) => void>();
+  const handles = new Map<string, FSWatcher>();
+  const closed = vi.fn();
+  vi.mocked(watch).mockImplementation(((
+    path: string,
+    _options: unknown,
+    listener: (event: string, name: string | null) => void,
+  ) => {
+    events.set(path, listener);
+    const watcher = new EventEmitter() as FSWatcher;
+    watcher.close = closed;
+    handles.set(path, watcher);
+    return watcher;
+  }) as typeof watch);
+  const adapter = createNodeContextSourceAdapter({ env: { HOME: root } });
+  const options = { workingDirectory: workspace };
+  return { root, workspace, events, handles, closed, adapter, options };
+}
+
+const settle = () => new Promise((resolve) => setTimeout(resolve, 160));
+
+describe("instruction file observation", () => {
+  it("refreshes case-folded event names without changing candidate selection", async () => {
+    const f = await fixture();
+    const path = join(f.workspace, "AGENTS.md");
+    await writeFile(path, "CASE_ONE");
+    const lease = await f.adapter.observeUserInstructions(f.options);
+    try {
+      await writeFile(path, "CASE_TWO");
+      f.events.get(f.workspace)!("change", "agents.md");
+      await settle();
+      expect((await lease.readSnapshot())?.content).toBe("CASE_TWO");
+    } finally {
+      lease.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it.each([".zcode", "AGENTS.md"])(
+    "rebinds a replaced directory after %s rename so generation three remains observable",
+    async (eventName) => {
+      const f = await fixture();
+      const dir = join(f.root, ".zcode");
+      await mkdir(dir);
+      await writeFile(join(dir, "AGENTS.md"), "G1");
+      const lease = await f.adapter.observeUserInstructions(f.options);
+      try {
+        expect((await lease.readSnapshot())?.content).toBe("G1");
+        const original = f.handles.get(dir)!;
+        const originalEvent = f.events.get(dir)!;
+        await rename(dir, join(f.root, "old-zcode"));
+        await mkdir(dir);
+        await writeFile(join(dir, "AGENTS.md"), "G2");
+        originalEvent("rename", eventName);
+        await settle();
+        expect((await lease.readSnapshot())?.content).toBe("G2");
+        const replacement = f.handles.get(dir)!;
+        await writeFile(join(dir, "AGENTS.md"), "G3");
+        // Native handles on the old inode do not receive changes to the replacement.
+        if (replacement !== original) f.events.get(dir)!("change", "AGENTS.md");
+        await settle();
+        expect((await lease.readSnapshot())?.content).toBe("G3");
+        expect(replacement).not.toBe(original);
+      } finally {
+        lease.dispose();
+        await rm(f.root, { recursive: true, force: true });
+      }
+    },
+  );
+
+  it("detects changes through an allowed symlink parent without link-directory events", async () => {
+    const f = await fixture();
+    const target = join(f.root, "external-rules");
+    await mkdir(target);
+    await writeFile(join(target, "AGENTS.md"), "LINK_ONE");
+    // Junctions also exercise realpath indirection without Windows symlink privileges.
+    await symlink(target, join(f.root, ".zcode"), "junction");
+    const lease = await f.adapter.observeUserInstructions(f.options);
+    try {
+      expect((await lease.readSnapshot())?.content).toBe("LINK_ONE");
+      await writeFile(join(target, "replacement"), "LINK_TWO_CHANGED");
+      await rename(join(target, "replacement"), join(target, "AGENTS.md"));
+      expect((await lease.readSnapshot())?.content).toBe("LINK_TWO_CHANGED");
+      expect((await lease.readSnapshot())?.sources?.map((source) => source.filePath)).toEqual([
+        join(f.root, ".zcode", "AGENTS.md"),
+      ]);
+    } finally {
+      lease.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it("recovers a runtime watcher error and keeps independent workspace selections", async () => {
+    const f = await fixture();
+    const other = join(f.root, "other");
+    await mkdir(other);
+    await mkdir(join(other, ".git"));
+    const first = await f.adapter.observeUserInstructions(f.options);
+    const second = await f.adapter.observeUserInstructions({ workingDirectory: other });
+    try {
+      f.handles.get(f.workspace)!.emit("error", new Error("watch failed"));
+      vi.mocked(watch).mockImplementation(() => {
+        throw new Error("still unavailable");
+      });
+      await writeFile(join(f.workspace, "AGENTS.md"), "FIRST");
+      expect((await first.readSnapshot())?.content).toBe("FIRST");
+      expect(await second.readSnapshot()).toBeUndefined();
+      await settle();
+      expect((await first.readSnapshot())?.content).toBe("FIRST");
+      first.dispose();
+      await writeFile(join(other, "AGENTS.md"), "SECOND");
+      f.events.get(other)!("rename", "AGENTS.md");
+      await settle();
+      expect((await second.readSnapshot())?.content).toBe("SECOND");
+    } finally {
+      first.dispose();
+      second.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it("follows the nearest workspace source and rebinds a newly created global parent", async () => {
+    const f = await fixture();
+    const nested = join(f.workspace, "nested");
+    await mkdir(nested);
+    await writeFile(join(f.workspace, "AGENTS.md"), "PARENT");
+    const lease = await f.adapter.observeUserInstructions({ workingDirectory: nested });
+    try {
+      expect((await lease.readSnapshot())?.content).toBe("PARENT");
+      await writeFile(join(nested, "AGENTS.md"), "NEAREST");
+      f.events.get(nested)!("rename", "AGENTS.md");
+      await settle();
+      expect((await lease.readSnapshot())?.content).toBe("NEAREST");
+      await mkdir(join(f.root, ".zcode"));
+      await writeFile(join(f.root, ".zcode", "AGENTS.md"), "GLOBAL");
+      f.events.get(f.root)!("rename", ".zcode");
+      await settle();
+      expect((await lease.readSnapshot())?.content).toBe("GLOBAL\n\nNEAREST");
+      expect(f.events.has(join(f.root, ".zcode"))).toBe(true);
+      await rm(join(nested, "AGENTS.md"));
+      f.events.get(nested)!("rename", "AGENTS.md");
+      await settle();
+      expect((await lease.readSnapshot())?.content).toBe("GLOBAL\n\nPARENT");
+    } finally {
+      lease.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it("isolates selection limits and closes pending debounce without a late read", async () => {
+    const f = await fixture();
+    await writeFile(join(f.workspace, "AGENTS.md"), "ABCDE");
+    const first = await f.adapter.observeUserInstructions({ ...f.options, maxBytes: 2 });
+    const second = await f.adapter.observeUserInstructions({ ...f.options, maxBytes: 4 });
+    try {
+      expect((await first.readSnapshot())?.content).toBe("AB");
+      expect((await second.readSnapshot())?.content).toBe("ABCD");
+      f.events.get(f.workspace)!("change", "AGENTS.md");
+      first.dispose();
+      second.dispose();
+      const count = vi.mocked(watch).mock.calls.length;
+      await settle();
+      expect(vi.mocked(watch)).toHaveBeenCalledTimes(count);
+      expect(await first.readSnapshot()).toBeUndefined();
+    } finally {
+      first.dispose();
+      second.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it("receives real native directory events across atomic replace and delete", async () => {
+    const f = await fixture();
+    vi.mocked(watch).mockImplementation(
+      (await vi.importActual<typeof import("node:fs")>("node:fs")).watch,
+    );
+    const lease = await f.adapter.observeUserInstructions(f.options);
+    try {
+      const path = join(f.workspace, "AGENTS.md");
+      await writeFile(path, "NATIVE_ONE");
+      await expect.poll(async () => (await lease.readSnapshot())?.content).toBe("NATIVE_ONE");
+      await writeFile(join(f.workspace, "atomic"), "NATIVE_TWO");
+      await rename(join(f.workspace, "atomic"), path);
+      await expect.poll(async () => (await lease.readSnapshot())?.content).toBe("NATIVE_TWO");
+      await rm(path);
+      await expect.poll(async () => lease.readSnapshot()).toBeUndefined();
+    } finally {
+      lease.dispose();
+      await rm(f.root, { recursive: true, force: true });
+    }
+  });
+
+  it("watches missing candidates, debounces atomic saves, hashes content and isolates leases", async () => {
+    const f = await fixture();
+    const first = await f.adapter.observeUserInstructions(f.options);
+    const count = vi.mocked(watch).mock.calls.length;
+    const second = await f.adapter.observeUserInstructions(f.options);
+    try {
+      expect(vi.mocked(watch)).toHaveBeenCalledTimes(count);
+      expect(await first.readSnapshot()).toBeUndefined();
+      const path = join(f.workspace, "AGENTS.md");
+      await writeFile(path, "ONE");
+      f.events.get(f.workspace)!("rename", "AGENTS.md");
