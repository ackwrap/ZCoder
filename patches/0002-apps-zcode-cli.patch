@@ -0,0 +1,177 @@
+import { Media, Message, type ContentPart, type ToolResultValue } from "@opencode/ai";
+import type { CodexCallOptions } from "./contract.js";
+
+type RuntimeMessage = CodexCallOptions["prompt"][number];
+type RuntimePart = Exclude<RuntimeMessage, { role: "system" }>["content"][number];
+type RuntimeOutput = Extract<RuntimePart, { type: "tool-result" }>["output"];
+
+function toolOutput(output: RuntimeOutput): ToolResultValue {
+  switch (output.type) {
+    case "json":
+    case "text":
+      return output;
+    case "error-json":
+    case "error-text":
+      return { type: "error", value: output.value };
+    case "execution-denied":
+      return { type: "error", value: output.reason ?? "Tool execution denied" };
+    case "content":
+      return {
+        type: "content",
+        value: output.value.map((part) => {
+          switch (part.type) {
+            case "text":
+              return { type: "text", text: part.text };
+            case "image-data":
+              return {
+                type: "file",
+                uri: `data:${part.mediaType};base64,${part.data}`,
+                mime: part.mediaType,
+              };
+            case "image-url":
+              return { type: "file", uri: part.url, mime: "image/*" };
+            case "file-data":
+              return {
+                type: "file",
+                uri: `data:${part.mediaType};base64,${part.data}`,
+                mime: part.mediaType,
+              };
+            default:
+              throw new Error(`codex-unsupported-tool-content: ${part.type}`);
+          }
+        }),
+      };
+  }
+}
+
+function content(part: RuntimePart): ContentPart {
+  const providerMetadata = part.providerOptions;
+  switch (part.type) {
+    case "text":
+      return { type: "text", text: part.text, providerMetadata };
+    case "reasoning":
+      return { type: "reasoning", text: part.text, providerMetadata };
+    case "file":
+      return {
+        type: "media",
+        filename: part.filename,
+        providerMetadata,
+        media:
+          part.data instanceof URL
+            ? Media.url(part.data.href, { mediaType: part.mediaType })
+            : typeof part.data === "string"
+              ? Media.base64(part.data, part.mediaType)
+              : Media.bytes(part.data, part.mediaType),
+      };
+    case "tool-call":
+      return {
+        type: "tool-call",
+        id: part.toolCallId,
+        name: part.toolName,
+        input: part.input,
+        providerExecuted: part.providerExecuted,
+        providerMetadata,
+      };
+    case "tool-result":
+      return {
+        type: "tool-result",
+        id: part.toolCallId,
+        name: part.toolName,
+        result: toolOutput(part.output),
+        // V3 prompt part 未声明 providerExecuted；存在时透传，避免把 provider-hosted
+        // 结果误判成 client function output。
+        providerExecuted: (part as { providerExecuted?: boolean }).providerExecuted,
+        providerMetadata,
+      };
+    default:
+      throw new Error(`codex-unsupported-message-content: ${part.type}`);
+  }
+}
+
+/** 只翻译运行时结构；instructions/工具/reasoning 的 wire 形态由 opencode 原协议生成。 */
+export function codexMessages(prompt: CodexCallOptions["prompt"]) {
+  const system: string[] = [];
+  const messages: Message[] = [];
+  for (const message of prompt) {
+    if (message.role === "system" && messages.length === 0) {
+      system.push(message.content);
+      continue;
+    }
+    messages.push(
+      Message.make({
+        role: message.role,
+        providerMetadata: message.providerOptions,
+        content: message.role === "system" ? message.content : message.content.map(content),
+      }),
+    );
+  }
+  return { system: system.join("\n\n"), messages };
+}
+
+export function codexTools(options: CodexCallOptions) {
+  return options.tools?.map((tool) => {
+    if (tool.type === "provider") {
+      return codexProviderTool(tool);
+    }
+    if (tool.type !== "function") {
+      throw new Error(
+        `codex-unsupported-provider-tool: ${(tool as { id?: string }).id ?? "unknown"}`,
+      );
+    }
+    return { name: tool.name, description: tool.description ?? "", inputSchema: tool.inputSchema };
+  });
+}
+
+/** Codex 只接受官方核实的 live web_search 形状；其他 provider tool/参数显式失败。 */
+function codexProviderTool(tool: {
+  readonly id: string;
+  readonly name: string;
+  readonly args: Record<string, unknown>;
+}) {
+  if (tool.id !== "openai.web_search" || tool.name !== "web_search") {
+    throw new Error(`codex-unsupported-provider-tool: ${tool.id}`);
+  }
+
+  const args = tool.args;
+  if (args.external_web_access !== true) {
+    throw new Error("codex-unsupported-web-search: external_web_access");
+  }
+  const unsupported = Object.keys(args).filter(
+    (key) => key !== "external_web_access" && key !== "filters",
+  );
+  if (unsupported.length > 0) {
+    throw new Error(`codex-unsupported-web-search: ${unsupported.join(",")}`);
+  }
+
+  const filters = asRecord(args.filters);
+  if (filters !== undefined) {
+    const unsupportedFilter = Object.keys(filters).filter((key) => key !== "allowed_domains");
+    if (unsupportedFilter.length > 0) {
+      throw new Error(`codex-unsupported-web-search-filter: ${unsupportedFilter.join(",")}`);
+    }
+  }
+  const allowedDomains = Array.isArray(filters?.allowed_domains)
+    ? filters.allowed_domains.filter((value): value is string => typeof value === "string")
+    : undefined;
+
+  return {
+    name: tool.name,
+    description: "Provider-native web search used internally by the WebSearch tool",
+    inputSchema: { type: "object", properties: {} },
+    native: {
+      openai: {
+        type: "web_search",
+        external_web_access: true,
+        ...(allowedDomains && allowedDomains.length > 0
+          ? { filters: { allowed_domains: allowedDomains } }
+          : {}),
+      },
+    },
+  };
+}
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
