+import { createHash } from "node:crypto";
+import {
+  parseContextSourceUpdate,
+  type ContextSourceUpdate,
+  type SkillLoadOutcome,
+} from "@zcode/contracts";
+
+/** Stable content version, independent of object property insertion order. */
+export function stableSourceRevision(value: unknown): string {
+  return createHash("sha256").update(stableSourceJson(value)).digest("hex");
+}
+export function stableSourceJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map((item) => stableSourceJson(item)).join(",")}]`;
+  if (value && typeof value === "object")
+    return `{${Object.entries(value)
+      .filter(([, item]) => item !== undefined)
+      .sort(([a], [b]) => a.localeCompare(b))
+      .map(([key, item]) => `${JSON.stringify(key)}:${stableSourceJson(item)}`)
+      .join(",")}}`;
+  return JSON.stringify(value) ?? "null";
+}
+export { parseContextSourceUpdate };
+export type { ContextSourceUpdate };
+
+export function parseSkillCatalog(value: unknown): SkillLoadOutcome | null | undefined {
+  if (value === null) return null;
+  if (
+    !isRecord(value) ||
+    !Array.isArray(value.skills) ||
+    !Array.isArray(value.diagnostics) ||
+    typeof value.totalDiscovered !== "number"
+  )
+    return undefined;
+  for (const skill of value.skills) {
+    if (
+      !isRecord(skill) ||
+      !["name", "description", "path", "directory", "rootPath", "scope", "source"].every(
+        (key) => typeof skill[key] === "string",
+      ) ||
+      typeof skill.safeToAutoLoad !== "boolean" ||
+      !Array.isArray(skill.frontmatterKeys) ||
+      !skill.frontmatterKeys.every((key) => typeof key === "string")
+    )
+      return undefined;
+  }
+  return structuredClone(value) as unknown as SkillLoadOutcome;
+}
+export function parseMcpToolVersions(value: unknown): Record<string, string> | undefined {
+  if (!isRecord(value) || !Object.values(value).every((item) => typeof item === "string"))
+    return undefined;
+  return { ...value } as Record<string, string>;
+}
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
