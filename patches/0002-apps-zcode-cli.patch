+
+    const [mainStart, sideRequest, mainContinue] = captures;
+    expect(mainStart.body.tools).toEqual(
+      expect.arrayContaining([expect.objectContaining({ name: "WebSearch", type: "function" })]),
+    );
+    expect(mainStart.body.tools.some((tool: any) => tool.type === "web_search")).toBe(false);
+    expect(mainStart.body.include).toEqual(["reasoning.encrypted_content"]);
