+/**
+ * compact 的 unit 是真实 user 起始轮次，而不是 assistant 分组。选中结果始终是
+ * runtime 尾部 suffix，因此只需在持久化分支上找到该 suffix 的首条消息：
+ * - 首个保留条目是真实 user 时，按其中真实 user 数量取倒数第 N 条持久化 user；
+ * - 首个保留条目是 assistant 时，按 assistant 数量定位对应的持久化 assistant；
+ * - 首个保留条目是 synthetic user/attachment 时，只能用 exact source/text 命中
+ *   对应持久化消息；命中不了说明它只是 runtime-only 条目，跳过它并用后续
+ *   可靠锚点做最小映射，绝不按分组数回退扩大回已摘要的 user 轮次。
+ * tail 固定为分支末尾，和 runtime 选中的尾部 suffix 对齐；找不到可靠锚点时
+ * 不写 preservedSegment，避免冷恢复重新带入已摘要历史或错位。
+ */
+function selectCompactPersistedTail(
+  active: readonly MessageWithParts[],
+  input: {
+    preservedEntries?: readonly RuntimeMessageEntry[];
+  },
+): MessageWithParts[] {
+  const preservedEntries = input.preservedEntries ?? [];
+  const recordableEntries = preservedEntries.filter(
+    (entry) => isRuntimeAttachmentEntry(entry) || entry.queryScope === undefined,
+  );
+  if (recordableEntries.length === 0) {
+    // 只保留了 query-local 续写提示：live 历史也会过滤它，不能把已摘要的持久化消息重新带回。
+    return [];
+  }
+
+  const headIndex = resolveCompactPersistedHeadIndex(active, recordableEntries);
+  if (
+    headIndex < 0 &&
+    recordableEntries.some(
+      (entry) => isRuntimeRealUserEntry(entry) || isRuntimeAssistantEntry(entry),
+    )
+  ) {
+    throw new Error("Cannot reliably map the compact preserved tail to persisted history");
+  }
+  return headIndex >= 0 ? active.slice(headIndex) : [];
+}
+
+function resolveCompactPersistedHeadIndex(
+  active: readonly MessageWithParts[],
+  recordableEntries: readonly RuntimeMessageEntry[],
+): number {
+  for (let index = 0; index < recordableEntries.length; index += 1) {
+    const remainingEntries = recordableEntries.slice(index);
+    const entry = remainingEntries[0]!;
+    if (isRuntimeRealUserEntry(entry)) {
+      const headIndex = findNthFromLastPersistedRealUser(
+        active,
+        remainingEntries.filter(isRuntimeRealUserEntry).length,
