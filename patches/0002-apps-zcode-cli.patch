@@ -0,0 +1,51 @@
+/** Auditable catalog changes, not authority to enable tools or change permissions. */
+export interface ContextSourceUpdate {
+  version: 1;
+  kind: "skills" | "agents" | "mcp_tools" | "instructions";
+  sourceKey: string;
+  revision: string;
+  changes: Array<{
+    sourceKey: string;
+    label: string;
+    change: "added" | "replaced" | "removed";
+  }>;
+}
+
+export function parseContextSourceUpdate(value: unknown): ContextSourceUpdate | undefined {
+  if (
+    !isRecord(value) ||
+    value.version !== 1 ||
+    !["skills", "agents", "mcp_tools", "instructions"].includes(String(value.kind)) ||
+    typeof value.sourceKey !== "string" ||
+    typeof value.revision !== "string" ||
+    !Array.isArray(value.changes)
+  )
+    return undefined;
+  const changes: ContextSourceUpdate["changes"] = [];
+  for (const item of value.changes) {
+    if (
+      !isRecord(item) ||
+      typeof item.sourceKey !== "string" ||
+      typeof item.label !== "string" ||
+      !["added", "replaced", "removed"].includes(String(item.change))
+    )
+      return undefined;
+    changes.push({
+      sourceKey: item.sourceKey,
+      label: item.label,
+      change: item.change as ContextSourceUpdate["changes"][number]["change"],
+    });
+  }
+  if (new Set(changes.map((item) => item.sourceKey)).size !== changes.length) return undefined;
+  return {
+    version: 1,
+    kind: value.kind as ContextSourceUpdate["kind"],
+    sourceKey: value.sourceKey,
+    revision: value.revision,
+    changes,
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
