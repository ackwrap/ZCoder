+    hiddenPartId: PartId;
+    messageId: MessageId;
+    partId: PartId;
+    turnId: TurnId;
+    productTurnId: string;
+  };
+}
+
+export function buildForkedSessionInput(
+  runtime: AgentRuntimeInternal,
+  parentSession: SessionInfo,
+  forkedSessionId: SessionId,
