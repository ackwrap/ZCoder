-
-function parseRipgrepJsonEvent(line: string, path: string): RipgrepJsonEvent {
-  try {
-    return JSON.parse(line) as RipgrepJsonEvent;
-  } catch (error) {
-    throw createFileSystemError({
-      code: "io_error",
-      path,
-      message: "Failed to parse ripgrep JSON output",
-      cause: error,
