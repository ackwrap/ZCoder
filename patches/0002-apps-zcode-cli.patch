--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/compact/session-limit/contract.ts
@@ -0,0 +1,17 @@
+export type AutoCompactLimit = { unit: "tokens" | "percent"; value: number };
+export interface AutoCompactLimitStatus {
+  limit: AutoCompactLimit | null;
+  contextWindowTokens: number;
+  requestedThresholdTokens: number | null;
+  effectiveThresholdTokens: number;
+}
+
+export function applyAutoCompactLimit(safeThreshold: number, contextWindow: number, limit?: AutoCompactLimit | null): number {
+  if (!limit) return safeThreshold;
+  if (!Number.isFinite(limit.value) || limit.value <= 0 ||
+      (limit.unit === "percent" ? limit.value > 100 : !Number.isSafeInteger(limit.value))) {
+    throw new Error("Invalid automatic compaction limit");
+  }
+  const requested = limit.unit === "percent" ? Math.floor(contextWindow * limit.value / 100) : limit.value;
+  return Math.min(safeThreshold, Math.max(1, requested));
+}
