+    worker.once("error", (error: Error) => {
+      settle(() => reject(error));
+    });
+
+    worker.once("exit", (code: number) => {
+      if (settled) return;
+      settle(() => reject(new Error(`ripgrep worker exited before returning a result: ${code}`)));
