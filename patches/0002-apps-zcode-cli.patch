+import type { ModelProperties } from "@zcode/contracts";
+import type { RegistryModelConfig, RegistryProviderConfig } from "@zcode/provider";
+
+const TRUSTED_CODEX_BASE_URL = "https://api.openai.com/v1";
+
+/**
+ * Codex 可信身份的单一 owner：`bindModel` 的端点门禁与 runtime 能力标记都必须走这里，
+ * 避免 createModel/bindModel 两套校验漂移。只认 resolved provider 配置，不接受 modelId
+ * 或用户元数据推断。
+ */
+export function isTrustedCodexProviderConfig(input: {
+  readonly access: { readonly type: string };
+  readonly api?: { readonly type: string; readonly baseUrl: string };
+  readonly baseURL?: string;
+  readonly kind?: string;
+}): boolean {
+  const kind = input.kind ?? (input.api?.type === "openai-responses" ? "openai" : input.api?.type);
+  const baseURL = input.baseURL ?? input.api?.baseUrl;
+  return (
+    input.access.type === "codex-oauth" && kind === "openai" && baseURL === TRUSTED_CODEX_BASE_URL
+  );
+}
+
+export function resolveRuntimeModelProperties(input: {
+  readonly modelConfig: Pick<RegistryModelConfig, "properties">;
+  readonly providerConfig: RegistryProviderConfig;
+}): ModelProperties {
+  // runtime-only 标记只能由可信 resolved provider 身份产生；先无条件删除调用方/持久化
+  // 数据里的同名值，避免非 Codex provider 借伪造属性拿到能力。
+  const { nativeWebSearchProvider: _ignored, ...properties } = input.modelConfig
+    .properties as ModelProperties;
+  if (!isTrustedCodexProviderConfig(input.providerConfig)) {
+    return properties as ModelProperties;
+  }
+  return {
+    ...properties,
+    nativeWebSearchProvider: "codex",
+    supportsNativeWebSearch: true,
+  };
+}
