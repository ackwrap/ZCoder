+import { describe, expect, it, vi } from "vitest";
+import {
+  createRootTraceContext,
+  createSessionId,
+  SessionEventType,
+  type McpPort,
+  type SessionEntryInfo,
+  type SessionStorePort,
+  type SkillMetadata,
+  type SkillPort,
+} from "@zcode/contracts";
+import { createTestAgentRuntime } from "../test-agent-runtime.js";
+import { createTestSessionEventStore } from "../test-event-store.js";
+
+function fixture(mode: "build" | "yolo" = "yolo") {
+  const entries = new Map<string, SessionEntryInfo>();
+  const sessionStore = {
+    getSession: vi.fn(async () => null),
+    createSession: vi.fn(async () => ({})),
+    saveSessionEntry: vi.fn(async (entry: SessionEntryInfo) => {
+      entries.set(entry.id, structuredClone(entry));
+    }),
+    sessionEntries: vi.fn(async ({ sessionID, type }: { sessionID: string; type?: string }) =>
+      [...entries.values()].filter(
+        (entry) => entry.sessionID === sessionID && (!type || entry.type === type),
+      ),
+    ),
+  } as unknown as SessionStorePort;
+  const metadata: SkillMetadata = {
+    name: "skill",
+    qualifiedName: "plugin:skill",
+    description: "test",
+    path: "/fixture/SKILL.md",
+    directory: "/fixture",
+    rootPath: "/fixture",
+    source: "plugin",
+    scope: "project",
+    safeToAutoLoad: true,
+    frontmatterKeys: [],
+  };
+  const skillPort: SkillPort = {
+    discoverSkills: vi.fn(async () => ({
+      skills: [metadata],
+      diagnostics: [],
+      totalDiscovered: 1,
+    })),
+    loadSkill: vi.fn(async () => ({
+      metadata,
+      content: "skill body",
+      baseDirectory: "/fixture",
+      bytesRead: 10,
+      sizeBytes: 10,
+      truncated: false,
+    })),
+  };
+  const descriptor = {
+    serverName: "fixture",
+    toolName: "read",
+    inputSchema: { type: "object", properties: {} },
+    annotations: { readOnlyHint: true },
+  };
+  const mcpPort = {
+    connectConfiguredServers: vi.fn(async () => ({ statuses: {}, tools: [descriptor] })),
+    status: vi.fn(async () => ({})),
+    listTools: vi.fn(async () => [descriptor]),
+    callTool: vi.fn(async () => ({ content: [{ type: "text", text: "upstream" }] })),
+  } as unknown as McpPort;
+  const eventStore = createTestSessionEventStore();
+  const sessionId = createSessionId("resource-runtime");
+  const runtime = createTestAgentRuntime(
+    sessionId,
+    {
+      mode,
+      workingDirectory: "/fixture",
+      toolSearch: { mode: "local" },
+      mcp: { enabled: true, servers: { fixture: { type: "stdio", command: "node" } } },
+    },
+    { eventStore, sessionStore, skillPort, mcpPort },
+  );
+  return { runtime, sessionId, eventStore, sessionStore, skillPort, mcpPort };
+}
+
+describe("runtime session resource controls", () => {
+  it("tags each resource with its source so the UI can hide built-in and plugin entries", async () => {
+    const f = fixture();
+    await f.runtime.refreshSessionResources();
+    const events = await f.eventStore.getEvents(f.sessionId);
+    const resources = events
+      .filter((event) => event.type === SessionEventType.SessionResourcesUpdated)
+      .at(-1)?.payload as {
+      skills: { id: string; source?: string }[];
+      mcpServers: { id: string; source?: string }[];
+    };
+    // plugin 来源的 Skill 归为 plugin，用户配置的 MCP 归为 user。
+    expect(resources.skills.find((skill) => skill.id === "plugin:skill")?.source).toBe("plugin");
+    expect(resources.mcpServers.find((server) => server.id === "fixture")?.source).toBe("user");
+  });
+  it("persists current-session settings and guards the real Skill and MCP executors", async () => {
+    const f = fixture();
+    await f.runtime.refreshSessionResources();
+    await f.runtime.initializeMcp(createRootTraceContext({ sessionId: f.sessionId }));
+    await f.runtime.setSessionResource({ kind: "skill", id: "plugin:skill", enabled: false });
+    await f.runtime.setSessionResource({ kind: "mcp", id: "fixture", enabled: false });
+    const execute = f.runtime.getToolExecutor();
+    const skill = await execute.execute({ id: "skill", name: "Skill", input: { skill: "skill" } });
+    expect(skill.success).toBe(false);
+    expect(skill.error?.message).toContain("disabled in this session");
+    expect(JSON.stringify(skill)).not.toContain("skill body");
+    const mcp = await execute.execute({ id: "mcp", name: "mcp__fixture__read", input: {} });
+    expect(mcp.success).toBe(false);
+    expect(mcp.error?.message).toContain("disabled in this session");
+    const deferred = await execute.execute(
+      {
+        id: "deferred",
+        name: "DeferredToolCall",
+        input: { name: "mcp__fixture__read", input: {} },
+      },
+      {
+        toolSearch: {
+          mode: "local",
+          enabled: true,
+          catalog: [
+            { name: "DeferredToolCall", deferred: false },
+            { name: "mcp__fixture__read", deferred: true },
+          ],
+          discovered: new Set(["mcp__fixture__read"]),
+        },
+      },
+    );
+    expect(deferred.error?.message).toContain("disabled in this session");
+    expect(f.mcpPort.callTool).not.toHaveBeenCalled();
+    await f.runtime.setSessionResource({ kind: "mcp", id: "fixture", enabled: true });
+    const enabledResult = await execute.execute({
+      id: "mcp-again",
+      name: "mcp__fixture__read",
+      input: {},
+    });
+    expect(enabledResult.success, JSON.stringify(enabledResult)).toBe(true);
+    expect(f.mcpPort.connectConfiguredServers).toHaveBeenCalledTimes(1);
+    const events = await f.eventStore.getEvents(f.sessionId);
+    expect(
+      events.filter((event) => event.type === SessionEventType.SessionResourcesUpdated).at(-1)
+        ?.payload,
+    ).toMatchObject({ policy: { disabledSkills: ["plugin:skill"], disabledMcpServers: [] } });
+    expect(f.sessionStore.saveSessionEntry).toHaveBeenCalledWith(
+      expect.objectContaining({ type: "session/resource-policy", touchSession: false }),
+    );
+    const restored = createTestAgentRuntime(
+      f.sessionId,
+      { workingDirectory: "/fixture" },
+      { eventStore: createTestSessionEventStore(), sessionStore: f.sessionStore },
+    );
+    await expect(restored.assertSessionResourceEnabled("skill", "plugin:skill")).rejects.toThrow(
+      "disabled in this session",
+    );
+  });
+
+  it("rejects unknown identities without writing policy", async () => {
+    const f = fixture();
+    await expect(
+      f.runtime.setSessionResource({ kind: "mcp", id: "not-configured", enabled: true }),
+    ).rejects.toThrow("unavailable");
+    expect(f.sessionStore.saveSessionEntry).not.toHaveBeenCalled();
+  });
+});
