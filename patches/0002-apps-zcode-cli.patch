+      { message: { role: "tool", toolCallId: "a", toolName: "Read", content: "a" } },
+      { message: { role: "user", content: "intervening" }, metadata: realUserRuntimeMetadata() },
+      { message: { role: "assistant", content: "still waiting" } },
+      { message: { role: "tool", toolCallId: "b", toolName: "Read", content: "b".repeat(5_000) } },
+    ];
+    const selected = selectCompactEntries({ entries, trigger: CompactTrigger.Auto, policy: { profile: "compact", tailBudgetTokens: 1_000 } });
+    expect(selected.preservedEntries).toEqual(entries.slice(-5));
+    assertToolPairs(selected.entriesForSummary);
+    assertToolPairs(selected.preservedEntries);
+  });
+
+  it("does not treat an unmatched tool call as a safe assistant boundary", () => {
+    const entries: RuntimeMessageEntry[] = [
+      ...longTurn(),
+      { message: { role: "assistant", content: "", toolCalls: [{ id: "pending", name: "Read", input: {} }] } },
+      { message: { role: "assistant", content: "still waiting" } },
+    ];
+    const selected = selectCompactEntries({ entries, trigger: CompactTrigger.Auto, policy: { profile: "compact", tailBudgetTokens: 1_000 } });
+    expect(selected.preservedEntries.slice(-2)).toEqual(entries.slice(-2));
+    expect(selected.entriesForSummary.some((entry) => "message" in entry && entry.message.toolCalls?.some((call) => call.id === "pending"))).toBe(false);
+  });
+
+  it("preserves an indivisible oversized last tool segment", () => {
+    const entries: RuntimeMessageEntry[] = [
+      { message: { role: "user", content: "one tool" }, metadata: realUserRuntimeMetadata() },
+      { message: { role: "assistant", content: "", toolCalls: [{ id: "one", name: "Read", input: {} }] } },
+      { message: { role: "tool", toolCallId: "one", toolName: "Read", content: "x".repeat(10_000) } },
+    ];
+    const selected = selectCompactEntries({ entries, trigger: CompactTrigger.Auto, policy: { profile: "compact", tailBudgetTokens: 1_000 } });
+    expect(selected.preservedEntries).toEqual(entries);
+    expect(selected.entriesForSummary).toEqual([]);
