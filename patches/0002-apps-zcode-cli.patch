+}
+
+interface AttemptTiming {
+  providerId: string | undefined;
+  durationMs: number;
+}
+
+/**
+ * 一轮结束时从同一批事件派生轮末速率事实。
+ *
+ * 分子：主轮 ModelComplete 的 output token 之和（与 live 的 turnHeader.outputTokens 同源，
+ * 失败请求上报的 token 不计入）。
+ * 分母：主轮 network attempt 的模型耗时之和（completed/failed），不含重试退避与本地后处理。
+ * 高速轮与 live 一样只看加速 provider 的子集：混合轮回退到普通 provider 后，
+ * 普通侧耗时不是 live 的分母，这里也不能混进来。
+ */
+export function resolveTurnModelTiming(
+  events: readonly SessionEvent[],
+  sinceMs: number,
+): TurnModelTiming | undefined {
+  let outputTokens = 0;
+  const attempts: AttemptTiming[] = [];
+  for (const event of events) {
+    if (event.timestamp.getTime() < sinceMs) continue;
+    if (event.type === SessionEventType.ModelComplete) {
+      const payload = event.payload as ModelCompletePayload;
+      if (!isMainTurnComplete(payload)) continue;
+      const tokens = payload.usage?.outputTokens;
+      if (typeof tokens === "number" && Number.isFinite(tokens) && tokens > 0) {
+        outputTokens += tokens;
+      }
+      continue;
+    }
+    if (event.type !== SessionEventType.ModelNetworkStatus) continue;
+    const payload = event.payload as ModelNetworkStatusEvent;
+    if (payload.type !== "model_request_completed" && payload.type !== "model_request_failed") {
+      continue;
+    }
+    if (payload.querySource !== undefined && payload.querySource !== "main_turn") continue;
+    const durationMs = payload.durationMs;
+    if (typeof durationMs !== "number" || !Number.isFinite(durationMs) || durationMs < 0) continue;
+    attempts.push({ providerId: payload.providerId, durationMs });
