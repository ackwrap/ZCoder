+import { describe, expect, it, vi } from "vitest";
+import { configureAutoCompact } from "../../src/zcode-protocol-v4/commands/handlers/autocompact.js";
+import type { V4CommandCoreHost } from "../../src/zcode-protocol-v4/commands/types.js";
+import type { CommandEnvelope } from "@zcode/shared/zcode-protocol-v4";
+
+describe("session autocompact handler", () => {
+  it("queries and updates only the envelope session runtime", async () => {
+    const configure = vi.fn(() => ({ limit: null, contextWindowTokens: 200000, requestedThresholdTokens: null, effectiveThresholdTokens: 166000 }));
+    const getRecord = vi.fn((id: string) => id === "current" ? { app: { runtime: { configureAutoCompact: configure } } } : undefined);
+    const host = { getRecord } as unknown as V4CommandCoreHost;
+    const envelope = { sessionId: "current", payload: {} } as CommandEnvelope;
+    expect((await configureAutoCompact(host, envelope)).type).toBe("configureAutoCompact");
+    expect(configure).toHaveBeenLastCalledWith(undefined);
+    await configureAutoCompact(host, { ...envelope, payload: { limit: { unit: "tokens", value: 100000 } } });
+    expect(configure).toHaveBeenLastCalledWith({ limit: { unit: "tokens", value: 100000 } });
+    await expect(configureAutoCompact(host, { ...envelope, sessionId: "missing" })).rejects.toThrow();
+    expect(configure).toHaveBeenCalledTimes(2);
+  });
+});
