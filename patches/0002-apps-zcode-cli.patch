+const UA = "opencode/latest/2.1.4/cli";
+const textItem = {
+  id: "msg_fixture",
+  type: "message",
+  role: "assistant",
+  status: "completed",
+  content: [{ type: "output_text", text: "你好 done", annotations: [] }],
+};
+function frames(output: unknown[] = [textItem]) {
+  return [
+    {
+      type: "response.created",
+      response: { id: "resp_fixture", model: "gpt-6.1-sol", created_at: 1 },
+    },
+    ...output.flatMap((item, index) => [
+      { type: "response.output_item.added", output_index: index, item },
+      { type: "response.output_item.done", output_index: index, item },
+    ]),
+    {
+      type: "response.completed",
+      response: {
+        id: "resp_fixture",
+        model: "gpt-6.1-sol",
+        status: "completed",
+        output,
+        usage: {
+          input_tokens: 12,
+          output_tokens: 7,
+          total_tokens: 19,
+          input_tokens_details: { cached_tokens: 4 },
+          output_tokens_details: { reasoning_tokens: 3 },
+        },
+      },
+    },
+  ];
+}
+function sse(events: unknown[] = frames(), split = false) {
+  const bytes = new TextEncoder().encode(
+    events.map((e) => `data: ${JSON.stringify(e)}\r\n\r\n`).join(""),
+  );
+  return new Response(
+    new ReadableStream<Uint8Array>({
+      start(controller) {
+        for (let index = 0; index < bytes.length; index += split ? 1 : bytes.length)
+          controller.enqueue(bytes.slice(index, index + (split ? 1 : bytes.length)));
+        controller.close();
+      },
+    }),
+    { headers: { "content-type": "text/event-stream" } },
+  );
+}
+function fixture(response: () => Response | Promise<Response> = () => sse()) {
+  const transport = vi.fn(async (_url: unknown, _init?: RequestInit) => response());
+  const routing = { resolve: vi.fn() };
+  const execution = new AiSdkModelExecution(
+    { endpointRoutingPort: routing },
+    { transport: transport as typeof fetch },
+  );
