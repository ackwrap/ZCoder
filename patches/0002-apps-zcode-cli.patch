+import type {
+  ContextSourceUpdate,
+  MessageContextSnapshot,
+  MessageWithParts,
+  SkillLoadOutcome,
+  SkillMetadata,
+  TraceContext,
+} from "@zcode/contracts";
+import { activeSessionMessages } from "../../agent/session-history-hydrator.js";
+import {
+  parseSkillCatalog,
+  parseMcpToolVersions,
+  stableSourceRevision,
+} from "../../agent/context-source-metadata.js";
+import {
+  systemReminderAttachmentEntry,
+  type RuntimeMessageEntry,
+} from "../../agent/message-history.js";
+import { buildSkillsSection } from "../../context/sections/skills.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { persistRuntimeReminderMessage } from "./runtime-reminder-persistence.js";
+
+export interface SkillCatalogState {
+  baseline: SkillLoadOutcome | null;
+  applied: SkillLoadOutcome | null;
+  initialized: SkillLoadOutcome | null;
+  baselinePersisted: boolean;
+}
+export function initializeSkillCatalog(runtime: AgentRuntimeInternal): void {
+  const initial = structuredClone(runtime.skillLoadOutcome ?? null);
+  runtime.skillCatalogState = {
+    baseline: initial,
+    applied: initial,
+    initialized: initial,
+    baselinePersisted: false,
+  };
+}
+export function skillCatalogCheckpoint(
+  runtime: AgentRuntimeInternal,
+  current = false,
+): Pick<MessageContextSnapshot, "skillCatalog"> {
+  const state = runtime.skillCatalogState;
+  return state ? { skillCatalog: structuredClone(current ? state.applied : state.baseline) } : {};
+}
+export function commitSkillCatalogBaseline(
+  runtime: AgentRuntimeInternal,
+  catalog: SkillLoadOutcome | null,
+): void {
+  const state = runtime.skillCatalogState;
+  if (!state) return;
+  state.baseline = structuredClone(catalog);
+  state.baselinePersisted = Boolean(runtime.sessionStore);
+}
+export async function restoreSkillCatalogHistory(
+  runtime: AgentRuntimeInternal,
+  messages: MessageWithParts[],
+  branch: Parameters<typeof activeSessionMessages>[1],
+): Promise<void> {
+  const state = runtime.skillCatalogState;
+  if (!state) return;
+  const timeline = activeSessionMessages(messages, {
+    ...branch,
+    includeCompactPreservedSegment: false,
+  });
+  const mcpCheckpoint = timeline.find(
+    (m) => m.info.role === "user" && m.info.contextSnapshot?.mcpToolVersions !== undefined,
+  );
+  runtime.mcpSourceBaseline =
+    mcpCheckpoint?.info.role === "user"
+      ? new Map(
+          Object.entries(
+            parseMcpToolVersions(mcpCheckpoint.info.contextSnapshot?.mcpToolVersions) ?? {},
+          ),
+        )
+      : undefined;
+  runtime.mcpBaselinePersisted = Boolean(mcpCheckpoint);
+  const saved = timeline.find(
+    (m) => m.info.role === "user" && m.info.contextSnapshot?.skillCatalog !== undefined,
+  );
+  const checkpoint =
+    saved?.info.role === "user"
+      ? parseSkillCatalog(saved.info.contextSnapshot?.skillCatalog)
+      : undefined;
+  let fallback = state.initialized;
+  if (checkpoint === undefined && runtime.skillPort) {
+    try {
+      const current = await runtime.skillPort.discoverSkills({
+        workingDirectory: runtime.workspaceRoot,
+      });
+      if (
+        !current.diagnostics.some(
+          (d) => d.code === "skill_scan_failed" || d.code === "skill_read_failed",
+        )
+      )
+        fallback = current;
+    } catch {
+      /* Retain the last initialized trusted snapshot on read failure. */
+    }
+  }
+  if (runtime.shuttingDown || runtime.skillCatalogState !== state) return;
+  state.baseline = runtime.skillPort ? (checkpoint !== undefined ? checkpoint : fallback) : null;
+  state.baselinePersisted = checkpoint !== undefined;
+  state.applied = structuredClone(state.baseline);
+  runtime.mcpCatalogAnnounced = timeline.length > 0;
+  for (const message of timeline)
+    for (const part of message.parts) {
+      if (part.type !== "text") continue;
+      const metadata = part.metadata?.runtimeMessage as { mcpToolVersions?: unknown } | undefined;
+      const versions = parseMcpToolVersions(metadata?.mcpToolVersions);
+      if (versions) runtime.mcpSourceBaseline = new Map(Object.entries(versions));
+    }
+  const entries = runtime.messageHistory
+    .borrowReadOnlyRuntimeEntries()
+    .filter((entry) => runtime.skillPort || entry.metadata?.sourceUpdate?.kind !== "skills");
+  for (const entry of entries) {
+    if (
+      entry.metadata?.source === "context_source_update" &&
+      entry.metadata.sourceUpdate?.kind === "skills"
+    ) {
+      const catalog = parseSkillCatalog(entry.metadata.skillCatalog);
+      if (catalog !== undefined) state.applied = catalog;
+    }
+  }
+  if (!runtime.mcpSourceBaseline && runtime.mcpToolsRegistered) {
+    const visible = new Set(runtime.getTools().map((tool) => tool.name));
+    runtime.mcpSourceBaseline = new Map(
+      [...(runtime.mcpRegisteredDescriptorVersions ?? [])].filter(([name]) => visible.has(name)),
+    );
+  }
+  runtime.skillLoadOutcome = structuredClone(state.applied ?? undefined);
+  runtime.messageHistory.replaceMessages(entries);
+}
+
+function key(skill: SkillMetadata): string {
+  return `skills:${JSON.stringify([skill.qualifiedName ?? skill.name, skill.path])}`;
+}
+function catalogItems(catalog: SkillLoadOutcome | null): Map<string, SkillMetadata> {
+  return new Map(
+    (catalog?.skills ?? []).map((skill) => [
+      key(skill),
+      { ...skill, frontmatterKeys: [...skill.frontmatterKeys].sort() },
+    ]),
+  );
+}
+export function skillCatalogRevision(catalog: SkillLoadOutcome | null): string {
+  return stableSourceRevision([...catalogItems(catalog)].sort(([a], [b]) => a.localeCompare(b)));
+}
+
+/** Discovery only: no bodies, execution, configuration writes or session-policy reset. */
+export async function consumeSkillCatalogUpdates(
+  runtime: AgentRuntimeInternal,
+  traceContext: TraceContext,
+): Promise<RuntimeMessageEntry[]> {
+  const state = runtime.skillCatalogState;
+  if (!state || !runtime.skillPort || runtime.shuttingDown) return [];
+  let current: SkillLoadOutcome;
+  try {
+    current = await runtime.skillPort.discoverSkills({
+      workingDirectory: runtime.workspaceRoot,
+      trace: traceContext,
+    });
+  } catch {
+    return [];
+  }
+  // Partial IO failure is not proof of deletion. Retry the entire trusted catalog at the next boundary.
+  if (
+    current.diagnostics.some(
+      (d) => d.code === "skill_scan_failed" || d.code === "skill_read_failed",
+    )
+  )
+    return [];
+  if (runtime.shuttingDown || runtime.skillCatalogState !== state) return [];
+  const revision = skillCatalogRevision(current);
+  if (revision === skillCatalogRevision(state.applied)) {
+    runtime.skillLoadOutcome = structuredClone(current);
+    return [];
+  }
+  const before = catalogItems(state.applied),
+    after = catalogItems(current);
+  const changes: ContextSourceUpdate["changes"] = [];
+  for (const sourceKey of [...new Set([...before.keys(), ...after.keys()])].sort()) {
+    const old = before.get(sourceKey),
+      next = after.get(sourceKey);
+    if (old && next && stableSourceRevision(old) === stableSourceRevision(next)) continue;
+    const source = next ?? old!;
+    changes.push({
+      sourceKey,
+      label: source.qualifiedName ?? source.name,
+      change: next ? (old ? "replaced" : "added") : "removed",
+    });
+  }
+  const sourceUpdate: ContextSourceUpdate = {
+    version: 1,
+    kind: "skills",
+    sourceKey: "skills:catalog",
+    revision,
+    changes,
+  };
+  const section = buildSkillsSection({
+    outcome: current,
+    metadataBudget: runtime.config.skillMetadataBudget,
+  });
+  const entry = {
+    ...systemReminderAttachmentEntry(
+      "context_source_update",
+      [
+        "Skill catalog update (skills:catalog). The complete catalog below replaces the previous available-Skills listing only.",
+        ...changes.map(
+          (change) => `${change.change}: ${JSON.stringify(change.label)} (${change.sourceKey})`,
+        ),
+        "Already loaded Skill content is unchanged; use the Skill tool explicitly to load current content. This update grants no permissions and does not enable session-disabled Skills.",
+        section?.content ?? "No Skills are currently available in this catalog.",
+      ].join("\n\n"),
+    ),
+    metadata: {
+      source: "context_source_update" as const,
+      sourceUpdate,
+      skillCatalog: structuredClone(current),
+    },
+  };
+  const messageId = await persistRuntimeReminderMessage.call(runtime, entry, traceContext);
+  if (messageId) runtime.latestConversationMessageId = messageId;
+  runtime.messageHistory.addEntries([entry]);
+  state.applied = structuredClone(current);
+  runtime.skillLoadOutcome = structuredClone(current);
+  return [entry];
+}
