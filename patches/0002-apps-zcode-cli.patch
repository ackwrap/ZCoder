+  const compressed = Buffer.from(await request.arrayBuffer());
+  return {
+    url: String(url),
+    init: init!,
+    headers: request.headers,
+    body: JSON.parse(zstdDecompressSync(compressed).toString("utf8")),
+  };
+}
