+    { endpointRoutingPort: routing },
+    { transport: transport as typeof fetch },
+  );
+  const bind = execution.bindModel({
+    providerId: "codex-fixture",
+    modelId: "gpt-6.1-sol",
+    supportsJsonSchemaOutput: true,
+    providerConfig: new ProviderConfig({
+      group: "standard-personal",
+      access: new CodexOAuthAccessConfig(),
+      api: new ProviderApiConfig({
+        type: "openai-responses",
+        baseUrl: "https://api.openai.com/v1",
+      }),
+    }) as never,
+    optionSpecs: {
+      reasoningLevel: { map: '{"reasoning":{"effort":reasoningLevel}}' },
+      maxOutputTokens: { map: '{"max_output_tokens":maxOutputTokens}' },
+    },
+  });
+  const resolved = bind.resolveRequest({
+    options: { reasoningLevel: "high", maxOutputTokens: 1024 },
+    requestAuth: {
+      apiKey: "fixture-token",
+      codexMode: "device",
+      headers: {
