+import type { MessageWithParts } from "@zcode/contracts";
+import {
+  contextSourceUpdateSchema,
+  type ContextSourceUpdateProjection,
+} from "@zcode/shared/zcode-protocol-v4";
+
+/** Only explicit runtime-owned audit metadata, never the hidden model-facing part text. */
+export function contextSourceUpdateNotices(message: MessageWithParts): Array<{
+  type: "context_source_update";
+  content: "";
+  messageId: string;
+  partId: string;
+  sourceUpdate: ContextSourceUpdateProjection;
+}> {
+  const info = message.info;
+  if (
+    info.role !== "user" ||
+    info.synthetic !== true ||
+    info.semantics?.origin !== "agent_runtime" ||
+    info.semantics.uiVisibility !== "hidden" ||
+    info.semantics.transcriptVisibility !== "hidden"
+  )
+    return [];
+  return message.parts.flatMap((part) => {
+    if (
+      part.type !== "text" ||
+      String(part.sessionID) !== String(info.sessionID) ||
+      String(part.messageID) !== String(info.id)
+    )
+      return [];
+    const metadata = part.metadata;
+    if (!metadata || typeof metadata !== "object") return [];
+    const runtime = metadata.runtimeMessage;
+    const runtimeRecord =
+      runtime && typeof runtime === "object" && !Array.isArray(runtime)
+        ? (runtime as Record<string, unknown>)
+        : undefined;
+    const source = metadata.source ?? runtimeRecord?.source;
+    if (
+      source !== "context_source_update" &&
+      source !== "instruction_file_update" &&
+      source !== "agent_listing_delta" &&
+      source !== "tool_search_announcement"
+    )
+      return [];
+    const parsed = contextSourceUpdateSchema.safeParse(
+      metadata.sourceUpdate ?? runtimeRecord?.sourceUpdate,
+    );
+    if (!parsed.success) return [];
+    return [
+      {
+        type: "context_source_update" as const,
+        content: "" as const,
+        messageId: String(info.id),
+        partId: String(part.id),
+        sourceUpdate: parsed.data,
+      },
+    ];
+  });
+}
