@@ -0,0 +1,215 @@
+import { describe, expect, it } from "vitest";
+import { SessionEventType, type MessageWithParts, type SessionEvent } from "@zcode/contracts";
+import { mergeColdConversationEvents } from "../src/zcode-protocol-v4/cold-event-merge.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { synthesizeEventsFromMessages } from "../src/zcode-protocol-v4/transcript-hydration.js";
+
+const update = {
+  version: 1,
+  kind: "skills",
+  sourceKey: "skills:catalog",
+  revision: "a".repeat(64),
+  changes: [
+    { sourceKey: "skills:one", label: "One", change: "added" },
+    { sourceKey: "skills:two", label: "Two", change: "replaced" },
+    { sourceKey: "skills:old", label: "Old", change: "removed" },
+  ],
+};
+const fact = (payload: unknown): SessionEvent =>
+  ({
+    id: "event1",
+    sessionId: "s1",
+    type: SessionEventType.SystemMessage,
+    payload,
+    timestamp: new Date(),
+    sequenceNumber: 1,
+    traceId: "trace1",
+  }) as SessionEvent;
+const payload = {
+  type: "context_source_update",
+  content: "NEVER SHOW PROMPT",
+  messageId: "message1",
+  partId: "part1",
+  sourceUpdate: update,
+};
+
+function hiddenMessage(
+  metadata: Record<string, unknown> = { source: "context_source_update", sourceUpdate: update },
+): MessageWithParts {
+  return {
+    info: {
+      id: "message1",
+      sessionID: "s1",
+      role: "user",
+      time: { created: 1 },
+      synthetic: true,
+      semantics: {
+        origin: "agent_runtime",
+        kind: "system_reminder",
+        uiVisibility: "hidden",
+        transcriptVisibility: "hidden",
+        providerVisibility: "visible",
+      },
+    },
+    parts: [
+      {
+        type: "text",
+        id: "part1",
+        messageID: "message1",
+        sessionID: "s1",
+        synthetic: true,
+        text: "SECRET SYSTEM PROMPT",
+        metadata,
+      },
+    ],
+  } as unknown as MessageWithParts;
+}
+
+function noticeRows(events: readonly SessionEvent[]) {
+  const projection = new ProductProjection("s1", "epoch1");
+  for (const event of events) projection.applyEvent(event);
+  return projection
+    .getSnapshot()
+    .rows.window.filter(
+      (row) => row.kind === "timelineMarker" && row.marker.type === "contextSourceUpdate",
+    );
+}
+
+describe("context source update audit notice", () => {
+  it("projects only the safe change metadata and deduplicates by durable part", () => {
+    const rows = noticeRows([
+      fact(payload),
+      { ...fact(payload), id: "event2" as SessionEvent["id"], sequenceNumber: 2 },
+    ]);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      kind: "timelineMarker",
+      entityId: "part1",
+      marker: { type: "contextSourceUpdate", update },
+    });
+    expect(JSON.stringify(rows)).not.toContain("NEVER SHOW PROMPT");
+  });
+
+  it("restores a trusted hidden part without making a visible user message", () => {
+    const projection = new ProductProjection("s1", "epoch1");
+    for (const event of synthesizeEventsFromMessages([hiddenMessage()], { sessionId: "s1" }))
+      projection.applyEvent(event);
+    expect(projection.getSnapshot().rows.window).toHaveLength(1);
+    expect(JSON.stringify(projection.getSnapshot().rows.window)).not.toContain(
+      "SECRET SYSTEM PROMPT",
+    );
+  });
+
+  it.each([
+    "context_source_update",
+    "instruction_file_update",
+    "agent_listing_delta",
+    "tool_search_announcement",
+  ])("restores %s runtime metadata without hidden bodies", (source) => {
+    const rows = noticeRows(
+      synthesizeEventsFromMessages(
+        [
+          hiddenMessage({
+            runtimeMessage: { source, sourceUpdate: update, content: "RUNTIME SECRET" },
+          }),
+        ],
+        { sessionId: "s1" },
+      ),
+    );
+    expect(rows).toHaveLength(1);
+    expect(JSON.stringify(rows)).not.toContain("SECRET");
+  });
+
+  it.each([
+    {},
+    { ...update, version: 2 },
+    { ...update, changes: [{ label: "Invalid" }] },
+    { ...update, changes: [] },
+  ])("ignores malformed or empty metadata", (sourceUpdate) => {
+    expect(noticeRows([fact({ ...payload, sourceUpdate })])).toHaveLength(0);
+  });
+
+  it("keeps legacy or user-controlled part metadata hidden", () => {
+    const message = {
+      info: {
+        id: "user1",
+        sessionID: "s1",
+        role: "user",
+        time: { created: 1 },
+        synthetic: true,
+        visibility: "model-only",
+      },
+      parts: [
+        {
+          type: "text",
+          id: "part1",
+          messageID: "user1",
+          sessionID: "s1",
+          text: "HIDDEN",
+          metadata: { sourceUpdate: update },
+        },
+      ],
+    } as unknown as MessageWithParts;
+    const events = synthesizeEventsFromMessages([message], { sessionId: "s1" });
+    expect(
+      events.some((item) => (item.payload as { type?: string }).type === "context_source_update"),
+    ).toBe(false);
+  });
+
+  it("deduplicates durable and memory notices before projection", () => {
+    const merged = mergeColdConversationEvents({
+      memoryEvents: [fact(payload)],
+      messages: [hiddenMessage()],
+      sessionId: "s1",
+    });
+    const notices = merged.events.filter(
+      (event) =>
+        event.type === SessionEventType.SystemMessage &&
+        (event.payload as { type?: string }).type === "context_source_update",
+    );
+    expect(notices).toHaveLength(1);
+    expect(noticeRows(merged.events)).toHaveLength(1);
+    expect(JSON.stringify(merged.events)).not.toContain("SECRET SYSTEM PROMPT");
+    expect(JSON.stringify(merged.events)).not.toContain("NEVER SHOW PROMPT");
+  });
+
+  it.each([true, false])(
+    "does not revive a retired memory notice when another active message exists: %s",
+    (hasActiveMessage) => {
+      const messages = hasActiveMessage
+        ? [
+            {
+              ...hiddenMessage(),
+              info: { ...hiddenMessage().info, id: "other-message" },
+              parts: [],
+            } as unknown as MessageWithParts,
+          ]
+        : [];
+      const merged = mergeColdConversationEvents({
+        memoryEvents: [fact(payload)],
+        messages,
+        sessionId: "s1",
+      });
+      expect(noticeRows(merged.events)).toHaveLength(0);
+    },
+  );
+
+  it("preserves a pending live notice when its exact active message is present", () => {
+    const memoryEvents = [
+      {
+        ...fact({ input: "active", messageId: "input1" }),
+        type: SessionEventType.TurnStarted,
+        turnId: "active-turn",
+      } as SessionEvent,
+      { ...fact(payload), id: "event2", sequenceNumber: 2, turnId: "active-turn" } as SessionEvent,
+    ];
+    const message = hiddenMessage();
+    message.info.anchor = { turnId: "active-turn" as never };
+    const merged = mergeColdConversationEvents({
+      memoryEvents,
+      messages: [message],
+      sessionId: "s1",
+    });
+    expect(noticeRows(merged.events)).toHaveLength(1);
+  });
+});
