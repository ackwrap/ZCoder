@@ -0,0 +1,27 @@
+import type { AutoCompactPolicyConfig } from "../policy.js";
+import { getAutoCompactThreshold, DEFAULT_COMPACT_CONTEXT_WINDOW } from "../policy.js";
+import type { RuntimeModelFactory } from "../../runtime/types.js";
+import type { ModelSelection } from "@zcode/contracts";
+import type { AutoCompactLimit, AutoCompactLimitStatus } from "./contract.js";
+
+export function configureSessionAutoCompact(
+  config: { compact?: AutoCompactPolicyConfig },
+  selection: ModelSelection | undefined,
+  modelFactory: RuntimeModelFactory,
+  change?: { limit: AutoCompactLimit | null },
+): AutoCompactLimitStatus {
+  if (!selection) throw new Error("Session model is not ready");
+  const model = modelFactory({ selection });
+  const contextWindow = model.properties.contextWindow ?? DEFAULT_COMPACT_CONTEXT_WINDOW;
+  const policy = { ...config.compact, contextWindow, maxOutputTokens: model.optionSpecs.maxOutputTokens.max };
+  if (change) policy.sessionLimit = change.limit;
+  const effectiveThresholdTokens = getAutoCompactThreshold(policy);
+  if (change) config.compact = { ...config.compact, sessionLimit: change.limit };
+  const limit = policy.sessionLimit ?? null;
+  return {
+    limit,
+    contextWindowTokens: contextWindow,
+    requestedThresholdTokens: limit ? limit.unit === "percent" ? Math.floor(contextWindow * limit.value / 100) : limit.value : null,
+    effectiveThresholdTokens,
+  };
+}
