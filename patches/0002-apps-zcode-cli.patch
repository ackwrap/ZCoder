+const compressCodexBody = promisify(zstdCompress);
+
+/** Compress only the fixed token-sharing route, after option mapping and request-security processing. */
+export function createCodexResponsesFetch(
+  transport: typeof globalThis.fetch,
+  mode?: "device",
+): typeof globalThis.fetch {
+  return async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    if (url.href !== "https://api.openai.com/v1/responses" || request.method !== "POST") {
+      throw new Error("codex-endpoint-not-allowed");
+    }
+    request.signal.throwIfAborted();
+    let body = Buffer.from(await request.arrayBuffer());
+    let nonStreaming = false;
+    if (mode === "device") {
+      // 设备码身份属于 Codex 后端，不是 Token Sharing；只映射这个固定目标，禁止用户端点覆盖。
+      const value = JSON.parse(body.toString("utf8")) as Record<string, unknown>;
+      nonStreaming = value.stream !== true;
+      value.store = false;
+      value.stream = true;
+      delete value.max_output_tokens;
+      delete value.max_tokens;
+      delete value.temperature;
+      delete value.top_p;
+      const instructions: string[] =
+        typeof value.instructions === "string" ? [value.instructions] : [];
+      if (Array.isArray(value.input))
+        value.input = value.input.filter((item) => {
+          if (!item || (item.role !== "system" && item.role !== "developer")) return true;
+          if (typeof item.content === "string") instructions.push(item.content);
+          else if (Array.isArray(item.content))
+            for (const part of item.content)
+              if (typeof part.text === "string") instructions.push(part.text);
+          return false;
+        });
+      value.instructions = instructions.join("\n\n");
+      body = Buffer.from(JSON.stringify(value));
+    }
+    const compressed = await compressCodexBody(body);
+    request.signal.throwIfAborted();
+    const headers = new Headers(request.headers);
+    headers.set("Content-Encoding", "zstd");
+    headers.delete("Content-Length");
+    const response = await transport(
+      mode === "device" ? "https://chatgpt.com/backend-api/codex/responses" : url,
+      {
+        ...init,
+        method: "POST",
+        headers,
+        body: new Uint8Array(compressed),
+        signal: request.signal,
+        redirect: "error",
+      },
+    );
+    return mode === "device" && nonStreaming && response.ok
+      ? collectCodexResponse(response)
+      : response;
+  };
+}
+
+/** Codex only streams; preserve SDK generateText/compact's JSON contract with a bounded final event. */
+async function collectCodexResponse(response: Response): Promise<Response> {
+  if (!response.headers.get("content-type")?.includes("text/event-stream") || !response.body)
+    return response;
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  let pending = "";
+  let bytes = 0;
+  let completed: unknown;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > 32 * 1024 * 1024) throw new Error("codex-response-too-large");
+      pending += decoder.decode(value, { stream: true });
+      const frames = pending.split(/\r?\n\r?\n/);
+      pending = frames.pop() ?? "";
+      for (const frame of frames) {
+        const data = frame
+          .split(/\r?\n/)
+          .filter((line) => line.startsWith("data:"))
+          .map((line) => line.slice(5).trimStart())
+          .join("\n");
+        if (!data || data === "[DONE]") continue;
+        let event;
+        try {
+          event = JSON.parse(data);
+        } catch {
+          throw new Error("codex-response-invalid");
+        }
+        if (event.type === "response.failed" || event.type === "error")
+          throw new Error("codex-response-failed");
+        if (event.type === "response.completed") completed = event.response;
+      }
+      if (completed) break;
+    }
+  } finally {
+    void reader.cancel().catch(() => {});
+  }
+  if (!completed) throw new Error("codex-response-incomplete");
+  const headers = new Headers(response.headers);
+  headers.set("content-type", "application/json");
+  headers.delete("content-length");
+  headers.delete("content-encoding");
+  return new Response(JSON.stringify(completed), { status: response.status, headers });
+}
