+
+  const sessionId = createSessionId("codex-websearch-runtime");
+  const eventStore = new InMemorySessionEventStore();
+  const runtime = createTestAgentRuntime(
+    sessionId,
+    { modelSelection: createTestModelSelection(`${PROVIDER_ID}/${MODEL_ID}`) },
