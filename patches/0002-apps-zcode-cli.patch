+import type {
+  ContextSourceSnapshot,
+  MessageWithParts,
+  ResolvedUserInstructions,
+  TraceContext,
+  UserInstructionObservation,
+} from "@zcode/contracts";
+import { activeSessionMessages } from "../../agent/session-history-hydrator.js";
 import { countContextPrefixMessages } from "../deps.js";
+import { systemReminderAttachmentEntry } from "../../agent/message-history.js";
+import { persistRuntimeReminderMessage } from "./runtime-reminder-persistence.js";
 import type { Model } from "../deps.js";
 import type { RuntimeMessageEntry } from "../../agent/message-history.js";
 import type { AgentRuntimeInternal } from "../internal.js";
 import { buildContextHistoryEntries } from "./context-history-entries.js";
+import { restoreSkillCatalogHistory } from "./context-source-updates.js";
+import { stableSourceRevision } from "../../agent/context-source-metadata.js";
+
+export interface InstructionFileState {
+  baseline: ResolvedUserInstructions | null;
+  applied: ResolvedUserInstructions | null;
+  baselinePersisted?: boolean;
+  initializedSnapshot: ResolvedUserInstructions | null;
+  observation?: UserInstructionObservation;
+}
+
+function instructionFilesEnabled(runtime: AgentRuntimeInternal): boolean {
+  return (
+    runtime.config.subagentContext?.injectAgentsMd !== false &&
+    Boolean(runtime.config.userInstructions || runtime.config.subagentContext?.userInstructions)
+  );
+}
+
+export async function initializeInstructionFiles(
+  runtime: AgentRuntimeInternal,
+  snapshot: ContextSourceSnapshot,
+): Promise<void> {
+  runtime.instructionFileState?.observation?.dispose();
+  const enabled = instructionFilesEnabled(runtime);
+  const options = runtime.config.userInstructions;
+  const state: InstructionFileState = { baseline: null, applied: null, initializedSnapshot: null };
+  runtime.instructionFileState = state;
+  const observation =
+    enabled && options && runtime.contextSourcePort?.observeUserInstructions
+      ? await runtime.contextSourcePort.observeUserInstructions(options)
+      : undefined;
+  if (runtime.shuttingDown || runtime.instructionFileState !== state) {
+    observation?.dispose();
+    return;
+  }
+  state.observation = observation;
+  try {
+    const current = !enabled
+      ? undefined
+      : observation
+        ? await observation.readSnapshot()
+        : (runtime.config.subagentContext?.userInstructions ?? snapshot.userInstructions);
+    if (runtime.shuttingDown || runtime.instructionFileState !== state) return;
+    snapshot.userInstructions = current;
+    state.baseline = current ?? null;
+    state.applied = current ?? null;
+    state.initializedSnapshot = current ?? null;
+  } catch (error) {
+    observation?.dispose();
+    if (runtime.instructionFileState === state) runtime.instructionFileState = undefined;
+    throw error;
+  }
+}
+
+export async function consumeInstructionFileUpdates(
+  runtime: AgentRuntimeInternal,
+  traceContext: TraceContext,
+): Promise<RuntimeMessageEntry[]> {
+  const state = runtime.instructionFileState;
+  if (!state?.observation || runtime.shuttingDown) return [];
+  const current = (await state.observation.readSnapshot()) ?? null;
+  if (runtime.shuttingDown || runtime.instructionFileState !== state) return [];
+  const before = instructionSources(state.applied);
+  const after = instructionSources(current);
+  const changes: string[] = [];
+  const auditChanges: import("@zcode/contracts").ContextSourceUpdate["changes"] = [];
+  for (const key of new Set([...before.keys(), ...after.keys()])) {
+    const old = before.get(key),
+      next = after.get(key);
+    if (old?.content === next?.content && old?.truncated === next?.truncated) continue;
+    const source = next ?? old!;
+    auditChanges.push({
+      sourceKey: `instructions:${key}`,
+      label: `${source.scope}: ${source.filePath}`,
+      change: next ? (old ? "replaced" : "added") : "removed",
+    });
+    changes.push(
+      [
+        `Instruction file update (${source.scope}): ${JSON.stringify(source.filePath)}`,
+        next
+          ? old
+            ? "The following complete content replaces the previous version of this source only."
+            : "This new instruction source now applies."
+          : "This source was deleted or is no longer selected; its previous content no longer applies.",
+        "Other instruction sources and system/user rules are unchanged. This update grants no additional tool permissions.",
+        ...(next ? ["", next.content, ...(next.truncated ? ["[File truncated]"] : [])] : []),
+      ].join("\n"),
+    );
+  }
+  if (changes.length === 0) return [];
+  const entry = {
+    ...systemReminderAttachmentEntry("instruction_file_update", changes.join("\n\n")),
+    metadata: {
+      source: "instruction_file_update" as const,
+      userInstructions: current,
+      sourceUpdate: {
+        version: 1 as const,
+        kind: "instructions" as const,
+        sourceKey: "instructions:files",
+        revision: stableSourceRevision([...after].sort(([a], [b]) => a.localeCompare(b))),
+        changes: auditChanges,
+      },
+    },
+  };
+  const messageId = await persistRuntimeReminderMessage.call(runtime, entry, traceContext);
+  if (messageId) runtime.latestConversationMessageId = messageId;
+  runtime.messageHistory.addEntries([entry]);
+  state.applied = current;
+  if (runtime.contextSourceSnapshot)
+    runtime.contextSourceSnapshot = {
+      ...runtime.contextSourceSnapshot,
+      userInstructions: current ?? undefined,
+    };
+  return [entry];
+}
+
+function instructionSources(instructions: ResolvedUserInstructions | null) {
+  return new Map(
+    (
+      instructions?.sources ??
+      (instructions ? [{ ...instructions, scope: "workspace" as const }] : [])
+    ).map((source) => [`${source.scope}:${source.filePath}`, source]),
+  );
+}
+
+/** Restores only the selected branch; preserved pre-compact messages are not a new baseline. */
+export async function restoreInstructionFileHistory(
+  runtime: AgentRuntimeInternal,
+  messages: MessageWithParts[],
+  branch: Parameters<typeof activeSessionMessages>[1] = {},
+): Promise<void> {
+  await restoreSkillCatalogHistory(runtime, messages, branch);
+  const state = runtime.instructionFileState;
+  if (!state) {
+    rebuildContextPrefix(runtime);
+    return;
+  }
+  const disabled = !instructionFilesEnabled(runtime);
+  const timeline = activeSessionMessages(messages, {
+    ...branch,
+    includeCompactPreservedSegment: false,
+  });
+  const saved = timeline.find(
+    (m) => m.info.role === "user" && m.info.contextSnapshot?.userInstructions !== undefined,
+  );
+  const baseline = disabled
+    ? null
+    : saved?.info.role === "user"
+      ? (saved.info.contextSnapshot!.userInstructions ?? null)
+      : state.observation
+        ? ((await state.observation.readSnapshot()) ?? null)
+        : state.initializedSnapshot;
+  if (runtime.shuttingDown || runtime.instructionFileState !== state) return;
+  state.baseline = baseline;
+  state.baselinePersisted = !disabled && Boolean(saved);
+  state.applied = state.baseline;
+  const entries = runtime.messageHistory
+    .borrowReadOnlyRuntimeEntries()
+    .filter((entry) => !disabled || entry.metadata?.source !== "instruction_file_update");
+  for (const entry of entries) {
+    if (
+      entry.metadata?.source === "instruction_file_update" &&
+      entry.metadata.userInstructions !== undefined
+    )
+      state.applied = entry.metadata.userInstructions;
+  }
+  runtime.messageHistory.replaceMessages(entries);
