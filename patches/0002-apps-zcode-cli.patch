+  runtime: ThisParameterType<PersistRuntimeReminderMessage>,
+  ...args: Parameters<PersistRuntimeReminderMessage>
+): ReturnType<PersistRuntimeReminderMessage> {
+  return persist.call(runtime, ...args);
+}
