+import { zstdDecompressSync } from "node:zlib";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+// 集成测试直接驱动 adapters/core 源码，避免依赖可能滞后的 dist 构建产物。
+vi.mock("@zcode/adapters/model", async () => await import("../../adapters/src/model/index.js"));
