+          input_tokens_details: { cached_tokens: 4 },
+          output_tokens_details: { reasoning_tokens: 3 },
+        },
+      },
+    },
+  ];
+}
+function sse(events: unknown[] = frames(), split = false) {
+  const bytes = new TextEncoder().encode(
+    events.map((e) => `data: ${JSON.stringify(e)}\r\n\r\n`).join(""),
+  );
+  return new Response(
+    new ReadableStream<Uint8Array>({
+      start(controller) {
+        for (let index = 0; index < bytes.length; index += split ? 1 : bytes.length)
+          controller.enqueue(bytes.slice(index, index + (split ? 1 : bytes.length)));
+        controller.close();
+      },
+    }),
+    { headers: { "content-type": "text/event-stream" } },
+  );
+}
+function fixture(response: () => Response | Promise<Response> = () => sse()) {
+  const transport = vi.fn(async (_url: unknown, _init?: RequestInit) => response());
+  const routing = { resolve: vi.fn() };
+  const execution = new AiSdkModelExecution(
+    { endpointRoutingPort: routing },
+    { transport: transport as typeof fetch },
+  );
+  const bind = execution.bindModel({
+    providerId: "codex-fixture",
+    modelId: "gpt-6.1-sol",
+    supportsJsonSchemaOutput: true,
+    providerConfig: new ProviderConfig({
+      group: "standard-personal",
+      access: new CodexOAuthAccessConfig(),
+      api: new ProviderApiConfig({
+        type: "openai-responses",
+        baseUrl: "https://api.openai.com/v1",
+      }),
+    }) as never,
+    optionSpecs: {
+      reasoningLevel: { map: '{"reasoning":{"effort":reasoningLevel}}' },
+      maxOutputTokens: { map: '{"max_output_tokens":maxOutputTokens}' },
+    },
+  });
+  const resolved = bind.resolveRequest({
+    options: { reasoningLevel: "high", maxOutputTokens: 1024 },
+    requestAuth: {
+      apiKey: "fixture-token",
+      codexMode: "device",
+      headers: {
