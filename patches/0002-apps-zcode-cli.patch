+export async function setSessionResource(
+  this: AgentRuntimeInternal,
+  input: { kind: "skill" | "mcp"; id: string; enabled: boolean },
+  traceContext = this.rootTraceContext,
+): Promise<void> {
+  const resources = await readSessionResources(this);
+  const items = input.kind === "skill" ? resources.skills : resources.mcpServers;
+  const item = items.find((candidate) => candidate.id === input.id);
+  if (!item || !item.available) throw new Error("Resource is unavailable in this session");
+  await this.sessionResources.set(input.kind, input.id, input.enabled);
+  const policy = this.sessionResources.snapshot();
