+function resolveSkillSource(source: SkillMetadata["source"]): "builtin" | "plugin" | "user" {
+  if (source === "bundled" || source === "zcode") return "builtin";
+  return source === "plugin" ? "plugin" : "user";
+}
+
+const BUILTIN_MCP_SERVER_NAMES = new Set(["node_repl"]);
+const PLUGIN_MCP_SERVER_PREFIX = "plugin:";
+
+function resolveMcpServerSource(id: string): "builtin" | "plugin" | "user" {
+  if (BUILTIN_MCP_SERVER_NAMES.has(id)) return "builtin";
+  return id.startsWith(PLUGIN_MCP_SERVER_PREFIX) ? "plugin" : "user";
+}
