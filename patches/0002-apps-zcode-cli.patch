index 0000000000000000000000000000000000000000..3607144e75ebfe0397d6784d214867c5466f1e6f
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/session-resources/module.ts
@@ -0,0 +1,106 @@
+import { CoreErrorType, createCoreError, type McpPort, type SkillPort } from "@zcode/contracts";
+import {
+  sessionResourcePolicySchema,
+  type SessionResourcePolicy,
+} from "@zcode/shared/zcode-protocol-v4";
+import type {
+  SessionResourceControl,
+  SessionResourceKind,
+  SessionResourcePersistence,
+} from "./contract.js";
+
+/** 只拥有本会话 deny 策略；配置、连接、授权和其他 runtime 不属于这里。 */
+export class SessionResourceController implements SessionResourceControl {
+  private policy: SessionResourcePolicy = {
+    revision: 0,
+    disabledSkills: [],
+    disabledMcpServers: [],
+  };
+  private restoring?: Promise<void>;
+  private mutation: Promise<void> = Promise.resolve();
+
+  constructor(private readonly persistence?: SessionResourcePersistence) {}
+
+  restore(): Promise<void> {
+    this.restoring ??= (async () => {
+      const stored = await this.persistence?.load();
+      // 损坏配置不能被当作空 denylist，否则冷恢复会静默恢复用户已禁用的资源。
+      if (stored !== undefined) this.policy = sessionResourcePolicySchema.parse(stored);
+    })().catch((error) => {
+      // 读取失败仍保持 fail-closed，但允许下一次明确重试，不把一次临时 IO 故障永久缓存。
+      this.restoring = undefined;
+      throw error;
+    });
+    return this.restoring;
+  }
+
+  snapshot(): SessionResourcePolicy {
+    return {
+      ...this.policy,
+      disabledSkills: [...this.policy.disabledSkills],
+      disabledMcpServers: [...this.policy.disabledMcpServers],
+    };
+  }
+
+  set(kind: SessionResourceKind, id: string, enabled: boolean): Promise<void> {
+    const operation = this.mutation.then(async () => {
+      await this.restore();
+      const key = kind === "skill" ? "disabledSkills" : "disabledMcpServers";
+      const disabled = new Set(this.policy[key]);
+      if (disabled.has(id) === !enabled) return;
+      if (enabled) disabled.delete(id);
+      else disabled.add(id);
+      const next = {
+        ...this.policy,
+        revision: this.policy.revision + 1,
+        [key]: [...disabled].sort(),
+      };
+      // 先存后发布：失败时不能让 UI/执行层接受一份重启即丢失的“成功”状态。
+      await this.persistence?.save(next);
+      this.policy = next;
+    });
+    this.mutation = operation.catch(() => {});
+    return operation;
+  }
+
+  async assertEnabled(kind: SessionResourceKind, id: string): Promise<void> {
+    await this.restore();
+    const disabled = kind === "skill" ? this.policy.disabledSkills : this.policy.disabledMcpServers;
+    if (disabled.includes(id)) {
+      throw createCoreError(
+        CoreErrorType.PermissionDenied,
+        "Resource is disabled in this session",
+        { recoverable: true },
+      );
+    }
+  }
+
+  guardSkillPort(port: SkillPort): SkillPort {
+    return {
+      discoverSkills: port.discoverSkills.bind(port),
+      loadSkill: async (request, options) => {
+        await this.restore();
+        const loaded = await port.loadSkill(request, options);
+        // 只认解析后的稳定身份，不能用请求中的短名/别名误伤同名插件或绕过禁用。
+        await this.assertEnabled("skill", loaded.metadata.qualifiedName ?? loaded.metadata.name);
+        return loaded;
+      },
+    };
+  }
+
+  guardMcpPort(port: McpPort): McpPort {
+    return new Proxy(port, {
+      get: (target, property) => {
+        const value = Reflect.get(target, property);
+        if (typeof value !== "function") return value;
+        if (property === "callTool") {
+          return async (...args: Parameters<McpPort["callTool"]>) => {
+            await this.assertEnabled("mcp", args[0].serverName);
+            return value.apply(target, args);
+          };
+        }
+        return value.bind(target);
+      },
+    });
+  }
+}
