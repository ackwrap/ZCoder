+
+function isRuntimeAssistantEntry(entry: RuntimeMessageEntry): boolean {
+  return !isRuntimeAttachmentEntry(entry) && entry.message.role === "assistant";
+}
+
+function isRuntimeRealUserEntry(entry: RuntimeMessageEntry): boolean {
+  return (
+    !isRuntimeAttachmentEntry(entry) &&
