+import { expect, it } from "vitest";
+import type { CodexCallOptions } from "../src/model/codex-transport/contract.js";
+import { codexTools } from "../src/model/codex-transport/messages.js";
+
+function tools(filters?: unknown) {
+  return codexTools({
+    tools: [
+      {
+        type: "provider",
+        id: "openai.web_search",
+        name: "web_search",
+        args: { external_web_access: true, ...(filters !== undefined ? { filters } : {}) },
+      },
+    ],
+  } as CodexCallOptions);
+}
+
+it.each(
+  [
+    null,
+    false,
+    "example.com",
+    [],
+    { allowed_domains: "example.com" },
+    { allowed_domains: [] },
+    { allowed_domains: ["example.com", 1] },
+    { allowed_domains: [""] },
+    { allowed_domains: [" "] },
+  ].map((value) => [value]),
+)("rejects malformed search restrictions rather than broadening search: %j", (filters) => {
+  expect(() => tools(filters)).toThrow(/codex-unsupported-web-search/);
+});
+
+it("preserves supported domain restrictions and unrestricted search", () => {
+  expect(tools({ allowed_domains: ["example.com", "docs.example.com"] })?.[0]).toMatchObject({
+    native: { openai: { filters: { allowed_domains: ["example.com", "docs.example.com"] } } },
+  });
+  expect(tools()?.[0]).toMatchObject({
+    native: { openai: { type: "web_search", external_web_access: true } },
+  });
+  expect(tools({})?.[0]).toMatchObject({ native: { openai: { type: "web_search" } } });
+});
