+export function createInstructionObservationRegistry(
+  dependencies: InstructionObservationDependencies,
+): InstructionObservationRegistry {
+  const observations = new Map<string, Promise<{ acquire(): UserInstructionObservation }>>();
+  async function observe(
+    options: UserInstructionsOptions,
+    sourceEnv: NodeJS.ProcessEnv,
+  ): Promise<UserInstructionObservation> {
+    const normalized = {
+      ...options,
+      workingDirectory: resolve(options.workingDirectory),
+      projectRoot: options.projectRoot ? resolve(options.projectRoot) : undefined,
+      priorityFiles: [...(options.priorityFiles ?? dependencies.defaultPriorityFiles)],
+    };
+    const env = { ...sourceEnv };
+    const key = JSON.stringify({ ...normalized, userHome: dependencies.resolveUserHome(env) });
+    let pending = observations.get(key);
+    if (!pending) {
+      pending = createInstructionObservation(
+        normalized,
+        env,
+        () => observations.delete(key),
+        dependencies,
+      );
+      observations.set(key, pending);
+      void pending.catch(() => {
+        if (observations.get(key) === pending) observations.delete(key);
+      });
+    }
+    const observation = await pending;
+    if (observations.get(key) !== pending) return observe(options, sourceEnv);
+    return observation.acquire();
+  }
+  return { observe };
+}
+
+async function createInstructionObservation(
+  options: UserInstructionsOptions,
+  env: NodeJS.ProcessEnv,
+  onClosed: () => void,
+  dependencies: InstructionObservationDependencies,
+): Promise<{ acquire(): UserInstructionObservation }> {
+  const projectRoot =
+    options.projectRoot ?? (await dependencies.findProjectRoot(options.workingDirectory));
+  options = { ...options, projectRoot: projectRoot ?? undefined };
+  const candidates: string[] = [];
+  for (let dir = resolve(options.workingDirectory); ; dir = dirname(dir)) {
+    for (const name of options.priorityFiles ?? dependencies.defaultPriorityFiles)
+      candidates.push(join(dir, name));
+    if (dir === projectRoot || dir === dirname(dir)) break;
+  }
+  if ((options.priorityFiles ?? dependencies.defaultPriorityFiles).includes("AGENTS.md")) {
+    candidates.push(join(dependencies.resolveUserHome(env), ".zcode", "AGENTS.md"));
+  }
+  const watchers = new Map<string, { watcher: FSWatcher; names: Set<string>; identity: string }>();
+  let closed = false,
+    leases = 0,
+    fallback = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let snapshot: ResolvedUserInstructions | undefined;
+  let hash = "",
+    revision = "";
+  let queue = Promise.resolve();
+  const fingerprint = async () =>
+    JSON.stringify(
+      await Promise.all(
+        candidates.map(async (path) => {
+          try {
+            const info = await stat(path);
+            return [path, info.mtimeMs, info.ctimeMs, info.size, info.ino];
+          } catch {
+            return [path, null];
+          }
+        }),
+      ),
+    );
+  const schedule = () => {
+    if (closed) return;
+    if (timer) clearTimeout(timer);
+    timer = setTimeout(() => {
+      timer = undefined;
+      void refresh().catch(() => {
+        fallback = true;
+      });
+    }, 100);
+    timer.unref();
+  };
+  async function bindWatchers() {
+    const targets = new Map<string, { names: Set<string>; identity: string }>();
+    fallback = false;
+    for (const candidate of candidates) {
+      try {
+        if ((await lstat(candidate)).isSymbolicLink()) fallback = true;
+        if ((await realpath(candidate)) !== resolve(candidate)) fallback = true;
+      } catch {
+        /* Missing candidates still use their nearest existing parent. */
+      }
+      let dir = dirname(candidate);
+      let identity = "";
+      while (true) {
+        try {
+          if ((await lstat(dir)).isSymbolicLink()) fallback = true;
+          const info = await stat(dir);
+          if (info.isDirectory()) {
+            const target = await realpath(dir);
+            if (target !== resolve(dir)) fallback = true;
+            identity = JSON.stringify([target, info.dev, info.ino, info.birthtimeMs]);
+            break;
+          }
+        } catch {
+          /* Missing parent: anchor at an existing ancestor. */
+        }
+        if (dir === dirname(dir)) break;
+        dir = dirname(dir);
+      }
+      const name = relative(dir, candidate).split(sep)[0]!.toLowerCase();
+      const names = targets.get(dir)?.names ?? new Set<string>();
+      names.add(name);
+      targets.set(dir, { names, identity });
+    }
+    if (closed) return;
+    for (const [dir, entry] of watchers) {
+      if (targets.get(dir)?.identity !== entry.identity) {
+        entry.watcher.close();
+        watchers.delete(dir);
+      }
+    }
+    for (const [dir, { names, identity }] of targets) {
+      const existing = watchers.get(dir);
+      if (existing) {
+        existing.names = names;
+        continue;
+      }
+      try {
+        const watcher = watch(dir, { persistent: false }, (event, name) => {
+          if (watchers.get(dir)?.watcher !== watcher) return;
+          const eventName = name === null ? undefined : String(name).toLowerCase();
+          if (event === "rename" && (!eventName || eventName === basename(dir).toLowerCase())) {
+            watcher.close();
+            watchers.delete(dir);
+            fallback = true;
+            schedule();
+          } else if (!eventName || watchers.get(dir)?.names.has(eventName)) {
+            schedule();
+          }
+        });
+        const entry = { watcher, names, identity };
+        watchers.set(dir, entry);
+        watcher.on("error", () => {
+          watcher.close();
+          if (watchers.get(dir) !== entry) return;
+          watchers.delete(dir);
+          fallback = true;
+          schedule();
+        });
+      } catch {
+        fallback = true;
+      }
+    }
+  }
+  function refresh() {
+    queue = queue
+      .catch(() => undefined)
+      .then(async () => {
+        if (closed) return;
+        await bindWatchers();
+        const nextRevision = await fingerprint();
+        const next = await dependencies.resolveInstructions(options, env);
+        const nextHash = createHash("sha256")
+          .update(JSON.stringify(next ?? null))
+          .digest("hex");
+        if (closed) return;
+        if (nextHash !== hash) {
+          snapshot = next;
+          hash = nextHash;
+        }
+        revision = nextRevision;
+      });
+    return queue;
+  }
+  function close() {
+    if (closed) return;
+    closed = true;
+    if (timer) clearTimeout(timer);
+    for (const { watcher } of watchers.values()) watcher.close();
+    watchers.clear();
+    onClosed();
+  }
+  try {
+    await refresh();
+  } catch (error) {
+    close();
+    throw error;
+  }
+  return {
+    acquire() {
+      leases++;
+      let released = false;
+      return {
+        async readSnapshot() {
+          if (released) return undefined;
+          await queue;
+          if (released) return undefined;
+          if (fallback && (await fingerprint()) !== revision) {
+            if (released) return undefined;
+            await refresh();
+          }
+          if (released) return undefined;
+          return snapshot ? structuredClone(snapshot) : undefined;
+        },
+        dispose() {
+          if (released) return;
+          released = true;
+          if (--leases > 0) return;
+          close();
+        },
+      };
+    },
+  };
+}
