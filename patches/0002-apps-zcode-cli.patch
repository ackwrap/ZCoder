+
+describe("Codex WebSearch runtime integration", () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it("runs main request -> WebSearch ToolExecutor -> Codex side request -> main continuation", async () => {
+    const { captures, eventStore, runtime, sessionId } = createCodexRuntime((body) => {
+      if (isSideRequest(body)) return sse(sideRequestFrames());
+      return sse(
+        hasToolResult(body)
+          ? finalMainFrames("Final answer with [A](https://example.com/a)")
+          : firstMainFrames(),
+      );
+    });
+
+    const result = await runtime.executeTurn("Search current ZCode info");
+
+    expect(result.response).toContain("Final answer");
+    expect(captures).toHaveLength(3);
+
+    const [mainStart, sideRequest, mainContinue] = captures;
+    expect(mainStart.body.tools).toEqual(
+      expect.arrayContaining([expect.objectContaining({ name: "WebSearch", type: "function" })]),
+    );
+    expect(mainStart.body.tools.some((tool: any) => tool.type === "web_search")).toBe(false);
+    expect(mainStart.body.include).toEqual(["reasoning.encrypted_content"]);
+
+    expect(sideRequest.body.tools).toEqual([{ type: "web_search", external_web_access: true }]);
+    expect(sideRequest.body.include).toEqual([
+      "reasoning.encrypted_content",
+      "web_search_call.action.sources",
+    ]);
+    expect(sideRequest.body.input).toContainEqual(
+      expect.objectContaining({
+        content: expect.arrayContaining([
+          expect.objectContaining({
+            text: "Perform a web search for the query: latest zcode",
+            type: "input_text",
+          }),
+        ]),
+        role: "user",
+      }),
+    );
+
+    expect(mainContinue.body.tools.some((tool: any) => tool.type === "web_search")).toBe(false);
+    const toolOutput = mainContinue.body.input.find(
+      (item: any) => item?.type === "function_call_output",
+    );
+    expect(String(toolOutput?.output)).toContain("https://example.com/a");
+    expect(String(toolOutput?.output)).not.toContain("web_search_call");
+
+    const stored = await eventStore.getEvents(sessionId);
+    expect(
+      stored.some(
+        (event) =>
+          event.type === SessionEventType.ToolCallResult &&
+          event.payload?.toolCallId === "call_websearch",
+      ),
+    ).toBe(true);
+
+    for (const capture of captures) {
+      expect(capture.headers.get("Authorization")).toBe("Bearer fixture-token");
+      expect(capture.headers.get("chatgpt-account-id")).toBe("fixture-account");
+      expect(capture.headers.get("Content-Encoding")).toBe("zstd");
+    }
+  });
+
+  it("propagates a hosted web_search failure instead of reporting empty success", async () => {
+    const { captures, eventStore, runtime, sessionId } = createCodexRuntime((body) => {
+      if (isSideRequest(body)) return sse(sideErrorFrames());
+      return sse(
+        hasToolResult(body)
+          ? finalMainFrames("Final answer after search failure")
+          : firstMainFrames(),
+      );
+    });
+
+    const result = await runtime.executeTurn("Search current ZCode info");
+
+    expect(result.response).toContain("Final answer after search failure");
+    expect(captures).toHaveLength(3);
+    const mainContinue = captures[2];
+    const toolOutput = mainContinue.body.input.find(
+      (item: any) => item?.type === "function_call_output",
+    );
+    expect(String(toolOutput?.output)).toContain("WebSearch stream failed");
+    expect(String(toolOutput?.output)).not.toContain("No links found");
+
+    const stored = await eventStore.getEvents(sessionId);
+    expect(
+      stored.some(
+        (event) =>
+          event.type === SessionEventType.ToolCallError &&
+          event.payload?.toolCallId === "call_websearch",
+      ),
+    ).toBe(true);
+    expect(
+      stored.some(
+        (event) =>
+          event.type === SessionEventType.ToolCallResult &&
+          event.payload?.toolCallId === "call_websearch",
+      ),
+    ).toBe(false);
+
+    const sideStatuses = stored.filter(
+      (event) =>
+        event.type === SessionEventType.ModelNetworkStatus &&
+        event.payload?.querySource === "web_search_tool",
+    ) as Array<{ payload: Record<string, any> }>;
+    const started = sideStatuses.filter((event) => event.payload.type === "model_request_started");
+    const terminal = sideStatuses.filter(
+      (event) =>
+        event.payload.type === "model_request_completed" ||
+        event.payload.type === "model_request_failed",
+    );
+    expect(started).toHaveLength(1);
+    expect(terminal).toHaveLength(1);
+    expect(terminal[0]?.payload.type).toBe("model_request_completed");
+    expect(terminal[0]?.payload.usage).toMatchObject({
+      inputTokens: 20,
+      outputTokens: 1,
+      totalTokens: 21,
+    });
