+  const matchedLineIndexes = new Set(matchingIndexes);
+  const entries = createContextLineIndexes(lines.length, ranges, request).map((lineIndex) => ({
+    path,
+    lineNumber: lineIndex + 1,
+    text: lines[lineIndex] ?? "",
