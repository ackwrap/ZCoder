+import { describe, expect, expectTypeOf, it, vi } from "vitest";
+import type { MessageId, TraceId } from "@zcode/contracts";
+import { parseAgentListingDelta } from "../../src/agent/agent-listing-metadata.js";
+import type {
+  AppendRuntimeAgentListing,
+  CollectAgentListingAttachment,
+  CollectRuntimeAgentListing,
+  ConsumeSkillCatalogUpdates,
+  InitializeSkillCatalog,
+  ParseAgentListingDelta,
+  PersistRuntimeReminderMessage,
+  RemoveRuntimePersistenceMessagesBestEffort,
+  RestoreSkillCatalogHistory,
+  SkillCatalogCheckpoint,
+  StableSourceRevision,
+} from "../../src/runtime/context-source-runtime/contract.js";
+import { examplePersistRuntimeReminderMessage } from "../../src/runtime/context-source-runtime/contract.example.js";
+import type { AgentRuntimeInternal } from "../../src/runtime/internal.js";
+
+// 重方法仅作真实 API 类型引用，不加载 Runtime 或启动既有功能 suite。
+
+describe("context source runtime contract", () => {
+  it("keeps catalog, listing and persistence on their existing APIs", () => {
+    expectTypeOf<
+      typeof import("../../src/agent/context-source-metadata.js").stableSourceRevision
+    >().toEqualTypeOf<StableSourceRevision>();
+    expectTypeOf(parseAgentListingDelta).toEqualTypeOf<ParseAgentListingDelta>();
+    expectTypeOf<
+      typeof import("../../src/runtime/methods/context-source-updates.js").initializeSkillCatalog
+    >().toEqualTypeOf<InitializeSkillCatalog>();
+    expectTypeOf<
+      typeof import("../../src/runtime/methods/context-source-updates.js").skillCatalogCheckpoint
+    >().toEqualTypeOf<SkillCatalogCheckpoint>();
+    expectTypeOf<
+      typeof import("../../src/runtime/methods/context-source-updates.js").restoreSkillCatalogHistory
+    >().toEqualTypeOf<RestoreSkillCatalogHistory>();
+    expectTypeOf<
+      typeof import("../../src/runtime/methods/context-source-updates.js").consumeSkillCatalogUpdates
+    >().toEqualTypeOf<ConsumeSkillCatalogUpdates>();
+    expectTypeOf<
+      typeof import("../../src/runtime/helpers/agent-listing.js").collectRuntimeAgentListing
+    >().toEqualTypeOf<CollectRuntimeAgentListing>();
+    expectTypeOf<
+      typeof import("../../src/runtime/helpers/agent-listing.js").appendRuntimeAgentListing
+    >().toEqualTypeOf<AppendRuntimeAgentListing>();
+    expectTypeOf<
+      typeof import("../../src/subagent/listing.js").collectAgentListingAttachment
+    >().toEqualTypeOf<CollectAgentListingAttachment>();
+    expectTypeOf<
+      typeof import("../../src/runtime/methods/runtime-reminder-persistence.js").persistRuntimeReminderMessage
+    >().toEqualTypeOf<PersistRuntimeReminderMessage>();
+    expectTypeOf<
+      ThisParameterType<PersistRuntimeReminderMessage>
+    >().toEqualTypeOf<AgentRuntimeInternal>();
+    expectTypeOf<ReturnType<PersistRuntimeReminderMessage>>().toEqualTypeOf<
+      Promise<MessageId | undefined>
+    >();
+    expectTypeOf<
+      ThisParameterType<RemoveRuntimePersistenceMessagesBestEffort>
+    >().toEqualTypeOf<AgentRuntimeInternal>();
+    expectTypeOf<ReturnType<RemoveRuntimePersistenceMessagesBestEffort>>().toEqualTypeOf<
+      Promise<void>
+    >();
+  });
+
+  it("forwards the original this, arguments and Promise without another persistence path", async () => {
+    const persist = vi.fn<PersistRuntimeReminderMessage>().mockResolvedValue(undefined);
+    const runtime = {} as ThisParameterType<PersistRuntimeReminderMessage>;
+    const args = [
+      { kind: "attachment", content: "", metadata: { source: "context_source_update" } },
+      { traceId: "trace-contract" as TraceId },
+    ] satisfies Parameters<PersistRuntimeReminderMessage>;
+    const result = examplePersistRuntimeReminderMessage(persist, runtime, ...args);
+    expect(persist.mock.contexts).toEqual([runtime]);
+    expect(persist).toHaveBeenCalledExactlyOnceWith(...args);
+    expect(result).toBe(persist.mock.results[0]?.value);
+    await expect(result).resolves.toBeUndefined();
+  });
+
+  it("restores only structured, non-overlapping public listing deltas", () => {
+    const delta = {
+      addedTypes: ["reader"],
+      addedLines: ["reader: public description"],
+      removedTypes: [],
+      isInitial: true,
+      showConcurrencyNote: true,
+    };
+    expect(parseAgentListingDelta({ ...delta, systemPrompt: "HIDDEN" })).toEqual(delta);
+    expect(parseAgentListingDelta({ ...delta, addedLines: [] })).toBeUndefined();
+    expect(parseAgentListingDelta({ ...delta, removedTypes: ["reader"] })).toBeUndefined();
+    expect(
+      parseAgentListingDelta({
+        ...delta,
+        replacedTypes: ["reader"],
+        replacedLines: ["replacement"],
+      }),
+    ).toBeUndefined();
+  });
+});
