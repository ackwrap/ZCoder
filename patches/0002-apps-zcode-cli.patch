+}
+
+/**
+ * 仅凭持久化事实判断该 user message 冷恢复后是否会成为真实 user 边界。
+ * synthetic 提醒、Continue、coordinator/task 输入和只有状态的空消息都不算。
+ */
+function isPersistedRealUserMessage(message: MessageWithParts): boolean {
+  if (message.info.role !== "user") return false;
+  const presentation = parseRuntimeInputPresentation(
+    (message.info.metadata as Record<string, unknown> | undefined)?.inputPresentation,
+  );
+  const visibleParts = message.parts.filter((part) => !(part.type === "text" && part.ignored));
+  const hasStructuredUserPart = visibleParts.some(
+    (part) => part.type === "file" || part.type === "agent",
+  );
+  const hasRealText = visibleParts.some(
+    (part) => part.type === "text" && !part.synthetic && part.text.trim().length > 0,
+  );
+  // 旧持久化可能把 real_user 身份只写入 text part 的 runtimeMessage。
+  const hasSyntheticRealUserText = visibleParts.some(
+    (part) =>
+      part.type === "text" &&
+      part.synthetic &&
+      part.text.trim().length > 0 &&
+      partRuntimeMessageSource(part.metadata) === "real_user",
+  );
+  const hasUserEnvelope = hasRealText || hasStructuredUserPart || hasSyntheticRealUserText;
+  // inputPresentation 在冷恢复时覆盖 part 推断：只有 user_steer 仍是真实用户。
+  if (presentation) return presentation === "user_steer" && hasUserEnvelope;
+  return hasUserEnvelope;
+}
+
+function partRuntimeMessageSource(metadata: Record<string, unknown> | undefined): unknown {
+  const runtimeMessage = metadata?.runtimeMessage;
+  if (typeof runtimeMessage !== "object" || runtimeMessage === null) return undefined;
+  return (runtimeMessage as { source?: unknown }).source;
+}
