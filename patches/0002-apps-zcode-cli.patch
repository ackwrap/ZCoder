+import { publishModelStatus, statusPublishOptions } from "./runner-status.js";
+
+type StreamDiagnostics = ReturnType<typeof createStreamDiagnostics>;
+type StreamStatusContext = ReturnType<typeof createStatusContext>;
+
+/**
+ * 自然 EOF 后的终态判定：先把 provider business error 与可疑空流转成失败，
+ * 再决定是否进入一次 generic empty completion 重试。返回 true 表示已调度重试。
+ */
+export async function settleStreamBeforeCompletion(input: {
+  attempt: number;
+  diagnostics: StreamDiagnostics;
+  emittedError: boolean;
+  emittedEvent: boolean;
+  emptyCompletionRetryCount: number;
+  logger?: Logger;
+  request: AiSdkModelTextRequest;
+  requestHeaders: Record<string, string>;
+  resolved: ResolvedAiSdkModel;
+  retry: ResolvedAiSdkModelRetryOptions;
+  retryBudgetAttempt: number;
+  startedAt: number;
+  statusContext: StreamStatusContext;
+  statusSink?: ModelStatusSink;
+  streamResult: AiSdkStreamTextResult;
+}): Promise<boolean> {
+  if (input.emittedError) return false;
+
+  const hiddenProviderBusinessError = detectProviderBusinessFinishError({
+    providerId: String(input.statusContext.providerId),
+    providerKind: input.statusContext.providerKind,
+    source:
+      input.diagnostics.lastFinishChunk ??
+      ({
+        type: "finish",
+        finishReason: input.diagnostics.finishReason,
+        rawFinishReason: input.diagnostics.rawFinishReason,
+      } satisfies Record<string, unknown>),
+  });
+  if (hiddenProviderBusinessError) {
+    throw toTerminalStreamError(hiddenProviderBusinessError, input);
+  }
+
+  if (!isSuspiciousStreamDiagnostics(input.diagnostics)) return false;
+
+  const streamEndedWithoutOutputError =
+    detectProviderBusinessFinishError({
+      providerId: String(input.statusContext.providerId),
+      providerKind: input.statusContext.providerKind,
+      source: input.diagnostics.lastErrorChunk ?? input.diagnostics.lastFinishChunk,
+    }) ??
+    createRequestVerificationEmptyStreamError({
+      accountMode: input.resolved.accountAccess?.mode,
+      headers: input.resolved.headers,
+      providerId: String(input.statusContext.providerId),
+      providerKind: input.resolved.providerKind,
+    });
+  if (streamEndedWithoutOutputError) {
+    throw toTerminalStreamError(streamEndedWithoutOutputError, input);
+  }
+
+  const canRetry =
+    input.request.preserveProviderStreamBoundaries !== true &&
+    isZeroOutputModelCompletion({
+      finishReason: input.diagnostics.finishReason,
+      rawFinishReason: input.diagnostics.rawFinishReason,
+      reasoningLength: input.diagnostics.reasoningDeltaChars,
+      textLength: input.diagnostics.textDeltaChars,
+      toolCallCount: input.diagnostics.toolCallCount,
+      usage: input.diagnostics.usage,
+    }) &&
+    canRetryEmptyCompletion({
+      abortSignal: input.request.abortSignal,
+      attempt: input.attempt,
+      maxAttempts: input.retry.maxAttempts,
+      retryCount: input.emptyCompletionRetryCount,
+    });
+  if (!canRetry) return false;
+
+  const responseHeaders = await resolveStreamResponseHeaders(input.streamResult);
+  const completedAt = Date.now();
+  // finish 会把 retry-safe 前奏刷成可见事件；空 completion 需在
+  // flush 前进入一次 adapter retry，避免 core 把第一次 attempt 当成已完成。
+  logStreamDiagnostics({
+    attempt: input.attempt,
+    diagnostics: input.diagnostics,
+    durationMs: completedAt - input.startedAt,
+    emittedError: input.emittedError,
+    emittedEvent: input.emittedEvent,
+    logger: input.logger,
+    outboundHeaders: input.resolved.headers,
+    statusContext: input.statusContext,
+  });
+  await scheduleEmptyCompletionRetry({
+    abortSignal: input.request.abortSignal,
+    attempt: input.attempt,
+    completedAt,
+    errorPhase: "stream",
+    logger: input.logger,
+    requestHeaders: input.requestHeaders,
+    requestStatusSink: input.request.statusSink,
+    responseHeaders,
+    retry: input.retry,
+    retryBudgetAttempt: input.retryBudgetAttempt,
+    startedAt: input.startedAt,
+    statusContext: input.statusContext,
+    statusSink: input.statusSink,
+    streamOutputCommitted: false,
+  });
+  return true;
+}
+
+function toTerminalStreamError(
+  error: unknown,
+  input: {
+    attempt: number;
+    request: AiSdkModelTextRequest;
+    statusContext: StreamStatusContext;
+  },
+): unknown {
+  if (isRequestVerificationRejection(error)) return error;
+  const failure: ClassifiedModelFailure = classifyModelFailure(error, input.request.abortSignal);
+  return new TerminalStreamChunkError(
+    toAdapterError(error, failure, input.statusContext, input.attempt, {
+      ...compactStreamFailureContext(
+        input.request.preserveProviderStreamBoundaries,
+        "response_body",
+      ),
+      errorPhase: "stream",
+    }),
+  );
+}
+
+/** 发布自然完成状态；返回是否写入终态，供外层 finally 判断是否需要补发。 */
+export async function publishStreamCompletion(input: {
+  admission?: AttemptAdmission;
+  attempt: number;
+  diagnostics: StreamDiagnostics;
+  emittedError: boolean;
+  emittedEvent: boolean;
+  logger?: Logger;
+  request: AiSdkModelTextRequest;
+  requestHeaderCount: number;
+  requestHeaders: Record<string, string>;
+  resolved: ResolvedAiSdkModel;
+  statusContext: StreamStatusContext;
+  statusSink?: ModelStatusSink;
+  startedAt: number;
+  streamResult: AiSdkStreamTextResult;
+  streamMaxIdleMs: number;
+  streamOutputCommitted: boolean;
+  streamStallCount: number;
+  timeToFirstContentMs?: number;
+  timeToFirstProviderEventMs?: number;
+  timeToFirstTextMs?: number;
+}): Promise<boolean> {
+  logStreamDiagnostics({
+    attempt: input.attempt,
+    diagnostics: input.diagnostics,
+    durationMs: Date.now() - input.startedAt,
+    emittedError: input.emittedError,
+    emittedEvent: input.emittedEvent,
+    logger: input.logger,
+    outboundHeaders: input.resolved.headers,
+    statusContext: input.statusContext,
+  });
+  if (input.emittedError) return false;
+
+  const completedAt = Date.now();
+  const responseHeaders = await resolveStreamResponseHeaders(input.streamResult);
+  await publishModelStatus(
+    {
+      ...input.statusContext,
+      attempt: input.attempt,
+      durationMs: completedAt - input.startedAt,
+      requestHeaderCount: input.requestHeaderCount,
+      requestHeaders: input.requestHeaders,
+      responseHeaderCount: Object.keys(responseHeaders).length,
+      responseHeaders,
+      providerRequestId: providerRequestIdFromHeaders(responseHeaders),
+      finishReason: input.diagnostics.finishReason,
+      usage: input.diagnostics.usage,
+      timeToFirstProviderEventMs: input.timeToFirstProviderEventMs,
+      timeToFirstContentMs: input.timeToFirstContentMs,
+      timeToFirstTextMs: input.timeToFirstTextMs,
+      streamMaxIdleMs: input.streamMaxIdleMs || undefined,
+      streamStallCount: input.streamStallCount,
+      streamOutputCommitted: input.streamOutputCommitted,
+      timestamp: new Date(completedAt).toISOString(),
+      type: "model_request_completed",
+    },
+    statusPublishOptions(input, input.admission),
+  );
+  return true;
+}
