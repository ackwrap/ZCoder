+++ b/apps/zcode-cli/packages/bootstrap/tests/compaction-policy.test.ts
@@ -0,0 +1,283 @@
+import type { SessionStorePort } from "@zcode/contracts";
+import { zcodeWorkspaceUpdateCompactionPolicyResultSchema } from "@zcode/shared";
+import { describe, expect, it, vi } from "vitest";
+import type { ZCodeAppOptions } from "../src/app/types.js";
+import {
+  DEFAULT_COMPACTION_POLICY,
+  updateCompactionPolicy,
+} from "../src/zcode-protocol/model-io-preferences.js";
+import { ZCodeProtocolAgentServer } from "../src/zcode-protocol/server.js";
+import {
+  activateSessionForResume,
+  closeSession,
+  createSessionRecordForV4,
+} from "../src/zcode-protocol/server-operations.js";
+import type { ZCodeProtocolAgentServerContext } from "../src/zcode-protocol/server-types.js";
+import { createFakeApp } from "./helpers/fake-zcode-app.js";
+
+const workspace = { workspaceKey: "/workspace/app", workspacePath: "/workspace/app" };
+
+const compactPolicy = {
+  profile: "compact" as const,
+  tailBudgetTokens: 12_000,
+  summaryMaxOutputTokens: 4_000,
+};
+
+function makeContext(sessions: Map<string, unknown> = new Map()): ZCodeProtocolAgentServerContext {
+  return {
+    appRuntimePreferences: {
+      askUserQuestionAutoResolutionEnabled: true,
+      modelIoFullRetentionEnabled: false,
+      offPeakToolEnabled: false,
+      dynamicWorkflowEnabled: false,
+      compactionPolicies: new Map(),
+    },
+    sessions,
+  } as unknown as ZCodeProtocolAgentServerContext;
+}
+
+function fakeRecord(
+  workspaceKey: string,
+  overrides: Partial<ReturnType<typeof createFakeApp>> = {},
+) {
+  return {
+    app: createFakeApp(undefined, overrides),
+    workspace: { workspaceKey, workspacePath: workspaceKey },
+  };
+}
+
+describe("workspace/updateCompactionPolicy（Host → CLI 同步）", () => {
+  it("严格拒绝非法参数（分类/边界/非整数/缺省/未知键）", async () => {
+    const invalidParams: unknown[] = [
+      { workspace, ...compactPolicy, profile: "verbose" },
+      { workspace, ...compactPolicy, tailBudgetTokens: 999 },
+      { workspace, ...compactPolicy, tailBudgetTokens: 100_001 },
+      { workspace, ...compactPolicy, tailBudgetTokens: 12_000.5 },
+      { workspace, ...compactPolicy, summaryMaxOutputTokens: 999 },
+      { workspace, ...compactPolicy, summaryMaxOutputTokens: 20_001 },
+      { workspace, profile: "compact", tailBudgetTokens: 12_000 },
+      // strict：不接受 per-session 字段，也不接受旧 interaction preferences 扩展。
+      { workspace, ...compactPolicy, sessionId: "sess_1" },
+      { workspace, ...compactPolicy, preferences: { enabled: true } },
+    ];
+
+    for (const params of invalidParams) {
+      await expect(updateCompactionPolicy(makeContext(), params)).rejects.toThrow();
+    }
+  });
+
+  it("接受边界值并回显已接受策略与 updatedSessionCount", async () => {
+    const context = makeContext();
+    const result = zcodeWorkspaceUpdateCompactionPolicyResultSchema.parse(
+      await updateCompactionPolicy(context, {
+        workspace,
+        profile: "compact",
+        tailBudgetTokens: 1_000,
+        summaryMaxOutputTokens: 20_000,
+      }),
+    );
+
+    expect(result).toEqual({
+      workspace,
+      profile: "compact",
+      tailBudgetTokens: 1_000,
+      summaryMaxOutputTokens: 20_000,
+      updatedSessionCount: 0,
+    });
+    expect(context.appRuntimePreferences.compactionPolicies?.get(workspace.workspaceKey)).toEqual({
+      profile: "compact",
+      tailBudgetTokens: 1_000,
+      summaryMaxOutputTokens: 20_000,
+    });
+
+    await updateCompactionPolicy(context, {
+      workspace,
+      profile: "detailed",
+      tailBudgetTokens: 100_000,
+      summaryMaxOutputTokens: 1_000,
+    });
+    expect(context.appRuntimePreferences.compactionPolicies?.get(workspace.workspaceKey)).toEqual({
+      profile: "detailed",
+      tailBudgetTokens: 100_000,
+      summaryMaxOutputTokens: 1_000,
+    });
+  });
+
+  it("只更新 workspaceKey 匹配的活跃 session，并缓存给后续 create/resume", async () => {
+    const matching = vi.fn();
+    const otherWorkspace = vi.fn();
+    const sessions = new Map<string, unknown>([
+      ["sess_target", fakeRecord(workspace.workspaceKey, { setCompactionPolicy: matching })],
+      ["sess_other", fakeRecord("/workspace/other", { setCompactionPolicy: otherWorkspace })],
+      // 旧 app/测试替身没有 setter：跳过而不是崩溃。
+      ["sess_no_setter", fakeRecord(workspace.workspaceKey)],
+    ]);
+    const context = makeContext(sessions);
+
+    const result = await updateCompactionPolicy(context, { workspace, ...compactPolicy });
+
+    expect(result).toEqual({ workspace, ...compactPolicy, updatedSessionCount: 1 });
+    expect(context.appRuntimePreferences.compactionPolicies?.get(workspace.workspaceKey)).toEqual(
+      compactPolicy,
+    );
+    expect(matching).toHaveBeenCalledTimes(1);
+    expect(matching).toHaveBeenCalledWith(compactPolicy);
+    expect(otherWorkspace).not.toHaveBeenCalled();
+  });
+
+  it("server 初始化兼容默认 detailed/15000/8000", () => {
+    const server = new ZCodeProtocolAgentServer({
+      createZCodeApp: () => createFakeApp(),
+    });
+    const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+
+    expect(context.appRuntimePreferences.compactionPolicies?.size).toBe(0);
+    expect(DEFAULT_COMPACTION_POLICY).toEqual({
+      profile: "detailed",
+      tailBudgetTokens: 15_000,
+      summaryMaxOutputTokens: 8_000,
+    });
+  });
+});
+
+describe("session create/resume 读取压缩策略缓存", () => {
+  function captureAppOptions() {
+    let appOptions: ZCodeAppOptions | undefined;
+    const server = new ZCodeProtocolAgentServer({
+      createZCodeApp: (options) => {
+        appOptions = options;
+        return createFakeApp(options);
+      },
+    });
+    const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+    return {
+      context,
+      appOptions: () => appOptions,
+    };
+  }
+
+  it("新建 session 写入 runtimeConfig.compact，且不带 enabled/microcompact", async () => {
+    const { context, appOptions } = captureAppOptions();
+
+    const created = await createSessionRecordForV4(context, { workspace });
+    try {
+      expect(appOptions()?.runtimeConfig?.compact).toEqual(DEFAULT_COMPACTION_POLICY);
+    } finally {
+      await closeSession(context, { sessionId: created.sessionId });
+    }
+  });
+
+  it("同步后的策略用于新建 session", async () => {
+    const { context, appOptions } = captureAppOptions();
+    await updateCompactionPolicy(context, { workspace, ...compactPolicy });
+
+    const created = await createSessionRecordForV4(context, { workspace });
+    try {
+      expect(appOptions()?.runtimeConfig?.compact).toEqual(compactPolicy);
+      // 只下传三个字段，不能覆盖 core 的其他压缩策略。
+      expect(Object.keys(appOptions()?.runtimeConfig?.compact ?? {}).sort()).toEqual([
+        "profile",
+        "summaryMaxOutputTokens",
+        "tailBudgetTokens",
+      ]);
+    } finally {
+      await closeSession(context, { sessionId: created.sessionId });
+    }
+  });
+
+  it("冷恢复同样从缓存取策略", async () => {
+    let appOptions: ZCodeAppOptions | undefined;
+    const sessionStore = {
+      // 无 workspaceID 的本地会话：跳过远端路径修复，只走 resume materialize。
+      getSession: async () => ({
+        id: "sess_resume",
+        directory: workspace.workspacePath,
+        path: workspace.workspacePath,
+        time: { created: 1, updated: 2 },
+      }),
+      messages: async () => [],
+    } as unknown as SessionStorePort;
+    const server = new ZCodeProtocolAgentServer({
+      createZCodeApp: (options) => {
+        appOptions = options;
+        return createFakeApp(options);
+      },
+      sessionStore,
+    });
+    const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+    await updateCompactionPolicy(context, { workspace, ...compactPolicy });
+
+    await activateSessionForResume(context, { sessionId: "sess_resume" });
+    try {
+      expect(appOptions?.runtimeConfig?.compact).toEqual(compactPolicy);
+    } finally {
+      await closeSession(context, { sessionId: "sess_resume" });
+    }
+  });
+});
+
+function deferred(): { promise: Promise<void>; resolve: () => void } {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+describe("异步 createZCodeApp 窗口内到达的策略同步", () => {
+  /**
+   * app 初始化挂起时 record 还没登记，updateCompactionPolicy 的活跃遍历看不到它；
+   * createRecord 必须在发布前按最新缓存补一次。create / resume 共用同一路径。
+   */
+  async function latestPolicyWins(activation: "create" | "resume") {
+    const gate = deferred();
+    const appInitStarted = deferred();
+    const setCompactionPolicy = vi.fn();
+    let appOptions: ZCodeAppOptions | undefined;
+    const sessionStore = {
+      getSession: async () => ({
+        id: "sess_resume",
+        directory: workspace.workspacePath,
+        path: workspace.workspacePath,
+        time: { created: 1, updated: 2 },
+      }),
+      messages: async () => [],
+    } as unknown as SessionStorePort;
+    const server = new ZCodeProtocolAgentServer({
+      createZCodeApp: async (options) => {
+        appOptions = options;
+        appInitStarted.resolve();
+        await gate.promise;
+        return createFakeApp(options, { setCompactionPolicy });
+      },
+      ...(activation === "resume" ? { sessionStore } : {}),
+    });
+    const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+
+    const started =
+      activation === "resume"
+        ? activateSessionForResume(context, { sessionId: "sess_resume" })
+        : createSessionRecordForV4(context, { workspace });
+    // 此时 runtimeConfig.compact 已按旧缓存（默认）读取，app 仍在初始化。
+    await appInitStarted.promise;
+    await updateCompactionPolicy(context, { workspace, ...compactPolicy });
+    gate.resolve();
+    const result = await started;
+    const sessionId =
+      activation === "resume" ? "sess_resume" : (result as { sessionId: string }).sessionId;
+    try {
+      expect(appOptions?.runtimeConfig?.compact).toEqual(DEFAULT_COMPACTION_POLICY);
+      expect(setCompactionPolicy).toHaveBeenCalledTimes(1);
+      expect(setCompactionPolicy).toHaveBeenCalledWith(compactPolicy);
+    } finally {
+      await closeSession(context, { sessionId });
+    }
+  }
+
+  it.each(["create", "resume"] as const)(
+    "%s 路径在 app 初始化完成后采用最新缓存",
+    async (activation) => {
+      await latestPolicyWins(activation);
+    },
+  );
+});
