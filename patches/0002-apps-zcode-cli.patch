+          event.type === SessionEventType.ToolCallResult &&
+          event.payload?.toolCallId === "call_websearch",
+      ),
+    ).toBe(false);
+
+    const sideStatuses = stored.filter(
+      (event) =>
+        event.type === SessionEventType.ModelNetworkStatus &&
+        event.payload?.querySource === "web_search_tool",
+    ) as Array<{ payload: Record<string, any> }>;
+    expect(
+      sideStatuses.filter((event) => event.payload.type === "model_request_started"),
+    ).toHaveLength(1);
+    const failed = sideStatuses.filter((event) => event.payload.type === "model_request_failed");
+    expect(failed).toHaveLength(1);
+    expect(failed[0]?.payload.usage).toBeUndefined();
+    expect(
+      sideStatuses.filter((event) => event.payload.type === "model_request_completed"),
+    ).toHaveLength(0);
+    expect(
+      sideStatuses.filter((event) => event.payload.type === "model_retry_scheduled"),
+    ).toHaveLength(0);
+  });
+});
+
+function createCodexRuntime(respond: (body: Record<string, any>) => Response) {
+  const captures: CapturedRequest[] = [];
+  vi.stubGlobal("fetch", async (input: RequestInfo | URL, init?: RequestInit) => {
+    const request = new Request(input, init);
+    const bytes = Buffer.from(await request.clone().arrayBuffer());
+    const body = JSON.parse(zstdDecompressSync(bytes).toString("utf8")) as Record<string, any>;
+    captures.push({ body, headers: request.headers });
+    return respond(body);
+  });
+
+  const provider = createRegistryProviderConfig(
+    parseProviderConfig({
+      group: "standard-personal",
+      access: { type: "codex-oauth" },
+      api: { type: "openai-responses", baseUrl: "https://api.openai.com/v1" },
+    }),
+  );
+  const model = createRegistryModelConfig(
+    new ModelConfig({
+      enabled: true,
+      properties: new ModelPropertiesConfig({
+        contextWindow: 200_000,
+        requiresMfjsToolSchema: false,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: false,
+          supportsVideo: false,
+          supportsAudio: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: false,
+      }),
+      optionSpecs: new ModelOptionSpecsConfig({
+        reasoningLevel: { values: ["disabled"], map: "{}" },
+        maxOutputTokens: { max: 2048, map: "{}" },
+      }),
+    }),
+  );
+  if (!provider.ok || !model.ok) throw new Error("invalid Codex WebSearch fixture");
+
+  const executionConfig = createRuntimeAiSdkModelExecutionConfig(
+    { ZCODE_APP_VERSION: "3.16.2", ZCODE_ENV: "production" },
+    { sourceTitle: "cli" },
+  );
+  const bound = createModelAdapter({ executionConfig, env: {} }).createModel({
+    providerId: PROVIDER_ID,
+    modelId: MODEL_ID,
+    providerConfig: provider.config,
+    modelConfig: model.config,
+    options: { reasoningLevel: "disabled", maxOutputTokens: 2048 },
+  });
+
+  const sessionId = createSessionId("codex-websearch-runtime");
+  const eventStore = new InMemorySessionEventStore();
+  const runtime = createTestAgentRuntime(
+    sessionId,
+    { modelSelection: createTestModelSelection(`${PROVIDER_ID}/${MODEL_ID}`) },
+    {
+      eventStore,
+      modelFactory: (input) => bound.bind(input.selection.options ?? {}),
+      providerRuntimeHeadersPort: {
+        shouldRefreshBeforeModelRequest: ({ providerId }) => providerId === PROVIDER_ID,
+        async refreshBeforeModelRequest() {
+          return {
+            headersApplied: true,
+            requestAuth: {
+              apiKey: "fixture-token",
+              codexMode: "device",
+              headers: {
+                "chatgpt-account-id": "fixture-account",
+                "session-id": "fixture-session",
+                "thread-id": "fixture-session",
+                "x-client-request-id": "fixture-session",
+              },
+            },
+          };
+        },
+      },
+    },
+  );
+  return { captures, eventStore, runtime, sessionId };
+}
+
+function isSideRequest(body: Record<string, any>): boolean {
+  return body.tools?.some((tool: any) => tool.type === "web_search") === true;
+}
+
+function hasToolResult(body: Record<string, any>): boolean {
+  return Array.isArray(body.input)
+    ? body.input.some((item: any) => item?.type === "function_call_output")
+    : false;
+}
+
+function sse(events: unknown[]): Response {
+  return new Response(events.map((event) => `data: ${JSON.stringify(event)}\r\n\r\n`).join(""), {
+    headers: { "content-type": "text/event-stream" },
+  });
+}
+
+function firstMainFrames() {
+  const call = {
+    id: "fc_websearch",
+    type: "function_call",
+    call_id: "call_websearch",
+    name: "WebSearch",
+    arguments: '{"query":"latest zcode"}',
+    status: "completed",
+  };
+  return [
+    { type: "response.created", response: { id: "resp_main_1", model: MODEL_ID, created_at: 1 } },
+    { type: "response.output_item.added", output_index: 0, item: call },
+    { type: "response.output_item.done", output_index: 0, item: call },
+    {
+      type: "response.completed",
+      response: {
+        id: "resp_main_1",
+        model: MODEL_ID,
+        status: "completed",
+        output: [call],
+        usage: { input_tokens: 10, output_tokens: 4, total_tokens: 14 },
+      },
+    },
+  ];
+}
+
+function sideRequestFrames() {
+  const search = {
+    id: "ws_fixture",
+    type: "web_search_call",
+    status: "completed",
+    action: {
+      type: "search",
+      query: "latest zcode",
+      sources: [
+        { type: "url", url: "https://example.com/a", title: "A" },
+        { type: "url", url: "javascript:alert(1)", title: "unsafe" },
+      ],
+    },
+  };
+  const message = {
+    id: "msg_side",
+    type: "message",
+    role: "assistant",
+    status: "completed",
+    content: [
+      {
+        type: "output_text",
+        text: "Search summary from [A](https://example.com/a)",
+        annotations: [
+          { type: "url_citation", url: "https://example.com/a", title: "A" },
+          { type: "url_citation", url: "ftp://unsafe.example/file", title: "bad" },
+        ],
+      },
+    ],
+  };
+  return [
+    { type: "response.created", response: { id: "resp_side", model: MODEL_ID, created_at: 1 } },
+    { type: "response.output_item.added", output_index: 0, item: search },
+    { type: "response.output_item.done", output_index: 0, item: search },
+    { type: "response.output_item.added", output_index: 1, item: message },
+    { type: "response.output_item.done", output_index: 1, item: message },
+    {
+      type: "response.completed",
+      response: {
+        id: "resp_side",
+        model: MODEL_ID,
+        status: "completed",
+        output: [search, message],
+        usage: { input_tokens: 20, output_tokens: 8, total_tokens: 28 },
+      },
+    },
+  ];
+}
+
+function sideErrorFrames() {
+  const search = {
+    id: "ws_error",
+    type: "web_search_call",
+    status: "failed",
+    action: { type: "search", query: "latest zcode" },
+    error: { code: "server_error", message: "fixture hosted search failed" },
+  };
+  return [
+    {
+      type: "response.created",
+      response: { id: "resp_side_error", model: MODEL_ID, created_at: 1 },
+    },
+    { type: "response.output_item.added", output_index: 0, item: search },
+    { type: "response.output_item.done", output_index: 0, item: search },
+    {
+      type: "response.completed",
+      response: {
+        id: "resp_side_error",
+        model: MODEL_ID,
+        status: "completed",
+        output: [search],
+        usage: { input_tokens: 20, output_tokens: 1, total_tokens: 21 },
+      },
+    },
+  ];
+}
+
+function finalMainFrames(text: string) {
+  const message = {
+    id: "msg_final",
+    type: "message",
+    role: "assistant",
+    status: "completed",
+    content: [{ type: "output_text", text, annotations: [] }],
+  };
+  return [
+    { type: "response.created", response: { id: "resp_main_2", model: MODEL_ID, created_at: 1 } },
+    { type: "response.output_item.added", output_index: 0, item: message },
+    { type: "response.output_item.done", output_index: 0, item: message },
+    {
+      type: "response.completed",
+      response: {
+        id: "resp_main_2",
+        model: MODEL_ID,
+        status: "completed",
+        output: [message],
+        usage: { input_tokens: 40, output_tokens: 6, total_tokens: 46 },
+      },
+    },
+  ];
+}
