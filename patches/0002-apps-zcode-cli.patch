@@ -0,0 +1,100 @@
+import { describe, expect, it, vi } from "vitest";
+import type { MessageWithParts, SessionInfo, SessionStorePort } from "@zcode/contracts";
+import { readPersistedCompactSummary } from "../src/zcode-protocol-v4/compact-summary-read.js";
+
+const identity = {
+  sessionId: "s1",
+  operationId: "op1",
+  summaryRef: "summary1",
+  branchGeneration: 0,
+};
+function fixture() {
+  const message = {
+    info: {
+      id: "summary1",
+      sessionID: "s1",
+      role: "user",
+      summary: { body: "# Durable\n\nSaved summary", diffs: [] },
+      semantics: {
+        origin: "agent_runtime",
+        kind: "compact_summary",
+        uiVisibility: "hidden",
+        transcriptVisibility: "hidden",
+      },
+    },
+    parts: [
+      {
+        type: "compaction",
+        sessionID: "s1",
+        messageID: "summary1",
+        operationId: "op1",
+        compactBoundary: { summaryMessageIds: ["summary1"] },
+      },
+    ],
+  } as unknown as MessageWithParts;
+  const session = { id: "s1" } as SessionInfo;
+  const store = {
+    getSession: vi.fn().mockResolvedValue(session),
+    messageWithParts: vi.fn().mockResolvedValue(message),
+    messages: vi.fn(),
+  } as unknown as Pick<SessionStorePort, "getSession" | "messageWithParts" | "messages">;
+  return { message, session, store };
+}
+
+describe("durable compact summary scoped read", () => {
+  it("reads only the referenced message within the session, never a full transcript", async () => {
+    const { store } = fixture();
+    expect(await readPersistedCompactSummary(store, identity)).toEqual({
+      status: "available",
+      markdown: "# Durable\n\nSaved summary",
+    });
+    expect(store.messageWithParts).toHaveBeenCalledWith({ sessionID: "s1", messageID: "summary1" });
+    expect(store.messages).not.toHaveBeenCalled();
+  });
+
+  it.each(["session", "message", "operation", "boundary", "semantics", "body"])(
+    "rejects missing/mismatched %s",
+    async (field) => {
+      const { store, message, session } = fixture();
+      if (field === "session") session.id = "other" as SessionInfo["id"];
+      if (field === "message")
+        message.info.sessionID = "other" as MessageWithParts["info"]["sessionID"];
+      if (field === "operation" && message.parts[0]?.type === "compaction")
+        message.parts[0].operationId = "other";
+      if (field === "boundary" && message.parts[0]?.type === "compaction")
+        message.parts[0].compactBoundary = undefined;
+      if (field === "semantics") message.info.semantics = undefined;
+      if (field === "body" && message.info.role === "user") message.info.summary = undefined;
+      expect((await readPersistedCompactSummary(store, identity)).status).toBe("unavailable");
+    },
+  );
+
+  it("rejects old branches before reading and rechecks after I/O", async () => {
+    const { store, session } = fixture();
+    session.revert = { branchGeneration: 1 } as NonNullable<SessionInfo["revert"]>;
+    expect(await readPersistedCompactSummary(store, identity)).toEqual({
+      status: "unavailable",
+      reason: "staleIdentity",
+    });
+    expect(store.messageWithParts).not.toHaveBeenCalled();
+    session.revert = undefined;
+    vi.mocked(store.messageWithParts).mockImplementationOnce(async () => {
+      session.revert = { branchGeneration: 1 } as NonNullable<SessionInfo["revert"]>;
+      return fixture().message;
+    });
+    expect(await readPersistedCompactSummary(store, identity)).toEqual({
+      status: "unavailable",
+      reason: "staleIdentity",
+    });
+  });
+
+  it("does not return oversized summaries", async () => {
+    const { store, message } = fixture();
+    if (message.info.role === "user")
+      message.info.summary = { body: "x".repeat(140_000), diffs: [] };
+    expect(await readPersistedCompactSummary(store, identity)).toEqual({
+      status: "unavailable",
+      reason: "tooLarge",
+    });
+  });
+});
diff --git a/apps/zcode-cli/packages/bootstrap/tests/compaction-policy.test.ts b/apps/zcode-cli/packages/bootstrap/tests/compaction-policy.test.ts
