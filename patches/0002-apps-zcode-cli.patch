+  const policy = runtime.sessionResources.snapshot();
+  return {
+    policy,
+    skills: catalog.skills.map((skill) => {
+      const id = skill.qualifiedName ?? skill.name;
+      return {
+        id,
+        label: id,
+        available: true,
+        enabled: !policy.disabledSkills.includes(id),
+        source: resolveSkillSource(skill.source),
+      };
+    }),
+    mcpServers: [
+      ...new Set([...Object.keys(runtime.config.mcp?.servers ?? {}), ...Object.keys(statuses)]),
+    ]
+      .sort()
+      .map((id) => {
+        const available =
+          Boolean(runtime.mcpPort) &&
+          runtime.config.mcp?.enabled !== false &&
+          runtime.config.mcp?.servers?.[id]?.enabled !== false;
+        return {
+          id,
+          label: id,
+          available,
+          enabled: available && !policy.disabledMcpServers.includes(id),
+          source: resolveMcpServerSource(id),
+        };
+      }),
+  };
+}
+
+// 右侧连接器只展示用户自己接入的资源；ZCode 自带与插件提供的连接器不进入该列表。
+// 归类只影响展示过滤，策略所有权与开关语义仍由 SessionResourceController 裁决。
+function resolveSkillSource(source: SkillMetadata["source"]): "builtin" | "plugin" | "user" {
+  if (source === "bundled" || source === "zcode") return "builtin";
+  return source === "plugin" ? "plugin" : "user";
+}
+
+const BUILTIN_MCP_SERVER_NAMES = new Set(["node_repl"]);
+const PLUGIN_MCP_SERVER_PREFIX = "plugin:";
+
+function resolveMcpServerSource(id: string): "builtin" | "plugin" | "user" {
+  if (BUILTIN_MCP_SERVER_NAMES.has(id)) return "builtin";
+  return id.startsWith(PLUGIN_MCP_SERVER_PREFIX) ? "plugin" : "user";
+}
+
+export async function refreshSessionResources(
+  this: AgentRuntimeInternal,
+  traceContext = this.rootTraceContext,
+): Promise<void> {
+  await this.appendEvent(
+    this.createEvent(
+      SessionEventType.SessionResourcesUpdated,
+      await readSessionResources(this),
+      traceContext,
+    ),
+    traceContext,
+  );
+}
+
+export async function setSessionResource(
+  this: AgentRuntimeInternal,
+  input: { kind: "skill" | "mcp"; id: string; enabled: boolean },
+  traceContext = this.rootTraceContext,
+): Promise<void> {
+  const resources = await readSessionResources(this);
+  const items = input.kind === "skill" ? resources.skills : resources.mcpServers;
+  const item = items.find((candidate) => candidate.id === input.id);
+  if (!item || !item.available) throw new Error("Resource is unavailable in this session");
+  await this.sessionResources.set(input.kind, input.id, input.enabled);
+  const policy = this.sessionResources.snapshot();
+  const next = {
+    policy,
+    skills: resources.skills.map((entry) => ({
+      ...entry,
+      enabled: entry.available && !policy.disabledSkills.includes(entry.id),
+    })),
+    mcpServers: resources.mcpServers.map((entry) => ({
+      ...entry,
+      enabled: entry.available && !policy.disabledMcpServers.includes(entry.id),
+    })),
+  };
+  // 保存之后不再查询端口：瞬时状态读取失败不能把已接受策略伪装成保存失败。
+  await this.appendEvent(
+    this.createEvent(SessionEventType.SessionResourcesUpdated, next, traceContext),
+    traceContext,
+  );
+}
+
+export async function assertSessionResourceEnabled(
+  this: AgentRuntimeInternal,
+  kind: "skill" | "mcp",
+  id: string,
+): Promise<void> {
+  await this.sessionResources.assertEnabled(kind, id);
+}
