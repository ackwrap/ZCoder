+import type { McpPort, SkillPort } from "@zcode/contracts";
+import type { SessionResourcePolicy } from "@zcode/shared/zcode-protocol-v4";
+
+export type SessionResourceKind = "skill" | "mcp";
+export interface SessionResourcePersistence {
+  load(): Promise<unknown>;
+  save(policy: SessionResourcePolicy): Promise<void>;
+}
+export interface SessionResourceControl {
+  restore(): Promise<void>;
+  snapshot(): SessionResourcePolicy;
+  set(kind: SessionResourceKind, id: string, enabled: boolean): Promise<void>;
+  assertEnabled(kind: SessionResourceKind, id: string): Promise<void>;
+  guardSkillPort(port: SkillPort): SkillPort;
+  guardMcpPort(port: McpPort): McpPort;
+}
