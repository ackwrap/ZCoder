+async function readSessionResources(runtime: AgentRuntimeInternal): Promise<SessionResourcesState> {
+  await runtime.sessionResources.restore();
+  const catalog = await runtime.getSkillCatalog(runtime.rootTraceContext);
+  const statuses = (await runtime.mcpPort?.status()) ?? {};
+  const policy = runtime.sessionResources.snapshot();
+  return {
+    policy,
+    skills: catalog.skills.map((skill) => {
+      const id = skill.qualifiedName ?? skill.name;
+      return {
+        id,
+        label: id,
+        available: true,
+        enabled: !policy.disabledSkills.includes(id),
+        source: resolveSkillSource(skill.source),
+      };
+    }),
+    mcpServers: [
+      ...new Set([...Object.keys(runtime.config.mcp?.servers ?? {}), ...Object.keys(statuses)]),
+    ]
+      .sort()
+      .map((id) => {
+        const available =
+          Boolean(runtime.mcpPort) &&
+          runtime.config.mcp?.enabled !== false &&
+          runtime.config.mcp?.servers?.[id]?.enabled !== false;
+        return {
+          id,
+          label: id,
+          available,
+          enabled: available && !policy.disabledMcpServers.includes(id),
+          source: resolveMcpServerSource(id),
+        };
+      }),
+  };
