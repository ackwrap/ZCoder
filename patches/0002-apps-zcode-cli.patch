+export async function persistTaskOutputCopySource(
+  toolName: string,
+  output: unknown,
+  context: ToolExecutionContext,
+  trace: TraceContext,
+): Promise<{ path: string; bytes: number } | undefined> {
+  if (toolName !== TASK_OUTPUT_TOOL_NAME || !context.artifactStore) return undefined;
+  const parsed = TaskOutputResultSchema.safeParse(output);
+  const task = parsed.success ? parsed.data.task : null;
+  if (!task?.output.trim()) return undefined;
+  if (task.task_type === "local_agent") {
+    const result = context.runtimeTaskRegistry?.get(task.task_id)?.output;
+    if (
+      result?.status !== "completed" ||
+      result.content.map((block) => block.text).join("\n") !== task.output
+    )
+      return undefined;
+  }
+  const bytes = Buffer.byteLength(task.output, "utf8");
+  if (bytes > 8 * 1024 * 1024) return undefined;
+  try {
+    const artifact = await context.artifactStore.writeToolResultArtifact(
+      {
+        sessionId: context.sessionId,
+        turnId: context.turnId,
+        toolCallId: context.toolCallId,
+        toolName,
+        content: task.output,
+        contentType: "text/plain",
+        retention: "session",
+        trace,
+      },
+      { signal: context.abortSignal },
+    );
+    return artifact.path && artifact.path.length <= 4_096 && artifact.bytes === bytes
+      ? { path: artifact.path, bytes }
+      : undefined;
+  } catch {
