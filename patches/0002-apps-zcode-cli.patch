+it("closes bound watchers on initialization failure and permits a fresh acquisition", async () => {
+  const close = vi.fn();
+  vi.mocked(watch).mockImplementation(() => {
+    const watcher = new EventEmitter() as FSWatcher;
+    watcher.close = close;
+    return watcher;
+  });
+  const resolveInstructions = vi
