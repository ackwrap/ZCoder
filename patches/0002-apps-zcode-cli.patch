+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: false,
+      }),
+      optionSpecs: new ModelOptionSpecsConfig({
+        reasoningLevel: { values: ["disabled"], map: "{}" },
+        maxOutputTokens: { max: 2048, map: "{}" },
+      }),
+    }),
+  );
+  if (!provider.ok || !model.ok) throw new Error("invalid Codex WebSearch fixture");
+
+  const executionConfig = createRuntimeAiSdkModelExecutionConfig(
+    { ZCODE_APP_VERSION: "3.16.2", ZCODE_ENV: "production" },
+    { sourceTitle: "cli" },
+  );
