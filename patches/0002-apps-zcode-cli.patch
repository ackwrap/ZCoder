+import { describe, expect, it, vi } from "vitest";
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { ConversationV4Gateway } from "../src/zcode-protocol-v4/v4-gateway.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { synthesizeEventsFromMessages } from "../src/zcode-protocol-v4/transcript-hydration.js";
+import type { MessageWithParts } from "@zcode/contracts";
+
+function event(type: SessionEvent["type"], payload: unknown, sequenceNumber = 1): SessionEvent {
+  return {
+    id: `e${sequenceNumber}`,
+    sessionId: "s1",
+    type,
+    payload,
+    sequenceNumber,
+    timestamp: new Date(),
+    traceId: "trace1",
+  } as SessionEvent;
+}
+const completed = {
+  operationId: "op1",
+  status: "completed",
+  trigger: "manual",
+  summaryMessageId: "summary1",
+  preCompactTokenCount: 10000,
+  postCompactTokenCount: 999,
+  truePostCompactTokenCount: 2000,
+};
+function setup(status = "completed") {
+  const read = vi.fn().mockResolvedValue({ status: "available", markdown: "# Saved" });
+  const gateway = new ConversationV4Gateway({
+    sessionExists: () => true,
+    emitWireFrame: () => {},
+    executeCommand: async () => undefined,
+    readCompactSummary: read,
+  });
+  gateway.ingest("s1", event(SessionEventType.CompactCompleted, { ...completed, status }));
+  return { gateway, read };
+}
+async function identity(gateway: ConversationV4Gateway) {
+  const page = await gateway.rowsRange({
+    sessionId: "s1",
+    limit: 20,
+    clientMode: "desktop-continuous",
+  });
+  const row = page.rows.find((item) => item.kind === "timelineMarker");
+  if (!row) throw new Error("missing marker");
+  return {
+    sessionId: "s1",
+    baseLogEpoch: page.atLogEpoch,
+    branchGeneration: 0,
+    rowId: row.rowId,
+    operationId: "op1",
+    summaryRef: "summary1",
+  };
+}
+
+describe("V4 compact summary authorization", () => {
+  it("authorizes only the exact successful active marker", async () => {
+    const { gateway, read } = setup();
+    try {
+      const request = await identity(gateway);
+      expect(await gateway.compactSummary(request)).toEqual({
+        status: "available",
+        markdown: "# Saved",
+      });
+      expect(read).toHaveBeenCalledTimes(1);
+      for (const invalid of [
+        { operationId: "other" },
+        { summaryRef: "other" },
+        { rowId: 999 },
+        { baseLogEpoch: "old" },
+        { branchGeneration: 1 },
+      ]) {
+        expect((await gateway.compactSummary({ ...request, ...invalid })).status).toBe(
+          "unavailable",
+        );
+      }
+      expect(read).toHaveBeenCalledTimes(1);
+    } finally {
+      gateway.dispose();
+    }
+  });
+
+  it.each(["started", "failed", "skipped", "interrupted"])(
+    "does not read bodies for %s markers",
+    async (status) => {
+      const { gateway, read } = setup(status);
+      try {
+        expect((await gateway.compactSummary(await identity(gateway))).status).toBe("unavailable");
+        expect(read).not.toHaveBeenCalled();
+      } finally {
+        gateway.dispose();
+      }
+    },
+  );
