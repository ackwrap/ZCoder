@@ -0,0 +1,105 @@
+import type { ToolSet } from "ai";
+import { ModelErrorCode } from "@zcode/contracts";
+import { AiSdkModelAdapterError } from "../errors.js";
+
+/**
+ * Codex 官方 wire 只核实在线搜索 `external_web_access: true` 与
+ * `filters.allowed_domains`。blocked_domains/maxUses 没有可信 wire 证据，Codex 会拒绝
+ * 不支持参数，因此这里显式失败而不是静默丢弃或本地后置过滤。
+ */
+export function toCodexNativeWebSearchTool(args: Record<string, unknown>): ToolSet[string] {
+  if (args.blockedDomains !== undefined) {
+    throw new AiSdkModelAdapterError(
+      ModelErrorCode.InvalidModelRequest,
+      "Codex native WebSearch does not support blocked_domains",
+    );
+  }
+  if (args.maxUses !== undefined) {
+    throw new AiSdkModelAdapterError(
+      ModelErrorCode.InvalidModelRequest,
+      "Codex native WebSearch does not support maxUses",
+    );
+  }
+
+  const allowedDomains = validateAllowedDomains(args.allowedDomains);
+  return {
+    type: "provider",
+    id: "openai.web_search",
+    name: "web_search",
+    args: {
+      external_web_access: true,
+      ...(allowedDomains ? { filters: { allowed_domains: allowedDomains } } : {}),
+    },
+    inputSchema: { type: "object", properties: {} },
+  } as unknown as ToolSet[string];
+}
+
+/** Codex 只接受官方核实的 live web_search 形状；其他 provider tool/参数显式失败。 */
+export function codexProviderTool(tool: {
+  readonly id: string;
+  readonly name: string;
+  readonly args: Record<string, unknown>;
+}) {
+  if (tool.id !== "openai.web_search" || tool.name !== "web_search") {
+    throw new Error(`codex-unsupported-provider-tool: ${tool.id}`);
+  }
+
+  const args = tool.args;
+  if (args.external_web_access !== true) {
+    throw new Error("codex-unsupported-web-search: external_web_access");
+  }
+  const unsupported = Object.keys(args).filter(
+    (key) => key !== "external_web_access" && key !== "filters",
+  );
+  if (unsupported.length > 0) {
+    throw new Error(`codex-unsupported-web-search: ${unsupported.join(",")}`);
+  }
+
+  const filters = asRecord(args.filters);
+  if (args.filters !== undefined && !filters) {
+    throw new Error("codex-unsupported-web-search: filters");
+  }
+  if (filters !== undefined) {
+    const unsupportedFilter = Object.keys(filters).filter((key) => key !== "allowed_domains");
+    if (unsupportedFilter.length > 0) {
+      throw new Error(`codex-unsupported-web-search-filter: ${unsupportedFilter.join(",")}`);
+    }
+  }
+  const allowedDomains = validateAllowedDomains(filters?.allowed_domains);
+
+  return {
+    name: tool.name,
+    description: "Provider-native web search used internally by the WebSearch tool",
+    inputSchema: { type: "object", properties: {} },
+    native: {
+      openai: {
+        type: "web_search",
+        external_web_access: true,
+        ...(allowedDomains && allowedDomains.length > 0
+          ? { filters: { allowed_domains: allowedDomains } }
+          : {}),
+      },
+    },
+  };
+}
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+function validateAllowedDomains(value: unknown): string[] | undefined {
+  if (value === undefined) return undefined;
+  if (
+    !Array.isArray(value) ||
+    value.length === 0 ||
+    value.some((domain) => typeof domain !== "string" || domain.trim().length === 0)
+  ) {
+    throw new AiSdkModelAdapterError(
+      ModelErrorCode.InvalidModelRequest,
+      "codex-unsupported-web-search: allowed_domains",
+    );
+  }
+  return [...value] as string[];
+}
