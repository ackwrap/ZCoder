+        "session-id": "fixture-session",
+        "thread-id": "fixture-session",
+        "x-client-request-id": "fixture-session",
+        "User-Agent": UA,
+      },
+    },
+  });
+  return { transport, routing, resolved, bind };
+}
+async function sent(f: ReturnType<typeof fixture>) {
+  const [url, init] = f.transport.mock.calls[0]!;
