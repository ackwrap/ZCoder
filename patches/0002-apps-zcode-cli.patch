+  for (const match of content.matchAll(globalRegex)) {
+    const index = match.index ?? 0;
+    const lineNumber = lineNumberForIndex(content, index);
+    const text = firstLine(match[0]);
+    entries.push({
+      path,
+      lineNumber,
+      text,
+      matched: true,
+    });
+    matchCount += 1;
+  }
