+import type { CompactionRuntimePolicy } from "@zcode/core";
+import { zcodeWorkspaceUpdateCompactionPolicyParamsSchema } from "@zcode/shared";
+import {
+  parseParams,
+  type CompactionPolicyPreference,
+  type ZCodeProtocolAgentServerContext,
+} from "../server-types.js";
+
+export const DEFAULT_COMPACTION_POLICY: CompactionPolicyPreference = {
+  profile: "detailed",
+  tailBudgetTokens: 15_000,
+  summaryMaxOutputTokens: 8_000,
+};
+export type CompactionPolicyRuntimeConfig = CompactionRuntimePolicy;
+
+export function resolveCompactionPolicyRuntimeConfig(
+  preference: CompactionPolicyPreference = DEFAULT_COMPACTION_POLICY,
+): CompactionPolicyRuntimeConfig {
+  return {
+    profile: preference.profile,
+    tailBudgetTokens: preference.tailBudgetTokens,
+    summaryMaxOutputTokens: preference.summaryMaxOutputTokens,
+  };
+}
+
+/** The server context owns the only cache; callers receive a fresh three-field value. */
+export function readWorkspaceCompactionPolicy(
+  context: ZCodeProtocolAgentServerContext,
+  workspaceKey: string,
+): CompactionPolicyRuntimeConfig {
+  return resolveCompactionPolicyRuntimeConfig(
+    context.appRuntimePreferences.compactionPolicies?.get(workspaceKey),
+  );
+}
+
+export async function updateCompactionPolicy(
+  context: ZCodeProtocolAgentServerContext,
+  rawParams: unknown,
+) {
+  const params = parseParams(zcodeWorkspaceUpdateCompactionPolicyParamsSchema, rawParams);
+  const policy: CompactionPolicyPreference = {
+    profile: params.profile,
+    tailBudgetTokens: params.tailBudgetTokens,
+    summaryMaxOutputTokens: params.summaryMaxOutputTokens,
+  };
+  const policies = (context.appRuntimePreferences.compactionPolicies ??= new Map());
+  policies.set(params.workspace.workspaceKey, policy);
+  let updatedSessionCount = 0;
+  for (const record of context.sessions.values()) {
+    if (record.workspace.workspaceKey !== params.workspace.workspaceKey) continue;
+    if (typeof record.app.setCompactionPolicy !== "function") continue;
+    record.app.setCompactionPolicy(resolveCompactionPolicyRuntimeConfig(policy));
+    updatedSessionCount += 1;
+  }
+  return { workspace: params.workspace, ...policy, updatedSessionCount };
+}
