+import { describe, expect, it, vi } from "vitest";
+import {
+  SESSION_ENTRY_TURN_MODEL_TIMING,
+  SessionEventType,
+  type MessageId,
+  type SessionEvent,
+  type TurnModelTimingEntryData,
+} from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../src/runtime/internal.js";
+import {
+  persistTurnModelTiming,
+  resolveTurnModelTiming,
+} from "../src/runtime/methods/turn-model-step-usage.js";
+
+const USER_MESSAGE_ID = "msg-user-timing" as MessageId;
+const STARTED_AT = 1_700_000_000_000;
+
+function event(type: SessionEvent["type"], payload: unknown, timestampMs: number): SessionEvent {
+  return {
+    id: `event-${type}-${timestampMs}` as SessionEvent["id"],
+    sessionId: "session-timing" as SessionEvent["sessionId"],
+    turnId: "turn-timing" as SessionEvent["turnId"],
+    type,
+    timestamp: new Date(timestampMs),
+    traceId: "trace-timing" as SessionEvent["traceId"],
+    sequenceNumber: 1,
+    payload,
+  } as SessionEvent;
+}
+
+function networkStatus(payload: Record<string, unknown>, timestampMs: number): SessionEvent {
+  return event(SessionEventType.ModelNetworkStatus, payload, timestampMs);
+}
+
+function modelComplete(outputTokens: number, timestampMs: number): SessionEvent {
+  return event(
+    SessionEventType.ModelComplete,
+    {
+      content: "done",
+      stopReason: "end_turn",
+      querySource: "main_turn",
+      usage: { inputTokens: 10, outputTokens },
+    },
+    timestampMs,
+  );
+}
+
+/**
+ * 失败 attempt 1s → 退避 10s → 成功 attempt 1s、输出 1200 tokens。
+ * 分母是 2s（600 tok/s）；逻辑请求全程 12s 绝不能当分母。
+ */
+function retryScenario(offset = 0): SessionEvent[] {
+  return [
+    networkStatus(
+      {
+        type: "model_request_failed",
+        requestId: "request-1",
+        providerId: "p",
+        modelId: "m",
+        transport: "sse",
+        attempt: 1,
+        maxAttempts: 3,
+        durationMs: 1_000,
+        reason: "network",
+        retryable: true,
+        message: "network error",
+      },
+      STARTED_AT + offset + 1_000,
+    ),
+    networkStatus(
+      {
+        type: "model_retry_scheduled",
+        requestId: "request-2",
+        providerId: "p",
+        modelId: "m",
+        transport: "sse",
+        attempt: 2,
+        maxAttempts: 3,
+        retryAfterMs: 10_000,
+      },
+      STARTED_AT + offset + 2_000,
+    ),
+    networkStatus(
+      {
+        type: "model_request_completed",
+        requestId: "request-2",
+        providerId: "p",
+        modelId: "m",
+        transport: "sse",
+        attempt: 2,
+        maxAttempts: 3,
+        durationMs: 1_000,
+      },
+      STARTED_AT + offset + 12_000,
+    ),
+    modelComplete(1_200, STARTED_AT + offset + 12_001),
+  ];
+}
+
+function runtimeWithStore(saveSessionEntry: ReturnType<typeof vi.fn>, events: SessionEvent[] = []) {
+  const recordModelUsage = vi.fn(async () => undefined);
+  const runtime = {
+    sessionId: "session-timing",
+    config: { taskType: "interactive" },
+    logger: { warn: vi.fn() },
+    eventStore: { getEvents: vi.fn(async () => events) },
+    sessionStore: {
+      saveSessionEntry,
+      recordModelUsage,
+      upsertTurnUsage: vi.fn(async () => undefined),
+      upsertToolUsage: vi.fn(async () => undefined),
+      pruneUsage: vi.fn(async () => undefined),
+    },
+  } as unknown as AgentRuntimeInternal;
+  return { runtime, recordModelUsage };
+}
+
+describe("轮末速率事实（终态一次写入）", () => {
+  it("只累计 attempt 耗时，重试退避与本地后处理不进入分母", () => {
+    expect(resolveTurnModelTiming(retryScenario(), STARTED_AT)).toEqual({
+      outputTokens: 1_200,
+      modelDurationMs: 2_000,
+      attemptCount: 2,
+      highspeedAttemptCount: 0,
+    });
+  });
+
+  it("高速轮回退普通 provider 时，分母只取加速子集，与 live 一致", () => {
+    const events = [
+      networkStatus(
+        {
+          type: "model_request_completed",
+          requestId: "req-hs",
+          providerId: "account:bigmodel-highspeed-card",
+          modelId: "glm-5.3",
+          transport: "sse",
+          attempt: 1,
+          maxAttempts: 1,
+          durationMs: 400,
+        },
+        STARTED_AT + 400,
+      ),
+      // 卡过期后回退普通 provider：live 的轮末分母不含这 10s。
+      networkStatus(
+        {
+          type: "model_request_completed",
+          requestId: "req-fallback",
+          providerId: "account:bigmodel-individual-coding-plan",
+          modelId: "glm-5.3",
+          transport: "sse",
+          attempt: 1,
+          maxAttempts: 1,
+          durationMs: 10_000,
+        },
+        STARTED_AT + 10_400,
+      ),
+      modelComplete(300, STARTED_AT + 10_401),
+    ];
+    expect(resolveTurnModelTiming(events, STARTED_AT)).toEqual({
+      outputTokens: 300,
+      modelDurationMs: 400,
+      attemptCount: 2,
+      highspeedAttemptCount: 1,
+    });
+  });
+
+  it("分子或分母缺失时整轮不写，避免重启后显示错误速率", async () => {
+    const saveSessionEntry = vi.fn(async () => undefined);
+    const events = retryScenario().filter(
+      (sessionEvent) => sessionEvent.type !== SessionEventType.ModelComplete,
+    );
+    const { runtime } = runtimeWithStore(saveSessionEntry, events);
+
+    await persistTurnModelTiming(runtime, {
+      userMessageId: USER_MESSAGE_ID,
+      startedAt: STARTED_AT,
+    });
+
+    expect(saveSessionEntry).not.toHaveBeenCalled();
+  });
+
