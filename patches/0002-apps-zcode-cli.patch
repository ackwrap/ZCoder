+import { createInstructionObservationRegistry } from "./module.js";
+import type { InstructionObservationDependencies } from "./contract.js";
+
+export async function readInstructionSnapshot(
+  dependencies: InstructionObservationDependencies,
+  workingDirectory: string,
+) {
+  const registry = createInstructionObservationRegistry(dependencies);
+  const lease = await registry.observe({ workingDirectory }, {});
+  try {
+    return await lease.readSnapshot();
+  } finally {
+    lease.dispose();
+  }
+}
