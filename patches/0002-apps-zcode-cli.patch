@@ -0,0 +1,23 @@
+import type { LanguageModel } from "ai";
+
+export type CodexRuntimeModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+export type CodexCallOptions = Parameters<CodexRuntimeModel["doStream"]>[0];
+export type CodexGenerateResult = Awaited<ReturnType<CodexRuntimeModel["doGenerate"]>>;
+export type CodexStreamPart =
+  Awaited<ReturnType<CodexRuntimeModel["doStream"]>>["stream"] extends ReadableStream<infer Part>
+    ? Part
+    : never;
+
+export interface CodexModelOptions {
+  readonly modelId: string;
+  readonly apiKey?: string;
+  readonly headers?: Readonly<Record<string, string>>;
+  readonly fetch: typeof globalThis.fetch;
+  readonly optionBody?: Readonly<Record<string, unknown>>;
+  readonly captureBody?: (body: Record<string, unknown>) => void;
+}
+
+export const CODEX_BASE_URL = "https://chatgpt.com/backend-api/codex";
+export const CODEX_RESPONSES_URL = `${CODEX_BASE_URL}/responses`;
+// 从本机 opencode v2.1.4 的可执行文件 --user-agent 参数核实，不能使用 unknown 占位值。
+export const CODEX_USER_AGENT = "opencode/latest/2.1.4/cli";
diff --git a/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts b/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77ade0985b410f92132836c16773b19524424645
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts
@@ -0,0 +1,220 @@
+import type {
+  LLMEvent,
+  LLMResponse,
+  Usage,
+  ProviderMetadata,
+  FinishReasonDetails,
+  ToolResultValue,
+} from "@opencode/ai";
+import type { CodexGenerateResult, CodexStreamPart } from "./contract.js";
+
+// 原 parser 的 metadata 来源是经 schema 解码的 wire JSON，转换结构类型时保持原键不变。
+function metadata(value: ProviderMetadata | undefined): CodexGenerateResult["providerMetadata"] {
+  return value as CodexGenerateResult["providerMetadata"];
+}
+function finishReason(reason: FinishReasonDetails): CodexGenerateResult["finishReason"] {
+  const normalized = reason.normalized;
+  return {
+    unified: normalized === "unknown" ? "other" : normalized,
+    raw: reason.raw ?? normalized,
+  };
+}
+function usage(value: Usage | undefined): CodexGenerateResult["usage"] {
+  return {
+    inputTokens: {
+      total: value?.inputTokens,
+      noCache: value?.nonCachedInputTokens,
+      cacheRead: value?.cacheReadInputTokens,
+      cacheWrite: value?.cacheWriteInputTokens,
+    },
+    outputTokens: {
+      total: value?.outputTokens,
+      reasoning: value?.reasoningTokens,
+      text: value?.outputTokens === undefined ? undefined : value.visibleOutputTokens,
+    },
+    raw: value?.providerMetadata?.openai as CodexGenerateResult["usage"]["raw"],
+  };
+}
+
+function toolResultValue(value: ToolResultValue): unknown {
+  switch (value.type) {
+    case "json":
+    case "text":
+    case "error":
+      return value.value;
+    case "content":
+      return value.value.map((part) =>
+        part.type === "text"
+          ? { type: "text" as const, text: part.text }
+          : filePart(part.uri, part.mime),
+      );
+  }
+}
+
+function filePart(uri: string, mime: string) {
+  if (!uri.startsWith("data:")) {
+    return { type: "file-url" as const, url: uri };
+  }
+  const comma = uri.indexOf(",");
+  const metadata = uri.slice(5, comma);
+  return {
+    type: "file-data" as const,
+    data: uri.slice(comma + 1),
+    mediaType: metadata.replace(/;base64$/u, "") || mime,
+  };
+}
+
+export function codexResult(response: LLMResponse): CodexGenerateResult {
+  const terminal = response.events.findLast((event) => event.type === "finish");
+  const responseId = terminal?.providerMetadata?.openai?.responseId;
+  return {
+    warnings: [],
+    usage: usage(response.usage),
+    finishReason: finishReason(response.finishReason),
+    providerMetadata: metadata(terminal?.providerMetadata),
+    response: typeof responseId === "string" ? { id: responseId } : undefined,
+    content: response.message.content.map((part): CodexGenerateResult["content"][number] => {
+      switch (part.type) {
+        case "text":
+        case "reasoning":
+          return {
+            type: part.type,
+            text: part.text,
+            providerMetadata: metadata(part.providerMetadata),
+          };
+        case "tool-call":
+          return {
+            type: "tool-call",
+            toolCallId: part.id,
+            toolName: part.name,
+            input: JSON.stringify(part.input),
+            providerExecuted: part.providerExecuted,
+            providerMetadata: metadata(part.providerMetadata),
+          };
+        case "tool-result":
+          return {
+            type: "tool-result",
+            toolCallId: part.id,
+            toolName: part.name,
+            result: toolResultValue(part.result) as never,
+            ...(part.result.type === "error" ? { isError: true } : {}),
+            providerMetadata: metadata(part.providerMetadata),
+          };
+        default:
+          throw new Error(`codex-unsupported-generated-content: ${part.type}`);
+      }
+    }),
+  };
+}
+
+/** 这里只改变事件字段名，不解析 SSE/原生 JSON；分片合并与工具校验由 opencode 持有。 */
+export async function* codexEvents(
+  events: AsyncIterable<LLMEvent>,
+): AsyncGenerator<CodexStreamPart> {
+  const text = new Map<string, string>();
+  let finished = false;
+  yield { type: "stream-start", warnings: [] };
+  for await (const event of events) {
+    switch (event.type) {
+      case "text-start":
+      case "reasoning-start":
+        text.set(event.id, "");
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "text-delta":
+      case "reasoning-delta":
+        text.set(event.id, (text.get(event.id) ?? "") + event.text);
+        yield {
+          type: event.type,
+          id: event.id,
+          delta: event.text,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "text-end":
+      case "reasoning-end": {
+        const previous = text.get(event.id) ?? "";
+        if (event.text !== undefined && event.text !== previous) {
+          if (!event.text.startsWith(previous))
+            throw new Error("codex-authoritative-text-mismatch");
+          yield {
+            type: event.type === "text-end" ? "text-delta" : "reasoning-delta",
+            id: event.id,
+            delta: event.text.slice(previous.length),
+          };
+        }
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        text.delete(event.id);
+        break;
+      }
+      case "tool-input-start":
+        yield {
+          type: event.type,
+          id: event.id,
+          toolName: event.name,
+          providerExecuted: event.providerExecuted,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-input-delta":
+        yield { type: event.type, id: event.id, delta: event.text };
+        break;
+      case "tool-input-end":
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-call":
+        yield {
+          type: event.type,
+          toolCallId: event.id,
+          toolName: event.name,
+          input: JSON.stringify(event.input),
+          providerExecuted: event.providerExecuted,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-result":
+        yield {
+          type: event.type,
+          toolCallId: event.id,
+          toolName: event.name,
+          result: toolResultValue(event.result) as never,
+          ...(event.result.type === "error" ? { isError: true } : {}),
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-input-error":
+        throw new Error(`codex-invalid-tool-input: ${event.name}`);
+      case "provider-error":
+        throw new Error(event.message, { cause: event.classification });
+      case "finish":
+        finished = true;
+        if (typeof event.providerMetadata?.openai?.responseId === "string")
+          yield { type: "response-metadata", id: event.providerMetadata.openai.responseId };
+        yield {
+          type: "finish",
+          finishReason: finishReason(event.reason),
+          usage: usage(event.usage),
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "step-start":
+      case "step-finish":
+        break;
+      default:
+        throw new Error(`codex-unsupported-generated-event: ${event.type}`);
+    }
+  }
+  if (!finished) throw new Error("codex-response-incomplete");
+}
