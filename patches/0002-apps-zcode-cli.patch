+import type { ZCodeProtocolAgentServerContext } from "../../src/zcode-protocol/server-types.js";
+import type { ZCodeAppOptions } from "../../src/app/types.js";
+import { createFakeApp } from "../helpers/fake-zcode-app.js";
+
+const a = { workspaceKey: "/workspace/a", workspacePath: "/workspace/a" };
+const b = { workspaceKey: "/workspace/b", workspacePath: "/workspace/b" };
+const policyA = {
+  profile: "compact" as const,
+  tailBudgetTokens: 12_000,
+  summaryMaxOutputTokens: 4_000,
+};
+const policyB = {
+  profile: "compact" as const,
+  tailBudgetTokens: 20_000,
+  summaryMaxOutputTokens: 6_000,
+};
+const defaults = { profile: "detailed", tailBudgetTokens: 15_000, summaryMaxOutputTokens: 8_000 };
+
+function deferred() {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+describe("workspace compaction policy isolation", () => {
+  it.each(["create", "resume"] as const)(
+    "does not leak A preferences into B %s",
+    async (activation) => {
+      const captured: ZCodeAppOptions[] = [];
+      const server = new ZCodeProtocolAgentServer({
+        createZCodeApp: (options) => {
+          captured.push(options);
+          return createFakeApp(options);
+        },
+        sessionStore: {
+          getSession: async () =>
+            activation === "resume"
+              ? {
+                  id: "sess_b",
+                  directory: b.workspacePath,
+                  path: b.workspacePath,
+                  time: { created: 1, updated: 2 },
+                }
+              : null,
+          messages: async () => [],
+        } as unknown as SessionStorePort,
+      });
+      const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+      await updateCompactionPolicy(context, { workspace: a, ...policyA });
+      const result =
+        activation === "create"
+          ? await createSessionRecordForV4(context, { workspace: b })
+          : await activateSessionForResume(context, { sessionId: "sess_b" });
+      const id = activation === "create" ? (result as { sessionId: string }).sessionId : "sess_b";
+      try {
+        expect(captured.at(-1)?.runtimeConfig?.compact).toEqual(defaults);
+      } finally {
+        await closeSession(context, { sessionId: id });
+      }
+    },
+  );
+
+  it("retains independent A and B values after interleaved updates", async () => {
+    const captured: ZCodeAppOptions[] = [];
+    const server = new ZCodeProtocolAgentServer({
+      createZCodeApp: (options) => {
+        captured.push(options);
+        return createFakeApp(options);
+      },
+    });
+    const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+    await updateCompactionPolicy(context, { workspace: a, ...policyA });
+    await updateCompactionPolicy(context, { workspace: b, ...policyB });
+    for (const [workspace, expected] of [
+      [a, policyA],
+      [b, policyB],
+    ] as const) {
+      const result = await createSessionRecordForV4(context, { workspace });
+      try {
+        expect(captured.at(-1)?.runtimeConfig?.compact).toEqual(expected);
+      } finally {
+        await closeSession(context, { sessionId: result.sessionId });
+      }
+    }
+  });
+
+  it.each(["create", "resume"] as const)(
+    "rechecks only A policy after async A %s while B updates",
+    async (activation) => {
+      const started = deferred();
+      const gate = deferred();
+      const setter = vi.fn();
+      const server = new ZCodeProtocolAgentServer({
+        createZCodeApp: async (options) => {
+          started.resolve();
+          await gate.promise;
+          return createFakeApp(options, { setCompactionPolicy: setter });
+        },
+        sessionStore: {
+          getSession: async () =>
+            activation === "resume"
+              ? {
+                  id: "sess_a",
+                  directory: a.workspacePath,
+                  path: a.workspacePath,
+                  time: { created: 1, updated: 2 },
+                }
+              : null,
+          messages: async () => [],
+        } as unknown as SessionStorePort,
+      });
+      const context = (server as unknown as { context: ZCodeProtocolAgentServerContext }).context;
+      await updateCompactionPolicy(context, { workspace: a, ...policyA });
+      const pending =
+        activation === "create"
+          ? createSessionRecordForV4(context, { workspace: a })
+          : activateSessionForResume(context, { sessionId: "sess_a" });
+      await started.promise;
+      await updateCompactionPolicy(context, { workspace: b, ...policyB });
+      gate.resolve();
+      const result = await pending;
+      const id = activation === "create" ? (result as { sessionId: string }).sessionId : "sess_a";
+      try {
+        expect(setter).toHaveBeenCalledExactlyOnceWith(policyA);
+      } finally {
+        await closeSession(context, { sessionId: id });
+      }
+    },
+  );
+});
