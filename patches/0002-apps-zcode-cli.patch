+    expect(fetch).not.toHaveBeenCalled();
+    await expect(model.doGenerate({ prompt: [] })).rejects.toThrow("codex-login-required");
+    expect(fetch).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/zcode-cli/packages/adapters/src/model/codex-transport/contract.ts b/apps/zcode-cli/packages/adapters/src/model/codex-transport/contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2f5dfaaa3b47e95a27d3555ccfae3c846a67523
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/codex-transport/contract.ts
@@ -0,0 +1,23 @@
+import type { LanguageModel } from "ai";
+
+export type CodexRuntimeModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+export type CodexCallOptions = Parameters<CodexRuntimeModel["doStream"]>[0];
+export type CodexGenerateResult = Awaited<ReturnType<CodexRuntimeModel["doGenerate"]>>;
+export type CodexStreamPart =
+  Awaited<ReturnType<CodexRuntimeModel["doStream"]>>["stream"] extends ReadableStream<infer Part>
+    ? Part
+    : never;
+
+export interface CodexModelOptions {
+  readonly modelId: string;
+  readonly apiKey?: string;
+  readonly headers?: Readonly<Record<string, string>>;
+  readonly fetch: typeof globalThis.fetch;
+  readonly optionBody?: Readonly<Record<string, unknown>>;
+  readonly captureBody?: (body: Record<string, unknown>) => void;
+}
+
+export const CODEX_BASE_URL = "https://chatgpt.com/backend-api/codex";
+export const CODEX_RESPONSES_URL = `${CODEX_BASE_URL}/responses`;
+// 从本机 opencode v2.1.4 的可执行文件 --user-agent 参数核实，不能使用 unknown 占位值。
+export const CODEX_USER_AGENT = "opencode/latest/2.1.4/cli";
diff --git a/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts b/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts
new file mode 100644
index 0000000000000000000000000000000000000000..00df528a9f061f4f66f691d73181eb326efd219d
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/codex-transport/events.ts
@@ -0,0 +1,172 @@
+import type {
+  LLMEvent,
+  LLMResponse,
+  Usage,
+  ProviderMetadata,
+  FinishReasonDetails,
+} from "@opencode/ai";
+import type { CodexGenerateResult, CodexStreamPart } from "./contract.js";
+
+// 原 parser 的 metadata 来源是经 schema 解码的 wire JSON，转换结构类型时保持原键不变。
+function metadata(value: ProviderMetadata | undefined): CodexGenerateResult["providerMetadata"] {
+  return value as CodexGenerateResult["providerMetadata"];
+}
+function finishReason(reason: FinishReasonDetails): CodexGenerateResult["finishReason"] {
+  const normalized = reason.normalized;
+  return {
+    unified: normalized === "unknown" ? "other" : normalized,
+    raw: reason.raw ?? normalized,
+  };
+}
+function usage(value: Usage | undefined): CodexGenerateResult["usage"] {
+  return {
+    inputTokens: {
+      total: value?.inputTokens,
+      noCache: value?.nonCachedInputTokens,
+      cacheRead: value?.cacheReadInputTokens,
+      cacheWrite: value?.cacheWriteInputTokens,
+    },
+    outputTokens: {
+      total: value?.outputTokens,
+      reasoning: value?.reasoningTokens,
+      text: value?.outputTokens === undefined ? undefined : value.visibleOutputTokens,
+    },
+    raw: value?.providerMetadata?.openai as CodexGenerateResult["usage"]["raw"],
+  };
+}
+
+export function codexResult(response: LLMResponse): CodexGenerateResult {
+  const terminal = response.events.findLast((event) => event.type === "finish");
+  const responseId = terminal?.providerMetadata?.openai?.responseId;
+  return {
+    warnings: [],
+    usage: usage(response.usage),
+    finishReason: finishReason(response.finishReason),
+    providerMetadata: metadata(terminal?.providerMetadata),
+    response: typeof responseId === "string" ? { id: responseId } : undefined,
+    content: response.message.content.map((part): CodexGenerateResult["content"][number] => {
+      switch (part.type) {
+        case "text":
+        case "reasoning":
+          return {
+            type: part.type,
+            text: part.text,
+            providerMetadata: metadata(part.providerMetadata),
+          };
+        case "tool-call":
+          return {
+            type: "tool-call",
+            toolCallId: part.id,
+            toolName: part.name,
+            input: JSON.stringify(part.input),
+            providerExecuted: part.providerExecuted,
+            providerMetadata: metadata(part.providerMetadata),
+          };
+        default:
+          throw new Error(`codex-unsupported-generated-content: ${part.type}`);
+      }
+    }),
+  };
+}
+
+/** 这里只改变事件字段名，不解析 SSE/原生 JSON；分片合并与工具校验由 opencode 持有。 */
+export async function* codexEvents(
+  events: AsyncIterable<LLMEvent>,
+): AsyncGenerator<CodexStreamPart> {
+  const text = new Map<string, string>();
+  let finished = false;
+  yield { type: "stream-start", warnings: [] };
+  for await (const event of events) {
+    switch (event.type) {
+      case "text-start":
+      case "reasoning-start":
+        text.set(event.id, "");
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "text-delta":
+      case "reasoning-delta":
+        text.set(event.id, (text.get(event.id) ?? "") + event.text);
+        yield {
+          type: event.type,
+          id: event.id,
+          delta: event.text,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "text-end":
+      case "reasoning-end": {
+        const previous = text.get(event.id) ?? "";
+        if (event.text !== undefined && event.text !== previous) {
+          if (!event.text.startsWith(previous))
+            throw new Error("codex-authoritative-text-mismatch");
+          yield {
+            type: event.type === "text-end" ? "text-delta" : "reasoning-delta",
+            id: event.id,
+            delta: event.text.slice(previous.length),
+          };
+        }
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        text.delete(event.id);
+        break;
+      }
+      case "tool-input-start":
+        yield {
+          type: event.type,
+          id: event.id,
+          toolName: event.name,
+          providerExecuted: event.providerExecuted,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-input-delta":
+        yield { type: event.type, id: event.id, delta: event.text };
+        break;
+      case "tool-input-end":
+        yield {
+          type: event.type,
+          id: event.id,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-call":
+        yield {
+          type: event.type,
+          toolCallId: event.id,
+          toolName: event.name,
+          input: JSON.stringify(event.input),
+          providerExecuted: event.providerExecuted,
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "tool-input-error":
+        throw new Error(`codex-invalid-tool-input: ${event.name}`);
+      case "provider-error":
+        throw new Error(event.message, { cause: event.classification });
+      case "finish":
+        finished = true;
+        if (typeof event.providerMetadata?.openai?.responseId === "string")
+          yield { type: "response-metadata", id: event.providerMetadata.openai.responseId };
+        yield {
+          type: "finish",
+          finishReason: finishReason(event.reason),
+          usage: usage(event.usage),
+          providerMetadata: metadata(event.providerMetadata),
+        };
+        break;
+      case "step-start":
+      case "step-finish":
+        break;
+      default:
+        throw new Error(`codex-unsupported-generated-event: ${event.type}`);
+    }
+  }
+  if (!finished) throw new Error("codex-response-incomplete");
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/codex-transport/messages.ts b/apps/zcode-cli/packages/adapters/src/model/codex-transport/messages.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d9168b5cb66fdbfd43010f657151a31398eac57
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/codex-transport/messages.ts
@@ -0,0 +1,113 @@
+import { Media, Message, type ContentPart, type ToolResultValue } from "@opencode/ai";
+import type { CodexCallOptions } from "./contract.js";
+
+type RuntimeMessage = CodexCallOptions["prompt"][number];
+type RuntimePart = Exclude<RuntimeMessage, { role: "system" }>["content"][number];
+type RuntimeOutput = Extract<RuntimePart, { type: "tool-result" }>["output"];
+
+function toolOutput(output: RuntimeOutput): ToolResultValue {
+  switch (output.type) {
+    case "json":
+    case "text":
+      return output;
+    case "error-json":
+    case "error-text":
+      return { type: "error", value: output.value };
+    case "execution-denied":
+      return { type: "error", value: output.reason ?? "Tool execution denied" };
+    case "content":
+      return {
+        type: "content",
+        value: output.value.map((part) => {
+          switch (part.type) {
+            case "text":
+              return { type: "text", text: part.text };
+            case "image-data":
+              return {
+                type: "file",
+                uri: `data:${part.mediaType};base64,${part.data}`,
+                mime: part.mediaType,
+              };
+            case "image-url":
+              return { type: "file", uri: part.url, mime: "image/*" };
+            case "file-data":
+              return {
+                type: "file",
+                uri: `data:${part.mediaType};base64,${part.data}`,
+                mime: part.mediaType,
+              };
+            default:
+              throw new Error(`codex-unsupported-tool-content: ${part.type}`);
+          }
+        }),
+      };
+  }
+}
+
+function content(part: RuntimePart): ContentPart {
+  const providerMetadata = part.providerOptions;
+  switch (part.type) {
+    case "text":
+      return { type: "text", text: part.text, providerMetadata };
+    case "reasoning":
+      return { type: "reasoning", text: part.text, providerMetadata };
+    case "file":
+      return {
+        type: "media",
+        filename: part.filename,
+        providerMetadata,
+        media:
+          part.data instanceof URL
+            ? Media.url(part.data.href, { mediaType: part.mediaType })
+            : typeof part.data === "string"
+              ? Media.base64(part.data, part.mediaType)
+              : Media.bytes(part.data, part.mediaType),
+      };
+    case "tool-call":
+      return {
+        type: "tool-call",
+        id: part.toolCallId,
+        name: part.toolName,
+        input: part.input,
+        providerExecuted: part.providerExecuted,
+        providerMetadata,
+      };
+    case "tool-result":
+      return {
+        type: "tool-result",
+        id: part.toolCallId,
+        name: part.toolName,
+        result: toolOutput(part.output),
+        providerMetadata,
+      };
+    default:
+      throw new Error(`codex-unsupported-message-content: ${part.type}`);
+  }
+}
+
+/** 只翻译运行时结构；instructions/工具/reasoning 的 wire 形态由 opencode 原协议生成。 */
+export function codexMessages(prompt: CodexCallOptions["prompt"]) {
+  const system: string[] = [];
+  const messages: Message[] = [];
+  for (const message of prompt) {
+    if (message.role === "system" && messages.length === 0) {
+      system.push(message.content);
+      continue;
+    }
+    messages.push(
+      Message.make({
+        role: message.role,
+        providerMetadata: message.providerOptions,
+        content: message.role === "system" ? message.content : message.content.map(content),
+      }),
+    );
+  }
+  return { system: system.join("\n\n"), messages };
+}
+
+export function codexTools(options: CodexCallOptions) {
+  return options.tools?.map((tool) => {
+    if (tool.type !== "function") throw new Error(`codex-unsupported-provider-tool: ${tool.id}`);
+    return { name: tool.name, description: tool.description ?? "", inputSchema: tool.inputSchema };
+  });
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/codex-transport/module.ts b/apps/zcode-cli/packages/adapters/src/model/codex-transport/module.ts
new file mode 100644
index 0000000000000000000000000000000000000000..566f66e4aa29d5a5b001d87ef4d8d52b385b4494
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/codex-transport/module.ts
@@ -0,0 +1,193 @@
+import { promisify } from "node:util";
+import { zstdDecompress } from "node:zlib";
+import { APICallError } from "ai";
+import { AIError, Auth, isRetryable, LLM, type LanguageModel } from "@opencode/ai";
+import { AI } from "@opencode/ai/promise";
+import { OpenAIResponses } from "@opencode/ai/protocols/openai-responses";
+import { RequestExecutor } from "@opencode/ai/route/executor";
+import { Route } from "@opencode/ai/route/client";
+import { Endpoint } from "@opencode/ai/route/endpoint";
+import { Layer } from "effect";
+import { FetchHttpClient } from "effect/http";
+import {
+  CODEX_BASE_URL,
+  CODEX_RESPONSES_URL,
+  CODEX_USER_AGENT,
+  type CodexCallOptions,
+  type CodexModelOptions,
+  type CodexRuntimeModel,
+} from "./contract.js";
+import { codexMessages, codexTools } from "./messages.js";
+import { codexEvents, codexResult } from "./events.js";
+
+const decompress = promisify(zstdDecompress);
+const PROTECTED_BODY_FIELDS = ["model", "input", "stream", "previous_response_id", "conversation"];
+const OUTPUT_LIMIT_FIELDS = ["max_output_tokens", "max_tokens"];
+const CODEX_ROUTE = Route.make({
+  id: OpenAIResponses.route.id,
+  provider: OpenAIResponses.route.provider,
+  providerMetadataKey: OpenAIResponses.route.providerMetadataKey,
+  protocol: OpenAIResponses.protocol,
+  endpoint: Endpoint.path(OpenAIResponses.PATH, { baseURL: CODEX_BASE_URL }),
+  transport: OpenAIResponses.httpTransport,
+  defaults: OpenAIResponses.route.defaults,
+});
+
+function requestError(error: unknown): unknown {
+  if (!(error instanceof AIError)) return error;
+  const reason = error.reason;
+  return new APICallError({
+    message: error.message,
+    url: reason.http?.url ?? CODEX_RESPONSES_URL,
+    requestBodyValues: undefined,
+    statusCode: reason.http?.status,
+    responseHeaders: reason.http?.headers,
+    responseBody: "body" in reason ? reason.body : undefined,
+    isRetryable: isRetryable(error),
+    cause: error,
+  });
+}
+
+function bodyOverlay(config: CodexModelOptions, options: CodexCallOptions) {
+  const body = { ...config.optionBody };
+  for (const key of PROTECTED_BODY_FIELDS)
+    if (key in body) throw new Error(`codex-protected-option-field: ${key}`);
+  // opencode OpenAIPlugin 的 context/compaction hook 删除 maxTokens；同样不发 option map 的 output limit。
+  for (const key of OUTPUT_LIMIT_FIELDS) delete body[key];
+  if (options.responseFormat?.type === "json") {
+    const format = options.responseFormat;
+    body.text = {
+      ...(typeof body.text === "object" && body.text !== null ? body.text : {}),
+      format: format.schema
+        ? {
+            type: "json_schema",
+            name: format.name ?? "response",
+            schema: format.schema,
+            strict: true,
+            ...(format.description ? { description: format.description } : {}),
+          }
+        : { type: "json_object" },
+    };
+  }
+  return { ...body, store: false };
+}
+
+function nativeRequest(
+  config: CodexModelOptions,
+  options: CodexCallOptions,
+): ReturnType<typeof LLM.request> {
+  if (!config.apiKey || !new Headers(config.headers).get("chatgpt-account-id"))
+    throw new Error("codex-login-required");
+  const headers = new Headers();
+  for (const [name, value] of Object.entries(options.headers ?? {}))
+    if (value !== undefined) headers.set(name, value);
+  for (const [name, value] of Object.entries(config.headers ?? {})) headers.set(name, value);
+  headers.set("User-Agent", CODEX_USER_AGENT);
+  headers.set("originator", "opencode");
+  headers.set("x-codex-beta-features", "remote_compaction_v2");
+  const model: LanguageModel = CODEX_ROUTE.with({
+    auth: Auth.value(config.apiKey).bearer(),
+    http: { encoding: "zstd" },
+  }).model({ id: config.modelId });
+  const choice = options.toolChoice;
+  return LLM.request({
+    model,
+    ...codexMessages(options.prompt),
+    tools: codexTools(options),
+    toolChoice: choice?.type === "tool" ? { type: "tool", name: choice.toolName } : choice,
+    generation: {
+      temperature: options.temperature,
+      topP: options.topP,
+      presencePenalty: options.presencePenalty,
+      frequencyPenalty: options.frequencyPenalty,
+    },
+    providerOptions: {
+      ...options.providerOptions?.openai,
+      store: false,
+      include: ["reasoning.encrypted_content"],
+    },
+    http: { headers: Object.fromEntries(headers), body: bodyOverlay(config, options) },
+  });
+}
+
+function client(config: CodexModelOptions) {
+  const fetch: typeof globalThis.fetch = async (input, init) => {
+    const request = new Request(input, init);
+    if (request.url !== CODEX_RESPONSES_URL || request.method !== "POST")
+      throw new Error("codex-endpoint-not-allowed");
+    request.signal.throwIfAborted();
+    if (config.captureBody) {
+      const bytes = Buffer.from(await request.clone().arrayBuffer());
+      const decoded =
+        request.headers.get("Content-Encoding") === "zstd" ? await decompress(bytes) : bytes;
+      config.captureBody(JSON.parse(decoded.toString("utf8")));
+    }
+    // 依赖包的 FetchHttpClient 必须复用原请求安全/代理 fetch，不能回退 global fetch 或跟随重定向。
+    request.signal.throwIfAborted();
+    return config.fetch(input, { ...init, redirect: "error" });
+  };
+  const http = FetchHttpClient.layer.pipe(
+    Layer.provide(
+      Layer.mergeAll(
+        Layer.succeed(FetchHttpClient.Fetch, fetch),
+        Layer.succeed(FetchHttpClient.RequestInit, { redirect: "error" }),
+      ),
+    ),
+  );
+  return AI.make({ layer: RequestExecutor.layer.pipe(Layer.provide(http)) });
+}
+
+export function createCodexResponsesModel(config: CodexModelOptions): CodexRuntimeModel {
+  return {
+    specificationVersion: "v3",
+    provider: "opencode.codex",
+    modelId: config.modelId,
+    supportedUrls: { "image/*": [/^https?:\/\//] },
+    async doGenerate(options) {
+      const request = nativeRequest(config, options);
+      const ai = client(config);
+      try {
+        return codexResult(await ai.llm.generate(request, { signal: options.abortSignal }));
+      } catch (error) {
+        throw requestError(error);
+      } finally {
+        await ai.dispose();
+      }
+    },
+    async doStream(options) {
+      const request = nativeRequest(config, options);
+      const abort = new AbortController();
+      const signal = options.abortSignal
+        ? AbortSignal.any([abort.signal, options.abortSignal])
+        : abort.signal;
+      async function* run() {
+        const ai = client(config);
+        try {
+          yield* codexEvents(ai.llm.stream(request, { signal }));
+        } catch (error) {
+          throw requestError(error);
+        } finally {
+          await ai.dispose();
+        }
+      }
+      const iterator = run();
+      return {
+        stream: new ReadableStream({
+          async pull(controller) {
+            try {
+              const next = await iterator.next();
+              if (next.done) controller.close();
+              else controller.enqueue(next.value);
+            } catch (error) {
+              controller.error(error);
+            }
+          },
+          async cancel(reason) {
+            abort.abort(reason);
+            await iterator.return();
+          },
+        }),
+      };
+    },
+  };
+}
