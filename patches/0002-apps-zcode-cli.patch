+    resolveUserHome: () => tmpdir(),
+    defaultPriorityFiles: ["RULES.txt"],
+  });
+  const options = { workingDirectory: tmpdir(), projectRoot: tmpdir() };
+  await expect(registry.observe(options, {})).rejects.toThrow("initial refresh failed");
+  expect(watch).toHaveBeenCalled();
+  expect(close).toHaveBeenCalledTimes(vi.mocked(watch).mock.calls.length);
+  const first = await registry.observe(options, {});
+  const second = await registry.observe(options, {});
+  expect(resolveInstructions).toHaveBeenCalledTimes(2);
+  first.dispose();
+  expect(await second.readSnapshot()).toBeUndefined();
+  second.dispose();
+  expect(close).toHaveBeenCalledTimes(vi.mocked(watch).mock.calls.length);
+});
