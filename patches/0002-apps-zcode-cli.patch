+
+function collectMultilineOnlyMatchingMatches(
+  path: string,
+  content: string,
+  regex: RegExp,
+): OnlyMatchingMatches {
+  const matches: OnlyMatchingMatches = {
+    matchCount: 0,
+    ranges: [],
+    entriesByLine: new Map(),
