--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/tests/instruction-observation-regression.test.ts
@@ -0,0 +1,63 @@
+import { EventEmitter } from "node:events";
+import { watch, type FSWatcher } from "node:fs";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { createNodeContextSourceAdapter } from "../src/context/index.js";
+
+vi.mock("node:fs", async (original) => ({
+  ...(await original<typeof import("node:fs")>()),
+  watch: vi.fn(),
+}));
+afterEach(() => vi.resetAllMocks());
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "instruction-regression-"));
+  await mkdir(join(root, ".git"));
+  let changed: (() => void) | undefined;
+  vi.mocked(watch).mockImplementation(((
+    _path: unknown,
+    _options: unknown,
+    listener: (event: string, name: string) => void,
+  ) => {
+    changed = () => listener("change", "AGENTS.md");
+    const handle = new EventEmitter() as FSWatcher;
+    handle.close = vi.fn();
+    return handle;
+  }) as typeof watch);
+  const adapter = createNodeContextSourceAdapter({ env: { HOME: root } });
+  await writeFile(join(root, "AGENTS.md"), "ABCDE");
+  const lease = await adapter.observeUserInstructions({
+    workingDirectory: root,
+    projectRoot: root,
+    priorityFiles: ["AGENTS.md"],
+    maxBytes: 2,
+  });
+  return { root, lease, changed: () => changed!() };
+}
+
+it("does not return an in-flight snapshot after its lease is disposed", async () => {
+  const f = await fixture();
+  try {
+    const pending = f.lease.readSnapshot();
+    f.lease.dispose();
+    expect(await pending).toBeUndefined();
+  } finally {
+    f.lease.dispose();
+    await rm(f.root, { recursive: true, force: true });
+  }
+});
+
+it("refreshes size metadata when the truncated content prefix is unchanged", async () => {
+  const f = await fixture();
+  try {
+    await writeFile(join(f.root, "AGENTS.md"), "ABCDEFGHI");
+    f.changed();
+    await expect.poll(async () => (await f.lease.readSnapshot())?.sizeBytes).toBe(9);
+    expect((await f.lease.readSnapshot())?.content).toBe("AB");
+  } finally {
+    f.lease.dispose();
+    await rm(f.root, { recursive: true, force: true });
+  }
+});
