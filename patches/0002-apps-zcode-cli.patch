+/** 冷恢复轮末速率的完整事实：分子与分母必须出自同一批主轮事件。 */
+export interface TurnModelTiming extends Omit<TurnModelTimingEntryData, "parentUserMessageId"> {}
+
+/** 与 ProductProjection.onModelComplete 的 isMainTurn 判据保持一致。 */
+function isMainTurnComplete(payload: ModelCompletePayload): boolean {
+  return payload.querySource !== undefined
+    ? payload.querySource === "main_turn"
+    : payload.stopReason !== "tool_internal";
+}
+
+interface AttemptTiming {
+  providerId: string | undefined;
+  durationMs: number;
+}
+
+/**
+ * 一轮结束时从同一批事件派生轮末速率事实。
+ *
+ * 分子：主轮 ModelComplete 的 output token 之和（与 live 的 turnHeader.outputTokens 同源，
+ * 失败请求上报的 token 不计入）。
+ * 分母：主轮 network attempt 的模型耗时之和（completed/failed），不含重试退避与本地后处理。
+ * 高速轮与 live 一样只看加速 provider 的子集：混合轮回退到普通 provider 后，
+ * 普通侧耗时不是 live 的分母，这里也不能混进来。
+ */
+export function resolveTurnModelTiming(
+  events: readonly SessionEvent[],
+  sinceMs: number,
+): TurnModelTiming | undefined {
+  let outputTokens = 0;
+  const attempts: AttemptTiming[] = [];
+  for (const event of events) {
+    if (event.timestamp.getTime() < sinceMs) continue;
+    if (event.type === SessionEventType.ModelComplete) {
+      const payload = event.payload as ModelCompletePayload;
+      if (!isMainTurnComplete(payload)) continue;
+      const tokens = payload.usage?.outputTokens;
+      if (typeof tokens === "number" && Number.isFinite(tokens) && tokens > 0) {
+        outputTokens += tokens;
+      }
+      continue;
+    }
+    if (event.type !== SessionEventType.ModelNetworkStatus) continue;
+    const payload = event.payload as ModelNetworkStatusEvent;
+    if (payload.type !== "model_request_completed" && payload.type !== "model_request_failed") {
+      continue;
+    }
+    if (payload.querySource !== undefined && payload.querySource !== "main_turn") continue;
+    const durationMs = payload.durationMs;
+    if (typeof durationMs !== "number" || !Number.isFinite(durationMs) || durationMs < 0) continue;
+    attempts.push({ providerId: payload.providerId, durationMs });
+  }
+
+  const highspeedAttempts = attempts.filter((attempt) => isHighspeedProviderId(attempt.providerId));
+  const denominatorAttempts = highspeedAttempts.length > 0 ? highspeedAttempts : attempts;
+  const modelDurationMs = denominatorAttempts.reduce((sum, attempt) => sum + attempt.durationMs, 0);
+  // 任一侧缺失或非正时整轮保持未知：不拿逻辑总耗时、字符数或 0 分母兜底。
+  if (outputTokens <= 0 || modelDurationMs <= 0) return undefined;
+  return {
+    outputTokens,
+    modelDurationMs,
+    attemptCount: attempts.length,
+    highspeedAttemptCount: highspeedAttempts.length,
+  };
+}
+
+/**
+ * 轮次终态只写一次分子与分母。
+ *
+ * 不在每个 model step 结束时写前缀：那样最终一次覆盖失败、或 guide 改变了父用户消息身份时，
+ * 旧前缀会被冷恢复当成整轮结果。终态写入失败就整轮保持未知（下一次合并时该 entry 的
+ * `completedAt` 也不会存在）。
+ *
+ * 身份用 turn 启动时生成、guide 不修改的 user messageId，与冷/热投影唯一的 turnHeader
+ * `entityId` 一致。
+ */
+export async function persistTurnModelTiming(
+  runtime: AgentRuntimeInternal,
+  turn: { userMessageId: MessageId; startedAt: number },
+): Promise<void> {
+  const saveSessionEntry = runtime.sessionStore?.saveSessionEntry;
+  if (!saveSessionEntry) return;
+  const events = await runtime.eventStore?.getEvents(runtime.sessionId).catch(() => undefined);
+  // 事件读不到就无法证明这是整轮事实：宁可未知，也不写半份。
+  if (!events) return;
+  const timing = resolveTurnModelTiming(events, turn.startedAt);
+  if (!timing) return;
+  const data: TurnModelTimingEntryData = {
+    parentUserMessageId: turn.userMessageId,
+    outputTokens: timing.outputTokens,
+    modelDurationMs: timing.modelDurationMs,
+    attemptCount: timing.attemptCount,
+    highspeedAttemptCount: timing.highspeedAttemptCount,
+  };
+  const now = Date.now();
+  try {
+    await saveSessionEntry.call(runtime.sessionStore, {
+      // 每轮一个稳定 id：重复结算（重放/重试）只覆盖同一条，不会累加。
+      id: `${runtime.sessionId}:turn-model-timing:${turn.userMessageId}`,
+      sessionID: runtime.sessionId,
+      type: SESSION_ENTRY_TURN_MODEL_TIMING,
+      touchSession: false,
+      time: { created: turn.startedAt, updated: now },
+      data,
+    });
+  } catch (error) {
+    runtime.logger?.warn("Session turn model timing persistence failed", {
+      error: error instanceof Error ? error.message : String(error),
+      event: "session.turn_model_timing.persist_failed",
+      module: "core.runtime",
+    });
+  }
+}
