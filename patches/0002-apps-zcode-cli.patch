diff --git a/apps/zcode-cli/packages/core/tests/session-resources/contract.test.ts b/apps/zcode-cli/packages/core/tests/session-resources/contract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43b136580eaebaaf5b0ef54400219c85d69fcb7d
--- /dev/null
+++ b/apps/zcode-cli/packages/core/tests/session-resources/contract.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, it, vi } from "vitest";
+import { SessionResourceController } from "../../src/session-resources/module.js";
+import type { McpPort, SkillPort } from "@zcode/contracts";
+
+describe("session resource policy", () => {
+  it("retries a failed restore without ever substituting an empty policy", async () => {
+    const load = vi
+      .fn()
+      .mockRejectedValueOnce(new Error("temporary IO failure"))
+      .mockResolvedValue({ revision: 1, disabledSkills: [], disabledMcpServers: ["a"] });
+    const owner = new SessionResourceController({ load, save: async () => {} });
+    await expect(owner.assertEnabled("mcp", "a")).rejects.toThrow("IO failure");
+    await expect(owner.assertEnabled("mcp", "a")).rejects.toThrow("disabled in this session");
+  });
+  it("isolates sessions and restores accepted policy without modifying configuration", async () => {
+    let saved: unknown;
+    const persistence = {
+      load: async () => saved,
+      save: async (value: unknown) => {
+        saved = value;
+      },
+    };
+    const owner = new SessionResourceController(persistence);
+    await owner.set("mcp", "one", false);
+    await expect(owner.assertEnabled("mcp", "one")).rejects.toThrow("disabled in this session");
+    await expect(
+      new SessionResourceController().assertEnabled("mcp", "one"),
+    ).resolves.toBeUndefined();
+    const resumed = new SessionResourceController(persistence);
+    await expect(resumed.assertEnabled("mcp", "one")).rejects.toThrow();
+    await resumed.set("mcp", "one", true);
+    await expect(resumed.assertEnabled("mcp", "one")).resolves.toBeUndefined();
+  });
+
+  it("serializes independent updates, treats explicit same values as idempotent", async () => {
+    const save = vi.fn(async () => {});
+    const owner = new SessionResourceController({ load: async () => undefined, save });
+    await Promise.all([owner.set("skill", "plugin:a", false), owner.set("mcp", "a", false)]);
+    await owner.set("skill", "plugin:a", false);
+    expect(owner.snapshot()).toEqual({
+      revision: 2,
+      disabledSkills: ["plugin:a"],
+      disabledMcpServers: ["a"],
+    });
+    expect(save).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not publish a failed write and permits subsequent recovery", async () => {
+    const save = vi.fn().mockRejectedValueOnce(new Error("disk full")).mockResolvedValue(undefined);
+    const owner = new SessionResourceController({ load: async () => undefined, save });
+    await expect(owner.set("mcp", "a", false)).rejects.toThrow("disk full");
+    expect(owner.snapshot().disabledMcpServers).toEqual([]);
+    await owner.set("mcp", "b", false);
+    expect(owner.snapshot().disabledMcpServers).toEqual(["b"]);
+  });
+
+  it("fails closed on corrupt persisted policy", async () => {
+    const owner = new SessionResourceController({
+      load: async () => ({ disabledSkills: "bad" }),
+      save: async () => {},
+    });
+    await expect(owner.assertEnabled("mcp", "a")).rejects.toThrow();
+    await expect(owner.set("mcp", "a", true)).rejects.toThrow();
+  });
+
+  it("checks the resolved Skill identity so aliases cannot return disabled content", async () => {
+    const loadSkill = vi.fn(async () => ({
+      metadata: { name: "a", qualifiedName: "plugin:a" },
+      content: "private instructions",
+    }));
+    const owner = new SessionResourceController();
+    const port = owner.guardSkillPort({
+      loadSkill,
+      discoverSkills: vi.fn(),
+    } as unknown as SkillPort);
+    await owner.set("skill", "plugin:a", false);
+    await expect(port.loadSkill({ name: "a", workingDirectory: "." })).rejects.toThrow();
+    await owner.set("skill", "plugin:a", true);
+    expect((await port.loadSkill({ name: "a", workingDirectory: "." })).content).toBe(
+      "private instructions",
+    );
+  });
+
+  it("blocks the actual MCP route, not a model-visible name, and preserves port binding", async () => {
+    const raw = {
+      marker: 1,
+      callTool: vi.fn(async function (this: { marker: number }) {
+        return { marker: this.marker };
+      }),
+    };
+    const owner = new SessionResourceController();
+    const port = owner.guardMcpPort(raw as unknown as McpPort);
+    await owner.set("mcp", "plugin_one", false);
+    await expect(port.callTool({ serverName: "plugin_one", toolName: "alias" })).rejects.toThrow();
+    expect(raw.callTool).not.toHaveBeenCalled();
+    expect(await port.callTool({ serverName: "other", toolName: "alias" })).toEqual({ marker: 1 });
+  });
+
+  it("does not abort a call that has already entered the upstream port", async () => {
+    let finish!: (value: object) => void;
+    const callTool = vi.fn(
+      () =>
+        new Promise<object>((resolve) => {
+          finish = resolve;
+        }),
+    );
+    const owner = new SessionResourceController();
+    const port = owner.guardMcpPort({ callTool } as unknown as McpPort);
+    const pending = port.callTool({ serverName: "a", toolName: "read" });
+    await vi.waitFor(() => expect(callTool).toHaveBeenCalledOnce());
+    await owner.set("mcp", "a", false);
+    finish({ ok: true });
+    await expect(pending).resolves.toEqual({ ok: true });
+    await expect(port.callTool({ serverName: "a", toolName: "read" })).rejects.toThrow();
+  });
+});
diff --git a/apps/zcode-cli/packages/core/tests/session-resources/runtime.test.ts b/apps/zcode-cli/packages/core/tests/session-resources/runtime.test.ts
