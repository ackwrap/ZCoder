+++ b/apps/zcode-cli/packages/bootstrap/tests/context-projections/contract.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, expectTypeOf, it, vi } from "vitest";
+import type { MessageWithParts, SessionInfo, SessionStorePort } from "@zcode/contracts";
+import { readPersistedCompactSummary } from "../../src/zcode-protocol-v4/compact-summary-read.js";
+import { contextSourceUpdateNotices } from "../../src/zcode-protocol-v4/context-source-update-notice.js";
+import type {
+  ContextSourceUpdateNotices,
+  ReadPersistedCompactSummary,
+} from "../../src/zcode-protocol-v4/context-projections/contract.js";
+import { exampleReadAuthorizedCompactSummary } from "../../src/zcode-protocol-v4/context-projections/contract.example.js";
+
+const identity = {
+  sessionId: "session-contract",
+  operationId: "operation-contract",
+  summaryRef: "summary-contract",
+  branchGeneration: 0,
+};
+const update = {
+  version: 1,
+  kind: "skills",
+  sourceKey: "skills:catalog",
+  revision: "a".repeat(64),
+  changes: [{ sourceKey: "skills:one", label: "One", change: "added" }],
+};
+
+function fixture() {
+  const session = { id: identity.sessionId } as SessionInfo;
+  const message = {
+    info: {
+      id: identity.summaryRef,
+      sessionID: identity.sessionId,
+      role: "user",
+      synthetic: true,
+      summary: { body: "# Saved summary", diffs: [] },
+      semantics: {
+        origin: "agent_runtime",
+        kind: "compact_summary",
+        uiVisibility: "hidden",
+        transcriptVisibility: "hidden",
+      },
+    },
+    parts: [
+      {
+        type: "compaction",
+        sessionID: identity.sessionId,
+        messageID: identity.summaryRef,
+        operationId: identity.operationId,
+        compactBoundary: { summaryMessageIds: [identity.summaryRef] },
+      },
+    ],
+  } as unknown as MessageWithParts;
+  const store = {
+    getSession: vi.fn<SessionStorePort["getSession"]>().mockResolvedValue(session),
+    messageWithParts: vi.fn<SessionStorePort["messageWithParts"]>().mockResolvedValue(message),
+  } satisfies Pick<SessionStorePort, "getSession" | "messageWithParts">;
+  return { session, message, store };
+}
+
+function auditMessage(): MessageWithParts {
+  const { message } = fixture();
+  message.parts = [
+    {
+      type: "text",
+      id: "part-contract",
+      sessionID: identity.sessionId,
+      messageID: identity.summaryRef,
+      get text() {
+        throw new Error("Hidden body must not be read by audit projection");
+      },
+      metadata: { source: "context_source_update", sourceUpdate: update },
+    },
+  ] as unknown as MessageWithParts["parts"];
+  return message;
+}
+
+describe("V4 context projection contract", () => {
+  it("keeps the two production APIs and the async read result", async () => {
+    expectTypeOf(readPersistedCompactSummary).toEqualTypeOf<ReadPersistedCompactSummary>();
+    expectTypeOf(contextSourceUpdateNotices).toEqualTypeOf<ContextSourceUpdateNotices>();
+    expectTypeOf<ReturnType<ReadPersistedCompactSummary>>().toEqualTypeOf<
+      Promise<import("@zcode/shared/zcode-protocol-v4").V4ConversationCompactSummaryResult>
+    >();
+    // 此 identity 已由调用 gateway 授权；reader 不代替 marker 授权。
+    const { store } = fixture();
+    await expect(
+      exampleReadAuthorizedCompactSummary(readPersistedCompactSummary, store, identity),
+    ).resolves.toEqual({ status: "available", markdown: "# Saved summary" });
+    expect(store.messageWithParts).toHaveBeenCalledExactlyOnceWith({
+      sessionID: identity.sessionId,
+      messageID: identity.summaryRef,
+    });
+    expect(store.getSession).toHaveBeenCalledTimes(2);
+  });
+
+  it("rejects stale identity before reading and after a branch changes during IO", async () => {
+    const { session, message, store } = fixture();
+    store.getSession.mockResolvedValueOnce({
+      ...session,
+      revert: { branchGeneration: 1 },
+    } as SessionInfo);
+    await expect(readPersistedCompactSummary(store, identity)).resolves.toEqual({
+      status: "unavailable",
+      reason: "staleIdentity",
+    });
+    expect(store.messageWithParts).not.toHaveBeenCalled();
+    store.messageWithParts.mockImplementationOnce(async () => {
+      session.revert = { branchGeneration: 1 } as NonNullable<SessionInfo["revert"]>;
+      return message;
+    });
+    await expect(readPersistedCompactSummary(store, identity)).resolves.toEqual({
+      status: "unavailable",
+      reason: "staleIdentity",
+    });
+  });
+
+  it("rejects an unauthorized session and a mismatched operation boundary", async () => {
+    const { store } = fixture();
+    store.getSession.mockResolvedValueOnce(null);
+    await expect(readPersistedCompactSummary(store, identity)).resolves.toEqual({
+      status: "unavailable",
+      reason: "notAuthorized",
+    });
+    expect(store.messageWithParts).not.toHaveBeenCalled();
+    await expect(
+      readPersistedCompactSummary(store, { ...identity, operationId: "other-operation" }),
+    ).resolves.toEqual({ status: "unavailable", reason: "missingBody" });
+  });
+
+  it("projects only validated audit metadata, never the hidden body", () => {
+    const message = auditMessage();
+    expect(contextSourceUpdateNotices(message)).toEqual([
+      {
+        type: "context_source_update",
+        content: "",
+        messageId: identity.summaryRef,
+        partId: "part-contract",
+        sourceUpdate: update,
+      },
+    ]);
+    if (message.info.role !== "user") throw new Error("Expected user fixture");
+    message.info.synthetic = false;
+    expect(contextSourceUpdateNotices(message)).toEqual([]);
+  });
+
+  it("rejects foreign parts and invalid metadata without reading hidden text", () => {
+    const message = auditMessage();
+    const part = message.parts[0]!;
+    if (part.type !== "text") throw new Error("Expected text fixture");
+    part.messageID = "foreign" as typeof part.messageID;
+    expect(contextSourceUpdateNotices(message)).toEqual([]);
+    part.messageID = identity.summaryRef as typeof part.messageID;
+    part.metadata = { source: "context_source_update", sourceUpdate: { ...update, version: 2 } };
+    expect(contextSourceUpdateNotices(message)).toEqual([]);
+  });
+});
