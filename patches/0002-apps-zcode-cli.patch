+import { describe, expect, it } from "vitest";
+import {
+  ReadInputJsonSchema,
+  ReadInputSchema,
+  ReadPdfInputJsonSchema,
+  type JsonSchema,
+} from "@zcode/contracts";
+import { registerBuiltInTools } from "../src/tool/handlers/index.js";
+import { readToolEntry } from "../src/tool/handlers/read.js";
+import { createToolRegistry } from "../src/tool/registry.js";
+import { createTestRuntimeModel } from "./test-runtime-model.js";
+
+const RANGE_GUIDANCE =
+  "Use offset and limit to read relevant sections with enough surrounding context. Prefer one larger relevant read over many small slices, and use available content search to locate specific content before reading.";
+const OFFSET_DESCRIPTION =
+  "The line number to start reading from (1-based). Use with limit to read a relevant section.";
+const LIMIT_DESCRIPTION =
+  "The maximum number of lines to read. Use with offset to read a relevant section.";
+
+function expectRangeGuidance(description: string | undefined): void {
+  expect(description).toContain(RANGE_GUIDANCE);
+  expect(description).not.toMatch(/recommended to read the whole file|Only provide if/iu);
+  expect(description).not.toContain("Grep");
+}
+
+function expectRangeParameters(schema: JsonSchema | undefined): void {
+  expect(schema).toMatchObject({
+    properties: {
+      offset: { description: OFFSET_DESCRIPTION },
+      limit: { description: LIMIT_DESCRIPTION },
+    },
+  });
+}
+
+describe("Read range guidance", () => {
+  it.each([false, true])(
+    "keeps registry guidance consistent with embedded search %s",
+    (embeddedSearchEnabled) => {
+      const registry = createToolRegistry();
+      registerBuiltInTools(registry, { embeddedSearchEnabled });
+      const contract = registry.toContracts().find((tool) => tool.name === "Read");
+
+      expectRangeGuidance(contract?.description);
+      expectRangeParameters(contract?.inputSchema);
+      expect(registry.has("Grep")).toBe(!embeddedSearchEnabled);
+    },
+  );
+
+  it.each([undefined, false, true])(
+    "preserves range guidance in turn-level contracts with supportsPdf %s",
+    (supportsPdf) => {
+      const context =
+        supportsPdf === undefined
+          ? {}
+          : {
+              model: createTestRuntimeModel({
+                inputFormat: { supportsPdf },
+                generateText: async () => {
+                  throw new Error("Descriptor checks must not invoke the model");
+                },
+              }),
+            };
+      const contract = readToolEntry.resolveModelContract?.(context);
+
+      expectRangeGuidance(contract?.description);
+      expectRangeParameters(contract?.inputSchema);
+      expect(Boolean(contract?.description?.includes("- Reads PDFs"))).toBe(supportsPdf === true);
+      if (supportsPdf === true) {
+        expect(contract?.inputSchema).toHaveProperty("properties.pages");
+      } else {
+        expect(contract?.inputSchema).not.toHaveProperty("properties.pages");
+      }
+    },
+  );
+
+  it.each([ReadInputJsonSchema, ReadPdfInputJsonSchema])(
+    "exposes neutral range parameter descriptions in provider schemas",
+    (schema) => {
+      expectRangeParameters(schema);
+      expect(JSON.stringify(schema)).not.toContain("Only provide if the file is too large");
+    },
