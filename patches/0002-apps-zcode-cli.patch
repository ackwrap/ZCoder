+      (value): value is string => typeof value === "string",
+    );
+    return partSources.length === 0 || source === undefined || partSources.includes(source);
+  });
+}
+
+function runtimeEntryText(entry: RuntimeMessageEntry): string {
+  return isRuntimeAttachmentEntry(entry)
+    ? entry.content
