+    matchCount: input.matches.matchCount,
+    entries: createOnlyMatchingContentEntries(input),
+  };
+}
+
+function createOnlyMatchingContentEntries(input: {
+  path: string;
+  lines: string[];
+  request: FileSystemSearchTextRequest;
+  matches: OnlyMatchingMatches;
