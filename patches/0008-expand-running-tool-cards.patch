diff --git a/packages/ui/test/toolLiveExpand.test.ts b/packages/ui/test/toolLiveExpand.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b29ecafba863207b5f7fcea179fa425e97261d21
--- /dev/null
+++ b/packages/ui/test/toolLiveExpand.test.ts
@@ -0,0 +1,169 @@
+// @vitest-environment jsdom
+
+import { cleanup, render } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { toolCallRowToLegacyNode } from "../src/v4/toolCallRowAdapter.js";
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  EditToolCallBlock,
+  resolveEditChildAutoOpen,
+  resolveEditToolLayout,
+} from "../src/ToolCallBlocks/renderers/edit.js";
+import { ExecuteToolCallBlock } from "../src/ToolCallBlocks/renderers/execute.js";
+import { readRawToolCallFileSummaries } from "../src/ToolCallBlocks/fileSummaries.js";
+
+const displayModel = {
+  inlinePreview: { type: "none" as const },
+  planResult: null,
+  viewerSource: null,
+  viewerLabelId: "codeViewer.viewCode",
+  showSummaryFileLink: true,
+  showInput: false,
+  showOutput: true,
+  showKind: false,
+};
+
+function renderEdit(status: "running" | "completed") {
+  const node = toolCallRowToLegacyNode({
+    kind: "toolCall",
+    rowId: 1,
+    turnId: "turn",
+    createdAt: 1,
+    createdAtSeq: 1,
+    toolCallId: `edit-live-${status}`,
+    toolName: "Edit",
+    status,
+    inputText: "",
+    input: {
+      file_path: "/workspace/live.ts",
+      old_string: "const before = 1;",
+      new_string: "const after = 2;",
+    },
+  } as ToolCallRow);
+  const rawFileSummaries = readRawToolCallFileSummaries(node.toolCall.raw, node.toolCall);
+  return render(
+    createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "zh-CN" },
+      createElement(EditToolCallBlock, {
+        toolCallNode: node,
+        workspacePath: "/workspace",
+        displayModel,
+        viewerSource: null,
+        rawFileSummaries,
+        isRunning: status === "running",
+        statusLabel: status,
+        childToolList: null,
+      } as never),
+    ),
+  );
+}
+
+function renderExecute(status: "running" | "completed") {
+  const node = toolCallRowToLegacyNode({
+    kind: "toolCall",
+    rowId: 2,
+    turnId: "turn",
+    createdAt: 1,
+    createdAtSeq: 1,
+    toolCallId: `exec-live-${status}`,
+    toolName: "Bash",
+    status,
+    inputText: "",
+    input: { command: "run-build" },
+    outputPreview: {
+      text: "latest-line-xyz",
+      fullText: "latest-line-xyz",
+      totalLines: 1,
+      totalBytes: 11,
+      linesEstimated: false,
+    },
+  } as ToolCallRow);
+  return render(
+    createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "zh-CN" },
+      createElement(ExecuteToolCallBlock, {
+        toolCallNode: node,
+        workspacePath: "/workspace",
+        displayModel,
+        viewerSource: null,
+        rawFileSummaries: [],
+        isRunning: status === "running",
+        statusLabel: status,
+        childToolList: null,
+      } as never),
+    ),
+  );
+}
+
+afterEach(() => {
+  cleanup();
+});
+
+beforeAll(() => {
+  // jsdom 不实现 matchMedia / ResizeObserver，diff 高亮与命令输出测量需要它们。
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  );
+  Object.defineProperty(window, "matchMedia", {
+    configurable: true,
+    value: (query: string) => ({
+      matches: false,
+      media: query,
+      onchange: null,
+      addEventListener() {},
+      removeEventListener() {},
+      addListener() {},
+      removeListener() {},
+      dispatchEvent: () => false,
+    }),
+  });
+});
+
+describe("edit live expand layout", () => {
+  it("auto-opens a single-file edit only while it is running", () => {
+    expect(resolveEditToolLayout({ hasMultipleFiles: false, isRunning: true })).toEqual({
+      canToggle: true,
+      forceOpen: false,
+      autoOpen: true,
+    });
+    expect(resolveEditToolLayout({ hasMultipleFiles: false, isRunning: false }).autoOpen).toBe(
+      false,
+    );
+  });
+
+  it("keeps the multi-file container collapsed and auto-opens each child while running", () => {
+    expect(resolveEditToolLayout({ hasMultipleFiles: true, isRunning: true }).autoOpen).toBe(false);
+    expect(resolveEditChildAutoOpen(true)).toBe(true);
+    expect(resolveEditChildAutoOpen(false)).toBe(false);
+  });
+
+  it("renders the diff without a click while running and stays collapsed after completion", () => {
+    const running = renderEdit("running");
+    expect(running.container.textContent).toContain("const after = 2;");
+
+    cleanup();
+    const completed = renderEdit("completed");
+    expect(completed.container.textContent).not.toContain("const after = 2;");
+  });
+});
+
+describe("execute live expand layout", () => {
+  it("renders command output without a click while running", () => {
+    const running = renderExecute("running");
+    expect(running.container.textContent).toContain("latest-line-xyz");
+  });
+
+  it("keeps a completed command collapsed", () => {
+    const completed = renderExecute("completed");
+    expect(completed.container.textContent).not.toContain("latest-line-xyz");
+  });
+});
