+    intl: {
+      formatMessage: ({ id }: { id: string }, values?: Record<string, string | number>): string =>
+        values?.model ? `${id}:${values.model}` : id,
+    },
+  }),
+}));
+const servicesMock = vi.hoisted(() => ({
+  modelSelectionService: { getView: vi.fn() },
+}));
+vi.mock("@/hooks/useServices.js", () => ({ useServices: () => servicesMock }));
+
+function entry(modelId: string, text: string): ModelSystemPromptEntry {
+  return { providerId: "p", modelId, text };
+}
+
+function renderSection(
+  entries: ModelSystemPromptEntry[],
+  update: (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => Promise<void>,
+  titleGenerationModel?: { providerId: string; modelId: string },
+) {
+  return render(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: entries },
+      onUpdateSettings: update,
+      titleGenerationModel,
+    }),
+  );
+}
+
+async function openDialog() {
+  await waitFor(() =>
+    expect(
+      (screen.getByTestId("model-system-prompt-open-dialog") as HTMLButtonElement).disabled,
+    ).toBe(false),
+  );
+  fireEvent.click(screen.getByTestId("model-system-prompt-open-dialog"));
+}
+
+async function chooseModel(modelId: string) {
+  if (screen.queryByTestId("model-system-prompt-dialog")) {
+    fireEvent.click(screen.getByTestId("model-system-prompt-cancel"));
+    await expectDialogClosed();
+  }
+  fireEvent.change(screen.getByTestId("model-system-prompt-model-select"), {
+    target: { value: modelSystemPromptEntryKey("p", modelId) },
+  });
+  await openDialog();
+}
+
+function textarea(): HTMLTextAreaElement {
+  return screen.getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement;
+}
+
+async function expectDialogClosed() {
+  await waitFor(() => expect(screen.queryByTestId("model-system-prompt-dialog")).toBeNull());
+}
+
+afterEach(cleanup);
+
+describe("model system prompt dialog", () => {
