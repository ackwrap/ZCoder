index 0000000000000000000000000000000000000000..08bd83a7d3714f1c3525a744e91eece9ab372cea
--- /dev/null
+++ b/packages/ui/test/conversationFocusModeGroups.test.ts
@@ -0,0 +1,177 @@
+import { describe, expect, it } from "vitest";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  buildFocusLogicalGroupsFromRows,
+  didFocusLoadProgress,
+  readFocusLoadProgress,
+  resolveFocusDataRequirement,
+  selectFocusTimelineWindow,
+} from "@/v4/focus-mode/contract.js";
+
+let nextId = 1;
+
+function header(turnId: string, state: string): ConversationRow {
+  const rowId = nextId++;
+  return {
+    rowId,
+    turnId,
+    kind: "turnHeader",
+    origin: "userInput",
+    executionKind: "agent",
+    state,
+    startedAt: 1,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function user(turnId: string, guided = false): ConversationRow {
+  const rowId = nextId++;
+  return {
+    rowId,
+    turnId,
+    kind: "userInput",
+    origin: "realUser",
+    text: `user-${rowId}`,
+    createdAt: 1,
+    createdAtSeq: rowId,
+    ...(guided ? { guided: true as const } : {}),
+  } as ConversationRow;
+}
+
+function assistant(turnId: string, state = "complete"): ConversationRow {
+  const rowId = nextId++;
+  return {
+    rowId,
+    turnId,
+    kind: "assistantText",
+    text: `answer-${rowId}`,
+    state,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function tool(turnId: string, status = "complete"): ConversationRow {
+  const rowId = nextId++;
+  return {
+    rowId,
+    turnId,
+    kind: "toolCall",
+    toolName: "Bash",
+    toolCallId: `tool-${rowId}`,
+    status,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function successTurn(turnId: string, guided = false): ConversationRow[] {
+  return [
+    header(turnId, "completedSuccess"),
+    user(turnId),
+    ...(guided ? [user(turnId, true)] : []),
+    assistant(turnId),
+  ];
+}
+
+function runningTurn(turnId: string): ConversationRow[] {
+  return [
+    header(turnId, "running"),
+    user(turnId),
+    user(turnId, true),
+    tool(turnId, "complete"),
+    assistant(turnId, "streaming"),
+  ];
+}
+
+function interruptedTurn(turnId: string): ConversationRow[] {
+  return [header(turnId, "completedInterrupted"), user(turnId), assistant(turnId, "interrupted")];
+}
+
+describe("focus logical groups", () => {
+  it("keeps A success + B running despite guided inputs and completed tools", () => {
+    const rows = [...successTurn("a"), ...runningTurn("b")];
+    const groups = buildFocusLogicalGroupsFromRows(rows);
+
+    expect(groups.map((group) => group.turnIds)).toEqual([["a"], ["b"]]);
+    expect(groups.map((group) => group.complete)).toEqual([true, false]);
+
+    const window = selectFocusTimelineWindow(groups, false);
+    expect(window.turnIds).toEqual(["a", "b"]);
+  });
+
+  it("merges interrupted B with resumed C instead of consuming two slots", () => {
+    const rows = [...successTurn("a"), ...interruptedTurn("b"), ...runningTurn("c")];
+    const groups = buildFocusLogicalGroupsFromRows(rows);
+
+    expect(groups.map((group) => group.turnIds)).toEqual([["a"], ["b", "c"]]);
+    expect(groups.map((group) => group.complete)).toEqual([true, false]);
+
+    const window = selectFocusTimelineWindow(groups, false);
+    expect(window.turnIds).toEqual(["a", "b", "c"]);
+    expect(window.groups).toHaveLength(2);
+
+    // C completing closes the same logical group; B/C then count as one.
+    const completed = buildFocusLogicalGroupsFromRows([
+      ...successTurn("a"),
+      ...interruptedTurn("b"),
+      header("c", "completedSuccess"),
+      user("c"),
+      assistant("c"),
+    ]);
+    expect(completed.map((group) => group.turnIds)).toEqual([["a"], ["b", "c"]]);
+    expect(completed.map((group) => group.complete)).toEqual([true, true]);
+  });
+
+  it("shows the latest two completed conversations when idle", () => {
+    const rows = [...successTurn("a"), ...successTurn("b"), ...successTurn("c")];
+    const groups = buildFocusLogicalGroupsFromRows(rows);
+
+    const latest = selectFocusTimelineWindow(groups, false);
+    expect(latest.turnIds).toEqual(["b", "c"]);
+  });
+
+  it("requires a real preceding boundary even when the leading turn has a header", () => {
