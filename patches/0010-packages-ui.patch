+/**
+ * composer-model-selection-intent 模块清单（architecture-governance managed 模块）。
+ * 层：ui。修改 requires 时同步更新 architecture-policy.yaml（检查器会校验两者一致）。
+ */
+export const composerModelSelectionIntentModule = {
+  id: "composer-model-selection-intent",
+  requires: ["shared", "ui"],
+  provides: ["composer-model-selection-intent"],
+  publicEntrypoints: ["index.ts"],
+} as const;
