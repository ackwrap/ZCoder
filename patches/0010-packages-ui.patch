+  DialogHeader: ({ children }: { children?: ReactNode }) => createElement("header", null, children),
+  DialogTitle: ({ children }: { children?: ReactNode }) => createElement("h2", null, children),
+}));
+
+vi.mock("@/app-shell/BackgroundBashOutputSidePane.js", () => ({
+  BackgroundBashOutputSidePane: ({
+    onOpenCodeViewer,
+  }: {
+    onOpenCodeViewer?: (source: { type: "file"; path: string; title: string }) => void;
+  }) =>
+    createElement(
+      "button",
+      {
+        type: "button",
+        onClick: () =>
+          onOpenCodeViewer?.({
+            type: "file",
+            path: "/tmp/output.txt",
+            title: "output.txt",
+          }),
+      },
+      "open-full-file",
+    ),
+}));
+
+const scope = {
+  sessionId: "session-1",
+  workspacePath: "/workspace",
+  workspaceIdentity: "ssh:a",
+  remoteSessionId: "remote-a",
+};
+
+function tab(overrides: Partial<BackgroundBashSidePaneTab> = {}): BackgroundBashSidePaneTab {
+  return {
+    id: "bash-output:session-1:work-1",
+    type: "bash-output",
+    workspacePath: "/workspace",
+    workspaceIdentity: "ssh:a",
+    remoteSessionId: "remote-a",
+    rootSessionId: "root",
+    sessionId: "session-1",
+    workId: "work-1",
+    title: "build",
+    workspaceKey: "ssh:a",
+    ownerTaskId: "session-1",
+    ...overrides,
+  };
+}
+
+afterEach(cleanup);
+
+describe("BackgroundBashOutputDialog 作用域", () => {
+  it("同一会话/工作区/remote 才渲染，切换作用域后不展示旧输出", () => {
+    const value = tab();
