+
+function parseCompactionTokenValue(
+  raw: string,
+  range: { min: number; max: number },
+): number | undefined {
+  const trimmed = raw.trim();
+  if (!/^\d+$/.test(trimmed)) {
+    return undefined;
+  }
+  const value = Number(trimmed);
+  return Number.isSafeInteger(value) && value >= range.min && value <= range.max
+    ? value
+    : undefined;
+}
+
+function CompactionTokenBudgetRow({
+  label,
+  description,
+  value,
+  range,
+  disabled,
+  testId,
+  onSave,
+}: {
+  label: string;
+  description: string;
+  value: number;
+  range: { min: number; max: number };
+  disabled?: boolean;
+  testId: string;
+  onSave: (value: number) => Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const [draft, setDraft] = useState(String(value));
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  // ref 在事件处理间同步生效，防止 blur/Enter 在同一帧内重复提交。
+  const pendingRef = useRef(false);
+
+  useEffect(() => {
+    setDraft(String(value));
+  }, [value]);
+
+  const commit = useCallback(async () => {
+    if (pendingRef.current || disabled) {
+      return;
+    }
+    const parsed = parseCompactionTokenValue(draft, range);
+    if (parsed === undefined) {
+      // 越界或非整数只停留在本地校验；不能把非法值提交给 Host。
+      setError(
+        intl.formatMessage(
+          { id: "settings.advanced.tokenRangeError" },
+          { min: String(range.min), max: String(range.max) },
+        ),
+      );
+      return;
+    }
+    if (parsed === value) {
+      setDraft(String(parsed));
+      setError(null);
+      return;
+    }
+
+    setPending(true);
+    pendingRef.current = true;
+    setError(null);
+    try {
+      await onSave(parsed);
+      setDraft(String(parsed));
+    } catch {
+      // 保存失败保留本地输入，用户修正后可直接重试。
+      setError(intl.formatMessage({ id: "settings.advanced.saveFailed" }));
+    } finally {
+      pendingRef.current = false;
+      setPending(false);
+    }
+  }, [disabled, draft, intl, onSave, range, value]);
+
+  return (
+    <SettingsRow
+      label={label}
+      description={description}
+      detail={
+        error ? (
+          <p role="alert" data-testid={`${testId}-error`} className="text-ui-sm text-destructive">
+            {error}
+          </p>
+        ) : null
+      }
+      control={
+        <Input
+          size="lg"
+          type="number"
+          inputMode="numeric"
+          min={range.min}
+          max={range.max}
+          step={1}
+          value={draft}
+          disabled={disabled || pending}
+          aria-label={label}
+          aria-invalid={Boolean(error)}
+          data-testid={testId}
+          className="w-full tabular-nums"
+          onChange={(event) => {
+            setDraft(event.currentTarget.value);
+          }}
+          onBlur={() => {
+            void commit();
+          }}
+          onKeyDown={(event) => {
+            if (event.key === "Enter") {
+              event.preventDefault();
+              void commit();
+            }
+          }}
+        />
+      }
+    />
+  );
+}
+
