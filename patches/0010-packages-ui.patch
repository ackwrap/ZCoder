+}));
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    locale: "en-US",
+    intl: { formatMessage: ({ id }: { id: string }) => id },
+  }),
+}));
+afterEach(cleanup);
+const git: GitRepositorySummary = {
+  workspacePath: "/repo",
+  repoRoot: "/repo",
+  workspaceInRepoPath: "",
+  autoRefreshWatchPaths: [],
+  branchName: "main",
+  trackingBranchName: null,
+  headRefType: "branch",
+  ahead: 0,
+  behind: 0,
+  isDirty: true,
+  isGitAvailable: true,
+  isRepository: true,
+};
+const usage = {
+  usedTokens: 32000,
+  maxTokens: 128000,
+  autoCompactThresholdTokens: 96000,
+  cache: { hitRate: 0.048 },
+  breakdown: [
+    { source: "mcp_tool_schemas" as const, chars: 3000 },
+    { source: "messages" as const, chars: 1000 },
+  ],
+};
+
+describe("SessionInspector", () => {
+  it("renders each card without an environment card", () => {
+    const { container } = render(
+      createElement(SessionInspector, { workspacePath: "/repo", gitSummary: git }),
+    );
+    expect(
+      [...container.querySelectorAll("[data-inspector-card]")].map((node) =>
+        node.getAttribute("data-inspector-card"),
+      ),
+    ).toEqual(["context", "connectors", "changes"]);
+  });
+  it("distinguishes missing Git data from unavailable Git and a non-repository", () => {
+    const { rerender } = render(createElement(SessionInspector, { workspacePath: "/files" }));
+    expect(screen.getByText("chat.inspector.gitPending")).toBeTruthy();
+    expect(screen.queryByText("chat.inspector.notRepository")).toBeNull();
+    rerender(
+      createElement(SessionInspector, {
+        workspacePath: "/files",
+        gitSummary: { ...git, isGitAvailable: false },
+      }),
+    );
+    expect(screen.getByText("git.empty.gitUnavailableTitle")).toBeTruthy();
+    expect(screen.queryByTestId("inspector-open-changes")).toBeNull();
+  });
+  it("keeps read-only information without branch mutation or commit controls", () => {
+    render(
+      createElement(SessionInspector, {
+        workspacePath: "/repo",
+        gitSummary: git,
+        readOnly: true,
+        onRefreshGit: vi.fn(),
+      }),
+    );
+    expect(screen.getByText("main")).toBeTruthy();
+    expect(screen.queryByText("commit-dialog")).toBeNull();
+    expect(screen.getByTestId("inspector-open-changes").hasAttribute("disabled")).toBe(true);
+  });
+  it("renders ordered cards, real usage and character shares without inventing per-source tokens", () => {
+    const { container } = render(
+      createElement(SessionInspector, {
+        workspacePath: "/repo",
+        usage,
+        selection: { provider: "p", model: "m" },
+        resources: createElement("div", null, "session resources"),
+      }),
+    );
+    expect(
+      [...container.querySelectorAll("[data-inspector-card]")].map((node) =>
+        node.getAttribute("data-inspector-card"),
+      ),
+    ).toEqual(["context", "connectors", "changes"]);
+    // 上下文与连接器默认折叠；展开后再断言真实内容。
+    const contextTrigger = screen.getByTestId("inspector-context-trigger");
+    const connectorsTrigger = screen.getByTestId("inspector-connectors-trigger");
+    expect(contextTrigger.getAttribute("aria-expanded")).toBe("false");
+    expect(connectorsTrigger.getAttribute("aria-expanded")).toBe("false");
+    fireEvent.click(contextTrigger);
+    fireEvent.click(connectorsTrigger);
+    expect(screen.getByTestId("inspector-context-usage").textContent).toContain("32K");
+    expect(screen.getByTestId("inspector-context-usage").textContent).toContain("25%");
+    expect(screen.getByTestId("inspector-context-breakdown").textContent).toContain("75%");
