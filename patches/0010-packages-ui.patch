@@ -0,0 +1,79 @@
+import { describe, expect, it, vi } from "vitest";
+import { DesktopCommandIds } from "@zcode/shared";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  buildIntegratedCompatSlashCommands,
+  type CompatSlashCommandIntegrationDeps,
+} from "./contract.js";
+
+function deps(): CompatSlashCommandIntegrationDeps {
+  return {
+    locale: "en-US",
+    rows: [],
+    contextWindow: null,
+    olderRowsAvailable: true,
+    notify: vi.fn(),
+    forkActionsEnabled: false,
+    snapshotRef: { current: null },
+    handleFork: vi.fn(),
+    isDesktop: false,
+    closeWindowCommand: DesktopCommandIds.CloseWindow,
+    platform: { executeDesktopCommand: vi.fn(async () => undefined) },
+    logger: { warn: vi.fn() },
+    cliSlashCommandNames: new Set(),
+  };
+}
+
+describe("compat integration admission", () => {
+  it("omits fork when denied and yields each exact CLI name", () => {
+    const input = deps();
+    input.cliSlashCommandNames = new Set(["copy", "exit"]);
+    expect(buildIntegratedCompatSlashCommands(input).map((c) => c.value)).toEqual([
+      "export",
+      "context",
+    ]);
+  });
+  it("resolves the current projected fork row at invocation and reuses callback", async () => {
+    const input = deps();
+    input.forkActionsEnabled = true;
+    const command = buildIntegratedCompatSlashCommands(input).find((c) => c.value === "fork")!;
+    input.snapshotRef = { current: { rows: { window: [] } } };
+    // The injected ref is stable in SessionPane; mutate its current value after registration.
+    const stable = deps();
+    stable.forkActionsEnabled = true;
+    const fork = buildIntegratedCompatSlashCommands(stable).find((c) => c.value === "fork")!;
+    (stable.snapshotRef as { current: unknown }).current = {
+      rows: {
+        window: [
+          {
+            kind: "assistantText",
+            rowId: "latest",
+            entityId: "e",
+            actions: { canFork: true },
+          } as unknown as ConversationRow,
+        ],
+      },
+    };
+    await fork.run();
+    expect(stable.handleFork).toHaveBeenCalledWith({ rowId: "latest", entityId: "e" });
+    await command.run();
+    expect(input.handleFork).not.toHaveBeenCalled();
+  });
+  it("does not close Web stubs and catches desktop close rejection", async () => {
+    const input = deps();
+    await buildIntegratedCompatSlashCommands(input)
+      .find((c) => c.value === "exit")!
+      .run();
+    expect(input.platform!.executeDesktopCommand).not.toHaveBeenCalled();
+    input.isDesktop = true;
+    const error = new Error("close failed");
+    input.platform!.executeDesktopCommand = vi.fn(async () => {
+      throw error;
+    });
+    await buildIntegratedCompatSlashCommands(input)
+      .find((c) => c.value === "exit")!
+      .run();
+    await Promise.resolve();
+    expect(input.logger.warn).toHaveBeenCalledWith("[v4-pane] 关闭窗口失败", { error });
+  });
+});
