+      expect(readCompleteTaskOutput(body, id, truncated)).toBeUndefined();
+  });
+  it("reads all snapshot bytes across a split Unicode character", async () => {
+    const bytes = new TextEncoder().encode(`${"a".repeat(262143)}😀${text}`);
+    const calls: number[] = [];
