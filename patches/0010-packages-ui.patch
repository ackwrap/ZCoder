@@ -0,0 +1,117 @@
+import type { WorkspaceSidePaneState, WorkspaceSidePaneTab } from "@/lib/workspaceSidePane.js";
+import { isFileViewerDirty } from "./fileViewerDirtyRegistry.js";
+import type {
+  FileViewerTab,
+  PlanDetailSidePaneTab,
+  SelectAgentViewerTabOptions,
+  SelectFileViewerTabOptions,
+  SelectPlanViewerTabOptions,
+  SubagentSessionSidePaneTab,
+  ViewerCategorySelectionPorts,
+} from "./types.js";
+import { getCodeViewerSourceWorkspaceKey, isPlainFileViewerSource } from "./viewerSource.js";
+
+function fileViewerTabWorkspaceKey(tab: FileViewerTab): string | undefined {
+  if (tab.workspaceKey?.trim()) return tab.workspaceKey.trim();
+  if (tab.type === "file-manager") {
+    return tab.target.workspaceIdentity?.trim() || tab.target.workspacePath;
+  }
+  return getCodeViewerSourceWorkspaceKey(tab.source);
+}
+
+export function isFileViewerTab(tab: WorkspaceSidePaneTab): tab is FileViewerTab {
+  return (
+    tab.type === "file-manager" ||
+    (tab.type === "code-viewer" && isPlainFileViewerSource(tab.source))
+  );
+}
+
+function matchesFileViewerScope(
+  tab: FileViewerTab,
+  workspaceKey: string | undefined,
+  ownerTaskId: string | null | undefined,
+  ports: ViewerCategorySelectionPorts,
+): boolean {
+  return (
+    ports.ownerKey(tab.ownerTaskId) === ports.ownerKey(ownerTaskId) &&
+    (fileViewerTabWorkspaceKey(tab) ?? "") === (workspaceKey ?? "")
+  );
+}
+
+/**
+ * 选择要复用的文件查看 tab。
+ *
+ * 同一 sourceKey 优先（重复点同一文件不改变内容）；否则 active 文件 tab 优先。
+ * active 文件 tab 有未保存草稿时不做跨对象复用——调用方会新建 tab，保留草稿现场。
+ * 没有 active 文件 tab 时取最近打开的非 dirty 文件 tab。
+ */
+export function selectFileViewerTab(
+  current: WorkspaceSidePaneState,
+  options: SelectFileViewerTabOptions,
+): FileViewerTab | undefined {
+  const isTabDirty = options.isTabDirty ?? isFileViewerDirty;
+  const candidates = current.tabs.filter(
+    (tab): tab is FileViewerTab =>
+      isFileViewerTab(tab) &&
+      matchesFileViewerScope(
+        tab,
+        options.workspaceKey,
+        options.ownerTaskId,
+        options.ports,
+      ),
+  );
+  if (candidates.length === 0) return undefined;
+
+  if (options.sourceKey != null) {
+    const sameSource = candidates.find(
+      (tab) => options.ports.tabSourceKey(tab) === options.sourceKey,
+    );
+    if (sameSource) return sameSource;
+  }
+
+  const active = candidates.find((tab) => tab.id === current.activeTabId);
+  if (active) {
+    return isTabDirty(active.id) ? undefined : active;
+  }
+
+  let selected: FileViewerTab | undefined;
+  for (const tab of candidates) {
+    if (isTabDirty(tab.id)) continue;
+    if (!selected || (tab.openedAt ?? 0) >= (selected.openedAt ?? 0)) selected = tab;
+  }
+  return selected;
+}
+
+export function selectAgentViewerTab(
+  current: WorkspaceSidePaneState,
+  options: SelectAgentViewerTabOptions,
+): SubagentSessionSidePaneTab | undefined {
+  const candidates = current.tabs.filter(
+    (tab): tab is SubagentSessionSidePaneTab =>
+      tab.type === "subagent-session" &&
+      tab.workspaceKey === options.workspaceKey &&
+      tab.rootSessionId === options.rootSessionId,
+  );
+  if (candidates.length === 0) return undefined;
+  return (
+    candidates.find((tab) => tab.id === current.activeTabId) ??
+    candidates.reduce((latest, tab) => ((tab.openedAt ?? 0) >= (latest.openedAt ?? 0) ? tab : latest))
+  );
+}
+
+export function selectPlanViewerTab(
+  current: WorkspaceSidePaneState,
+  options: SelectPlanViewerTabOptions,
+): PlanDetailSidePaneTab | undefined {
+  const candidates = current.tabs.filter(
+    (tab): tab is PlanDetailSidePaneTab =>
+      tab.type === "plan-detail" &&
+      tab.workspaceKey === options.workspaceKey &&
+      tab.parentSessionId === options.parentSessionId,
+  );
+  if (candidates.length === 0) return undefined;
+  return (
+    candidates.find((tab) => tab.id === current.activeTabId) ??
+    candidates.reduce((latest, tab) => ((tab.openedAt ?? 0) >= (latest.openedAt ?? 0) ? tab : latest))
+  );
+}
