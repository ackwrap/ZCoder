index 0000000000000000000000000000000000000000..c211e911049504270b0533a98cbd53a4ba3cecfd
--- /dev/null
+++ b/packages/ui/src/app-shell/GodSidePane.tsx
@@ -0,0 +1,207 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import type { GodFlowAssignmentView, GodFlowView } from "@zcode/shared/zcode-protocol-v4";
+import { GodFlowDiagram } from "@/app-shell/GodFlowDiagram.js";
+import { useWorkspaceServicesResolution } from "@/hooks/useWorkspaceServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { GodSidePaneTab, OpenScopedSubagentSideTabRequest } from "@/lib/workspaceSidePane.js";
+import { V4PaneConversationProvider, useV4Conversation } from "@/v4/V4ConversationContext.js";
+
+type OpenSubagentSession = (request: OpenScopedSubagentSideTabRequest) => void;
+type Role = GodFlowAssignmentView["role"];
+
+export function GodSidePane({ tab, visible, onOpenSubagentSession }: {
+  tab: GodSidePaneTab;
+  visible: boolean;
+  onOpenSubagentSession?: OpenSubagentSession | undefined;
+}) {
+  const { intl } = useZCodeIntl();
+  const scope = useMemo(() => ({
+    workspacePath: tab.workspacePath,
+    ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+    ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+  }), [tab.workspacePath, tab.workspaceIdentity, tab.remoteSessionId]);
+  if (!visible) return null;
+  return <V4PaneConversationProvider scope={scope} unavailableFallback={<p className="p-4 text-ui-sm text-foreground-subtle">{intl.formatMessage({ id: "sidePane.god.unavailable" })}</p>}>
+    <GodSidePaneContents tab={tab} visible={visible} onOpenSubagentSession={onOpenSubagentSession} />
+  </V4PaneConversationProvider>;
+}
+
+type Load = { key: string; status: "loading" | "ready" | "error"; flow: GodFlowView | null; resident?: boolean };
+type OpenStatus = { key: string; status: "opening" | "failed" | "unavailable" } | null;
+
+function GodSidePaneContents({ tab, visible, onOpenSubagentSession }: {
+  tab: GodSidePaneTab;
+  visible: boolean;
+  onOpenSubagentSession?: OpenSubagentSession | undefined;
+}) {
+  const { services, rpcReady } = useWorkspaceServicesResolution(tab.workspacePath, tab.remoteSessionId, tab.workspaceIdentity);
+  const { layer, onRuntimeRestart, onRuntimeLifecycle } = useV4Conversation();
+  const [generation, setGeneration] = useState(0);
+  const [runtimeAvailable, setRuntimeAvailable] = useState(true);
+  const [flowAnimationEnabled, setFlowAnimationEnabled] = useState(true);
+  useEffect(() => {
+    if (!visible) return;
+    setRuntimeAvailable(true);
+    const restart = onRuntimeRestart(() => {
+      openRequestRef.current.version += 1;
+      setGeneration((value) => value + 1);
+    });
+    const lifecycle = onRuntimeLifecycle?.((state) => {
+      openRequestRef.current.version += 1;
+      setRuntimeAvailable(state === "available");
+      setGeneration((value) => value + 1);
+    });
+    return () => { restart(); lifecycle?.(); };
+  }, [visible, onRuntimeRestart, onRuntimeLifecycle]);
+  useEffect(() => {
+    if (!visible || !tab.parentSessionId) return;
+    const lease = layer.acquire(tab.parentSessionId);
+    return () => lease.release();
+  }, [layer, visible, tab.parentSessionId]);
+  const { intl } = useZCodeIntl();
+  const key = JSON.stringify([tab.workspaceKey, tab.workspacePath, tab.workspaceIdentity, tab.remoteSessionId, tab.parentSessionId]);
+  const [load, setLoad] = useState<Load>({ key, status: "loading", flow: null });
+  const text = (id: string) => intl.formatMessage({ id: `sidePane.god.${id}` });
+  const openKey = JSON.stringify([key, generation, visible, rpcReady, runtimeAvailable]);
+  const openRequestRef = useRef({ key: openKey, version: 0, inFlight: false, mounted: false });
+  if (openRequestRef.current.key !== openKey) {
+    openRequestRef.current = { key: openKey, version: openRequestRef.current.version + 1, inFlight: false, mounted: openRequestRef.current.mounted };
+  }
+  const [openStatus, setOpenStatus] = useState<OpenStatus>(null);
+  useEffect(() => {
+    openRequestRef.current.mounted = true;
+    return () => {
+      openRequestRef.current.mounted = false;
+      openRequestRef.current.version += 1;
+    };
+  }, []);
+
+  const openRole = async (role: Role) => {
+    const request = openRequestRef.current;
+    if (!onOpenSubagentSession || !visible || !rpcReady || !runtimeAvailable || !tab.parentSessionId || request.inFlight) return;
+    request.inFlight = true;
+    const version = ++request.version;
+    const valid = () => openRequestRef.current === request && request.mounted && request.version === version;
+    setOpenStatus({ key: openKey, status: "opening" });
+    try {
+      const target = `god-${role}`;
+      let cursor: string | undefined;
+      const seenCursors = new Set<string>();
+      let item: { childSessionId: string; subagentType: string } | undefined;
+      do {
+        const result = await services.zcodeAgentService.listSessionSubagents({
+          workspacePath: tab.workspacePath,
+          ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+          ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+          sessionId: tab.parentSessionId,
+          endedLimit: 100,
+          ...(cursor ? { endedCursor: cursor } : {}),
+        });
+        if (!valid()) return;
+        item = result.running.filter((entry) => entry.subagentType === target)
+          .sort((left, right) => (right.startedAt ?? 0) - (left.startedAt ?? 0))[0]
+          ?? result.ended.items.find((entry) => entry.subagentType === target);
+        if (item) break;
+        cursor = result.ended.nextCursor;
+        if (cursor && seenCursors.has(cursor)) throw new Error("Repeated subagent cursor");
+        if (cursor) seenCursors.add(cursor);
+      } while (cursor);
+      if (!valid()) return;
+      if (!item) {
+        setOpenStatus({ key: openKey, status: "unavailable" });
+        return;
+      }
+      onOpenSubagentSession({
+        workspacePath: tab.workspacePath,
+        ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+        ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+        rootSessionId: tab.parentSessionId,
+        parentSessionId: tab.parentSessionId,
+        childSessionId: item.childSessionId,
+        subagentType: item.subagentType,
+        title: text(role),
+      });
+      setOpenStatus(null);
+    } catch {
+      if (valid()) setOpenStatus({ key: openKey, status: "failed" });
+    } finally {
+      request.inFlight = false;
+    }
+  };
+
+  useEffect(() => {
+    let alive = true;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let inFlight = false;
+    const refresh = async () => {
+      if (!alive || inFlight || document.visibilityState === "hidden") return;
+      inFlight = true;
+      try {
+        const result = await services.zcodeAgentService.conversationGodFlowV4({
+          workspacePath: tab.workspacePath,
+          ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+          ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+          sessionId: tab.parentSessionId,
+        });
+        if (alive && document.visibilityState !== "hidden") setLoad({ key, status: "ready", flow: result.flow, resident: result.resident });
+      } catch {
+        if (alive && document.visibilityState !== "hidden") setLoad({ key, status: "error", flow: null });
+      } finally {
+        inFlight = false;
+        if (alive) timer = setTimeout(refresh, 3000);
+      }
+    };
+    const onVisibility = () => {
+      if (document.visibilityState === "visible") {
+        if (inFlight) return;
+        setLoad({ key, status: "loading", flow: null });
+        if (timer) clearTimeout(timer);
+        void refresh();
+      } else {
+        setLoad({ key, status: "loading", flow: null });
+      }
+    };
+    if (visible && rpcReady && runtimeAvailable && tab.parentSessionId) {
+      setLoad({ key, status: "loading", flow: null });
+      document.addEventListener("visibilitychange", onVisibility);
+      void refresh();
+    } else {
+      setLoad({ key, status: rpcReady && runtimeAvailable ? "ready" : "error", flow: null });
+    }
+    return () => {
+      alive = false;
+      if (timer) clearTimeout(timer);
+      document.removeEventListener("visibilitychange", onVisibility);
+    };
+  }, [key, generation, visible, rpcReady, runtimeAvailable, services, tab.workspacePath, tab.workspaceIdentity, tab.remoteSessionId, tab.parentSessionId]);
+
+  const current: Load = !rpcReady || !runtimeAvailable
+    ? { key, status: "error", flow: null }
+    : load.key === key ? load : { key, status: "loading", flow: null };
+  const flow = current.flow;
+  return <div className="h-full overflow-auto p-4">
+    <div className="mb-3 flex items-center justify-between gap-2">
+      <h2 className="font-medium text-foreground">{text("title")}</h2>
+      {flow && <span className="text-ui-sm text-foreground-subtle">{intl.formatMessage({ id: "sidePane.god.revision" }, { revision: flow.revision })}</span>}
+    </div>
+    {openStatus?.key === openKey && <p role="status" className="mb-3 text-ui-sm text-foreground-subtle">{text(openStatus.status === "opening" ? "openingAgent" : openStatus.status === "failed" ? "openAgentFailed" : "agentUnavailable")}</p>}
+    {current.status === "loading" ? <p className="text-ui-sm text-foreground-subtle">{text("loading")}</p>
+      : current.status === "error" ? <div role="status" className="space-y-2 text-ui-sm text-foreground-subtle">
+        <p>{text("unavailable")}</p>
+        {rpcReady && runtimeAvailable && <button type="button" className="rounded border border-border px-2 py-1 text-foreground hover:bg-surface-hover" onClick={() => setGeneration((value) => value + 1)}>{text("retryRead")}</button>}
+      </div>
+      : !flow ? <p className="text-ui-sm text-foreground-subtle">{text("empty")}</p>
+      : <>
+        <p className="mb-2 text-ui-sm font-medium text-foreground">{text("stage")}: {text(`stage.${flow.stage}`)}</p>
+        <p className="mb-3 text-ui-sm text-foreground-subtle">{current.resident ? text("snapshot") : text("inactive")}</p>
+        {flow.reason && <p className="mb-3 whitespace-pre-wrap break-words text-ui-sm text-foreground-subtle">{text("reason")}: {flow.reason}</p>}
+        <div className="mb-3 flex flex-wrap items-center justify-between gap-2 text-ui-sm text-foreground-subtle">
+          <span>{text("animationHint")}</span>
+          <button type="button" aria-pressed={flowAnimationEnabled} className="rounded border border-border px-2 py-1 text-foreground hover:bg-surface-hover" onClick={() => setFlowAnimationEnabled((enabled) => !enabled)}>
+            {text(flowAnimationEnabled ? "pauseAnimation" : "resumeAnimation")}
+          </button>
+        </div>
+        <GodFlowDiagram key={JSON.stringify([key, flow.flowId, flow.revision])} flow={flow} resident={Boolean(current.resident)} reducedMotion={!flowAnimationEnabled} onOpenRole={onOpenSubagentSession ? (role) => void openRole(role) : undefined} />
+      </>}
+  </div>;
+}
