+      workspaceKey: "/workspace",
+    });
+    const tabId = first.activeTabId;
+
+    const second = openCodeViewerSidePane(first, fileSource("/workspace/b.md"), "owner", {
+      workspaceKey: "/workspace",
+    });
+
+    expect(second.tabs).toHaveLength(1);
+    expect(second.activeTabId).toBe(tabId);
+    expect(getActiveSidePaneTab(second)).toMatchObject({
+      type: "code-viewer",
+      source: { path: "/workspace/b.md" },
+    });
+  });
+
+  it("shares one file viewer tab between the directory pane and file previews", () => {
+    const directory = openFileManagerSidePane(
+      null,
+      { workspacePath: "/workspace" },
+      "owner",
+      { workspaceKey: "/workspace" },
+    );
+    const tabId = directory.activeTabId;
+
+    const file = openCodeViewerSidePane(directory, fileSource("/workspace/a.md"), "owner", {
+      workspaceKey: "/workspace",
+    });
+    expect(file.tabs).toHaveLength(1);
+    expect(file.activeTabId).toBe(tabId);
+    expect(getActiveSidePaneTab(file)).toMatchObject({
+      type: "file-manager",
+      source: { path: "/workspace/a.md" },
+    });
+
+    const directoryAgain = openFileManagerSidePane(
+      file,
+      { workspacePath: "/workspace" },
+      "owner",
+      { workspaceKey: "/workspace" },
+    );
+    expect(directoryAgain.tabs).toHaveLength(1);
+    expect(directoryAgain.activeTabId).toBe(tabId);
+    expect(getActiveSidePaneTab(directoryAgain)).toMatchObject({
+      type: "file-manager",
+      target: { workspacePath: "/workspace" },
+      source: { path: "/workspace/a.md" },
+    });
+  });
+
+  it("replaces only the active file viewer and keeps other historical file tabs", () => {
