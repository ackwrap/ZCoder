index 0000000000000000000000000000000000000000..2501d7dda334f748f2209a3ccd42b9fb08e0a0f8
--- /dev/null
+++ b/packages/ui/src/v4/composer/model-selection-intent/store.ts
@@ -0,0 +1,183 @@
+import { logger } from "@/logger.js";
+import { modelSelectionSchema, type ModelSelection } from "@zcode/shared";
+import type {
+  ModelSelectionIntentRecord,
+  ModelSelectionIntentScope,
+  ModelSelectionIntentState,
+} from "./contract.js";
+
+// 与正文草稿分库：空白 Composer 的显式模型选择也必须跨重挂/重启保留。
+// Root 草稿没有 sessionId，由调用方传 null 直接排除，继续走 Recent/正文草稿语义。
+const STORAGE_KEY_PREFIX = "zcode-v4-composer-model-intent:v1:";
+const warnedStorageKeys = new Set<string>();
+
+export function resolveModelSelectionIntentScope(
+  workspacePath: string,
+  workspaceIdentity: string | undefined,
+  sessionId: string | null,
+): ModelSelectionIntentScope | null {
+  const normalizedSessionId = sessionId?.trim();
+  if (!normalizedSessionId) return null;
+  const normalizedIdentity = workspaceIdentity?.trim();
+  return {
+    workspacePath,
+    ...(normalizedIdentity ? { workspaceIdentity: normalizedIdentity } : {}),
+    sessionId: normalizedSessionId,
+  };
+}
+
+function intentStorageKey(scope: ModelSelectionIntentScope): string {
+  return `${STORAGE_KEY_PREFIX}${JSON.stringify([
+    scope.workspaceIdentity?.trim() || scope.workspacePath,
+    scope.sessionId,
+  ])}`;
+}
+
+function warnStorageFailure(key: string, error: unknown): void {
+  if (warnedStorageKeys.has(key)) return;
+  warnedStorageKeys.add(key);
+  logger.warn("[composer-model-intent] 模型意图持久化访问失败", {
+    error: error instanceof Error ? error.message : String(error),
+    key,
+  });
+}
+
+function getStorage(): Storage | null {
+  if (typeof window === "undefined") return null;
+  try {
+    return window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isIntentState(value: unknown): value is ModelSelectionIntentState {
+  return value === "pending" || value === "confirmed";
+}
+
+function readRecord(scope: ModelSelectionIntentScope): ModelSelectionIntentRecord | null {
+  const key = intentStorageKey(scope);
+  try {
+    const raw = getStorage()?.getItem(key);
+    if (!raw) return null;
+    const parsed: unknown = JSON.parse(raw);
+    if (!isRecord(parsed) || typeof parsed.version !== "string" || !parsed.version) return null;
+    if (!isIntentState(parsed.state)) return null;
+    const selection = modelSelectionSchema.safeParse(parsed.selection);
+    if (!selection.success) return null;
+    return {
+      version: parsed.version,
+      state: parsed.state,
+      selection: selection.data,
+    };
+  } catch (error) {
+    warnStorageFailure(key, error);
+    return null;
+  }
+}
+
+function writeRecord(
+  scope: ModelSelectionIntentScope,
+  record: ModelSelectionIntentRecord,
+): boolean {
+  const key = intentStorageKey(scope);
+  const storage = getStorage();
+  if (!storage) return false;
+  try {
+    storage.setItem(key, JSON.stringify(record));
+    warnedStorageKeys.delete(key);
+    return true;
+  } catch (error) {
+    warnStorageFailure(key, error);
+    return false;
+  }
+}
+
+export function readModelSelectionIntent(
+  scope: ModelSelectionIntentScope,
+): ModelSelectionIntentRecord | null {
+  return readRecord(scope);
+}
+
+export function sameModelSelection(a: ModelSelection, b: ModelSelection): boolean {
+  return (
+    a.providerId === b.providerId &&
+    a.modelId === b.modelId &&
+    a.options?.reasoningLevel === b.options?.reasoningLevel
+  );
+}
+
+/** 用户显式选择：总是以新版本覆盖旧意图；若此刻快照已相同，直接记为已确认副本。 */
+export function recordModelSelectionIntent(
+  scope: ModelSelectionIntentScope,
+  selection: ModelSelection,
+  options?: { snapshotSelection?: ModelSelection | null },
+): ModelSelectionIntentRecord | null {
+  const parsed = modelSelectionSchema.safeParse(selection);
+  if (!parsed.success) return null;
+  const snapshotSelection = options?.snapshotSelection;
+  const record: ModelSelectionIntentRecord = {
+    version: nextIntentVersion(),
+    state:
+      snapshotSelection && sameModelSelection(parsed.data, snapshotSelection)
+        ? "confirmed"
+        : "pending",
+    selection: parsed.data,
+  };
+  return writeRecord(scope, record) ? record : null;
+}
+
+/**
+ * 提交被接纳：仅当当前意图仍是发起该提交时的 pending 版本才写入。
+ * 旧实例、旧 ACK 或期间的新手选都会因版本不符而放弃，不会跨窗口覆盖新意图。
+ */
+export function acceptModelSelectionIntent(
+  scope: ModelSelectionIntentScope,
+  selection: ModelSelection,
+  expectedVersion: string,
+  snapshotSelection: ModelSelection | null,
+): ModelSelectionIntentRecord | null {
+  const current = readRecord(scope);
+  if (!current || current.state !== "pending" || current.version !== expectedVersion) return null;
+  const parsed = modelSelectionSchema.safeParse(selection);
+  if (!parsed.success) return null;
+  const record: ModelSelectionIntentRecord = {
+    version: current.version,
+    state:
+      snapshotSelection && sameModelSelection(parsed.data, snapshotSelection)
+        ? "confirmed"
+        : "pending",
+    selection: parsed.data,
+  };
+  return writeRecord(scope, record) ? record : null;
+}
+
+/**
+ * 权威投影与 pending 意图一致：保留版本，改为 confirmed 副本。
+ * 不删除记录，后续重挂载才能区分“已确认副本”和“未发送显式意图”。
+ */
+export function confirmModelSelectionIntent(
+  scope: ModelSelectionIntentScope,
+  snapshotSelection: ModelSelection,
+  expectedVersion: string,
+): ModelSelectionIntentRecord | null {
+  const current = readRecord(scope);
+  if (!current || current.state !== "pending" || current.version !== expectedVersion) return null;
+  if (!sameModelSelection(current.selection, snapshotSelection)) return null;
+  const record: ModelSelectionIntentRecord = {
+    version: current.version,
+    state: "confirmed",
+    selection: snapshotSelection,
+  };
+  return writeRecord(scope, record) ? record : null;
+}
+
+function nextIntentVersion(): string {
+  const cryptoApi = globalThis.crypto;
+  if (cryptoApi && typeof cryptoApi.randomUUID === "function") return cryptoApi.randomUUID();
+  return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
+}
