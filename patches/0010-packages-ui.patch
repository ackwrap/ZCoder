@@ -0,0 +1,36 @@
+import type { ComponentType, ReactNode } from "react";
+import { StatusCapsuleCompactContext } from "@/v4/status-capsule/StatusCapsuleContext.js";
+import type { SidePaneCapsuleScopeProps } from "@/v4/status-capsule/contract.js";
+
+export function StatusCapsuleProvider({
+  compact,
+  children,
+}: {
+  compact: boolean;
+  children: ReactNode;
+}) {
+  return (
+    <StatusCapsuleCompactContext.Provider value={compact}>
+      {children}
+    </StatusCapsuleCompactContext.Provider>
+  );
+}
+
+// Create the wrapper at module scope to preserve the conversation's identity.
+export function withSidePaneCapsuleScope<P extends object>(
+  Component: ComponentType<P>,
+): ComponentType<P & SidePaneCapsuleScopeProps> {
+  function SidePaneCapsuleScoped(props: P & SidePaneCapsuleScopeProps) {
+    const { sidePaneOpen, ...componentProps } = props;
+    return (
+      <StatusCapsuleProvider compact={sidePaneOpen}>
+        <Component {...(componentProps as P)} />
+      </StatusCapsuleProvider>
+    );
+  }
+  const Scoped: ComponentType<P & SidePaneCapsuleScopeProps> = SidePaneCapsuleScoped;
+  Scoped.displayName = `withSidePaneCapsuleScope(${
+    Component.displayName ?? Component.name ?? "Component"
+  })`;
+  return Scoped;
+}
