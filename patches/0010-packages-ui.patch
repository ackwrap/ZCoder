@@ -0,0 +1,74 @@
+import { useEffect, useState } from "react";
+import { hostSupportsModelSystemPromptReplacement } from "@zcode/shared/zcode-protocol-v4";
+import { ensureAgentV4ConnectionHandshake } from "@/v4/agentV4ConnectionHandshake.js";
+
+type HostHandshakeService = Parameters<typeof ensureAgentV4ConnectionHandshake>[0];
+
+const supportByService = new WeakMap<object, boolean>();
+const listenersByService = new WeakMap<object, Set<() => void>>();
+
+function serviceKey(service: HostHandshakeService | null | undefined): object | null {
+  return service ?? null;
+}
+
+/** 同步读取当前 host 是否声明接受 Submission 的自定义系统 Agent 提示词字段；未知按 false。 */
+export function getModelSystemPromptHostSupport(
+  service: HostHandshakeService | null | undefined,
+): boolean {
+  const key = serviceKey(service);
+  return key ? supportByService.get(key) === true : false;
+}
+
+/**
+ * 复用既有 hello 握手声明（`capabilities.modelSystemPromptReplacement`）。旧 Host 只有
+ * `modelSystemPrompt`（append 语义）或缺失新位时返回 false，调用方必须隐藏入口并完全
+ * 省略两个 Submission 字段，不能发送显式 false 让旧 schema 失败。
+ */
+export function ensureModelSystemPromptHostSupport(
+  service: HostHandshakeService | null | undefined,
+): Promise<boolean> {
+  if (!service) return Promise.resolve(false);
+  const key = service;
+  const known = supportByService.get(key);
+  if (known !== undefined) return Promise.resolve(known);
+  return ensureAgentV4ConnectionHandshake(service)
+    .then((hello) => {
+      const supported = hostSupportsModelSystemPromptReplacement(hello.capabilities);
+      supportByService.set(key, supported);
+      for (const listener of listenersByService.get(key) ?? []) listener();
+      return supported;
+    })
+    .catch(() => false);
+}
+
+/** React 消费面：未知/握手失败按不支持处理，避免对旧 Host 假启用。 */
+export function useModelSystemPromptHostSupport(
+  service: HostHandshakeService | null | undefined,
+): boolean {
+  const [supported, setSupported] = useState(() => getModelSystemPromptHostSupport(service));
+
+  useEffect(() => {
+    let current = true;
+    const key = serviceKey(service);
+    const notify = () => {
+      if (current) setSupported(getModelSystemPromptHostSupport(service));
+    };
+    if (key) {
+      const listeners = listenersByService.get(key) ?? new Set<() => void>();
+      listeners.add(notify);
+      listenersByService.set(key, listeners);
+    }
+    void ensureModelSystemPromptHostSupport(service).then((value) => {
+      if (current) setSupported(value);
+    });
+    return () => {
+      current = false;
+      if (!key) return;
+      const listeners = listenersByService.get(key);
+      listeners?.delete(notify);
+      if (listeners && listeners.size === 0) listenersByService.delete(key);
+    };
+  }, [service]);
+
+  return supported;
+}
