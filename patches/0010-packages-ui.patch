+import { describe, expect, it } from "vitest";
+import { sidePaneViewerTabsExample } from "./contract.example.js";
+import {
+  clearFileViewerDirty,
+  getFileViewerDirtyVersion,
+  isFileViewerDirty,
+  setFileViewerDirty,
+  subscribeFileViewerDirty,
+} from "./contract.js";
+
+describe("side pane viewer tabs contract", () => {
+  it("accepts a workspace-scoped open option", () => {
+    expect(sidePaneViewerTabsExample.workspaceKey).toBe("/workspace");
+    expect(sidePaneViewerTabsExample.forceNewViewerTab).toBe(false);
+  });
+
+  it("notifies subscribers only when a file viewer dirty value changes", () => {
+    const tabId = "contract-file-viewer-dirty";
+    let notifications = 0;
+    const unsubscribe = subscribeFileViewerDirty(() => {
+      notifications += 1;
+    });
+    const before = getFileViewerDirtyVersion();
+
+    setFileViewerDirty(tabId, true);
+    expect(isFileViewerDirty(tabId)).toBe(true);
+    expect(getFileViewerDirtyVersion()).toBeGreaterThan(before);
+    expect(notifications).toBe(1);
+
+    setFileViewerDirty(tabId, true);
+    expect(notifications).toBe(1);
+
+    clearFileViewerDirty(tabId);
+    expect(isFileViewerDirty(tabId)).toBe(false);
+    expect(notifications).toBe(2);
+
+    unsubscribe();
+  });
+});
