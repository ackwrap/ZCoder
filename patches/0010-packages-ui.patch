index 0000000000000000000000000000000000000000..21868a966d50d513621787dc3b9980379336f6ba
--- /dev/null
+++ b/packages/ui/src/v4/command-output-file-preview/CommandOutputFilePreviewDialog.tsx
@@ -0,0 +1,129 @@
+import { memo, useMemo } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog.js";
+import { PreviewPane } from "@/PreviewPane.js";
+import type { CodeViewerSource } from "@/lib/codeViewer.js";
+
+export interface CommandOutputPreviewScope {
+  sessionId: string | null;
+  workspacePath: string;
+  workspaceIdentity?: string;
+  remoteSessionId?: string;
+}
+
+export interface CommandOutputPreviewRequest {
+  path: string;
+  title: string;
+  /**
+   * 打开时的作用域键。切换会话/工作区后即使请求还在 state 里也不能读取另一个
+   * Host 的同名路径；组件内再校验一次，effect 清空只是常规路径。
+   */
+  scopeKey: string;
+}
+
+/**
+ * 作用域键必须逐项包含 session / path / identity / remote；不能退化成 identity || path。
+ */
+export function commandOutputPreviewScopeKey(scope: CommandOutputPreviewScope): string {
+  return JSON.stringify([
+    scope.sessionId ?? null,
+    scope.workspacePath,
+    scope.workspaceIdentity?.trim() ?? null,
+    scope.remoteSessionId?.trim() ?? null,
+  ]);
+}
+
+// 官方 Bash 输出布局：<tmp>/zcode-bash-<随机标识>/<session>/<tool>-stdout.log。
+// 只认这个根目录 + stdout/stderr 文件名，避免把任意 .log 或同名源码误判成命令输出。
+const BASH_OUTPUT_ROOT_PATTERN = /^zcode-bash-[^/\\]+$/i;
+const BASH_OUTPUT_FILE_PATTERN = /-(?:stdout|stderr)\.log$/i;
+
+export function isCommandOutputLogPath(path: string | null | undefined): boolean {
+  if (typeof path !== "string") return false;
+  const normalized = path.trim().replace(/\\/g, "/");
+  if (!normalized) return false;
+  const parts = normalized.split("/").filter(Boolean);
+  if (parts.length < 3) return false;
+  const file = parts.pop();
+  const session = parts.pop();
+  const root = parts.pop();
+  return Boolean(
+    file &&
+    session &&
+    root &&
+    BASH_OUTPUT_FILE_PATTERN.test(file) &&
+    BASH_OUTPUT_ROOT_PATTERN.test(root),
+  );
+}
+
+export type ReadPreviewTarget = "command-output-dialog" | "code-viewer" | null;
+
+/**
+ * Read 卡片的单一分派规则：普通文件保持既有 code viewer；只有官方的命令输出日志
+ * 且宿主提供弹窗入口时才改走弹窗。没有弹窗入口时回退既有 viewer，行为不退化。
+ */
+export function resolveReadPreviewTarget(input: {
+  entryType: "file" | "directory";
+  path: string;
+  hasCommandOutputPreview: boolean;
+  hasCodeViewer: boolean;
+}): ReadPreviewTarget {
+  if (input.entryType !== "file") return null;
+  if (isCommandOutputLogPath(input.path)) {
+    if (input.hasCommandOutputPreview) return "command-output-dialog";
+    return input.hasCodeViewer ? "code-viewer" : null;
+  }
+  return input.hasCodeViewer ? "code-viewer" : null;
+}
+
+/**
+ * 命令输出文件预览弹窗。复用既有 PreviewPane 的文件读取、错误与在线状态；
+ * 不新建读取/授权链路，也不打开右侧栏。
+ */
+export const CommandOutputFilePreviewDialog = memo(function CommandOutputFilePreviewDialog({
+  request,
+  scope,
+  onDismiss,
+}: {
+  request: CommandOutputPreviewRequest | null;
+  scope: CommandOutputPreviewScope;
+  onDismiss: () => void;
+}) {
+  const scopeKey = commandOutputPreviewScopeKey(scope);
+  const active = request && request.scopeKey === scopeKey ? request : null;
+  const source = useMemo<CodeViewerSource | null>(() => {
+    if (!active) return null;
+    return {
+      type: "file",
+      title: active.title,
+      path: active.path,
+      workspacePath: scope.workspacePath,
+      ...(scope.workspaceIdentity ? { workspaceIdentity: scope.workspaceIdentity } : {}),
+      ...(scope.remoteSessionId ? { workspaceRemoteSessionId: scope.remoteSessionId } : {}),
+    };
+  }, [active, scope.remoteSessionId, scope.workspaceIdentity, scope.workspacePath]);
+
+  return (
+    <Dialog
+      open={active !== null}
+      onOpenChange={(open) => {
+        if (!open) onDismiss();
+      }}
+    >
+      <DialogContent
+        data-testid="command-output-file-preview-dialog"
+        className="flex h-[min(80vh,720px)] max-w-4xl flex-col gap-0 overflow-hidden p-0"
+      >
+        <DialogHeader className="border-b border-border px-4 py-3 pr-12 text-left">
+          <DialogTitle className="truncate text-ui-base" title={active?.path}>
+            {active?.title ?? ""}
+          </DialogTitle>
+        </DialogHeader>
+        <div className="min-h-0 flex-1">
+          {source ? (
+            <PreviewPane source={source} onClose={onDismiss} workspacePath={scope.workspacePath} />
+          ) : null}
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+});
