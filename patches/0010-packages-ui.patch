+import { forwardRef, useId, type ButtonHTMLAttributes } from "react";
+
+export const StatusCapsuleButton = forwardRef<
+  HTMLButtonElement,
+  ButtonHTMLAttributes<HTMLButtonElement>
+>(function StatusCapsuleButton({ children, "aria-describedby": describedBy, ...props }, ref) {
+  const summaryId = useId();
+  return (
+    <button
+      {...props}
+      ref={ref}
+      aria-describedby={[describedBy, summaryId].filter(Boolean).join(" ")}
+    >
+      <span id={summaryId} className="contents">
+        {children}
+      </span>
+    </button>
+  );
+});
