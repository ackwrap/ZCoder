index 0000000000000000000000000000000000000000..bafec379f14f8c8398354bbf29f8054e37cf1f39
--- /dev/null
+++ b/packages/ui/src/v4/composer/model-selection-intent/contract.example.ts
@@ -0,0 +1,51 @@
+/**
+ * composer-model-selection-intent 标准调用示例：
+ * 用户手选 B → 写 pending；快照确认 B → 转 confirmed；ACCEPT 只条件写回自己消费的版本。
+ */
+import {
+  acceptModelSelectionIntent,
+  confirmModelSelectionIntent,
+  recordModelSelectionIntent,
+  resolveModelSelectionIntentScope,
+  type ModelSelection,
+} from "./index.js";
+
+export function exampleComposerModelSelectionIntent(input: {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  sessionId: string | null;
+  selected: ModelSelection;
+  snapshotSelection: ModelSelection | null;
+}): { pendingVersion: string | null; confirmed: boolean } {
+  const scope = resolveModelSelectionIntentScope(
+    input.workspacePath,
+    input.workspaceIdentity,
+    input.sessionId,
+  );
+  if (!scope) return { pendingVersion: null, confirmed: false };
+
+  const recorded = recordModelSelectionIntent(scope, input.selected, {
+    snapshotSelection: input.snapshotSelection,
+  });
+  if (!recorded || recorded.state !== "pending") {
+    return { pendingVersion: null, confirmed: recorded?.state === "confirmed" };
+  }
+
+  // 提交被接纳时用发起时冻结的 version 条件写回；快照已一致则直接 confirmed。
+  const accepted = acceptModelSelectionIntent(
+    scope,
+    input.selected,
+    recorded.version,
+    input.snapshotSelection,
+  );
+  if (accepted?.state === "confirmed") return { pendingVersion: null, confirmed: true };
+
+  // 快照后到：仅当仍是同一 pending 版本且选择一致时收敛。
+  const confirmed = input.snapshotSelection
+    ? confirmModelSelectionIntent(scope, input.snapshotSelection, recorded.version)
+    : null;
+  return {
+    pendingVersion: confirmed ? null : recorded.version,
+    confirmed: confirmed?.state === "confirmed",
+  };
+}
