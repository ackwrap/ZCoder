+++ b/packages/ui/test/commandOutputFilePreviewDialog.test.ts
@@ -0,0 +1,132 @@
+// @vitest-environment jsdom
+import { createElement, type ReactNode } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  CommandOutputFilePreviewDialog,
+  commandOutputPreviewScopeKey,
+  type CommandOutputPreviewRequest,
+  type CommandOutputPreviewScope,
+} from "@/v4/command-output-file-preview/contract.js";
+
+vi.mock("@/components/ui/dialog.js", () => ({
+  Dialog: ({
+    children,
+    open,
+    onOpenChange,
+  }: {
+    children?: ReactNode;
+    open?: boolean;
+    onOpenChange?: (open: boolean) => void;
+  }) =>
+    open
+      ? createElement(
+          "div",
+          null,
+          createElement(
+            "button",
+            { type: "button", onClick: () => onOpenChange?.(false) },
+            "dismiss-dialog",
+          ),
+          children,
+        )
+      : null,
+  DialogContent: ({ children, ...props }: { children?: ReactNode; [key: string]: unknown }) =>
+    createElement("section", props, children),
+  DialogHeader: ({ children }: { children?: ReactNode }) => createElement("header", null, children),
+  DialogTitle: ({ children }: { children?: ReactNode }) => createElement("h2", null, children),
+}));
+
+vi.mock("@/PreviewPane.js", () => ({
+  PreviewPane: ({
+    source,
+    onClose,
+  }: {
+    source: {
+      type: string;
+      path?: string;
+      workspacePath?: string;
+      workspaceIdentity?: string;
+      workspaceRemoteSessionId?: string;
+    } | null;
+    onClose: () => void;
+  }) =>
+    createElement(
+      "section",
+      {
+        "data-testid": "mock-preview-pane",
+        "data-type": source?.type ?? "",
+        "data-path": source?.path ?? "",
+        "data-workspace": source?.workspacePath ?? "",
+        "data-identity": source?.workspaceIdentity ?? "",
+        "data-remote": source?.workspaceRemoteSessionId ?? "",
+      },
+      createElement("button", { type: "button", onClick: onClose }, "close-preview"),
+    ),
+}));
+
+const scope: CommandOutputPreviewScope = {
+  sessionId: "session-1",
+  workspacePath: "/workspace",
+  workspaceIdentity: "ssh:a",
+  remoteSessionId: "remote-a",
+};
+
+function request(
+  overrides: Partial<CommandOutputPreviewRequest> = {},
+): CommandOutputPreviewRequest {
+  return {
+    path: "/tmp/zcode-bash-abc/session/call_1-stdout.log",
+    title: "call_1-stdout.log",
+    scopeKey: commandOutputPreviewScopeKey(scope),
+    ...overrides,
+  };
+}
+
+afterEach(cleanup);
+
+describe("CommandOutputFilePreviewDialog", () => {
+  it("renders PreviewPane with the current workspace/remote scope", () => {
+    render(
+      createElement(CommandOutputFilePreviewDialog, {
+        request: request(),
+        scope,
+        onDismiss: vi.fn(),
+      }),
+    );
+    const pane = screen.getByTestId("mock-preview-pane");
+    expect(pane.getAttribute("data-type")).toBe("file");
+    expect(pane.getAttribute("data-path")).toBe(request().path);
+    expect(pane.getAttribute("data-workspace")).toBe("/workspace");
+    expect(pane.getAttribute("data-identity")).toBe("ssh:a");
+    expect(pane.getAttribute("data-remote")).toBe("remote-a");
+    expect(screen.getByText("call_1-stdout.log")).toBeTruthy();
+  });
+
+  it("does not render a request opened under another scope", () => {
+    render(
+      createElement(CommandOutputFilePreviewDialog, {
+        request: request({
+          scopeKey: commandOutputPreviewScopeKey({ ...scope, sessionId: "old" }),
+        }),
+        scope,
+        onDismiss: vi.fn(),
+      }),
+    );
+    expect(screen.queryByTestId("mock-preview-pane")).toBeNull();
+  });
+
+  it("closes through dialog and preview close actions", () => {
+    const onDismiss = vi.fn();
+    render(
+      createElement(CommandOutputFilePreviewDialog, {
+        request: request(),
+        scope,
+        onDismiss,
+      }),
+    );
+    fireEvent.click(screen.getByText("close-preview"));
+    fireEvent.click(screen.getByText("dismiss-dialog"));
+    expect(onDismiss).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/packages/ui/test/compactionProfileSettings.test.ts b/packages/ui/test/compactionProfileSettings.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a085d46648f62d0d9b28b09a21d78d68a8062a02
--- /dev/null
+++ b/packages/ui/test/compactionProfileSettings.test.ts
@@ -0,0 +1,217 @@
+// @vitest-environment jsdom
+// 高级设置里的上下文压缩方式：两个 radio 卡 + 仅精简模式生效的 token 预算。
+import { createElement, type ReactNode } from "react";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { CompactionProfile } from "@zcode/shared";
+import { AdvancedSection } from "../src/settingsPageHelpers.js";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    intl: {
+      formatMessage: ({ id }: { id: string }, values?: Record<string, string | number>): string =>
+        values ? `${id}:${values.min}-${values.max}` : id,
+    },
+  }),
+}));
+
+// 只验证高级设置自身交互，避免加载共享设置页里与 Case 无关的代码预览依赖。
+vi.mock("@/settings/SettingsPageParts.js", () => ({
+  SettingsBadge: ({ children }: { children?: ReactNode }) => createElement("span", null, children),
+  SettingsGroupCard: ({ children }: { children?: ReactNode }) =>
+    createElement("section", null, children),
+  SettingsRow: ({
+    label,
+    description,
+    control,
+    detail,
+  }: {
+    label?: ReactNode;
+    description?: ReactNode;
+    control?: ReactNode;
+    detail?: ReactNode;
+  }) => createElement("div", null, label, description, control, detail),
+}));
+
+function renderSection(
+  overrides: {
+    compactionProfile?: CompactionProfile;
+    compactionTailBudgetTokens?: number;
+    compactionSummaryMaxOutputTokens?: number;
+    onCompactionTailBudgetTokensChange?: (tokens: number) => Promise<void>;
+    onCompactionSummaryMaxOutputTokensChange?: (tokens: number) => Promise<void>;
+  } = {},
+) {
+  const props = {
+    compactionProfile: overrides.compactionProfile ?? ("detailed" as CompactionProfile),
+    compactionTailBudgetTokens: overrides.compactionTailBudgetTokens ?? 15_000,
+    compactionSummaryMaxOutputTokens: overrides.compactionSummaryMaxOutputTokens ?? 8_000,
+    onCompactionProfileChange: vi.fn(async (_profile: CompactionProfile) => {}),
+    onCompactionTailBudgetTokensChange:
+      overrides.onCompactionTailBudgetTokensChange ?? vi.fn(async (_tokens: number) => {}),
+    onCompactionSummaryMaxOutputTokensChange:
+      overrides.onCompactionSummaryMaxOutputTokensChange ?? vi.fn(async (_tokens: number) => {}),
+  };
+  render(createElement(AdvancedSection, props));
+  return props;
+}
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe("AdvancedSection 上下文压缩设置", () => {
+  it("默认显示详细摘要卡，详细模式下预算输入禁用", () => {
+    renderSection();
+
+    expect(screen.getByTestId("compaction-profile-detailed").getAttribute("aria-checked")).toBe(
+      "true",
+    );
+    expect(screen.getByTestId("compaction-profile-compact").getAttribute("aria-checked")).toBe(
+      "false",
+    );
+    expect((screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement).disabled).toBe(
+      true,
+    );
+    expect(
+      (screen.getByTestId("compaction-summary-max-output-input") as HTMLInputElement).disabled,
+    ).toBe(true);
+  });
+
+  it("选择精简摘要时保存模式，并在精简模式展示可编辑预算", async () => {
+    const props = renderSection({ compactionProfile: "compact" });
+
+    expect(screen.getByTestId("compaction-profile-compact").getAttribute("aria-checked")).toBe(
+      "true",
+    );
+    expect((screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement).value).toBe(
+      "15000",
+    );
+    expect(
+      (screen.getByTestId("compaction-summary-max-output-input") as HTMLInputElement).value,
+    ).toBe("8000");
+
+    await act(async () => {
+      fireEvent.click(screen.getByTestId("compaction-profile-detailed"));
+    });
+    expect(props.onCompactionProfileChange).toHaveBeenCalledWith("detailed");
+  });
+
+  it("模式保存失败时显示本地化错误并可重试", async () => {
+    const props = renderSection();
+    props.onCompactionProfileChange.mockRejectedValueOnce(new Error("disk full"));
+
+    await act(async () => {
+      fireEvent.click(screen.getByTestId("compaction-profile-compact"));
+    });
+
+    await waitFor(() =>
+      expect(screen.getByTestId("compaction-profile-error").textContent).toBe(
+        "settings.advanced.saveFailed",
+      ),
+    );
+    expect(props.onCompactionProfileChange).toHaveBeenCalledWith("compact");
+  });
+
+  it("合法预算在 blur 或 Enter 时保存", async () => {
+    const onTailChange = vi.fn(async (_tokens: number) => {});
+    renderSection({
+      compactionProfile: "compact",
+      onCompactionTailBudgetTokensChange: onTailChange,
+    });
+    const input = screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement;
+
+    fireEvent.change(input, { target: { value: "20000" } });
+    await act(async () => {
+      fireEvent.blur(input);
+    });
+    expect(onTailChange).toHaveBeenCalledWith(20_000);
+
+    fireEvent.change(input, { target: { value: "100000" } });
+    await act(async () => {
+      fireEvent.keyDown(input, { key: "Enter" });
+    });
+    expect(onTailChange).toHaveBeenLastCalledWith(100_000);
+  });
+
+  it("越界或非整数预算不提交，并显示范围错误", async () => {
+    const onTailChange = vi.fn(async (_tokens: number) => {});
+    renderSection({
+      compactionProfile: "compact",
+      onCompactionTailBudgetTokensChange: onTailChange,
+    });
+    const input = screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement;
+
+    for (const value of ["999", "100001", "15000.5", "abc"]) {
+      fireEvent.change(input, { target: { value } });
+      await act(async () => {
+        fireEvent.blur(input);
+      });
+    }
+
+    expect(onTailChange).not.toHaveBeenCalled();
+    expect(screen.getByTestId("compaction-tail-budget-input-error").textContent).toBe(
+      "settings.advanced.tokenRangeError:1000-100000",
+    );
+  });
+
+  it("摘要输出上限保存失败时显示错误并保留输入", async () => {
+    const onSummaryChange = vi.fn(async (_tokens: number) => {
+      throw new Error("write failed");
+    });
+    renderSection({
+      compactionProfile: "compact",
+      onCompactionSummaryMaxOutputTokensChange: onSummaryChange,
+    });
+    const input = screen.getByTestId("compaction-summary-max-output-input") as HTMLInputElement;
+
+    fireEvent.change(input, { target: { value: "12000" } });
+    await act(async () => {
+      fireEvent.blur(input);
+    });
+
+    await waitFor(() =>
+      expect(screen.getByTestId("compaction-summary-max-output-input-error").textContent).toBe(
+        "settings.advanced.saveFailed",
+      ),
+    );
+    expect(onSummaryChange).toHaveBeenCalledWith(12_000);
+    expect(input.value).toBe("12000");
+    expect(input.disabled).toBe(false);
+  });
+
+  it("保存期间禁用输入且不会重复提交", async () => {
+    let resolveSave: (() => void) | undefined = undefined;
+    const pendingSave = new Promise<void>((resolve) => {
+      resolveSave = resolve;
+    });
+    const onTailChange = vi.fn(async (_tokens: number) => {
+      await pendingSave;
+    });
+    renderSection({
+      compactionProfile: "compact",
+      onCompactionTailBudgetTokensChange: onTailChange,
+    });
+    const input = screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement;
+
+    fireEvent.change(input, { target: { value: "25000" } });
+    await act(async () => {
+      fireEvent.blur(input);
+    });
+    expect(input.disabled).toBe(true);
+    expect(onTailChange).toHaveBeenCalledTimes(1);
+
+    await act(async () => {
+      fireEvent.blur(input);
+      fireEvent.keyDown(input, { key: "Enter" });
+    });
+    expect(onTailChange).toHaveBeenCalledTimes(1);
+
+    await act(async () => {
+      resolveSave?.();
+      await pendingSave;
+    });
+    await waitFor(() => expect(input.disabled).toBe(false));
+  });
+});
diff --git a/packages/ui/test/compatSlashCommands.test.ts b/packages/ui/test/compatSlashCommands.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ffc61e8ea078656c547423df87ff628dcb69f40
--- /dev/null
+++ b/packages/ui/test/compatSlashCommands.test.ts
@@ -0,0 +1,315 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  buildCompatSlashCommands,
+  findLatestForkableRow,
+  type CompatSlashCommandDeps,
+} from "@/v4/slash-commands/index.js";
+import { formatTokenCount } from "@/v4/slash-commands/transcript.js";
+
+function makeRows(
+  entries: Array<{ kind: "userInput" | "assistantText"; text: string }>,
+): ConversationRow[] {
+  return entries.map((entry, index) => ({
+    rowId: index + 1,
+    kind: entry.kind,
+    text: entry.text,
+  })) as unknown as ConversationRow[];
+}
+
+function buildDeps(overrides: Partial<CompatSlashCommandDeps> = {}): CompatSlashCommandDeps {
+  return {
+    locale: "zh-CN",
+    rows: [],
+    contextWindow: null,
+    olderRowsAvailable: false,
+    notify: vi.fn(),
+    forkLatest: null,
+    closeWindow: null,
+    ...overrides,
+  };
+}
+
+function build(locale: "zh-CN" | "en-US", rows: ConversationRow[] = []) {
+  const notify = vi.fn();
+  const commands = buildCompatSlashCommands(buildDeps({ locale, rows, notify }));
+  return { commands, notify };
+}
+
+function stubDownloadEnvironment() {
+  const anchor = { href: "", download: "", rel: "", click: vi.fn() };
+  const parts: string[] = [];
+  const revokeObjectURL = vi.fn();
+  vi.stubGlobal("document", { createElement: () => anchor });
+  vi.stubGlobal("URL", {
+    createObjectURL: () => "blob:mock",
+    revokeObjectURL,
+  });
+  vi.stubGlobal("window", { setTimeout: (callback: () => void) => callback() });
+  vi.stubGlobal(
+    "Blob",
+    class {
+      constructor(blobParts: string[]) {
+        parts.push(...blobParts);
+      }
+    },
+  );
+  return { anchor, parts, revokeObjectURL };
+}
+
+describe("compat slash commands", () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("registers copy, export, context, fork, branch and exit", () => {
+    const commands = buildCompatSlashCommands(
+      buildDeps({ forkLatest: () => true, closeWindow: () => {} }),
+    );
+    expect(commands.map((command) => command.value)).toEqual([
+      "copy",
+      "export",
+      "context",
+      "fork",
+      "branch",
+      "exit",
+    ]);
+  });
+
+  it("omits fork writes when the current view cannot fork", () => {
+    const { commands } = build("zh-CN");
+    expect(commands.map((command) => command.value)).toEqual([
+      "copy",
+      "export",
+      "context",
+      "exit",
+    ]);
+  });
+
+  it("copies the latest assistant reply only", async () => {
+    const writeText = vi.fn(async () => {});
+    vi.stubGlobal("navigator", { clipboard: { writeText } });
+    const { commands, notify } = build(
+      "zh-CN",
+      makeRows([
+        { kind: "assistantText", text: "旧回复" },
+        { kind: "userInput", text: "下一个问题" },
+        { kind: "assistantText", text: "最新回复" },
+      ]),
+    );
+
+    commands.find((command) => command.value === "copy")?.run();
+
+    await vi.waitFor(() => expect(writeText).toHaveBeenCalledWith("最新回复"));
+    await vi.waitFor(() => expect(notify).toHaveBeenCalledWith("已复制最近一条助手回复。"));
+  });
+
+  it("reports an empty transcript instead of touching the clipboard", () => {
+    const writeText = vi.fn(async () => {});
+    vi.stubGlobal("navigator", { clipboard: { writeText } });
+    const { commands, notify } = build("zh-CN");
+
+    commands.find((command) => command.value === "copy")?.run();
+
+    expect(writeText).not.toHaveBeenCalled();
+    expect(notify).toHaveBeenCalledWith("没有可复制的助手回复。");
+  });
+
+  it("reports copy failure when the clipboard API is unavailable", () => {
+    vi.stubGlobal("navigator", {});
+    const { commands, notify } = build(
+      "zh-CN",
+      makeRows([{ kind: "assistantText", text: "回复" }]),
+    );
+
+    commands.find((command) => command.value === "copy")?.run();
+
+    expect(notify).toHaveBeenCalledWith("复制失败，请检查剪贴板权限。");
+  });
+
+  it("exports the transcript as a Markdown download", () => {
+    const { anchor, parts, revokeObjectURL } = stubDownloadEnvironment();
+    const notify = vi.fn();
+    const commands = buildCompatSlashCommands(
+      buildDeps({
+        rows: makeRows([
+          { kind: "userInput", text: "问题" },
+          { kind: "assistantText", text: "回答" },
+        ]),
+        notify,
+      }),
+    );
+
+    commands.find((command) => command.value === "export")?.run();
+
+    expect(parts[0]).toContain("# ZCode 对话");
+    expect(parts[0]).toContain("## 用户\n\n问题");
+    expect(parts[0]).toContain("## 助手\n\n回答");
+    expect(anchor.download).toMatch(/^zcode-conversation-.+\.md$/);
+    expect(anchor.click).toHaveBeenCalledTimes(1);
+    expect(revokeObjectURL).toHaveBeenCalledWith("blob:mock");
+    expect(notify).toHaveBeenCalledWith("已导出 2 条消息为 Markdown 文件。");
+  });
+
+  it("says when only the loaded window was exported", () => {
+    stubDownloadEnvironment();
+    const notify = vi.fn();
+    const commands = buildCompatSlashCommands(
+      buildDeps({
+        rows: makeRows([{ kind: "assistantText", text: "回答" }]),
+        olderRowsAvailable: true,
+        notify,
+      }),
+    );
+
+    commands.find((command) => command.value === "export")?.run();
+
+    expect(notify).toHaveBeenCalledWith("已导出当前窗口的 1 条消息；更早历史尚未加载。");
+  });
+
+  it("reports an empty transcript instead of writing a file", () => {
+    const { anchor } = stubDownloadEnvironment();
+    const { commands, notify } = build("zh-CN");
+
+    commands.find((command) => command.value === "export")?.run();
+
+    expect(anchor.click).not.toHaveBeenCalled();
+    expect(notify).toHaveBeenCalledWith("当前对话还没有可导出的内容。");
+  });
+
+  it("drops engine epilogue text and workflow launch rows from exports", () => {
+    const { parts } = stubDownloadEnvironment();
+    const rows = [
+      {
+        rowId: 1,
+        kind: "userInput",
+        text: "问题\n---\n尾注",
+        origin: "realUser",
+        epilogueStart: 2,
+      },
+      { rowId: 2, kind: "userInput", text: "启动轮", origin: "workflowLaunch" },
+      { rowId: 3, kind: "assistantText", text: "回答" },
+    ] as unknown as ConversationRow[];
+    const commands = buildCompatSlashCommands(buildDeps({ rows }));
+
+    commands.find((command) => command.value === "export")?.run();
+
+    expect(parts[0]).toContain("问题");
+    expect(parts[0]).not.toContain("尾注");
+    expect(parts[0]).not.toContain("启动轮");
+  });
+
+  it("formats context usage with the compaction threshold", () => {
+    const notify = vi.fn();
+    const commands = buildCompatSlashCommands(
+      buildDeps({
+        locale: "en-US",
+        contextWindow: {
+          usedTokens: 1500,
+          maxTokens: 200000,
+          autoCompactThresholdTokens: 160000,
+        },
+        notify,
+      }),
+    );
+
+    commands.find((command) => command.value === "context")?.run();
+
+    expect(notify).toHaveBeenCalledWith("Context 1.5k / 200k (0.8%), auto-compact threshold 160k.");
+  });
+
+  it("falls back when usage is unavailable", () => {
+    const { commands, notify } = build("en-US");
+    commands.find((command) => command.value === "context")?.run();
+    expect(notify).toHaveBeenCalledWith("No context usage data for this session yet.");
+  });
+
+  it("reuses the existing fork entry", () => {
+    const forkLatest = vi.fn(() => true);
