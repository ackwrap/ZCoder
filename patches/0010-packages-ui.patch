diff --git a/packages/ui/test/autocompact.test.ts b/packages/ui/test/autocompact.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d3606c4b2c241e09dd70996ad0629b59425a6ba
--- /dev/null
+++ b/packages/ui/test/autocompact.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it, vi } from "vitest";
+import { buildAutoCompactCommand, parseAutoCompactInput } from "@/v4/slash-commands/autocompact.js";
+
+describe("autocompact command", () => {
+  it("prepares input on menu selection without querying or sending", async () => {
+    const prepareInput = vi.fn();
+    const execute = vi.fn();
+    const notify = vi.fn();
+    const command = buildAutoCompactCommand({
+      enabled: true,
+      cliNames: new Set(),
+      execute,
+      notify,
+      prepareInput,
+    });
+    command.commands[0]!.run();
+    expect(prepareInput).toHaveBeenCalledOnce();
+    expect(execute).not.toHaveBeenCalled();
+    expect(notify).not.toHaveBeenCalled();
+  });
+  it("dispatches to current session and reports actual safe threshold", async () => {
+    const execute = vi.fn(async () => ({
+      commandId: "test",
+      status: "accepted" as const,
+      result: {
+        type: "configureAutoCompact" as const,
+        limit: { unit: "tokens" as const, value: 1000000 },
+        contextWindowTokens: 200000,
+        requestedThresholdTokens: 1000000,
+        effectiveThresholdTokens: 166000,
+      },
+    }));
+    const notify = vi.fn();
+    const command = buildAutoCompactCommand({
+      enabled: true,
+      cliNames: new Set(),
+      execute,
+      notify,
+      prepareInput: vi.fn(),
+    });
+    expect(await command.run("/autocompact 1m")).toBe("sent");
+    expect(execute).toHaveBeenCalledWith({ limit: { unit: "tokens", value: 1000000 } });
+    expect(notify.mock.calls[0]?.[0]).toContain("166");
+    expect(await command.run("/autocompact nonsense")).toBe("blocked");
+    expect(execute).toHaveBeenCalledTimes(1);
+  });
+  it("yields to CLI names and hides unavailable write commands", async () => {
+    const execute = vi.fn();
+    for (const input of [
+      { enabled: false, cliNames: new Set<string>() },
+      { enabled: true, cliNames: new Set(["autocompact"]) },
+    ]) {
+      const command = buildAutoCompactCommand({
+        ...input,
+        execute,
+        notify: vi.fn(),
+        prepareInput: vi.fn(),
+      });
+      expect(command.commands).toEqual([]);
+      expect(await command.run("/autocompact 100k")).toBeNull();
+    }
+    expect(execute).not.toHaveBeenCalled();
+  });
+});
+
+describe("autocompact input", () => {
+  it.each([
+    ["100k", 100000],
+    ["1m", 1000000],
+    ["1.5M", 1500000],
+    ["80000", 80000],
+  ])("parses %s", (input, value) => {
+    expect(parseAutoCompactInput(`/autocompact ${input}`)).toEqual({
+      limit: { unit: "tokens", value },
+    });
+  });
+  it("supports query, reset and percentages", () => {
+    expect(parseAutoCompactInput("/autocompact")).toEqual({});
+    expect(parseAutoCompactInput("/autocompact reset")).toEqual({ limit: null });
+    expect(parseAutoCompactInput("/autocompact 80%")).toEqual({
+      limit: { unit: "percent", value: 80 },
+    });
+    expect(parseAutoCompactInput("/compact")).toBeNull();
+  });
+  it.each(["0", "-1", "101%", "NaN", "1.23", "2m extra", "999999999999999999999m"])(
+    "rejects %s",
+    (arg) => {
+      expect(() => parseAutoCompactInput(`/autocompact ${arg}`)).toThrow();
+    },
+  );
+});
diff --git a/packages/ui/test/backgroundBashNotice.test.ts b/packages/ui/test/backgroundBashNotice.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e889d3645d84b03c654cf95d76bdd619b0878844
--- /dev/null
+++ b/packages/ui/test/backgroundBashNotice.test.ts
@@ -0,0 +1,131 @@
+// @vitest-environment jsdom
+
+import { createElement } from "react";
+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it } from "vitest";
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import {
+  ExecuteToolCallBlock,
+  splitBackgroundRunNotice,
+} from "../src/ToolCallBlocks/renderers/execute.js";
+import { buildToolDisplayModel } from "../src/lib/toolDisplay.js";
+import { toolCallRowToLegacyNode } from "../src/v4/toolCallRowAdapter.js";
+
+afterEach(cleanup);
+
+// ExecuteCommand 用 ResizeObserver 判断命令行是否溢出；jsdom 不提供该 API。
+class ResizeObserverStub {
+  observe(): void {}
+  unobserve(): void {}
+  disconnect(): void {}
+}
+globalThis.ResizeObserver ??= ResizeObserverStub as unknown as typeof ResizeObserver;
+
+const BACKGROUND_NOTICE =
+  "Command running in background with ID: exec_bg. Output is being written to: /tmp/exec_bg.output. You will be notified when it completes. To check interim output, use Read on that file path.";
+
+function row(outputText: string): ToolCallRow {
+  return {
+    rowId: 1,
+    turnId: "turn-bg",
+    createdAt: 1,
+    createdAtSeq: 1,
+    kind: "toolCall",
+    toolCallId: "call-bg",
+    toolName: "Bash",
+    status: "success",
+    inputText: '{"command":"npm run watch"}',
+    input: { command: "npm run watch" },
+    output: { text: outputText },
+  };
+}
+
+function body(value: ToolCallRow, locale: "zh-CN" | "en-US" = "zh-CN") {
+  const node = toolCallRowToLegacyNode(value);
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: locale },
+    createElement(ExecuteToolCallBlock, {
+      nestedToolRenderer: () => null,
+      toolCallNode: node,
+      workspacePath: "/workspace",
+      displayModel: buildToolDisplayModel(node.toolCall),
+      viewerSource: null,
+      rawFileSummaries: [],
+      isRunning: false,
+      statusLabel: "完成",
+      childToolList: null,
+      forceOpen: true,
+    }),
+  );
+}
+
+describe("splitBackgroundRunNotice", () => {
+  it.each([
+    [BACKGROUND_NOTICE, "exec_bg"],
+    [
+      "Command was manually backgrounded by user with ID: exec_user. Output is being written to: C:\\tmp\\a.log",
+      "exec_user",
+    ],
+    [
+      "Command exceeded the assistant-mode blocking budget (15s) and was moved to the background with ID: exec_auto. It is still running — you will be notified when it completes. Output is being written to: /tmp/a.log. In assistant mode, delegate long-running work to a subagent or use run_in_background to keep this conversation responsive.",
+      "exec_auto",
+    ],
+  ])("extracts the background task id %#", (text, taskId) => {
+    expect(splitBackgroundRunNotice(text)).toMatchObject({ body: "", taskId });
+  });
+
+  it("keeps preceding stdout as the body", () => {
+    expect(splitBackgroundRunNotice(`partial output\n${BACKGROUND_NOTICE}`)).toMatchObject({
+      body: "partial output",
+      taskId: "exec_bg",
+      outputPath: "/tmp/exec_bg.output",
+    });
+  });
+
+  it.each(["ok", "log: Command running in background without a task id", ""])(
+    "ignores non-notice text %j",
+    (text) => {
+      expect(splitBackgroundRunNotice(text)).toBeNull();
+    },
+  );
+});
+
+describe("background Bash card", () => {
+  it("shows a compact background label instead of the model hint text", () => {
+    render(body(row(BACKGROUND_NOTICE)));
+    expect(screen.getByTestId("execute-background-run").textContent).toBe(
+      "已转入后台运行 · exec_bg",
+    );
+    expect(screen.queryByText(/You will be notified/)).toBeNull();
+    expect(screen.queryByText(/To check interim output/)).toBeNull();
+  });
+
+  it("keeps real output that precedes the notice", () => {
+    render(
+      body(
+        row(
+          "watching for changes\nCommand was manually backgrounded by user with ID: exec_bg2. Output is being written to: /tmp/watch.log",
+        ),
+      ),
+    );
+    expect(screen.getByTestId("execute-background-run").textContent).toBe(
+      "已转入后台运行 · exec_bg2",
+    );
+    expect(screen.getByTestId("bash-result-output").textContent).toBe("watching for changes");
+  });
+
+  it("localizes the label", () => {
+    render(body(row(BACKGROUND_NOTICE), "en-US"));
+    expect(screen.getByTestId("execute-background-run").textContent).toBe(
+      "Moved to background · exec_bg",
+    );
+  });
+
+  it("leaves ordinary command output untouched", () => {
+    render(body(row("ok")));
+    expect(screen.queryByTestId("execute-background-run")).toBeNull();
+    expect(screen.getByTestId("bash-result-output").textContent).toBe("ok");
+  });
+});
