diff --git a/packages/ui/src/codex-provider/CONTRACT.md b/packages/ui/src/codex-provider/CONTRACT.md
new file mode 100644
index 0000000000000000000000000000000000000000..e8b26692cdbd1277d8242d20f1e90800899dcf9e
--- /dev/null
+++ b/packages/ui/src/codex-provider/CONTRACT.md
@@ -0,0 +1,9 @@
+# codex-provider-ui
+
+浏览器和设备码是显式独立操作，共用 Host owner。设备码只能在用户主动发起的活动 flow 中展示，取消/失败/过期/切换后清除，不写入日志或本地持久化。验证页仅允许固定 OpenAI 官方 URL；不自动输入用户码或确认授权。
+浏览器授权 URL 仅允许 `https://auth.openai.com/oauth/authorize`，与 Host 当前 Codex 流程一致；旧 `/api/accounts/authorize` 和其他站点仍拒绝。合法地址必须交给平台打开，不能因残留旧路径白名单立即取消成功创建的 flow。
+
+Codex 连接卡片与 hook 是 Host 状态的展示投影，不读取凭据、不拼接 OAuth 参数、不兑换 token。
+通过 `useServices` 读取 Codex 公共服务，通过 `usePlatform` 打开系统浏览器。
+provider/service 换代后忽略旧请求；卸载时取消本卡片发起的未完成登录。
+与现有 Provider 编辑器的唯一交集是 `CodexConnectionCard({ providerId })`；API Key 与连接编辑表单对 Codex 隐藏。
diff --git a/packages/ui/src/codex-provider/CodexConnectionCard.tsx b/packages/ui/src/codex-provider/CodexConnectionCard.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b0ca7df85dcc16b7d0a4e85b01f56259ff00aa28
--- /dev/null
+++ b/packages/ui/src/codex-provider/CodexConnectionCard.tsx
@@ -0,0 +1,135 @@
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { useCodexConnection } from "./useCodexConnection.js";
+
+export function CodexConnectionCard({ providerId }: { providerId: string }) {
+  const { intl } = useZCodeIntl();
+  const connection = useCodexConnection(providerId);
+  const { status, busy, error } = connection;
+  const waiting = status?.flow?.state === "waiting";
+  const device = waiting ? status?.flow?.device : undefined;
+  const message = (key: string) =>
+    intl.formatMessage({ id: `settings.modelProvider.codex.${key}` });
+  const failed = error || status?.flow?.state === "failed";
+  return (
+    <section
+      className="space-y-3 rounded-lg border border-border bg-surface p-4"
+      data-testid="codex-connection"
+    >
+      <h3 className="text-ui-base font-medium">{message("name")}</h3>
+      {waiting || status?.connected ? (
+        <p className="text-ui-base text-foreground-subtle">
+          {message(waiting ? (device ? "deviceWaiting" : "waiting") : "connected")}
+        </p>
+      ) : null}
+      {!connection.available || (status && !status.loginAvailable) ? (
+        <p className="text-ui-caption text-foreground-subtle">{message("desktopOnly")}</p>
+      ) : null}
+      {failed ? (
+        <p role="alert" className="text-ui-base text-destructive">
+          {message(
+            status?.flow?.error === "codex-token-sharing-required"
+              ? "sharingRequired"
+              : status?.flow?.error === "codex-device-expired"
+                ? "deviceExpired"
+                : status?.flow?.error === "codex-device-unavailable"
+                  ? "deviceUnavailable"
+                  : "failed",
+          )}
+        </p>
+      ) : null}
+      {device ? (
+        <div
+          className="space-y-2 rounded-md border border-border p-3 text-ui-base"
+          data-testid="codex-device-details"
+        >
+          <p className="break-all">{device.verificationUrl}</p>
+          <code className="select-all text-ui-lg" data-testid="codex-device-code">
+            {device.userCode}
+          </code>
+          <p className="text-ui-caption text-foreground-subtle">
+            {intl.formatMessage(
+              { id: "settings.modelProvider.codex.deviceExpires" },
+              { time: new Date(device.expiresAt).toLocaleTimeString() },
+            )}
+          </p>
+          <p className="text-ui-caption text-foreground-subtle">{message("deviceWarning")}</p>
+          <div className="flex flex-wrap gap-2">
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              data-testid="codex-device-open"
+              onClick={connection.openDevice}
+            >
+              {message("deviceOpen")}
+            </Button>
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              data-testid="codex-device-copy"
+              onClick={() => void connection.copyDevice()}
+            >
+              {message("deviceCopy")}
+            </Button>
+          </div>
+        </div>
+      ) : null}
+      <div className="flex flex-wrap gap-2">
+        <Button
+          type="button"
+          size="sm"
+          data-testid="codex-login"
+          disabled={busy || waiting || !status?.loginAvailable}
+          onClick={() => void connection.start()}
+        >
+          {message(status?.connected ? "reconnect" : "login")}
+        </Button>
+        <Button
+          type="button"
+          size="sm"
+          variant="outline"
+          data-testid="codex-device-login"
+          disabled={busy || waiting || !status?.loginAvailable}
+          onClick={() => void connection.startDevice()}
+        >
+          {message("deviceLogin")}
+        </Button>
+        {waiting ? (
+          <Button
+            type="button"
+            size="sm"
+            variant="outline"
+            data-testid="codex-cancel"
+            onClick={() => void connection.cancel()}
+          >
+            {message("cancel")}
+          </Button>
+        ) : null}
+        {status?.connected ? (
+          <Button
+            type="button"
+            size="sm"
+            variant="outline"
+            data-testid="codex-disconnect"
+            disabled={busy}
+            onClick={() => void connection.disconnect()}
+          >
+            {message("disconnect")}
+          </Button>
+        ) : null}
+        {error ? (
+          <Button
+            type="button"
+            size="sm"
+            variant="outline"
+            onClick={() => void connection.reload()}
+          >
+            {message("retry")}
+          </Button>
+        ) : null}
+      </div>
+    </section>
+  );
+}
