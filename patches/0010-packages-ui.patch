+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render } from "@testing-library/react";
+import { afterEach, expect, it } from "vitest";
+import { ToolLayout } from "../src/ToolCallBlocks/ToolLayout.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+afterEach(cleanup);
+function card(id: string, isRunning: boolean) {
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "en-US" },
+    createElement(ToolLayout, {
+      toolId: id,
+      icon: null,
+      kindLabel: "Tool",
+      primaryText: "single",
+      isRunning,
+      expandWhileRunning: true,
+      content: "detail",
+    }),
+  );
+}
+it("opens on running admission and returns to the completed default without recording a choice", () => {
+  const view = render(card("live-transition", false));
+  const trigger = () =>
+    view.getByTestId("tool-summary-trigger-live-transition");
+  expect(trigger().getAttribute("aria-expanded")).toBe("false");
+  view.rerender(card("live-transition", true));
+  expect(trigger().getAttribute("aria-expanded")).toBe("true");
+  view.rerender(card("live-transition", false));
+  expect(trigger().getAttribute("aria-expanded")).toBe("false");
+});
+it("retains manual collapse through updates, completion and remount", () => {
+  const view = render(card("live-choice", true));
+  fireEvent.click(view.getByTestId("tool-summary-trigger-live-choice"));
+  view.rerender(card("live-choice", true));
+  expect(
+    view
+      .getByTestId("tool-summary-trigger-live-choice")
+      .getAttribute("aria-expanded"),
+  ).toBe("false");
+  view.rerender(card("live-choice", false));
+  expect(
+    view
+      .getByTestId("tool-summary-trigger-live-choice")
+      .getAttribute("aria-expanded"),
+  ).toBe("false");
+  view.unmount();
+  const remounted = render(card("live-choice", true));
+  expect(
+    remounted
+      .getByTestId("tool-summary-trigger-live-choice")
+      .getAttribute("aria-expanded"),
+  ).toBe("false");
+});
