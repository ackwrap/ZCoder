+/** Running defaults are projections, never remembered user choices. */
+export function resolveToolLiveExpansion(
+  rememberedOpen: boolean | undefined,
+  isRunning: boolean,
+  expandWhileRunning: boolean,
+): boolean {
+  return rememberedOpen ?? (expandWhileRunning && isRunning);
+}
