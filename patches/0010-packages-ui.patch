+import { readFileSync } from "node:fs";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { DesktopCommandIds } from "@zcode/shared";
+import {
+  buildIntegratedCompatSlashCommands,
+  type CompatSlashCommandIntegrationDeps,
+} from "@/v4/slash-commands/contract.js";
+import {
+  getSessionFocusModeEnabled,
+  resetSessionFocusModeStoreForTest,
+  resolveSessionFocusModeScopeKey,
+  setSessionFocusModeEnabled,
+  toggleSessionFocusMode,
+} from "@/v4/focus-mode/contract.js";
+
+const workspace = { workspaceIdentity: "workspace-identity", workspacePath: "C:/workspace" };
+
+function deps(
+  overrides: Partial<CompatSlashCommandIntegrationDeps> = {},
+): CompatSlashCommandIntegrationDeps {
+  return {
+    locale: "en-US",
+    rows: [],
+    contextWindow: null,
+    olderRowsAvailable: false,
+    notify: vi.fn(),
+    forkActionsEnabled: false,
+    snapshotRef: { current: null },
+    handleFork: vi.fn(),
+    isDesktop: false,
+    closeWindowCommand: DesktopCommandIds.CloseWindow,
+    platform: undefined,
+    logger: { warn: vi.fn() },
+    cliSlashCommandNames: new Set(),
+    ...overrides,
+  };
+}
+
+function scope(sessionId: string) {
+  return resolveSessionFocusModeScopeKey({ ...workspace, sessionId });
+}
+
+beforeEach(() => {
+  resetSessionFocusModeStoreForTest();
+});
+
+describe("session-scoped focus mode state", () => {
+  it("defaults off and keeps panes of the same session consistent", () => {
+    const a = scope("session-a");
+    const aPaneTwo = resolveSessionFocusModeScopeKey({
+      workspaceIdentity: "workspace-identity",
+      workspacePath: "C:/other-path",
+      sessionId: "session-a",
+    });
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+    expect(aPaneTwo).toBe(a);
+
+    setSessionFocusModeEnabled(a, true);
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+    expect(getSessionFocusModeEnabled(aPaneTwo)).toBe(true);
+  });
+
+  it("keeps other sessions off and restores a session's state after switching away", () => {
+    const a = scope("session-a");
+    const b = scope("session-b");
+    expect(toggleSessionFocusMode(a)).toBe(true);
+
+    expect(getSessionFocusModeEnabled(b)).toBe(false);
+    expect(toggleSessionFocusMode(b)).toBe(true);
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+
+    expect(toggleSessionFocusMode(a)).toBe(false);
+    expect(getSessionFocusModeEnabled(b)).toBe(true);
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+  });
+});
+
+describe("/force command", () => {
+  it("registers the session toggle, exposes on/off copy, and never yields a provider call", () => {
+    let enabled = false;
+    const toggle = vi.fn(() => {
+      enabled = !enabled;
+      return enabled;
+    });
+    const notify = vi.fn();
+    const input = deps({ focusMode: { enabled, toggle }, notify });
+
+    const command = buildIntegratedCompatSlashCommands(input).find((c) => c.value === "force");
+    expect(command).toBeDefined();
+    expect(command?.label).toBe("/force");
+    expect(command?.description).toContain("Enable focused mode");
+    command?.run();
+    expect(toggle).toHaveBeenCalledOnce();
+    expect(notify).toHaveBeenCalledWith("Focused mode is on for this session.");
+
+    const enabledCommand = buildIntegratedCompatSlashCommands(
+      deps({ focusMode: { enabled: true, toggle }, notify }),
+    ).find((c) => c.value === "force");
+    expect(enabledCommand?.description).toContain("Disable focused mode");
+    enabledCommand?.run();
+    expect(notify).toHaveBeenLastCalledWith("Focused mode is off for this session.");
+  });
+
+  it("yields to an exact CLI command name", () => {
+    const input = deps({
+      focusMode: { enabled: false, toggle: () => true },
+      cliSlashCommandNames: new Set(["force"]),
+    });
+    expect(buildIntegratedCompatSlashCommands(input).some((c) => c.value === "force")).toBe(false);
+  });
+
+  it("stays available for the pure view path when write actions are denied", () => {
+    const input = deps({
+      forkActionsEnabled: false,
+      focusMode: { enabled: false, toggle: () => true },
+    });
+    expect(buildIntegratedCompatSlashCommands(input).some((c) => c.value === "force")).toBe(true);
+  });
+});
+
+describe("global settings removal", () => {
+  it("does not reintroduce a global focus-mode settings field", () => {
+    const settingsPage = readFileSync(new URL("../src/SettingsPage.tsx", import.meta.url), "utf8");
+    expect(settingsPage).not.toContain("FocusModeSettingRow");
+    expect(settingsPage).not.toContain("sessionTimelineFocusModeEnabled");
+
+    const protocol = readFileSync(new URL("../../shared/src/protocol.ts", import.meta.url), "utf8");
+    expect(protocol).not.toContain("sessionTimelineFocusModeEnabled");
+  });
+});
diff --git a/packages/ui/test/sessionFocusModeLoading.test.ts b/packages/ui/test/sessionFocusModeLoading.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b9d2a2c0f553882abd66518ebd91d1c8f94f487a
--- /dev/null
+++ b/packages/ui/test/sessionFocusModeLoading.test.ts
@@ -0,0 +1,209 @@
+// @vitest-environment jsdom
+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  useFocusTimelineWindow,
+  type UseFocusTimelineWindowOptions,
+} from "@/v4/focus-mode/contract.js";
+
+function header(turnId: string, state: string, rowId: number): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "turnHeader",
+    origin: "userInput",
+    executionKind: "agent",
+    state,
+    startedAt: 1,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function user(turnId: string, rowId: number): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "userInput",
+    origin: "realUser",
+    text: `user-${rowId}`,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function assistant(turnId: string, rowId: number, state = "complete"): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "assistantText",
+    text: `answer-${rowId}`,
+    state,
+    createdAt: 1,
+    createdAtSeq: rowId,
+  } as ConversationRow;
+}
+
+function successTurn(turnId: string, startRowId: number): ConversationRow[] {
+  return [
+    header(turnId, "completedSuccess", startRowId),
+    user(turnId, startRowId + 1),
+    assistant(turnId, startRowId + 2),
+  ];
+}
+
+function interruptedRow(turnId: string, rowId: number): ConversationRow {
+  return assistant(turnId, rowId, "interrupted");
+}
+
+function createLoader() {
+  const resolvers: Array<{ resolve: () => void; reject: (error: Error) => void }> = [];
+  const onLoadOlder = vi.fn(
+    () =>
+      new Promise<void>((resolve, reject) => {
+        resolvers.push({ resolve, reject });
+      }),
+  );
+  return {
+    onLoadOlder,
+    resolveNext: () => resolvers.shift()?.resolve(),
+    rejectNext: () => resolvers.shift()?.reject(new Error("late load failed")),
+  };
+}
+
+function baseRows(): ConversationRow[] {
+  return [
+    ...successTurn("a", 1000),
+    ...successTurn("b", 2000),
+    ...successTurn("c", 3000),
+    ...successTurn("d", 4000),
+  ];
+}
+
+async function setup(
+  initialRows: ConversationRow[],
+  loader: ReturnType<typeof createLoader>,
+  canLoadOlder = true,
+) {
+  let props: UseFocusTimelineWindowOptions = {
+    rows: initialRows,
+    sessionKey: "session-1",
+    canLoadOlder,
+    loadingOlder: false,
+    onLoadOlder: loader.onLoadOlder,
+  };
+  const hook = renderHook((next: UseFocusTimelineWindowOptions) => useFocusTimelineWindow(next), {
+    initialProps: props,
+  });
+  const rerender = async (partial: Partial<UseFocusTimelineWindowOptions>) => {
+    props = { ...props, ...partial };
+    await act(async () => {
+      hook.rerender(props);
+      await Promise.resolve();
+    });
+  };
+  const completeLoad = async (rows: ConversationRow[], loading = true) => {
+    await rerender({ loadingOlder: loading });
+    loader.resolveNext();
+    await act(async () => {
+      await Promise.resolve();
+    });
+    await rerender({ rows, loadingOlder: false });
+  };
+  return { hook, rerender, completeLoad };
+}
+
+describe("focus latest completion owner", () => {
+  it("stops after a no-progress completion and retries only explicitly", async () => {
+    const loader = createLoader();
+    const rows = successTurn("a", 1000);
+    const { hook, completeLoad } = await setup(rows, loader);
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(1);
+    await completeLoad([...rows]);
+    expect(hook.result.current.loadStatus).toBe("exhausted");
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(1);
+    act(() => hook.result.current.retryLoadOlder());
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(2);
+  });
+
+  it("stops after eight progressing loads and explicit retry starts a new budget", async () => {
+    const loader = createLoader();
+    let rows = successTurn("a", 1000);
+    const { hook, completeLoad } = await setup(rows, loader);
+    for (let index = 0; index < 8; index++) {
+      rows = [interruptedRow("prefix", 900 - index), ...rows];
+      await completeLoad(rows);
+    }
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(8);
+    expect(hook.result.current.loadStatus).toBe("exhausted");
+    act(() => hook.result.current.retryLoadOlder());
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(9);
+  });
+
+  it("suspends in-flight completion while expanded and preserves its progress budget", async () => {
+    const loader = createLoader();
+    let rows = successTurn("a", 1000);
+    const { hook, rerender, completeLoad } = await setup(rows, loader);
+    await rerender({ active: false });
+    rows = [interruptedRow("prefix", 900), ...rows];
+    await completeLoad(rows);
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(1);
+    expect(hook.result.current.focusLoading).toBe(false);
+    await rerender({ active: true });
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(2);
+    for (let index = 1; index < 8; index++) {
+      rows = [interruptedRow("prefix", 900 - index), ...rows];
+      await completeLoad(rows);
+    }
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(8);
+    expect(hook.result.current.loadStatus).toBe("exhausted");
+  });
+
+  it("ignores a stale rejection after leaving and re-entering latest", async () => {
+    const loader = createLoader();
+    const { hook, rerender } = await setup(successTurn("a", 1000), loader);
+    await rerender({ active: false });
+    await rerender({ active: true });
+    loader.rejectNext();
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(hook.result.current.loadStatus).not.toBe("error");
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(1);
+  });
+
+  it("protects the new request when an earlier session finishes after switching back", async () => {
+    const loader = createLoader();
+    const { hook, rerender } = await setup(successTurn("a", 1000), loader);
+    await rerender({ sessionKey: "session-2", rows: baseRows() });
+    await rerender({ sessionKey: "session-1", rows: successTurn("a", 1000) });
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(2);
+    loader.resolveNext();
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(hook.result.current.focusLoading).toBe(true);
+    expect(loader.onLoadOlder).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not leak a previous session failure or load budget", async () => {
+    const loader = createLoader();
+    const { hook, rerender } = await setup(successTurn("a", 1000), loader);
+    await rerender({ sessionKey: "session-2", rows: baseRows() });
+    loader.rejectNext();
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(hook.result.current.loadStatus).not.toBe("error");
+    expect(hook.result.current.window.turnIds).toEqual(["c", "d"]);
+  });
+
+  it("stops at true history start and preserves a single group", async () => {
+    const loader = createLoader();
+    const { hook } = await setup(successTurn("a", 1000), loader, false);
+    expect(loader.onLoadOlder).not.toHaveBeenCalled();
+    expect(hook.result.current.window.turnIds).toEqual(["a"]);
+    expect(hook.result.current.needsOlderData).toBe(false);
+  });
+});
diff --git a/packages/ui/test/sessionFocusModePersistence.test.ts b/packages/ui/test/sessionFocusModePersistence.test.ts
