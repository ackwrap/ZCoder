@@ -0,0 +1,36 @@
+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+import { latestAssistantText, type TranscriptEntry } from "../transcript.js";
+
+export function createCopyCommand(
+  entries: readonly TranscriptEntry[],
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand {
+  const messages = getCompatMessages(locale);
+  return {
+    value: messages.copy.value,
+    label: `/${messages.copy.value}`,
+    description: messages.copy.description,
+    keywords: messages.copy.keywords,
+    run: () => {
+      const text = latestAssistantText(entries);
+      if (!text) {
+        notify(messages.copyEmpty);
+        return;
+      }
+      // 与既有复制入口一致：先确认 API 存在，避免非安全上下文同步抛错逃出命令面板。
+      const clipboard = navigator.clipboard;
+      if (typeof clipboard?.writeText !== "function") {
+        notify(messages.copyFailed);
+        return;
+      }
+      // 剪贴板是异步 API；命令本身是同步 UI 行为，失败只提示，不向会话写内容。
+      void clipboard.writeText(text).then(
+        () => notify(messages.copySucceeded),
+        () => notify(messages.copyFailed),
+      );
+    },
+  };
+}
