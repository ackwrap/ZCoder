@@ -0,0 +1,36 @@
+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+import { formatTokenCount } from "../transcript.js";
+import type { ContextWindowUsage } from "../types.js";
+
+export function createContextCommand(
+  contextWindow: ContextWindowUsage | null,
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand {
+  const messages = getCompatMessages(locale);
+  return {
+    value: messages.context.value,
+    label: `/${messages.context.value}`,
+    description: messages.context.description,
+    keywords: messages.context.keywords,
+    run: () => {
+      if (!contextWindow || contextWindow.maxTokens <= 0) {
+        notify(messages.contextUnavailable);
+        return;
+      }
+      const used = Math.max(0, contextWindow.usedTokens);
+      const max = contextWindow.maxTokens;
+      const percent = `${((used / max) * 100).toFixed(1)}%`;
+      const autoCompactThresholdTokens = contextWindow.autoCompactThresholdTokens;
+      const autoCompactThreshold =
+        typeof autoCompactThresholdTokens === "number" && autoCompactThresholdTokens > 0
+          ? formatTokenCount(autoCompactThresholdTokens)
+          : null;
+      notify(
+        messages.contextSummary(formatTokenCount(used), formatTokenCount(max), percent, autoCompactThreshold),
+      );
+    },
+  };
+}
