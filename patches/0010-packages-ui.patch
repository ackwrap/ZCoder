@@ -0,0 +1,79 @@
+import { type ComponentProps, type ReactNode } from "react";
+import { ChevronDownIcon } from "lucide-react";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "@/components/ui/collapsible.js";
+import { cn } from "@/components/lib/utils.js";
+
+export interface InspectorCardProps extends Omit<
+  ComponentProps<typeof Collapsible>,
+  "children" | "defaultOpen" | "onOpenChange" | "open"
+> {
+  id: string;
+  title: string;
+  children: ReactNode;
+  /** 折叠触发器内的非交互状态内容（例如后台任务总数）。 */
+  trailing?: ReactNode;
+  /** 与折叠触发器同级的标题行操作。 */
+  actions?: ReactNode;
+  /** 展开内容的附加类名（例如滚动上限）。 */
+  contentClassName?: string;
+  /** 受控开合；省略时默认展开。 */
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+  /** 非受控时的初始开合；省略时默认展开。 */
+  defaultOpen?: boolean;
+}
+
+/**
+ * 信息栏卡片外壳。上下文、连接器、改动与后台任务共用同一套容器和标题行，
+ * 避免各卡随时间长出不同的圆角、内边距或折叠箭头。
+ */
+export function InspectorCard({
+  actions,
+  children,
+  className,
+  contentClassName,
+  defaultOpen = true,
+  id,
+  onOpenChange,
+  open,
+  title,
+  trailing,
+  ...collapsibleProps
+}: InspectorCardProps) {
+  return (
+    <Collapsible
+      {...collapsibleProps}
+      data-inspector-card={id}
+      defaultOpen={open === undefined ? defaultOpen : undefined}
+      open={open}
+      onOpenChange={onOpenChange}
+      className={cn("min-w-0 rounded-xl border border-card-border bg-card p-3", className)}
+    >
+      <div className="flex min-w-0 items-center gap-1">
+        <CollapsibleTrigger
+          data-testid={`inspector-${id}-trigger`}
+          className="group flex min-w-0 flex-1 items-center gap-1 text-left text-ui-sm text-foreground-subtle"
+        >
+          <span>{title}</span>
+          {trailing ? <span className="shrink-0 tabular-nums">{trailing}</span> : null}
+          <ChevronDownIcon
+            aria-hidden="true"
+            className="size-3.5 shrink-0 transition-transform group-data-[state=closed]:-rotate-90"
+          />
+        </CollapsibleTrigger>
+        {actions ? (
+          <div className="inline-flex shrink-0 items-center gap-1 text-ui-sm text-foreground-subtle">
+            {actions}
+          </div>
+        ) : null}
+      </div>
+      <CollapsibleContent>
+        <div className={cn("min-w-0 space-y-2 pt-2", contentClassName)}>{children}</div>
+      </CollapsibleContent>
+    </Collapsible>
+  );
+}
diff --git a/packages/ui/src/session-diagnostics/McpServerDiagnostics.tsx b/packages/ui/src/session-diagnostics/McpServerDiagnostics.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9ce30bebcd32e8ec257fa198ac7b3a5d657779aa
--- /dev/null
+++ b/packages/ui/src/session-diagnostics/McpServerDiagnostics.tsx
@@ -0,0 +1,59 @@
+import { useEffect, useState } from "react";
+import type { ZCodeMcpServer } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { resolveMcpFailureMessageId } from "@/settings/McpFailurePresentation.js";
+import { buildMcpDiagnosticReport } from "./projection.js";
+
+export function McpServerDiagnostics({ server }: { server: ZCodeMcpServer }) {
+  const { intl } = useZCodeIntl();
+  const [copyState, setCopyState] = useState<"idle" | "pending" | "copied" | "failed">("idle");
+  const report = buildMcpDiagnosticReport(server);
+  useEffect(() => setCopyState("idle"), [report]);
+  const label = (id: string) => intl.formatMessage({ id });
+  const copy = async () => {
+    setCopyState("pending");
+    try {
+      if (!navigator.clipboard?.writeText) throw new Error("clipboard-unavailable");
+      await navigator.clipboard.writeText(report);
+      setCopyState("copied");
+    } catch {
+      setCopyState("failed");
+    }
+  };
+  return (
+    <details className="mt-2 min-w-0 text-ui-sm" data-testid={`mcp-diagnostics-${server.id}`}>
+      <summary className="cursor-pointer rounded text-foreground-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-input-border-focused">
+        {label("chat.mcpStatus.details")}
+      </summary>
+      <div className="mt-2 space-y-2">
+        {server.status === "error" ? (
+          <p className="text-destructive">
+            {intl.formatMessage({ id: resolveMcpFailureMessageId(server.failureKind) })}
+          </p>
+        ) : null}
+        <p className="text-foreground-subtle">{label("chat.mcpStatus.redacted")}</p>
+        <pre className="max-h-48 overflow-auto whitespace-pre-wrap break-all rounded-md bg-surface p-2 font-mono text-ui-xs text-foreground-subtle select-text">
+          {report}
+        </pre>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          disabled={copyState === "pending"}
+          onClick={() => void copy()}
+        >
+          {label("chat.mcpStatus.copy")}
+        </Button>
+        {copyState === "copied" || copyState === "failed" ? (
+          <p
+            role="status"
+            className={copyState === "failed" ? "text-destructive" : "text-foreground-subtle"}
+          >
+            {label(`chat.mcpStatus.${copyState}`)}
+          </p>
+        ) : null}
+      </div>
+    </details>
+  );
+}
