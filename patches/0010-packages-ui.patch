@@ -0,0 +1,24 @@
+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+
+export function createExitCommand(
+  closeWindow: (() => void) | null,
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand {
+  const messages = getCompatMessages(locale);
+  return {
+    value: messages.exit.value,
+    label: `/${messages.exit.value}`,
+    description: messages.exit.description,
+    keywords: messages.exit.keywords,
+    run: () => {
+      if (!closeWindow) {
+        notify(messages.exitUnavailable);
+        return;
+      }
+      closeWindow();
+    },
+  };
+}
