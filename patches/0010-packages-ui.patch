+import { useState } from "react";
+import { createRoot } from "react-dom/client";
+import { useAutoCompactCommand } from "@/v4/slash-commands/autocompact.js";
+
+function Fixture() {
+  const [text, setText] = useState("/autocompact 100k");
+  const [feedback, setFeedback] = useState("");
+  const [value, setValue] = useState<number | null>(null);
+  const command = useAutoCompactCommand({
+    prepareInput: () => setText("/autocompact "),
+    enabled: true,
+    cliNames: new Set(),
+    notify: setFeedback,
+    execute: async (payload) => {
+      const next =
+        payload.limit === undefined ? value : payload.limit === null ? null : payload.limit.value;
+      setValue(next);
+      return {
+        commandId: "fixture",
+        status: "accepted",
+        result: {
+          type: "configureAutoCompact",
+          limit: next === null ? null : { unit: "tokens", value: next },
+          contextWindowTokens: 200000,
+          requestedThresholdTokens: next,
+          effectiveThresholdTokens: Math.min(next ?? 166000, 166000),
+        },
+      };
+    },
+  });
+  return (
+    <main>
+      <input aria-label="Command" value={text} onChange={(event) => setText(event.target.value)} />
+      <button
+        onClick={async () => {
+          if ((await command.run(text)) === "sent") setText("");
+        }}
+      >
+        Send
+      </button>
+      {command.commands.map((entry) => (
+        <button key={entry.value} onClick={entry.run}>
+          {entry.value}
+        </button>
+      ))}
+      <output>{feedback}</output>
+    </main>
+  );
+}
+createRoot(document.getElementById("root")!).render(<Fixture />);
diff --git a/packages/ui/test/browser/manual-review/pending/autocompact.test.mjs b/packages/ui/test/browser/manual-review/pending/autocompact.test.mjs
new file mode 100644
