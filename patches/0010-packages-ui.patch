@@ -0,0 +1,134 @@
+import type { IPlatformService } from "@zcode/shared";
+import { useEffect } from "react";
+import type { RequestSecurityWorkspaceTab } from "@/request-security.js";
+
+import { ServiceProvider, useServices } from "@/hooks/useServices.js";
+import { useWorkspaceServicesResolution } from "@/hooks/useWorkspaceServices.js";
+import { logger } from "@/logger.js";
+
+import { setCaptchaReporter, CAPTCHA_BUTTON_ID, CAPTCHA_CONTAINER_ID, CAPTCHA_MOUNT_ID } from "./captcha.js";
+import { cancelProviderRuntimeHeadersRequest, handleProviderRuntimeHeadersRequest } from "./bridge.js";
+
+/**
+ * 验证码宿主：阿里云 SDK 需要一个真实 DOM 容器 + 一个可点击的 button
+ * （无感失败后靠点它拉起弹窗）。这个组件只负责把三个节点挂上去，逻辑全在 captcha.ts。
+ */
+export function RequestSecurityHost() {
+  return (
+    <div
+      id={CAPTCHA_CONTAINER_ID}
+      aria-hidden="true"
+      className="fixed left-0 top-0 z-[2147483647] h-0 w-0 overflow-visible"
+    >
+      <div id={CAPTCHA_MOUNT_ID} className="absolute left-0 top-0 h-0 w-0 overflow-visible" />
+      <button
+        id={CAPTCHA_BUTTON_ID}
+        type="button"
+        tabIndex={-1}
+        aria-hidden="true"
+        className="fixed left-1/2 top-1/2 h-px w-px -translate-x-1/2 -translate-y-1/2 border-0 p-0 opacity-0"
+      />
+    </div>
+  );
+}
+
+/** ARMS 上报出口：Root 挂载时把 platform 注进来。 */
+export function setRequestSecurityReporter(reporter: IPlatformService | null): void {
+  setCaptchaReporter(reporter);
+}
+
+/**
+ * 单个 workspace 的鉴权桥：订阅 Agent 的 provider 运行时头请求 / 取消通知。
+ *
+ * 必须是 workspace 级订阅（不是 session 级）：web 远控新建的会话在桌面没有 pane，
+ * 只有 workspace 级订阅能在没有任何打开中的会话视图时也应答。
+ */
+function WorkspaceProviderRuntimeAuthBridge({
+  workspacePath,
+  workspaceIdentity,
+}: {
+  workspacePath: string;
+  workspaceIdentity?: string;
+}) {
+  const services = useServices();
+
+  useEffect(() => {
+    const target = workspaceIdentity ? { workspacePath, workspaceIdentity } : { workspacePath };
+    const requested = services.zcodeAgentService.onDynamicWorkspaceProviderRuntimeHeadersRequest(target)(
+      (request) => {
+        void handleProviderRuntimeHeadersRequest({
+          request,
+          zcodeAgentService: services.zcodeAgentService,
+          codingPlanSubscriptionService: services.codingPlanSubscriptionService,
+          providerSettingsService: services.providerSettingsService,
+        }).catch((error: unknown) => {
+          logger.warn("[captcha] provider runtime headers response failed", {
+            error: error instanceof Error ? error.message : String(error),
+            providerId: request.providerId,
+            requestId: request.requestId,
+            sessionId: request.sessionId,
+          });
+        });
+      },
+    );
+    const cancelled = services.zcodeAgentService.onDynamicWorkspaceProviderRuntimeHeadersCancelled(
+      target,
+    )((request) => {
+      cancelProviderRuntimeHeadersRequest(request);
+    });
+    return () => {
+      requested.dispose();
+      cancelled.dispose();
+    };
+  }, [services, workspacePath, workspaceIdentity]);
+
+  return null;
+}
+
+function WorkspaceTabAuthBridge({ tab }: { tab: RequestSecurityWorkspaceTab }) {
+  const resolution = useWorkspaceServicesResolution(
+    tab.workspacePath,
+    tab.remoteSessionId,
+    tab.workspaceIdentity,
+    tab.remoteTarget,
+  );
+  if (!resolution.rpcReady) return null;
+  return (
+    <ServiceProvider services={resolution.services}>
+      <WorkspaceProviderRuntimeAuthBridge
+        workspacePath={tab.workspacePath}
+        {...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {})}
+      />
+    </ServiceProvider>
+  );
+}
+
+function workspaceKeyOf(tab: RequestSecurityWorkspaceTab): string {
+  return tab.workspaceIdentity?.trim() || tab.workspacePath;
+}
+
+/**
+ * 桌面唯一权威：为每个打开的 workspace 起一个鉴权桥；Web 端不挂（Root 里已按 isDesktop 门控）。
+ * 同一个 workspace 的多个 tab 只保留一个订阅者，避免重复跑验证码。
+ */
+export function RequestSecurityWorkspaceBridge({
+  workspaceTabs,
+}: {
+  workspaceTabs: readonly RequestSecurityWorkspaceTab[];
+}) {
+  const unique: RequestSecurityWorkspaceTab[] = [];
+  const seen = new Set<string>();
+  for (const tab of workspaceTabs) {
+    const key = workspaceKeyOf(tab);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    unique.push(tab);
+  }
+  return (
+    <>
+      {unique.map((tab) => (
+        <WorkspaceTabAuthBridge key={workspaceKeyOf(tab)} tab={tab} />
+      ))}
+    </>
+  );
+}
