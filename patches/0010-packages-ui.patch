+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { formatCompactTokenNumber } from "@/lib/tokenNumberFormat.js";
+import type { ConfiguredContext, ContextUsageDiagnostic } from "./types.js";
+import { resolveContextBudget } from "./projection.js";
+
+export function ContextDiagnostics({
+  configured,
+  usage,
+}: {
+  configured?: ConfiguredContext | null;
+  usage?: ContextUsageDiagnostic | null;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const label = (id: string) => intl.formatMessage({ id });
+  const tokens = (value: number) => formatCompactTokenNumber(locale, value);
+  const budget = resolveContextBudget(usage);
+  if (!configured && !budget) return null;
+  return (
+    <section
+      className="space-y-2 text-ui-sm text-foreground-subtle"
+      data-testid="context-diagnostics"
+    >
+      {configured ? (
+        <div
+          className="space-y-1"
+          data-testid="context-configured-window"
+          data-source={configured.source}
+          data-model={configured.model}
+        >
+          <div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
+            <span>{label("chat.contextDiagnostics.configured")}</span>
+            <span className="font-mono text-foreground">{tokens(configured.size)}</span>
+          </div>
+          <div className="break-words">
+            {configured.model} · {label(`chat.contextDiagnostics.source.${configured.source}`)}
+          </div>
+        </div>
+      ) : null}
+      {budget ? (
+        <dl
+          className="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1"
+          data-testid="context-compact-budget"
+        >
+          <dt>{label("chat.contextDiagnostics.threshold")}</dt>
+          <dd className="font-mono text-foreground">{tokens(budget.threshold)}</dd>
+          <dt>{label("chat.contextDiagnostics.remaining")}</dt>
+          <dd className="font-mono text-foreground">{tokens(budget.remaining)}</dd>
+        </dl>
+      ) : null}
+    </section>
+  );
+}
