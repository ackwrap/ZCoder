+    })!;
+    const button = tree.props.children as ReactElement<{ onClick: () => void }>;
+    button.props.onClick();
+    expect(onOpen).toHaveBeenCalledExactlyOnceWith({
+      rootSessionId: "s1",
+      parentSessionId: "s1",
