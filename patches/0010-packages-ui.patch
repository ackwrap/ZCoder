+        settings: {
+          modelSystemPromptAppends: [entry("a", "external-new-a"), entry("b", "old-b")],
+        },
+        onUpdateSettings: update,
+      }),
+    );
+    expect((screen.getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement).value).toBe(
+      "newer-edit",
+    );
+  });
+
+  it("waits for an unmatched save then cleans when props catches up", async () => {
+    let release!: () => void;
+    const firstWrite = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const writes: ModelSystemPromptEntry[][] = [];
+    const update = vi.fn(async (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {
+      writes.push(patch.modelSystemPromptAppends);
+      if (writes.length === 1) await firstWrite;
+    });
+
+    const view = renderSection([entry("a", "old-a"), entry("b", "old-b")], update);
+    await openDialog();
+    await expectTextareaValue("old-a");
+    await setText("saved-a");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+    await waitFor(() => expect(writes).toHaveLength(1));
+
+    // resolve 时 props 仍是 old-a：保留 overlay/committed，不 clean 成旧值。
+    await act(async () => {
+      release();
+      await firstWrite;
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    await waitFor(() => expect(screen.queryByTestId("model-system-prompt-dialog")).toBeNull());
+    await openDialog();
+    await expectTextareaValue("saved-a");
+
+    view.rerender(
+      createElement(ModelSystemPromptsSettingsSection, {
+        settings: {
+          modelSystemPromptAppends: [entry("a", "saved-a"), entry("b", "old-b")],
+        },
