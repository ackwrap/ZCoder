new file mode 100644
index 0000000000000000000000000000000000000000..df1660fd5631771fed6f770a5057ffae693b050d
--- /dev/null
+++ b/packages/ui/src/side-pane-viewer-tabs/fileViewerDirtyRegistry.ts
@@ -0,0 +1,40 @@
+const dirtyFileViewerTabIds = new Set<string>();
+const listeners = new Set<() => void>();
+let dirtyVersion = 0;
+
+function emitDirtyChange(): void {
+  dirtyVersion += 1;
+  for (const listener of listeners) {
+    listener();
+  }
+}
+
+export function isFileViewerDirty(tabId: string): boolean {
+  return dirtyFileViewerTabIds.has(tabId);
+}
+
+export function setFileViewerDirty(tabId: string, dirty: boolean): void {
+  const wasDirty = dirtyFileViewerTabIds.has(tabId);
+  if (wasDirty === dirty) return;
+  if (dirty) {
+    dirtyFileViewerTabIds.add(tabId);
+  } else {
+    dirtyFileViewerTabIds.delete(tabId);
+  }
+  emitDirtyChange();
+}
+
+export function clearFileViewerDirty(tabId: string): void {
+  setFileViewerDirty(tabId, false);
+}
+
+export function subscribeFileViewerDirty(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function getFileViewerDirtyVersion(): number {
+  return dirtyVersion;
+}
