+// @vitest-environment jsdom
+import { createElement } from "react";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import {
+  ModelSystemPromptsSettingsSection,
+  modelSystemPromptEntryKey,
+} from "@/settings/model-system-prompts/index.js";
+import type { ModelSystemPromptEntry } from "@zcode/shared";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({ intl: { formatMessage: ({ id }: { id: string }) => id } }),
+}));
+const services = vi.hoisted(() => ({
+  modelSelectionService: {
+    getView: async () => ({
+      providers: [
+        {
+          providerId: "provider-a",
+          providerName: "Same Name",
+          models: [{ modelId: "same-model" }],
+        },
+        {
+          providerId: "provider-b",
+          providerName: "Same Name",
+          models: [{ modelId: "same-model" }],
+        },
+      ],
+    }),
+  },
+}));
+vi.mock("@/hooks/useServices.js", () => ({ useServices: () => services }));
+afterEach(cleanup);
+
+it("isolates identical model IDs and provider display names across selection, save, cancel and empty removal", async () => {
+  const a = { providerId: "provider-a", modelId: "same-model", text: "prompt A" };
+  const b = { providerId: "provider-b", modelId: "same-model", text: "prompt B" };
+  const update = vi.fn(
+    async (_patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {},
+  );
+  const view = render(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: [a, b] },
+      onUpdateSettings: update,
+    }),
+  );
+  await waitFor(() =>
+    expect(
+      (screen.getByTestId("model-system-prompt-open-dialog") as HTMLButtonElement).disabled,
+    ).toBe(false),
+  );
+  const choose = (provider: string) =>
+    fireEvent.change(screen.getByTestId("model-system-prompt-model-select"), {
+      target: { value: modelSystemPromptEntryKey(provider, "same-model") },
+    });
+  const open = () => fireEvent.click(screen.getByTestId("model-system-prompt-open-dialog"));
+  const text = () => screen.getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement;
+  const cancel = () => fireEvent.click(screen.getByTestId("model-system-prompt-cancel"));
+
+  choose("provider-a");
+  open();
+  expect(text().value).toBe("prompt A");
+  fireEvent.change(text(), { target: { value: "discard A" } });
+  cancel();
+  choose("provider-b");
+  open();
+  expect(text().value).toBe("prompt B");
+  fireEvent.change(text(), { target: { value: "discard B" } });
+  cancel();
+  expect(update).not.toHaveBeenCalled();
+
+  choose("provider-a");
+  open();
+  expect(text().value).toBe("prompt A");
+  fireEvent.change(text(), { target: { value: "saved A" } });
+  await act(async () => fireEvent.click(screen.getByTestId("model-system-prompt-save")));
+  expect(update).toHaveBeenNthCalledWith(1, {
+    modelSystemPromptAppends: [{ ...a, text: "saved A" }, b],
+  });
+  view.rerender(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: [{ ...a, text: "saved A" }, b] },
+      onUpdateSettings: update,
+    }),
+  );
+  choose("provider-b");
+  open();
+  expect(text().value).toBe("prompt B");
+  cancel();
+  choose("provider-a");
+  open();
+  expect(text().value).toBe("saved A");
+  fireEvent.change(text(), { target: { value: "" } });
+  await act(async () => fireEvent.click(screen.getByTestId("model-system-prompt-save")));
+  expect(update).toHaveBeenNthCalledWith(2, { modelSystemPromptAppends: [b] });
+  view.rerender(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: [b] },
+      onUpdateSettings: update,
+    }),
+  );
+  choose("provider-b");
+  open();
+  expect(text().value).toBe("prompt B");
+  cancel();
+  expect(update).toHaveBeenCalledTimes(2);
+});
