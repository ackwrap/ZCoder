+import { describe, expect, it } from "vitest";
+import { resolveReadScope, type ReadScopeSource } from "./contract.js";
+import { readScopeUiModule } from "./module.js";
+
+const base: ReadScopeSource = {
+  input: { file_path: "/workspace/example.ts" },
+  output: "1\tfirst\n2\tsecond",
+  status: "completed",
+};
+
+describe("read-scope-ui contract", () => {
+  it("declares its module manifest", () => {
+    expect(readScopeUiModule.id).toBe("read-scope-ui");
+  });
+
+  it("marks confirmed unbounded text as full", () => {
+    expect(resolveReadScope(base)).toEqual({ kind: "full", truncated: false });
+  });
+
+  it.each([
+    [0, "0\tfirst", 0, 1],
+    [200, "200\tfirst\n201\tsecond", 200, 2],
+  ] as const)(
+    "preserves offset %s and actual line count",
+    (offset, output, expectedOffset, lines) => {
+      expect(
+        resolveReadScope({
+          ...base,
+          input: { file_path: "/workspace/example.ts", offset, limit: 59 },
+          output,
+        }),
+      ).toEqual({ kind: "range", offset: expectedOffset, lines, truncated: false });
+    },
+  );
+
+  it("recognizes full coverage from structured counts even with explicit limit", () => {
+    expect(
+      resolveReadScope({
+        ...base,
+        input: { file_path: "/workspace/example.ts", limit: 100 },
+        output: { type: "text", startLine: 1, numLines: 2, totalLines: 2 },
+      }),
+    ).toEqual({ kind: "full", truncated: false });
+  });
+
+  it.each([true, false])(
+    "does not equate a structured range with full coverage (truncated=%s)",
+    (truncated) => {
+      expect(
+        resolveReadScope({
+          ...base,
+          output: { type: "text", startLine: 1, numLines: 2, totalLines: 8, truncated },
+        }),
+      ).toEqual({ kind: "range", offset: 1, lines: 2, truncated });
+    },
+  );
+
+  it("recognizes serialized structured results", () => {
+    expect(
+      resolveReadScope({
+        ...base,
+        output: JSON.stringify({ type: "text", startLine: 200, numLines: 0, totalLines: 100 }),
+      }),
+    ).toEqual({ kind: "range", offset: 200, lines: 0, truncated: false });
+  });
+
+  it("supports legacy raw input and structured raw output", () => {
+    expect(
+      resolveReadScope({
+        input: undefined,
+        status: "completed",
+        raw: {
+          rawInput: { filePath: "/workspace/example.ts", offset: 3, limit: 8 },
+          rawOutput: { type: "text", startLine: 3, numLines: 4, totalLines: 6 },
+        },
+      }),
+    ).toEqual({ kind: "range", offset: 3, lines: 4, truncated: false });
+  });
+
+  it("retains requested ranges for unchanged results without actual counts", () => {
+    expect(
+      resolveReadScope({
+        ...base,
+        input: { file_path: "/workspace/example.ts", offset: 3 },
+        output: "Wasted call — file unchanged since your last Read.",
+      }),
+    ).toEqual({ kind: "request-range", offset: 3, truncated: false });
+  });
+
+  it.each(["pending", "in_progress", "failed", "stopped"])(
+    "never claims actual coverage for %s",
+    (status) => {
+      expect(resolveReadScope({ ...base, status })).toEqual({
+        kind: "request-full",
+        truncated: false,
+      });
+    },
+  );
+
+  it("does not label incomplete input previews", () => {
+    expect(resolveReadScope({ ...base, raw: { inputPreviewComplete: false } })).toBeNull();
+  });
+
+  it("does not infer complete coverage from discontinuous text", () => {
+    expect(resolveReadScope({ ...base, output: "1\tfirst\n800\tlast" })).toEqual({
+      kind: "request-full",
+      truncated: false,
+    });
+  });
+
+  it.each(["1\tfirst\n…", "Read stopped\n1\tfirst", "1\tfirst\nunknown tail"])(
+    "does not infer actual coverage from mixed or cut-off text %s",
+    (output) => {
+      expect(resolveReadScope({ ...base, output })).toEqual({
+        kind: "request-full",
+        truncated: false,
+      });
+    },
+  );
+
+  it.each([0, 1])("recognizes an unbounded read from offset %s as full", (offset) => {
+    expect(
+      resolveReadScope({ ...base, input: { file_path: "/workspace/example.ts", offset } }),
+    ).toEqual({ kind: "full", truncated: false });
+  });
+
+  it.each([
+    "<system-reminder>Warning: the file exists but the contents are empty.</system-reminder>",
+    "<system-reminder>Warning: the file exists but is shorter than the provided offset (200). The file has 100 lines.</system-reminder>",
+  ])("keeps warning-only output conservative", (output) => {
+    expect(resolveReadScope({ ...base, output })).toEqual({
+      kind: "request-full",
+      truncated: false,
+    });
+  });
+
+  it.each(["image.png", "report.pdf", "video.mp4", "book.ipynb"])(
+    "excludes media path %s",
+    (name) => {
+      expect(resolveReadScope({ ...base, input: { file_path: `/workspace/${name}` } })).toBeNull();
+    },
+  );
+
+  it.each([
+    { output: { type: "directory" } },
+    { output: "<path>/workspace</path>\n<type>directory</type>\n<content>example.ts</content>" },
+    { input: { file_path: "/workspace", fileType: "directory" } },
+  ])("does not label directory projections %j", (overrides) => {
+    expect(resolveReadScope({ ...base, ...overrides })).toBeNull();
+  });
+
+  it.each([
+    { file_path: "/workspace", type: "directory" },
+    { file_path: "/workspace/example.ts", offset: -1 },
+    { file_path: "/workspace/example.ts", limit: 0 },
+    { parsed_cmd: [{ type: "read", path: "example.ts" }] },
+  ])("omits unsupported or invalid inputs %j", (input) => {
+    expect(resolveReadScope({ ...base, input })).toBeNull();
+  });
+});
