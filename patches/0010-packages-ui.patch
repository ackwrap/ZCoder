+      notify: vi.fn(),
+      forkLatest: null,
+      closeWindow: null,
+    };
+    expect(buildCompatSlashCommands(deps).some((item) => item.value === "model")).toBe(false);
+    expect(
+      buildCompatSlashCommands({ ...deps, openModelMenu: () => true }).filter((item) =>
+        ["model", "effort"].includes(item.value),
+      ),
+    ).toHaveLength(2);
+  });
+});
