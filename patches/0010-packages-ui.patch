+# 当前会话资源控制 UI
+
+接收权威 snapshot 的 state 与 SessionPane 绑定的 V4 send。只保存请求状态，不乐观改写资源开关、不调用设置 store。父级以工作区 identity/session/epoch 作为 React key；卸载后忽略异步结果。无能力或读取失败显示可重试通用错误，不显示原始服务错误/连接配置。只读视图不发送命令。
+
+两组列表复用 Collapsible/Switch，键盘可用，各自限高滚动，随原状态栏响应式收起。完整产品规则见根 `docs/session-resource-controls.md`。
diff --git a/packages/ui/src/session-resource-controls/SessionResourceControls.tsx b/packages/ui/src/session-resource-controls/SessionResourceControls.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b4618d6b7f5d331ba0b1bdb09277c70fd7f9e4de
--- /dev/null
+++ b/packages/ui/src/session-resource-controls/SessionResourceControls.tsx
@@ -0,0 +1,146 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { ChevronDownIcon, RefreshCwIcon } from "lucide-react";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "@/components/ui/collapsible.js";
+import { Button } from "@/components/ui/button.js";
+import { Switch } from "@/components/ui/switch.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { SessionResourceControlsProps } from "./types.js";
+
+export function SessionResourceControls({
+  state,
+  ready,
+  readOnly,
+  userResourcesOnly = false,
+  send,
+}: SessionResourceControlsProps) {
+  const { intl } = useZCodeIntl();
+  // 只读投影：内置/插件条目由 runtime 标记来源，这里仅决定是否展示，不改变策略与开关语义。
+  const selectItems = (items: NonNullable<typeof state>["skills"] | undefined) =>
+    userResourcesOnly ? items?.filter((item) => (item.source ?? "user") === "user") : items;
+  const [pending, setPending] = useState(false);
+  const [failed, setFailed] = useState(false);
+  const mounted = useRef(false);
+  const generation = useRef(0);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+      generation.current += 1;
+    };
+  }, []);
+  const request = useCallback(
+    async (kind?: "skill" | "mcp", id?: string, enabled?: boolean) => {
+      const requestGeneration = ++generation.current;
+      setPending(true);
+      setFailed(false);
+      try {
+        const ack = await send(
+          kind ? "setSessionResource" : "getSessionResources",
+          kind ? { kind, id, enabled } : {},
+        );
+        if (ack.status !== "accepted" && ack.status !== "duplicate" && ack.status !== "noop")
+          throw new Error("resource command failed");
+      } catch {
+        if (mounted.current && requestGeneration === generation.current) setFailed(true);
+      } finally {
+        if (mounted.current && requestGeneration === generation.current) setPending(false);
+      }
+    },
+    [send],
+  );
+  useEffect(() => {
+    if (ready && !readOnly) void request();
+  }, [ready, readOnly, request]);
+  if (readOnly) return null;
+  return (
+    <section
+      data-testid="session-resource-controls"
+      aria-busy={pending}
+      className="min-w-0 border-t border-border pt-2"
+    >
+      <div className="flex min-w-0 items-center justify-between gap-2 px-2 text-ui-sm text-foreground-subtlest">
+        <span>{intl.formatMessage({ id: "chat.resources.scope" })}</span>
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon-sm"
+          className="size-6"
+          disabled={!ready || pending}
+          aria-label={intl.formatMessage({ id: "chat.resources.refresh" })}
+          onClick={() => void request()}
+        >
+          <RefreshCwIcon className="size-3.5" />
+        </Button>
+      </div>
+      {failed ? (
+        <p role="alert" className="px-2 py-1 text-ui-sm text-warning">
+          {intl.formatMessage({ id: "chat.resources.error" })}
+        </p>
+      ) : null}
+      {!state ? (
+        <p className="px-2 py-1 text-ui-sm text-foreground-subtlest">
+          {intl.formatMessage({
+            id: pending ? "chat.resources.loading" : "chat.resources.unavailable",
+          })}
+        </p>
+      ) : null}
+      {(
+        [
+          // 规格 docs/session-context-and-mcp-diagnostics.md「右侧会话信息栏」：MCP 在前、Skills 在后。
+          ["mcp", "MCP", selectItems(state?.mcpServers)],
+          ["skill", "Skills", selectItems(state?.skills)],
+        ] as const
+      ).map(([kind, label, items]) => (
+        // 分组默认折叠：长 Skills 列表会把整张卡片撑满，展开交给用户。
+        <Collapsible key={kind} className="min-w-0" data-resource-group={kind}>
+          <CollapsibleTrigger className="flex h-8 w-full items-center gap-1.5 px-2 text-left text-ui-base text-foreground-subtle">
+            <ChevronDownIcon className="size-3.5" />
+            <span>{label}</span>
+            {items ? (
+              <span className="text-ui-sm text-foreground-subtlest">
+                {items.filter((item) => item.enabled).length}/{items.length}
+              </span>
+            ) : null}
+          </CollapsibleTrigger>
+          <CollapsibleContent>
+            {/* 列表项与分组标题左对齐：标题的 px-2 加上 chevron(14px) 与 gap-1.5(6px)，
+                否则开关行会比标题更靠左，读起来像脱出层级。 */}
+            <div className="max-h-48 min-w-0 overflow-x-hidden overflow-y-auto px-2 pb-1">
+              {items?.length === 0 ? (
+                <p className="py-1 pl-5 text-ui-sm text-foreground-subtlest">
+                  {intl.formatMessage({ id: "chat.resources.empty" })}
+                </p>
+              ) : null}
+              {items?.map((item) => (
+                <div
+                  key={item.id}
+                  className="flex min-w-0 items-center justify-between gap-3 py-1.5 pl-5"
+                >
+                  <span title={item.label} className="min-w-0 truncate text-ui-sm text-foreground">
+                    {item.label}
+                  </span>
+                  <Switch
+                    data-resource-id={item.id}
+                    data-resource-kind={kind}
+                    size="sm"
+                    checked={item.enabled}
+                    disabled={!ready || pending || failed || !item.available}
+                    aria-label={intl.formatMessage(
+                      { id: "chat.resources.toggle" },
+                      { name: item.label },
+                    )}
+                    onCheckedChange={(enabled) => void request(kind, item.id, enabled)}
+                  />
+                </div>
+              ))}
+            </div>
+          </CollapsibleContent>
+        </Collapsible>
+      ))}
+    </section>
+  );
+}
