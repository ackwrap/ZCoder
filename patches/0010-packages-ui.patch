+// @vitest-environment jsdom
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ModelSystemPromptEntry } from "@zcode/shared";
+import {
+  attachModelSystemPromptToSubmission,
+  freezeModelSystemPromptEntries,
+  isModelSystemPromptEnabled,
+  promoteModelSystemPromptDraftFlag,
+  readFrozenModelSystemPrompt,
+  rememberFrozenModelSystemPrompt,
+  resolveModelSystemPromptScope,
+  resolveModelSystemPromptSubmission,
+  resolveModelSystemPromptSubmissionForHost,
+  setModelSystemPromptEnabled,
+} from "./index.js";
+import { exampleComposerModelSystemPrompt } from "./contract.example.js";
+import { composerModelSystemPromptModule } from "./module.js";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    intl: { formatMessage: ({ id }: { id: string }) => id },
+  }),
+}));
+vi.mock("@/ControlHintTooltip.js", () => ({
+  ControlHintTooltip: ({ children }: { children?: unknown }) => children,
+}));
+
+const ENTRY: ModelSystemPromptEntry = {
+  providerId: "Provider",
+  modelId: "Model",
+  text: "  first\r\n  second  ",
+};
+
+function installStorage(options: { throwOnSet?: boolean } = {}): Map<string, string> {
+  const values = new Map<string, string>();
+  const storage: Storage = {
+    get length() {
+      return values.size;
+    },
+    clear: () => values.clear(),
+    getItem: (key: string) => values.get(key) ?? null,
+    key: (index: number) => [...values.keys()][index] ?? null,
+    removeItem: (key: string) => {
+      values.delete(key);
+    },
+    setItem: (key: string, value: string) => {
+      if (options.throwOnSet) throw new Error("quota exceeded");
+      values.set(key, value);
+    },
+  };
+  Object.defineProperty(window, "localStorage", {
+    configurable: true,
+    value: storage,
+  });
+  return values;
+}
+
+describe("composer-model-system-prompt contract", () => {
+  beforeEach(() => {
+    installStorage();
+  });
+
+  it("declares its managed module manifest", () => {
+    expect(composerModelSystemPromptModule).toMatchObject({
+      id: "composer-model-system-prompt",
+      requires: ["shared", "ui"],
+      publicEntrypoints: ["index.ts"],
+    });
+  });
+
+  it("defaults every new session to off and isolates sessions", () => {
+    const sessionOne = resolveModelSystemPromptScope("/workspace/one", undefined, "session-1")!;
+    const sessionTwo = resolveModelSystemPromptScope("/workspace/one", undefined, "session-2")!;
+    expect(isModelSystemPromptEnabled(sessionOne)).toBe(false);
+    expect(isModelSystemPromptEnabled(sessionTwo)).toBe(false);
+
+    setModelSystemPromptEnabled(sessionOne, true);
+    expect(isModelSystemPromptEnabled(sessionOne)).toBe(true);
+    expect(isModelSystemPromptEnabled(sessionTwo)).toBe(false);
+  });
+
+  it("promotes the frozen draft owner without reading or deleting a newer root", () => {
+    const draft = resolveModelSystemPromptScope("/workspace/promote", undefined, null, "gen-1")!;
+    setModelSystemPromptEnabled(draft, true);
+    const binding = {
+      workspacePath: "/workspace/promote",
+      draftOwnerKey: "gen-1",
+      enabled: true,
+      revision: 1,
+    };
+
+    expect(
+      promoteModelSystemPromptDraftFlag({
+        binding,
+        targetSessionId: "created-session",
+      }),
+    ).toBe(true);
+    const real = resolveModelSystemPromptScope("/workspace/promote", undefined, "created-session")!;
+    expect(isModelSystemPromptEnabled(real)).toBe(true);
+    expect(isModelSystemPromptEnabled(draft)).toBe(false);
+
+    // 导航已切到新 root：迟到 ACK 只清冻结的 gen-1，不得翻转/删除 gen-2。
+    const newerDraft = resolveModelSystemPromptScope(
+      "/workspace/promote",
+      undefined,
+      null,
+      "gen-2",
+    )!;
+    setModelSystemPromptEnabled(newerDraft, true);
+    expect(
+      promoteModelSystemPromptDraftFlag({
+        binding,
+        targetSessionId: "duplicate-session",
+      }),
+    ).toBe(true);
+    expect(isModelSystemPromptEnabled(newerDraft)).toBe(true);
+    // 同 session 重复 ACK 幂等。
+    expect(
+      promoteModelSystemPromptDraftFlag({
+        binding,
+        targetSessionId: "created-session",
+      }),
+    ).toBe(true);
+    expect(isModelSystemPromptEnabled(real)).toBe(true);
+  });
+
+  it("keeps the current option when localStorage cannot persist", () => {
+    installStorage({ throwOnSet: true });
+    const scope = resolveModelSystemPromptScope("/workspace/storage-failure", undefined, "s")!;
+    setModelSystemPromptEnabled(scope, true);
+    expect(isModelSystemPromptEnabled(scope)).toBe(true);
+  });
+
+  it("resolves exactly one normalized entry for the current model only", () => {
+    expect(
+      resolveModelSystemPromptSubmission({
+        entries: [ENTRY],
+        enabled: true,
+        selection: { providerId: "Provider", modelId: "Model" },
+      }),
+    ).toEqual({
+      modelSystemPromptEnabled: true,
+      modelSystemPrompt: {
+        providerId: "Provider",
+        modelId: "Model",
+        text: "first\n  second",
+      },
+    });
+
+    for (const selection of [
+      { providerId: "provider", modelId: "Model" },
+      { providerId: "Provider", modelId: "model" },
+      { providerId: "Provider", modelId: "Other" },
+    ]) {
+      expect(
+        resolveModelSystemPromptSubmission({ entries: [ENTRY], enabled: true, selection }),
+      ).toEqual({ modelSystemPromptEnabled: false });
+    }
+  });
+
+  it("emits explicit false when disabled or when the matched text is empty", () => {
+    expect(
+      resolveModelSystemPromptSubmission({
+        entries: [ENTRY],
+        enabled: false,
+        selection: { providerId: "Provider", modelId: "Model" },
+      }),
+    ).toEqual({ modelSystemPromptEnabled: false });
+
+    const blank = { ...ENTRY, text: " \r\n\t " };
+    const result = resolveModelSystemPromptSubmission({
+      entries: [blank],
+      enabled: true,
+      selection: { providerId: "Provider", modelId: "Model" },
+    });
+    expect(result).toEqual({ modelSystemPromptEnabled: false });
+    expect("modelSystemPrompt" in result).toBe(false);
+  });
+
+  it("omits both fields entirely for a host without the capability", () => {
+    expect(
+      resolveModelSystemPromptSubmissionForHost({
+        hostSupported: false,
+        entries: [ENTRY],
+        enabled: true,
+        selection: { providerId: "Provider", modelId: "Model" },
+      }),
+    ).toBeUndefined();
+    // 支持 capability 的 host 才发显式 false；旧 host 连 false 都不能发。
+    expect(
+      resolveModelSystemPromptSubmissionForHost({
+        hostSupported: true,
+        entries: [ENTRY],
+        enabled: false,
+        selection: { providerId: "Provider", modelId: "Model" },
+      }),
+    ).toEqual({ modelSystemPromptEnabled: false });
+  });
+
+  it("freezes a snapshot that later edits cannot change", () => {
+    const entries = [{ ...ENTRY }];
+    const fields = resolveModelSystemPromptSubmission({
+      entries,
+      enabled: true,
+      selection: { providerId: "Provider", modelId: "Model" },
+    });
+    const attached = attachModelSystemPromptToSubmission(
+      { modelSelection: { providerId: "Provider", modelId: "Model" }, mode: "build" },
+      fields,
+    );
+    entries[0]!.text = "changed later";
+    expect(attached.modelSystemPrompt?.text).toBe("first\n  second");
+    expect(Object.isFrozen(attached)).toBe(true);
+
+    const frozen = {
+      enabled: true,
+      entries: freezeModelSystemPromptEntries(entries),
+    };
+    rememberFrozenModelSystemPrompt(attached, frozen);
+    expect(readFrozenModelSystemPrompt(attached)).toBe(frozen);
+  });
+
+  it("strips a previously attached prompt when the new fields carry none", () => {
+    const withPrompt = attachModelSystemPromptToSubmission(
+      { modelSelection: { providerId: "Provider", modelId: "Model" }, mode: "build" },
+      {
+        modelSystemPromptEnabled: true,
+        modelSystemPrompt: ENTRY,
+      },
+    );
+    const switched = attachModelSystemPromptToSubmission(
+      { ...withPrompt, modelSelection: { providerId: "Provider", modelId: "Other" } },
+      { modelSystemPromptEnabled: false },
+    );
+    expect(switched.modelSystemPromptEnabled).toBe(false);
+    expect(Object.hasOwn(switched, "modelSystemPrompt")).toBe(false);
+  });
+
+  it("covers the draft-to-session example without leaking into the next task", () => {
+    const result = exampleComposerModelSystemPrompt({
+      workspacePath: "/workspace/example",
+      modelId: "Model",
+      entries: [{ ...ENTRY, providerId: "provider-a" }],
+      targetSessionId: "example-session",
+    });
+    expect(result?.submission).toMatchObject({ modelSystemPromptEnabled: true });
+    expect(result?.realSessionEnabled).toBe(true);
+    expect(result?.nextDraftEnabled).toBe(false);
+  });
+});
