diff --git a/packages/ui/src/McpStatusDialog.tsx b/packages/ui/src/McpStatusDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6f932283700ac2d30b95f912ac5083c0d7a37382
--- /dev/null
+++ b/packages/ui/src/McpStatusDialog.tsx
@@ -0,0 +1,265 @@
+import { RefreshCwIcon } from "lucide-react";
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { ZCodeMcpServer, ZCodeMcpListMode } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { useBaseWorkspaceServices } from "@/hooks/useWorkspaceServices.js";
+import { logger } from "@/logger.js";
+import { useMcpStore } from "@/store/mcpStore.js";
+import { useOptionalTabStore } from "@/store/TabStoreProvider.js";
+import { setPendingSettingsPluginIntent } from "@/lib/settingsNavigation.js";
+import { refreshMcpServerStatusList } from "@/settings/McpSettingsSection.js";
+import { McpServerDiagnostics, sanitizeMcpDiagnosticText } from "@/session-diagnostics/contract.js";
+
+function resolveTransportLabel(server: ZCodeMcpServer): string {
+  if (server.config.command) {
+    return "stdio";
+  }
+  return server.config.type ?? (server.config.url ? "http" : "?");
+}
+
+function resolveStatusMessageId(server: ZCodeMcpServer): string {
+  if (!server.enabled) {
+    return "chat.mcpStatus.status.disabled";
+  }
+  switch (server.status) {
+    case "connected":
+      return "chat.mcpStatus.status.connected";
+    case "connecting":
+      return "chat.mcpStatus.status.connecting";
+    case "error":
+      return "chat.mcpStatus.status.error";
+    default:
+      return "chat.mcpStatus.status.disconnected";
+  }
+}
+
+/**
+ * `/mcp`（别名 `/mcps`）的轻量状态面板。
+ *
+ * 只消费现有的 mcpStore 服务器与状态快照，不新增第二份 MCP 状态来源；
+ * 刷新复用 settings 页同一条 `mcp/list` 链路（列表 → mergeServerStatusSnapshots）。
+ * 完整增删改仍留在 设置 → 插件 → MCP。
+ */
+export function McpStatusDialog({
+  open,
+  onOpenChange,
+  workspacePath,
+  workspaceIdentity,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  workspacePath: string;
+  workspaceIdentity?: string;
+}) {
+  const { intl } = useZCodeIntl();
+  const services = useBaseWorkspaceServices();
+  const servers = useMcpStore((state) => state.servers);
+  const isConfigLoaded = useMcpStore((state) => state.isConfigLoaded);
+  const storeWorkspaceKey = useMcpStore(
+    (state) => state.currentWorkspaceIdentity?.trim() || state.currentProjectPath,
+  );
+  const workspaceKey = workspaceIdentity?.trim() || workspacePath;
+  const storeMatchesWorkspace = storeWorkspaceKey === workspaceKey;
+  const openSettingsTab = useOptionalTabStore((state) => state.openSettingsTab);
+  const [refreshing, setRefreshing] = useState(false);
+  const [refreshError, setRefreshError] = useState<string | null>(null);
+
+  const requestSequence = useRef(0);
+  const activeScope = useRef("");
+  activeScope.current = open ? `${workspaceIdentity ?? ""}\0${workspacePath}` : "";
+  const refresh = useCallback(
+    async (mode: ZCodeMcpListMode = "status") => {
+      if (!workspacePath || !activeScope.current || !storeMatchesWorkspace) {
+        setRefreshing(false);
+        setRefreshError(null);
+        return;
+      }
+      setRefreshing(true);
+      setRefreshError(null);
+      const store = useMcpStore.getState();
+      const sequence = ++requestSequence.current;
+      const requestedWorkspaceKey = activeScope.current;
+      const storeScope = (state: ReturnType<typeof useMcpStore.getState>) =>
+        `${state.currentAuthorityKey ?? ""}\0${state.currentWorkspaceIdentity ?? ""}\0${state.currentProjectPath}`;
+      const requestedStoreScope = storeScope(store);
+      const getCurrentWorkspaceKey = () =>
+        sequence === requestSequence.current &&
+        activeScope.current === requestedWorkspaceKey &&
+        storeScope(useMcpStore.getState()) === requestedStoreScope
+          ? requestedWorkspaceKey
+          : "";
+      try {
+        const result = await refreshMcpServerStatusList({
+          workspacePath,
+          ...(workspaceIdentity ? { workspaceIdentity } : {}),
+          mode,
+          mcpSyncService: services.mcpSyncService,
+          beginServerStatusListRefresh: store.beginServerStatusListRefresh,
+          mergeServerStatusSnapshots: store.mergeServerStatusSnapshots,
+          markServerStatusListRefreshFailed: store.markServerStatusListRefreshFailed,
+          requestedWorkspaceKey,
+          getCurrentWorkspaceKey,
+        });
+        if (result === "status-mode-unsupported" && getCurrentWorkspaceKey()) {
+          setRefreshError(intl.formatMessage({ id: "chat.mcpStatus.statusUnsupported" }));
+        }
+      } catch (error) {
+        if (!getCurrentWorkspaceKey()) return;
+        const message = error instanceof Error ? error.message : String(error);
+        setRefreshError(sanitizeMcpDiagnosticText(message, useMcpStore.getState().servers));
+        logger.warn("[mcp-status] list server statuses failed", { mode });
+      } finally {
+        if (sequence === requestSequence.current) setRefreshing(false);
+      }
+    },
+    [intl, services, workspaceIdentity, workspacePath, storeMatchesWorkspace],
+  );
+
+  // Dialog 只在打开时刷新一次；依赖用 ref 保持稳定，避免 services 引用变化造成循环请求。
+  const refreshRef = useRef(refresh);
+  refreshRef.current = refresh;
+  useEffect(() => {
+    if (open) {
+      void refreshRef.current();
+    }
+    return () => {
+      requestSequence.current += 1;
+    };
+  }, [open, workspacePath, workspaceIdentity, storeWorkspaceKey]);
+
+  // 工作区配置尚未切换完成时不能展示上一工作区的服务器，也不能把新请求合并回旧 store。
+  const listedServers = storeMatchesWorkspace ? servers : [];
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent
+        className="max-h-[90dvh] max-w-[min(32rem,calc(100vw-1rem))] overflow-auto"
+        data-testid="mcp-status-dialog"
+      >
+        <DialogHeader>
+          <DialogTitle>{intl.formatMessage({ id: "chat.mcpStatus.title" })}</DialogTitle>
+          <DialogDescription>
+            {intl.formatMessage({ id: "chat.mcpStatus.description" })}
+          </DialogDescription>
+        </DialogHeader>
+
+        <div className="flex flex-wrap items-center justify-end gap-2">
+          {openSettingsTab ? (
+            <Button
+              type="button"
+              variant="ghost"
+              size="sm"
+              data-testid="mcp-status-settings"
+              onClick={() => {
+                onOpenChange(false);
+                setPendingSettingsPluginIntent("mcps");
+                openSettingsTab();
+              }}
+            >
+              {intl.formatMessage({ id: "chat.mcpStatus.settings" })}
+            </Button>
+          ) : null}
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            data-testid="mcp-status-connect"
+            disabled={refreshing || !storeMatchesWorkspace}
+            onClick={() => void refresh("connect")}
+          >
+            {intl.formatMessage({ id: "chat.mcpStatus.connect" })}
+          </Button>
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            data-testid="mcp-status-refresh"
+            disabled={refreshing || !storeMatchesWorkspace}
+            onClick={() => void refresh("status")}
+          >
+            <RefreshCwIcon className={refreshing ? "size-3.5 animate-spin" : "size-3.5"} />
+            {intl.formatMessage({ id: "chat.mcpStatus.refresh" })}
+          </Button>
+        </div>
+
+        {refreshError ? (
+          <p className="text-ui-sm text-destructive" role="alert">
+            {intl.formatMessage({ id: "chat.mcpStatus.refreshFailed" }, { message: refreshError })}
+          </p>
+        ) : null}
+
+        <div className="max-h-[50vh] space-y-1 overflow-auto" data-testid="mcp-status-list">
+          {!isConfigLoaded || !storeMatchesWorkspace ? (
+            <p className="px-1 py-6 text-center text-ui-base text-foreground-subtle">
+              {intl.formatMessage({ id: "chat.mcpStatus.loading" })}
+            </p>
+          ) : listedServers.length === 0 ? (
+            <p className="px-1 py-6 text-center text-ui-base text-foreground-subtle">
+              {intl.formatMessage({ id: "chat.mcpStatus.empty" })}
+            </p>
+          ) : (
+            listedServers.map((server) => {
+              const statusLabel = intl.formatMessage({ id: resolveStatusMessageId(server) });
+              return (
+                <div
+                  key={server.id}
+                  className="min-w-0 rounded-lg border border-border px-3 py-2"
+                  data-testid={`mcp-status-row-${server.id}`}
+                >
+                  <div className="flex min-w-0 items-center gap-3">
+                    <div className="min-w-0 flex-1">
+                      <div className="flex min-w-0 items-center gap-2">
+                        <span className="truncate text-ui-base font-medium text-foreground">
+                          {server.name}
+                        </span>
+                        <span className="shrink-0 rounded bg-hover px-1.5 py-0.5 text-ui-xs text-foreground-subtle">
+                          {resolveTransportLabel(server)}
+                        </span>
+                      </div>
+                      <div className="mt-0.5 flex items-center gap-2 text-ui-sm">
+                        <span
+                          className={
+                            !server.enabled
+                              ? "text-foreground-subtlest"
+                              : server.status === "connected"
+                                ? "text-success"
+                                : server.status === "error"
+                                  ? "text-destructive"
+                                  : "text-foreground-subtle"
+                          }
+                        >
+                          {statusLabel}
+                        </span>
+                        {server.enabled && typeof server.toolCount === "number" ? (
+                          <span className="text-foreground-subtle">
+                            {intl.formatMessage(
+                              { id: "chat.mcpStatus.toolCount" },
+                              { count: String(server.toolCount) },
+                            )}
+                          </span>
+                        ) : null}
+                      </div>
+                    </div>
+                  </div>
+                  <McpServerDiagnostics server={server} />
+                </div>
+              );
+            })
+          )}
+        </div>
+
+        <p className="text-ui-sm text-foreground-subtle">
+          {intl.formatMessage({ id: "chat.mcpStatus.hint" })}
+        </p>
+      </DialogContent>
+    </Dialog>
+  );
+}
