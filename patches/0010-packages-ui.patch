+import { ServiceProvider } from "@/hooks/useServices.js";
+import type { IServiceAccessor } from "@zcode/services";
+import "@/styles.css";
+
+const query = new URLSearchParams(location.search);
+const theme = query.get("theme") === "dark" ? "dark" : "light";
+document.documentElement.className =
+  theme === "dark" ? "dark theme-zai-dark" : "light theme-zai-light";
+
+type FixtureVariant = ChatViewSummaryPanelVariant | "auto";
+const initialVariant: FixtureVariant = query.get("variant") === "auto" ? "auto" : "mini";
+
+const GIT_SUMMARY: GitRepositorySummary = {
+  workspacePath: "/workspace/zcode-plus",
+  repoRoot: "/workspace/zcode-plus",
+  workspaceInRepoPath: "",
+  autoRefreshWatchPaths: [],
+  branchName: "zcode-plus-dev",
+  trackingBranchName: "origin/zcode-plus-dev",
+  headRefType: "branch",
+  ahead: 0,
+  behind: 0,
+  isDirty: true,
+  isGitAvailable: true,
+  isRepository: true,
+};
+
+const noop = () => undefined;
+
+function MountProbe({ onMount }: { onMount: () => void }) {
+  useEffect(() => {
+    onMount();
+    // The probe only proves the conversation tree is not remounted by the scope.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+  return null;
+}
+
+function StatusPanelHost({
+  variantOverride,
+  variantChanges,
+  onVariantChange,
+  onMount,
+}: {
+  variantOverride: ChatViewSummaryPanelVariant | null;
+  variantChanges: number;
+  onVariantChange: (variant: ChatViewSummaryPanelVariant | null) => void;
+  onMount: () => void;
+}) {
+  return (
+    <>
+      <MountProbe onMount={onMount} />
+      <ConversationStatusPanel
+        workspacePath={GIT_SUMMARY.workspacePath}
+        gitSummary={GIT_SUMMARY}
+        gitDirtyFileCount={3}
+        gitWorktreeChangeSummary={{ added: 4286, removed: 1678 }}
+        summaryPanelVariantOverride={variantOverride}
+        onVariantChange={onVariantChange}
+        onRefreshGit={noop}
+      />
+      <output data-testid="variant-changes">{variantChanges}</output>
+    </>
+  );
+}
+
+// Module-level: toggling sidePaneOpen must not recreate or remount the conversation tree.
+const ScopedStatusPanelHost = withSidePaneCapsuleScope(StatusPanelHost);
+
+function Fixture() {
+  const [sidePaneOpen, setSidePaneOpen] = useState(false);
+  const [variant, setVariant] = useState<FixtureVariant>(initialVariant);
+  const [variantChanges, setVariantChanges] = useState(0);
+  const [mounts, setMounts] = useState(0);
+
+  return (
+    <ZCodeIntlProvider initialLocale="en-US">
+      <ServiceProvider services={{ gitService: {} } as IServiceAccessor}>
+        <TooltipProvider>
+          <main className="min-h-screen bg-background p-4 text-foreground">
+            <div className="flex flex-wrap items-center gap-2 text-ui-sm">
+              <button
+                type="button"
+                data-testid="toggle-side-pane"
+                className="h-8 rounded-lg border border-border px-3"
+                onClick={() => setSidePaneOpen((value) => !value)}
+              >
+                Toggle side pane
+              </button>
+              <button
+                type="button"
+                data-testid="reset-variant"
+                className="h-8 rounded-lg border border-border px-3"
+                onClick={() => setVariant(initialVariant)}
+              >
+                Reset variant
+              </button>
+              <output data-testid="side-pane-state">{sidePaneOpen ? "open" : "closed"}</output>
+              <output data-testid="variant">{variant}</output>
+              <output data-testid="mount-count">{mounts}</output>
+            </div>
+            <div
+              data-testid="conversation-container"
+              className="@container/conversation relative mx-auto mt-4 h-40 w-full max-w-[420px] overflow-hidden rounded-xl bg-background-alt"
+            >
+              <ScopedStatusPanelHost
+                sidePaneOpen={sidePaneOpen}
+                variantOverride={variant === "auto" ? null : variant}
+                variantChanges={variantChanges}
+                onVariantChange={(next) => {
+                  setVariant(next ?? "auto");
+                  setVariantChanges((value) => value + 1);
+                }}
+                onMount={() => setMounts((value) => value + 1)}
+              />
+            </div>
+          </main>
+        </TooltipProvider>
+      </ServiceProvider>
+    </ZCodeIntlProvider>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(<Fixture />);
