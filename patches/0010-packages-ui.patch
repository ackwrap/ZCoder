+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type {
+  CommandAck,
+  CommandEnvelope,
+  ConversationSnapshot,
+} from "@zcode/shared/zcode-protocol-v4";
+import { PendingCommandRegistry, PENDING_COMMAND_TTL_MS } from "@/v4/pendingCommandRegistry.js";
+import {
+  isModelSystemPromptEnabled,
+  readModelSystemPromptDraftState,
+  resolveModelSystemPromptScope,
+  setModelSystemPromptEnabled,
+} from "@/v4/composer/model-system-prompt/index.js";
+
+class MemoryStorage {
+  readonly values = new Map<string, string>();
+  getItem(key: string): string | null {
+    return this.values.get(key) ?? null;
+  }
+  setItem(key: string, value: string): void {
+    this.values.set(key, value);
+  }
+  removeItem(key: string): void {
+    this.values.delete(key);
+  }
+}
+
+class FlakyPendingStorage extends MemoryStorage {
+  failPendingWrites = false;
+  override setItem(key: string, value: string): void {
+    if (this.failPendingWrites && key === "zcode-v4-pending-commands:v1") {
+      throw new Error("pending quota");
+    }
+    super.setItem(key, value);
+  }
+}
+
+function envelope(overrides: Partial<CommandEnvelope> = {}): CommandEnvelope {
+  return {
+    commandId: "command-1",
+    clientId: "client-1",
+    sessionId: "accepted-session",
+    type: "sendText",
+    payload: {
+      text: "hello",
+      modelSelection: { providerId: "p", modelId: "m", options: { reasoningLevel: "high" } },
+      mode: "build",
+    },
+    issuedAt: 1_000,
+    ...overrides,
+  } as CommandEnvelope;
+}
+
+function ack(
+  commandId: string,
+  status: CommandAck["status"],
+  options: { result?: CommandAck["result"] } = {},
+): CommandAck {
+  return {
+    commandId,
+    status,
+    revisionAtDecision: 1,
+    ...(options.result ? { result: options.result } : {}),
+  };
+}
+
+function snapshot(
+  sessionId: string,
+  rows: ConversationSnapshot["rows"]["window"],
+): ConversationSnapshot {
+  return {
+    sessionId,
+    logEpoch: "epoch-1",
+    seq: 1,
+    revision: 1,
+    meta: { title: "", titleSource: "default" },
+    control: {
+      phase: "running",
+      sessionEnded: false,
+      canStop: true,
+      stopState: "stoppable",
+      stopTargetKind: "assistant",
+      activeWorks: [],
+      lastError: null,
+      apiRetry: null,
+    },
+    availability: {
+      fork: { allowed: true },
+      compact: { allowed: false, reasonCode: "running" },
+      switchModelConfig: { allowed: false, reasonCode: "running" },
+      setFollowupMode: { allowed: true },
+      queueEdit: { allowed: true },
+      sendQueuedNow: { allowed: true },
+      pauseGoal: { allowed: false, reasonCode: "running" },
+      resumeGoal: { allowed: false, reasonCode: "running" },
+    },
+    inputRouting: { mode: "enqueue" },
+    config: { provider: "p", model: "m", thought: "medium", followupMode: "queue", mode: "build" },
+    usage: {
+      contextWindow: { usedTokens: 0, maxTokens: 100, autoCompactThresholdTokens: null },
+      modelUsage: [],
+    },
+    goal: null,
+    plan: null,
+    backgroundWorks: [],
+    pendingInteractions: [],
+    pendingCommands: [],
+    queue: { autoDrain: true, items: [] },
+    rows: { firstRowId: rows[0]?.rowId ?? null, totalCount: rows.length, window: rows },
+  };
+}
+
+function makeReceipt(workspacePath: string, draftOwnerKey: string, targetSessionId: string) {
+  const draft = resolveModelSystemPromptScope(workspacePath, undefined, null, draftOwnerKey)!;
+  setModelSystemPromptEnabled(draft, true);
+  const state = readModelSystemPromptDraftState(draft)!;
+  return {
+    draft,
+    receipt: {
+      version: 1 as const,
+      workspacePath,
+      draftOwnerKey,
+      enabled: true,
+      revision: state.revision,
+    },
+    targetSessionId,
+  };
+}
+
+function installBrowserStorage(storage: MemoryStorage): void {
+  Object.defineProperty(globalThis, "window", {
+    configurable: true,
+    value: { localStorage: storage },
+  });
+}
+
+beforeEach(() => {
+  // 每个 test 用唯一 workspace/session；模块级内存不需要 reset。
+});
+
+describe("model system prompt promotion at pending accepted boundary", () => {
+  it.each(["sendText", "sendGoalCommand"] as const)(
+    "%s accepted promotes the frozen draft intent",
+    (type) => {
+      const workspacePath = `/workspace/boundary-${type}`;
+      const targetSessionId = `accepted-${type}`;
+      const storage = new MemoryStorage();
+      installBrowserStorage(storage);
+      const { draft, receipt } = makeReceipt(workspacePath, "gen-1", targetSessionId);
+      const registry = new PendingCommandRegistry({
+        storage: new MemoryStorage(),
+        now: () => PENDING_COMMAND_TTL_MS,
+      });
+      const command = envelope({
+        commandId: `command-${type}`,
+        type,
+        sessionId: targetSessionId,
+        payload: {
+          text: "hello",
+          modelSelection: { providerId: "p", modelId: "m", options: { reasoningLevel: "high" } },
+          mode: "build",
+        },
+      });
+      registry.record(command, {
+        workspace: { workspacePath },
+        modelSystemPromptPromotion: receipt,
+      });
+
+      registry.applyAck(command, ack(command.commandId, "accepted"));
+
+      const real = resolveModelSystemPromptScope(workspacePath, undefined, targetSessionId)!;
+      expect(readModelSystemPromptDraftState(draft)).toBeNull();
+      expect(isModelSystemPromptEnabled(real)).toBe(true);
+      expect(
+        registry.findCommand(command.commandId)?.clientContext?.modelSystemPromptPromotion?.applied,
+      ).toBe(true);
+      setModelSystemPromptEnabled(real, false);
+      registry.applyAck(command, ack(command.commandId, "accepted"));
+      // 重复 accepted 不能覆盖目标后来的手动 off。
+      expect(isModelSystemPromptEnabled(real)).toBe(false);
+      expect(
+        registry.findCommand(command.commandId)?.clientContext?.modelSystemPromptPromotion?.applied,
+      ).toBe(true);
+    },
+  );
+
+  it("createSession remap promotes to the created session", () => {
+    const workspacePath = "/workspace/boundary-create";
+    const storage = new MemoryStorage();
+    installBrowserStorage(storage);
+    const { draft, receipt } = makeReceipt(workspacePath, "gen-create", "created-session");
+    const registry = new PendingCommandRegistry({
+      storage: new MemoryStorage(),
+      now: () => PENDING_COMMAND_TTL_MS,
+    });
+    const command = envelope({
+      commandId: "create-command",
+      type: "createSession",
+      sessionId: null,
+      payload: { workspaceId: workspacePath, firstInput: { text: "hello" } },
+    });
+    registry.record(command, {
+      workspace: { workspacePath },
+      modelSystemPromptPromotion: receipt,
+    });
+
+    registry.applyAck(
+      command,
+      ack(command.commandId, "accepted", {
+        result: { type: "createSession", sessionId: "created-session" },
+      }),
+    );
+
+    expect(readModelSystemPromptDraftState(draft)).toBeNull();
+    expect(
+      isModelSystemPromptEnabled(
+        resolveModelSystemPromptScope(workspacePath, undefined, "created-session")!,
+      ),
+    ).toBe(true);
+  });
+
+  it("query and snapshot accepted evidence use the same boundary", () => {
+    const workspacePath = "/workspace/boundary-query";
+    const storage = new MemoryStorage();
+    installBrowserStorage(storage);
+    const queryReceipt = makeReceipt(workspacePath, "gen-query", "query-session").receipt;
+    const registry = new PendingCommandRegistry({
+      storage: new MemoryStorage(),
+      now: () => PENDING_COMMAND_TTL_MS,
+    });
+    const queryCommand = envelope({
+      commandId: "query-command",
+      sessionId: "query-session",
+    });
+    registry.record(queryCommand, {
+      workspace: { workspacePath },
+      modelSystemPromptPromotion: queryReceipt,
+    });
+    registry.applyQuery({
+      results: [
+        {
+          key: { sessionId: queryCommand.sessionId, commandId: queryCommand.commandId },
+          result: { status: "accepted", commandId: queryCommand.commandId },
+        },
+      ],
+    });
+    expect(
+      registry.findCommand(queryCommand.commandId)?.clientContext?.modelSystemPromptPromotion
+        ?.applied,
+    ).toBe(true);
+    expect(
+      isModelSystemPromptEnabled(
+        resolveModelSystemPromptScope(workspacePath, undefined, "query-session")!,
+      ),
+    ).toBe(true);
+
+    const snapshotReceipt = makeReceipt(workspacePath, "gen-snapshot", "snapshot-session").receipt;
+    const snapshotCommand = envelope({
+      commandId: "snapshot-command",
+      sessionId: "snapshot-session",
+    });
+    registry.record(snapshotCommand, {
+      workspace: { workspacePath },
+      modelSystemPromptPromotion: snapshotReceipt,
+    });
+    registry.reconcileSnapshot(
+      snapshot("snapshot-session", [
+        {
+          rowId: 1,
+          kind: "userInput",
+          origin: "realUser",
+          sourceCommandId: snapshotCommand.commandId,
+          text: "hello",
+        } as ConversationSnapshot["rows"]["window"][number],
+      ]),
+    );
+    expect(registry.findCommand(snapshotCommand.commandId)).toBeUndefined();
+    expect(
+      isModelSystemPromptEnabled(
+        resolveModelSystemPromptScope(workspacePath, undefined, "snapshot-session")!,
+      ),
+    ).toBe(true);
+  });
+
+  it("does not promote on rejection and no-ops without a receipt", () => {
+    const workspacePath = "/workspace/boundary-reject";
+    const storage = new MemoryStorage();
+    installBrowserStorage(storage);
+    const { draft, receipt } = makeReceipt(workspacePath, "gen-reject", "rejected-session");
+    const registry = new PendingCommandRegistry({
+      storage: new MemoryStorage(),
+      now: () => PENDING_COMMAND_TTL_MS,
+    });
+    const command = envelope({ commandId: "reject-command", sessionId: "rejected-session" });
+    registry.record(command, {
+      workspace: { workspacePath },
+      modelSystemPromptPromotion: receipt,
+    });
+    registry.applyAck(command, ack(command.commandId, "failed"));
+    expect(readModelSystemPromptDraftState(draft)?.enabled).toBe(true);
+    expect(
+      isModelSystemPromptEnabled(
+        resolveModelSystemPromptScope(workspacePath, undefined, "rejected-session")!,
+      ),
+    ).toBe(false);
+
+    const noReceipt = envelope({ commandId: "no-receipt", sessionId: "no-receipt-session" });
+    registry.record(noReceipt, { workspace: { workspacePath } });
+    registry.applyAck(noReceipt, ack(noReceipt.commandId, "accepted"));
+    expect(registry.findCommand(noReceipt.commandId)).toBeDefined();
+  });
+
+  it("does not re-promote over an explicit off after pending applied persistence fails and a new renderer reloads", async () => {
+    const workspacePath = "/workspace/boundary-reload";
+    const targetSessionId = "reload-session";
+    const browserStorage = new MemoryStorage();
+    installBrowserStorage(browserStorage);
+    const { receipt } = makeReceipt(workspacePath, "gen-reload", targetSessionId);
+    const pendingStorage = new FlakyPendingStorage();
+    const registry = new PendingCommandRegistry({ storage: pendingStorage });
+
+    const queryCommand = envelope({ commandId: "query-command", sessionId: targetSessionId });
+    const snapshotCommand = envelope({ commandId: "snapshot-command", sessionId: targetSessionId });
+    for (const command of [queryCommand, snapshotCommand]) {
+      registry.record(command, {
+        workspace: { workspacePath },
+        modelSystemPromptPromotion: receipt,
+      });
+    }
+    const storedBefore = pendingStorage.getItem("zcode-v4-pending-commands:v1");
+    expect(storedBefore).toContain("query-command");
+    expect(storedBefore).not.toContain('"applied":true');
+
+    // ACK 写 target=true，但 pending JSON 单独写失败：旧 JSON（无 applied）留盘。
+    pendingStorage.failPendingWrites = true;
+    registry.applyAck(queryCommand, ack(queryCommand.commandId, "accepted"));
+    const real = resolveModelSystemPromptScope(workspacePath, undefined, targetSessionId)!;
+    expect(isModelSystemPromptEnabled(real)).toBe(true);
+    expect(pendingStorage.getItem("zcode-v4-pending-commands:v1")).not.toContain('"applied":true');
+
+    // 用户随后成功显式 off（"0" 已落盘）；新 renderer 加载旧 pending。
+    setModelSystemPromptEnabled(real, false);
+    expect(isModelSystemPromptEnabled(real)).toBe(false);
+    pendingStorage.failPendingWrites = false;
+    vi.resetModules();
+    const [{ PendingCommandRegistry: FreshRegistry }, fresh] = await Promise.all([
+      import("@/v4/pendingCommandRegistry.js"),
+      import("@/v4/composer/model-system-prompt/index.js"),
+    ]);
+    const freshRegistry = new FreshRegistry({ storage: pendingStorage });
+    // 真实 Date.now/TTL：旧记录有效且被加载。
+    expect(freshRegistry.findCommand(queryCommand.commandId)).toBeDefined();
+    expect(freshRegistry.findCommand(snapshotCommand.commandId)).toBeDefined();
+
+    freshRegistry.applyQuery({
+      results: [
+        {
+          key: { sessionId: targetSessionId, commandId: queryCommand.commandId },
+          result: { status: "accepted", commandId: queryCommand.commandId },
+        },
+      ],
+    });
+    const freshReal = fresh.resolveModelSystemPromptScope(
+      workspacePath,
+      undefined,
+      targetSessionId,
+    )!;
+    expect(fresh.readModelSystemPromptSessionState(freshReal)).toEqual({ enabled: false });
+    expect(fresh.isModelSystemPromptEnabled(freshReal)).toBe(false);
+
+    freshRegistry.reconcileSnapshot(
+      snapshot(targetSessionId, [
+        {
+          rowId: 1,
+          kind: "userInput",
+          origin: "realUser",
+          sourceCommandId: snapshotCommand.commandId,
+          text: "hello",
+        } as ConversationSnapshot["rows"]["window"][number],
+      ]),
+    );
+    expect(fresh.isModelSystemPromptEnabled(freshReal)).toBe(false);
+  });
+});
