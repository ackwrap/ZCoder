+  clearTaskSidePaneMemoryStateForTest();
+  vi.clearAllMocks();
+});
+
+function setup() {
+  let resolve!: (id: string) => void;
+  let reject!: (error: Error) => void;
+  const pendingCreation = new Promise<string>((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  const hook = renderHook(() =>
+    useAppPanels({
+      workspaceAbsPath: "/repo",
+      activeTaskId: "parent",
+      sidePaneOwnerId: "parent",
+      isDesktop: true,
+      supportsEmbeddedBrowser: false,
+      defaultWhiteboardNamePrefix: "Whiteboard",
+    }),
+  );
+  act(() =>
+    hook.result.current.handleOpenSelectionSideChat({
+      workspacePath: "/repo",
+      parentSessionId: "parent",
+      childSessionId: "pending:test",
+      pendingCreation,
+    }),
+  );
+  return { ...hook, resolve, reject };
+}
+
+describe("side chat loading owner", () => {
+  it("reveals before ACK and resolves without a second open", async () => {
+    const h = setup();
+    expect(h.result.current.isSidePaneCollapsed).toBe(false);
+    const id = h.result.current.sidePaneState!.activeTabId;
+    expect(h.result.current.sidePaneState?.tabs[0]).toMatchObject({ creationState: "loading" });
+    await act(async () => h.resolve("real"));
+    expect(h.result.current.sidePaneState?.activeTabId).toBe(id);
+    expect(h.result.current.sidePaneState?.tabs[0]).toMatchObject({
+      childSessionId: "real",
+      creationState: undefined,
+    });
+    expect(closeSession).not.toHaveBeenCalled();
+  });
+
+  it("closes late child without reopening after closing the loading tab", async () => {
+    const h = setup();
+    await act(async () =>
+      h.result.current.handleCloseSidePaneTab(h.result.current.sidePaneState!.activeTabId),
+    );
+    expect(closeSession).not.toHaveBeenCalled();
+    await act(async () => h.resolve("late"));
+    expect(h.result.current.isSidePaneCollapsed).toBe(true);
+    expect(h.result.current.sidePaneState?.tabs ?? []).toEqual([]);
+    expect(closeSession).toHaveBeenCalledWith({ workspacePath: "/repo", sessionId: "late" });
+  });
+
+  it("reports failure on the existing tab", async () => {
+    const h = setup();
+    await act(async () => h.reject(new Error("creation failed")));
+    expect(h.result.current.sidePaneState?.tabs[0]).toMatchObject({
+      creationState: "failed",
+      creationError: "creation failed",
+    });
+    expect(closeSession).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/ui/test/useSettingServiceCompactionPolicy.test.ts b/packages/ui/test/useSettingServiceCompactionPolicy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a9a1f79996fdab51869f60da09e8e0862b92f14
--- /dev/null
+++ b/packages/ui/test/useSettingServiceCompactionPolicy.test.ts
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+// docs/compaction-profiles.md「Host → CLI 同步」「设置契约」：三个压缩设置发生变化时，
+// persist 成功后同步 Host/Bot 并沿用现有 broadcast 机制；不混入 strict interaction preferences。
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL, type AppSettings } from "@zcode/shared";
+import type { IServiceAccessor } from "@zcode/services";
+
+const settingService = {
+  get: vi.fn<() => Promise<AppSettings>>(),
+  update: vi.fn<(patch: Partial<AppSettings>) => Promise<void>>(),
+};
+const broadcastService = {
+  send: vi.fn<(message: { channel: string; payload: unknown }) => Promise<void>>(),
+};
+const zcodeAgentService = {
+  syncAppRuntimePreferences: vi.fn(async () => undefined),
+  syncCompactionPolicy: vi.fn(async () => undefined),
+};
+const botsService = {
+  syncAppRuntimePreferences: vi.fn(async () => undefined),
+  syncCompactionPolicy: vi.fn(async () => undefined),
+};
+const services = {
+  broadcastService,
+  settingService,
+  zcodeAgentService,
+  botsService,
+} as unknown as IServiceAccessor;
+
+vi.mock("@/hooks/useServices.js", () => ({
+  useServices: () => services,
+}));
+
+vi.mock("@/hooks/usePlatform.js", () => ({
+  usePlatform: () => ({}),
+}));
+
+describe("useSettings compaction policy runtime sync", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    settingService.get.mockResolvedValue({} as AppSettings);
+    settingService.update.mockResolvedValue(undefined);
+    broadcastService.send.mockResolvedValue(undefined);
+    zcodeAgentService.syncCompactionPolicy.mockResolvedValue(undefined);
+    botsService.syncCompactionPolicy.mockResolvedValue(undefined);
+  });
+
+  it.each([
+    [{ compactionProfile: "compact" as const }, "compact", 15_000, 8_000],
+    [{ compactionTailBudgetTokens: 40_000 }, "detailed", 40_000, 8_000],
+    [{ compactionSummaryMaxOutputTokens: 12_000 }, "detailed", 15_000, 12_000],
+  ])("persist 成功后同步归一策略并广播：%j", async (patch, profile, tailBudgetTokens, summary) => {
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await hook.result.current.update(patch);
+    });
+
+    const policy = { profile, tailBudgetTokens, summaryMaxOutputTokens: summary };
+    expect(settingService.update).toHaveBeenCalledWith(patch);
+    expect(zcodeAgentService.syncCompactionPolicy).toHaveBeenCalledWith(policy);
+    expect(botsService.syncCompactionPolicy).toHaveBeenCalledWith(policy);
+    expect(broadcastService.send).toHaveBeenCalledWith({
+      channel: COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL,
+      payload: policy,
+    });
+    // 三个压缩字段走独立方法，不塞进 strict interaction preferences。
+    expect(zcodeAgentService.syncAppRuntimePreferences).not.toHaveBeenCalled();
+    expect(botsService.syncAppRuntimePreferences).not.toHaveBeenCalled();
+    hook.unmount();
+  });
+
+  it("持久化失败时不触发同步或广播", async () => {
+    settingService.update.mockRejectedValueOnce(new Error("write failed"));
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await expect(hook.result.current.update({ compactionProfile: "compact" })).rejects.toThrow(
+        "write failed",
+      );
+    });
+
+    expect(zcodeAgentService.syncCompactionPolicy).not.toHaveBeenCalled();
+    expect(botsService.syncCompactionPolicy).not.toHaveBeenCalled();
+    expect(broadcastService.send).not.toHaveBeenCalled();
+    hook.unmount();
+  });
+
+  it("Host 同步失败仍广播，但把失败上报给保存方", async () => {
+    zcodeAgentService.syncCompactionPolicy.mockRejectedValueOnce(new Error("host gone"));
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await expect(hook.result.current.update({ compactionProfile: "compact" })).rejects.toThrow(
+        "host gone",
+      );
+    });
+
+    expect(broadcastService.send).toHaveBeenCalledWith(
+      expect.objectContaining({ channel: COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL }),
+    );
+    hook.unmount();
+  });
+});
