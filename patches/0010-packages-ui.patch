new file mode 100644
index 0000000000000000000000000000000000000000..86cb243ff2e72642e98b78e3eedf2c178efc2d6f
--- /dev/null
+++ b/packages/ui/src/ToolCallBlocks/renderers/read-scope/scope.ts
@@ -0,0 +1,105 @@
+import type { ReadScope, ReadScopeSource } from "./types.js";
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+function integer(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+}
+
+function parseOutput(value: unknown): unknown {
+  if (typeof value !== "string" || !value.trimStart().startsWith("{")) return value;
+  try {
+    return JSON.parse(value);
+  } catch {
+    return value;
+  }
+}
+
+function numberedRange(text: string): { offset: number; lines: number } | undefined {
+  let offset: number | undefined;
+  let lines = 0;
+  const content = text.replace(/^<system-reminder>[^]*?<\/system-reminder>\r?\n\r?\n/u, "");
+  for (const line of content.split(/\r?\n/u)) {
+    const match = /^\s*(\d+)\t/u.exec(line);
+    if (!match) return undefined;
+    const number = Number(match[1]);
+    if (!Number.isSafeInteger(number)) return undefined;
+    offset ??= number;
+    if (number !== offset + lines) return undefined;
+    lines += 1;
+  }
+  return offset === undefined ? undefined : { offset, lines };
+}
+
+export function resolveReadScope(source: ReadScopeSource): ReadScope | null {
+  const raw = record(source.raw);
+  if (raw?.inputPreviewComplete === false) return null;
+  const input = record(source.input) ?? record(raw?.rawInput);
+  if (!input || Array.isArray(input.parsed_cmd)) return null;
+  const path = input.file_path ?? input.filePath ?? input.path ?? input.filename;
+  if (typeof path !== "string") return null;
+  if (/\.(?:png|jpe?g|gif|webp|svg|pdf|mp4|m4v|mov|webm|mkv|avi|ipynb)$/iu.test(path)) return null;
+  if (
+    input.pages !== undefined ||
+    /^(?:dir|directory|folder)$/iu.test(
+      String(input.entryType ?? input.fileType ?? input.type ?? ""),
+    )
+  )
+    return null;
+
+  const offset = integer(input.offset);
+  const limit = integer(input.limit);
+  if ((input.offset !== undefined && offset === undefined) || (input.limit !== undefined && !limit))
+    return null;
+  const ranged = input.offset !== undefined || limit !== undefined;
+  const requested = (truncated: boolean): ReadScope =>
+    ranged
+      ? {
+          kind: "request-range",
+          offset: offset ?? 1,
+          ...(limit === undefined ? {} : { limit }),
+          truncated,
+        }
+      : { kind: "request-full", truncated };
+  if (!/^(?:completed|success)$/u.test(source.status)) return requested(false);
+
+  const output = parseOutput(source.output ?? raw?.rawOutput);
+  const structured = record(output);
+  if (structured && /^(?:image|video|pdf|parts|notebook|directory)$/u.test(String(structured.type)))
+    return null;
+  const text =
+    typeof output === "string"
+      ? output
+      : typeof structured?.content === "string"
+        ? structured.content
+        : typeof structured?.text === "string"
+          ? structured.text
+          : "";
+  if (/(?:^|\n)<type>\s*(?:dir|directory|folder)\s*<\/type>/iu.test(text)) return null;
+  const transportTruncated = Boolean(raw?.outputTruncated);
+  const truncated =
+    transportTruncated ||
+    structured?.truncated === true ||
+    structured?.truncatedByTokenCap === true ||
+    Boolean(structured?.partialViewNotice) ||
+    /(?:^|\n)(?:<|&lt;)system-reminder>[^\n]*(?:partial view|truncat)/iu.test(text);
+  if (transportTruncated) return requested(true);
+
+  const start = integer(structured?.startLine);
+  const count = integer(structured?.numLines);
+  const total = integer(structured?.totalLines);
+  if (start !== undefined && count !== undefined) {
+    if (!truncated && start <= 1 && total !== undefined && count >= total)
+      return { kind: "full", truncated: false };
+    return { kind: "range", offset: start, lines: count, truncated };
+  }
+  const returned = numberedRange(text);
+  if (!returned) return requested(truncated);
+  if (limit === undefined && (offset ?? 1) <= 1 && !truncated && returned.offset <= 1)
+    return { kind: "full", truncated: false };
+  return { kind: "range", ...returned, truncated };
+}
