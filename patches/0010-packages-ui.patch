+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+
+/** `/force`: session-scoped renderer view toggle; never sends a provider request. */
+export function createFocusModeCommand(
+  focusMode: { enabled: boolean; toggle: () => boolean } | null,
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand | null {
+  if (!focusMode) return null;
+  const messages = getCompatMessages(locale);
+  return {
+    value: messages.focusMode.value,
+    label: "/force",
+    description: focusMode.enabled
+      ? messages.focusMode.disableDescription
+      : messages.focusMode.enableDescription,
+    keywords: messages.focusMode.keywords,
+    run: () => {
+      const enabled = focusMode.toggle();
+      notify(enabled ? messages.focusModeEnabled : messages.focusModeDisabled);
+    },
+  };
+}
