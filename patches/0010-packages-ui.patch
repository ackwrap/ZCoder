+        "form",
+        { "data-testid": "mock-chat-prompt-editor" },
+        props.leadingActions,
+      ),
+  };
+});
+
+vi.mock("@/v4/composer/useComposerAttachments.js", () => ({
+  useComposerAttachments: () => ({
+    attachments: [],
+    attachmentError: null,
+    adoptSentAttachments: vi.fn(async () => {}),
+    hasAttachments: false,
+    hasUnreadyAttachments: false,
+    isDraggingOverComposer: false,
+    attachmentInputRef: { current: null },
+    openAttachmentPicker: vi.fn(),
+    handleAttachmentInputChange: vi.fn(),
+    handlePaste: vi.fn(),
+    handleDragOverComposer: vi.fn(),
+    handleDragLeaveComposer: vi.fn(),
+    handleDropComposer: vi.fn(),
+    handleWhiteboardMentionSelected: vi.fn(),
+    removeAttachment: vi.fn(),
+    retryAttachment: vi.fn(),
+    clearAttachments: vi.fn(),
+    prepareForSend: vi.fn(async () => []),
+    setAttachmentError: vi.fn(),
+  }),
+}));
+
+vi.mock("@/v4/composer/V4ComposerToolbar.js", async () => {
+  const React = await import("react");
+  const Stub = ({ label }: { label: string }) => React.createElement("span", null, label);
+  return {
+    V4ComposerModeSwitch: () => React.createElement(Stub, { label: "mode" }),
+    V4ComposerModelControls: () => React.createElement(Stub, { label: "model" }),
+  };
+});
+
+const AnyConversationComposer = ConversationComposer as unknown as ComponentType<
+  Record<string, unknown>
+>;
+
+function renderComposer(overrides: Record<string, unknown> = {}): string {
+  return renderToStaticMarkup(
+    createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "zh-CN" },
+      createElement(AnyConversationComposer, {
+        snapshot: null,
+        sessionId: "session-1",
+        workspacePath: "/workspace",
+        composerDraft: { text: "", updatedAt: 1 },
+        onSendText: vi.fn(async () => {}),
+        onStop: vi.fn(),
+        onSelectModel: vi.fn(),
+        onSelectThought: vi.fn(),
+        onSwitchMode: vi.fn(),
+        ...overrides,
+      }),
+    ),
+  );
+}
+
+const repositorySummary = {
+  branchName: "main",
+  headRefType: "branch",
+  isGitAvailable: true,
+  isRepository: true,
+} as const;
+
+afterEach(() => {
+  captured.branchProps = null;
+});
+
+describe("ConversationComposer Git branch entry", () => {
+  it("在会话底栏渲染分支入口并复用宿主 Git 快照", () => {
+    const onRefreshGit = vi.fn();
+
+    const html = renderComposer({
+      gitSummary: repositorySummary,
+      gitDirtyFileCount: 3,
+      onRefreshGit,
+    });
+
+    expect(html).toContain("mock-git-branch-switcher");
+    expect(captured.branchProps).toMatchObject({
+      composerToolbar: true,
+      dirtyFileCount: 3,
+      popoverSide: "top",
+      avoidPopoverCollisions: false,
+      restoreFocusSelector: '[data-testid="v4-composer-input"]',
+      workspacePath: "/workspace",
+    });
+    expect(captured.branchProps?.onRefreshGit).toBe(onRefreshGit);
+  });
+
+  it("草稿态上方已有 contextHeader 入口时不重复渲染", () => {
+    const html = renderComposer({
+      contextHeader: createElement("nav", { "data-testid": "mock-context-header" }),
+      gitSummary: repositorySummary,
+      onRefreshGit: vi.fn(),
+    });
+
+    expect(html).toContain("mock-context-header");
+    expect(html).not.toContain("mock-git-branch-switcher");
+  });
+
+  it("非 Git 工作区或无刷新通道时不渲染入口", () => {
+    expect(
+      renderComposer({
+        gitSummary: { ...repositorySummary, isRepository: false },
+        onRefreshGit: vi.fn(),
+      }),
+    ).not.toContain("mock-git-branch-switcher");
+
+    expect(renderComposer({ gitSummary: repositorySummary })).not.toContain(
+      "mock-git-branch-switcher",
+    );
+  });
+});
