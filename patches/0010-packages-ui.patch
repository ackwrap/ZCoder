diff --git a/packages/ui/src/session-diagnostics/projection.ts b/packages/ui/src/session-diagnostics/projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..58b3fdb7692397aed12783d2ab76d76f0e7bb97c
--- /dev/null
+++ b/packages/ui/src/session-diagnostics/projection.ts
@@ -0,0 +1,134 @@
+import {
+  redactFeedbackText,
+  type ZCodeContextUsageBreakdownItem,
+  type ZCodeMcpServer,
+} from "@zcode/shared";
+import type { ConfiguredContext, ContextSelectionView, ContextUsageDiagnostic } from "./types.js";
+
+/** 低于该命中率时，工具栏只保留容量信息；信息栏不受此阈值限制。 */
+export const CACHE_HIT_RATE_DISPLAY_THRESHOLD = 0.78;
+
+export function formatContextCacheHitRateLabel(
+  hitRate: number | null | undefined,
+  locale: string,
+  options: { showBelowThreshold?: boolean } = {},
+): string | null {
+  if (hitRate === null || hitRate === undefined || !Number.isFinite(hitRate)) return null;
+  // 生产工具栏只露出明显缓存收益，避免低命中率分散对上下文容量的注意力；
+  // 开发环境需要观察 provider 的真实低命中值，因此允许绕过展示阈值。
+  if (!options.showBelowThreshold && hitRate < CACHE_HIT_RATE_DISPLAY_THRESHOLD) return null;
+  return new Intl.NumberFormat(locale, {
+    maximumFractionDigits: 1,
+    style: "percent",
+  }).format(Math.max(0, hitRate));
+}
+
+export function buildContextUsageBreakdownSegments(
+  breakdown: readonly ZCodeContextUsageBreakdownItem[] | undefined,
+) {
+  const order = [
+    "messages",
+    "system_prompt",
+    "meta_user_context",
+    "skills",
+    "tool_prompt",
+    "system_tool_schemas",
+    "mcp_tool_schemas",
+  ];
+  const charsBySource = new Map<ZCodeContextUsageBreakdownItem["source"], number>();
+  for (const item of breakdown ?? []) {
+    if (!Number.isFinite(item.chars) || item.chars <= 0) continue;
+    charsBySource.set(item.source, (charsBySource.get(item.source) ?? 0) + item.chars);
+  }
+  const total = [...charsBySource.values()].reduce((sum, chars) => sum + chars, 0);
+  if (!Number.isFinite(total) || total <= 0) return [];
+  return [...charsBySource.entries()]
+    .map(([source, chars]) => ({ source, chars, percent: chars / total }))
+    .sort(
+      (left, right) =>
+        right.chars - left.chars || order.indexOf(left.source) - order.indexOf(right.source),
+    );
+}
+
+export function selectConfiguredContext(
+  view: ContextSelectionView | null,
+  selection: { provider: string; model: string } | null,
+): ConfiguredContext | null {
+  if (!view || !selection) return null;
+  const model = view.providers
+    .find((p) => p.providerId === selection.provider)
+    ?.models.find((m) => m.modelId === selection.model);
+  const size = model?.effectiveConfig.properties?.contextWindow;
+  return typeof size === "number" && Number.isFinite(size) && size > 0
+    ? { model: selection.model, size, source: model?.contextWindowSource ?? "unknown" }
+    : null;
+}
+
+export function resolveContextBudget(
+  usage: ContextUsageDiagnostic | null | undefined,
+): { threshold: number; remaining: number } | null {
+  const threshold = usage?.autoCompactThresholdTokens;
+  if (
+    !usage ||
+    !Number.isFinite(usage.used) ||
+    usage.used < 0 ||
+    !Number.isFinite(usage.size) ||
+    usage.size <= 0 ||
+    typeof threshold !== "number" ||
+    !Number.isFinite(threshold) ||
+    threshold <= 0 ||
+    threshold > usage.size
+  )
+    return null;
+  return { threshold, remaining: Math.max(0, threshold - usage.used) };
+}
+
+/** 不序列化配置；已知配置值只用于进一步擦除错误中的回显。 */
+export function sanitizeMcpDiagnosticText(
+  text: string,
+  servers: readonly ZCodeMcpServer[],
+): string {
+  const secrets: string[] = [];
+  function collect(value: unknown, depth = 0): void {
+    if (depth > 8) return;
+    if (typeof value === "string" && value) {
+      secrets.push(value);
+      // 参数可能只回显等号后的值；URL 被通用过滤器改写后也不能留下已知主机。
+      if (value.includes("=")) secrets.push(value.slice(value.indexOf("=") + 1));
+      try {
+        secrets.push(new URL(value).hostname);
+      } catch {
+        /* 非 URL 配置值。 */
+      }
+    } else if (Array.isArray(value)) value.forEach((item) => collect(item, depth + 1));
+    else if (value && typeof value === "object")
+      Object.values(value).forEach((item) => collect(item, depth + 1));
+  }
+  for (const server of servers) {
+    for (const [key, value] of Object.entries(server.config)) if (key !== "type") collect(value);
+    collect(server.authorization?.authorizationUrl);
+  }
+  let safe = redactFeedbackText(text, { diagnostic: true });
+  for (const secret of [...new Set(secrets)].filter(Boolean).sort((a, b) => b.length - a.length))
+    safe = safe.split(secret).join("[REDACTED]");
+  return safe.slice(0, 8000);
+}
+
+export function buildMcpDiagnosticReport(server: ZCodeMcpServer): string {
+  const connectedAt = server.lastConnected ? new Date(server.lastConnected).getTime() : NaN;
+  return sanitizeMcpDiagnosticText(
+    [
+      `name: ${server.name}`,
+      `source: ${server.source}`,
+      `scope: ${server.scope}`,
+      `status: ${server.enabled ? (server.status ?? "unknown") : "disabled"}`,
+      `transport: ${server.config.command ? "stdio" : ["http", "sse", "streamableHttp"].includes(server.config.type ?? "") ? server.config.type : server.config.url ? "http" : "unknown"}`,
+      `toolCount: ${server.toolCount ?? "unknown"}`,
+      `lastConnected: ${Number.isFinite(connectedAt) ? new Date(connectedAt).toISOString() : "unknown"}`,
+      ...(server.failureKind ? [`failureKind: ${server.failureKind}`] : []),
+      ...(server.serverRequestId ? [`requestId: ${server.serverRequestId}`] : []),
+      ...(server.error ? [`error: ${server.error}`] : []),
+    ].join("\n"),
+    [server],
+  );
+}
