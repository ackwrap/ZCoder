diff --git a/packages/ui/test/focusModeComposerAlignment.test.ts b/packages/ui/test/focusModeComposerAlignment.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c7431f798ba5ef26f372dc5bcfb7ef33fe31d114
--- /dev/null
+++ b/packages/ui/test/focusModeComposerAlignment.test.ts
@@ -0,0 +1,146 @@
+// @vitest-environment jsdom
+import { createElement } from "react";
+import { act, cleanup, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { ConversationFocusModeTimeline } from "@/v4/focus-mode/contract.js";
+
+vi.mock("@/v4/ConversationTimeline.js", () => ({
+  ConversationTimeline: () =>
+    createElement(
+      "div",
+      { "data-v4-composer-dock-content": "true" },
+      createElement("div", {
+        className: "chat-composer-input-surface",
+        "data-testid": "input-surface",
+      }),
+    ),
+}));
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({ intl: { formatMessage: ({ id }: { id: string }) => id } }),
+}));
+
+it("tracks a dock translate class change without resize or transition events", async () => {
+  let left = 180;
+  vi.spyOn(HTMLElement.prototype, "getBoundingClientRect").mockImplementation(
+    function (this: HTMLElement) {
+      if (this.dataset.focusNavigationSlot) return { left: 100, width: 800 } as DOMRect;
+      if (this.dataset.testid === "input-surface") return { left, width: 400 } as DOMRect;
+      return { left: 100, width: 800 } as DOMRect;
+    },
+  );
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      observe() {}
+      disconnect() {}
+    },
+  );
+  const view = render(
+    createElement(ConversationFocusModeTimeline, {
+      rows: [],
+      totalCount: 0,
+      sessionKey: "s",
+      rowContext: {} as never,
+    }),
+  );
+  const slot = document.querySelector<HTMLElement>("[data-focus-navigation-slot]")!;
+  const dock = screen.getByTestId("input-surface").parentElement!;
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("280px");
+  left = 12;
+  await act(async () => {
+    dock.classList.add("@min-[1280px]/conversation:-translate-x-42");
+    await Promise.resolve();
+  });
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("112px");
+  view.unmount();
+  left = 180;
+  await act(async () => {
+    dock.className = "";
+    await Promise.resolve();
+  });
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("");
+});
+
+it("tracks the actual composer center and cleans up its bounded observers", () => {
+  let callback!: ResizeObserverCallback;
+  const observe = vi.fn();
+  const disconnect = vi.fn();
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      constructor(cb: ResizeObserverCallback) {
+        callback = cb;
+      }
+      observe = observe;
+      disconnect = disconnect;
+      unobserve = vi.fn();
+    },
+  );
+  let left = 180;
+  let width = 400;
+  const frames = new Map<number, FrameRequestCallback>();
+  let nextFrame = 1;
+  vi.stubGlobal(
+    "requestAnimationFrame",
+    vi.fn((cb: FrameRequestCallback) => {
+      const id = nextFrame++;
+      frames.set(id, cb);
+      return id;
+    }),
+  );
+  vi.stubGlobal(
+    "cancelAnimationFrame",
+    vi.fn((id: number) => frames.delete(id)),
+  );
+  vi.spyOn(HTMLElement.prototype, "getBoundingClientRect").mockImplementation(
+    function (this: HTMLElement) {
+      if (this.dataset.focusNavigationSlot) return { left: 100, width: 800 } as DOMRect;
+      if (this.dataset.testid === "input-surface") return { left, width } as DOMRect;
+      return { left: 100, width: 800 } as DOMRect;
+    },
+  );
+  const view = render(
+    createElement(ConversationFocusModeTimeline, {
+      rows: [],
+      totalCount: 0,
+      sessionKey: "s",
+      rowContext: {} as never,
+    }),
+  );
+  const slot = document.querySelector<HTMLElement>("[data-focus-navigation-slot]")!;
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("280px");
+  expect(observe).toHaveBeenCalledTimes(2);
+  expect(observe).toHaveBeenCalledWith(slot);
+  expect(observe).toHaveBeenCalledWith(screen.getByTestId("input-surface"));
+  left = 130;
+  width = 300;
+  act(() => callback([], {} as ResizeObserver));
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("180px");
+  const dock = screen.getByTestId("input-surface").parentElement!;
+  const transition = (name: string) => {
+    const event = new Event(name, { bubbles: true });
+    Object.defineProperty(event, "propertyName", { value: "transform" });
+    dock.dispatchEvent(event);
+  };
+  act(() => transition("transitionrun"));
+  expect(frames.size).toBe(1);
+  left = 170;
+  act(() => {
+    const [id, cb] = frames.entries().next().value!;
+    frames.delete(id);
+    cb(0);
+  });
+  expect(slot.style.getPropertyValue("--focus-composer-center")).toBe("220px");
+  act(() => transition("transitionend"));
+  expect(frames.size).toBe(0);
+  act(() => transition("transitionrun"));
+  view.unmount();
+  expect(frames.size).toBe(0);
+  expect(disconnect).toHaveBeenCalledOnce();
+});
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
diff --git a/packages/ui/test/imagePreviewPointerDismiss.test.ts b/packages/ui/test/imagePreviewPointerDismiss.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a035f5a8fbcd49cd4fdfacfafe0542251dcb8874
--- /dev/null
+++ b/packages/ui/test/imagePreviewPointerDismiss.test.ts
@@ -0,0 +1,557 @@
+// @vitest-environment jsdom
+import { createElement, useState } from "react";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX,
+  hasImagePreviewDismissMoved,
+  isImagePreviewDismissBlankTarget,
+  isImagePreviewDismissPointInsideImage,
+} from "@/components/ai-elements/image-preview-dismiss/index.js";
+import {
+  ImagePreviewDialog,
+  type ImagePreviewDialogItem,
+} from "@/components/ai-elements/image-preview-dialog.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+
+const IMAGE_ITEM: ImagePreviewDialogItem = {
+  alt: "preview",
+  src: "data:image/png;base64,AAAA",
+};
+
+const VIDEO_ITEM: ImagePreviewDialogItem = {
+  alt: "clip",
+  mediaType: "video/mp4",
+  src: "data:video/mp4;base64,AAAA",
+};
+
+function previewTree(
+  items: readonly ImagePreviewDialogItem[],
+  onOpenChange: (open: boolean) => void,
+  open = true,
+) {
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "zh-CN" },
+    createElement(ImagePreviewDialog, {
+      dialogTestId: "image-preview-dialog",
+      imageTestId: "image-preview-image",
+      initialIndex: 0,
+      items,
+      onOpenChange,
+      open,
+    }),
+  );
+}
+
+function renderPreview(items: readonly ImagePreviewDialogItem[] = [IMAGE_ITEM]) {
+  const onOpenChange = vi.fn();
+  const view = render(previewTree(items, onOpenChange));
+  return { onOpenChange, view };
+}
+
+function dialogContent() {
+  return screen.getByTestId("image-preview-dialog");
+}
+
+function imageElement() {
+  return screen.getByTestId("image-preview-image") as HTMLImageElement;
+}
+
+function mockImageRect(element: Element, rect: Partial<DOMRect>) {
+  return vi.spyOn(element, "getBoundingClientRect").mockReturnValue({
+    x: 0,
+    y: 0,
+    width: 200,
+    height: 200,
+    top: 0,
+    left: 0,
+    right: 200,
+    bottom: 200,
+    toJSON: () => ({}),
+    ...rect,
+  } as DOMRect);
+}
+
+function tap(element: Element, x: number, y: number, pointerId = 1) {
+  fireEvent.pointerDown(element, {
+    button: 0,
+    clientX: x,
+    clientY: y,
+    isPrimary: true,
+    pointerId,
+  });
+  fireEvent.pointerUp(element, {
+    button: 0,
+    clientX: x,
+    clientY: y,
+    isPrimary: true,
+    pointerId,
+  });
+}
+
+beforeEach(() => {
+  Object.defineProperty(HTMLElement.prototype, "setPointerCapture", {
+    configurable: true,
+    value: vi.fn(),
+  });
+  Object.defineProperty(HTMLElement.prototype, "hasPointerCapture", {
+    configurable: true,
+    value: vi.fn(() => false),
+  });
+  Object.defineProperty(HTMLElement.prototype, "releasePointerCapture", {
+    configurable: true,
+    value: vi.fn(),
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  delete (HTMLElement.prototype as { setPointerCapture?: unknown }).setPointerCapture;
+  delete (HTMLElement.prototype as { hasPointerCapture?: unknown }).hasPointerCapture;
+  delete (HTMLElement.prototype as { releasePointerCapture?: unknown }).releasePointerCapture;
+});
+
+describe("image preview dismiss helpers", () => {
+  it("detects blank, image, interactive, and image-bounds targets", () => {
+    const button = document.createElement("button");
+    const image = document.createElement("img");
+    document.body.append(button, image);
+    mockImageRect(image, { left: 20, top: 20, right: 120, bottom: 120, width: 100, height: 100 });
+
+    expect(
+      isImagePreviewDismissBlankTarget({
+        target: button,
+        image,
+        clientX: 0,
+        clientY: 0,
+      }),
+    ).toBe(false);
+    expect(
+      isImagePreviewDismissBlankTarget({
+        target: image,
+        image,
+        clientX: 0,
+        clientY: 0,
+      }),
+    ).toBe(false);
+    expect(
+      isImagePreviewDismissBlankTarget({
+        target: document.body,
+        image,
+        clientX: 50,
+        clientY: 50,
+      }),
+    ).toBe(false);
+    expect(
+      isImagePreviewDismissBlankTarget({
+        target: document.body,
+        image,
+        clientX: 10,
+        clientY: 10,
+      }),
+    ).toBe(true);
+    expect(isImagePreviewDismissPointInsideImage(image, 50, 50)).toBe(true);
+    expect(isImagePreviewDismissPointInsideImage(image, 10, 10)).toBe(false);
+
+    button.remove();
+    image.remove();
+  });
+
+  it("uses an img target fallback when bounds are zero", () => {
+    const image = document.createElement("img");
+    expect(
+      isImagePreviewDismissBlankTarget({
+        target: image,
+        image,
+        clientX: 10,
+        clientY: 10,
+      }),
+    ).toBe(false);
+  });
+
+  it("marks movement beyond the threshold as a drag", () => {
+    expect(
+      hasImagePreviewDismissMoved({
+        startX: 10,
+        startY: 10,
+        clientX: 10 + IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX,
+        clientY: 10,
+      }),
+    ).toBe(false);
+    expect(
+      hasImagePreviewDismissMoved({
+        startX: 10,
+        startY: 10,
+        clientX: 10 + IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX + 1,
+        clientY: 10,
+      }),
+    ).toBe(true);
+  });
+});
+
+describe("image preview blank dismiss", () => {
+  it("closes on a clean padding tap", () => {
+    const { onOpenChange } = renderPreview();
+    mockImageRect(imageElement(), { left: 100, top: 100, right: 300, bottom: 300 });
+    tap(dialogContent(), 10, 10);
+    expect(onOpenChange).toHaveBeenCalledExactlyOnceWith(false);
+  });
+
+  it("closes on blank space inside the image viewport but outside the image", () => {
+    const { onOpenChange } = renderPreview();
+    const image = imageElement();
+    mockImageRect(image, { left: 100, top: 100, right: 300, bottom: 300 });
+    const viewport = image.parentElement as HTMLDivElement;
+    tap(viewport, 10, 10);
+    expect(onOpenChange).toHaveBeenCalledExactlyOnceWith(false);
+  });
+
+  it("does not close on image clicks or zero-bounds image targets", async () => {
+    const { onOpenChange } = renderPreview();
+    tap(imageElement(), 10, 10);
+    expect(onOpenChange).not.toHaveBeenCalled();
+
+    fireEvent.click(imageElement());
+    expect(onOpenChange).not.toHaveBeenCalled();
+    expect(screen.getByTestId("image-preview-dialog")).toBeTruthy();
+  });
+
+  it("does not close from download, close, gallery, or zoom controls", () => {
+    const { onOpenChange } = renderPreview([IMAGE_ITEM, { ...IMAGE_ITEM, alt: "second" }]);
+    for (const name of ["下载图片", "关闭", "上一张图片", "下一张图片", "放大", "缩小"]) {
+      tap(screen.getByRole("button", { name }), 10, 10);
+    }
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("does not close when a blank drag moves past the threshold and returns", () => {
+    const { onOpenChange } = renderPreview();
+    mockImageRect(imageElement(), { left: 100, top: 100, right: 300, bottom: 300 });
+    const content = dialogContent();
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    fireEvent.pointerMove(content, {
+      clientX: 40,
+      clientY: 40,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("does not close when the blank press ends inside the image", () => {
+    const { onOpenChange } = renderPreview();
+    mockImageRect(imageElement(), { left: 20, top: 20, right: 120, bottom: 120 });
+    const content = dialogContent();
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 25,
+      clientY: 25,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("ignores pinch, non-primary, cancel, and lost capture", () => {
+    const { onOpenChange } = renderPreview();
+    mockImageRect(imageElement(), { left: 100, top: 100, right: 300, bottom: 300 });
+    const content = dialogContent();
+
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 12,
+      clientY: 12,
+      isPrimary: true,
+      pointerId: 2,
+    });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 1,
+    });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 12,
+      clientY: 12,
+      isPrimary: true,
+      pointerId: 2,
+    });
+
+    fireEvent.pointerDown(content, {
+      button: 2,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 3,
+    });
+    fireEvent.pointerUp(content, {
+      button: 2,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 3,
+    });
+
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 4,
+    });
+    fireEvent.pointerCancel(content, {
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 4,
+    });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 4,
+    });
+
+    fireEvent.pointerDown(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 5,
+    });
+    fireEvent.lostPointerCapture(content, { pointerId: 5 });
+    fireEvent.pointerUp(content, {
+      button: 0,
+      clientX: 10,
+      clientY: 10,
+      isPrimary: true,
+      pointerId: 5,
+    });
+
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ["padding", "first"],
+    ["padding", "second"],
+    ["viewport", "first"],
+    ["viewport", "second"],
+  ] as const)(
+    "does not dismiss while a real second touch is down (%s, up %s)",
+    (surface, touchUpOrder) => {
+      const { onOpenChange } = renderPreview();
+      const image = imageElement();
+      mockImageRect(image, { left: 100, top: 100, right: 300, bottom: 300 });
+      const target =
+        surface === "padding" ? dialogContent() : (image.parentElement as HTMLDivElement);
+
+      fireEvent.pointerDown(target, {
+        button: 0,
+        clientX: 10,
+        clientY: 10,
+        isPrimary: true,
+        pointerId: 1,
+      });
+      fireEvent.pointerDown(target, {
+        button: 0,
+        clientX: 12,
+        clientY: 12,
+        isPrimary: false,
+        pointerId: 2,
+      });
+      const pointerUpOrder = touchUpOrder === "first" ? [1, 2] : [2, 1];
+      for (const pointerId of pointerUpOrder) {
+        fireEvent.pointerUp(target, {
+          button: 0,
+          clientX: 10,
+          clientY: 10,
+          isPrimary: pointerId === 1,
+          pointerId,
+        });
+      }
+      expect(onOpenChange).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not dismiss from disabled zoom controls or their toolbar surface", () => {
+    const { onOpenChange } = renderPreview([IMAGE_ITEM, { ...IMAGE_ITEM, alt: "second" }]);
+    mockImageRect(imageElement(), { left: 100, top: 100, right: 300, bottom: 300 });
+
+    fireEvent.click(screen.getByRole("button", { name: "缩小" }));
+    const zoomOut = screen.getByRole("button", { name: "缩小" }) as HTMLButtonElement;
+    expect(zoomOut.disabled).toBe(true);
+    tap(zoomOut.parentElement!, 10, 10);
+
+    for (let index = 0; index < 6; index += 1) {
+      fireEvent.click(screen.getByRole("button", { name: "放大" }));
+    }
+    const zoomIn = screen.getByRole("button", { name: "放大" }) as HTMLButtonElement;
+    expect(zoomIn.disabled).toBe(true);
+    tap(zoomIn.parentElement!, 10, 10);
+
+    const download = screen.getByRole("button", { name: "下载图片" });
+    tap(download.parentElement!, 10, 10);
+    tap(screen.getByRole("button", { name: "下一张图片" }), 10, 10);
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("cancels an old gesture when gallery navigation changes the item", () => {
