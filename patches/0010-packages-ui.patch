diff --git a/packages/ui/test/sidePaneCapsuleExclusivity.test.ts b/packages/ui/test/sidePaneCapsuleExclusivity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..be5f5f868b28a108e76d51c1e60c0d3990cc79be
--- /dev/null
+++ b/packages/ui/test/sidePaneCapsuleExclusivity.test.ts
@@ -0,0 +1,144 @@
+// @vitest-environment jsdom
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import {
+  resolveCapsuleVariantForOpenSidePane,
+  shouldCloseSidePaneForCapsuleExpand,
+  useSidePaneCapsuleExclusivity,
+  type SidePaneCapsuleExclusivityOptions,
+} from "@/v4/status-capsule/index.js";
+
+describe("side pane / status capsule exclusivity rules", () => {
+  it("folds the capsule whenever the side pane is open", () => {
+    expect(
+      resolveCapsuleVariantForOpenSidePane({ isSidePaneOpen: true, variant: "panel" }),
+    ).toBe("mini");
+    expect(
+      resolveCapsuleVariantForOpenSidePane({ isSidePaneOpen: true, variant: null }),
+    ).toBe("mini");
+    expect(
+      resolveCapsuleVariantForOpenSidePane({ isSidePaneOpen: true, variant: "mini" }),
+    ).toBe("mini");
+    expect(
+      resolveCapsuleVariantForOpenSidePane({ isSidePaneOpen: false, variant: "panel" }),
+    ).toBe("panel");
+  });
+
+  it("closes the side pane only when expanding the capsule while it is open", () => {
+    expect(
+      shouldCloseSidePaneForCapsuleExpand({ isSidePaneOpen: true, nextVariant: "panel" }),
+    ).toBe(true);
+    expect(
+      shouldCloseSidePaneForCapsuleExpand({ isSidePaneOpen: false, nextVariant: "panel" }),
+    ).toBe(false);
+    expect(
+      shouldCloseSidePaneForCapsuleExpand({ isSidePaneOpen: true, nextVariant: "mini" }),
+    ).toBe(false);
+    expect(
+      shouldCloseSidePaneForCapsuleExpand({ isSidePaneOpen: true, nextVariant: null }),
+    ).toBe(false);
+  });
+});
+
+describe("useSidePaneCapsuleExclusivity", () => {
+  function setup(overrides: Partial<SidePaneCapsuleExclusivityOptions> = {}) {
+    const onChangeVariant = vi.fn();
+    const onCloseSidePane = vi.fn();
+    const initialProps: SidePaneCapsuleExclusivityOptions = {
+      isSidePaneOpen: false,
+      variant: null,
+      scopeKey: "workspace-a\u0000task-a",
+      onChangeVariant,
+      onCloseSidePane,
+      ...overrides,
+    };
+    const rendered = renderHook(
+      (props: SidePaneCapsuleExclusivityOptions) => useSidePaneCapsuleExclusivity(props),
+      { initialProps },
+    );
+    return { ...rendered, onChangeVariant, onCloseSidePane, initialProps };
+  }
+
+  it("forces mini on mount when the side pane is already open", async () => {
+    const { onChangeVariant } = setup({ isSidePaneOpen: true, variant: "panel" });
+    await waitFor(() => expect(onChangeVariant).toHaveBeenCalledWith("mini"));
+  });
+
+  it("forces mini when an open entry changes an automatic capsule to panel intent", async () => {
+    const { onChangeVariant } = setup({ isSidePaneOpen: true, variant: null });
+    await waitFor(() => expect(onChangeVariant).toHaveBeenCalledWith("mini"));
+  });
+
+  it("does not touch the capsule when the side pane is closed", () => {
+    const { onChangeVariant } = setup({ isSidePaneOpen: false, variant: "panel" });
+    expect(onChangeVariant).not.toHaveBeenCalled();
+  });
+
+  it("closes the side pane when the user expands the capsule", () => {
+    const { result, onChangeVariant, onCloseSidePane } = setup({
+      isSidePaneOpen: true,
+      variant: "mini",
+    });
+
+    act(() => result.current.handleVariantChange("panel"));
+
+    expect(onCloseSidePane).toHaveBeenCalledTimes(1);
+    expect(onChangeVariant).toHaveBeenCalledWith("panel");
+  });
+
+  it("expands the capsule without touching a closed side pane", () => {
+    const { result, onChangeVariant, onCloseSidePane } = setup({
+      isSidePaneOpen: false,
+      variant: "mini",
+    });
+
+    act(() => result.current.handleVariantChange("panel"));
+
+    expect(onCloseSidePane).not.toHaveBeenCalled();
+    expect(onChangeVariant).toHaveBeenCalledWith("panel");
+  });
+
+  it("reapplies the open-side-pane fold after a scope switch", async () => {
+    const { rerender, onChangeVariant, initialProps } = setup({
+      isSidePaneOpen: true,
+      variant: "mini",
+    });
+
+    rerender({
+      ...initialProps,
+      isSidePaneOpen: true,
+      variant: "panel",
+      scopeKey: "workspace-b\u0000task-b",
+    });
+
+    await waitFor(() => expect(onChangeVariant).toHaveBeenCalledWith("mini"));
+  });
+
+  it("does not auto-expand the capsule when the side pane closes", () => {
+    const { result, rerender, onChangeVariant, onCloseSidePane, initialProps } = setup({
