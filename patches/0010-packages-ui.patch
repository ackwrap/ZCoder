+      await pendingSave;
+    });
+    renderSection({
+      compactionProfile: "compact",
+      onCompactionTailBudgetTokensChange: onTailChange,
+    });
+    const input = screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement;
