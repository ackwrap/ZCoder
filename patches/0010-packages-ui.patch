@@ -0,0 +1,30 @@
+import type { CodeViewerSource } from "@/lib/codeViewer.js";
+import { isCommandOutputLogPath } from "./CommandOutputFilePreviewDialog.js";
+
+export type PreviewSourceDispatch = "dialog" | "viewer" | "none";
+
+/**
+ * 聊天侧打开文件的单一入口。宿主把 onOpenCodeViewer 换成这里的分派后，
+ * 即使某层卡片只转发了旧回调（嵌套分组、子代理行），命令输出日志也会走弹窗。
+ */
+export function dispatchPreviewSource(
+  source: CodeViewerSource,
+  handlers: {
+    openCommandOutputPreview?: (request: { path: string; title: string }) => void;
+    openCodeViewer?: (source: CodeViewerSource) => void;
+  },
+): PreviewSourceDispatch {
+  if (source.type === "file" && isCommandOutputLogPath(source.path)) {
+    if (handlers.openCommandOutputPreview) {
+      handlers.openCommandOutputPreview({ path: source.path, title: source.title });
+      return "dialog";
+    }
+  }
+
+  if (handlers.openCodeViewer) {
+    handlers.openCodeViewer(source);
+    return "viewer";
+  }
+
+  return "none";
+}
