diff --git a/packages/ui/test/commandOutputFilePreviewDialog.test.ts b/packages/ui/test/commandOutputFilePreviewDialog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5714723735325a71c6082b93d12d6243efb3a67c
