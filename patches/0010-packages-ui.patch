+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  CodeViewer,
+  isCodeCommentDraftDirty,
+} from "../src/components/ui/code-viewer.js";
+
+vi.mock("@pierre/diffs/react", () => ({
+  File: ({
+    lineAnnotations,
+    options,
+    renderAnnotation,
+  }: {
+    lineAnnotations?: unknown[];
+    options?: { onLineSelectionEnd?: (range: { start: number; end: number }) => void };
+    renderAnnotation?: (annotation: unknown) => unknown;
+  }) =>
+    createElement(
+      "div",
+      { "data-testid": "diffs-file" },
+      createElement(
+        "button",
+        {
+          type: "button",
+          "data-testid": "select-line",
+          onClick: () => options?.onLineSelectionEnd?.({ start: 1, end: 1 }),
+        },
+        "select",
+      ),
+      ...(lineAnnotations?.map((annotation, index) =>
+        createElement("div", { key: index }, renderAnnotation?.(annotation)),
+      ) ?? []),
+    ),
+}));
+
+afterEach(cleanup);
+
+describe("isCodeCommentDraftDirty", () => {
+  it("only treats an open draft with non-whitespace text as unsaved", () => {
+    expect(isCodeCommentDraftDirty(null, "text")).toBe(false);
+    expect(isCodeCommentDraftDirty({ startLine: 1, endLine: 1 }, "")).toBe(false);
+    expect(isCodeCommentDraftDirty({ startLine: 1, endLine: 1 }, "   \n")).toBe(false);
+    expect(isCodeCommentDraftDirty({ startLine: 1, endLine: 1 }, "review note")).toBe(true);
+  });
+});
+
+describe("CodeViewer comment draft dirty reporting", () => {
+  it("reports an open draft with text as dirty and clears it on cancel", async () => {
+    const onChange = vi.fn();
+    const view = render(
+      createElement(CodeViewer, {
+        code: "const value = 1;",
+        language: "typescript",
+        enableLineSelection: true,
+        onSubmitCodeComment: vi.fn(),
+        onCodeCommentDraftDirtyChange: onChange,
+      }),
+    );
+
+    fireEvent.click(view.getByTestId("select-line"));
+    const textarea = await view.findByRole("textbox");
+
+    fireEvent.change(textarea, { target: { value: "please check" } });
+    await waitFor(() => expect(onChange).toHaveBeenLastCalledWith(true));
+
+    fireEvent.click(view.getByRole("button", { name: /^Cancel/ }));
+    await waitFor(() => expect(onChange).toHaveBeenLastCalledWith(false));
+  });
+});
