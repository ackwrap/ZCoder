@@ -0,0 +1,9 @@
+# Compat slash command integration
+
+- Module: `compat-slash-commands-ui`; layer: `ui`; owner: conversation UI. Public entry `contract.ts`; dependencies `shared`, `ui`, React. Registration is coordinated externally; this change does not edit architecture-policy.
+- `useCompatSlashCommands` builds commands from injected rows, context usage, olderRowsAvailable, locale, notification, fork admission/callback/current-row reader, desktop flag/platform close method, close command id, warning callback and CLI names. SessionPane remains the sole owner of snapshots, readOnly/runtime admission, existing handleFork and platform capabilities.
+- Fork resolves the current latest CLI-projected canFork assistant row at invocation and calls handleFork; no alternative fork path. Readonly/otherwise denied views provide no fork command. Only desktop registers a close callback; rejected executeDesktopCommand promises reach the warning callback. Web stubs must not be treated as desktop.
+- All compat values yield to exact normalized CLI names. Existing slash panel rendering and keyboard behavior are untouched. Copy/export retain current window-only semantics and older-history disclosure.
+- MCP send admission uses the exact typed alias: CLI mcp blocks local /mcp only; CLI mcps blocks local /mcps only. Whitespace/case normalization is preserved; arguments and prefix matches are not local status commands. MCP dialog ownership remains in SessionPane; all non-local sends use the existing dispatch path.
+- No new persistent state, cache, asynchronous queue, replay or delivery path; desktop and remote snapshots retain existing owners. Hook memoization derives commands, not a second source of accepted state.
+- Regression evidence: exact MCP collision matrix, current fork target/callback, readonly and desktop gates, rejected close, CLI collisions, copy/export are tested before implementation. Existing browser tool fixture checks unchanged presentation; dedicated compat browser fixture verifies real command clicks, clipboard and download.
diff --git a/packages/ui/src/v4/slash-commands/autocompact.ts b/packages/ui/src/v4/slash-commands/autocompact.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09411dc0b50b020de2dc4f919feaebee2d211ffd
--- /dev/null
+++ b/packages/ui/src/v4/slash-commands/autocompact.ts
@@ -0,0 +1,76 @@
+import { useMemo } from "react";
+import type { CommandAck, CommandPayloadMap } from "@zcode/shared/zcode-protocol-v4";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+
+export function parseAutoCompactInput(
+  text: string,
+): CommandPayloadMap["configureAutoCompact"] | null {
+  const match = /^\/autocompact(?:\s+(.*))?$/i.exec(text.trim());
+  if (!match) return null;
+  const argument = (match[1] ?? "").trim();
+  if (!argument) return {};
+  if (argument.toLowerCase() === "reset") return { limit: null };
+  const number = /^(\d+(?:\.\d+)?)\s*([km%]?)$/i.exec(argument);
+  if (!number) throw new Error("用法：/autocompact [100k | 1m | 80% | reset]");
+  const unit = number[2]!.toLowerCase();
+  const value = Number(number[1]) * (unit === "k" ? 1000 : unit === "m" ? 1000000 : 1);
+  if (
+    !Number.isFinite(value) ||
+    value <= 0 ||
+    (unit === "%" ? value > 100 : !Number.isSafeInteger(value))
+  ) {
+    throw new Error("自动压缩上限必须是正整数 token 数，或 0–100% 之间的占比。");
+  }
+  return { limit: { unit: unit === "%" ? "percent" : "tokens", value } };
+}
+
+interface AutoCompactCommandDeps {
+  enabled: boolean;
+  cliNames: ReadonlySet<string>;
+  execute: (payload: CommandPayloadMap["configureAutoCompact"]) => Promise<CommandAck>;
+  notify: (message: string) => void;
+  prepareInput: () => void;
+}
+
+export function buildAutoCompactCommand(deps: AutoCompactCommandDeps) {
+  const available = deps.enabled && !deps.cliNames.has("autocompact");
+  const run = async (text: string): Promise<"sent" | "blocked" | null> => {
+    if (!available || !/^\/autocompact(?:\s|$)/i.test(text.trim())) return null;
+    try {
+      const payload = parseAutoCompactInput(text)!;
+      const ack = await deps.execute(payload);
+      if (ack.status !== "accepted" || ack.result?.type !== "configureAutoCompact") {
+        throw new Error(ack.reasonCode ?? "当前服务端不支持设置自动压缩上限。");
+      }
+      const result = ack.result;
+      const requested = result.limit
+        ? `${result.limit.value}${result.limit.unit === "percent" ? "%" : " tokens"}`
+        : "默认";
+      deps.notify(
+        `当前会话自动压缩上限：${requested}；实际触发阈值 ${result.effectiveThresholdTokens.toLocaleString()} / ${result.contextWindowTokens.toLocaleString()} tokens。`,
+      );
+      return "sent";
+    } catch (error) {
+      deps.notify(error instanceof Error ? error.message : "自动压缩上限操作失败。");
+      return "blocked";
+    }
+  };
+  const commands: AppSlashCommand[] = available
+    ? [
+        {
+          value: "autocompact",
+          description: "查看当前会话自动压缩上限；输入 100k、1m、80% 或 reset 设置",
+          keywords: ["autocompact", "自动压缩", "上限", "threshold"],
+          run: deps.prepareInput,
+        },
+      ]
+    : [];
+  return { run, commands };
+}
+
+export function useAutoCompactCommand(deps: AutoCompactCommandDeps) {
+  return useMemo(
+    () => buildAutoCompactCommand(deps),
+    [deps.enabled, deps.cliNames, deps.execute, deps.notify, deps.prepareInput],
+  );
+}
