@@ -0,0 +1,25 @@
+import type { Locale } from "@zcode/shared";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+
+/** `/context` 需要的最小用量结构；只取快照已投影的字段，命令实现不直接读 store。 */
+export interface ContextWindowUsage {
+  usedTokens: number;
+  maxTokens: number;
+  autoCompactThresholdTokens?: number | null;
+}
+
+/** 追加到 `/` 面板的本地命令依赖；数据与提示入口都由 SessionPane 注入。 */
+export interface CompatSlashCommandDeps {
+  locale: Locale;
+  rows: readonly ConversationRow[];
+  contextWindow: ContextWindowUsage | null;
+  /** 窗口是否只是尾部切片；为 true 时导出提示会说明更早历史未包含。 */
+  olderRowsAvailable: boolean;
+  /** 轻量提示入口；接入方传入全局 toast。 */
+  notify: (message: string) => void;
+  /** 复用现有 fork 入口；返回 false 表示没有可 fork 的行。null 表示当前视图不允许。 */
+  forkLatest: (() => boolean) | null;
+  /** 复用现有窗口关闭入口；null 表示非桌面环境。 */
+  closeWindow: (() => void) | null;
+  openModelMenu?: (() => boolean) | null;
+}
diff --git a/packages/ui/src/v4/slash-commands/useCompatSlashCommands.ts b/packages/ui/src/v4/slash-commands/useCompatSlashCommands.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39e088bc63b3c996718291d125f6ff33d34fe0b6
--- /dev/null
+++ b/packages/ui/src/v4/slash-commands/useCompatSlashCommands.ts
@@ -0,0 +1,100 @@
+import { useMemo } from "react";
+import type { DesktopCommandId } from "@zcode/shared";
+import type { ConversationRow, ConversationRowTarget } from "@zcode/shared/zcode-protocol-v4";
+import { buildCompatSlashCommands } from "./index.js";
+import { findLatestForkableRow } from "./rows.js";
+import type { CompatSlashCommandDeps } from "./types.js";
+
+export interface CompatSlashCommandIntegrationDeps extends Omit<
+  CompatSlashCommandDeps,
+  "forkLatest" | "closeWindow"
+> {
+  forkActionsEnabled: boolean;
+  snapshotRef: { readonly current: { rows: { window: readonly ConversationRow[] } } | null };
+  handleFork: (target: ConversationRowTarget) => unknown;
+  isDesktop: boolean;
+  closeWindowCommand: DesktopCommandId;
+  platform:
+    | { executeDesktopCommand?: (command: DesktopCommandId) => Promise<unknown> }
+    | null
+    | undefined;
+  logger: { warn: (message: string, details: { error: unknown }) => void };
+  cliSlashCommandNames: ReadonlySet<string>;
+}
+
+export function buildIntegratedCompatSlashCommands(deps: CompatSlashCommandIntegrationDeps) {
+  return buildCompatSlashCommands({
+    ...deps,
+    forkLatest: deps.forkActionsEnabled
+      ? () => {
+          const target = findLatestForkableRow(deps.snapshotRef.current?.rows.window ?? []);
+          if (!target) return false;
+          deps.handleFork(target);
+          return true;
+        }
+      : null,
+    // Web platform stubs also expose this method; explicit desktop admission is required.
+    closeWindow:
+      deps.isDesktop && deps.platform?.executeDesktopCommand
+        ? () => {
+            void deps.platform!.executeDesktopCommand!(deps.closeWindowCommand).catch((error) =>
+              deps.logger.warn("[v4-pane] 关闭窗口失败", { error }),
+            );
+          }
+        : null,
+  }).filter((command) => !deps.cliSlashCommandNames.has(command.value));
+}
+
+export function useCompatSlashCommands(deps: CompatSlashCommandIntegrationDeps) {
+  const {
+    locale,
+    rows,
+    contextWindow,
+    olderRowsAvailable,
+    notify,
+    forkActionsEnabled,
+    snapshotRef,
+    handleFork,
+    isDesktop,
+    closeWindowCommand,
+    platform,
+    logger,
+    cliSlashCommandNames,
+    openModelMenu,
+  } = deps;
+  return useMemo(
+    () =>
+      buildIntegratedCompatSlashCommands({
+        locale,
+        rows,
+        contextWindow,
+        olderRowsAvailable,
+        notify,
+        forkActionsEnabled,
+        snapshotRef,
+        handleFork,
+        isDesktop,
+        closeWindowCommand,
+        platform,
+        logger,
+        cliSlashCommandNames,
+        openModelMenu,
+      }),
+    [
+      locale,
+      rows,
+      contextWindow,
+      olderRowsAvailable,
+      notify,
+      forkActionsEnabled,
+      snapshotRef,
+      handleFork,
+      isDesktop,
+      closeWindowCommand,
+      platform,
+      logger,
+      cliSlashCommandNames,
+      openModelMenu,
+    ],
+  );
+}
