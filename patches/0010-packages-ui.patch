+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { createModelEffortCommands } from "./model-effort.js";
+import { createContextCommand } from "./commands/context.js";
+import { createCopyCommand } from "./commands/copy.js";
+import { createExitCommand } from "./commands/exit.js";
+import { createExportCommand } from "./commands/export.js";
+import { createForkCommand } from "./commands/fork.js";
+import { collectTranscriptEntries } from "./transcript.js";
+import type { CompatSlashCommandDeps } from "./types.js";
+
+export * from "./rows.js";
+export * from "./types.js";
+
+/**
+ * 构造追加到 `/` 面板的本地命令。调用方只需把返回值并入 `appSlashCommands`；
+ * SessionPane 的 useCompatSlashCommands 在注册边界过滤 CLI 同名命令。
+ */
+export function buildCompatSlashCommands(deps: CompatSlashCommandDeps): AppSlashCommand[] {
+  const entries = collectTranscriptEntries(deps.rows);
+  return [
+    ...createModelEffortCommands(deps.locale, deps.openModelMenu, deps.notify),
+    createCopyCommand(entries, deps.locale, deps.notify),
+    createExportCommand(entries, deps.olderRowsAvailable, deps.locale, deps.notify),
+    createContextCommand(deps.contextWindow, deps.locale, deps.notify),
+    // 只读或当前视图不允许 fork 时不注册写命令，避免面板出现必然失败的入口。
+    ...(deps.forkLatest
+      ? [
+          createForkCommand("fork", deps.forkLatest, deps.locale, deps.notify),
+          createForkCommand("branch", deps.forkLatest, deps.locale, deps.notify),
+        ]
+      : []),
+    createExitCommand(deps.closeWindow, deps.locale, deps.notify),
+  ];
+}
