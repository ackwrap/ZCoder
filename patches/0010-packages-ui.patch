+++ b/packages/ui/src/v4/composer/model-system-prompt/ModelSystemPromptToggle.tsx
@@ -0,0 +1,126 @@
+import { memo, useCallback, useRef, useState } from "react";
+import { FileTextIcon } from "lucide-react";
+import {
+  normalizeModelSystemPromptText,
+  resolveModelSystemPromptEntry,
+  type ModelSystemPromptEntry,
+} from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { cn } from "@/components/lib/utils.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import {
+  isModelSystemPromptEnabled,
+  resolveModelSystemPromptScope,
+  setModelSystemPromptEnabled,
+  type ModelSystemPromptScope,
+} from "./storage.js";
+
+export const TID_MODEL_SYSTEM_PROMPT_TOGGLE = "v4-model-system-prompt-toggle";
+
+export interface ModelSystemPromptToggleProps {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  sessionId: string | null;
+  /** 草稿 owner；真实 Session 忽略。 */
+  draftOwnerKey?: string | null;
+  entries?: readonly ModelSystemPromptEntry[] | null;
+  providerId?: string | null;
+  modelId?: string | null;
+  /** 当前 Host 的 hello capability；旧 Host 必须隐藏，不能显示一个假启用入口。 */
+  hostSupported: boolean;
+}
+
+function workspaceScopeKey(workspacePath: string, workspaceIdentity: string | undefined): string {
+  return workspaceIdentity?.trim() || workspacePath.trim();
+}
+
+function MountedModelSystemPromptToggle({
+  scope,
+  enabledLabelId,
+  disabledLabelId,
+}: {
+  scope: ModelSystemPromptScope;
+  enabledLabelId: string;
+  disabledLabelId: string;
+}) {
+  const { intl } = useZCodeIntl();
+  // 初值同步读取模块内存/持久化副本；挂载后不会用迟到磁盘值覆盖用户刚点的状态。
+  const [enabled, setEnabled] = useState(() => isModelSystemPromptEnabled(scope));
+  const enabledRef = useRef(enabled);
+  enabledRef.current = enabled;
+  const label = intl.formatMessage({
+    id: enabled ? disabledLabelId : enabledLabelId,
+  });
+
+  const handleToggle = useCallback(() => {
+    // 直接写内存 + localStorage；不调用任何服务，因此不触发生成、模型切换或 runtime 重启。
+    const next = !enabledRef.current;
+    enabledRef.current = next;
+    setEnabled(next);
+    setModelSystemPromptEnabled(scope, next);
+  }, [scope]);
+
+  return (
+    <ControlHintTooltip title={label} side="top">
+      <Button
+        type="button"
+        variant="ghost"
+        size="icon-md"
+        data-testid={TID_MODEL_SYSTEM_PROMPT_TOGGLE}
+        data-model-system-prompt-enabled={enabled ? "true" : "false"}
+        aria-pressed={enabled}
+        aria-label={label}
+        title={label}
+        className={cn(
+          "composer-model-system-prompt h-7 w-7 text-foreground-subtle hover:text-foreground",
+          enabled && "bg-card text-foreground shadow-sm hover:bg-card",
+        )}
+        onClick={handleToggle}
+      >
+        <FileTextIcon className="size-4" aria-hidden />
+      </Button>
+    </ControlHintTooltip>
+  );
+}
+
+/**
+ * 仅当当前模型在共享设置中存在非空精确条目时渲染。开关属于当前会话：
+ * 切换模型沿用同一 enabled；目标无配置时外层直接隐藏。
+ */
+export const ModelSystemPromptToggle = memo(function ModelSystemPromptToggle({
+  workspacePath,
+  workspaceIdentity,
+  sessionId,
+  draftOwnerKey,
+  entries,
+  providerId,
+  modelId,
+  hostSupported,
+}: ModelSystemPromptToggleProps) {
+  if (!hostSupported) return null;
+  if (!providerId?.trim() || !modelId?.trim()) return null;
+  const entry = resolveModelSystemPromptEntry(entries ?? [], {
+    providerId,
+    modelId,
+  });
+  if (!entry || !normalizeModelSystemPromptText(entry.text)) return null;
+
+  const scope = resolveModelSystemPromptScope(
+    workspacePath,
+    workspaceIdentity,
+    sessionId,
+    draftOwnerKey,
+  );
+  if (!scope) return null;
+
+  return (
+    <MountedModelSystemPromptToggle
+      // 作用域变化时重新读取对应会话的开关；模型切换不重置会话 enabled。
+      key={`${workspaceScopeKey(workspacePath, workspaceIdentity)}:${scope.sessionId ?? scope.draftOwnerKey ?? "__draft__"}`}
+      scope={scope}
+      enabledLabelId="chat.modelSystemPrompt.enable"
+      disabledLabelId="chat.modelSystemPrompt.disable"
+    />
+  );
+});
diff --git a/packages/ui/src/v4/composer/model-system-prompt/contract.example.ts b/packages/ui/src/v4/composer/model-system-prompt/contract.example.ts
