@@ -0,0 +1,134 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { exampleComposerModelSelectionIntent } from "./contract.example.js";
+import {
+  acceptModelSelectionIntent,
+  confirmModelSelectionIntent,
+  readModelSelectionIntent,
+  recordModelSelectionIntent,
+  resolveModelSelectionIntentScope,
+  sameModelSelection,
+  type ModelSelection,
+} from "./index.js";
+import { composerModelSelectionIntentModule } from "./module.js";
+
+const A: ModelSelection = {
+  providerId: "provider",
+  modelId: "model-a",
+  options: { reasoningLevel: "low" },
+};
+const B: ModelSelection = {
+  providerId: "provider",
+  modelId: "model-b",
+  options: { reasoningLevel: "high" },
+};
+
+function installStorage(): Map<string, string> {
+  const storage = new Map<string, string>();
+  Object.defineProperty(globalThis, "window", {
+    configurable: true,
+    value: {
+      localStorage: {
+        getItem: (key: string) => storage.get(key) ?? null,
+        setItem: (key: string, value: string) => storage.set(key, value),
+        removeItem: (key: string) => storage.delete(key),
+      },
+    },
+  });
+  return storage;
+}
+
+const scope = resolveModelSelectionIntentScope("/workspace", undefined, "session-1")!;
+
+describe("composer-model-selection-intent contract", () => {
+  beforeEach(() => {
+    installStorage();
+  });
+
+  afterEach(() => {
+    delete (globalThis as { window?: unknown }).window;
+  });
+
+  it("declares its module manifest", () => {
+    expect(composerModelSelectionIntentModule).toMatchObject({
+      id: "composer-model-selection-intent",
+      requires: ["shared", "ui"],
+      publicEntrypoints: ["index.ts"],
+    });
+  });
+
+  it("Root/无 session 不产生作用域", () => {
+    expect(resolveModelSelectionIntentScope("/workspace", undefined, null)).toBeNull();
+    expect(resolveModelSelectionIntentScope("/workspace", undefined, "  ")).toBeNull();
+  });
+
+  it("手选写 pending；快照确认后迟到 ACK 不再回退", () => {
+    const pending = recordModelSelectionIntent(scope, B, { snapshotSelection: A });
+    expect(pending).toMatchObject({ state: "pending", selection: B });
+
+    const confirmed = confirmModelSelectionIntent(scope, B, pending!.version);
+    expect(confirmed).toMatchObject({ state: "confirmed", selection: B });
+
+    expect(acceptModelSelectionIntent(scope, B, pending!.version, B)).toBeNull();
+    expect(readModelSelectionIntent(scope)).toMatchObject({ state: "confirmed", selection: B });
+  });
+
+  it("ACK 先到写 pending，随后快照收敛 confirmed", () => {
+    const pending = recordModelSelectionIntent(scope, B, { snapshotSelection: A });
+    const accepted = acceptModelSelectionIntent(scope, B, pending!.version, A);
+    expect(accepted).toMatchObject({ state: "pending", selection: B });
+
+    expect(confirmModelSelectionIntent(scope, B, pending!.version)).toMatchObject({
+      state: "confirmed",
+    });
+  });
+
+  it("旧版本 ACK 不能覆盖新意图", () => {
+    const first = recordModelSelectionIntent(scope, A, { snapshotSelection: null });
+    const second = recordModelSelectionIntent(scope, B, { snapshotSelection: null });
+    expect(second!.version).not.toBe(first!.version);
+
+    expect(acceptModelSelectionIntent(scope, A, first!.version, null)).toBeNull();
+    expect(readModelSelectionIntent(scope)).toMatchObject({ state: "pending", selection: B });
+  });
+
+  it("快照已相同时直接写 confirmed，不再是未消费意图", () => {
+    const record = recordModelSelectionIntent(scope, B, { snapshotSelection: B });
+    expect(record).toMatchObject({ state: "confirmed", selection: B });
+    expect(acceptModelSelectionIntent(scope, B, record!.version, B)).toBeNull();
+  });
+
+  it("按 session 隔离记录", () => {
+    const other = resolveModelSelectionIntentScope("/workspace", undefined, "session-2")!;
+    recordModelSelectionIntent(scope, A, { snapshotSelection: null });
+    recordModelSelectionIntent(other, B, { snapshotSelection: null });
+    expect(readModelSelectionIntent(scope)?.selection.modelId).toBe("model-a");
+    expect(readModelSelectionIntent(other)?.selection.modelId).toBe("model-b");
+  });
+
+  it("选择等价只比较完整 provider/model/reasoning", () => {
+    expect(sameModelSelection(B, { ...B, options: { ...B.options } })).toBe(true);
+    expect(sameModelSelection(B, { ...B, options: { reasoningLevel: "low" } })).toBe(false);
+    expect(sameModelSelection(B, { ...B, providerId: "other" })).toBe(false);
+  });
+
+  it("标准示例覆盖 pending 到 confirmed 的调用顺序", () => {
+    expect(
+      exampleComposerModelSelectionIntent({
+        workspacePath: "/workspace",
+        sessionId: "session-1",
+        selected: B,
+        snapshotSelection: A,
+      }),
+    ).toEqual({ pendingVersion: expect.any(String), confirmed: false });
+
+    expect(
+      exampleComposerModelSelectionIntent({
+        workspacePath: "/workspace",
+        sessionId: null,
+        selected: B,
+        snapshotSelection: B,
+      }),
+    ).toEqual({ pendingVersion: null, confirmed: false });
+  });
+});
