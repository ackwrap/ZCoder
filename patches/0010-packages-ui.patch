+          type="button"
+          size="icon"
+          variant="ghost"
+          className="size-7 rounded-full"
+          data-testid={TID_FOCUS_MODE_OLDER}
+          aria-label={intl.formatMessage({ id: "conversation.focusMode.older" })}
+          title={intl.formatMessage({ id: "conversation.focusMode.older" })}
+          onClick={onOlder}
+        >
+          <ArrowUpIcon className="size-4" />
+        </Button>
+        <Button
+          type="button"
+          size="icon"
+          variant="ghost"
+          className="size-7 rounded-full"
+          data-testid={TID_FOCUS_MODE_NEWER}
+          aria-label={intl.formatMessage({ id: "conversation.focusMode.newer" })}
+          title={intl.formatMessage({ id: "conversation.focusMode.newer" })}
+          onClick={onNewer}
+        >
+          <ArrowDownIcon className="size-4" />
+        </Button>
+        {loadStatus === "error" || loadStatus === "exhausted" ? (
+          <Button
+            type="button"
+            size="icon"
+            variant="ghost"
+            className={cn("size-7 rounded-full", loadStatus === "error" && "text-destructive")}
+            data-testid={TID_FOCUS_MODE_RETRY}
+            aria-label={intl.formatMessage({ id: "conversation.focusMode.retry" })}
+            title={intl.formatMessage({ id: "conversation.focusMode.retry" })}
+            onClick={onRetry}
+          >
+            <RotateCcwIcon className="size-4" />
+          </Button>
+        ) : null}
+      </div>
+      {statusText ? (
+        <span role="status" aria-live="polite" className="sr-only">
+          {isLatest && loadStatus === "exhausted"
+            ? intl.formatMessage({ id: "conversation.focusMode.noOlder" })
+            : statusText}
+        </span>
+      ) : null}
+    </div>
+  );
+}
