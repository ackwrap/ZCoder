+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { join } from "node:path";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/session-diagnostics.fixture.tsx";
+let server, browser, origin;
+before(async () => {
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      react(),
+      tailwindcss(),
+      {
+        name: "session-diagnostics-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0, hmr: false },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  await browser?.close();
+  server?.httpServer?.closeAllConnections();
+  await server?.close();
+});
+
+for (const width of [320, 1200])
+  for (const locale of ["zh-CN", "en-US"])
+    for (const theme of ["light", "dark"]) {
+      test(`session diagnostics ${width}/${locale}/${theme}`, async () => {
+        const page = await browser.newPage({
+          viewport: { width, height: 800 },
+          isMobile: width === 320,
+          hasTouch: width === 320,
+        });
+        const errors = [];
+        page.on("pageerror", (error) => errors.push(String(error)));
+        try {
+          await page.goto(`${origin}fixture?${new URLSearchParams({ locale, theme })}`);
+          await page.getByTestId("context-compact-budget").waitFor();
+          assert.equal(await page.getByTestId("context-diagnostics").locator("p").count(), 0);
+          assert.ok(
+            (await page.getByTestId("context-diagnostics").textContent()).includes(
+              "long-model-name",
+            ),
+          );
+          assert.equal(
+            await page.getByTestId("context-configured-window").getAttribute("data-source"),
+            "discovered",
+          );
+          if (process.env.DIAGNOSTIC_SCREENSHOT_DIR)
+            await page.screenshot({
+              path: join(
+                process.env.DIAGNOSTIC_SCREENSHOT_DIR,
+                `context-${width}-${locale}-${theme}.png`,
+              ),
+            });
+          assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
+          await page.getByTestId("open-mcp").click();
+          const dialog = page.getByTestId("mcp-status-dialog");
+          await dialog.waitFor();
+          assert.equal(await dialog.getByRole("switch").count(), 0);
+          assert.equal(await dialog.getByRole("checkbox").count(), 0);
+          await page.getByTestId("mcp-status-refresh").waitFor({ state: "visible" });
+          await dialog.locator("summary").click();
+          const report = await dialog.locator("pre").textContent();
+          assert.ok(report.includes("toolCount: 0"));
+          assert.ok(!report.includes("fixture-private-value"));
+          assert.ok(!report.includes("hidden-token"));
+          const bounds = await dialog.boundingBox();
+          assert.ok(bounds.x >= 0 && bounds.x + bounds.width <= width + 1);
+          assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
+          await dialog
+            .getByRole("button", { name: locale === "zh-CN" ? "复制诊断" : "Copy diagnostics" })
+            .click();
+          await dialog.getByRole("status").waitFor();
+          assert.ok(
+            (await dialog.getByRole("status").textContent()).includes(
+              locale === "zh-CN" ? "已复制" : "copied",
+            ),
+          );
+          if (process.env.DIAGNOSTIC_SCREENSHOT_DIR)
+            await page.screenshot({
+              path: join(
+                process.env.DIAGNOSTIC_SCREENSHOT_DIR,
+                `diagnostics-${width}-${locale}-${theme}.png`,
+              ),
+            });
+          assert.deepEqual(errors, []);
+        } finally {
+          await page.close();
+        }
+      });
+    }
