@@ -0,0 +1,267 @@
+import { useMemo, useState } from "react";
+import {
+  GOD_DEPARTMENTS,
+  ZCODE_AGENT_PROVIDER,
+  resolveModelSystemPromptEntry,
+  type AppSettings,
+  type GodDepartmentConfig,
+  type GodDepartmentDefinition,
+  type GodDepartmentId,
+  type GodDepartmentsConfig,
+  type ModelSelection,
+  type ModelSystemPromptEntry,
+} from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { Textarea } from "@/components/ui/textarea.js";
+import { Switch } from "@/components/ui/switch.js";
+import {
+  Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle,
+} from "@/components/ui/dialog.js";
+import {
+  AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent,
+  AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle,
+} from "@/components/ui/alert-dialog.js";
+import { ModelConfigSelect, type ModelSelectGroup } from "@/ModelConfigSelect.js";
+import { useModelSelectionServiceView } from "@/hooks/useModelSelectionView.js";
+import { useBaseWorkspaceServices } from "@/hooks/useWorkspaceServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { buildRegistryModelSelectGroups, resolveModelDisplayName } from "@/lib/modelSelectionGroups.js";
+import { decodeCustomModelValue, encodeCustomModelValue } from "@/lib/zcodeCustomModelValue.js";
+import { GodDepartmentsGraph } from "./GodDepartmentsGraph.js";
+
+interface Props {
+  settings?: AppSettings | null;
+  onUpdateSettings: (patch: Partial<AppSettings>) => Promise<void>;
+}
+
+function ResetDepartmentsDialog({ open, title, description, busy, error, onOpenChange, onConfirm }: {
+  open: boolean;
+  title: string;
+  description: string;
+  busy: boolean;
+  error?: string | null;
+  onOpenChange: (open: boolean) => void;
+  onConfirm: () => void;
+}) {
+  const { intl } = useZCodeIntl();
+  return <AlertDialog open={open} onOpenChange={(next) => { if (!busy) onOpenChange(next); }}>
+    <AlertDialogContent>
+      <AlertDialogHeader>
+        <AlertDialogTitle>{title}</AlertDialogTitle>
+        <AlertDialogDescription>{description}</AlertDialogDescription>
+      </AlertDialogHeader>
+      {error && <p role="alert" className="text-ui-sm text-destructive">{error}</p>}
+      <AlertDialogFooter>
+        <AlertDialogCancel disabled={busy}>{intl.formatMessage({ id: "settings.godDepartments.cancel" })}</AlertDialogCancel>
+        <AlertDialogAction disabled={busy} onClick={(event) => { event.preventDefault(); onConfirm(); }}>
+          {intl.formatMessage({ id: "settings.godDepartments.resetConfirm" })}
+        </AlertDialogAction>
+      </AlertDialogFooter>
+    </AlertDialogContent>
+  </AlertDialog>;
+}
+
+function DepartmentConfigDialog({ department, config, groups, modelPrompts, busy, onSave, onReset, onClose }: {
+  department: GodDepartmentDefinition;
+  config?: GodDepartmentConfig;
+  groups: readonly ModelSelectGroup[];
+  modelPrompts?: readonly ModelSystemPromptEntry[];
+  busy: boolean;
+  onSave: (config: GodDepartmentConfig) => Promise<void>;
+  onReset: () => Promise<void>;
+  onClose: () => void;
+}) {
+  const { intl } = useZCodeIntl();
+  const text = (key: string) => intl.formatMessage({ id: `settings.godDepartments.${key}` });
+  const [model, setModel] = useState<ModelSelection | undefined>(config?.modelSelection);
+  const [prompt, setPrompt] = useState(config?.systemPrompt ?? department.systemPrompt);
+  const [useModelPrompt, setUseModelPrompt] = useState(config?.useModelSystemPrompt === true);
+  const [error, setError] = useState<string | null>(null);
+  const [resetOpen, setResetOpen] = useState(false);
+  const [resetError, setResetError] = useState<string | null>(null);
+  const value = model ? encodeCustomModelValue(model.providerId, model.modelId) : "";
+  const label = value ? (resolveModelDisplayName(groups, value) ?? model?.modelId ?? value) : text("inherit");
+  const hasModelPrompt = Boolean(resolveModelSystemPromptEntry(modelPrompts, model));
+  const modelPromptStatus = !model ? "modelPromptInherited" : hasModelPrompt ? "modelPromptAvailable" : "modelPromptMissing";
+
+  const save = async () => {
+    const trimmed = prompt.trim();
+    if (trimmed.length > 100_000) {
+      setError(text("promptTooLong"));
+      return;
+    }
+    setError(null);
+    try {
+      await onSave({
+        ...(model ? { modelSelection: model } : {}),
+        ...(useModelPrompt ? { useModelSystemPrompt: true } : {}),
+        ...(trimmed && trimmed !== department.systemPrompt.trim() ? { systemPrompt: trimmed } : {}),
+      });
+      onClose();
+    } catch (cause) {
+      setError(`${text("error")}: ${cause instanceof Error ? cause.message : String(cause)}`);
+    }
+  };
+
+  const reset = async () => {
+    setResetError(null);
+    try {
+      await onReset();
+      onClose();
+    } catch (cause) {
+      setResetError(`${text("error")}: ${cause instanceof Error ? cause.message : String(cause)}`);
+    }
+  };
+
+  return <Dialog open onOpenChange={(open) => { if (!open && !busy && !resetOpen) onClose(); }}>
+    <DialogContent className="max-h-[90dvh] overflow-y-auto sm:max-w-2xl" showCloseButton={!busy}>
+      <DialogHeader className="pr-8">
+        <DialogTitle>{intl.formatMessage({ id: "settings.godDepartments.configure" }, { department: department.name })}</DialogTitle>
+        <DialogDescription>{department.description}</DialogDescription>
+      </DialogHeader>
+      <div className="space-y-2">
+        <div className="text-ui-sm font-medium">{text("model")}</div>
+        <ModelConfigSelect
+          modelGroups={groups}
+          normalizedValue={value}
+          triggerLabel={label}
+          triggerLabelClassName="min-w-0 text-left"
+          triggerClassName="border border-border"
+          triggerTestId={`god-department-model-${department.id}`}
+          focusSelectorOnClose={null}
+          showManageModelsAction={false}
+          lockReasonMessage=""
+          isItemLocked={() => false}
+          leadingItems={[{ key: "inherit", value: "", name: text("inherit") }]}
+          onValueChange={(next) => {
+            if (!next) { setModel(undefined); return; }
+            const decoded = decodeCustomModelValue(next);
+            if (decoded?.modelName) setModel({ providerId: decoded.providerId, modelId: decoded.modelName });
+          }}
+          disabled={busy}
+        />
+      </div>
+      <div className="space-y-2 rounded-xl border border-border p-3">
+        <div className="flex items-center justify-between gap-3">
+          <label htmlFor={`god-model-prompt-${department.id}`} className="text-ui-sm font-medium">{text("useModelPrompt")}</label>
+          <Switch
+            id={`god-model-prompt-${department.id}`}
+            aria-describedby={`god-model-prompt-description-${department.id}`}
+            checked={useModelPrompt}
+            onCheckedChange={setUseModelPrompt}
+            disabled={busy}
+          />
+        </div>
+        <div id={`god-model-prompt-description-${department.id}`} className="text-ui-sm text-foreground-subtle">
+          <p>{text("modelPromptOrder")}</p>
+          <p>{text(modelPromptStatus)}</p>
+        </div>
+      </div>
+      <label className="block space-y-2">
+        <span className="text-ui-sm font-medium">{text("prompt")}</span>
+        <Textarea value={prompt} disabled={busy} onChange={(event) => setPrompt(event.target.value)} className="h-64 resize-y overflow-y-auto whitespace-pre-wrap" />
+      </label>
+      {error && <p role="alert" className="text-ui-sm text-destructive">{error}</p>}
+      <DialogFooter className="sm:justify-between">
+        <div className="flex flex-wrap gap-2">
+          <Button type="button" variant="ghost" onClick={() => setPrompt(department.systemPrompt)} disabled={busy}>{text("restore")}</Button>
+          <Button type="button" variant="ghost" onClick={() => { setResetError(null); setResetOpen(true); }} disabled={busy}>{text("resetDepartment")}</Button>
+        </div>
+        <div className="flex justify-end gap-2">
+          <Button type="button" variant="ghost" onClick={onClose} disabled={busy}>{text("cancel")}</Button>
+          <Button type="button" onClick={() => void save()} disabled={busy}>{text("save")}</Button>
+        </div>
+      </DialogFooter>
+    </DialogContent>
+    <ResetDepartmentsDialog
+      open={resetOpen}
+      title={intl.formatMessage({ id: "settings.godDepartments.resetDepartmentTitle" }, { department: department.name })}
+      description={text("resetDepartmentDescription")}
+      busy={busy}
+      error={resetError}
+      onOpenChange={setResetOpen}
+      onConfirm={() => void reset()}
+    />
+  </Dialog>;
+}
+
+export function GodDepartmentsSection({ settings, onUpdateSettings }: Props) {
+  const { intl } = useZCodeIntl();
+  const services = useBaseWorkspaceServices();
+  const read = useModelSelectionServiceView(services.modelSelectionService);
+  const view = read.state.status === "ready" ? read.state.view : null;
+  const groups = useMemo(() => view ? buildRegistryModelSelectGroups(ZCODE_AGENT_PROVIDER, view, {
+    startPlanBadgeLabel: intl.formatMessage({ id: "settings.modelProvider.connectionMode.startPlanBadge" }),
+    apiKeyLabel: intl.formatMessage({ id: "settings.modelProvider.apiKey" }),
+    codingPlanLabel: intl.formatMessage({ id: "settings.modelProvider.connectionMode.codingPlan" }),
+  }) : [], [intl, view]);
+  const [busy, setBusy] = useState(false);
+  const [savingLock] = useState(() => ({ current: false }));
+  const [selectedId, setSelectedId] = useState<GodDepartmentId | null>(null);
+  const [resetAllOpen, setResetAllOpen] = useState(false);
+  const [resetError, setResetError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const selected = GOD_DEPARTMENTS.find((department) => department.id === selectedId);
+  const text = (key: string) => intl.formatMessage({ id: `settings.godDepartments.${key}` });
+
+  const updateDepartments = async (update: (latest: GodDepartmentsConfig) => GodDepartmentsConfig) => {
+    if (savingLock.current) throw new Error("Save in progress");
+    savingLock.current = true;
+    setBusy(true);
+    setNotice(null);
+    try {
+      const latest = await services.settingService.get();
+      await onUpdateSettings({ godDepartments: update(latest.godDepartments ?? {}) });
+    } finally {
+      savingLock.current = false;
+      setBusy(false);
+    }
+  };
+
+  const resetAll = async () => {
+    setResetError(null);
+    try {
+      await updateDepartments(() => ({}));
+      setResetAllOpen(false);
+      setNotice(text("resetAllSuccess"));
+    } catch (cause) {
+      setResetError(`${text("error")}: ${cause instanceof Error ? cause.message : String(cause)}`);
+    }
+  };
+
+  return <div className="space-y-4">
+    <div className="flex flex-wrap items-start justify-between gap-3">
+      <p className="min-w-0 flex-1 text-ui-sm text-foreground-subtle">{text("description")}</p>
+      <Button type="button" variant="outline" size="sm" disabled={busy || !settings} onClick={() => { setResetError(null); setResetAllOpen(true); }}>{text("resetAll")}</Button>
+    </div>
+    {notice && <p role="status" className="text-ui-sm text-foreground-subtle">{notice}</p>}
+    <GodDepartmentsGraph config={settings?.godDepartments} disabled={busy || !settings} onSelect={setSelectedId} />
+    {selected && <DepartmentConfigDialog
+      key={selected.id}
+      department={selected}
+      config={settings?.godDepartments?.[selected.id]}
+      groups={groups}
+      modelPrompts={settings?.modelSystemPromptAppends}
+      busy={busy || !settings}
+      onClose={() => setSelectedId(null)}
+      onSave={(config) => updateDepartments((latest) => ({ ...latest, [selected.id]: config }))}
+      onReset={async () => {
+        await updateDepartments((latest) => {
+          const next = { ...latest };
+          delete next[selected.id];
+          return next;
+        });
+        setNotice(intl.formatMessage({ id: "settings.godDepartments.resetDepartmentSuccess" }, { department: selected.name }));
+      }}
+    />}
+    <ResetDepartmentsDialog
+      open={resetAllOpen}
+      title={text("resetAll")}
+      description={text("resetAllDescription")}
+      busy={busy || !settings}
+      error={resetError}
+      onOpenChange={setResetAllOpen}
+      onConfirm={() => void resetAll()}
+    />
+  </div>;
+}
