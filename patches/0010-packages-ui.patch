+  type CommandOutputPreviewScope,
+} from "@/v4/command-output-file-preview/contract.js";
+
+vi.mock("@/components/ui/dialog.js", () => ({
+  Dialog: ({
+    children,
+    open,
+    onOpenChange,
+  }: {
+    children?: ReactNode;
+    open?: boolean;
+    onOpenChange?: (open: boolean) => void;
+  }) =>
+    open
+      ? createElement(
+          "div",
+          null,
+          createElement(
