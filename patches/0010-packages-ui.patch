+              <span className="min-w-0 truncate">
+                {gitSummary.branchName ?? label("chat.inspector.detached")}
+              </span>
+            </div>
+          )
+        ) : null}
+        {isRepository ? (
+          <>
+            <button
+              type="button"
+              data-testid="inspector-open-changes"
+              disabled={!onOpenGitReview}
+              onClick={() => onOpenGitReview?.(reviewSourceId ?? undefined)}
+              className="flex w-full items-center gap-2 rounded-lg py-1 text-left text-ui-sm hover:bg-hover disabled:cursor-default disabled:opacity-50"
+            >
+              <FileDiffIcon className="size-4 shrink-0 text-foreground-subtle" />
+              <span className="min-w-0 flex-1 text-foreground-subtle">
+                {label("chat.inspector.reviewChanges")}
+              </span>
+              {changeSummary ? (
+                <span className="shrink-0 tabular-nums">
+                  <span className="text-diff-added">+{changeSummary.added}</span>{" "}
+                  <span className="text-diff-removed">-{changeSummary.removed}</span>
+                </span>
+              ) : null}
+            </button>
+            {!readOnly && onRefreshGit && gitSummary ? (
+              <GitActionMenu
+                workspacePath={workspacePath}
+                workspaceIdentity={workspaceIdentity}
+                gitSummary={gitSummary}
+                activeTaskChangeSummary={activeTaskChangeSummary}
