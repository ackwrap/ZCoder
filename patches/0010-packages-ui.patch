+import { memo } from "react";
+import { RefreshCwIcon } from "lucide-react";
+import type { TimelineMarkerRow } from "@zcode/shared/zcode-protocol-v4";
+import { TID_V4_ROW, testId } from "@zcode/shared/test-ids";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+export const ContextSourceUpdateNotice = memo(function ContextSourceUpdateNotice({
+  row,
+}: {
+  row: TimelineMarkerRow;
+}) {
+  const { intl } = useZCodeIntl();
+  if (row.marker.type !== "contextSourceUpdate") return null;
+  const update = row.marker.update;
+  const source = intl.formatMessage({ id: `chat.contextSourceUpdate.source.${update.kind}` });
+  const title = intl.formatMessage({ id: "chat.contextSourceUpdate.title" }, { source });
+  const list = (
+    <ul className="min-w-0 space-y-1 text-ui-sm text-foreground-subtle">
+      {update.changes.map((change) => (
+        <li key={change.sourceKey} className="flex min-w-0 items-baseline gap-2">
+          <span className="shrink-0">
+            {intl.formatMessage({ id: `chat.contextSourceUpdate.change.${change.change}` })}
+          </span>
+          <span className="min-w-0 break-words text-foreground">{change.label}</span>
+        </li>
+      ))}
+    </ul>
+  );
+  return (
+    <div
+      data-row-id={row.rowId}
+      data-row-kind="timelineMarker"
+      data-marker-type="contextSourceUpdate"
+      data-testid={testId(TID_V4_ROW, String(row.rowId))}
+      className="mx-4 my-1 min-w-0 rounded-xl border border-border bg-surface px-3 py-2"
+    >
+      <div className="mb-1 flex min-w-0 items-center gap-2 text-ui-sm text-foreground-subtle">
+        <RefreshCwIcon aria-hidden className="size-3.5 shrink-0" />
+        <span>{title}</span>
+        <span className="text-ui-xs">
+          {intl.formatMessage(
+            { id: "chat.contextSourceUpdate.counts" },
+            {
+              added: update.changes.filter((change) => change.change === "added").length,
+              replaced: update.changes.filter((change) => change.change === "replaced").length,
+              removed: update.changes.filter((change) => change.change === "removed").length,
+            },
+          )}
+        </span>
+      </div>
+      {update.changes.length > 5 ? (
+        <details>
+          <summary className="cursor-pointer text-ui-sm text-foreground-subtle">
+            {intl.formatMessage({ id: "chat.contextSourceUpdate.details" })}
+          </summary>
+          <div className="mt-2">{list}</div>
+        </details>
+      ) : (
+        list
+      )}
+    </div>
+  );
+});
