@@ -0,0 +1,29 @@
+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { editionMessagesEnUS, editionMessagesZhCN } from "./contract.js";
+import { editionMessageFingerprints } from "./fixtures.js";
+
+function fingerprint(messages: Record<string, string>) {
+  return createHash("sha256")
+    .update(JSON.stringify(Object.entries(messages).sort(([a], [b]) => a.localeCompare(b, "en"))))
+    .digest("hex");
+}
+
+describe("edition messages contract", () => {
+  it("retains every pre-extraction message", () => {
+    expect(fingerprint(editionMessagesEnUS)).toBe(editionMessageFingerprints.enUS);
+    expect(fingerprint(editionMessagesZhCN)).toBe(editionMessageFingerprints.zhCN);
+  });
+  it("has complete bilingual keys and matching interpolation parameters", () => {
+    expect(Object.keys(editionMessagesZhCN).sort()).toEqual(
+      Object.keys(editionMessagesEnUS).sort(),
+    );
+    for (const [key, value] of Object.entries(editionMessagesEnUS)) {
+      const parameters = (text: string) =>
+        [...text.matchAll(/\{([\w]+)[},]/g)].map((match) => match[1]).sort();
+      expect(parameters(editionMessagesZhCN[key as keyof typeof editionMessagesZhCN]), key).toEqual(
+        parameters(value),
+      );
+    }
+  });
+});
