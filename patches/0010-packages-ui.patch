+    const pane = document.querySelector('[data-testid="fixture-conversation-pane"]');
+    const asideRect = aside.getBoundingClientRect();
+    const composerRect = composer.getBoundingClientRect();
+    return {
+      paneBottom: pane.getBoundingClientRect().bottom,
+      asideTop: asideRect.top,
+      asideBottom: asideRect.bottom,
+      asideHeight: asideRect.height,
+      asideLeft: asideRect.left,
+      composerTop: composerRect.top,
+      composerBottom: composerRect.bottom,
+      composerRight: composerRect.right,
+      innerHeight,
+    };
+  });
+}
+function assertRailReachesBottom(geometry) {
+  assert.ok(geometry.paneBottom <= geometry.innerHeight + 1);
+  assert.ok(
+    Math.abs(geometry.asideBottom - (geometry.paneBottom - 16)) <= 1.5,
+    `inspector bottom ${geometry.asideBottom} should reach pane bottom ${geometry.paneBottom - 16}`,
+  );
+  assert.ok(geometry.asideBottom <= geometry.innerHeight);
+  assert.ok(Math.abs(geometry.composerBottom - (geometry.paneBottom - 16)) <= 1.5);
+}
