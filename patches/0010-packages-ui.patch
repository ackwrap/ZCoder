--- /dev/null
+++ b/packages/ui/src/v4/slash-commands/rows.ts
@@ -0,0 +1,20 @@
+import type {
+  ConversationRow,
+  ConversationRowTarget,
+} from "@zcode/shared/zcode-protocol-v4";
+
+/**
+ * 窗口内最近一个可 fork 的助手行。判定与行内 fork 入口同源：只认 CLI 投影出的
+ * `actions.canFork` 和 `entityId`，UI 不自行推断稳定边界。
+ */
+export function findLatestForkableRow(
+  rows: readonly ConversationRow[],
+): ConversationRowTarget | null {
+  for (let index = rows.length - 1; index >= 0; index -= 1) {
+    const row = rows[index];
+    if (row?.kind === "assistantText" && row.entityId && row.actions?.canFork) {
+      return { rowId: row.rowId, entityId: row.entityId };
+    }
+  }
+  return null;
+}
diff --git a/packages/ui/src/v4/slash-commands/transcript.ts b/packages/ui/src/v4/slash-commands/transcript.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a2ace32c8f0e496649172da381a0ec9983ee3ef7
--- /dev/null
+++ b/packages/ui/src/v4/slash-commands/transcript.ts
@@ -0,0 +1,72 @@
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import { splitUserInputEpilogue } from "@/v4/ConversationUserInputEpilogue.js";
+
+export interface TranscriptEntry {
+  role: "user" | "assistant";
+  text: string;
+}
+
+/** 从行窗口按时间顺序提取可导出的纯文本；工具调用、推理等行不进入导出。 */
+export function collectTranscriptEntries(
+  rows: readonly ConversationRow[],
+): TranscriptEntry[] {
+  const entries: TranscriptEntry[] = [];
+  for (const row of rows) {
+    if (row.kind === "userInput") {
+      // 启动轮的 userInput 由 run 卡代言，时间线不显示，导出也跳过。
+      if (row.origin === "workflowLaunch") continue;
+      // 与消息气泡一致：只导出正文，引擎附加的尾注折叠内容不进文件。
+      const { body } = splitUserInputEpilogue(row.text, row.epilogueStart);
+      const text = body.trim();
+      if (text) entries.push({ role: "user", text });
+      continue;
+    }
+    if (row.kind === "assistantText") {
+      const text = row.text.trim();
+      if (text) entries.push({ role: "assistant", text });
+    }
+  }
+  return entries;
+}
+
+export function latestAssistantText(entries: readonly TranscriptEntry[]): string | null {
+  for (let index = entries.length - 1; index >= 0; index -= 1) {
+    const entry = entries[index];
+    if (entry?.role === "assistant") return entry.text;
+  }
+  return null;
+}
+
+export function buildMarkdownTranscript(
+  entries: readonly TranscriptEntry[],
+  labels: { untitled: string; userLabel: string; assistantLabel: string },
+): string {
+  const lines = [`# ${labels.untitled}`, ""];
+  for (const entry of entries) {
+    lines.push(
+      `## ${entry.role === "user" ? labels.userLabel : labels.assistantLabel}`,
+      "",
+      entry.text,
+      "",
+    );
+  }
+  return lines.join("\n");
+}
+
+export function buildExportFileName(now: Date): string {
+  return `zcode-conversation-${now.toISOString().replace(/[:.]/g, "-")}.md`;
+}
+
+export function formatTokenCount(tokens: number): string {
+  if (!Number.isFinite(tokens) || tokens < 0) return "0";
+  if (tokens < 1000) return String(Math.round(tokens));
+  const millions = tokens / 1_000_000;
+  // 999.5k 起向上取整会得到 1000k，统一进位成 m，避免出现四位数单位。
+  if (millions >= 0.9995) {
+    const digits = millions >= 100 ? 0 : 1;
+    return `${millions.toFixed(digits).replace(/\.0$/, "")}m`;
+  }
+  const thousands = tokens / 1000;
+  const digits = thousands >= 100 ? 0 : 1;
+  return `${thousands.toFixed(digits).replace(/\.0$/, "")}k`;
+}
