+// @vitest-environment jsdom
+
+import { createElement } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { ToolCallBlock } from "../src/ToolCallBlocks.js";
+import { toolCallRowToLegacyNode } from "../src/v4/toolCallRowAdapter.js";
+
+afterEach(cleanup);
+
+function row(overrides: Partial<ToolCallRow> = {}): ToolCallRow {
+  return {
+    rowId: 1,
+    turnId: "turn-read-scope",
+    createdAt: 1,
+    createdAtSeq: 1,
+    kind: "toolCall",
+    toolCallId: "read-scope",
+    toolName: "Read",
+    status: "success",
+    inputText: '{"file_path":"/workspace/example.ts"}',
+    input: { file_path: "/workspace/example.ts" },
+    output: { text: "1\tfirst\n2\tsecond" },
+    ...overrides,
+  };
+}
+
+function card(value: ToolCallRow, locale: "zh-CN" | "en-US" = "zh-CN", onOpenCodeViewer = vi.fn()) {
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: locale },
+    createElement(ToolCallBlock, {
+      toolCallNode: toolCallRowToLegacyNode(value),
+      workspacePath: "/workspace",
+      onOpenCodeViewer,
+    }),
+  );
+}
+
+describe("Read scope in actual tool cards", () => {
+  it("marks a completed whole text read beside the file name", () => {
+    render(card(row()));
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("全文");
+    expect(screen.getByRole("button", { name: "example.ts" })).toBeTruthy();
+  });
+
+  it("shows the actual returned range instead of the requested maximum", () => {
+    render(
+      card(
+        row({
+          input: { file_path: "/workspace/example.ts", offset: 200, limit: 59 },
+          output: { text: "200\tfirst\n201\tsecond" },
+        }),
+      ),
+    );
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("offset 200 · 2 行");
+  });
+
+  it("updates a requested whole read to a truncated actual range", () => {
+    const view = render(card(row({ status: "running", output: undefined })));
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("全文请求");
+    view.rerender(
+      card(
+        row({
+          output: {
+            text: "<system-reminder>Showing a partial view of lines 1-2 of 800.</system-reminder>\n\n1\tfirst\n2\tsecond",
+          },
+        }),
+      ),
+    );
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("offset 1 · 2 行 · 已截断");
+  });
+
+  it("does not mistake a transport-truncated preview for a full file", () => {
+    render(
+      card(
+        row({
+          output: {
+            text: "1\tfirst\n…\n800\tlast",
+            truncated: { totalBytes: 90_000, ref: "tool-output/read-scope" },
+          },
+        }),
+      ),
+    );
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("全文请求 · 已截断");
+  });
+
+  it("uses request wording for failed range reads", () => {
+    render(
+      card(
+        row({
+          status: "error",
+          input: { file_path: "/workspace/example.ts", offset: 60, limit: 60 },
+          output: undefined,
+          error: { code: "read_failed", message: "File does not exist" },
+        }),
+      ),
+    );
+    expect(screen.getByTestId("read-scope-label").textContent).toBe(
+      "offset 60 · 最多 60 行（请求）",
+    );
+  });
+
+  it("keeps range metadata visible in English", () => {
+    render(
+      card(
+        row({
+          input: { file_path: "/workspace/example.ts", limit: 60 },
+          output: { text: "1\tfirst" },
+        }),
+        "en-US",
+      ),
+    );
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("offset 1 · 1 line");
+  });
+
+  it.each([
+    [{ status: "running", output: undefined }, "Full file requested"],
+    [
+      {
+        input: { file_path: "/workspace/example.ts", offset: 4 },
+        status: "running",
+        output: undefined,
+      },
+      "offset 4 · to end of file (requested)",
+    ],
+    [
+      {
+        input: { file_path: "/workspace/example.ts", limit: 4 },
+        status: "running",
+        output: undefined,
+      },
+      "offset 1 · up to 4 lines (requested)",
+    ],
+    [{}, "Full file"],
+  ] satisfies [Partial<ToolCallRow>, string][])(
+    "localizes request and full-file labels %j",
+    (overrides, label) => {
+      render(card(row(overrides), "en-US"));
+      expect(screen.getByTestId("read-scope-label").textContent).toBe(label);
+    },
+  );
+
+  it("waits for complete input before showing scope during streaming", () => {
+    const view = render(
+      card(
+        row({
+          status: "running",
+          input: undefined,
+          inputText: '{"file_path":"/workspace/ex',
+          output: undefined,
+        }),
+      ),
+    );
+    expect(screen.queryByTestId("read-scope-label")).toBeNull();
+    view.rerender(card(row({ status: "running", output: undefined })));
+    expect(screen.getByTestId("read-scope-label").textContent).toBe("全文请求");
+  });
+
+  it("keeps the existing file preview callback", () => {
+    const open = vi.fn();
+    render(card(row(), "zh-CN", open));
+    fireEvent.click(screen.getByRole("button", { name: "example.ts" }));
+    expect(open).toHaveBeenCalledWith({
+      type: "file",
+      title: "example.ts",
+      path: "/workspace/example.ts",
+    });
+  });
+
+  it("does not attach text range labels to image reads", () => {
+    render(
+      card(row({ input: { file_path: "/workspace/example.png" }, output: { text: "Read image" } })),
+    );
+    expect(screen.queryByTestId("read-scope-label")).toBeNull();
+  });
+});
