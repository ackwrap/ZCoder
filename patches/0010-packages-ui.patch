+// 轮次间距：规格见 docs/chat/conversation-turn-view-model.md「轮次间距」。
+// 用真实 ConversationTurnGroup 量两轮之间的实际视觉间隙，而不是断言 class 字符串。
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/turn-spacing.fixture.tsx";
+const artifacts = join(root, "packages/desktop/.e2e-artifacts/turn-spacing");
+let server, browser, origin;
+
+before(async () => {
+  await mkdir(artifacts, { recursive: true });
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      {
+        name: "turn-spacing-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+      react(),
+      tailwindcss(),
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: {
+      host: "127.0.0.1",
+      port: 0,
+      hmr: false,
+      watch: { ignored: ["**/packages/desktop/out/**", "**/.e2e-artifacts/**"] },
+    },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+
+for (const mobile of [false, true])
+  for (const theme of ["light", "dark"]) {
+    test(`轮次间距 ${mobile ? "mobile" : "desktop"}/${theme}`, async () => {
+      const page = await browser.newPage({
+        viewport: { width: mobile ? 390 : 1200, height: 900 },
+        isMobile: mobile,
+        hasTouch: mobile,
+      });
+      const errors = [];
+      page.on("pageerror", (error) => errors.push(String(error)));
+      try {
+        await page.goto(`${origin}fixture?mobile=${mobile}&theme=${theme}`);
+        const turnsRoot = page.getByTestId("turns-root");
+        await turnsRoot.waitFor();
+
+        const sections = turnsRoot.locator(":scope > section");
+        assert.equal(await sections.count(), 2, "fixture 应渲染两轮");
+
+        const [first, second] = [sections.nth(0), sections.nth(1)];
+        const firstStyle = await first.evaluate((node) => getComputedStyle(node));
+        const secondStyle = await second.evaluate((node) => getComputedStyle(node));
+
+        // 轮间距 = 上一轮内容底边 → 下一轮内容顶边。section 的 padding 算在盒子内，
+        // 直接量两个 section 盒子会得到 0，所以取各自的最后一个/第一个内容节点。
+        assert.equal(firstStyle.paddingBottom, "16px", "轮底应为 pb-4");
+        assert.equal(secondStyle.paddingTop, "28px", "常规轮顶应为 pt-7");
+
+        const [firstContent, secondContent] = await Promise.all([
+          first.locator(":scope > *").last().boundingBox(),
+          second.locator(":scope > *").first().boundingBox(),
+        ]);
+        assert.ok(firstContent && secondContent);
+        const gap = secondContent.y - (firstContent.y + firstContent.height);
+        assert.ok(Math.abs(gap - 44) < 1, `相邻两轮内容间距应为 44px，实际 ${gap}px`);
+
+        // 轮次间距必须显著小于改动前的 76px，避免回退。
+        assert.ok(gap < 60, `轮次间距不应回到 76px 量级，实际 ${gap}px`);
+
+        // 轮底 padding 是轮间距的唯一来源，容器不再额外叠加底部留白。
+        const rootStyle = await turnsRoot.evaluate((node) => getComputedStyle(node));
+        assert.equal(rootStyle.paddingBottom, "0px", "轮次容器不应再叠加底部留白");
+
+        await page.screenshot({
+          path: join(artifacts, `${theme}-${mobile ? "mobile" : "desktop"}.png`),
+        });
+        assert.deepEqual(errors, []);
+      } finally {
+        await page.close();
+      }
+    });
+  }
