+/**
+ * 模型请求前的运行时鉴权桥：把 Agent 的 `providerRuntimeHeaders.request` 变成
+ * "跑验证码 → 回填 `X-Aliyun-Captcha-Verify-*` 头"。
+ *
+ * 官方实现（`request-security-edition` 的 CTt / wTt / TTt）三条语义，逐条保留：
+ *   - 同一 (workspace, sessionId, requestId) 的重复请求只应答一次（合并），避免 workspace 级
+ *     与 session 级两个订阅者各跑一次验证码；
+ *   - 账号不需要验证码时也要回 `headersApplied:true + 空 headers`，否则 CLI 会判失败；
+ *   - 取消通知必须 abort 正在跑的验证码，否则 CLI 已失败而 Helper 仍占着队列。
+ */
+
+import {
+  isRequestVerificationMessage,
+  requiresRequestVerification,
+  type RequestVerificationConfig,
+  type ZCodeProviderRuntimeHeadersRequestParams,
+} from "@zcode/shared";
+import type { IServiceAccessor } from "@zcode/services";
+
+import { logger } from "@/logger.js";
+
+import { prepareCaptchaVerification } from "./captcha.js";
+
+const VERIFICATION_FAILED_MESSAGE = "Captcha verification failed. Please try again.";
+
+type ProviderSettingsService = IServiceAccessor["providerSettingsService"];
+type CodingPlanService = IServiceAccessor["codingPlanSubscriptionService"];
+type ZCodeAgentService = IServiceAccessor["zcodeAgentService"];
+
+export interface ProviderRuntimeAuthBridgeInput {
+  request: ZCodeProviderRuntimeHeadersRequestParams;
+  zcodeAgentService: ZCodeAgentService;
+  codingPlanSubscriptionService: CodingPlanService;
+  providerSettingsService: ProviderSettingsService;
+  signal?: AbortSignal;
+}
+
+interface InFlightEntry {
+  promise: Promise<void>;
+  controller: AbortController;
+}
+
+const inFlight = new Map<string, InFlightEntry>();
+/** certifyId 台账：只用于诊断「同一 certifyId 被复用」这种 F008 预兆。 */
+const lastCertifyId = new Map<string, string | null>();
+
+function requestKey(request: ZCodeProviderRuntimeHeadersRequestParams): string {
+  const workspaceKey = request.workspace.workspaceIdentity?.trim() || request.workspace.workspacePath;
+  return [workspaceKey, request.sessionId, request.requestId].join("::");
+}
+
+function errorKindOf(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  if (message.startsWith("Captcha instance timed out after ")) return "instance_timeout";
+  if (message.startsWith("Captcha initialization timed out.")) return "initialization_timeout";
+  if (message === "Failed to load captcha script.") return "script_load_failed";
+  if (message.startsWith("Captcha verification timed out after ")) return "verification_timeout";
+  if (message.startsWith("Traceless captcha timed out after ")) return "traceless_timeout";
+  return "unknown";
+}
+
+/** 从 provider 设置里读该 provider 的 access（请求没带 accountAccess 时用）。 */
+async function resolveAccess(
+  input: ProviderRuntimeAuthBridgeInput,
+): Promise<{ type?: string; mode?: string } | undefined> {
+  const direct = input.request.accountAccess;
+  if (direct) return direct as { type?: string; mode?: string };
+  const view = await input.providerSettingsService.getView();
+  const provider = view.providers.find((item) => item.providerId === input.request.providerId);
+  return provider?.effectiveConfig?.access as { type?: string; mode?: string } | undefined;
+}
+
+function isStartPlanAccount(access: { type?: string; mode?: string } | undefined): boolean {
+  return access?.type === "zhipu-account" && requiresRequestVerification(access as { mode: string });
+}
+
+/**
+ * 跑一次验证码并给出要回填的 headers。
+ *
+ * `skipModelRequest` / `enabled:false` 时返回空 headers（仍然 headersApplied=true，
+ * 让服务端把账号本身的鉴权材料下发）。
+ */
+async function resolveVerificationHeaders(input: {
+  request: ZCodeProviderRuntimeHeadersRequestParams;
+  codingPlanSubscriptionService: CodingPlanService;
+  source: string;
+  signal: AbortSignal;
+}): Promise<Record<string, string>> {
+  const config: RequestVerificationConfig | null =
+    await input.codingPlanSubscriptionService.getRequestVerificationConfig();
+  input.signal.throwIfAborted();
+
+  const providerId = input.request.providerId;
+  if (config?.enabled === false || config?.skipModelRequest === true) {
+    lastCertifyId.delete(providerId);
+    return {};
+  }
+  if (!config || !config.region || !config.prefix || !config.sceneId) {
+    throw new Error(VERIFICATION_FAILED_MESSAGE);
+  }
+
+  const captchaVerifyParam = await prepareCaptchaVerification(input.codingPlanSubscriptionService, {
+    providerId,
+    requestId: input.request.requestId,
+    source: input.source,
+    signal: input.signal,
+  });
+  if (!captchaVerifyParam?.trim()) throw new Error(VERIFICATION_FAILED_MESSAGE);
+
+  const region = config.region?.trim();
+  lastCertifyId.set(providerId, null);
+  return {
+    "X-Aliyun-Captcha-Verify-Param": captchaVerifyParam,
+    ...(region ? { "X-Aliyun-Captcha-Verify-Region": region } : {}),
+  };
+}
+
+async function respond(input: ProviderRuntimeAuthBridgeInput, signal: AbortSignal): Promise<void> {
+  let errorKind: string | undefined;
+  let errorMessage: string | undefined;
+  let headers: Record<string, string> | undefined;
+  const startedAt = Date.now();
+
+  logger.lifecycle.info("[captcha-diagnostics]", {
+    event: "request.received",
+    requestId: input.request.requestId,
+    providerId: input.request.providerId,
+    source: input.request.reason,
+  });
+
+  try {
+    const access = await resolveAccess(input);
+    signal.throwIfAborted();
+    if (isStartPlanAccount(access)) {
+      headers = await resolveVerificationHeaders({
+        request: input.request,
+        codingPlanSubscriptionService: input.codingPlanSubscriptionService,
+        source: input.request.reason === "captcha-retry" ? "captcha_retry" : "send_preflight",
+        signal,
+      });
+    } else {
+      // 账号不需要验证码：回空 headers，但仍然是 headersApplied=true。
+      headers = {};
+    }
+  } catch (error) {
+    if (signal.aborted) {
+      logger.lifecycle.info("[captcha-diagnostics]", {
+        event: "request.cancelled",
+        requestId: input.request.requestId,
+      });
+      return;
+    }
+    errorKind = errorKindOf(error);
+    errorMessage = error instanceof Error ? error.message : String(error);
+    logger.warn("[captcha] provider runtime headers refresh failed", {
+      providerId: input.request.providerId,
+      requestId: input.request.requestId,
+      error: errorMessage,
+    });
+  }
+
+  if (signal.aborted) return;
+
+  logger.lifecycle.info("[captcha-diagnostics]", {
+    event: "request.respond",
+    requestId: input.request.requestId,
+    headersApplied: headers !== undefined,
+    errorKind,
+    elapsedMs: Date.now() - startedAt,
+  });
+
+  await input.zcodeAgentService.respondProviderRuntimeHeaders({
+    workspacePath: input.request.workspace.workspacePath,
+    ...(input.request.workspace.workspaceIdentity
+      ? { workspaceIdentity: input.request.workspace.workspaceIdentity }
+      : {}),
+    sessionId: input.request.sessionId,
+    requestId: input.request.requestId,
+    response:
+      headers !== undefined
+        ? { headersApplied: true, runtimeProviderHeaders: headers }
+        : {
+            headersApplied: false,
+            ...(errorMessage ? { errorMessage } : {}),
+          },
+  });
+}
+
+/** 处理一次请求；同一 key 的重复请求合并到同一个 promise。 */
+export async function handleProviderRuntimeHeadersRequest(
+  input: ProviderRuntimeAuthBridgeInput,
+): Promise<void> {
+  const key = requestKey(input.request);
+  const existing = inFlight.get(key);
+  if (existing) {
+    logger.info("[captcha] provider runtime headers request coalesced", {
+      providerId: input.request.providerId,
+      requestId: input.request.requestId,
+      sessionId: input.request.sessionId,
+    });
+    await existing.promise.catch((error: unknown) => {
+      logger.warn("[captcha] provider runtime headers coalesced response failed", {
+        error: error instanceof Error ? error.message : String(error),
+      });
+    });
+    return;
+  }
+  const controller = new AbortController();
+  const promise = respond(input, controller.signal).finally(() => {
+    inFlight.delete(key);
+  });
+  inFlight.set(key, { promise, controller });
+  await promise.catch((error: unknown) => {
+    logger.warn("[captcha] provider runtime headers response failed", {
+      error: error instanceof Error ? error.message : String(error),
+      providerId: input.request.providerId,
+      requestId: input.request.requestId,
+      sessionId: input.request.sessionId,
+    });
+  });
+}
+
+/** 取消通知：只 abort 同一个 key 的在途请求。 */
+export function cancelProviderRuntimeHeadersRequest(request: {
+  requestId: string;
+  sessionId: string;
+  workspace: { workspacePath: string; workspaceIdentity?: string };
+}): void {
+  const workspaceKey = request.workspace.workspaceIdentity?.trim() || request.workspace.workspacePath;
+  const key = [workspaceKey, request.sessionId, request.requestId].join("::");
+  const entry = inFlight.get(key);
+  if (!entry || entry.controller.signal.aborted) return;
+  logger.info("[captcha] provider runtime headers cancelled", {
+    requestId: request.requestId,
+    sessionId: request.sessionId,
+  });
+  entry.controller.abort(new DOMException("Captcha request cancelled", "AbortError"));
+}
+
+/** 网关 3007 类拒绝是否属于"需要安全验证"，供 UI 决定是否提示重试。 */
+export function isVerificationRejection(message: string): boolean {
+  return isRequestVerificationMessage(message);
+}
