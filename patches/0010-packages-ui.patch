+import type { AppSettings } from "@zcode/shared";
+
+// 预览数据仅驻留内存，不接入 Host、账号、凭据或模型请求。
+export let previewSettings = {
+  godDepartments: {
+    zhongshu: { modelSelection: { providerId: "preview", modelId: "规划模型（演示）" }, useModelSystemPrompt: true },
+    menxia: { modelSelection: { providerId: "preview", modelId: "审核模型（演示）" } },
+  },
+  modelSystemPromptAppends: [
+    { providerId: "preview", modelId: "规划模型（演示）", text: "你是谨慎的规划助手。结论应基于证据，清楚说明假设。" },
+  ],
+} as AppSettings;
+
+export function updatePreviewSettings(patch: Partial<AppSettings>) {
+  previewSettings = { ...previewSettings, ...patch };
+  return previewSettings;
+}
+
+const view = {
+  revision: 1,
+  providers: [{
+    providerId: "preview",
+    providerName: "隔离演示模型",
+    config: { api: { type: "openai" }, access: { type: "api-key" } },
+    models: ["规划模型（演示）", "审核模型（演示）", "开发模型（演示）"].map((modelId) => ({ modelId, config: {} })),
+  }],
+};
+const services = {
+  settingService: { get: async () => previewSettings },
+  modelSelectionService: { getView: async () => view, onDidChange: () => ({ dispose() {} }) },
+};
+export const useBaseWorkspaceServices = () => services;
+export const useOptionalBaseWorkspaceServices = () => null;
+export const useWorkspaceServices = () => services;
+export const useWorkspaceServicesResolution = () => ({ services, status: "ready" });
