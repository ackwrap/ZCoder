diff --git a/packages/ui/src/codex-provider/useCodexConnection.ts b/packages/ui/src/codex-provider/useCodexConnection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b61be71f1dd60cdbaeb62a6e2510afd54582991b
--- /dev/null
+++ b/packages/ui/src/codex-provider/useCodexConnection.ts
@@ -0,0 +1,151 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useServices } from "@/hooks/useServices.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+
+/** Display projection only. The Host owns flow admission, tokens and refresh. */
+export function useCodexConnection(providerId: string) {
+  const candidateService = useServices().codexProviderService;
+  const platform = usePlatform();
+  // Web 远控与桌面共享 Host，但浏览器的 127.0.0.1 并不指向该 Host；不能在手机发起 loopback 登录。
+  const service = platform.canOpenLocalFiles === true ? candidateService : undefined;
+  type ConnectionStatus = Awaited<ReturnType<NonNullable<typeof candidateService>["status"]>>;
+  const [status, setStatus] = useState<ConnectionStatus | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState(false);
+  const owner = useRef(0);
+  const statusRequest = useRef(0);
+  const flow = useRef<string | null>(null);
+  const reload = useCallback(async () => {
+    const generation = owner.current;
+    if (!service) return;
+    const request = ++statusRequest.current;
+    try {
+      const value = await service.status(providerId);
+      if (generation !== owner.current || request !== statusRequest.current) return;
+      setStatus(value);
+      setError(false);
+    } catch {
+      if (generation === owner.current && request === statusRequest.current) setError(true);
+    }
+  }, [providerId, service]);
+  useEffect(() => {
+    owner.current += 1;
+    setStatus(null);
+    setError(false);
+    setBusy(false);
+    void reload();
+    const timer = setInterval(() => void reload(), 1500);
+    return () => {
+      owner.current += 1;
+      clearInterval(timer);
+      if (flow.current) void service?.cancel(providerId, flow.current).catch(() => {});
+      flow.current = null;
+    };
+  }, [providerId, reload, service]);
+  const start = useCallback(async () => {
+    if (!service || busy || !status?.loginAvailable) return;
+    const generation = owner.current;
+    setBusy(true);
+    setError(false);
+    let started: string | undefined;
+    try {
+      const result = await service.start(providerId);
+      started = result.flowId;
+      if (generation !== owner.current) {
+        await service.cancel(providerId, result.flowId);
+        return;
+      }
+      flow.current = result.flowId;
+      // Host 已使用 Codex 的 /oauth/authorize；残留 Token Sharing 旧路径会在打开浏览器前立即取消登录。
+      // 保留精确 origin/path 白名单，不接受任意站点或恢复旧端点回退。
+      const url = new URL(result.authorizeUrl);
+      if (url.origin !== "https://auth.openai.com" || url.pathname !== "/oauth/authorize")
+        throw new Error("invalid-authorization-url");
+      platform.openExternal(result.authorizeUrl);
+      await reload();
+    } catch {
+      if (started) await service.cancel(providerId, started).catch(() => {});
+      if (generation === owner.current) setError(true);
+    } finally {
+      if (generation === owner.current) setBusy(false);
+    }
+  }, [busy, platform, providerId, reload, service, status?.loginAvailable]);
+  const disconnect = useCallback(async () => {
+    if (!service || busy) return;
+    const generation = owner.current;
+    statusRequest.current += 1;
+    setBusy(true);
+    try {
+      await service.disconnect(providerId);
+      if (generation === owner.current) await reload();
+    } catch {
+      if (generation === owner.current) setError(true);
+    } finally {
+      if (generation === owner.current) setBusy(false);
+    }
+  }, [busy, providerId, reload, service]);
+  const startDevice = useCallback(async () => {
+    if (!service || busy || !status?.loginAvailable) return;
+    const generation = owner.current;
+    setBusy(true);
+    setError(false);
+    let started: string | undefined;
+    try {
+      const result = await service.startDevice(providerId);
+      started = result.flowId;
+      if (generation !== owner.current) {
+        await service.cancel(providerId, result.flowId);
+        return;
+      }
+      flow.current = result.flowId;
+      if (result.verificationUrl !== "https://auth.openai.com/codex/device")
+        throw new Error("invalid-device-url");
+      await reload();
+    } catch {
+      if (started) await service.cancel(providerId, started).catch(() => {});
+      if (generation === owner.current) setError(true);
+    } finally {
+      if (generation === owner.current) setBusy(false);
+    }
+  }, [busy, providerId, reload, service, status?.loginAvailable]);
+  const openDevice = useCallback(() => {
+    if (
+      status?.flow?.state === "waiting" &&
+      status.flow.device?.verificationUrl === "https://auth.openai.com/codex/device"
+    )
+      platform.openExternal("https://auth.openai.com/codex/device");
+  }, [platform, status?.flow]);
+  const copyDevice = useCallback(async () => {
+    const code = status?.flow?.state === "waiting" ? status.flow.device?.userCode : undefined;
+    if (!code) return;
+    try {
+      await navigator.clipboard.writeText(code);
+    } catch {
+      setError(true);
+    }
+  }, [status?.flow]);
+  const cancel = useCallback(async () => {
+    if (!service || !status?.flow) return;
+    const generation = owner.current;
+    statusRequest.current += 1;
+    try {
+      await service.cancel(providerId, status.flow.id);
+      if (generation === owner.current) await reload();
+    } catch {
+      if (generation === owner.current) setError(true);
+    }
+  }, [providerId, reload, service, status?.flow]);
+  return {
+    status,
+    busy,
+    error,
+    start,
+    startDevice,
+    openDevice,
+    copyDevice,
+    disconnect,
+    cancel,
+    reload,
+    available: Boolean(service),
+  };
+}
