+++ b/packages/ui/src/settings/god-departments/GodDepartmentsGraph.tsx
@@ -0,0 +1,169 @@
+import { useMemo } from "react";
+import { Controls, Handle, MarkerType, Position, type Edge, type Node, type NodeProps } from "@xyflow/react";
+import { Crown, Settings2 } from "lucide-react";
+import { GOD_DEPARTMENTS, type GodDepartmentId, type GodDepartmentsConfig } from "@zcode/shared";
+import { Canvas } from "@/components/ai-elements/canvas.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+interface Props {
+  config?: GodDepartmentsConfig;
+  disabled: boolean;
+  onSelect: (id: GodDepartmentId) => void;
+}
+
+type DepartmentNodeData = {
+  name: string;
+  description: string;
+  model?: string;
+  promptLabel?: string;
+  configureLabel?: string;
+  disabled?: boolean;
+  onSelect?: () => void;
+};
+
+function DepartmentNode({ data }: NodeProps<Node<DepartmentNodeData>>) {
+  const content = <>
+    <div className="flex items-center justify-between gap-2">
+      <span className="flex items-center gap-2 text-sm font-semibold">{!data.onSelect && <Crown className="size-4 text-amber-500" />}{data.name}</span>
+      {data.onSelect && <Settings2 className="size-3.5 text-foreground-subtle" />}
+    </div>
+    <p className="mt-1 truncate text-[11px] text-foreground-subtle" title={data.description}>{data.description}</p>
+    {data.model && <div className="mt-2 flex items-center gap-1 border-t border-border pt-2 text-[11px]">
+      <span className="min-w-0 flex-1 truncate" title={data.model}>{data.model}</span>
+      {data.promptLabel && <span className="shrink-0 rounded bg-surface-hover px-1.5 text-foreground-subtle">{data.promptLabel}</span>}
+    </div>}
+  </>;
+  return <div className="relative h-full w-full">
+    {data.onSelect
+      ? <button type="button" aria-label={data.configureLabel} onClick={data.onSelect} disabled={data.disabled}
+          className="nodrag nopan pointer-events-auto h-full w-full rounded-xl border border-border bg-background p-3 text-left shadow-sm transition-colors hover:border-foreground-subtle hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50">{content}</button>
+      : <div className="h-full rounded-xl border border-amber-500/40 bg-background p-3">{content}</div>}
+    {([Position.Top, Position.Right, Position.Bottom, Position.Left] as const).flatMap((position) => [
+      <Handle key={`in-${position}`} id={`in-${position}`} type="target" position={position} className="!size-1.5 !border-0 !bg-foreground-subtle" isConnectable={false} />,
+      <Handle key={`out-${position}`} id={`out-${position}`} type="source" position={position} className="!size-1.5 !border-0 !bg-foreground-subtle" isConnectable={false} />,
+    ])}
+  </div>;
+}
+
+function DepartmentGroup({ data }: NodeProps<Node<{ label: string }>>) {
+  return <div className="h-full w-full rounded-2xl border border-dashed border-border bg-surface-hover/30 p-3">
+    <span className="text-xs font-medium text-foreground-subtle">{data.label}</span>
+  </div>;
+}
+
+const NODE_TYPES = { department: DepartmentNode, departmentGroup: DepartmentGroup };
+const NODE_WIDTH = 184;
+const NODE_HEIGHT = 108;
+const POSITIONS: Partial<Record<GodDepartmentId, { x: number; y: number }>> = {
+  taizi: { x: 280, y: 54 },
+  zhongshu: { x: 580, y: 54 },
+  menxia: { x: 1040, y: 54 },
+  shangshu: { x: 810, y: 246 },
+  zaochao: { x: 280, y: 246 },
+};
+const EDGE_COLOR = "var(--color-workflow-trace-strong, #838c9c)";
+
+export function GodDepartmentsGraph({ config, disabled, onSelect }: Props) {
+  const { intl } = useZCodeIntl();
+  const text = (key: string) => intl.formatMessage({ id: `settings.godDepartments.${key}` });
+  const nodes = useMemo<Node[]>(() => {
+    const ministries = GOD_DEPARTMENTS.filter((department) => department.group === "六部");
+    const groups = ([
+      { id: "provinces", type: "departmentGroup", position: { x: 556, y: 0 }, data: { label: text("group.三省") }, style: { width: 692, height: 378 } },
+      { id: "ministries", type: "departmentGroup", position: { x: 0, y: 450 }, data: { label: text("graph.ministries") }, style: { width: 1248, height: 172 } },
+    ] satisfies Node[]).map((node) => ({ ...node, selectable: false, focusable: false, zIndex: -1 }));
+    return [
+      ...groups,
+      { id: "emperor", type: "department", position: { x: 20, y: 54 }, style: { width: NODE_WIDTH, height: NODE_HEIGHT }, data: { name: text("graph.emperor"), description: text("graph.emperorRole") } },
+      ...GOD_DEPARTMENTS.map((department): Node => {
+        const departmentConfig = config?.[department.id];
+        const position = POSITIONS[department.id] ?? { x: 12 + ministries.findIndex((item) => item.id === department.id) * 208, y: 494 };
+        return {
+          id: department.id,
+          type: "department",
+          position,
+          style: { width: NODE_WIDTH, height: NODE_HEIGHT },
+          data: {
+            name: department.name,
+            description: department.description,
+            model: departmentConfig?.modelSelection?.modelId ?? text("inherit"),
+            promptLabel: departmentConfig?.useModelSystemPrompt ? text("graph.modelPrompt") : undefined,
+            configureLabel: intl.formatMessage({ id: "settings.godDepartments.configure" }, { department: department.name }),
+            disabled,
+            onSelect: () => onSelect(department.id),
+          },
+        };
+      }),
+    ];
+  }, [config, disabled, intl, onSelect]);
+
+  const edges = useMemo<Edge[]>(() => {
+    const edge = (source: string, target: string, label: string | undefined, sourcePosition = Position.Right, targetPosition = Position.Left, kind: "forward" | "return" | "support" = "forward"): Edge => {
+      const color = kind === "return" ? "#d59b52" : EDGE_COLOR;
+      return {
+        id: `${source}-${target}`,
+        source, target,
+        sourceHandle: `out-${sourcePosition}`,
+        targetHandle: `in-${targetPosition}`,
+        type: kind === "return" ? "default" : "smoothstep",
+        label,
+        markerEnd: { type: MarkerType.ArrowClosed, color, width: 16, height: 16 },
+        style: { stroke: color, strokeWidth: 1.6, ...(kind !== "forward" ? { strokeDasharray: "5 4" } : {}) },
+        labelStyle: { fill: "var(--color-foreground)", fontSize: 12 },
+        labelBgStyle: { fill: "var(--color-background)", fillOpacity: 0.95 },
+        labelBgPadding: [6, 3],
+        labelBgBorderRadius: 4,
+      };
+    };
+    return [
+      edge("emperor", "taizi", text("graph.request")),
+      edge("taizi", "zhongshu", text("graph.plan")),
+      edge("zhongshu", "menxia", text("graph.review")),
+      edge("menxia", "zhongshu", text("graph.reject"), Position.Top, Position.Top, "return"),
+      edge("menxia", "shangshu", text("graph.approve"), Position.Bottom, Position.Right),
+      edge("shangshu", "taizi", text("graph.report"), Position.Left, Position.Bottom, "return"),
+      edge("shangshu", "zaochao", text("graph.briefing"), Position.Left, Position.Right),
+      edge("zaochao", "shangshu", undefined, Position.Bottom, Position.Left, "return"),
+      ...GOD_DEPARTMENTS.filter((department) => department.group === "六部").flatMap((department) => [
+        edge("shangshu", department.id, undefined, Position.Bottom, Position.Top),
+        edge(department.id, "shangshu", undefined, Position.Right, Position.Bottom, "return"),
+      ]),
+    ];
+  }, [intl]);
+
+  return <section className="overflow-hidden rounded-2xl border border-border" aria-label={text("graph.title")}>
+    <div className="flex flex-wrap items-start justify-between gap-2 border-b border-border px-4 py-3">
+      <div><h2 className="font-medium">{text("graph.title")}</h2><p className="mt-1 text-ui-sm text-foreground-subtle">{text("graph.hint")}</p></div>
+      <span className="rounded-md bg-surface-hover px-2 py-1 text-ui-xs text-foreground-subtle">{intl.formatMessage({ id: "settings.godDepartments.graph.count" }, { count: GOD_DEPARTMENTS.length })}</span>
+    </div>
+    <div className="h-[min(65vh,640px)] min-h-[420px] [&_.react-flow__controls-button]:border-border [&_.react-flow__controls-button]:bg-background [&_.react-flow__controls-button]:fill-foreground">
+      <Canvas
+        nodes={nodes}
+        edges={edges}
+        nodeTypes={NODE_TYPES}
+        nodesDraggable={false}
+        nodesConnectable={false}
+        nodesFocusable={false}
+        edgesFocusable={false}
+        elementsSelectable={false}
+        selectionOnDrag={false}
+        panOnDrag
+        panOnScroll={false}
+        zoomOnScroll={false}
+        zoomOnPinch
+        deleteKeyCode={null}
+        minZoom={0.3}
+        maxZoom={1.6}
+        fitViewOptions={{ padding: 0.12, maxZoom: 1 }}
+        colorMode="system"
+      >
+        <Controls showInteractive={false} />
+      </Canvas>
+    </div>
+    <div className="flex flex-wrap gap-x-6 gap-y-2 border-t border-border px-4 py-3 text-ui-xs text-foreground-subtle">
+      <span className="flex items-center gap-2"><span className="w-6 border-t-2 border-foreground-subtle" />{text("graph.forwardLegend")}</span>
+      <span className="flex items-center gap-2"><span className="w-6 border-t-2 border-dashed border-amber-500" />{text("graph.returnLegend")}</span>
+      <span>{text("graph.runtimeNote")}</span>
+    </div>
+  </section>;
+}
diff --git a/packages/ui/src/settings/god-departments/GodDepartmentsSection.tsx b/packages/ui/src/settings/god-departments/GodDepartmentsSection.tsx
new file mode 100644
