+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { SessionResourcesState } from "@zcode/shared/zcode-protocol-v4";
+import { SessionResourceControls } from "@/session-resource-controls/contract.js";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    locale: "en-US",
+    intl: { formatMessage: ({ id }: { id: string }) => id },
+  }),
+}));
+
+afterEach(cleanup);
+
+const state: SessionResourcesState = {
+  policy: { revision: 0, disabledSkills: [], disabledMcpServers: [] },
+  skills: [
+    { id: "user-skill", label: "user-skill", available: true, enabled: true, source: "user" },
+    { id: "bundled", label: "bundled", available: true, enabled: true, source: "builtin" },
+    { id: "plugin:skill", label: "plugin:skill", available: true, enabled: true, source: "plugin" },
+  ],
+  mcpServers: [
+    { id: "user-mcp", label: "user-mcp", available: true, enabled: true, source: "user" },
+    { id: "node_repl", label: "node_repl", available: true, enabled: true, source: "builtin" },
+    { id: "plugin:pdf", label: "plugin:pdf", available: true, enabled: true, source: "plugin" },
+    // 旧快照没有 source：按用户资源处理，避免把已有配置误判成内置。
+    { id: "legacy", label: "legacy", available: true, enabled: true },
+  ],
+};
+
+function renderControls(userResourcesOnly: boolean) {
+  const result = render(
+    createElement(SessionResourceControls, {
+      state,
+      ready: true,
+      readOnly: false,
+      userResourcesOnly,
+      send: vi.fn(async () => ({ status: "accepted" }) as never),
+    }),
+  );
+  // 分组默认折叠，折叠时 Radix 不渲染内容；先展开才能断言条目是否被过滤。
+  fireEvent.click(screen.getByText("MCP"));
+  fireEvent.click(screen.getByText("Skills"));
+  return result;
+}
+
+describe("SessionResourceControls source filtering", () => {
+  it("keeps the full list by default", () => {
+    renderControls(false);
+    expect(screen.getByText("node_repl")).toBeTruthy();
+    expect(screen.getByText("plugin:pdf")).toBeTruthy();
+    expect(screen.getByText("bundled")).toBeTruthy();
+  });
+
+  it("hides built-in and plugin resources when userResourcesOnly is set", () => {
+    renderControls(true);
+    expect(screen.getByText("user-skill")).toBeTruthy();
+    expect(screen.getByText("user-mcp")).toBeTruthy();
+    expect(screen.getByText("legacy")).toBeTruthy();
+    expect(screen.queryByText("node_repl")).toBeNull();
+    expect(screen.queryByText("plugin:pdf")).toBeNull();
+    expect(screen.queryByText("bundled")).toBeNull();
+  });
+});
