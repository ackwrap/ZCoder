+  if (typeof text !== "string" || !taskId || truncated || text.length > 8 * 1024 * 1024)
+    return undefined;
+  const match =
+    /^<retrieval_status>(?:success|not_ready|timeout)<\/retrieval_status>\n\n<task_id>([^\n]+)<\/task_id>\n\n<task_type>([^\n]+)<\/task_type>\n\n<status>[^\n]+<\/status>(?:\n\n<exit_code>-?\d+<\/exit_code>)?\n\n<output>\n([\s\S]*)\n<\/output>(?:\n\n<error>[\s\S]*<\/error>)?$/u.exec(
+      text,
+    );
+  if (
+    !match ||
+    match[1] !== taskId ||
+    match[2] === "local_agent" ||
+    !match[3]?.trim() ||
+    match[3].includes("[Truncated.") ||
+    match[3].includes("[Tool output truncated")
+  )
+    return undefined;
+  return match[3];
+}
