@@ -0,0 +1,15 @@
+/**
+ * mode-switch 标准调用示例：运行中会话、非只读、服务端仍是 guarded 时切 yolo。
+ */
+import { resolveImmediateModeCommand } from "./contract.js";
+
+export function exampleModeSwitch(sessionId: string, hasPendingIntent: boolean): string | null {
+  return resolveImmediateModeCommand({
+    mode: "yolo",
+    sessionId,
+    liveSessionId: sessionId,
+    acknowledgedMode: "guarded",
+    hasPendingIntent,
+    readOnly: false,
+  });
+}
diff --git a/packages/ui/src/v4/composer/mode-switch/contract.test.ts b/packages/ui/src/v4/composer/mode-switch/contract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e0d6546be1e3f5bd4892ca69c14c364e1b9f660
--- /dev/null
+++ b/packages/ui/src/v4/composer/mode-switch/contract.test.ts
@@ -0,0 +1,203 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { exampleModeSwitch } from "./contract.example.js";
+import {
+  createModeSwitchSequencer,
+  MODE_SWITCH_UNCONFIRMED_MESSAGE,
+  type ModeSwitchAck,
+  type ModeSwitchSendInput,
+  type ModeSwitchSnapshot,
+} from "./contract.js";
+import { modeSwitchModule } from "./module.js";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((resolvePromise) => {
+    resolve = resolvePromise;
+  });
+  return { promise, resolve };
+}
+
+function createHarness(initial: ModeSwitchSnapshot) {
+  let snapshot: ModeSwitchSnapshot = initial;
+  let sessionId: string | null = initial.sessionId;
+  let draftMode = initial.mode;
+  const sent: ModeSwitchSendInput[] = [];
+  const responder = vi.fn<(input: ModeSwitchSendInput) => Promise<ModeSwitchAck>>();
+  const warn = vi.fn();
+  const notifyUnconfirmed = vi.fn();
+  const applyDraftMode = vi.fn((mode: string) => {
+    draftMode = mode;
+  });
+  const sequencer = createModeSwitchSequencer({
+    sendMode: (input) => {
+      sent.push(input);
+      return responder(input);
+    },
+    getSnapshot: () => snapshot,
+    getSessionId: () => sessionId,
+    getDraftMode: () => draftMode,
+    applyDraftMode,
+    notifyUnconfirmed,
+    warn,
+  });
+  return {
+    sequencer,
+    responder,
+    warn,
+    notifyUnconfirmed,
+    applyDraftMode,
+    sent,
+    setSnapshot(next: ModeSwitchSnapshot) {
+      snapshot = next;
+    },
+    setSessionId(next: string | null) {
+      sessionId = next;
+    },
+  };
+}
+
+const guardedSnapshot: ModeSwitchSnapshot = {
+  sessionId: "session-1",
+  revision: 7,
+  logEpoch: "epoch-1",
+  mode: "guarded",
+};
+
+describe("mode-switch contract", () => {
+  it("declares its module manifest", () => {
+    expect(modeSwitchModule.id).toBe("mode-switch");
+  });
+
+  it("示例：guarded 运行中切 yolo 需要立即下发", () => {
+    expect(exampleModeSwitch("session-1", false)).toBe("yolo");
+  });
+
+  it("延迟 ACK 时保留最新意图：guarded→yolo→guarded 不丢最后一次", async () => {
+    const first = deferred<ModeSwitchAck>();
+    const harness = createHarness(guardedSnapshot);
+    harness.responder
+      .mockImplementationOnce(() => first.promise)
+      .mockResolvedValue({ status: "accepted" });
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    harness.sequencer.request("guarded", { readOnly: false });
+    expect(harness.sent.map((input) => input.mode)).toEqual(["yolo"]);
+
+    first.resolve({ status: "accepted" });
+    await vi.waitFor(() =>
+      expect(harness.sent.map((input) => input.mode)).toEqual(["yolo", "guarded"]),
+    );
+  });
+
+  it("stale ACK 用 revisionAtDecision 重基准，不无限重放", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder
+      .mockResolvedValueOnce({ status: "stale", revisionAtDecision: 9 })
+      .mockResolvedValueOnce({ status: "accepted" });
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.sent).toHaveLength(2));
+    expect(harness.sent[0]).toMatchObject({ baseRevision: 7, baseLogEpoch: "epoch-1" });
+    expect(harness.sent[1]).toMatchObject({ baseRevision: 9, baseLogEpoch: "epoch-1" });
+  });
+
+  it("rejected ACK 不反向旧 mode：保留草稿意图并给出可见未确认提示", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder.mockResolvedValue({ status: "rejected", reasonCode: "mode.notAllowed" });
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.notifyUnconfirmed).toHaveBeenCalled());
+
+    // 只回显用户选择，不再猜测/写回旧 mode。
+    expect(harness.applyDraftMode.mock.calls).toEqual([["yolo"]]);
+    expect(harness.notifyUnconfirmed).toHaveBeenCalledWith(MODE_SWITCH_UNCONFIRMED_MESSAGE);
+    expect(harness.warn).toHaveBeenCalledWith(
+      expect.stringContaining("切换协作模式未确认: yolo rejected mode.notAllowed"),
+    );
+  });
+
+  it("transport 失败同样不猜测旧 mode、不自动重传", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder.mockRejectedValue(new Error("transport down"));
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.notifyUnconfirmed).toHaveBeenCalled());
+    expect(harness.applyDraftMode.mock.calls).toEqual([["yolo"]]);
+    expect(harness.sent).toHaveLength(1);
+  });
+
+  it("unknown 时同一陈旧 snapshot 不能吞掉同值再请求", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder
+      .mockResolvedValueOnce({ status: "rejected", reasonCode: "mode.notAllowed" })
+      .mockResolvedValueOnce({ status: "accepted" });
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.notifyUnconfirmed).toHaveBeenCalled());
+
+    // snapshot 未推进：不能据此解除 unknown，同值请求必须再发。
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.sent).toHaveLength(2));
+    expect(harness.sent.map((input) => input.mode)).toEqual(["yolo", "yolo"]);
+  });
+
+  it("事件失败后普通 revision 前进不解除 unknown；用户降权请求实际下发并由 accepted 确认", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder
+      .mockResolvedValueOnce({ status: "rejected", reasonCode: "event.write_failed" })
+      .mockResolvedValueOnce({ status: "accepted" });
+
+    // 服务端实际已提交 yolo，但权限事件失败；UI 进入 unknown。
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.notifyUnconfirmed).toHaveBeenCalled());
+    expect(harness.sent).toHaveLength(1);
+
+    // 普通消息把 revision 推到 8，但快照仍是 guarded；不能据此认为权限已恢复。
+    harness.setSnapshot({ ...guardedSnapshot, revision: 8, mode: "guarded" });
+    harness.sequencer.request("guarded", { readOnly: false });
+    await vi.waitFor(() => expect(harness.sent).toHaveLength(2));
+    expect(harness.sent[1]).toMatchObject({ mode: "guarded", baseRevision: 8 });
+
+    // accepted 明确成功后才重新确认；再次同值请求恢复去重。
+    harness.sequencer.request("guarded", { readOnly: false });
+    await Promise.resolve();
+    expect(harness.sent).toHaveLength(2);
+  });
+
+  it("跨会话迟到 ACK 不写回新会话草稿", async () => {
+    const first = deferred<ModeSwitchAck>();
+    const harness = createHarness(guardedSnapshot);
+    harness.responder.mockImplementation(() => first.promise);
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    harness.setSessionId("session-2");
+    harness.setSnapshot({ ...guardedSnapshot, sessionId: "session-2" });
+    harness.sequencer.reset("session-2");
+    harness.applyDraftMode.mockClear();
+    harness.notifyUnconfirmed.mockClear();
+
+    first.resolve({ status: "rejected", reasonCode: "late" });
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(harness.applyDraftMode).not.toHaveBeenCalled();
+    expect(harness.notifyUnconfirmed).not.toHaveBeenCalled();
+  });
+
+  it("accepted 后同值请求不再重复发送；只读/plan 只改草稿", async () => {
+    const harness = createHarness(guardedSnapshot);
+    harness.responder.mockResolvedValue({ status: "accepted" });
+
+    harness.sequencer.request("yolo", { readOnly: false });
+    await vi.waitFor(() => expect(harness.sent).toHaveLength(1));
+    harness.sequencer.request("yolo", { readOnly: false });
+    await Promise.resolve();
+    expect(harness.sent).toHaveLength(1);
+
+    harness.applyDraftMode.mockClear();
+    harness.sequencer.request("guarded", { readOnly: true });
+    harness.sequencer.request("plan", { readOnly: false });
+    expect(harness.sent).toHaveLength(1);
+    expect(harness.applyDraftMode).toHaveBeenCalledTimes(2);
+  });
+});
