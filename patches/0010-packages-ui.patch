+  openSelectionSideChatPane,
+  closeSidePaneTab,
+  settleSelectionSideChatCreation,
+  type WorkspaceSidePaneState,
+} from "@/lib/workspaceSidePane.js";
+
+function Fixture() {
+  const [state, setState] = useState<WorkspaceSidePaneState | null>(null);
+  const paneRef = useRef<HTMLDivElement>(null);
+  const [model, setModel] = useState("one");
+  const [effort, setEffort] = useState("low");
+  const commands = createModelEffortCommands(
+    "en-US",
+    () => openComposerModelMenu(paneRef.current),
+    () => {},
+  );
+  const request = {
+    workspaceKey: "workspace",
+    workspacePath: "/workspace",
+    parentSessionId: "parent",
+    childSessionId: "pending:test",
+  };
+  const tab = state?.tabs.find((item) => item.type === "selection-side-chat");
+  return (
+    <main>
+      <div ref={paneRef}>
+        {commands.map((command) => (
+          <button key={command.value} onClick={command.run}>{`/${command.value}`}</button>
+        ))}
+        <TooltipProvider>
+          <ModelConfigSelect
+            modelGroups={[
+              {
+                key: "provider",
+                label: "Provider",
+                items: [
+                  { key: "one", value: "one", name: "Model One" },
+                  { key: "two", value: "two", name: "Model Two" },
+                ],
+              },
+            ]}
+            normalizedValue={model}
+            triggerLabel={model}
+            showManageModelsAction={false}
+            lockReasonMessage="Locked"
+            isItemLocked={() => false}
+            onValueChange={setModel}
+            showProviderLevel={false}
+            composerOptions={{
+              providerLabel: "Provider",
+              modelsLabel: "Models",
+              effortLabel: "Effort",
+              selectModelLabel: "Select model",
+              levels: [
+                { value: "low", label: "Low" },
+                { value: "high", label: "High" },
+              ],
+              value: effort,
+              onValueChange: setEffort,
+            }}
+          />
+        </TooltipProvider>
+        <output>{`Selected: ${model}; effort: ${effort}`}</output>
+      </div>
+      <button
+        onClick={() =>
+          setState((current) =>
+            openSelectionSideChatPane(current, {
+              ...request,
+              pendingCreation: new Promise(() => {}),
+            }),
+          )
+        }
+      >
+        Open side
+      </button>
+      <button
+        onClick={() =>
+          setState((current) =>
+            settleSelectionSideChatCreation(
+              current,
+              request.childSessionId,
+              request.workspaceKey,
+              request.parentSessionId,
+              { sessionId: "real-child" },
+            ),
+          )
+        }
+      >
+        Resolve creation
+      </button>
+      <button
+        onClick={() =>
+          setState((current) =>
+            settleSelectionSideChatCreation(
+              current,
+              request.childSessionId,
+              request.workspaceKey,
+              request.parentSessionId,
+              { error: "Creation failed" },
+            ),
+          )
+        }
+      >
+        Fail creation
+      </button>
+      <button
+        onClick={() =>
+          setState((current) =>
+            current ? closeSidePaneTab(current, current.activeTabId) : current,
+          )
+        }
+      >
+        Close side
+      </button>
+      {tab?.type === "selection-side-chat" ? (
+        <section aria-label="Side conversation">
+          <SelectionSideChatPane tab={tab} focused onUnavailable={() => {}} />
+        </section>
+      ) : (
+        <p>Side closed</p>
+      )}
+    </main>
+  );
+}
+createRoot(document.getElementById("root")!).render(
+  <ZCodeIntlProvider initialLocale="en-US">
+    <Fixture />
+  </ZCodeIntlProvider>,
+);
