+  gitSummary,
+  dirtyFileCount = 0,
+  changeSummary,
+  activeTaskChangeSummary,
+  reviewSourceId,
+  onRefreshGit,
+  onOpenGitReview,
+  readOnly = false,
+}: SessionInspectorProps) {
+  const { intl, locale } = useZCodeIntl();
+  const label = (id: string) => intl.formatMessage({ id });
+  const tokens = (value: number) => formatCompactTokenNumber(locale, value);
+  const percent = (value: number) =>
+    new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 1 }).format(value);
+  const providerRead = useProviderSettingsView();
+  const configured = selectConfiguredContext(
+    !remote && providerRead.state.status === "ready" ? providerRead.state.view : null,
+    selection,
+  );
+  const validUsage =
+    usage &&
+    Number.isFinite(usage.usedTokens) &&
+    usage.usedTokens > 0 &&
+    Number.isFinite(usage.maxTokens) &&
+    usage.maxTokens > 0
+      ? usage
+      : null;
+  const ratio = validUsage ? Math.min(validUsage.usedTokens / validUsage.maxTokens, 1) : 0;
+  const breakdown = buildContextUsageBreakdownSegments(validUsage?.breakdown);
+  // 信息栏是诊断视图：命中率只要 provider 上报就如实显示，套用工具栏 78% 阈值会掩盖低命中。
+  const cacheHitRate = formatContextCacheHitRateLabel(validUsage?.cache?.hitRate, locale, {
+    showBelowThreshold: true,
+  });
+  const isRepository = Boolean(gitSummary?.isGitAvailable && gitSummary.isRepository);
+  return (
+    <div className="space-y-2" data-testid="session-inspector">
+      <InspectorCard id="context" title={label("chat.contextUsage.title")} defaultOpen={false}>
+        {validUsage ? (
+          <>
+            <div
+              data-testid="inspector-context-usage"
+              className="flex flex-wrap items-center justify-between gap-1 text-ui-sm tabular-nums"
+            >
+              <span className="text-foreground">{percent(ratio)}</span>
+              <span className="text-foreground-subtle">
+                {tokens(validUsage.usedTokens)} / {tokens(validUsage.maxTokens)}
+              </span>
+            </div>
+            <Progress
+              value={ratio * 100}
+              aria-label={label("chat.contextUsage.title")}
+              aria-valuenow={Math.round(ratio * 100)}
+              aria-valuemin={0}
+              aria-valuemax={100}
+              aria-valuetext={`${tokens(validUsage.usedTokens)} / ${tokens(validUsage.maxTokens)}`}
+              className="h-1 bg-surface"
+            />
+            <div className="flex justify-between gap-2 text-ui-sm text-foreground-subtle">
+              <span>{label("chat.inspector.freeSpace")}</span>
+              <span className="tabular-nums">
+                {tokens(Math.max(0, validUsage.maxTokens - validUsage.usedTokens))}
+              </span>
+            </div>
+            {cacheHitRate ? (
+              <div
+                data-testid="inspector-cache-hit-rate"
+                className="flex justify-between gap-2 text-ui-sm text-foreground-subtle"
+              >
+                <span>{label("chat.contextUsage.cacheHitRate")}</span>
+                <span className="tabular-nums text-foreground">{cacheHitRate}</span>
+              </div>
+            ) : null}
+          </>
+        ) : (
+          <p className="text-ui-sm text-foreground-subtlest">{label("chat.inspector.noUsage")}</p>
+        )}
+        <ContextDiagnostics
+          configured={configured}
+          usage={
+            validUsage
+              ? {
+                  used: validUsage.usedTokens,
+                  size: validUsage.maxTokens,
+                  autoCompactThresholdTokens: validUsage.autoCompactThresholdTokens,
+                }
+              : null
+          }
+        />
+        {!configured && selection?.model ? (
+          <p className="break-all text-ui-sm text-foreground-subtle">{selection.model}</p>
+        ) : null}
+        {breakdown.length > 0 ? (
+          <div
+            data-testid="inspector-context-breakdown"
+            className="space-y-1 border-t border-border pt-2"
+          >
+            <p className="text-ui-xs text-foreground-subtlest">
+              {label("chat.inspector.characterShare")}
+            </p>
+            <dl className="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1 text-ui-sm">
+              {breakdown.map((item) => (
+                <div key={item.source} className="contents">
+                  <dt className="text-foreground-subtle">{label(SOURCE_LABELS[item.source])}</dt>
+                  <dd className="text-right tabular-nums text-foreground">
+                    {percent(item.percent)}
+                  </dd>
+                </div>
+              ))}
+            </dl>
+          </div>
+        ) : null}
+      </InspectorCard>
+      <InspectorCard id="connectors" title={label("chat.inspector.connectors")} defaultOpen={false}>
+        {resources ?? (
+          <p className="text-ui-sm text-foreground-subtlest">
+            {label("chat.inspector.noResources")}
+          </p>
+        )}
+      </InspectorCard>
+      <InspectorCard id="changes" title={label("chat.statusPanel.changes")}>
+        {isRepository && gitSummary ? (
+          onRefreshGit && !readOnly ? (
+            <GitBranchSwitcher
+              workspacePath={workspacePath}
+              gitSummary={gitSummary}
+              dirtyFileCount={dirtyFileCount}
+              onRefreshGit={onRefreshGit}
+              className="w-full px-0 pt-0"
+              triggerClassName="w-full justify-start text-ui-sm"
+              popoverSide="bottom"
+            />
+          ) : (
+            <div className="flex items-center gap-2 text-ui-sm text-foreground-subtle">
+              <GitBranchIcon className="size-4 shrink-0" />
+              <span className="min-w-0 truncate">
+                {gitSummary.branchName ?? label("chat.inspector.detached")}
+              </span>
+            </div>
+          )
+        ) : null}
+        {isRepository ? (
+          <>
+            <button
+              type="button"
+              data-testid="inspector-open-changes"
+              disabled={!onOpenGitReview}
+              onClick={() => onOpenGitReview?.(reviewSourceId ?? undefined)}
+              className="flex w-full items-center gap-2 rounded-lg py-1 text-left text-ui-sm hover:bg-hover disabled:cursor-default disabled:opacity-50"
+            >
+              <FileDiffIcon className="size-4 shrink-0 text-foreground-subtle" />
+              <span className="min-w-0 flex-1 text-foreground-subtle">
+                {label("chat.inspector.reviewChanges")}
+              </span>
+              {changeSummary ? (
+                <span className="shrink-0 tabular-nums">
+                  <span className="text-diff-added">+{changeSummary.added}</span>{" "}
+                  <span className="text-diff-removed">-{changeSummary.removed}</span>
+                </span>
+              ) : null}
+            </button>
+            {!readOnly && onRefreshGit && gitSummary ? (
+              <GitActionMenu
+                workspacePath={workspacePath}
+                workspaceIdentity={workspaceIdentity}
+                gitSummary={gitSummary}
+                activeTaskChangeSummary={activeTaskChangeSummary}
+                onRefreshGit={onRefreshGit}
+                triggerLayout="status-row"
+                className="w-full"
+              />
+            ) : null}
+          </>
+        ) : (
+          <p className="text-ui-sm text-foreground-subtlest">
+            {label(
+              !gitSummary
+                ? "chat.inspector.gitPending"
+                : !gitSummary.isGitAvailable
+                  ? "git.empty.gitUnavailableTitle"
+                  : "chat.inspector.notRepository",
+            )}
+          </p>
+        )}
+      </InspectorCard>
+    </div>
+  );
+}
