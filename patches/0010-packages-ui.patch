+import { describe, expect, it } from "vitest";
+import type { ZCodeMcpServer } from "@zcode/shared";
+import {
+  buildMcpDiagnosticReport,
+  resolveContextBudget,
+  selectConfiguredContext,
+  type ContextSelectionView,
+} from "./contract.js";
+
+describe("session diagnostics contract", () => {
+  it("selects the exact provider/model and never guesses missing provenance", () => {
+    const view = {
+      providers: [
+        {
+          providerId: "p",
+          models: [
+            {
+              modelId: "m",
+              effectiveConfig: { properties: { contextWindow: 272000 } },
+              contextWindowSource: "discovered",
+            },
+          ],
+        },
+      ],
+    } as unknown as ContextSelectionView;
+    expect(selectConfiguredContext(view, { provider: "p", model: "m" })).toEqual({
+      model: "m",
+      size: 272000,
+      source: "discovered",
+    });
+    expect(selectConfiguredContext(view, { provider: "other", model: "m" })).toBeNull();
+    expect(selectConfiguredContext(null, { provider: "p", model: "m" })).toBeNull();
+    const legacy = structuredClone(view);
+    delete (legacy.providers[0]!.models[0]! as { contextWindowSource?: string })
+      .contextWindowSource;
+    expect(selectConfiguredContext(legacy, { provider: "p", model: "m" })?.source).toBe("unknown");
+  });
+
+  it.each([null, undefined, 0, -1, NaN, Infinity, 300000])(
+    "does not invent a budget for threshold %s",
+    (threshold) => {
+      expect(
+        resolveContextBudget({ used: 1000, size: 272000, autoCompactThresholdTokens: threshold }),
+      ).toBeNull();
+    },
+  );
+
+  it("uses runtime threshold, not the current configured window, and clamps remaining", () => {
+    expect(
+      resolveContextBudget({ used: 1000, size: 64000, autoCompactThresholdTokens: 50000 }),
+    ).toEqual({ threshold: 50000, remaining: 49000 });
+    expect(
+      resolveContextBudget({ used: 55000, size: 64000, autoCompactThresholdTokens: 50000 }),
+    ).toEqual({ threshold: 50000, remaining: 0 });
+  });
+
+  it("builds an allowlisted report and scrubs known configuration secrets and URLs", () => {
+    const server: ZCodeMcpServer = {
+      id: "fixture",
+      name: "fixture",
+      enabled: true,
+      status: "error",
+      source: "zcodeagentmcp",
+      scope: "workspace",
+      toolCount: 0,
+      config: {
+        command: "node",
+        args: ["--key=argument-secret"],
+        env: { PRIVATE: "environment-secret" },
+        headers: { "X-Key": "header-secret" },
+        url: "https://user:pass@example.invalid/private?token=query-secret",
+      },
+      authorization: {
+        type: "oauth_authorization_code",
+        authorizationUrl: "https://auth.invalid/?code=authorization-secret",
+        startedAt: "today",
+      },
+      error:
+        "failed environment-secret header-secret argument-secret https://user:pass@example.invalid/private?token=query-secret\nAuthorization: Bearer unknown-secret",
+    };
+    const report = buildMcpDiagnosticReport(server);
+    expect(report).toContain("toolCount: 0");
+    for (const secret of [
+      "environment-secret",
+      "header-secret",
+      "argument-secret",
+      "query-secret",
+      "authorization-secret",
+      "unknown-secret",
+      "--key",
+      "PRIVATE",
+    ])
+      expect(report).not.toContain(secret);
+    expect(report).toContain("[REDACTED]");
+    expect(server.error).toContain("environment-secret");
+  });
+});
