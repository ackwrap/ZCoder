@@ -0,0 +1,77 @@
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import { describe, expect, it } from "vitest";
+import { conversationFocusModeModule } from "./module.js";
+import {
+  buildFocusLogicalGroupsFromRows,
+  resolveFocusDataRequirement,
+  selectFocusTimelineWindow,
+} from "./focusGroups.js";
+
+function header(turnId: string, rowId: number, state: string): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "turnHeader",
+    origin: "userInput",
+    executionKind: "agent",
+    state: state as "running",
+    startedAt: rowId,
+    createdAt: rowId,
+    createdAtSeq: rowId,
+  };
+}
+
+function userInput(turnId: string, rowId: number, guided = false): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "userInput",
+    origin: "realUser",
+    text: `q-${rowId}`,
+    createdAt: rowId,
+    createdAtSeq: rowId,
+    ...(guided ? { guided: true as const } : {}),
+  };
+}
+
+function assistant(turnId: string, rowId: number): ConversationRow {
+  return {
+    rowId,
+    turnId,
+    kind: "assistantText",
+    text: `a-${rowId}`,
+    state: "complete",
+    createdAt: rowId,
+    createdAtSeq: rowId,
+  };
+}
+
+describe("conversation-focus-mode contract", () => {
+  it("declares its module manifest", () => {
+    expect(conversationFocusModeModule.id).toBe("conversation-focus-mode");
+    expect(conversationFocusModeModule.requires).toEqual(["shared", "ui"]);
+  });
+
+  it("uses completedSuccess as the only complete boundary", () => {
+    const rows = [
+      header("a", 1, "completedSuccess"),
+      userInput("a", 2),
+      assistant("a", 3),
+      header("b", 4, "completedInterrupted"),
+      userInput("b", 5),
+      assistant("b", 6),
+      header("c", 7, "running"),
+      userInput("c", 8, true),
+      userInput("c", 9, true),
+    ];
+    const groups = buildFocusLogicalGroupsFromRows(rows);
+    expect(groups.map((group) => group.turnIds)).toEqual([["a"], ["b", "c"]]);
+    expect(groups.map((group) => group.complete)).toEqual([true, false]);
+
+    const window = selectFocusTimelineWindow(groups, false);
+    expect(window.turnIds).toEqual(["a", "b", "c"]);
+    expect(
+      resolveFocusDataRequirement({ groups, window, canLoadOlder: false }).needsOlderData,
+    ).toBe(false);
+  });
+});
