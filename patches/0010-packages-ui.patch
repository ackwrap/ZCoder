+import type { CompactionSettingsSectionProps, TitleGenerationModelRef } from "./types.js";
+
+const TITLE_MODEL_VALUE_SEPARATOR = "|";
+
+const COMPACTION_PROFILE_OPTIONS: readonly CompactionProfile[] = ["detailed", "compact"];
+const COMPACTION_TAIL_BUDGET_RANGE = { min: 1_000, max: 100_000 } as const;
+const COMPACTION_SUMMARY_MAX_OUTPUT_RANGE = { min: 1_000, max: 20_000 } as const;
+
+function parseCompactionTokenValue(
+  raw: string,
+  range: { min: number; max: number },
+): number | undefined {
+  const trimmed = raw.trim();
+  if (!/^\d+$/.test(trimmed)) {
+    return undefined;
+  }
+  const value = Number(trimmed);
+  return Number.isSafeInteger(value) && value >= range.min && value <= range.max
+    ? value
+    : undefined;
+}
+
+function CompactionTokenBudgetRow({
+  label,
+  description,
+  value,
+  range,
+  disabled,
+  testId,
+  onSave,
+}: {
+  label: string;
+  description: string;
+  value: number;
+  range: { min: number; max: number };
+  disabled?: boolean;
+  testId: string;
+  onSave: (value: number) => Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const [draft, setDraft] = useState(String(value));
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  // ref 在事件处理间同步生效，防止 blur/Enter 在同一帧内重复提交。
+  const pendingRef = useRef(false);
+
+  useEffect(() => {
+    setDraft(String(value));
+  }, [value]);
+
+  const commit = useCallback(async () => {
+    if (pendingRef.current || disabled) {
+      return;
+    }
+    const parsed = parseCompactionTokenValue(draft, range);
+    if (parsed === undefined) {
+      // 越界或非整数只停留在本地校验；不能把非法值提交给 Host。
+      setError(
+        intl.formatMessage(
+          { id: "settings.advanced.tokenRangeError" },
+          { min: String(range.min), max: String(range.max) },
+        ),
+      );
+      return;
+    }
+    if (parsed === value) {
+      setDraft(String(parsed));
+      setError(null);
+      return;
+    }
+
+    setPending(true);
+    pendingRef.current = true;
+    setError(null);
+    try {
+      await onSave(parsed);
+      setDraft(String(parsed));
+    } catch {
+      // 保存失败保留本地输入，用户修正后可直接重试。
+      setError(intl.formatMessage({ id: "settings.advanced.saveFailed" }));
+    } finally {
+      pendingRef.current = false;
+      setPending(false);
+    }
+  }, [disabled, draft, intl, onSave, range, value]);
+
+  return (
+    <SettingsRow
+      label={label}
+      description={description}
+      detail={
+        error ? (
+          <p role="alert" data-testid={`${testId}-error`} className="text-ui-sm text-destructive">
+            {error}
+          </p>
+        ) : null
+      }
+      control={
+        <Input
+          size="lg"
+          type="number"
+          inputMode="numeric"
+          min={range.min}
+          max={range.max}
+          step={1}
+          value={draft}
+          disabled={disabled || pending}
+          aria-label={label}
+          aria-invalid={Boolean(error)}
+          data-testid={testId}
+          className="w-full tabular-nums"
+          onChange={(event) => {
+            setDraft(event.currentTarget.value);
+          }}
+          onBlur={() => {
+            void commit();
+          }}
+          onKeyDown={(event) => {
+            if (event.key === "Enter") {
+              event.preventDefault();
+              void commit();
+            }
+          }}
+        />
+      }
+    />
+  );
+}
+
+function TitleGenerationModelRow({
+  value,
+  onChange,
+}: {
+  value?: TitleGenerationModelRef;
+  onChange: (next: TitleGenerationModelRef) => Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const services = useServices();
+  const [providers, setProviders] = useState<
+    ReadonlyArray<{
+      providerId: string;
+      providerName?: string | null;
+      models: ReadonlyArray<{ modelId: string }>;
+    }>
+  >([]);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const pendingRef = useRef(false);
+  useEffect(() => {
+    let cancelled = false;
+    void services.modelSelectionService
+      .getView()
+      .then((view) => {
+        if (!cancelled) setProviders(view.providers);
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+  }, [services.modelSelectionService]);
+  const modelValue = (providerId: string, modelId: string) =>
+    `${encodeURIComponent(providerId)}${TITLE_MODEL_VALUE_SEPARATOR}${encodeURIComponent(modelId)}`;
+  const current = value ? modelValue(value.providerId, value.modelId) : "";
+
+  const handleChange = useCallback(
+    async (raw: string) => {
+      if (pendingRef.current) return;
+      const separatorIndex = raw.indexOf(TITLE_MODEL_VALUE_SEPARATOR);
+      let next: TitleGenerationModelRef = { providerId: "", modelId: "" };
+      if (separatorIndex > 0) {
+        try {
+          next = {
+            providerId: decodeURIComponent(raw.slice(0, separatorIndex)),
+            modelId: decodeURIComponent(raw.slice(separatorIndex + 1)),
+          };
+        } catch {
+          next = { providerId: "", modelId: "" };
+        }
+      }
+      pendingRef.current = true;
+      setPending(true);
+      setError(null);
+      try {
+        await onChange(next);
+      } catch {
+        setError(intl.formatMessage({ id: "settings.advanced.saveFailed" }));
+      } finally {
+        pendingRef.current = false;
+        setPending(false);
+      }
+    },
+    [intl, onChange],
+  );
+
+  return (
+    <div className="px-4 py-3">
+      <div className="text-ui-base font-medium text-foreground">
+        {intl.formatMessage({ id: "settings.advanced.titleGenerationModel" })}
+      </div>
+      <div className="mt-1 text-ui-sm leading-5 text-foreground-subtle">
+        {intl.formatMessage({ id: "settings.advanced.titleGenerationModelDescription" })}
+      </div>
+      <select
+        data-testid="title-generation-model-select"
+        aria-label={intl.formatMessage({ id: "settings.advanced.titleGenerationModel" })}
+        className="mt-3 h-9 w-full rounded-md border border-input-border bg-input px-2 text-ui-base text-foreground"
+        value={current}
+        disabled={pending}
+        onChange={(event) => {
+          void handleChange(event.currentTarget.value);
+        }}
+      >
+        <option value="">
+          {intl.formatMessage({ id: "settings.advanced.titleGenerationModelInherit" })}
+        </option>
+        {providers.map((provider) => (
+          <optgroup key={provider.providerId} label={provider.providerName ?? provider.providerId}>
+            {provider.models.map((model) => (
+              <option key={model.modelId} value={modelValue(provider.providerId, model.modelId)}>
+                {`${provider.providerName ?? provider.providerId} · ${model.modelId}`}
+              </option>
+            ))}
+          </optgroup>
+        ))}
+      </select>
+      {error ? (
+        <p role="alert" className="mt-2 text-ui-sm text-destructive">
+          {error}
+        </p>
+      ) : null}
+    </div>
+  );
+}
+
+export function AdvancedSection({
+  compactionProfile,
+  compactionTailBudgetTokens,
+  compactionSummaryMaxOutputTokens,
+  onCompactionProfileChange,
+  onCompactionTailBudgetTokensChange,
+  onCompactionSummaryMaxOutputTokensChange,
+  titleGenerationModel,
+  onTitleGenerationModelChange,
+}: {
+  compactionProfile: CompactionProfile;
+  compactionTailBudgetTokens: number;
+  compactionSummaryMaxOutputTokens: number;
+  onCompactionProfileChange: (profile: CompactionProfile) => Promise<void>;
+  onCompactionTailBudgetTokensChange: (tokens: number) => Promise<void>;
+  onCompactionSummaryMaxOutputTokensChange: (tokens: number) => Promise<void>;
+  titleGenerationModel?: TitleGenerationModelRef;
+  onTitleGenerationModelChange?: (next: TitleGenerationModelRef) => Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const [profilePending, setProfilePending] = useState(false);
+  const [profileError, setProfileError] = useState<string | null>(null);
+  const profilePendingRef = useRef(false);
+
+  const handleProfileChange = useCallback(
+    async (nextProfile: string) => {
+      if (nextProfile !== "detailed" && nextProfile !== "compact") {
+        return;
+      }
+      if (profilePendingRef.current || nextProfile === compactionProfile) {
+        return;
+      }
+      profilePendingRef.current = true;
+      setProfilePending(true);
+      setProfileError(null);
+      try {
+        await onCompactionProfileChange(nextProfile);
+      } catch {
+        setProfileError(intl.formatMessage({ id: "settings.advanced.saveFailed" }));
+      } finally {
+        profilePendingRef.current = false;
+        setProfilePending(false);
+      }
+    },
+    [compactionProfile, intl, onCompactionProfileChange],
+  );
+
+  return (
+    <div className="space-y-4">
+      <SettingsGroupCard>
+        <div className="px-4 py-3">
+          <div className="text-ui-base font-medium text-foreground">
+            {intl.formatMessage({ id: "settings.advanced.compactionProfile" })}
+          </div>
+          <div className="mt-1 text-ui-sm leading-5 text-foreground-subtle">
+            {intl.formatMessage({ id: "settings.advanced.compactionProfileDescription" })}
+          </div>
+          <RadioGroup
+            aria-label={intl.formatMessage({ id: "settings.advanced.compactionProfile" })}
+            data-testid="compaction-profile-group"
+            value={compactionProfile}
+            disabled={profilePending}
+            className="mt-3 grid gap-2 sm:grid-cols-2"
+            onValueChange={(value) => {
+              void handleProfileChange(value);
+            }}
+          >
+            {COMPACTION_PROFILE_OPTIONS.map((profile) => {
+              const checked = compactionProfile === profile;
+              return (
+                <label
+                  key={profile}
+                  htmlFor={`compaction-profile-${profile}`}
+                  className={cn(
+                    "flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors",
+                    checked
+                      ? "border-input-border-focused bg-card-selected"
+                      : "border-border bg-surface hover:bg-surface-hover",
+                    profilePending && "cursor-not-allowed opacity-60",
+                  )}
+                >
+                  <RadioGroupItem
+                    id={`compaction-profile-${profile}`}
+                    value={profile}
+                    data-testid={`compaction-profile-${profile}`}
+                    aria-label={intl.formatMessage({
+                      id: `settings.advanced.compactionProfile.${profile}`,
+                    })}
+                    className="mt-0.5"
+                  />
+                  <span className="min-w-0">
+                    <span className="block text-ui-base font-medium text-foreground">
+                      {intl.formatMessage({
+                        id: `settings.advanced.compactionProfile.${profile}`,
+                      })}
+                    </span>
+                    <span className="mt-1 block text-ui-sm leading-5 text-foreground-subtle">
+                      {intl.formatMessage({
+                        id: `settings.advanced.compactionProfile.${profile}Description`,
+                      })}
+                    </span>
+                  </span>
+                </label>
+              );
+            })}
+          </RadioGroup>
+          {profileError ? (
+            <p
+              role="alert"
+              data-testid="compaction-profile-error"
+              className="mt-2 text-ui-sm text-destructive"
+            >
+              {profileError}
+            </p>
+          ) : null}
+        </div>
+        <CompactionTokenBudgetRow
+          label={intl.formatMessage({
+            id: "settings.advanced.compactionTailBudgetTokens",
+          })}
+          description={intl.formatMessage({
+            id: "settings.advanced.compactionTailBudgetTokensDescription",
+          })}
+          value={compactionTailBudgetTokens}
+          range={COMPACTION_TAIL_BUDGET_RANGE}
+          // 两个预算只在精简模式生效；详细模式保留固定 20K 上限，输入保持可见但禁用。
+          disabled={compactionProfile !== "compact" || profilePending}
+          testId="compaction-tail-budget-input"
+          onSave={onCompactionTailBudgetTokensChange}
+        />
+        <CompactionTokenBudgetRow
+          label={intl.formatMessage({
+            id: "settings.advanced.compactionSummaryMaxOutputTokens",
+          })}
+          description={intl.formatMessage({
+            id: "settings.advanced.compactionSummaryMaxOutputTokensDescription",
+          })}
+          value={compactionSummaryMaxOutputTokens}
+          range={COMPACTION_SUMMARY_MAX_OUTPUT_RANGE}
+          disabled={compactionProfile !== "compact" || profilePending}
+          testId="compaction-summary-max-output-input"
+          onSave={onCompactionSummaryMaxOutputTokensChange}
+        />
+      </SettingsGroupCard>
+      {onTitleGenerationModelChange ? (
+        <SettingsGroupCard>
+          <TitleGenerationModelRow
+            value={titleGenerationModel}
+            onChange={onTitleGenerationModelChange}
+          />
+        </SettingsGroupCard>
+      ) : null}
+    </div>
+  );
+}
+
+export function CompactionSettingsSection({
+  settings,
+  onUpdateSettings,
+}: CompactionSettingsSectionProps) {
+  return (
+    <AdvancedSection
+      compactionProfile={settings?.compactionProfile ?? "detailed"}
+      compactionTailBudgetTokens={settings?.compactionTailBudgetTokens ?? 15_000}
+      compactionSummaryMaxOutputTokens={settings?.compactionSummaryMaxOutputTokens ?? 8_000}
+      titleGenerationModel={settings?.titleGenerationModel}
+      onCompactionProfileChange={(compactionProfile) => onUpdateSettings({ compactionProfile })}
+      onCompactionTailBudgetTokensChange={(compactionTailBudgetTokens) =>
+        onUpdateSettings({ compactionTailBudgetTokens })
+      }
+      onCompactionSummaryMaxOutputTokensChange={(compactionSummaryMaxOutputTokens) =>
+        onUpdateSettings({ compactionSummaryMaxOutputTokens })
+      }
+      onTitleGenerationModelChange={(titleGenerationModel) =>
+        onUpdateSettings({ titleGenerationModel })
+      }
+    />
+  );
+}
