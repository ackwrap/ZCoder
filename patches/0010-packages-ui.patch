+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+  acceptModelSystemPromptPromotion,
+  isModelSystemPromptPromotionReceipt,
+  promoteModelSystemPromptDraftFlag,
+  readModelSystemPromptDraftState,
+  readModelSystemPromptSessionState,
+  resolveModelSystemPromptScope,
+  setModelSystemPromptEnabled,
+} from "@/v4/composer/model-system-prompt/index.js";
+
+function installStorage(options: { throwOnSet?: boolean } = {}): void {
+  const values = new Map<string, string>();
+  Object.defineProperty(window, "localStorage", {
+    configurable: true,
+    value: {
+      clear: () => values.clear(),
+      getItem: (key: string) => values.get(key) ?? null,
+      key: (index: number) => [...values.keys()][index] ?? null,
+      get length() {
+        return values.size;
+      },
+      removeItem: (key: string) => {
+        values.delete(key);
+      },
+      setItem: (key: string, value: string) => {
+        if (options.throwOnSet) throw new Error("quota");
+        values.set(key, value);
+      },
+    } satisfies Storage,
+  });
+}
+
+function receiptEntry(params: {
+  workspacePath: string;
+  draftOwnerKey: string;
+  enabled: boolean;
+  revision: number;
+  targetSessionId: string | null;
+  applied?: boolean;
+}) {
+  return {
+    sessionId: params.targetSessionId,
+    clientContext: {
+      modelSystemPromptPromotion: {
+        version: 1 as const,
+        workspacePath: params.workspacePath,
+        draftOwnerKey: params.draftOwnerKey,
+        enabled: params.enabled,
+        revision: params.revision,
+        ...(params.applied === undefined ? {} : { applied: params.applied }),
+      },
+    },
+  };
+}
+
+afterEach(() => {
+  Object.defineProperty(window, "localStorage", {
+    configurable: true,
+    value: undefined,
+  });
+});
+
+describe("model system prompt promotion receipt", () => {
+  beforeEach(() => installStorage());
+
+  it("applies once and never overwrites a later manual target toggle", () => {
+    const workspace = "/workspace/receipt-once";
+    const draft = resolveModelSystemPromptScope(workspace, undefined, null, "gen-1")!;
+    setModelSystemPromptEnabled(draft, true);
+    const state = readModelSystemPromptDraftState(draft)!;
+    const entry = receiptEntry({
+      workspacePath: workspace,
+      draftOwnerKey: "gen-1",
+      enabled: true,
+      revision: state.revision,
+      targetSessionId: "accepted-session",
+    });
+
+    expect(acceptModelSystemPromptPromotion(entry)).toBe(true);
+    const real = resolveModelSystemPromptScope(workspace, undefined, "accepted-session")!;
+    expect(entry.clientContext.modelSystemPromptPromotion?.applied).toBe(true);
+    expect(readModelSystemPromptDraftState(draft)).toBeNull();
+
+    // 目标随后手动关闭；重复 ACK/query/snapshot 不得再写 true。
+    setModelSystemPromptEnabled(real, false);
+    expect(acceptModelSystemPromptPromotion(entry)).toBe(false);
+    setModelSystemPromptEnabled(real, false);
+    expect(acceptModelSystemPromptPromotion({ ...entry, sessionId: "accepted-session" })).toBe(
+      false,
+    );
+  });
+
+  it("does not clear a source draft that has a newer edit", () => {
+    const workspace = "/workspace/receipt-cas";
+    const draft = resolveModelSystemPromptScope(workspace, undefined, null, "gen-1")!;
+    setModelSystemPromptEnabled(draft, true);
+    const captured = readModelSystemPromptDraftState(draft)!;
+    // 提交后用户又关掉同一草稿：revision 增加，promotion 不能清掉这次新编辑。
+    setModelSystemPromptEnabled(draft, false);
+
+    expect(
+      promoteModelSystemPromptDraftFlag({
+        binding: {
+          workspacePath: workspace,
+          draftOwnerKey: "gen-1",
+          enabled: true,
+          revision: captured.revision,
+        },
+        targetSessionId: "accepted-session",
+      }),
+    ).toBe(true);
+    const real = resolveModelSystemPromptScope(workspace, undefined, "accepted-session")!;
+    expect(resolveModelSystemPromptScope(workspace, undefined, "accepted-session")).not.toBeNull();
+    expect(
+      acceptModelSystemPromptPromotion(
+        receiptEntry({
+          workspacePath: workspace,
+          draftOwnerKey: "gen-1",
+          enabled: true,
+          revision: captured.revision,
+          targetSessionId: "another-accepted-session",
+        }),
+      ),
+    ).toBe(true);
+    expect(readModelSystemPromptDraftState(draft)?.enabled).toBe(false);
+    expect(real).not.toBeNull();
+  });
+
+  it("initializes only an unset target and preserves explicit on/off values", () => {
+    const workspace = "/workspace/target-cas";
+    const draft = resolveModelSystemPromptScope(workspace, undefined, null, "gen-1")!;
+    setModelSystemPromptEnabled(draft, true);
+    const revision = readModelSystemPromptDraftState(draft)!.revision;
+    const binding = {
+      workspacePath: workspace,
+      draftOwnerKey: "gen-1",
+      enabled: true,
+      revision,
+    };
+
+    const explicitOff = resolveModelSystemPromptScope(workspace, undefined, "off-session")!;
+    setModelSystemPromptEnabled(explicitOff, false);
+    expect(readModelSystemPromptSessionState(explicitOff)).toEqual({ enabled: false });
+    promoteModelSystemPromptDraftFlag({ binding, targetSessionId: "off-session" });
+    // 显式 '0' 不被初始化覆盖。
+    expect(readModelSystemPromptSessionState(explicitOff)).toEqual({ enabled: false });
+
+    const unset = resolveModelSystemPromptScope(workspace, undefined, "unset-session")!;
+    expect(readModelSystemPromptSessionState(unset)).toBeNull();
+    promoteModelSystemPromptDraftFlag({ binding, targetSessionId: "unset-session" });
+    expect(readModelSystemPromptSessionState(unset)).toEqual({ enabled: true });
+
+    const explicitOn = resolveModelSystemPromptScope(workspace, undefined, "on-session")!;
+    setModelSystemPromptEnabled(explicitOn, true);
+    promoteModelSystemPromptDraftFlag({ binding, targetSessionId: "on-session" });
+    expect(readModelSystemPromptSessionState(explicitOn)).toEqual({ enabled: true });
+  });
+
+  it("leaves a newer root untouched when a late receipt names an older owner", () => {
+    const workspace = "/workspace/receipt-new-root";
+    const newer = resolveModelSystemPromptScope(workspace, undefined, null, "gen-2")!;
+    setModelSystemPromptEnabled(newer, true);
+    expect(
+      acceptModelSystemPromptPromotion(
+        receiptEntry({
+          workspacePath: workspace,
+          draftOwnerKey: "gen-1",
+          enabled: true,
+          revision: 1,
+          targetSessionId: "late-session",
+        }),
+      ),
+    ).toBe(true);
+    expect(readModelSystemPromptDraftState(newer)?.enabled).toBe(true);
+  });
+
+  it("keeps the memory option when localStorage writes throw", () => {
+    installStorage({ throwOnSet: true });
+    const workspace = "/workspace/receipt-storage";
+    const draft = resolveModelSystemPromptScope(workspace, undefined, null, "gen-1")!;
+    setModelSystemPromptEnabled(draft, true);
+    const state = readModelSystemPromptDraftState(draft)!;
+    const entry = receiptEntry({
+      workspacePath: workspace,
+      draftOwnerKey: "gen-1",
+      enabled: true,
+      revision: state.revision,
+      targetSessionId: "accepted-session",
+    });
+    expect(acceptModelSystemPromptPromotion(entry)).toBe(true);
+    expect(resolveModelSystemPromptScope(workspace, undefined, "accepted-session")).not.toBeNull();
+    expect(entry.clientContext.modelSystemPromptPromotion?.applied).toBe(true);
+  });
+
+  it("ignores malformed or target-less receipts", () => {
+    expect(isModelSystemPromptPromotionReceipt(null)).toBe(false);
+    expect(isModelSystemPromptPromotionReceipt({ version: 2 })).toBe(false);
+    expect(
+      acceptModelSystemPromptPromotion({
+        sessionId: "accepted-session",
+        clientContext: { modelSystemPromptPromotion: { version: 1 } as never },
+      }),
+    ).toBe(false);
+    expect(
+      acceptModelSystemPromptPromotion(
+        receiptEntry({
+          workspacePath: "/workspace/no-target",
+          draftOwnerKey: "gen-1",
+          enabled: true,
+          revision: 1,
+          targetSessionId: null,
+        }),
+      ),
+    ).toBe(false);
+    expect(
+      acceptModelSystemPromptPromotion(
+        receiptEntry({
+          workspacePath: "/workspace/already-applied",
+          draftOwnerKey: "gen-1",
+          enabled: true,
+          revision: 1,
+          targetSessionId: "accepted-session",
+          applied: true,
+        }),
+      ),
+    ).toBe(false);
+  });
+});
