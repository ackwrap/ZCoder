+            <p className="text-ui-base text-foreground-subtle">
+              {intl.formatMessage({ id: "settings.advanced.modelSystemPrompts.description" })}
+            </p>
+            <div className="flex items-end gap-2">
+              <div className="min-w-0 flex-1">{modelSelect}</div>
+              {configureButton}
+            </div>
+          </div>
+        </SettingsGroupCard>
+      </div>
+      <ModelSystemPromptDialog
+        open={dialogOpen}
+        modelLabel={dialogModelLabel}
+        returnFocusRef={configureButtonRef}
+        draft={draft}
+        pending={pending}
+        error={error}
+        onCancel={closeDialog}
+        onDraftChange={handleDraftChange}
+        onSave={() => {
+          void commit();
+        }}
+      />
+    </>
+  );
+}
