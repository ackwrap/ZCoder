new file mode 100644
index 0000000000000000000000000000000000000000..f66b7022bc831199f8774348474b193ced7a469b
--- /dev/null
+++ b/packages/ui/src/session-diagnostics/tokensPerSecond.ts
@@ -0,0 +1,17 @@
+/**
+ * 本轮输出速率：只按运行时上报的 outputTokens 与模型耗时计算。
+ * 任一值缺失、非正或非有限时返回 null，调用方不显示该项；不用总工时或字符数兜底。
+ */
+export function resolveOutputTokensPerSecond(
+  outputTokens: number | undefined,
+  modelDurationMs: number | undefined,
+): number | null {
+  if (outputTokens === undefined || modelDurationMs === undefined) return null;
+  if (!Number.isFinite(outputTokens) || outputTokens <= 0) return null;
+  if (!Number.isFinite(modelDurationMs) || modelDurationMs <= 0) return null;
+  return outputTokens / (modelDurationMs / 1000);
+}
+
+export function formatTokensPerSecondLabel(rate: number, locale: string): string {
+  return new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(rate);
+}
