+import { describe, expect, it, vi } from "vitest";
+import {
+  createRenameCommand,
+  normalizeRenameTitle,
+  parseRenameCommand,
+  renameCommandCopy,
+} from "../src/v4/slash-commands/rename.js";
+
+describe("/rename command", () => {
+  it.each([
+    ["/rename 深度审计会话", "深度审计会话"],
+    ["/RENAME 深度审计会话", "深度审计会话"],
+    ["  /rename   多  空白  ", "多 空白"],
+    ["/rename 带/斜杠 的标题", "带/斜杠 的标题"],
+    ["/rename", ""],
+  ])("parses %j", (input, title) => {
+    expect(parseRenameCommand(input)).toEqual({ title });
+  });
+
+  it.each(["/renamed 标题", "/rename-x", "rename 标题"])("ignores non-command text %j", (input) => {
+    expect(parseRenameCommand(input)).toBeNull();
+  });
+
+  it("yields to a CLI command with the same name", () => {
+    expect(parseRenameCommand("/rename 标题", new Set(["rename"]))).toBeNull();
+  });
+
+  it("keeps an empty title for model-assisted regeneration", () => {
+    expect(parseRenameCommand("/rename")).toEqual({ title: "" });
+    expect(parseRenameCommand("/rename   ")).toEqual({ title: "" });
+  });
+
+  it("inserts the command text from the picker instead of running it", () => {
+    const run = vi.fn();
+    const command = createRenameCommand({ description: "d", run });
+    expect(command).toMatchObject({ value: "rename", insertText: "/rename " });
+    expect(command.label).toBeUndefined();
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it("normalizes titles without leaving empty segments", () => {
+    expect(normalizeRenameTitle("  a \n b  ")).toBe("a b");
+  });
+
+  it("localizes copy and keeps the requested title", () => {
+    expect(renameCommandCopy("zh-CN").renamed("标题")).toBe("已重命名为「标题」");
+    expect(renameCommandCopy("en-US").renamed("Title")).toBe('Renamed to "Title"');
+    expect(renameCommandCopy("zh-CN").regenerated).toBe("已根据对话重命名");
+    expect(renameCommandCopy("en-US").regenerated).toBe("Renamed from the conversation");
+    expect(renameCommandCopy("zh-CN").generating).toBe("正在根据对话生成标题…");
+    expect(renameCommandCopy("en-US").generating).toBe("Generating a title from the conversation…");
+  });
+});
