+/** 远大于旧 8000 字符上限，用于确认 UI 与发送链路不再截断。 */
+const LONG_TEXT = `  ${"x".repeat(20_000)}\r\n  tail  `;
+/** SessionPane 真实发送链路的 9000+ 正文。 */
+const LONG_PROMPT = "p".repeat(9_500);
+
+function entry(providerId: string, modelId: string, text: string): ModelSystemPromptEntry {
