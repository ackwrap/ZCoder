+import { describe, expect, it } from "vitest";
+import { isMcpStatusCommand } from "../src/lib/mcpStatusCommand.js";
+
+describe("typed MCP status admission yields to exact CLI alias", () => {
+  it.each([
+    ["/mcp", [], true],
+    [" /MCP  ", ["mcp"], false],
+    ["/mcps", ["mcps"], false],
+    ["/mcp", ["mcps"], true],
+    ["/mcps", ["mcp"], true],
+    ["/mcp arg", [], false],
+    ["/mcps-more", [], false],
+    ["/mcp", ["mcp", "mcps"], false],
+  ] as const)("%s with CLI %j => %s", (text, cli, expected) => {
