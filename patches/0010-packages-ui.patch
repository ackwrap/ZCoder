+
+describe("SessionPane long model prompt payloads", () => {
+  beforeEach(async () => {
+    conversationMock.sendCommand.mockClear();
+    readinessMock.gate = Promise.resolve();
+    handshakeMock.supported = true;
+    handshakeMock.legacyOnly = false;
+    servicesMock.zcodeAgentService = {};
+    prewarmMock.binding = null;
