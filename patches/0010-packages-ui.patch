+      sessionId: params.sessionId === undefined ? "toggle-session" : params.sessionId,
+      entries: params.entries ?? [ENTRY],
+      providerId: params.providerId ?? "Provider",
+      modelId: params.modelId ?? "Model",
+      hostSupported: params.hostSupported ?? true,
+    }),
+  );
+}
+
+afterEach(cleanup);
+
+describe("ModelSystemPromptToggle", () => {
+  it("renders only for a non-empty exact match and keeps each session's toggle", () => {
+    const view = renderToggle({});
+    const button = screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE);
+    expect(button.getAttribute("aria-pressed")).toBe("false");
+    expect(button.getAttribute("title")).toBe("chat.modelSystemPrompt.enable");
+    expect(button.tagName).toBe("BUTTON");
+
+    fireEvent.click(button);
+    expect(button.getAttribute("aria-pressed")).toBe("true");
+    expect(button.getAttribute("title")).toBe("chat.modelSystemPrompt.disable");
+
+    view.unmount();
+    renderToggle({});
+    expect(screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE).getAttribute("aria-pressed")).toBe(
+      "true",
+    );
+    cleanup();
+
+    renderToggle({ sessionId: "another-session" });
+    expect(screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE).getAttribute("aria-pressed")).toBe(
+      "false",
+    );
+    cleanup();
+
+    renderToggle({ modelId: "Other" });
+    expect(screen.queryByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE)).toBeNull();
+    cleanup();
+
+    renderToggle({ entries: [{ ...ENTRY, text: "  " }] });
+    expect(screen.queryByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE)).toBeNull();
+  });
+
+  it("hides the icon for a host without the capability", () => {
+    const view = renderToggle({ hostSupported: false });
+    expect(view.container.querySelector("[data-testid]")).toBeNull();
+  });
+
+  it("keeps the same draft owner across remount and isolates a new generation", () => {
+    const workspacePath = "/workspace/draft-owner";
+    const owner = buildModelSystemPromptDraftOwnerKey({
+      projectScope: "project-a",
+      generation: 1,
+    });
+    const nextOwner = buildModelSystemPromptDraftOwnerKey({
+      projectScope: "project-a",
+      generation: 2,
+    });
+    expect(owner).not.toBe(nextOwner);
+
+    const view = render(
+      createElement(ModelSystemPromptToggle, {
+        workspacePath,
+        sessionId: null,
+        draftOwnerKey: owner,
+        entries: [ENTRY],
+        providerId: "Provider",
+        modelId: "Model",
+        hostSupported: true,
+      }),
+    );
+    fireEvent.click(screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE));
+    view.unmount();
+
+    // 同一 owner 重挂：保持该草稿自己的 toggle。
+    render(
+      createElement(ModelSystemPromptToggle, {
+        workspacePath,
+        sessionId: null,
+        draftOwnerKey: owner,
+        entries: [ENTRY],
+        providerId: "Provider",
+        modelId: "Model",
+        hostSupported: true,
+      }),
+    );
+    expect(screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE).getAttribute("aria-pressed")).toBe(
+      "true",
+    );
+    cleanup();
+
+    // 新 generation 是新草稿，默认关闭。
+    render(
+      createElement(ModelSystemPromptToggle, {
+        workspacePath,
+        sessionId: null,
+        draftOwnerKey: nextOwner,
+        entries: [ENTRY],
+        providerId: "Provider",
+        modelId: "Model",
+        hostSupported: true,
+      }),
+    );
+    expect(screen.getByTestId(TID_MODEL_SYSTEM_PROMPT_TOGGLE).getAttribute("aria-pressed")).toBe(
+      "false",
+    );
+  });
+});
