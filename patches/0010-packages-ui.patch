+  }: {
+    onOpenCodeViewer?: (source: { type: "file"; path: string; title: string }) => void;
+  }) =>
+    createElement(
+      "button",
+      {
+        type: "button",
+        onClick: () =>
+          onOpenCodeViewer?.({
+            type: "file",
+            path: "/tmp/output.txt",
+            title: "output.txt",
+          }),
+      },
+      "open-full-file",
+    ),
+}));
+
+const scope = {
+  sessionId: "session-1",
+  workspacePath: "/workspace",
+  workspaceIdentity: "ssh:a",
+  remoteSessionId: "remote-a",
+};
+
+function tab(overrides: Partial<BackgroundBashSidePaneTab> = {}): BackgroundBashSidePaneTab {
+  return {
+    id: "bash-output:session-1:work-1",
+    type: "bash-output",
+    workspacePath: "/workspace",
+    workspaceIdentity: "ssh:a",
+    remoteSessionId: "remote-a",
+    rootSessionId: "root",
+    sessionId: "session-1",
+    workId: "work-1",
+    title: "build",
+    workspaceKey: "ssh:a",
+    ownerTaskId: "session-1",
+    ...overrides,
+  };
+}
+
+afterEach(cleanup);
+
+describe("BackgroundBashOutputDialog 作用域", () => {
+  it("同一会话/工作区/remote 才渲染，切换作用域后不展示旧输出", () => {
+    const value = tab();
+    expect(backgroundBashTabInScope(value, scope)).toBe(value);
+    expect(backgroundBashTabInScope(value, { ...scope, sessionId: "session-2" })).toBeNull();
+    // identity 相同、path 变化也是另一份对话（不能退化成 identity || path）。
+    expect(backgroundBashTabInScope(value, { ...scope, workspacePath: "/other" })).toBeNull();
+    expect(backgroundBashScopeKey({ ...scope, workspacePath: "/other" })).not.toBe(
+      backgroundBashScopeKey(scope),
+    );
+    expect(backgroundBashTabInScope(value, { ...scope, workspaceIdentity: "ssh:b" })).toBeNull();
+    expect(backgroundBashTabInScope(value, { ...scope, remoteSessionId: "remote-b" })).toBeNull();
+    expect(backgroundBashTabInScope(value, { ...scope, sessionId: null })).toBeNull();
+  });
+
+  it("作用域不匹配时不渲染 side pane（轮询不会启动）", () => {
+    render(
+      createElement(BackgroundBashOutputDialog, {
+        tab: tab(),
+        scope: { ...scope, sessionId: "session-2" },
+        onDismiss: vi.fn(),
+      }),
+    );
+    expect(screen.queryByText("open-full-file")).toBeNull();
+  });
+
+  it("完整文件入口先关闭弹窗再移交 code viewer", () => {
+    const order: string[] = [];
+    render(
+      createElement(BackgroundBashOutputDialog, {
+        tab: tab(),
+        scope,
+        onDismiss: () => order.push("dismiss"),
+        onOpenCodeViewer: () => order.push("viewer"),
