+/** 文件查看类别只收普通文件型 source；diff/review/inline text 保持既有独立 tab 语义。 */
+export function isPlainFileViewerSource(source: CodeViewerSource): boolean {
+  switch (source.type) {
+    case "file":
+    case "image":
+    case "media":
+    case "pdf":
+    case "pptx":
+      return true;
+    case "text":
+      return Boolean(source.path);
+    default:
+      return false;
+  }
+}
