diff --git a/packages/ui/test/selectionSideChatLoading.test.ts b/packages/ui/test/selectionSideChatLoading.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a79ae512b759d2d2b55c9f24c34ee12cc4da26fd
--- /dev/null
+++ b/packages/ui/test/selectionSideChatLoading.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "vitest";
+import {
+  closeSidePaneTab,
+  openSelectionSideChatPane,
+  settleSelectionSideChatCreation,
+} from "@/lib/workspaceSidePane.js";
+import {
+  createSelectionSideChat,
+  getSelectionSideChatCreationId,
+} from "@/lib/selectionSideChatRuntime.js";
+
+const request = {
+  workspaceKey: "workspace",
+  workspacePath: "/workspace",
+  parentSessionId: "parent",
+  childSessionId: "pending:one",
+};
+
+function loading() {
+  return openSelectionSideChatPane(null, {
+    ...request,
+    pendingCreation: new Promise<string>(() => {}),
+  });
+}
+
+function settle(
+  state: ReturnType<typeof loading> | null,
+  result: { sessionId: string } | { error: string },
+) {
+  return settleSelectionSideChatCreation(
+    state,
+    request.childSessionId,
+    request.workspaceKey,
+    request.parentSessionId,
+    result,
+  );
+}
+
+describe("selection side chat opens before loading", () => {
+  it("opens a loading tab synchronously and replaces its content without changing identity", () => {
+    const state = loading();
+    expect(state.tabs[0]).toMatchObject({
+      creationState: "loading",
+      childSessionId: "pending:one",
+    });
+    const done = settle(state, { sessionId: "real-child" });
+    expect(done?.activeTabId).toBe(state.activeTabId);
+    expect(done?.tabs[0]).toMatchObject({
+      id: state.tabs[0].id,
+      ordinal: 1,
+      childSessionId: "real-child",
+    });
+    expect(done?.tabs[0]).not.toHaveProperty("creationState", "loading");
+  });
+
+  it("does not recreate a closed tab on success or failure", () => {
+    const state = loading();
+    const closed = closeSidePaneTab(state, state.tabs[0].id);
+    expect(settle(closed, { sessionId: "late-child" })).toBe(closed);
+    expect(settle(closed, { error: "failed" })).toBe(closed);
+  });
+
+  it("preserves focus on another tab and reports failure inline", () => {
+    const state = openSelectionSideChatPane(loading(), { ...request, childSessionId: "other" });
+    const failed = settle(state, { error: "creation failed" });
+    expect(failed?.activeTabId).toBe(state.activeTabId);
+    expect(failed?.tabs[0]).toMatchObject({
+      creationState: "failed",
+      creationError: "creation failed",
+    });
+    expect(failed?.tabs[1]).toBe(state.tabs[1]);
+  });
+
+  it("ignores mismatched workspace and parent and already settled results", () => {
+    const state = loading();
+    expect(
+      settleSelectionSideChatCreation(state, request.childSessionId, "other", "parent", {
+        sessionId: "bad",
+      }),
+    ).toBe(state);
+    expect(
+      settleSelectionSideChatCreation(state, request.childSessionId, "workspace", "other", {
+        sessionId: "bad",
+      }),
+    ).toBe(state);
+    const done = settle(state, { sessionId: "child" });
+    expect(settle(done, { error: "late" })).toBe(done);
+  });
+
+  it("shares a creation identity only while the same request is pending", async () => {
+    let resolve!: (value: string) => void;
+    const first = createSelectionSideChat(
+      "loading-test",
+      () =>
+        new Promise<string>((done) => {
+          resolve = done;
+        }),
+    );
+    const duplicate = createSelectionSideChat("loading-test", async () => "unexpected");
+    expect(duplicate).toBe(first);
+    expect(getSelectionSideChatCreationId(first)).toBe(getSelectionSideChatCreationId(duplicate));
+    resolve("child");
+    await first;
+    const next = createSelectionSideChat("loading-test", async () => "next");
+    expect(getSelectionSideChatCreationId(next)).not.toBe(getSelectionSideChatCreationId(first));
+    await next;
+  });
+});
