+import { useCallback, useEffect, useRef } from "react";
+
+export type SidePaneCapsuleVariant = "panel" | "mini";
+
+export interface SidePaneCapsuleExclusivityOptions {
+  isSidePaneOpen: boolean;
+  variant: SidePaneCapsuleVariant | null;
+  /** workspace + active task；scope 切换/恢复时重新强制折叠。 */
+  scopeKey: string;
+  onChangeVariant: (variant: SidePaneCapsuleVariant | null) => void;
+  onCloseSidePane: () => void;
+}
+
+export function resolveCapsuleVariantForOpenSidePane({
+  isSidePaneOpen,
+  variant,
+}: {
+  isSidePaneOpen: boolean;
+  variant: SidePaneCapsuleVariant | null;
+}): SidePaneCapsuleVariant | null {
+  if (isSidePaneOpen && variant !== "mini") {
+    return "mini";
+  }
+  return variant;
+}
+
+export function shouldCloseSidePaneForCapsuleExpand({
+  isSidePaneOpen,
+  nextVariant,
+}: {
+  isSidePaneOpen: boolean;
+  nextVariant: SidePaneCapsuleVariant | null;
+}): boolean {
+  return isSidePaneOpen && nextVariant === "panel";
+}
+
+/**
+ * Side Pane 与对话状态胶囊互斥：
+ * - Side Pane 可见（无论从哪个入口打开/scope 恢复）时，胶囊强制 mini；
+ * - 用户把胶囊展开为 panel 时，关闭 Side Pane（只收起面板，不删 tabs/dirty 内容）；
+ * - 关闭 Side Pane 不反向强制展开胶囊。
+ */
+export function useSidePaneCapsuleExclusivity({
+  isSidePaneOpen,
+  variant,
+  scopeKey,
+  onChangeVariant,
+  onCloseSidePane,
+}: SidePaneCapsuleExclusivityOptions): {
+  handleVariantChange: (nextVariant: SidePaneCapsuleVariant | null) => void;
+} {
+  // 用户刚主动展开胶囊时，允许先关闭 Side Pane；避免同一批状态里又被“打开必折叠”抢回 mini。
+  const capsuleExpandedByUserRef = useRef(false);
+  const scopeKeyRef = useRef(scopeKey);
+  if (scopeKeyRef.current !== scopeKey) {
+    scopeKeyRef.current = scopeKey;
+    capsuleExpandedByUserRef.current = false;
+  }
+
+  useEffect(() => {
+    if (!isSidePaneOpen) {
+      capsuleExpandedByUserRef.current = false;
+      return;
+    }
+    if (capsuleExpandedByUserRef.current) {
+      return;
+    }
+    const nextVariant = resolveCapsuleVariantForOpenSidePane({ isSidePaneOpen, variant });
+    if (nextVariant !== variant) {
+      onChangeVariant(nextVariant);
+    }
+  }, [isSidePaneOpen, onChangeVariant, scopeKey, variant]);
+
+  const handleVariantChange = useCallback(
+    (nextVariant: SidePaneCapsuleVariant | null) => {
+      if (shouldCloseSidePaneForCapsuleExpand({ isSidePaneOpen, nextVariant })) {
+        capsuleExpandedByUserRef.current = true;
+        onCloseSidePane();
+      } else if (nextVariant !== "panel") {
+        capsuleExpandedByUserRef.current = false;
+      }
+      onChangeVariant(nextVariant);
+    },
+    [isSidePaneOpen, onChangeVariant, onCloseSidePane],
+  );
+
+  return { handleVariantChange };
+}
