new file mode 100644
index 0000000000000000000000000000000000000000..30b900f4eef274d3b0cdf073a52c5d9b299409f2
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/FocusModeTimeline.tsx
@@ -0,0 +1,88 @@
+import { useCallback, useLayoutEffect, useMemo, useRef, useState } from "react";
+import {
+  ConversationTimeline,
+  type ConversationTimelineNavigationAdapter,
+  type ConversationTimelineProps,
+} from "@/v4/ConversationTimeline.js";
+import { FocusModeNavigationButtons } from "./FocusModeNavigationButtons.js";
+import { useFocusTimelineWindow } from "./useFocusTimelineWindow.js";
+import { useComposerNavigationAlignment } from "./useComposerNavigationAlignment.js";
+
+/** Renderer-local focus view; phase changes keep the timeline and dock mounted. */
+export function ConversationFocusModeTimeline(props: ConversationTimelineProps) {
+  const {
+    rows,
+    sessionKey,
+    canLoadOlder = false,
+    loadingOlder = false,
+    onLoadOlder,
+    scrollToBottomActionRef,
+    ...rest
+  } = props;
+  const rootRef = useRef<HTMLDivElement>(null);
+  const navigationSlotRef = useRef<HTMLDivElement>(null);
+  useComposerNavigationAlignment(rootRef, navigationSlotRef, sessionKey, Boolean(props.bottomDock));
+  const [phase, setPhase] = useState({ sessionKey, expanded: false });
+  if (phase.sessionKey !== sessionKey) setPhase({ sessionKey, expanded: false });
+  const expanded = phase.sessionKey === sessionKey && phase.expanded;
+  const focus = useFocusTimelineWindow({
+    rows,
+    sessionKey,
+    canLoadOlder,
+    loadingOlder,
+    onLoadOlder,
+    active: !expanded,
+  });
+  const innerScrollToBottomRef = useRef<(() => void) | null>(null);
+  const handleBackToBottom = useCallback(() => {
+    if (expanded) setPhase({ sessionKey, expanded: false });
+    else innerScrollToBottomRef.current?.();
+  }, [expanded, sessionKey]);
+  useLayoutEffect(() => {
+    if (!scrollToBottomActionRef) return;
+    scrollToBottomActionRef.current = handleBackToBottom;
+    return () => {
+      if (scrollToBottomActionRef.current === handleBackToBottom)
+        scrollToBottomActionRef.current = null;
+    };
+  }, [handleBackToBottom, scrollToBottomActionRef]);
+  const navigationAdapter = useMemo<ConversationTimelineNavigationAdapter>(
+    () => ({
+      onBackToBottom: handleBackToBottom,
+      windowPlacement: expanded
+        ? { key: `${sessionKey}|expanded`, placement: "top" }
+        : { key: `${sessionKey}|latest`, placement: "bottom" },
+    }),
+    [expanded, handleBackToBottom, sessionKey],
+  );
+
+  return (
+    <div ref={rootRef} className="relative flex min-h-0 flex-1 flex-col">
+      <div ref={navigationSlotRef} data-focus-navigation-slot="true" className="relative shrink-0">
+        <div className="relative left-[var(--focus-composer-center,50%)] w-max -translate-x-1/2">
+          <FocusModeNavigationButtons
+            isLatest={!expanded}
+            loadStatus={expanded ? "idle" : focus.loadStatus}
+            onOlder={() => setPhase({ sessionKey, expanded: true })}
+            onNewer={handleBackToBottom}
+            onRetry={focus.retryLoadOlder}
+          />
+        </div>
+      </div>
+      <ConversationTimeline
+        {...rest}
+        rows={expanded ? rows : focus.visibleRows}
+        totalCount={expanded ? props.totalCount : focus.visibleRows.length}
+        sessionKey={sessionKey}
+        canLoadOlder={expanded && canLoadOlder && !focus.focusLoading}
+        loadingOlder={expanded && (loadingOlder || focus.focusLoading)}
+        onLoadOlder={expanded ? onLoadOlder : undefined}
+        onLoadAllOlder={undefined}
+        scrollMemoryKey={null}
+        scrollToBottomActionRef={innerScrollToBottomRef}
+        hideTurnNavigator={expanded ? props.hideTurnNavigator : true}
+        navigationAdapter={navigationAdapter}
+      />
+    </div>
+  );
+}
