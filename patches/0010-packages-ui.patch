+  });
+
+  it("renders a compact labelled button", () => {
+    const html = renderToStaticMarkup(
+      createElement(SubagentDirectoryButton, {
+        workspacePath: "/work",
+        sessionId: "s1",
+        onOpen: vi.fn(),
