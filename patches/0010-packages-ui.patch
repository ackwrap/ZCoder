+
+export function readCompleteTaskOutput(
+  text: unknown,
+  taskId: string | undefined,
+  truncated: unknown,
+): string | undefined {
+  if (typeof text !== "string" || !taskId || truncated || text.length > 8 * 1024 * 1024)
+    return undefined;
+  const match =
+    /^<retrieval_status>(?:success|not_ready|timeout)<\/retrieval_status>\n\n<task_id>([^\n]+)<\/task_id>\n\n<task_type>([^\n]+)<\/task_type>\n\n<status>[^\n]+<\/status>(?:\n\n<exit_code>-?\d+<\/exit_code>)?\n\n<output>\n([\s\S]*)\n<\/output>(?:\n\n<error>[\s\S]*<\/error>)?$/u.exec(
+      text,
+    );
+  if (
+    !match ||
+    match[1] !== taskId ||
+    match[2] === "local_agent" ||
+    !match[3]?.trim() ||
+    match[3].includes("[Truncated.") ||
+    match[3].includes("[Tool output truncated")
+  )
+    return undefined;
+  return match[3];
+}
+
+export async function readTaskOutputCopySource(
+  source: { path: string; bytes: number },
+  readRange: (params: { path: string; offset: number; length: number }) => Promise<Uint8Array>,
+  isCurrent: () => boolean = () => true,
+): Promise<string> {
+  if (!Number.isInteger(source.bytes) || source.bytes <= 0 || source.bytes > 8 * 1024 * 1024)
+    throw new Error("Invalid output size");
+  const bytes = new Uint8Array(source.bytes);
+  let offset = 0;
+  while (offset < source.bytes) {
+    if (!isCurrent()) throw new Error("Stale copy");
+    const length = Math.min(256 * 1024, source.bytes - offset);
+    const chunk = await readRange({ path: source.path, offset, length });
+    if (!isCurrent() || chunk.byteLength !== length) throw new Error("Incomplete output");
+    bytes.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  if ((await readRange({ path: source.path, offset, length: 1 })).byteLength !== 0 || !isCurrent())
+    throw new Error("Output changed");
+  return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+}
+
+export interface TaskOutputCopyInput {
+  toolId: string;
+  taskId: string | undefined;
+  output: unknown;
+  outputTruncated: unknown;
+  source: { path: string; bytes: number } | undefined;
+  hasOutput: boolean;
+  isRunning: boolean;
+  isExecutionFailed: boolean;
+  isDenied: boolean;
+  isStopped: boolean;
+}
+
+export function useTaskOutputCopyAction({
+  toolId,
+  taskId,
+  output,
+  outputTruncated,
+  source,
+  hasOutput,
+  isRunning,
+  isExecutionFailed,
+  isDenied,
+  isStopped,
+}: TaskOutputCopyInput) {
+  const { intl } = useZCodeIntl();
+  const capabilities = useToolPresentationCapabilities();
+  const inlineOutput = readCompleteTaskOutput(output, taskId, outputTruncated);
+  const canCopy =
+    !isRunning &&
+    !isExecutionFailed &&
+    !isDenied &&
+    !isStopped &&
+    Boolean((source && capabilities.readTaskOutputRange && !capabilities.readonly) || inlineOutput);
+  const [copyState, setCopyState] = useState<"idle" | "loading" | "copied" | "failed">("idle");
+  const copyGeneration = useRef(0);
+  const copyBusy = useRef(false);
+  useLayoutEffect(() => {
+    copyGeneration.current += 1;
+    copyBusy.current = false;
+    setCopyState("idle");
+    return () => {
+      copyGeneration.current += 1;
+    };
+  }, [toolId, source?.path, source?.bytes, inlineOutput, capabilities.readTaskOutputRange]);
+  const handleCopy = useCallback(async () => {
+    if (!canCopy || copyBusy.current) return;
+    copyBusy.current = true;
+    const generation = copyGeneration.current;
+    const isCurrent = () => generation === copyGeneration.current;
+    setCopyState("loading");
+    try {
+      if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
+      const textPromise =
+        source && capabilities.readTaskOutputRange && !capabilities.readonly
+          ? readTaskOutputCopySource(source, capabilities.readTaskOutputRange, isCurrent)
+          : Promise.resolve(inlineOutput);
+      if (typeof ClipboardItem !== "undefined" && navigator.clipboard.write) {
+        const content = textPromise.then((text) => {
+          if (!isCurrent() || text === undefined) throw new Error("Full output unavailable");
+          return new Blob([text], { type: "text/plain" });
+        });
+        // WebKit requires write admission during the original user gesture, before Host IO.
+        void content.catch(() => undefined);
+        await navigator.clipboard.write([new ClipboardItem({ "text/plain": content })]);
+      } else {
+        const text = await textPromise;
+        if (!isCurrent()) return;
+        if (text === undefined) throw new Error("Full output unavailable");
+        await navigator.clipboard.writeText(text);
+      }
+      if (isCurrent()) setCopyState("copied");
+    } catch {
+      if (isCurrent()) setCopyState("failed");
+    } finally {
+      if (isCurrent()) copyBusy.current = false;
+    }
+  }, [canCopy, source, capabilities.readTaskOutputRange, capabilities.readonly, inlineOutput]);
+  const copyLabel = intl.formatMessage({
+    id: !canCopy
+      ? "chat.toolCall.taskOutput.copyUnavailable"
+      : copyState === "idle"
+        ? "chat.toolCall.taskOutput.copy"
+        : `chat.toolCall.taskOutput.copy.${copyState}`,
+  });
+  const copyAction = useMemo(
+    () =>
+      hasOutput ? (
+        <span className="inline-flex shrink-0 items-center">
+          <Button
+            type="button"
+            variant="ghost"
+            size="icon-sm"
+            disabled={!canCopy || copyState === "loading"}
+            aria-label={copyLabel}
+            title={copyLabel}
+            onClick={(event) => {
+              event.stopPropagation();
+              void handleCopy();
+            }}
+          >
+            {copyState === "copied" ? (
+              <CheckIcon className="size-3.5" />
+            ) : (
+              <CopyIcon className="size-3.5" />
+            )}
+          </Button>
+          <span
+            role="status"
+            className={copyState === "failed" ? "text-ui-xs text-foreground-subtle" : "sr-only"}
+          >
+            {copyState !== "idle" ? copyLabel : ""}
+          </span>
+        </span>
+      ) : undefined,
+    [hasOutput, canCopy, copyState, copyLabel, handleCopy],
+  );
+
+  return copyAction;
+}
