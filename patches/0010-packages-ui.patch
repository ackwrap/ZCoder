+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { CodexConnectionCard } from "@/codex-provider/contract.js";
+
+const mocks = vi.hoisted(() => ({
+  status: vi.fn(),
+  start: vi.fn(),
+  startDevice: vi.fn(),
+  cancel: vi.fn(),
+  disconnect: vi.fn(),
+  openExternal: vi.fn(),
+  writeText: vi.fn(),
+  local: true,
+}));
+vi.mock("@/hooks/useServices.js", () => ({ useServices: () => ({ codexProviderService: mocks }) }));
+vi.mock("@/hooks/usePlatform.js", () => ({
+  usePlatform: () => ({ canOpenLocalFiles: mocks.local, openExternal: mocks.openExternal }),
+}));
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    intl: { formatMessage: ({ id }: { id: string }) => id.split(".").at(-1) },
+  }),
+}));
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.local = true;
+  mocks.status.mockResolvedValue({ connected: false, loginAvailable: true });
+  mocks.start.mockResolvedValue({
+    flowId: "flow-test",
+    authorizeUrl: "https://auth.openai.com/api/accounts/authorize?fixture=true",
+  });
+  mocks.cancel.mockResolvedValue(undefined);
+  mocks.disconnect.mockResolvedValue(undefined);
+  Object.defineProperty(navigator, "clipboard", {
+    configurable: true,
+    value: { writeText: mocks.writeText },
+  });
+  mocks.writeText.mockResolvedValue(undefined);
+});
+afterEach(cleanup);
+
+describe("Codex connection card", () => {
+  it("retains both login options without the idle promotional description", async () => {
+    render(createElement(CodexConnectionCard, { providerId: "codex-test" }));
+    await waitFor(() =>
+      expect((screen.getByTestId("codex-login") as HTMLButtonElement).disabled).toBe(false),
+    );
+    expect(screen.getByTestId("codex-device-login")).toBeTruthy();
+    expect(screen.queryByText("description")).toBeNull();
+  });
+  it("only requests a device code on click, opens the fixed official page, and hides it on cancel", async () => {
+    const device = {
+      verificationUrl: "https://auth.openai.com/codex/device",
+      userCode: "ABCD-EFGH",
+      expiresAt: Date.now() + 900000,
+    };
+    mocks.startDevice.mockImplementation(async () => {
+      mocks.status.mockResolvedValue({
+        connected: false,
+        loginAvailable: true,
+        flow: { id: "device-flow", state: "waiting", device },
+      });
+      return { flowId: "device-flow", ...device };
+    });
+    render(createElement(CodexConnectionCard, { providerId: "codex-test" }));
+    await waitFor(() =>
+      expect((screen.getByTestId("codex-device-login") as HTMLButtonElement).disabled).toBe(false),
+    );
+    expect(mocks.startDevice).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByTestId("codex-device-login"));
+    expect((await screen.findByTestId("codex-device-code")).textContent).toBe("ABCD-EFGH");
+    expect(mocks.start).not.toHaveBeenCalled();
+    expect(mocks.openExternal).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByTestId("codex-device-open"));
+    expect(mocks.openExternal).toHaveBeenCalledWith("https://auth.openai.com/codex/device");
+    fireEvent.click(screen.getByTestId("codex-device-copy"));
+    expect(mocks.writeText).toHaveBeenCalledWith("ABCD-EFGH");
+    mocks.status.mockResolvedValue({
+      connected: false,
+      loginAvailable: true,
+      flow: { id: "device-flow", state: "cancelled" },
+    });
+    fireEvent.click(screen.getByTestId("codex-cancel"));
+    await waitFor(() => expect(screen.queryByTestId("codex-device-code")).toBeNull());
+    expect(mocks.cancel).toHaveBeenCalledWith("codex-test", "device-flow");
+  });
+  it("opens the system browser only after explicit login and supports cancel", async () => {
+    render(createElement(CodexConnectionCard, { providerId: "codex-test" }));
+    await waitFor(() =>
+      expect((screen.getByTestId("codex-login") as HTMLButtonElement).disabled).toBe(false),
+    );
+    expect(mocks.openExternal).not.toHaveBeenCalled();
+    mocks.status.mockResolvedValue({
+      connected: false,
+      loginAvailable: true,
+      flow: { id: "flow-test", state: "waiting" },
+    });
+    fireEvent.click(screen.getByTestId("codex-login"));
+    await waitFor(() => expect(mocks.openExternal).toHaveBeenCalledOnce());
+    expect(screen.queryByRole("textbox")).toBeNull();
+    fireEvent.click(await screen.findByTestId("codex-cancel"));
+    await waitFor(() => expect(mocks.cancel).toHaveBeenCalledWith("codex-test", "flow-test"));
+  });
+
+  it("does not start loopback OAuth or read Host auth state from mobile Web", async () => {
+    mocks.local = false;
+    render(createElement(CodexConnectionCard, { providerId: "codex-test" }));
+    expect((screen.getByTestId("codex-login") as HTMLButtonElement).disabled).toBe(true);
+    expect(screen.getByText("desktopOnly")).toBeTruthy();
+    expect(mocks.status).not.toHaveBeenCalled();
+    expect(mocks.start).not.toHaveBeenCalled();
+  });
+
+  it("shows sharing-permission failures without a legacy fallback", async () => {
+    mocks.status.mockResolvedValue({
+      connected: false,
+      loginAvailable: true,
+      flow: { id: "flow-test", state: "failed", error: "codex-token-sharing-required" },
+    });
+    render(createElement(CodexConnectionCard, { providerId: "codex-test" }));
+    expect((await screen.findByRole("alert")).textContent).toBe("sharingRequired");
+    expect(mocks.start).not.toHaveBeenCalled();
+  });
+});
