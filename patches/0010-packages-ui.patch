+/**
+ * mode-switch 对外契约：运行中会话切换权限模式时，是否要立即下发
+ * switchCollaborationMode（而不是只改下一次 Submission 的草稿）。
+ *
+ * 纯函数，不持有状态、不等待：草稿回显、CAS 重试、串行与失败纠正由 SessionPane
+ * 的调用方持有；本模块只回答“有没有必要发一条命令”。
+ */
+export {
+  createModeSwitchSequencer,
+  isSwitchableCollaborationMode,
+  MODE_SWITCH_UNCONFIRMED_MESSAGE,
+  resolveImmediateModeCommand,
+  SWITCHABLE_COLLABORATION_MODES,
+  type ImmediateModeCommandInput,
+  type ModeSwitchAck,
+  type ModeSwitchSendInput,
+  type ModeSwitchSequencer,
+  type ModeSwitchSequencerOptions,
+  type ModeSwitchSnapshot,
+  type SwitchableCollaborationMode,
+} from "./runtime.js";
