+import { afterEach, describe, expect, it } from "vitest";
+import {
+  activateNewTabSidePane,
+  getActiveSidePaneTab,
+  navigateFileManagerSidePaneSafely,
+  openCodeViewerSidePane,
+  openCodeViewerSidePanes,
+  openFileManagerSidePane,
+  openPlanDetailSidePane,
+  openSubagentSessionSidePane,
+  type WorkspaceSidePaneState,
+} from "../src/lib/workspaceSidePane.js";
+import {
+  clearFileViewerDirty,
+  isFileViewerDirty,
+  setFileViewerDirty,
+} from "../src/side-pane-viewer-tabs/contract.js";
+
+const dirtyTabIds = new Set<string>();
+
+function markFileViewerDirty(tabId: string): void {
+  dirtyTabIds.add(tabId);
+  setFileViewerDirty(tabId, true);
+}
+
+afterEach(() => {
+  for (const tabId of dirtyTabIds) {
+    clearFileViewerDirty(tabId);
+  }
+  dirtyTabIds.clear();
+});
+
+function fileSource(path: string, workspacePath = "/workspace") {
+  return {
+    type: "file" as const,
+    title: path.split("/").at(-1) ?? path,
+    path,
+    workspacePath,
+  };
+}
+
+function openAgent(
+  state: WorkspaceSidePaneState | null,
+  options: {
+    rootSessionId?: string;
+    parentSessionId?: string;
+    childSessionId: string;
+    title: string;
+  },
+) {
+  return openSubagentSessionSidePane(state, {
+    workspaceKey: "/workspace",
+    workspacePath: "/workspace",
+    rootSessionId: options.rootSessionId ?? "root-a",
+    parentSessionId: options.parentSessionId ?? "root-a",
+    childSessionId: options.childSessionId,
+    subagentType: "Explore",
+    title: options.title,
+  });
+}
+
+describe("side pane viewer category tabs", () => {
