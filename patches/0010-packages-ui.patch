diff --git a/packages/ui/test/useSettingServiceCompactionPolicy.test.ts b/packages/ui/test/useSettingServiceCompactionPolicy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a9a1f79996fdab51869f60da09e8e0862b92f14
--- /dev/null
+++ b/packages/ui/test/useSettingServiceCompactionPolicy.test.ts
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+// docs/compaction-profiles.md「Host → CLI 同步」「设置契约」：三个压缩设置发生变化时，
+// persist 成功后同步 Host/Bot 并沿用现有 broadcast 机制；不混入 strict interaction preferences。
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL, type AppSettings } from "@zcode/shared";
+import type { IServiceAccessor } from "@zcode/services";
+
+const settingService = {
+  get: vi.fn<() => Promise<AppSettings>>(),
+  update: vi.fn<(patch: Partial<AppSettings>) => Promise<void>>(),
+};
+const broadcastService = {
+  send: vi.fn<(message: { channel: string; payload: unknown }) => Promise<void>>(),
+};
+const zcodeAgentService = {
+  syncAppRuntimePreferences: vi.fn(async () => undefined),
+  syncCompactionPolicy: vi.fn(async () => undefined),
+};
+const botsService = {
+  syncAppRuntimePreferences: vi.fn(async () => undefined),
+  syncCompactionPolicy: vi.fn(async () => undefined),
+};
+const services = {
+  broadcastService,
+  settingService,
+  zcodeAgentService,
+  botsService,
+} as unknown as IServiceAccessor;
+
+vi.mock("@/hooks/useServices.js", () => ({
+  useServices: () => services,
+}));
+
+vi.mock("@/hooks/usePlatform.js", () => ({
+  usePlatform: () => ({}),
+}));
+
+describe("useSettings compaction policy runtime sync", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    settingService.get.mockResolvedValue({} as AppSettings);
+    settingService.update.mockResolvedValue(undefined);
+    broadcastService.send.mockResolvedValue(undefined);
+    zcodeAgentService.syncCompactionPolicy.mockResolvedValue(undefined);
+    botsService.syncCompactionPolicy.mockResolvedValue(undefined);
+  });
+
+  it.each([
+    [{ compactionProfile: "compact" as const }, "compact", 15_000, 8_000],
+    [{ compactionTailBudgetTokens: 40_000 }, "detailed", 40_000, 8_000],
+    [{ compactionSummaryMaxOutputTokens: 12_000 }, "detailed", 15_000, 12_000],
+  ])("persist 成功后同步归一策略并广播：%j", async (patch, profile, tailBudgetTokens, summary) => {
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await hook.result.current.update(patch);
+    });
+
+    const policy = { profile, tailBudgetTokens, summaryMaxOutputTokens: summary };
+    expect(settingService.update).toHaveBeenCalledWith(patch);
+    expect(zcodeAgentService.syncCompactionPolicy).toHaveBeenCalledWith(policy);
+    expect(botsService.syncCompactionPolicy).toHaveBeenCalledWith(policy);
+    expect(broadcastService.send).toHaveBeenCalledWith({
+      channel: COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL,
+      payload: policy,
+    });
+    // 三个压缩字段走独立方法，不塞进 strict interaction preferences。
+    expect(zcodeAgentService.syncAppRuntimePreferences).not.toHaveBeenCalled();
+    expect(botsService.syncAppRuntimePreferences).not.toHaveBeenCalled();
+    hook.unmount();
+  });
+
+  it("持久化失败时不触发同步或广播", async () => {
+    settingService.update.mockRejectedValueOnce(new Error("write failed"));
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await expect(hook.result.current.update({ compactionProfile: "compact" })).rejects.toThrow(
+        "write failed",
+      );
+    });
+
+    expect(zcodeAgentService.syncCompactionPolicy).not.toHaveBeenCalled();
+    expect(botsService.syncCompactionPolicy).not.toHaveBeenCalled();
+    expect(broadcastService.send).not.toHaveBeenCalled();
+    hook.unmount();
+  });
+
+  it("Host 同步失败仍广播，但把失败上报给保存方", async () => {
+    zcodeAgentService.syncCompactionPolicy.mockRejectedValueOnce(new Error("host gone"));
+    const { useSettings } = await import("@/hooks/useSettingService.js");
+    const hook = renderHook(() => useSettings());
+    await waitFor(() => expect(hook.result.current.loading).toBe(false));
+
+    await act(async () => {
+      await expect(hook.result.current.update({ compactionProfile: "compact" })).rejects.toThrow(
+        "host gone",
+      );
+    });
+
+    expect(broadcastService.send).toHaveBeenCalledWith(
+      expect.objectContaining({ channel: COMPACTION_POLICY_CHANGED_BROADCAST_CHANNEL }),
+    );
+    hook.unmount();
+  });
+});
diff --git a/packages/ui/test/v4-context-artifacts/contract.test.ts b/packages/ui/test/v4-context-artifacts/contract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5ef9e8c192e638cb2565e7046da18807819e331a
--- /dev/null
+++ b/packages/ui/test/v4-context-artifacts/contract.test.ts
@@ -0,0 +1,151 @@
+// @vitest-environment jsdom
+import { createElement, type ComponentProps } from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, expectTypeOf, it, vi } from "vitest";
+import {
+  CompactResultMarker,
+  ContextSourceUpdateNotice,
+  type CompactResultMarkerProps,
+  type ContextSourceUpdateNoticeProps,
+} from "@/v4/context-artifacts/contract.js";
+import {
+  exampleCompactResultMarker,
+  exampleContextSourceUpdateNotice,
+} from "@/v4/context-artifacts/contract.example.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+
+type ReadSummary = NonNullable<CompactResultMarkerProps["context"]["readCompactSummary"]>;
+
+function compactProps(readCompactSummary?: ReadSummary): CompactResultMarkerProps {
+  return {
+    row: {
+      rowId: 12,
+      turnId: "turn-1",
+      kind: "timelineMarker",
+      createdAt: 1,
+      createdAtSeq: 1,
+      marker: {
+        type: "compact",
+        status: "success",
+        origin: "manual",
+        operationId: "compact-1",
+        summaryRef: "summary-1",
+      },
+    },
+    context: {
+      workspacePath: "/repo",
+      workspaceIdentity: "workspace-1",
+      sessionId: "session-1",
+      logEpoch: "epoch-1",
+      branchGeneration: 2,
+      theme: "light",
+      codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+      readCompactSummary,
+    },
+    label: "Saved context",
+    icon: null,
+  };
+}
+
+function localized(children: ReturnType<typeof createElement>) {
+  return createElement(ZCodeIntlProvider, { initialLocale: "en-US", children });
+}
+
+afterEach(cleanup);
+
+describe("v4 context artifacts UI contract", () => {
+  it("derives props from the original components and forwards them without a second owner", () => {
+    expectTypeOf<CompactResultMarkerProps>().toEqualTypeOf<
+      ComponentProps<typeof CompactResultMarker>
+    >();
+    expectTypeOf<ContextSourceUpdateNoticeProps>().toEqualTypeOf<
+      ComponentProps<typeof ContextSourceUpdateNotice>
+    >();
+    expectTypeOf<keyof CompactResultMarkerProps>().toEqualTypeOf<
+      "row" | "context" | "label" | "icon"
+    >();
+    expectTypeOf<keyof ContextSourceUpdateNoticeProps>().toEqualTypeOf<"row">();
+    const props = compactProps();
+    const compact = exampleCompactResultMarker(props);
+    const notice = exampleContextSourceUpdateNotice({ row: props.row });
+    expect(compact.type).toBe(CompactResultMarker);
+    expect(compact.props.context).toBe(props.context);
+    expect(compact.props.row).toBe(props.row);
+    expect(notice.type).toBe(ContextSourceUpdateNotice);
+    expect(notice.props.row).toBe(props.row);
+  });
+
+  it("reads only through the injected callback, lazily passing the exact projected identity", async () => {
+    const read = vi.fn<ReadSummary>().mockResolvedValue({
+      status: "unavailable",
+      reason: "notAuthorized",
+    });
+    const view = render(localized(exampleCompactResultMarker(compactProps(read))));
+    expect(read).not.toHaveBeenCalled();
+    expect(view.container.textContent).toContain("Saved context");
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.container.textContent).toContain("Summary unavailable"));
+    expect(read).toHaveBeenCalledExactlyOnceWith({
+      sessionId: "session-1",
+      baseLogEpoch: "epoch-1",
+      branchGeneration: 2,
+      rowId: 12,
+      operationId: "compact-1",
+      summaryRef: "summary-1",
+    } satisfies Parameters<ReadSummary>[0]);
+    expect(view.container.querySelectorAll('[data-row-kind="timelineMarker"]')).toHaveLength(1);
+  });
+
+  it("does not fall back to a service when the host omits the read capability", async () => {
+    const view = render(localized(createElement(CompactResultMarker, compactProps())));
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.container.textContent).toContain("Summary unavailable"));
+    expect(view.queryByRole("button", { name: "Retry" })).toBeNull();
+  });
+
+  it("keeps host read errors out of rendered output", async () => {
+    const secret = "PRIVATE /session.db credential=secret";
+    const read = vi.fn<ReadSummary>().mockRejectedValue(new Error(secret));
+    const view = render(localized(createElement(CompactResultMarker, compactProps(read))));
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.getByRole("button", { name: "Retry" })).toBeTruthy());
+    expect(view.container.innerHTML).not.toContain(secret);
+    expect(view.container.textContent).not.toContain("PRIVATE");
+  });
+
+  it("renders notice labels as text without keys, revisions, prompt bodies or checkpoints", () => {
+    const label = '<img src=x onerror="alert(1)">';
+    const update = {
+      version: 1 as const,
+      kind: "instructions" as const,
+      sourceKey: "PRIVATE CATALOG KEY",
+      revision: "a".repeat(64),
+      content: "PRIVATE PROMPT BODY",
+      runtimeCheckpoint: { token: "PRIVATE TOKEN" },
+      changes: [
+        { sourceKey: "PRIVATE ITEM KEY", label, change: "replaced" as const, body: "PRIVATE BODY" },
+      ],
+    };
+    const props: ContextSourceUpdateNoticeProps = {
+      row: {
+        rowId: 13,
+        turnId: "turn-1",
+        kind: "timelineMarker",
+        createdAt: 1,
+        createdAtSeq: 1,
+        marker: { type: "contextSourceUpdate", update },
+      },
+    };
+    const view = render(localized(exampleContextSourceUpdateNotice(props)));
+    expect(view.container.textContent).toContain(label);
+    expect(view.container.textContent).toContain("Changed");
+    expect(view.container.innerHTML).not.toContain("PRIVATE");
+    expect(view.container.innerHTML).not.toContain(update.revision);
+    expect(view.container.querySelector("img, script")).toBeNull();
+    expect(view.container.querySelector('[data-row-kind="userInput"]')).toBeNull();
+    expect(
+      view.container.querySelectorAll('[data-marker-type="contextSourceUpdate"]'),
+    ).toHaveLength(1);
+  });
+});
