+import { describe, expect, it } from "vitest";
+import {
+  isSwitchableCollaborationMode,
+  resolveImmediateModeCommand,
+} from "@/v4/composer/mode-switch/contract.js";
+
+const base = {
+  mode: "yolo",
+  sessionId: "session-1",
+  liveSessionId: "session-1",
+  acknowledgedMode: "guarded",
+  readOnly: false,
+};
+
+describe("resolveImmediateModeCommand", () => {
+  it("运行中的会话切到完全访问时立即下发命令", () => {
+    expect(resolveImmediateModeCommand(base)).toBe("yolo");
+    expect(resolveImmediateModeCommand({ ...base, mode: "build", acknowledgedMode: "yolo" })).toBe(
+      "build",
+    );
+    expect(
+      resolveImmediateModeCommand({ ...base, mode: "guarded", acknowledgedMode: "build" }),
+    ).toBe("guarded");
+  });
+
+  it("草稿态、只读态与投影未切到当前会话时只改草稿", () => {
+    expect(resolveImmediateModeCommand({ ...base, sessionId: null })).toBeNull();
+    expect(resolveImmediateModeCommand({ ...base, readOnly: true })).toBeNull();
+    expect(resolveImmediateModeCommand({ ...base, liveSessionId: "session-old" })).toBeNull();
+    expect(resolveImmediateModeCommand({ ...base, liveSessionId: undefined })).toBeNull();
+  });
+
+  it("plan 与未知模式由草稿路径处理，不下发命令", () => {
+    for (const mode of ["plan", "plan-off", "auto", "unknown"]) {
+      expect(resolveImmediateModeCommand({ ...base, mode })).toBeNull();
+    }
+  });
+
+  it("服务端已确认同值且无在途意图时不重复写入", () => {
+    expect(resolveImmediateModeCommand({ ...base, acknowledgedMode: "yolo" })).toBeNull();
+    // 旧会话快照缺 mode 时按 build 处理。
+    expect(
+      resolveImmediateModeCommand({ ...base, mode: "build", acknowledgedMode: undefined }),
+    ).toBeNull();
+    expect(
+      resolveImmediateModeCommand({ ...base, mode: "build", acknowledgedMode: null }),
+    ).toBeNull();
+  });
+
+  it("失败后状态 unknown 时同值选择不能被旧基线吞掉", () => {
+    expect(
+      resolveImmediateModeCommand({
+        ...base,
+        mode: "guarded",
+        acknowledgedMode: "guarded",
+        unknown: true,
+      }),
+    ).toBe("guarded");
+    expect(
+      resolveImmediateModeCommand({
+        ...base,
+        mode: "guarded",
+        acknowledgedMode: null,
+        unknown: true,
+      }),
+    ).toBe("guarded");
+  });
+
+  it("有在途意图时同值也要保留，避免丢失 guarded→yolo→guarded 的最后一次", () => {
+    expect(
+      resolveImmediateModeCommand({
+        ...base,
+        mode: "guarded",
+        acknowledgedMode: "guarded",
+        hasPendingIntent: true,
+      }),
+    ).toBe("guarded");
+  });
+
+  it("可切换值域与 v4 命令面一致", () => {
+    expect(["build", "edit", "guarded", "yolo"].every(isSwitchableCollaborationMode)).toBe(true);
+    expect(isSwitchableCollaborationMode("plan")).toBe(false);
+    expect(isSwitchableCollaborationMode("auto")).toBe(false);
+  });
+});
