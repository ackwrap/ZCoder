+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import { ConversationTimeline } from "@/v4/ConversationTimeline.js";
+import { ConversationFocusModeTimeline } from "./FocusModeTimeline.js";
+import { buildFocusLogicalGroupsFromRows, selectFocusTimelineWindow } from "./focusGroups.js";
+
+/**
+ * Standard focus-mode projection: filter rows to the latest two logical groups,
+ * then hand the reduced row window to the existing ConversationTimeline.
+ */
+export function exampleFocusWindow(rows: readonly ConversationRow[]) {
+  const groups = buildFocusLogicalGroupsFromRows(rows);
+  return selectFocusTimelineWindow(groups, true);
+}
