@@ -0,0 +1,5 @@
+# header-subagent-directory
+
+为工作区头部提供当前会话的子智能体目录快捷入口。只发出一次目录打开意图，不持有列表状态、不请求模型或启动子智能体。
+
+当前会话与工作区范围由宿主注入，草稿或缺少回调时隐藏。现有侧栏管理器唯一拥有目录标签的创建、去重和激活；远程身份原样传递，不能退回本地默认工作区。
diff --git a/packages/ui/src/WorkspaceHeaderSections/subagent-directory/SubagentDirectoryButton.tsx b/packages/ui/src/WorkspaceHeaderSections/subagent-directory/SubagentDirectoryButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d6189435e48200fb124cccdc0b20a25795dd329e
--- /dev/null
+++ b/packages/ui/src/WorkspaceHeaderSections/subagent-directory/SubagentDirectoryButton.tsx
@@ -0,0 +1,46 @@
+import { ListTree } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { OpenScopedSubagentDirectorySideTabRequest } from "@/lib/workspaceSidePane.js";
+
+export function SubagentDirectoryButton({
+  sessionId,
+  workspacePath,
+  workspaceIdentity,
+  remoteSessionId,
+  onOpen,
+}: {
+  sessionId?: string | null;
+  workspacePath: string;
+  workspaceIdentity?: string;
+  remoteSessionId?: string;
+  onOpen?: (request: OpenScopedSubagentDirectorySideTabRequest) => void;
+}) {
+  const { intl } = useZCodeIntl();
+  if (!sessionId || !onOpen) return null;
+  const label = intl.formatMessage({ id: "subagentDirectory.title" });
+  return (
+    <ControlHintTooltip title={label} side="bottom">
+      <Button
+        type="button"
+        variant="ghost"
+        size="icon-md"
+        className="text-foreground hover:bg-hover hover:text-foreground [app-region:no-drag]"
+        aria-label={label}
+        data-testid="header-subagent-directory"
+        onClick={() =>
+          onOpen({
+            rootSessionId: sessionId,
+            parentSessionId: sessionId,
+            workspacePath,
+            workspaceIdentity,
+            remoteSessionId,
+          })
+        }
+      >
+        <ListTree className="size-4" />
+      </Button>
+    </ControlHintTooltip>
+  );
+}
