index 0000000000000000000000000000000000000000..de1d4dd89f36c9c40c41b62a27fb30925e027b24
--- /dev/null
+++ b/packages/ui/test/sessionFocusModePersistence.test.ts
@@ -0,0 +1,106 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  getSessionFocusModeEnabled,
+  resetSessionFocusModeStoreForTest,
+  resolveSessionFocusModeScopeKey,
+  setSessionFocusModeEnabled,
+  subscribeSessionFocusMode,
+} from "@/v4/focus-mode/contract.js";
+
+const scope = (workspaceIdentity: string, sessionId: string | null) =>
+  resolveSessionFocusModeScopeKey({ workspaceIdentity, sessionId });
+
+beforeEach(() => {
+  localStorage.clear();
+  resetSessionFocusModeStoreForTest();
+});
+afterEach(() => {
+  resetSessionFocusModeStoreForTest();
+  vi.restoreAllMocks();
+  localStorage.clear();
+});
+
+describe("focus mode persistence", () => {
+  it("restores only the exact workspace and session after renderer restart", () => {
+    const a = scope("workspace-a", "session-a");
+    setSessionFocusModeEnabled(a, true);
+    resetSessionFocusModeStoreForTest();
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+    expect(getSessionFocusModeEnabled(scope("workspace-a", "session-b"))).toBe(false);
+    expect(getSessionFocusModeEnabled(scope("workspace-b", "session-a"))).toBe(false);
+    setSessionFocusModeEnabled(a, false);
+    resetSessionFocusModeStoreForTest();
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+  });
+
+  it("never persists a draft or a session with no stable workspace", () => {
+    const draft = scope("workspace-a", null);
+    const unknown = scope("", "session-a");
+    setSessionFocusModeEnabled(draft, true);
+    setSessionFocusModeEnabled(unknown, true);
+    expect(localStorage.length).toBe(0);
+    resetSessionFocusModeStoreForTest();
+    expect(getSessionFocusModeEnabled(draft)).toBe(false);
+    expect(getSessionFocusModeEnabled(unknown)).toBe(false);
+    expect(getSessionFocusModeEnabled(scope("workspace-a", "draft"))).toBe(false);
+  });
+
+  it("reflects another window's writes and removal without affecting other sessions", () => {
+    const a = scope("workspace-a", "session-a");
+    const b = scope("workspace-a", "session-b");
+    setSessionFocusModeEnabled(a, true);
+    const key = localStorage.key(0)!;
+    const listener = vi.fn();
+    const unsubscribe = subscribeSessionFocusMode(listener);
+    localStorage.removeItem(key);
+    window.dispatchEvent(
+      new StorageEvent("storage", { key, newValue: null, storageArea: localStorage }),
+    );
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+    expect(getSessionFocusModeEnabled(b)).toBe(false);
+    expect(listener).toHaveBeenCalled();
+    localStorage.setItem(key, "1");
+    window.dispatchEvent(
+      new StorageEvent("storage", { key, newValue: "1", storageArea: localStorage }),
+    );
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+    unsubscribe();
+  });
+
+  it("invalidates cached preferences while no pane is subscribed", () => {
+    const a = scope("workspace-a", "session-a");
+    setSessionFocusModeEnabled(a, true);
+    const key = localStorage.key(0)!;
+    localStorage.setItem(key, "0");
+    window.dispatchEvent(
+      new StorageEvent("storage", { key, newValue: "0", storageArea: localStorage }),
+    );
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+  });
+
+  it("keeps the in-memory choice if reading fails but writing succeeds", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    const a = scope("workspace-a", "session-a");
+    setSessionFocusModeEnabled(a, true);
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+    setSessionFocusModeEnabled(a, false);
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+  });
+
+  it("keeps local state usable when storage access fails", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    const a = scope("workspace-a", "session-a");
+    setSessionFocusModeEnabled(a, true);
+    expect(getSessionFocusModeEnabled(a)).toBe(true);
+    setSessionFocusModeEnabled(a, false);
+    expect(getSessionFocusModeEnabled(a)).toBe(false);
+  });
+});
