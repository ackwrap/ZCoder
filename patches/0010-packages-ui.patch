@@ -0,0 +1,52 @@
+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+import {
+  buildExportFileName,
+  buildMarkdownTranscript,
+  type TranscriptEntry,
+} from "../transcript.js";
+
+export function createExportCommand(
+  entries: readonly TranscriptEntry[],
+  olderRowsAvailable: boolean,
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand {
+  const messages = getCompatMessages(locale);
+  return {
+    value: messages.export.value,
+    label: `/${messages.export.value}`,
+    description: messages.export.description,
+    keywords: messages.export.keywords,
+    run: () => {
+      if (entries.length === 0) {
+        notify(messages.exportEmpty);
+        return;
+      }
+      try {
+        const markdown = buildMarkdownTranscript(entries, {
+          untitled: messages.untitled,
+          userLabel: messages.userLabel,
+          assistantLabel: messages.assistantLabel,
+        });
+        const blob = new Blob([markdown], { type: "text/markdown;charset=utf-8" });
+        const url = URL.createObjectURL(blob);
+        const anchor = document.createElement("a");
+        anchor.href = url;
+        anchor.download = buildExportFileName(new Date());
+        anchor.rel = "noopener";
+        anchor.click();
+        // 立即 revoke 会让部分 Chromium 版本拿不到内容，等下载启动后再释放。
+        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+        notify(
+          olderRowsAvailable
+            ? messages.exportPartialSucceeded(entries.length)
+            : messages.exportSucceeded(entries.length),
+        );
+      } catch {
+        notify(messages.exportFailed);
+      }
+    },
+  };
+}
