+// @vitest-environment jsdom
+
+import { act, cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { ZCODE_AGENT_MCP_STATUS_MODE_UNSUPPORTED_ERROR_CODE } from "@zcode/services";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { isMcpStatusCommand } from "@/lib/mcpStatusCommand.js";
+import { useMcpStore } from "@/store/mcpStore.js";
+
+const listWorkspaceMcpServerStatuses = vi.fn(async () => ({ statuses: {} }));
+const openSettingsTab = vi.fn();
+vi.mock("@/store/TabStoreProvider.js", () => ({
+  useOptionalTabStore: (selector: (state: unknown) => unknown) => selector({ openSettingsTab }),
+}));
+
+vi.mock("@/hooks/useWorkspaceServices.js", () => ({
+  useBaseWorkspaceServices: () => ({
+    mcpSyncService: { listWorkspaceMcpServerStatuses },
+  }),
+}));
+
+import { McpStatusDialog } from "@/McpStatusDialog.js";
+
+beforeAll(() => {
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  );
+  Object.defineProperty(window, "matchMedia", {
+    configurable: true,
+    value: (query: string) => ({
+      matches: false,
+      media: query,
+      onchange: null,
+      addEventListener() {},
+      removeEventListener() {},
+      addListener() {},
+      removeListener() {},
+      dispatchEvent: () => false,
+    }),
+  });
+});
+
+afterEach(() => {
+  cleanup();
+});
+beforeEach(() => {
+  vi.clearAllMocks();
+  listWorkspaceMcpServerStatuses.mockResolvedValue({ statuses: {} });
+  useMcpStore.setState({
+    isConfigLoaded: true,
+    servers: [],
+    currentProjectPath: "/workspace",
+    currentWorkspaceIdentity: undefined,
+    currentAuthorityKey: undefined,
+  });
+});
+
+describe("isMcpStatusCommand", () => {
+  it("matches /mcp and its /mcps alias only", () => {
+    expect(isMcpStatusCommand("/mcp")).toBe(true);
+    expect(isMcpStatusCommand("/mcps")).toBe(true);
+    expect(isMcpStatusCommand("  /MCP  ")).toBe(true);
+    expect(isMcpStatusCommand("/mcp list")).toBe(false);
+    expect(isMcpStatusCommand("/mcps list")).toBe(false);
+    expect(isMcpStatusCommand("mcp")).toBe(false);
+  });
+});
+
+describe("McpStatusDialog", () => {
+  it("lists configured MCP servers with their status", () => {
+    useMcpStore.setState({
+      isConfigLoaded: true,
+      servers: [
+        {
+          id: "server-a",
+          name: "fixture-server",
+          enabled: true,
+          status: "connected",
+          toolCount: 3,
+          source: "zcode",
+          scope: "user",
+          config: { command: "node", args: ["server.js"] },
+        },
+      ],
+    } as never);
+
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(McpStatusDialog, {
+          open: true,
+          onOpenChange: vi.fn(),
+          workspacePath: "/workspace",
+        }),
+      ),
+    );
+
+    expect(view.getByTestId("mcp-status-dialog")).toBeTruthy();
+    expect(view.getByText("fixture-server")).toBeTruthy();
+    expect(view.getByText("已连接")).toBeTruthy();
+    expect(view.getByText("3 个工具")).toBeTruthy();
+    expect(listWorkspaceMcpServerStatuses).toHaveBeenCalledWith({
+      workspacePath: "/workspace",
+      mode: "status",
+    });
+  });
+
+  it("shows the empty state when no servers are configured", () => {
+    useMcpStore.setState({ isConfigLoaded: true, servers: [] } as never);
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(McpStatusDialog, {
+          open: true,
+          onOpenChange: vi.fn(),
+          workspacePath: "/workspace",
+        }),
+      ),
+    );
+    expect(view.getByText("当前工作区没有配置 MCP 服务器。")).toBeTruthy();
+  });
+
+  function dialog(open = true, workspacePath = "/workspace", workspaceIdentity?: string) {
+    return createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "zh-CN" },
+      createElement(McpStatusDialog, {
+        open,
+        onOpenChange: vi.fn(),
+        workspacePath,
+        workspaceIdentity,
+      }),
+    );
+  }
+
+  it("separates passive status refresh and explicit connection checks", async () => {
+    const view = render(dialog());
+    await waitFor(() =>
+      expect((view.getByText("连接检查") as HTMLButtonElement).disabled).toBe(false),
+    );
+    fireEvent.click(view.getByText("连接检查"));
+    await waitFor(() =>
+      expect(listWorkspaceMcpServerStatuses).toHaveBeenLastCalledWith({
+        workspacePath: "/workspace",
+        mode: "connect",
+      }),
+    );
+    await waitFor(() =>
+      expect((view.getByText("刷新状态") as HTMLButtonElement).disabled).toBe(false),
+    );
+    fireEvent.click(view.getByText("刷新状态"));
+    await waitFor(() =>
+      expect(listWorkspaceMcpServerStatuses).toHaveBeenLastCalledWith({
+        workspacePath: "/workspace",
+        mode: "status",
+      }),
+    );
+  });
+
+  it("does not silently connect when status mode is unsupported", async () => {
+    listWorkspaceMcpServerStatuses.mockRejectedValueOnce(
+      Object.assign(new Error("status-only unsupported"), {
+        code: ZCODE_AGENT_MCP_STATUS_MODE_UNSUPPORTED_ERROR_CODE,
+      }),
+    );
+    const view = render(dialog());
+    await waitFor(() =>
+      expect(view.getByRole("alert").textContent).toContain("不支持只读状态刷新"),
+    );
+    expect(listWorkspaceMcpServerStatuses).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["close", "workspace", "identity", "authority"])(
+    "ignores a delayed response after %s changes",
+    async (change) => {
+      const originalMerge = useMcpStore.getState().mergeServerStatusSnapshots;
+      const merge = vi.fn();
+      useMcpStore.setState({ mergeServerStatusSnapshots: merge });
+      let resolve!: (value: { statuses: Record<string, never> }) => void;
+      listWorkspaceMcpServerStatuses.mockImplementationOnce(
+        () =>
+          new Promise((done) => {
+            resolve = done;
+          }),
+      );
+      const view = render(dialog());
+      if (change === "authority") useMcpStore.setState({ currentAuthorityKey: "different-host" });
+      else
+        view.rerender(
+          dialog(
+            change !== "close",
+            change === "workspace" ? "/other" : "/workspace",
+            change === "identity" ? "remote-workspace" : undefined,
+          ),
+        );
+      await act(async () => {
+        resolve({ statuses: {} });
+      });
+      // 新 pane 等待 store 完成 scope 切换，不得把其响应写入旧 workspace。
+      expect(merge).not.toHaveBeenCalled();
+      useMcpStore.setState({ mergeServerStatusSnapshots: originalMerge });
+    },
+  );
+
+  it("shows zero tools and copies only the same redacted diagnostic body", async () => {
+    useMcpStore.setState({
+      servers: [
+        {
+          id: "diag",
+          name: "diag",
+          enabled: true,
+          status: "error",
+          source: "zcodeagentmcp",
+          scope: "user",
+          toolCount: 0,
+          failureKind: "network_unreachable",
+          error: "failed private-value",
+          config: { env: { KEY: "private-value" } },
+        },
+      ],
+    });
+    const writeText = vi.fn().mockResolvedValue(undefined);
+    Object.defineProperty(navigator, "clipboard", { configurable: true, value: { writeText } });
+    const view = render(dialog());
+    fireEvent.click(view.getByText("诊断详情"));
+    expect(view.getByText("0 个工具")).toBeTruthy();
+    expect(view.container.textContent).not.toContain("private-value");
+    fireEvent.click(view.getByText("复制诊断"));
+    await waitFor(() => expect(view.getByRole("status").textContent).toBe("诊断已复制。"));
+    expect(writeText).toHaveBeenCalledWith(
+      view.getByTestId("mcp-diagnostics-diag").querySelector("pre")!.textContent,
+    );
+    writeText.mockRejectedValueOnce(new Error("clipboard denied"));
+    fireEvent.click(view.getByText("复制诊断"));
+    await waitFor(() => expect(view.getByRole("status").textContent).toContain("复制失败"));
+  });
+
+  it("hides another workspace's configuration and waits for the matching store", async () => {
+    useMcpStore.setState({
+      currentProjectPath: "/other",
+      servers: [
+        {
+          id: "other",
+          name: "other-workspace",
+          source: "zcodeagentmcp",
+          scope: "user",
+          config: {},
+          enabled: true,
+        },
+      ],
+    });
+    const view = render(dialog());
+    expect(view.queryByText("other-workspace")).toBeNull();
+    expect(listWorkspaceMcpServerStatuses).not.toHaveBeenCalled();
+    await act(async () => {
+      useMcpStore.setState({ currentProjectPath: "/workspace", servers: [] });
+    });
+    await waitFor(() => expect(listWorkspaceMcpServerStatuses).toHaveBeenCalledOnce());
+  });
+
+  it("opens the existing MCP settings entry", () => {
+    const onOpenChange = vi.fn();
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(McpStatusDialog, { open: true, onOpenChange, workspacePath: "/workspace" }),
+      ),
+    );
+    fireEvent.click(view.getByText("打开 MCP 设置"));
+    expect(onOpenChange).toHaveBeenCalledWith(false);
+    expect(openSettingsTab).toHaveBeenCalledOnce();
+  });
+});
