+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/session-resources.fixture.tsx";
+let server, browser, origin;
+before(async () => {
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      react(),
+      tailwindcss(),
+      {
+        name: "session-resources-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0 },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+for (const width of [320, 1200])
+  for (const locale of ["zh-CN", "en-US"])
+    for (const theme of ["light", "dark"]) {
+      test(`session resource controls ${width}/${locale}/${theme}`, async () => {
+        const page = await browser.newPage({ viewport: { width, height: 800 } });
+        const errors = [];
+        page.setDefaultTimeout(30000);
+        page.on("pageerror", (error) => errors.push(String(error)));
+        try {
+          await page.goto(
+            `${origin}fixture?${new URLSearchParams({ locale, theme, narrow: String(width === 320) })}`,
+            { timeout: 60000, waitUntil: "domcontentloaded" },
+          );
+          const panel = page.getByTestId("chat-summary-panel");
+          await panel.waitFor();
+          const controls = page.getByTestId("session-resource-controls");
+          await controls.waitFor();
+          const skill = controls.locator('[data-resource-group="skill"]').getByRole("switch");
+          await skill.waitFor();
+          await page.waitForFunction(
+            () =>
+              document
+                .querySelector('[data-testid="session-resource-controls"]')
+                ?.getAttribute("aria-busy") === "false",
+          );
+          assert.equal(await skill.getAttribute("aria-checked"), "true");
+          await skill.click();
+          await page.waitForFunction(
+            () =>
+              document.querySelector('[role="switch"]')?.getAttribute("aria-checked") === "false",
+          );
+          await skill.focus();
+          await page.keyboard.press("Space");
+          await page.waitForFunction(
+            () =>
+              document.querySelector('[role="switch"]')?.getAttribute("aria-checked") === "true",
+          );
+          const mcp = controls.getByRole("switch").nth(1);
+          await mcp.click();
+          assert.equal(await mcp.getAttribute("aria-checked"), "false");
+          assert.equal(await controls.getByRole("switch").nth(2).isDisabled(), true);
+          const group = controls.locator('[data-resource-group="skill"]');
+          await group.getByRole("button").click();
+          await skill.waitFor({ state: "hidden" });
+          await group.getByRole("button").click();
+          await skill.waitFor();
+          await page.getByTestId("fixture-fail").click();
+          await controls.getByRole("alert").waitFor();
+          assert.ok(!(await controls.textContent()).includes("private-service-error"));
+          assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
+          const bounds = await panel.boundingBox();
+          assert.ok(bounds.x >= 0 && bounds.x + bounds.width <= width + 1);
+          assert.deepEqual(errors, []);
+        } catch (error) {
+          console.error(
+            "session resource fixture failure",
+            String(error),
+            await page.locator("body").innerText(),
+          );
+          throw error;
+        } finally {
+          await page.close();
+        }
+      });
+    }
