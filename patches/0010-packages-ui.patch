+import { describe, expect, it, vi } from "vitest";
+import {
+  dispatchPreviewSource,
+  isCommandOutputLogPath,
+  resolveReadPreviewTarget,
+} from "./contract.js";
+import { commandOutputFilePreviewModule } from "./module.js";
+
+describe("command-output-file-preview contract", () => {
+  it("declares its module manifest", () => {
+    expect(commandOutputFilePreviewModule.id).toBe("command-output-file-preview-ui");
+  });
+
+  it.each([
+    "C:\\Users\\xb\\AppData\\Local\\Temp\\zcode-bash-8E7j1G\\sess_subagent_agent_1\\call_1552b967195849bd9d65479bfdd51130-stdout.log",
+    "C:/Users/xb/AppData/Local/Temp/zcode-bash-8E7j1G/sess_subagent_agent_1/call_1552-stderr.log",
+    "/tmp/zcode-bash-abc123/session_1/exec_bg-stdout.log",
+    "/var/folders/x/zcode-bash-ABC/session/call_1-stdout.log",
+  ])("recognizes official bash output path %s", (path) => {
+    expect(isCommandOutputLogPath(path)).toBe(true);
+  });
+
+  it.each([
+    "/workspace/src/logger.ts",
+    "/workspace/logs/call_1-stdout.log",
+    "/workspace/zcode-bash-abc123/session/other.log",
+    "/workspace/zcode-bash-abc123/session/call_1-stdout.log.bak",
+    "/tmp/not-zcode-bash/session/call_1-stdout.log",
+    "/tmp/zcode-bash-abc123/call_1-stdout.log",
+    "/tmp/zcode-bash-abc123/session/nested/call_1-stdout.log",
+    "",
+    null,
+  ])("rejects non command-output path %s", (path) => {
+    expect(isCommandOutputLogPath(path)).toBe(false);
+  });
+
+  it("routes normal files to the existing code viewer", () => {
+    expect(
+      resolveReadPreviewTarget({
+        entryType: "file",
+        path: "/workspace/src/logger.ts",
+        hasCommandOutputPreview: true,
+        hasCodeViewer: true,
+      }),
+    ).toBe("code-viewer");
+  });
+
+  it("routes official command output to the dialog and falls back when the host is old", () => {
+    const path = "/tmp/zcode-bash-abc123/session/call_1-stdout.log";
+    expect(
+      resolveReadPreviewTarget({
+        entryType: "file",
+        path,
+        hasCommandOutputPreview: true,
+        hasCodeViewer: true,
+      }),
+    ).toBe("command-output-dialog");
+    expect(
+      resolveReadPreviewTarget({
+        entryType: "file",
+        path,
+        hasCommandOutputPreview: false,
+        hasCodeViewer: true,
+      }),
+    ).toBe("code-viewer");
+  });
+
+  it("never previews directories", () => {
+    expect(
+      resolveReadPreviewTarget({
+        entryType: "directory",
+        path: "/tmp/zcode-bash-abc123/session/call_1-stdout.log",
+        hasCommandOutputPreview: true,
+        hasCodeViewer: true,
+      }),
+    ).toBeNull();
+  });
+
+  // 嵌套分组/子代理行只转发旧 onOpenCodeViewer；宿主在这里统一分派，
+  // 命令输出日志才不会回落到右侧栏。
+  describe("dispatchPreviewSource", () => {
+    it("routes command output opened through the code viewer callback to the dialog", () => {
+      const openCommandOutputPreview = vi.fn();
+      const openCodeViewer = vi.fn();
+      const source = {
+        type: "file" as const,
+        title: "call_1-stdout.log",
+        path: "/tmp/zcode-bash-abc123/session/call_1-stdout.log",
+      };
+
+      expect(dispatchPreviewSource(source, { openCommandOutputPreview, openCodeViewer })).toBe(
+        "dialog",
+      );
+      expect(openCommandOutputPreview).toHaveBeenCalledWith({
+        path: source.path,
+        title: source.title,
+      });
+      expect(openCodeViewer).not.toHaveBeenCalled();
+    });
+
+    it("keeps normal files and non-file sources on the existing viewer", () => {
+      const openCommandOutputPreview = vi.fn();
+      const openCodeViewer = vi.fn();
+
+      dispatchPreviewSource(
+        { type: "file", title: "logger.ts", path: "/workspace/src/logger.ts" },
+        { openCommandOutputPreview, openCodeViewer },
+      );
+      dispatchPreviewSource(
+        { type: "text", title: "diff", content: "+a", language: "typescript" },
+        { openCommandOutputPreview, openCodeViewer },
+      );
+
+      expect(openCommandOutputPreview).not.toHaveBeenCalled();
+      expect(openCodeViewer).toHaveBeenCalledTimes(2);
+    });
+
+    it("falls back to the viewer when the host has no dialog entry", () => {
+      const openCodeViewer = vi.fn();
+      expect(
+        dispatchPreviewSource(
+          {
+            type: "file",
+            title: "call_1-stdout.log",
+            path: "/tmp/zcode-bash-abc123/session/call_1-stdout.log",
+          },
+          { openCodeViewer },
+        ),
