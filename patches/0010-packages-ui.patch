+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0, hmr: false, watch: null },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+
+after(async () => {
+  server?.httpServer?.closeAllConnections();
+  await Promise.all([browser?.close(), server?.close(), server?.watcher?.close()]);
+  if (cacheDir) await rm(cacheDir, { recursive: true, force: true });
+});
+
+async function waitForCompact(page, compact) {
+  await page.waitForFunction(
+    (expected) =>
+      document
+        .querySelector('[data-status-capsule="true"]')
+        ?.getAttribute("data-status-capsule-compact") === (expected ? "true" : "false"),
+    compact,
+  );
+  await page.waitForFunction((expected) => {
+    const metric = document.querySelector('[data-status-capsule="true"]');
+    if (!metric) return false;
+    const style = getComputedStyle(metric);
+    return (
+      style.paddingLeft === (expected ? "0px" : "8px") &&
+      style.paddingRight === (expected ? "0px" : "12px")
+    );
+  }, compact);
+}
+
+async function waitForVariant(page, variant) {
+  await page.waitForFunction(
+    (expected) => document.querySelector('[data-testid="variant"]')?.textContent === expected,
+    variant,
+  );
+}
+
+for (const variant of ["mini", "auto"])
+  for (const theme of ["light", "dark"])
+    for (const width of [390, 1200]) {
+      test(`status capsule compacts with the side pane ${variant}/${theme}/${width}`, async () => {
+        const page = await browser.newPage({ viewport: { width, height: 800 } });
+        const errors = [];
+        page.on("pageerror", (error) => errors.push(String(error)));
+        try {
+          await page.goto(`${origin}fixture?${new URLSearchParams({ theme, variant }).toString()}`);
+          const capsule = page.locator('[data-status-capsule="true"]');
+          const content = capsule.locator('[data-status-capsule-content="true"]');
+          const expand = page.getByRole("button", { name: "Expand status" });
+          const aside = page.getByTestId("chat-summary-panel");
+          try {
+            await capsule.waitFor({ timeout: 10000 });
+            await expand.waitFor({ timeout: 10000 });
+          } catch (error) {
+            console.error(
+              JSON.stringify(
+                await page.evaluate(() => {
+                  const metric = document.querySelector('[data-status-capsule="true"]');
+                  const chain = [];
+                  for (let node = metric; node && chain.length < 8; node = node.parentElement) {
+                    const style = getComputedStyle(node);
+                    chain.push({
+                      tag: node.tagName,
+                      class: node.className,
+                      display: style.display,
+                      visibility: style.visibility,
+                      width: style.width,
+                      height: style.height,
+                      containerName: style.containerName,
+                      containerType: style.containerType,
+                    });
+                  }
+                  return chain;
+                }),
+              ),
+              errors,
+            );
+            throw error;
+          }
+          await page.evaluate(() => document.fonts.ready);
+
+          const fullText = await content.textContent();
+          assert.match(fullText, /\+4286/);
+          assert.match(fullText, /-1678/);
+          const closedBox = await capsule.boundingBox();
+          assert.ok(closedBox && closedBox.width > 70, "full capsule has a summary width");
+          assert.equal(await page.getByTestId("mount-count").textContent(), "1");
+
+          // Side pane opens -> icon-only capsule.
+          await page.getByTestId("toggle-side-pane").click();
+          await waitForCompact(page, true);
+          assert.equal(await page.getByTestId("side-pane-state").textContent(), "open");
+          const compactBox = await capsule.boundingBox();
+          assert.ok(
+            compactBox && compactBox.width >= 30 && compactBox.width <= 36,
+            `compact capsule is icon-sized (got ${compactBox?.width})`,
+          );
+          assert.ok(
+            compactBox && compactBox.height >= 30 && compactBox.height <= 34,
+            `compact capsule keeps the 32px control height (got ${compactBox?.height})`,
+          );
+          assert.equal(await expand.getAttribute("aria-label"), "Expand status");
+          const accessible = await expand.ariaSnapshot();
+          const describedSummary = await expand.evaluate((button) =>
+            (button.getAttribute("aria-describedby") ?? "")
+              .split(/\s+/)
+              .map((id) => document.getElementById(id)?.textContent ?? "")
+              .join(" "),
+          );
+          assert.match(describedSummary, /\+4286.*-1678/);
+          assert.match(accessible, /Expand status/);
+          assert.equal(await page.getByTestId("mount-count").textContent(), "1");
+          assert.match(await content.textContent(), /\+4286/);
+          assert.match(await content.textContent(), /-1678/);
+
+          // Hover still reveals the maximize affordance inside the icon slot.
+          await expand.hover();
+          await page.waitForFunction(() => {
+            const icons = document.querySelectorAll("[data-status-capsule-icon] svg");
+            return icons.length >= 2 && getComputedStyle(icons[1]).opacity === "1";
+          });
+
+          // Close -> the exact previous summary width returns.
+          await page.getByTestId("toggle-side-pane").click();
+          await waitForCompact(page, false);
+          const restoredBox = await capsule.boundingBox();
+          assert.ok(
+            restoredBox && Math.abs(restoredBox.width - closedBox.width) <= 1.5,
+            `full capsule width is restored (${closedBox.width} -> ${restoredBox?.width})`,
+          );
+          assert.match(await content.textContent(), /\+4286/);
+          assert.match(await content.textContent(), /-1678/);
+          assert.equal(await page.getByTestId("mount-count").textContent(), "1");
+
+          // Reopen -> compact again; repeated toggles stay stable.
+          await page.getByTestId("toggle-side-pane").click();
+          await waitForCompact(page, true);
+          const secondCompactBox = await capsule.boundingBox();
+          assert.ok(
+            secondCompactBox &&
+              compactBox &&
+              Math.abs(secondCompactBox.width - compactBox.width) <= 1.5,
+          );
+          assert.equal(await page.getByTestId("mount-count").textContent(), "1");
+
+          // Mouse expand from the compact capsule still pins the full panel.
+          await expand.click();
+          await waitForVariant(page, "panel");
+          assert.equal(await aside.getAttribute("data-state"), "expanded");
+          assert.equal(await page.getByTestId("variant-changes").textContent(), "1");
+
+          // Keyboard expand works too, and the pinned panel survives side-pane toggles.
+          await page.getByTestId("reset-variant").click();
+          await waitForVariant(page, variant);
+          await expand.focus();
+          await page.keyboard.press("Enter");
+          await waitForVariant(page, "panel");
+          assert.equal(await page.getByTestId("variant-changes").textContent(), "2");
+          assert.equal(await aside.getAttribute("data-state"), "expanded");
+          await page.getByTestId("toggle-side-pane").click();
+          assert.equal(await page.getByTestId("side-pane-state").textContent(), "closed");
+          assert.equal(await aside.getAttribute("data-state"), "expanded");
+          await page.getByTestId("toggle-side-pane").click();
+          assert.equal(await page.getByTestId("side-pane-state").textContent(), "open");
+          assert.equal(await aside.getAttribute("data-state"), "expanded");
+          assert.equal(await page.getByTestId("mount-count").textContent(), "1");
+
+          assert.deepEqual(errors, []);
+        } finally {
+          await page.close();
+        }
+      });
+    }
