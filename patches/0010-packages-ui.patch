+import type { CompactionProfile } from "@zcode/shared";
+
+export interface TitleGenerationModelRef {
+  providerId: string;
+  modelId: string;
+}
+
+/** Accepted values belong to the injected settings owner, never to this UI. */
+export interface CompactionSettings {
+  compactionProfile?: CompactionProfile;
+  compactionTailBudgetTokens?: number;
+  compactionSummaryMaxOutputTokens?: number;
+  /** 缺席 = 继承会话当前模型。 */
+  titleGenerationModel?: TitleGenerationModelRef;
+}
+export type CompactionSettingsPatch = Omit<Partial<CompactionSettings>, "titleGenerationModel"> & {
+  /** 两个字段都为空 = 「继承会话模型」，由 Host 的 normalizeSettingsPatch 归一成删除。 */
+  titleGenerationModel?: TitleGenerationModelRef;
+};
+export interface CompactionSettingsSectionProps {
+  settings?: CompactionSettings | null;
+  /** Resolve after the existing save/sync/broadcast path; reject to show a retryable error. */
+  onUpdateSettings: (patch: CompactionSettingsPatch) => Promise<void>;
+}
