+      fireEvent.keyDown(input, { key: "Enter" });
+    });
+    expect(onTailChange).toHaveBeenLastCalledWith(100_000);
+  });
+
+  it("越界或非整数预算不提交，并显示范围错误", async () => {
+    const onTailChange = vi.fn(async (_tokens: number) => {});
