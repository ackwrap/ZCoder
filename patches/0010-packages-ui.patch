+import { promoteModelSystemPromptDraftFlag } from "./storage.js";
+
+/** 只进 pending clientContext 的可序列化 promotion receipt。 */
+export interface ModelSystemPromptPromotionReceipt {
+  readonly version: 1;
+  readonly workspacePath: string;
+  readonly workspaceIdentity?: string;
+  readonly draftOwnerKey: string;
+  readonly enabled: boolean;
+  readonly revision: number;
+  /** 已迁移标记：重复 ACK/query/snapshot 不得覆盖目标后来的手动 toggle。 */
+  readonly applied?: boolean;
+}
+
+interface PromotionEntryLike {
+  sessionId: string | null;
+  clientContext?: {
+    workspace?: {
+      workspacePath: string;
+      workspaceIdentity?: string;
+    };
+    modelSystemPromptPromotion?: ModelSystemPromptPromotionReceipt;
+  };
+}
+
+export function isModelSystemPromptPromotionReceipt(
+  value: unknown,
+): value is ModelSystemPromptPromotionReceipt {
+  if (!value || typeof value !== "object") return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    candidate.version === 1 &&
+    typeof candidate.workspacePath === "string" &&
+    candidate.workspacePath.trim().length > 0 &&
+    (candidate.workspaceIdentity === undefined ||
+      typeof candidate.workspaceIdentity === "string") &&
+    typeof candidate.draftOwnerKey === "string" &&
+    candidate.draftOwnerKey.trim().length > 0 &&
+    typeof candidate.enabled === "boolean" &&
+    typeof candidate.revision === "number" &&
+    Number.isSafeInteger(candidate.revision) &&
+    candidate.revision >= 0 &&
+    (candidate.applied === undefined || typeof candidate.applied === "boolean")
+  );
+}
+
+/**
+ * 真实 accepted 边界调用（applyAck/applyQuery/reconcileSnapshot 的 acceptComposer）。
+ * 只消费 receipt 中冻结的 workspace/owner/intent；目标 session 使用 remap 后的 entry.sessionId。
+ * 返回 true 表示本次写入了目标并标记 applied（调用方负责持久化）。
+ */
+export function acceptModelSystemPromptPromotion(entry: PromotionEntryLike): boolean {
+  const receipt = entry.clientContext?.modelSystemPromptPromotion;
+  if (!isModelSystemPromptPromotionReceipt(receipt) || receipt.applied) return false;
+  const targetSessionId = entry.sessionId?.trim();
+  if (!targetSessionId) return false;
+  const applied = promoteModelSystemPromptDraftFlag({
+    binding: {
+      workspacePath: receipt.workspacePath,
+      workspaceIdentity: receipt.workspaceIdentity,
+      draftOwnerKey: receipt.draftOwnerKey,
+      enabled: receipt.enabled,
+      revision: receipt.revision,
+    },
+    targetSessionId,
+  });
+  if (!applied) return false;
+  entry.clientContext!.modelSystemPromptPromotion = { ...receipt, applied: true };
+  return true;
+}
