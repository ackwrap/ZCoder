+import {
+  normalizeModelSystemPromptText,
+  resolveModelSystemPromptEntry,
+  type ModelSystemPromptEntry,
+} from "@zcode/shared";
+import type { ModelSystemPromptPromotionReceipt } from "./promotion.js";
+
+/** 随 Submission 透传给运行时的最小字段；关闭/无匹配时显式 false 且不带 entry。 */
+export interface ModelSystemPromptSubmissionFields {
+  modelSystemPromptEnabled: boolean;
+  modelSystemPrompt?: ModelSystemPromptEntry;
+}
+
+export interface ModelSystemPromptSelection {
+  providerId: string;
+  modelId: string;
+}
+
+export interface ModelSystemPromptSubmissionInput {
+  entries: readonly ModelSystemPromptEntry[] | undefined | null;
+  enabled: boolean;
+  selection: ModelSystemPromptSelection | null | undefined;
+}
+
+/**
+ * Host capability 门控：旧 Host 未声明 `modelSystemPrompt` 时必须完全省略字段，
+ * 不能发送显式 false 触发旧 schema 拒绝。
+ */
+export function resolveModelSystemPromptSubmissionForHost(
+  params: ModelSystemPromptSubmissionInput & { hostSupported: boolean },
+): ModelSystemPromptSubmissionFields | undefined {
+  if (!params.hostSupported) return undefined;
+  return resolveModelSystemPromptSubmission(params);
+}
+
+/**
+ * 只解析当前选择的一份条目：不读取历史、不 append。显式关闭或目标无配置时返回
+ * `modelSystemPromptEnabled: false`，不携带 `modelSystemPrompt`。
+ */
+export function resolveModelSystemPromptSubmission(
+  params: ModelSystemPromptSubmissionInput,
+): ModelSystemPromptSubmissionFields {
+  if (!params.enabled || !params.selection) {
+    return { modelSystemPromptEnabled: false };
+  }
+  const entry = resolveModelSystemPromptEntry(params.entries ?? undefined, params.selection);
+  if (!entry) return { modelSystemPromptEnabled: false };
+  const text = normalizeModelSystemPromptText(entry.text);
+  if (!text) return { modelSystemPromptEnabled: false };
+  return {
+    modelSystemPromptEnabled: true,
+    modelSystemPrompt: Object.freeze({
+      providerId: entry.providerId,
+      modelId: entry.modelId,
+      text,
+    }),
+  };
+}
+
+/** 提交时冻结的原始开关意图 + 设置配置快照，用于推荐换模后重新解析。 */
+export interface FrozenModelSystemPrompt {
+  readonly enabled: boolean;
+  readonly entries: readonly ModelSystemPromptEntry[];
+  /** 草稿首发才有的 promotion receipt；真实 Session 不带。 */
+  readonly promotion?: ModelSystemPromptPromotionReceipt;
+}
+
+const frozenBySubmission = new WeakMap<object, FrozenModelSystemPrompt>();
+
+export function freezeModelSystemPromptEntries(
+  entries: readonly ModelSystemPromptEntry[] | null | undefined,
+): readonly ModelSystemPromptEntry[] {
+  return Object.freeze((entries ?? []).map((entry) => Object.freeze({ ...entry })));
+}
+
+export function rememberFrozenModelSystemPrompt(
+  submission: object,
+  frozen: FrozenModelSystemPrompt,
+): void {
+  frozenBySubmission.set(submission, frozen);
+}
+
+/** 推荐路径只读提交时冻结的数据；不得重新读取当前 toggle/settings。 */
+export function readFrozenModelSystemPrompt(
+  submission: object,
+): FrozenModelSystemPrompt | undefined {
+  return frozenBySubmission.get(submission);
+}
+
+/** 供 pending clientContext 使用；不含 config 文本，只含可序列化 owner/intent。 */
+export function readModelSystemPromptPromotionReceipt(
+  submission: object,
+): ModelSystemPromptPromotionReceipt | undefined {
+  return frozenBySubmission.get(submission)?.promotion;
+}
+
+/**
+ * 把字段冻结进本次 Submission 副本。旧字段先显式剥离，避免 true/A → false/B 或无
+ * capability 时把历史 `modelSystemPrompt` 残留到 payload。
+ */
+export function attachModelSystemPromptToSubmission<T extends object>(
+  submission: T,
+  fields: ModelSystemPromptSubmissionFields,
+): T & ModelSystemPromptSubmissionFields {
+  const {
+    modelSystemPrompt: _previousPrompt,
+    modelSystemPromptEnabled: _previousEnabled,
+    ...rest
+  } = submission as T & {
+    modelSystemPrompt?: ModelSystemPromptEntry;
+    modelSystemPromptEnabled?: boolean;
+  };
+  return Object.freeze({
+    ...rest,
+    modelSystemPromptEnabled: fields.modelSystemPromptEnabled,
+    ...(fields.modelSystemPrompt
+      ? { modelSystemPrompt: Object.freeze({ ...fields.modelSystemPrompt }) }
+      : {}),
+  }) as T & ModelSystemPromptSubmissionFields;
+}
