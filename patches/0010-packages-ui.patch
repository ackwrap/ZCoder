@@ -0,0 +1,243 @@
+import { type ReactNode } from "react";
+import { FileDiffIcon, GitBranchIcon } from "lucide-react";
+import type {
+  GitChangeSourceId,
+  GitRepositorySummary,
+  ZCodeTaskChangeSummary,
+} from "@zcode/shared";
+import type { SessionUsageState } from "@zcode/shared/zcode-protocol-v4";
+import { Progress } from "@/components/ui/progress.js";
+import { GitActionMenu } from "@/GitActionMenu.js";
+import { GitBranchSwitcher } from "@/GitBranchSwitcher.js";
+import { useProviderSettingsView } from "@/hooks/useProviderSettingsView.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { formatCompactTokenNumber } from "@/lib/tokenNumberFormat.js";
+import { ContextDiagnostics } from "./ContextDiagnostics.js";
+import { InspectorCard } from "./InspectorCard.js";
+import {
+  buildContextUsageBreakdownSegments,
+  formatContextCacheHitRateLabel,
+  selectConfiguredContext,
+} from "./projection.js";
+
+const SOURCE_LABELS = {
+  messages: "chat.contextUsage.breakdown.messages",
+  system_prompt: "chat.contextUsage.breakdown.systemPrompt",
+  meta_user_context: "chat.contextUsage.breakdown.metaUserContext",
+  skills: "chat.contextUsage.breakdown.skills",
+  tool_prompt: "chat.contextUsage.breakdown.toolPrompt",
+  system_tool_schemas: "chat.contextUsage.breakdown.systemTools",
+  mcp_tool_schemas: "chat.contextUsage.breakdown.mcpTools",
+} as const;
+
+export interface SessionInspectorProps {
+  workspacePath: string;
+  remote?: boolean;
+  workspaceIdentity?: string;
+  usage?: SessionUsageState["contextWindow"];
+  selection?: { provider: string; model: string } | null;
+  resources?: ReactNode;
+  gitSummary?: GitRepositorySummary | null;
+  dirtyFileCount?: number;
+  changeSummary?: { added: number; removed: number } | null;
+  activeTaskChangeSummary?: ZCodeTaskChangeSummary | null;
+  reviewSourceId?: GitChangeSourceId | null;
+  onRefreshGit?: () => void;
+  onOpenGitReview?: (sourceId?: GitChangeSourceId) => void;
+  readOnly?: boolean;
+}
+
+export function SessionInspector({
+  workspacePath,
+  remote = false,
+  workspaceIdentity,
+  usage,
+  selection = null,
+  resources,
+  gitSummary,
+  dirtyFileCount = 0,
+  changeSummary,
+  activeTaskChangeSummary,
+  reviewSourceId,
+  onRefreshGit,
+  onOpenGitReview,
+  readOnly = false,
+}: SessionInspectorProps) {
+  const { intl, locale } = useZCodeIntl();
+  const label = (id: string) => intl.formatMessage({ id });
+  const tokens = (value: number) => formatCompactTokenNumber(locale, value);
+  const percent = (value: number) =>
+    new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 1 }).format(value);
+  const providerRead = useProviderSettingsView();
+  const configured = selectConfiguredContext(
+    !remote && providerRead.state.status === "ready" ? providerRead.state.view : null,
+    selection,
+  );
+  const validUsage =
+    usage &&
+    Number.isFinite(usage.usedTokens) &&
+    usage.usedTokens > 0 &&
+    Number.isFinite(usage.maxTokens) &&
+    usage.maxTokens > 0
+      ? usage
+      : null;
+  const ratio = validUsage ? Math.min(validUsage.usedTokens / validUsage.maxTokens, 1) : 0;
+  const breakdown = buildContextUsageBreakdownSegments(validUsage?.breakdown);
+  // 信息栏是诊断视图：命中率只要 provider 上报就如实显示，套用工具栏 78% 阈值会掩盖低命中。
+  const cacheHitRate = formatContextCacheHitRateLabel(validUsage?.cache?.hitRate, locale, {
+    showBelowThreshold: true,
+  });
+  const isRepository = Boolean(gitSummary?.isGitAvailable && gitSummary.isRepository);
+  return (
