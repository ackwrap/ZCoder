+import type { ModelSelection } from "@zcode/shared";
+
+export type { ModelSelection };
+
+/**
+ * 会话待用模型意图的生命周期：
+ * - pending：用户显式选择但会话权威投影尚未确认，恢复时压过快照与正文草稿；
+ * - confirmed：该选择已被会话事实接纳，只作为已确认副本，恢复时让位给最新权威值。
+ */
+export type ModelSelectionIntentState = "pending" | "confirmed";
+
+/** 一条会话级模型意图；version 是旧 ACK 条件写入的令牌。 */
+export interface ModelSelectionIntentRecord {
+  readonly version: string;
+  readonly state: ModelSelectionIntentState;
+  readonly selection: ModelSelection;
+}
+
+export interface ModelSelectionIntentScope {
+  readonly workspacePath: string;
+  readonly workspaceIdentity?: string;
+  readonly sessionId: string;
+}
