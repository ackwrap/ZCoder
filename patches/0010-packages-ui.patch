+    expect(formatTokenCount(200000)).toBe("200k");
+  });
+
+  it("promotes rounding boundaries to millions", () => {
+    expect(formatTokenCount(999_499)).toBe("999k");
+    expect(formatTokenCount(999_500)).toBe("1m");
