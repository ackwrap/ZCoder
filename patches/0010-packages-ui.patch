diff --git a/packages/ui/src/lib/mcpStatusCommand.ts b/packages/ui/src/lib/mcpStatusCommand.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6071d27feddecc28228c078ef4b40c6953ebaf3e
--- /dev/null
+++ b/packages/ui/src/lib/mcpStatusCommand.ts
@@ -0,0 +1,9 @@
+const MCP_STATUS_COMMAND_PATTERN = /^\/(?:mcp|mcps)\s*$/iu;
+
+/**
+ * `/mcp`（别名 `/mcps`）是 Composer 本地命令：只打开 MCP 状态面板，
+ * 不写入会话、不发给模型。与 `/side` 一样属于 UI 行为，不进入 CLI 命令目录。
+ */
+export function isMcpStatusCommand(text: string): boolean {
+  return MCP_STATUS_COMMAND_PATTERN.test(text.trim());
+}
