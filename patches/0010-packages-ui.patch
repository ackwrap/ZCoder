+import { createRoot } from "react-dom/client";
+import { TooltipProvider } from "@/components/ui/tooltip.js";
+import { MessageResponse } from "@/components/ai-elements/message.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+import "@/styles.css";
+
+const query = new URLSearchParams(location.search);
+const mobile = query.get("mobile") === "true";
+const theme = query.get("theme") === "light" ? "light" : "dark";
+document.documentElement.className = `${theme} theme-zai-${theme}`;
+
+// 覆盖全部受 Spacing 规格约束的块类型，断言才能逐项对上规格表。
+const markdown = [
+  "## 标题二",
+  "",
+  "第一段正文，用来量正文行高与字距。",
+  "",
+  "第二段正文，用来量块与块之间的间距。",
+  "",
+  "- 无序项一",
+  "- 无序项二",
+  "",
+  "1. 有序项一",
+  "2. 有序项二",
+  "",
+  "```ts",
+  "const a = 1;",
+  "```",
+  "",
+  "> 引用块正文。",
+].join("\n");
+
+createRoot(document.getElementById("root")!).render(
+  <TooltipProvider>
+    <ZCodeIntlProvider initialLocale={mobile ? "en-US" : "zh-CN"}>
+      <main className="min-h-dvh bg-background text-foreground">
+        <div data-testid="density-root" className="mx-auto w-[720px] max-w-full p-2">
+          <MessageResponse
+            theme={theme}
+            codePreviewSettings={DEFAULT_CODE_PREVIEW_SETTINGS}
+            streaming={false}
+          >
+            {markdown}
+          </MessageResponse>
+        </div>
+      </main>
+    </ZCodeIntlProvider>
+  </TooltipProvider>,
+);
diff --git a/packages/ui/test/browser/manual-review/pending/markdown-density.test.mjs b/packages/ui/test/browser/manual-review/pending/markdown-density.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1311cfafb4081a3535ac46961dcdc21c079f3d78
--- /dev/null
+++ b/packages/ui/test/browser/manual-review/pending/markdown-density.test.mjs
@@ -0,0 +1,168 @@
+// 正文紧凑度：规格见 docs/assistant-message-markdown-type-scale.md「Spacing」。
+// 用真实 MessageResponse + 真实样式量计算值，避免断言停留在 class 字符串上。
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/markdown-density.fixture.tsx";
+const artifacts = join(root, "packages/desktop/.e2e-artifacts/markdown-density");
+let server, browser, origin;
+
+before(async () => {
+  await mkdir(artifacts, { recursive: true });
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      {
+        name: "markdown-density-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+      react(),
+      tailwindcss(),
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: {
+      host: "127.0.0.1",
+      port: 0,
+      hmr: false,
+      watch: { ignored: ["**/packages/desktop/out/**", "**/.e2e-artifacts/**"] },
+    },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+
+const px = (value) => Number.parseFloat(value);
+const box = (element) => element.evaluate((node) => getComputedStyle(node));
+
+for (const mobile of [false, true])
+  for (const theme of ["light", "dark"]) {
+    test(`正文紧凑度 ${mobile ? "mobile" : "desktop"}/${theme}`, async () => {
+      const page = await browser.newPage({
+        viewport: { width: mobile ? 390 : 1200, height: 900 },
+        isMobile: mobile,
+        hasTouch: mobile,
+      });
+      const errors = [];
+      page.on("pageerror", (error) => errors.push(String(error)));
+      try {
+        await page.goto(`${origin}fixture?mobile=${mobile}&theme=${theme}`);
+        const rootEl = page.getByTestId("density-root");
+        await rootEl.waitFor();
+        const markdownRoot = rootEl.locator(":scope > div").first();
+        await markdownRoot.waitFor();
+
+        // 块间距由根容器的 space-y-3 提供：它会落在相邻子块的上外边距上（12px），
+        // 而不是 flex gap，所以按元素本身的外边距与真实视觉间距来量。
+        const markdownBlocks = markdownRoot.locator(":scope > *");
+        assert.ok((await markdownBlocks.count()) >= 6, "fixture 应渲染出全部块类型");
+        assert.equal(
+          await markdownBlocks.first().evaluate((node) => getComputedStyle(node).marginTop),
+          "0px",
+          "首块必须与容器齐平",
+        );
+
+        const paragraph = markdownRoot.locator("p").first();
+        const paragraphStyle = await box(paragraph);
+        // Tailwind v4 的 space-y-3 落在相邻子块的 margin-bottom 上，所以段落的
+        // 12px 下边距正是根容器提供的块间距本身；段落自身不能再叠加别的纵向间距。
+        assert.equal(
+          paragraphStyle.marginBottom,
+          "12px",
+          `段落间距应只来自 space-y-3，实际 ${paragraphStyle.marginBottom}`,
+        );
+        assert.equal(
+          paragraphStyle.marginTop,
+          "0px",
+          `段落不应另加上边距，实际 ${paragraphStyle.marginTop}`,
+        );
+        // 行高 1.65 × 17.6px（text-ui-base 在默认字号下的计算值）。
+        const fontSize = px(paragraphStyle.fontSize);
+        assert.ok(fontSize > 0);
+        assert.ok(
+          Math.abs(px(paragraphStyle.lineHeight) / fontSize - 1.65) < 0.01,
+          `正文行高应为 1.65 倍字号，实际 ${paragraphStyle.lineHeight}`,
+        );
+        // 正文不再逐字加宽。
+        assert.equal(paragraphStyle.letterSpacing, "normal", "正文不应使用 tracking-wide");
+
+        // 相邻段落的真实视觉间距应等于块间距 12px，不再有第二套节奏叠上去。
+        const [firstBox, secondBox] = await Promise.all([
+          paragraph.boundingBox(),
+          markdownRoot.locator("p").nth(1).boundingBox(),
+        ]);
+        assert.ok(firstBox && secondBox);
+        const gap = secondBox.y - (firstBox.y + firstBox.height);
+        assert.ok(Math.abs(gap - 12) < 2, `相邻段落间距应为 12px，实际 ${gap}px`);
+
+        // 标题是首块，规格要求首块与容器齐平，mt 被清零；下边距仍是 8px。
+        const heading = markdownRoot.locator("h2");
+        assert.equal(
