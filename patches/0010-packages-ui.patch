+import { describe, expect, it } from "vitest";
+import {
+  formatTokensPerSecondLabel,
+  resolveOutputTokensPerSecond,
+} from "@/session-diagnostics/contract.js";
+
+describe("resolveOutputTokensPerSecond", () => {
+  it("divides reported output tokens by model duration", () => {
+    expect(resolveOutputTokensPerSecond(1200, 6000)).toBe(200);
+    expect(resolveOutputTokensPerSecond(500, 2000)).toBe(250);
+  });
+
+  it.each([
+    [undefined, 1000],
+    [100, undefined],
+    [0, 1000],
+    [100, 0],
+    [-5, 1000],
+    [100, -500],
+    [Number.NaN, 1000],
+    [100, Number.POSITIVE_INFINITY],
+  ])("returns null for outputTokens=%s modelDurationMs=%s", (tokens, duration) => {
+    expect(resolveOutputTokensPerSecond(tokens, duration)).toBeNull();
+  });
+
+  it("formats the rate with one fraction digit", () => {
+    expect(formatTokensPerSecondLabel(200, "en-US")).toBe("200");
+    expect(formatTokensPerSecondLabel(52.36, "en-US")).toBe("52.4");
+  });
+});
diff --git a/packages/ui/test/toolLiveExpand.test.ts b/packages/ui/test/toolLiveExpand.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..88628552f6c3a7bf53ab2c42704db89487fd466f
--- /dev/null
+++ b/packages/ui/test/toolLiveExpand.test.ts
@@ -0,0 +1,318 @@
+// @vitest-environment jsdom
+
+import { cleanup, fireEvent, render } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { toolCallRowToLegacyNode } from "../src/v4/toolCallRowAdapter.js";
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import { EditToolCallBlock } from "../src/ToolCallBlocks/renderers/edit.js";
+import { ExecuteToolCallBlock } from "../src/ToolCallBlocks/renderers/execute.js";
+import { ExecuteGroupToolCallBlock } from "../src/ToolCallBlocks/renderers/execute-group.js";
+import { ExploreToolCallBlock } from "../src/ToolCallBlocks/renderers/explore.js";
+import { readRawToolCallFileSummaries } from "../src/ToolCallBlocks/fileSummaries.js";
+
+const displayModel = {
+  inlinePreview: { type: "none" as const },
+  planResult: null,
+  viewerSource: null,
+  viewerLabelId: "codeViewer.viewCode",
+  showSummaryFileLink: true,
+  showInput: false,
+  showOutput: true,
+  showKind: false,
+};
+
+function renderEdit(status: "running" | "completed") {
+  const node = toolCallRowToLegacyNode({
+    kind: "toolCall",
+    rowId: 1,
+    turnId: "turn",
+    createdAt: 1,
+    createdAtSeq: 1,
+    toolCallId: `edit-live-${status}`,
+    toolName: "Edit",
+    status,
+    inputText: "",
+    input: {
+      file_path: "/workspace/live.ts",
+      old_string: "const before = 1;",
+      new_string: "const after = 2;",
+    },
+  } as ToolCallRow);
+  const rawFileSummaries = readRawToolCallFileSummaries(node.toolCall.raw, node.toolCall);
+  return render(
+    createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "zh-CN" },
+      createElement(EditToolCallBlock, {
+        toolCallNode: node,
+        workspacePath: "/workspace",
+        displayModel,
+        viewerSource: null,
+        rawFileSummaries,
+        isRunning: status === "running",
+        statusLabel: status,
+        childToolList: null,
+      } as never),
+    ),
+  );
+}
+
+function executeElement(status: "running" | "completed") {
+  const node = toolCallRowToLegacyNode({
+    kind: "toolCall",
+    rowId: 2,
+    turnId: "turn",
+    createdAt: 1,
+    createdAtSeq: 1,
+    // 固定 toolId：重渲染必须复用用户选择的折叠状态。
+    toolCallId: "exec-live-command",
+    toolName: "Bash",
+    status,
+    inputText: "",
+    input: { command: "run-build" },
+    outputPreview: {
+      text: "latest-line-xyz",
+      fullText: "latest-line-xyz",
+      totalLines: 1,
+      totalBytes: 11,
+      linesEstimated: false,
+    },
+  } as ToolCallRow);
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "zh-CN" },
+    createElement(ExecuteToolCallBlock, {
+      toolCallNode: node,
+      workspacePath: "/workspace",
+      displayModel,
+      viewerSource: null,
+      rawFileSummaries: [],
+      isRunning: status === "running",
+      statusLabel: status,
+      childToolList: null,
+    } as never),
+  );
+}
+
+function renderExecute(status: "running" | "completed") {
+  return render(executeElement(status));
+}
+
+function liveToolRow(
+  rowId: number,
+  toolName: string,
+  input: Record<string, unknown>,
+  status: "running" | "completed",
+): ToolCallRow {
+  return {
+    rowId,
+    turnId: "turn",
+    createdAt: 1,
+    createdAtSeq: rowId,
+    kind: "toolCall",
+    toolCallId: `${toolName}-${rowId}`,
+    toolName,
+    status,
+    inputText: JSON.stringify(input),
+    input,
+  } as ToolCallRow;
+}
+
+function exploreGroupElement(isRunning: boolean) {
+  const rows = [
+    liveToolRow(10, "Read", { path: "/workspace/a.ts" }, isRunning ? "running" : "completed"),
+    liveToolRow(11, "Grep", { pattern: "needle" }, isRunning ? "running" : "completed"),
+  ];
+  const nodes = rows.map((row) => toolCallRowToLegacyNode(row));
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "zh-CN" },
+    createElement(ExploreToolCallBlock, {
+      toolCallNode: {
+        toolCall: {
+          toolId: "explore:group-live",
+          toolName: "Explore",
+          kind: "Explore",
+          title: "Explore",
+          input: {},
+          status: isRunning ? "in_progress" : "completed",
+        },
+        childToolCalls: nodes,
+      },
+      workspacePath: "/workspace",
+      displayModel,
+      viewerSource: null,
+      rawFileSummaries: [],
+      isRunning,
+      statusLabel: isRunning ? "running" : "completed",
+      childToolList: null,
+      nestedToolRenderer: () => null,
+      events: [
+        { kind: "tool", row: rows[0]!, node: nodes[0]! },
+        {
+          kind: "reasoning",
+          row: {
+            rowId: 12,
+            turnId: "turn",
+            createdAt: 2,
+            createdAtSeq: 12,
+            kind: "reasoning",
+            state: "complete",
+            text: "reasoning-detail",
+          },
+        },
+        { kind: "tool", row: rows[1]!, node: nodes[1]! },
+      ],
+      renderReasoning: () => createElement("div", { className: "reasoning-detail" }, "detail"),
+    } as never),
+  );
+}
+
+function executeGroupElement(isRunning: boolean) {
+  const rows = [
+    liveToolRow(20, "Bash", { command: "pnpm install" }, isRunning ? "running" : "completed"),
+    liveToolRow(21, "Bash", { command: "pnpm test" }, isRunning ? "running" : "completed"),
+  ];
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "zh-CN" },
+    createElement(ExecuteGroupToolCallBlock, {
+      toolCallNode: {
+        toolCall: {
+          toolId: "execute:group-live",
+          toolName: "ExecuteGroup",
+          kind: "executeGroup",
+          title: "Execute",
+          input: {},
+          status: isRunning ? "in_progress" : "completed",
+        },
+        childToolCalls: rows.map((row) => toolCallRowToLegacyNode(row)),
+      },
+      workspacePath: "/workspace",
+      displayModel,
+      viewerSource: null,
+      rawFileSummaries: [],
+      isRunning,
+      statusLabel: isRunning ? "running" : "completed",
+      childToolList: null,
+      nestedToolRenderer: () => null,
+    } as never),
+  );
+}
+
+afterEach(() => {
+  cleanup();
+});
+
+beforeAll(() => {
+  // jsdom 不实现 matchMedia / ResizeObserver，diff 高亮与命令输出测量需要它们。
+  vi.stubGlobal(
+    "ResizeObserver",
+    class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  );
+  Object.defineProperty(window, "matchMedia", {
+    configurable: true,
+    value: (query: string) => ({
+      matches: false,
+      media: query,
+      onchange: null,
+      addEventListener() {},
+      removeEventListener() {},
+      addListener() {},
+      removeListener() {},
+      dispatchEvent: () => false,
+    }),
+  });
+});
+
+describe("edit live expansion", () => {
+  it.each(["running", "completed"] as const)("uses the %s edit default", (status) => {
+    const view = renderEdit(status);
+    const trigger = view.container.querySelector<HTMLElement>(
+      `[data-testid="tool-summary-trigger-edit-live-${status}"]`,
+    );
+    expect(trigger?.getAttribute("aria-expanded")).toBe(String(status === "running"));
+    if (status === "running") {
+      expect(view.container.textContent).toContain("const after = 2;");
+      fireEvent.click(trigger!);
+      expect(trigger?.getAttribute("aria-expanded")).toBe("false");
+    } else {
+      expect(view.container.textContent).not.toContain("const after = 2;");
+      fireEvent.click(trigger!);
+      expect(trigger?.getAttribute("aria-expanded")).toBe("true");
+      expect(view.container.textContent).toContain("const after = 2;");
+    }
+  });
+});
+
+describe("execute live expand layout", () => {
+  it("opens command output while running", () => {
+    const running = renderExecute("running");
+    expect(running.container.textContent).toContain("latest-line-xyz");
+  });
+
+  it("keeps a completed command collapsed", () => {
+    const completed = renderExecute("completed");
+    expect(completed.container.textContent).not.toContain("latest-line-xyz");
+  });
+
+  it("preserves a manually opened command when it finishes", () => {
+    const view = render(executeElement("running"));
+    const trigger = () =>
+      view.container.querySelector<HTMLElement>(
+        '[data-testid="tool-summary-trigger-exec-live-command"]',
+      );
+
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+    fireEvent.click(trigger()!);
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("false");
+    view.rerender(executeElement("running"));
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("false");
+    fireEvent.click(trigger()!);
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+    expect(view.container.textContent).toContain("latest-line-xyz");
+
+    view.rerender(executeElement("completed"));
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+  });
+});
+
+describe("grouped run live expand layout", () => {
+  it("keeps a running explore group collapsed and preserves manual expansion", () => {
+    const view = render(exploreGroupElement(true));
+    const trigger = () =>
+      view.container.querySelector<HTMLElement>(
+        '[data-testid="tool-summary-trigger-explore:group-live"]',
+      );
+
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("false");
+    expect(view.container.textContent).not.toContain("detail");
+    fireEvent.click(trigger()!);
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+    expect(view.container.textContent).toContain("detail");
+
+    view.rerender(exploreGroupElement(false));
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+  });
+
+  it("keeps a running command group collapsed and preserves manual expansion", () => {
+    const view = render(executeGroupElement(true));
+    const trigger = () =>
+      view.container.querySelector<HTMLElement>(
+        '[data-testid="tool-summary-trigger-execute:group-live"]',
+      );
+
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("false");
+    fireEvent.click(trigger()!);
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+
+    view.rerender(executeGroupElement(false));
+    expect(trigger()?.getAttribute("aria-expanded")).toBe("true");
+  });
+});
