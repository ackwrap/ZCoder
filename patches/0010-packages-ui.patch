+    rowId: 3,
+    kind: "assistantText",
+    state: "complete",
+    entityId: "assistant-1",
+    text: "第一轮回答。",
+  },
+  {
+    turnId: "turn-2",
+    createdAt: turnTwo,
+    createdAtSeq: 2,
+    rowId: 11,
+    kind: "turnHeader",
+    origin: "userInput",
+    state: "completedSuccess",
