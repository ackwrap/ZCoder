+import { TID_CHAT_MODEL_SELECT_TRIGGER } from "@zcode/shared/test-ids";
+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+
+export function openComposerModelMenu(pane: HTMLElement | null): boolean {
+  const trigger = pane?.querySelector<HTMLButtonElement>(
+    `button[data-testid="${TID_CHAT_MODEL_SELECT_TRIGGER}"]`,
+  );
+  if (!trigger || trigger.disabled || trigger.getAttribute("aria-disabled") === "true")
+    return false;
+  trigger.focus();
+  trigger.dispatchEvent(
+    new KeyboardEvent("keydown", { key: "ArrowDown", bubbles: true, cancelable: true }),
+  );
+  return true;
+}
+
+export function createModelEffortCommands(
+  locale: Locale,
+  openMenu: (() => boolean) | null | undefined,
+  notify: (message: string) => void,
+): AppSlashCommand[] {
+  if (!openMenu) return [];
+  const zh = locale === "zh-CN";
+  const run = () => {
+    if (!openMenu()) notify(zh ? "当前模型菜单不可用" : "The model menu is currently unavailable");
+  };
+  return [
+    {
+      value: "model",
+      description: zh ? "切换模型" : "Switch model",
+      keywords: ["模型", "model"],
+      run,
+    },
+    {
+      value: "effort",
+      description: zh ? "设置推理强度" : "Set reasoning effort",
+      keywords: ["推理", "强度", "reasoning", "effort"],
+      run,
+    },
+  ];
+}
