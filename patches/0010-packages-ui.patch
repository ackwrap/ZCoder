+// @vitest-environment jsdom
+import { createElement } from "react";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ModelSystemPromptEntry } from "@zcode/shared";
+import { ModelSystemPromptsSettingsSection } from "@/settings/model-system-prompts/index.js";
+import { modelSystemPromptEntryKey } from "@/settings/model-system-prompts/index.js";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({ intl: { formatMessage: ({ id }: { id: string }) => id } }),
+}));
+const servicesMock = vi.hoisted(() => ({
+  modelSelectionService: { getView: vi.fn() },
+}));
+vi.mock("@/hooks/useServices.js", () => ({ useServices: () => servicesMock }));
+
+function entry(modelId: string, text: string): ModelSystemPromptEntry {
+  return { providerId: "p", modelId, text };
+}
+
+function renderSection(
+  entries: ModelSystemPromptEntry[],
+  update: (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => Promise<void>,
+) {
+  return render(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: entries },
+      onUpdateSettings: update,
+    }),
+  );
+}
+
+async function chooseModel(modelId: string) {
+  if (screen.queryByTestId("model-system-prompt-dialog")) closeDialog();
+  fireEvent.change(screen.getByTestId("model-system-prompt-model-select"), {
+    target: { value: modelSystemPromptEntryKey("p", modelId) },
+  });
+  await openDialog();
+}
+
+async function openDialog() {
+  await waitFor(() =>
+    expect(
+      (screen.getByTestId("model-system-prompt-open-dialog") as HTMLButtonElement).disabled,
+    ).toBe(false),
+  );
+  fireEvent.click(screen.getByTestId("model-system-prompt-open-dialog"));
+}
+
+function closeDialog() {
+  fireEvent.click(screen.getByTestId("model-system-prompt-cancel"));
+}
+
+async function setText(text: string) {
+  fireEvent.change(screen.getByTestId("model-system-prompt-textarea"), {
+    target: { value: text },
+  });
+}
+
+async function expectTextareaValue(value: string) {
+  await waitFor(() =>
+    expect((screen.getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement).value).toBe(
+      value,
+    ),
+  );
+}
+
+afterEach(cleanup);
+
+describe("model system prompt settings write queue", () => {
+  beforeEach(() => {
+    servicesMock.modelSelectionService.getView.mockReset();
+    servicesMock.modelSelectionService.getView.mockResolvedValue({
+      revision: 1,
+      providers: [
+        {
+          providerId: "p",
+          providerName: "P",
+          models: [
+            { modelId: "a", config: {} },
+            { modelId: "b", config: {} },
+            { modelId: "c", config: {} },
+          ],
+        },
+      ],
+    });
+  });
+
+  it("keeps an external entry added while another pair is pending", async () => {
+    let release!: () => void;
+    const firstWrite = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const writes: ModelSystemPromptEntry[][] = [];
+    const update = vi.fn(async (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {
+      writes.push(patch.modelSystemPromptAppends);
+      if (writes.length === 1) await firstWrite;
+    });
+
+    const view = renderSection([entry("a", "old-a"), entry("b", "old-b")], update);
+    await openDialog();
+    await expectTextareaValue("old-a");
+    await setText("new-a");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+    await waitFor(() => expect(writes).toHaveLength(1));
+
+    // A 仍在飞，关闭弹窗；权威投影带来外部 c，随后切到 B 并保存。
+    closeDialog();
+    view.rerender(
+      createElement(ModelSystemPromptsSettingsSection, {
+        settings: {
+          modelSystemPromptAppends: [
+            entry("a", "new-a"),
+            entry("b", "old-b"),
+            entry("c", "external-c"),
+          ],
+        },
+        onUpdateSettings: update,
+      }),
+    );
+    await openDialog();
+    await chooseModel("b");
+    await expectTextareaValue("old-b");
+    await waitFor(() =>
+      expect((screen.getByTestId("model-system-prompt-save") as HTMLButtonElement).disabled).toBe(
+        false,
+      ),
+    );
+    await setText("new-b");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+    await waitFor(() =>
+      expect((screen.getByTestId("model-system-prompt-save") as HTMLButtonElement).disabled).toBe(
+        true,
+      ),
+    );
+
+    await act(async () => {
+      release();
+      await firstWrite;
+      await Promise.resolve();
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    await waitFor(() => expect(writes).toHaveLength(2));
+    const second = writes[1]!;
+    expect(second.some((item) => item.modelId === "c" && item.text === "external-c")).toBe(true);
+    expect(second.some((item) => item.modelId === "b" && item.text === "new-b")).toBe(true);
+  });
+
+  it("does not use a failed write as the next pair's base", async () => {
+    let rejectFirst!: (error: Error) => void;
+    const firstWrite = new Promise<void>((_resolve, reject) => {
+      rejectFirst = reject;
+    });
+    const writes: ModelSystemPromptEntry[][] = [];
+    const update = vi.fn(async (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {
+      writes.push(patch.modelSystemPromptAppends);
+      if (writes.length === 1) await firstWrite;
+    });
+
+    const view = renderSection([entry("a", "old-a"), entry("b", "old-b")], update);
+    await openDialog();
+    await expectTextareaValue("old-a");
+    await setText("new-a");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+    await waitFor(() => expect(writes).toHaveLength(1));
+
+    closeDialog();
+    view.rerender(
+      createElement(ModelSystemPromptsSettingsSection, {
+        settings: {
+          modelSystemPromptAppends: [
+            entry("a", "old-a"),
+            entry("b", "old-b"),
+            entry("c", "external-c"),
+          ],
+        },
+        onUpdateSettings: update,
+      }),
+    );
+    await openDialog();
+    await chooseModel("b");
+    await waitFor(() =>
+      expect((screen.getByTestId("model-system-prompt-save") as HTMLButtonElement).disabled).toBe(
+        false,
+      ),
+    );
+    await setText("new-b");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+
+    await act(async () => {
+      rejectFirst(new Error("rejected"));
+      await firstWrite.catch(() => {});
+      await Promise.resolve();
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    await waitFor(() => expect(writes).toHaveLength(2));
+    const second = writes[1]!;
+    expect(second.some((item) => item.modelId === "a" && item.text === "new-a")).toBe(false);
+    expect(second.some((item) => item.modelId === "a" && item.text === "old-a")).toBe(true);
+    expect(second.some((item) => item.modelId === "c" && item.text === "external-c")).toBe(true);
+  });
+
+  it("cleans after a matched save and never resurrects it over a later external refresh", async () => {
+    let release!: () => void;
+    const firstWrite = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const writes: ModelSystemPromptEntry[][] = [];
+    const update = vi.fn(async (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {
+      writes.push(patch.modelSystemPromptAppends);
+      if (writes.length === 1) await firstWrite;
+    });
+
+    const view = renderSection([entry("a", "old-a"), entry("b", "old-b")], update);
+    await openDialog();
+    await expectTextareaValue("old-a");
+    await setText("saved-a");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+    await waitFor(() => expect(writes).toHaveLength(1));
+
+    // useSettings.update 的 refresh 在 promise resolve 前已正常带回 saved-a。
+    view.rerender(
+      createElement(ModelSystemPromptsSettingsSection, {
+        settings: {
+          modelSystemPromptAppends: [entry("a", "saved-a"), entry("b", "old-b")],
+        },
+        onUpdateSettings: update,
+      }),
+    );
+    await act(async () => {
+      release();
+      await firstWrite;
+      await Promise.resolve();
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    // 保存成功且当前编辑未再改：关闭弹窗；重新打开后继续跟随更晚权威刷新。
+    await waitFor(() => expect(screen.queryByTestId("model-system-prompt-dialog")).toBeNull());
+    await openDialog();
+    await expectTextareaValue("saved-a");
+
+    // 保存成功且当前编辑未再改：clean 后应跟随更晚权威刷新。
+    view.rerender(
+      createElement(ModelSystemPromptsSettingsSection, {
+        settings: {
+          modelSystemPromptAppends: [entry("a", "external-new-a"), entry("b", "old-b")],
+        },
+        onUpdateSettings: update,
+      }),
+    );
+    await waitFor(() =>
+      expect(
+        (screen.getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement).value,
