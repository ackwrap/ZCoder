@@ -0,0 +1,31 @@
+import type { ReadScope } from "./types.js";
+
+export function formatReadScope(scope: ReadScope, locale: string): string {
+  const chinese = locale === "zh-CN";
+  const lineCount = (count: number) =>
+    chinese ? `${count} 行` : `${count} ${count === 1 ? "line" : "lines"}`;
+  let label: string;
+  switch (scope.kind) {
+    case "full":
+      label = chinese ? "全文" : "Full file";
+      break;
+    case "range":
+      label = `offset ${scope.offset} · ${lineCount(scope.lines)}`;
+      break;
+    case "request-full":
+      label = chinese ? "全文请求" : "Full file requested";
+      break;
+    case "request-range":
+      label = `offset ${scope.offset} · ${
+        scope.limit === undefined
+          ? chinese
+            ? "至文件末尾（请求）"
+            : "to end of file (requested)"
+          : chinese
+            ? `最多 ${lineCount(scope.limit)}（请求）`
+            : `up to ${lineCount(scope.limit)} (requested)`
+      }`;
+      break;
+  }
+  return scope.truncated ? `${label} · ${chinese ? "已截断" : "truncated"}` : label;
+}
