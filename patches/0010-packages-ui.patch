+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry =
+  "/packages/ui/test/browser/manual-review/pending/tool-live-expansion.fixture.tsx";
+let server, browser, origin;
+before(async () => {
+  server = await createServer({
+    root,
+    configFile: false,
+    cacheDir: "node_modules/.vite-tool-live-expansion",
+    plugins: [
+      react(),
+      tailwindcss(),
+      {
+        name: "live-expansion-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0, hmr: false },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  await browser?.close();
+  server?.httpServer?.closeAllConnections();
+  await server?.close();
+});
+
+for (const width of [390, 1200])
+  for (const theme of ["light", "dark"]) {
+    test(`single edit/command live expansion ${width}/${theme}`, async () => {
+      const page = await browser.newPage({ viewport: { width, height: 800 } });
+      const errors = [];
+      page.on("pageerror", (error) => errors.push(String(error)));
+      try {
+        await page.goto(`${origin}fixture?theme=${theme}`);
+        const command = page.getByTestId("tool-summary-trigger-live-Bash");
+        const edit = page.getByTestId("tool-summary-trigger-live-Edit");
+        await command.waitFor();
+        assert.equal(await command.getAttribute("aria-expanded"), "true");
+        assert.equal(await edit.getAttribute("aria-expanded"), "true");
+        assert.ok(await page.getByTestId("execute-detail").isVisible());
+        await command.click();
+        assert.equal(await command.getAttribute("aria-expanded"), "false");
+        await edit.click();
+        assert.equal(await edit.getAttribute("aria-expanded"), "false");
+        await page
+          .getByRole("button", { name: "Stream update", exact: true })
+          .click();
+        assert.equal(await command.getAttribute("aria-expanded"), "false");
+        assert.equal(await edit.getAttribute("aria-expanded"), "false");
+        await page
+          .getByRole("button", { name: "Complete", exact: true })
+          .click();
+        assert.equal(await command.getAttribute("aria-expanded"), "false");
+        await command.click();
+        assert.equal(await command.getAttribute("aria-expanded"), "true");
+        assert.deepEqual(errors, []);
+      } finally {
+        await page.close();
+      }
+    });
+  }
