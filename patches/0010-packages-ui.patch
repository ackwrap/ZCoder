diff --git a/packages/ui/src/v4/slash-commands/rename.ts b/packages/ui/src/v4/slash-commands/rename.ts
new file mode 100644
index 0000000000000000000000000000000000000000..42d27f0cba29fb88ff74e745da16be0ae95e710a
--- /dev/null
+++ b/packages/ui/src/v4/slash-commands/rename.ts
@@ -0,0 +1,69 @@
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+
+const RENAME_COMMAND_PATTERN = /^\/rename(?:\s+([\s\S]*))?$/iu;
+const RENAME_COMMAND_NAME = "rename";
+
+export interface RenameCommandCopy {
+  description: string;
+  generating: string;
+  needsSession: string;
+  regenerated: string;
+  renamed(title: string): string;
+  failed: string;
+}
+
+export function renameCommandCopy(locale: string): RenameCommandCopy {
+  if (locale === "zh-CN") {
+    return {
+      description: "重命名当前会话；不带标题时由模型总结对话生成",
+      generating: "正在根据对话生成标题…",
+      needsSession: "请先开始会话再重命名。",
+      regenerated: "已根据对话重命名",
+      renamed: (title) => `已重命名为「${title}」`,
+      failed: "重命名会话失败。",
+    };
+  }
+  return {
+    description: "Rename this session; without a title the model summarizes the conversation",
+    generating: "Generating a title from the conversation…",
+    needsSession: "Start a session before renaming it.",
+    regenerated: "Renamed from the conversation",
+    renamed: (title) => `Renamed to "${title}"`,
+    failed: "Failed to rename the session.",
+  };
+}
+
+/**
+ * `/rename [title]` 是 Composer 本地命令：与 `/mcp` 一样在发送前拦截，不写入会话。
+ * 不带标题时由模型总结对话生成标题（与 opencode 的 title regenerate 同形）。
+ * CLI catalog 已有同名命令时让位，避免和 CLI 语义抢入口。
+ */
+export function parseRenameCommand(
+  text: string,
+  cliSlashCommandNames: ReadonlySet<string> = new Set(),
+): { title: string } | null {
+  const match = RENAME_COMMAND_PATTERN.exec(text.trim());
+  if (!match || cliSlashCommandNames.has(RENAME_COMMAND_NAME)) return null;
+  return { title: normalizeRenameTitle(match[1] ?? "") };
+}
+
+export function normalizeRenameTitle(value: string): string {
+  return value.replace(/\s+/gu, " ").trim();
+}
+
+/**
+ * 面板条目只把 `/rename ` 填进输入框：app 命令默认"选中即执行"，
+ * 直接跑会抢在用户输入标题之前按对话重命名。
+ */
+export function createRenameCommand(options: {
+  description: string;
+  run: () => void;
+}): AppSlashCommand {
+  return {
+    value: RENAME_COMMAND_NAME,
+    description: options.description,
+    keywords: ["rename", "title", "重命名", "标题"],
+    insertText: "/rename ",
+    run: options.run,
+  };
+}
