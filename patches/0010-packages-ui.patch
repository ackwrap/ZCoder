+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { McpStatusDialog } from "../src/McpStatusDialog.js";
+import { useMcpStore } from "../src/store/mcpStore.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+const mocks = vi.hoisted(() => ({ list: vi.fn(), settings: vi.fn() }));
+vi.mock("@/hooks/useWorkspaceServices.js", () => ({
+  useBaseWorkspaceServices: () => ({
+    mcpSyncService: { listWorkspaceMcpServerStatuses: mocks.list },
+  }),
+}));
+vi.mock("@/store/TabStoreProvider.js", () => ({
+  useOptionalTabStore: (selector: (state: unknown) => unknown) =>
+    selector({ openSettingsTab: mocks.settings }),
+}));
+afterEach(cleanup);
+it("offers diagnostics, status refresh and existing connect/settings without a configuration write control", async () => {
+  mocks.list.mockResolvedValue({ statuses: {} });
+  const toggle = vi.spyOn(useMcpStore.getState(), "toggleServer");
+  useMcpStore.setState({
+    isConfigLoaded: true,
+    currentProjectPath: "/read-only",
+    servers: [
+      {
+        id: "server",
+        name: "server",
+        enabled: true,
+        status: "connected",
+        source: "zcodeagentmcp",
+        scope: "user",
+        config: {},
+      },
+    ],
+  });
+  const view = render(
+    createElement(
+      ZCodeIntlProvider,
+      { initialLocale: "en-US" },
+      createElement(McpStatusDialog, {
+        open: true,
+        onOpenChange: vi.fn(),
+        workspacePath: "/read-only",
+      }),
+    ),
+  );
+  expect(view.queryByRole("switch")).toBeNull();
+  expect(view.queryByRole("checkbox")).toBeNull();
+  await waitFor(() =>
+    expect(
+      (view.getByTestId("mcp-status-connect") as HTMLButtonElement).disabled,
+    ).toBe(false),
+  );
+  fireEvent.click(view.getByTestId("mcp-status-connect"));
+  await waitFor(() =>
+    expect(mocks.list).toHaveBeenLastCalledWith({
+      workspacePath: "/read-only",
+      mode: "connect",
+    }),
+  );
+  expect(toggle).not.toHaveBeenCalled();
+  toggle.mockRestore();
+});
