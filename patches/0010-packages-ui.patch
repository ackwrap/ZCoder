diff --git a/packages/ui/src/components/ai-elements/image-preview-dismiss/contract.ts b/packages/ui/src/components/ai-elements/image-preview-dismiss/contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f55b2756ed83f5e60ffe3d75e0c7303d55e8dc65
--- /dev/null
+++ b/packages/ui/src/components/ai-elements/image-preview-dismiss/contract.ts
@@ -0,0 +1,38 @@
+import type { PointerEvent as ReactPointerEvent, RefObject } from "react";
+
+export const IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX = 5;
+
+export interface ImagePreviewDismissBlankTargetInput {
+  clientX: number;
+  clientY: number;
+  image: Element | null | undefined;
+  target: EventTarget | null;
+}
+
+export interface ImagePreviewDismissMoveInput {
+  clientX: number;
+  clientY: number;
+  maxMove?: number;
+  startX: number;
+  startY: number;
+}
+
+export interface ImagePreviewDismissOptions {
+  /** item identity/src/active lifecycle 的稳定信号；变化时取消旧手势。 */
+  displayKey: string;
+  imageRef: RefObject<Element | null>;
+  onDismiss: () => void;
+  open: boolean;
+}
+
+/**
+ * 可展开到图片预览 DialogContent 的 pointer handlers。
+ * 只由 viewer 使用；传入的 onDismiss 仅在干净空白轻点时调用。
+ */
+export interface ImagePreviewDismissHandlers {
+  onLostPointerCapture: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerCancel: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerDown: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerMove: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerUp: (event: ReactPointerEvent<HTMLElement>) => void;
+}
diff --git a/packages/ui/src/components/ai-elements/image-preview-dismiss/image-preview-dismiss.ts b/packages/ui/src/components/ai-elements/image-preview-dismiss/image-preview-dismiss.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b17044e32b38b4e7a960a702571811749f697b1e
--- /dev/null
+++ b/packages/ui/src/components/ai-elements/image-preview-dismiss/image-preview-dismiss.ts
@@ -0,0 +1,220 @@
+import {
+  IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX,
+  type ImagePreviewDismissBlankTargetInput,
+  type ImagePreviewDismissHandlers,
+  type ImagePreviewDismissMoveInput,
+  type ImagePreviewDismissOptions,
+} from "./contract.js";
+import type { PointerEvent as ReactPointerEvent } from "react";
+import { useCallback, useEffect, useRef } from "react";
+
+const INTERACTIVE_SELECTOR = [
+  "button",
+  "a[href]",
+  "input",
+  "select",
+  "textarea",
+  "summary",
+  "label",
+  "video",
+  "audio",
+  "[role='button']",
+  "[role='link']",
+  "[role='slider']",
+  "[role='checkbox']",
+  "[role='radio']",
+  "[role='menuitem']",
+  "[contenteditable='true']",
+  "[data-image-preview-interactive]",
+].join(",");
+
+function targetElement(target: EventTarget | null): Element | null {
+  return target && typeof (target as Element).closest === "function" ? (target as Element) : null;
+}
+
+export function isImagePreviewDismissInteractiveTarget(target: EventTarget | null): boolean {
+  return Boolean(targetElement(target)?.closest(INTERACTIVE_SELECTOR));
+}
+
+export function isImagePreviewDismissImageTarget(
+  target: EventTarget | null,
+  image: Element | null | undefined,
+): boolean {
+  const element = targetElement(target);
+  if (!element) return false;
+  if (image && element === image) return true;
+  return Boolean(element.closest("img"));
+}
+
+export function isImagePreviewDismissPointInsideImage(
+  image: Element | null | undefined,
+  clientX: number,
+  clientY: number,
+): boolean {
+  const rect = image?.getBoundingClientRect();
+  if (!rect || rect.width <= 0 || rect.height <= 0) return false;
+  return (
+    clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom
+  );
+}
+
+export function isImagePreviewDismissBlankTarget({
+  target,
+  image,
+  clientX,
+  clientY,
+}: ImagePreviewDismissBlankTargetInput): boolean {
+  if (isImagePreviewDismissInteractiveTarget(target)) return false;
+  if (isImagePreviewDismissImageTarget(target, image)) return false;
+  if (isImagePreviewDismissPointInsideImage(image, clientX, clientY)) return false;
+  return true;
+}
+
+export function hasImagePreviewDismissMoved({
+  startX,
+  startY,
+  clientX,
+  clientY,
+  maxMove = IMAGE_PREVIEW_DISMISS_MAX_MOVE_PX,
+}: ImagePreviewDismissMoveInput): boolean {
+  return Math.hypot(clientX - startX, clientY - startY) > maxMove;
+}
+
+interface DismissGesture {
+  blank: boolean;
+  cancelled: boolean;
+  displayKey: string;
+  lostCapture: boolean;
+  moved: boolean;
+  pointerId: number;
+  startX: number;
+  startY: number;
+}
+
+/**
+ * 只在图片外、非控件区域的主指针轻点时关闭预览。
+ * 不拦截传播或默认行为，viewport 的 pointer capture/拖拽清理保持原样。
+ */
+export function useImagePreviewDismiss({
+  displayKey,
+  imageRef,
+  onDismiss,
+  open,
+}: ImagePreviewDismissOptions): ImagePreviewDismissHandlers {
+  const gestureRef = useRef<DismissGesture | null>(null);
+  const activePointersRef = useRef(new Set<number>());
+  const pinchRef = useRef(false);
+  const displayKeyRef = useRef(displayKey);
+  const onDismissRef = useRef(onDismiss);
+  displayKeyRef.current = displayKey;
+  onDismissRef.current = onDismiss;
+
+  const reset = useCallback(() => {
+    gestureRef.current = null;
+    activePointersRef.current.clear();
+    pinchRef.current = false;
+  }, []);
+
+  useEffect(() => {
+    reset();
+  }, [displayKey, open, reset]);
+
+  const onPointerDown = useCallback(
+    (event: ReactPointerEvent<HTMLElement>) => {
+      // item/lifecycle 变化后，旧 gesture 立即失效，避免 key 已变但 effect 尚未执行。
+      if (gestureRef.current && gestureRef.current.displayKey !== displayKeyRef.current) {
+        reset();
+      }
+      const activePointers = activePointersRef.current;
+      if (activePointers.size > 0) {
+        // 第二根手指即使是 isPrimary=false 也必须跟踪；pinch 持续到全部抬起。
+        pinchRef.current = true;
+        if (gestureRef.current) gestureRef.current.cancelled = true;
+        activePointers.add(event.pointerId);
+        return;
+      }
+      activePointers.add(event.pointerId);
+      if (event.button !== 0 || event.isPrimary === false) {
+        gestureRef.current = null;
+        return;
+      }
+      gestureRef.current = {
+        blank: isImagePreviewDismissBlankTarget({
+          target: event.target,
+          image: imageRef.current,
+          clientX: event.clientX,
+          clientY: event.clientY,
+        }),
+        cancelled: false,
+        displayKey: displayKeyRef.current,
+        lostCapture: false,
+        moved: false,
+        pointerId: event.pointerId,
+        startX: event.clientX,
+        startY: event.clientY,
+      };
+    },
+    [imageRef, reset],
+  );
+
+  const onPointerMove = useCallback((event: ReactPointerEvent<HTMLElement>) => {
+    const gesture = gestureRef.current;
+    if (!gesture || gesture.pointerId !== event.pointerId) return;
+    if (
+      hasImagePreviewDismissMoved({
+        startX: gesture.startX,
+        startY: gesture.startY,
+        clientX: event.clientX,
+        clientY: event.clientY,
+      })
+    ) {
+      gesture.moved = true;
+    }
+  }, []);
+
+  const finishPointer = useCallback(
+    (event: ReactPointerEvent<HTMLElement>, cancelled: boolean) => {
+      const gesture = gestureRef.current;
+      activePointersRef.current.delete(event.pointerId);
+      if (!gesture || gesture.pointerId !== event.pointerId) {
+        if (activePointersRef.current.size === 0) pinchRef.current = false;
+        return;
+      }
+      if (cancelled) gesture.cancelled = true;
+      const shouldDismiss =
+        gesture.displayKey === displayKeyRef.current &&
+        !gesture.cancelled &&
+        gesture.blank &&
+        !gesture.moved &&
+        !gesture.lostCapture &&
+        !pinchRef.current &&
+        isImagePreviewDismissBlankTarget({
+          target: event.target,
+          image: imageRef.current,
+          clientX: event.clientX,
+          clientY: event.clientY,
+        });
+      gestureRef.current = null;
+      if (activePointersRef.current.size === 0) pinchRef.current = false;
+      if (shouldDismiss) onDismissRef.current();
+    },
+    [imageRef],
+  );
+
+  const onPointerUp = useCallback(
+    (event: ReactPointerEvent<HTMLElement>) => finishPointer(event, false),
+    [finishPointer],
+  );
+  const onPointerCancel = useCallback(
+    (event: ReactPointerEvent<HTMLElement>) => finishPointer(event, true),
+    [finishPointer],
+  );
+  const onLostPointerCapture = useCallback((event: ReactPointerEvent<HTMLElement>) => {
+    const gesture = gestureRef.current;
+    if (gesture?.pointerId === event.pointerId) gesture.lostCapture = true;
+    activePointersRef.current.delete(event.pointerId);
+    if (activePointersRef.current.size === 0) pinchRef.current = false;
+  }, []);
+
+  return { onLostPointerCapture, onPointerCancel, onPointerDown, onPointerMove, onPointerUp };
+}
