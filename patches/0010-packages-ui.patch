+++ b/packages/ui/src/v4/composer/model-system-prompt/storage.ts
@@ -0,0 +1,212 @@
+import { logger } from "@/logger.js";
+
+/**
+ * Composer 会话开关只属于 renderer 偏好：不发送 RPC、不改变运行中的 turn。
+ * 真实 Session 的开关持久化到 localStorage；草稿态只留在本窗口内存，promotion 后清除，
+ * 避免放弃草稿后把 enabled 泄漏给下一个新任务。
+ */
+export const MODEL_SYSTEM_PROMPT_STORAGE_KEY_PREFIX = "zcode-v4-composer-model-system-prompt:v1:";
+
+const warnedStorageKeys = new Set<string>();
+const sessionMemory = new Map<string, boolean>();
+const draftMemory = new Map<string, { enabled: boolean; revision: number }>();
+
+/** 跨 renderer epoch 的迟到 ACK 只能写目标，不能清当前进程的新 root。 */
+const RENDERER_EPOCH =
+  typeof globalThis.crypto?.randomUUID === "function"
+    ? globalThis.crypto.randomUUID()
+    : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
+
+export function buildModelSystemPromptDraftOwnerKey(params: {
+  projectScope?: string | null;
+  generation?: number | string | null;
+}): string {
+  return JSON.stringify([
+    RENDERER_EPOCH,
+    params.projectScope?.trim() ?? "",
+    params.generation ?? "",
+  ]);
+}
+
+export interface ModelSystemPromptScope {
+  readonly workspacePath: string;
+  readonly workspaceIdentity?: string;
+  readonly sessionId: string | null;
+  /** 草稿作用域（workspace/project/generation）；真实 Session 忽略。 */
+  readonly draftOwnerKey?: string;
+}
+
+/** 提交时冻结的草稿 owner/intent；promotion 只消费该快照，不读当前 root。 */
+export interface ModelSystemPromptDraftBinding {
+  readonly workspacePath: string;
+  readonly workspaceIdentity?: string;
+  readonly draftOwnerKey: string;
+  readonly enabled: boolean;
+  /** 捕获时的草稿 revision；source 已有新编辑时不清理。 */
+  readonly revision: number;
+}
+
+export interface ModelSystemPromptDraftState {
+  readonly enabled: boolean;
+  readonly revision: number;
+}
+
+/** 供 submission 冻结使用；真实 Session/无草稿返回 null。 */
+export function readModelSystemPromptDraftState(
+  scope: ModelSystemPromptScope,
+): ModelSystemPromptDraftState | null {
+  if (scope.sessionId !== null) return null;
+  const state = draftMemory.get(
+    draftMemoryKey(scope.workspacePath, scope.workspaceIdentity, scope.draftOwnerKey),
+  );
+  return state ? { ...state } : null;
+}
+
+function workspaceKey(workspacePath: string, workspaceIdentity?: string): string {
+  return workspaceIdentity?.trim() || workspacePath.trim();
+}
+
+function sessionStorageKey(scope: ModelSystemPromptScope): string {
+  return `${MODEL_SYSTEM_PROMPT_STORAGE_KEY_PREFIX}${JSON.stringify([
+    workspaceKey(scope.workspacePath, scope.workspaceIdentity),
+    scope.sessionId,
+  ])}`;
+}
+
+function draftMemoryKey(
+  workspacePath: string,
+  workspaceIdentity: string | undefined,
+  draftOwnerKey: string | undefined,
+): string {
+  return `${workspaceKey(workspacePath, workspaceIdentity)}\u0000${draftOwnerKey ?? "__draft__"}`;
+}
+
+function warnStorageFailure(key: string, error: unknown): void {
+  if (warnedStorageKeys.has(key)) return;
+  warnedStorageKeys.add(key);
+  logger.warn("[composer-model-system-prompt] 开关持久化访问失败", {
+    error: error instanceof Error ? error.message : String(error),
+    key,
+  });
+}
+
+function getStorage(): Storage | null {
+  if (typeof window === "undefined") return null;
+  try {
+    return window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * 解析作用域；空 workspace 返回 null。`sessionId=null` 表示草稿（root），仍然有效，
+ * 但只使用内存。
+ */
+export function resolveModelSystemPromptScope(
+  workspacePath: string,
+  workspaceIdentity: string | undefined,
+  sessionId: string | null,
+  draftOwnerKey?: string | null,
+): ModelSystemPromptScope | null {
+  const key = workspaceKey(workspacePath, workspaceIdentity);
+  if (!key) return null;
+  const normalizedSessionId = sessionId?.trim() ? sessionId.trim() : null;
+  const normalizedIdentity = workspaceIdentity?.trim();
+  const normalizedOwnerKey = normalizedSessionId === null ? draftOwnerKey?.trim() : undefined;
+  return {
+    workspacePath,
+    ...(normalizedIdentity ? { workspaceIdentity: normalizedIdentity } : {}),
+    sessionId: normalizedSessionId,
+    ...(normalizedOwnerKey ? { draftOwnerKey: normalizedOwnerKey } : {}),
+  };
+}
+
+export interface ModelSystemPromptSessionState {
+  readonly enabled: boolean;
+}
+
+/**
+ * 读取真实 Session 的显式状态；`null` 表示从未写过（默认 false，但可被 promotion 初始化）。
+ * 内存显式 `false` 与 localStorage `"0"` 都算显式，用于区分“用户关过”和“没写过”。
+ */
+export function readModelSystemPromptSessionState(
+  scope: ModelSystemPromptScope,
+): ModelSystemPromptSessionState | null {
+  if (scope.sessionId === null) return null;
+  const storageKey = sessionStorageKey(scope);
+  const memory = sessionMemory.get(storageKey);
+  if (memory !== undefined) return { enabled: memory };
+
+  let persisted: string | null = null;
+  try {
+    persisted = getStorage()?.getItem(storageKey) ?? null;
+  } catch (error) {
+    warnStorageFailure(storageKey, error);
+  }
+  if (persisted === null) return null;
+  const enabled = persisted === "1";
+  sessionMemory.set(storageKey, enabled);
+  return { enabled };
+}
+
+/** 读取当前会话/草稿开关；默认关闭。localStorage 只作持久化副本，内存优先。 */
+export function isModelSystemPromptEnabled(scope: ModelSystemPromptScope): boolean {
+  if (scope.sessionId === null) {
+    return readModelSystemPromptDraftState(scope)?.enabled ?? false;
+  }
+  return readModelSystemPromptSessionState(scope)?.enabled ?? false;
+}
+
+/**
+ * 写开关。先写内存再写 localStorage；存储失败只降级持久性，不丢当前选项。
+ * 草稿值不写盘。
+ */
+export function setModelSystemPromptEnabled(scope: ModelSystemPromptScope, enabled: boolean): void {
+  if (scope.sessionId === null) {
+    const key = draftMemoryKey(scope.workspacePath, scope.workspaceIdentity, scope.draftOwnerKey);
+    const current = draftMemory.get(key);
+    draftMemory.set(key, { enabled, revision: (current?.revision ?? 0) + 1 });
+    return;
+  }
+
+  const storageKey = sessionStorageKey(scope);
+  sessionMemory.set(storageKey, enabled);
+  try {
+    getStorage()?.setItem(storageKey, enabled ? "1" : "0");
+  } catch (error) {
+    warnStorageFailure(storageKey, error);
+  }
+}
+
+/**
+ * 首发送 promotion：只消费提交时冻结的 owner/enabled，不读当前 root。
+ * 清的是该 owner/generation 的草稿键；导航已切到新草稿时不会误删新 root。
+ */
+export function promoteModelSystemPromptDraftFlag(params: {
+  binding: ModelSystemPromptDraftBinding;
+  targetSessionId: string;
+}): boolean {
+  const target = resolveModelSystemPromptScope(
+    params.binding.workspacePath,
+    params.binding.workspaceIdentity,
+    params.targetSessionId,
+  );
+  if (!target) return false;
+  const sourceKey = draftMemoryKey(
+    params.binding.workspacePath,
+    params.binding.workspaceIdentity,
+    params.binding.draftOwnerKey,
+  );
+  const source = draftMemory.get(sourceKey);
+  // CAS：source 在提交后又有新编辑时不清；跨 epoch/旧 owner 也不会命中当前 root。
+  if (source && source.revision === params.binding.revision) {
+    draftMemory.delete(sourceKey);
+  }
+  // 目标已有显式 true/false（含用户成功写盘的 off）时保留；只在从未写过时初始化。
+  // 这跨 pending 账本 applied 丢失与 renderer 重载也成立。
+  if (readModelSystemPromptSessionState(target) === null) {
+    setModelSystemPromptEnabled(target, params.binding.enabled);
+  }
+  return true;
+}
