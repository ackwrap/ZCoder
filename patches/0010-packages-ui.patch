diff --git a/packages/ui/src/app-shell/GodFlowDiagram.tsx b/packages/ui/src/app-shell/GodFlowDiagram.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..aceb9a9fc34d868605d3ed2704f331f6d7763764
--- /dev/null
+++ b/packages/ui/src/app-shell/GodFlowDiagram.tsx
@@ -0,0 +1,275 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from "react";
+import { Bell, Building2, Coins, Crown, FileSearch, FileText, Landmark, Scale, Sparkles, Swords, Users, type LucideIcon } from "lucide-react";
+import type { GodFlowAssignmentView, GodFlowView } from "@zcode/shared/zcode-protocol-v4";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+type Kind = GodFlowAssignmentView["kind"];
+type Role = GodFlowAssignmentView["role"];
+type DepartmentNode = {
+  role: Role;
+  items: GodFlowAssignmentView[];
+  item?: GodFlowAssignmentView;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  ministry?: boolean;
+};
+const MINISTRIES: Role[] = ["libu_hr", "hubu", "libu", "bingbu", "xingbu", "gongbu"];
+const DEPARTMENT_STYLE: Record<Role, { color: string; fill: string; icon: LucideIcon }> = {
+  taizi: { color: "#e8bc72", fill: "#493724", icon: Crown },
+  zhongshu: { color: "#69b6ff", fill: "#153f67", icon: FileText },
+  menxia: { color: "#66d4a4", fill: "#154d37", icon: FileSearch },
+  shangshu: { color: "#c29aef", fill: "#493267", icon: Landmark },
+  libu_hr: { color: "#ef8c8c", fill: "#582c31", icon: Users },
+  hubu: { color: "#eac16a", fill: "#55431b", icon: Coins },
+  libu: { color: "#6ed6ab", fill: "#174936", icon: Sparkles },
+  bingbu: { color: "#79b6fa", fill: "#193d64", icon: Swords },
+  xingbu: { color: "#c197ed", fill: "#422b60", icon: Scale },
+  gongbu: { color: "#67cedd", fill: "#124951", icon: Building2 },
+  zaochao: { color: "#9fc6d7", fill: "#294350", icon: Bell },
+};
+const ACTIVE_KIND: Partial<Record<GodFlowView["stage"], Kind>> = {
+  intake: "intake", planning: "plan", reviewing: "review", dispatching: "dispatch",
+  executing: "execute", summarizing: "summarize", finalizing: "final",
+};
+
+function wrapLabel(value: string, maxUnits: number): string[] {
+  const lines: string[] = [];
+  let line = "";
+  let units = 0;
+  for (const character of value) {
+    const size = character.charCodeAt(0) > 255 ? 1 : 0.55;
+    if (units + size > maxUnits && line) { lines.push(line); line = ""; units = 0; }
+    line += character;
+    units += size;
+  }
+  if (line) lines.push(line);
+  return lines;
+}
+
+export function GodFlowDiagram({ flow, resident, reducedMotion, onOpenRole }: {
+  flow: GodFlowView;
+  resident: boolean;
+  reducedMotion: boolean;
+  onOpenRole?: ((role: Role) => void) | undefined;
+}) {
+  const { intl } = useZCodeIntl();
+  const text = (key: string) => intl.formatMessage({ id: `sidePane.god.${key}` });
+  const uid = useId().replace(/:/g, "");
+  const containerRef = useRef<HTMLDivElement>(null);
+  const [width, setWidth] = useState(680);
+  const [selectedRole, setSelectedRole] = useState<Role | null>(null);
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+    const update = (value: number) => {
+      if (value > 0) setWidth(Math.max(300, Math.floor(value) - 2));
+    };
+    update(container.getBoundingClientRect().width);
+    if (typeof ResizeObserver === "undefined") return;
+    const observer = new ResizeObserver(([entry]) => { if (entry) update(entry.contentRect.width); });
+    observer.observe(container);
+    return () => observer.disconnect();
+  }, []);
+
+  const current = flow.assignments.filter((item) => item.revision === flow.revision);
+  const previous = flow.assignments.filter((item) => item.revision !== flow.revision);
+  const one = (kind: Kind) => current.find((item) => item.kind === kind);
+  const intake = one("intake") ?? previous.find((item) => item.kind === "intake" && item.status === "submitted");
+  const plan = one("plan");
+  const review = one("review");
+  const dispatch = one("dispatch");
+  const summary = one("summarize");
+  const final = one("final");
+  const activeKind = ACTIVE_KIND[flow.stage];
+  const moving = (item?: GodFlowAssignmentView) => Boolean(resident && activeKind && item &&
+    item.kind === activeKind && item.revision === flow.revision && item.status === "running" && item.canAnimate === true);
+  const departmentNode = (role: Role, x: number, y: number, nodeWidth: number, height: number, ministry = false): DepartmentNode => {
+    const items = [...previous, ...current].filter((item) => item.role === role);
+    return { role, x, y, width: nodeWidth, height, ministry, items, item: items.find(moving) ?? items.at(-1) };
+  };
+  const center = (node: DepartmentNode) => node.x + node.width / 2;
+  const bottom = (node: DepartmentNode) => node.y + node.height;
+  const wide = width >= 660;
+  const single = width < 400;
+  const mainWidth = Math.min(220, width - 88);
+  const provinceWidth = wide ? Math.min(230, (width - 80 - 128) / 3) : single ? mainWidth : (width - 112) / 2;
+  const taizi = departmentNode("taizi", (width - mainWidth) / 2, 20, mainWidth, 104);
+  const provinceX = (index: number) => 40 + index * ((width - 80 - provinceWidth) / 2);
+  const zhongshu = departmentNode("zhongshu", wide ? provinceX(0) : single ? taizi.x : 40, 170, provinceWidth, 104);
+  const menxia = departmentNode("menxia", wide ? provinceX(1) : single ? taizi.x : width - 40 - provinceWidth,
+    single ? 334 : 170, provinceWidth, 104);
+  const shangshu = departmentNode("shangshu", wide ? provinceX(2) : taizi.x,
+    wide ? 170 : single ? 498 : 354, wide ? provinceWidth : mainWidth, 104);
+  const sectionY = bottom(shangshu) + 64;
+  const ministryY = sectionY + 84;
+  const columns = width >= 1180 ? 6 : width >= 660 ? 3 : width >= 400 ? 2 : 1;
+  const ministryWidth = (width - 80 - (columns - 1) * 24) / columns;
+  const ministryNodes = MINISTRIES.map((role, index) => departmentNode(role,
+    40 + (index % columns) * (ministryWidth + 24), ministryY + Math.floor(index / columns) * 210, ministryWidth, 160, true));
+  const ministriesBottom = ministryY + (Math.ceil(MINISTRIES.length / columns) - 1) * 210 + 160;
+  const auxiliary = current.some((item) => item.role === "zaochao")
+    ? departmentNode("zaochao", taizi.x, ministriesBottom + 76, mainWidth, 160, true) : undefined;
+  const executionNodes = [...ministryNodes, ...(auxiliary ? [auxiliary] : [])];
+  const height = (auxiliary ? bottom(auxiliary) : ministriesBottom) + 36;
+  const allNodes = [taizi, zhongshu, menxia, shangshu, ...executionNodes];
+  const selected = allNodes.find((node) => node.role === selectedRole);
+  const priorReview = previous.find((item) => item.kind === "review");
+  // Only controller-supplied feedback distinguishes a rejection from a generic retry.
+  const rejected = Boolean(priorReview && plan?.task.includes("门下退回："));
+  const approved = flow.approvedRevision === flow.revision;
+  const executing = executionNodes.some((node) => moving(node.item));
+  const edges: ReactNode[] = [];
+  const labels: ReactNode[] = [];
+  const edge = (key: string, path: string, active: boolean, feedback = false, duration = "3s") => {
+    edges.push(<g key={key}>
+      <path d={path} fill="none" stroke={active ? "#f0ca80" : feedback ? "#589bc0" : "#a4b4c7"}
+        strokeOpacity={active ? 0.95 : feedback ? 0.45 : 0.55} strokeWidth={active ? 2 : 1.4}
+        strokeLinecap="round" strokeLinejoin="round" strokeDasharray={feedback ? "5 6" : undefined}
+        markerEnd={`url(#${uid}-${active ? "active" : feedback ? "return" : "muted"})`} />
+      {active && !reducedMotion && [0, 1].map((index) => <g key={index}>
+        <circle r="8" fill="#ffd47b" opacity="0.18" />
+        <circle r="3.8" fill="#ffe0a0" stroke="#fff8e4" strokeWidth="1" />
+        <animateMotion path={path} dur={duration} begin={index === 0 ? "0s" : `-${Number.parseFloat(duration) / 2}s`} repeatCount="indefinite" calcMode="paced" />
+      </g>)}
+    </g>);
+  };
+  const label = (key: string, x: number, y: number, anchor: "start" | "middle" | "end" = "middle") => {
+    labels.push(<text key={`${key}-${x}-${y}`} x={x} y={y} textAnchor={anchor} fill="#acbbce" fontSize="12"
+      stroke="#131a23" strokeWidth="5" strokeLinejoin="round" paintOrder="stroke">{text(`edge.${key}`)}</text>);
+  };
+  const fromTop = (source: DepartmentNode, target: DepartmentNode, railY: number) =>
+    `M${center(source)} ${bottom(source)} V${railY} H${center(target)} V${target.y}`;
+  if (moving(intake)) edge("intake", `M${center(taizi)} 4 V${taizi.y}`, true, false, "1.6s");
