+
+    await openDialog();
+    await chooseModel("b");
+    await expectTextareaValue("old-b");
+    await waitFor(() =>
+      expect((screen.getByTestId("model-system-prompt-save") as HTMLButtonElement).disabled).toBe(
+        false,
+      ),
+    );
+    await setText("new-b");
+    fireEvent.click(screen.getByTestId("model-system-prompt-save"));
+
+    await waitFor(() => expect(writes).toHaveLength(2));
+    const second = writes[1]!;
+    expect(second.some((item) => item.modelId === "a" && item.text === "external-new-a")).toBe(
+      true,
+    );
+    expect(second.some((item) => item.modelId === "a" && item.text === "saved-a")).toBe(false);
+    expect(second.some((item) => item.modelId === "b" && item.text === "new-b")).toBe(true);
+  });
+
+  it("keeps a newer edit dirty when a late successful save resolves", async () => {
+    let release!: () => void;
+    const firstWrite = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const writes: ModelSystemPromptEntry[][] = [];
+    const update = vi.fn(async (patch: { modelSystemPromptAppends: ModelSystemPromptEntry[] }) => {
+      writes.push(patch.modelSystemPromptAppends);
