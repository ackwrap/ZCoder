diff --git a/packages/ui/test/v4CompactResultDetails.test.ts b/packages/ui/test/v4CompactResultDetails.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..359aa491e5b9154357ff915832e2afa3be38b4a6
--- /dev/null
+++ b/packages/ui/test/v4CompactResultDetails.test.ts
@@ -0,0 +1,183 @@
+// @vitest-environment jsdom
+import { act, createElement } from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type {
+  TimelineMarkerRow,
+  V4ConversationCompactSummaryResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+import { ConversationRowView } from "@/v4/ConversationRowView.js";
+import type { ConversationRowRenderContext } from "@/v4/conversationRowContext.js";
+
+const row: TimelineMarkerRow = {
+  rowId: 12,
+  entityId: "op1",
+  turnId: "turn1",
+  kind: "timelineMarker",
+  createdAt: 1,
+  createdAtSeq: 1,
+  marker: {
+    type: "compact",
+    status: "success",
+    origin: "manual",
+    operationId: "op1",
+    summaryRef: "summary1",
+    tokensBefore: 10000,
+    tokensAfter: 2000,
+  },
+};
+function context(
+  overrides: Partial<ConversationRowRenderContext> = {},
+): ConversationRowRenderContext {
+  return {
+    workspacePath: "/repo",
+    workspaceIdentity: "workspace1",
+    sessionId: "s1",
+    logEpoch: "epoch1",
+    branchGeneration: 0,
+    theme: "light",
+    codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+    ...overrides,
+  };
+}
+function element(
+  ctx: ConversationRowRenderContext,
+  markerRow = row,
+  locale: "en-US" | "zh-CN" = "en-US",
+) {
+  return createElement(ZCodeIntlProvider, {
+    initialLocale: locale,
+    children: createElement(ConversationRowView, { row: markerRow, context: ctx }),
+  });
+}
+afterEach(cleanup);
+
+describe("compact result marker", () => {
+  it.each(["en-US", "zh-CN"] as const)(
+    "formats integer estimates using the actual %s locale provider",
+    (locale) => {
+      const markerRow = {
+        ...row,
+        marker: { ...row.marker, tokensBefore: 12345.6, tokensAfter: 2345.1 },
+      } as TimelineMarkerRow;
+      const view = render(element(context(), markerRow, locale));
+      const format = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
+      expect(view.container.textContent).toContain(
+        `${format.format(12345.6)} → ${format.format(2345.1)}`,
+      );
+    },
+  );
+
+  it("defaults collapsed, lazily reads saved Markdown, and collapses without another row", async () => {
+    const read = vi.fn().mockResolvedValue({
+      status: "available",
+      markdown: "## Saved result\n\n**Durable** summary",
+    });
+    const view = render(element(context({ readCompactSummary: read })));
+    expect(read).not.toHaveBeenCalled();
+    expect(view.container.textContent).toContain("Manual");
+    expect(view.container.textContent).toContain("10,000 → 2,000");
+    const trigger = view.getByRole("button", { expanded: false });
+    fireEvent.click(trigger);
+    await waitFor(() => expect(view.getByRole("heading", { name: "Saved result" })).toBeTruthy());
+    expect(read).toHaveBeenCalledWith({
+      sessionId: "s1",
+      baseLogEpoch: "epoch1",
+      branchGeneration: 0,
+      rowId: 12,
+      operationId: "op1",
+      summaryRef: "summary1",
+    });
+    expect(view.container.querySelectorAll('[data-row-kind="timelineMarker"]')).toHaveLength(1);
+    fireEvent.click(view.getByRole("button", { expanded: true }));
+    expect(view.queryByRole("heading", { name: "Saved result" })).toBeNull();
+  });
+
+  it.each(["workspace", "session", "branch", "operation", "ref"])(
+    "ignores late success after %s identity changes",
+    async (change) => {
+      let finish!: (result: V4ConversationCompactSummaryResult) => void;
+      const read = vi.fn().mockImplementation(
+        () =>
+          new Promise<V4ConversationCompactSummaryResult>((resolve) => {
+            finish = resolve;
+          }),
+      );
+      const ctx = context({ readCompactSummary: read });
+      const view = render(element(ctx));
+      fireEvent.click(view.getByRole("button", { expanded: false }));
+      await waitFor(() => expect(read).toHaveBeenCalledTimes(1));
+      const nextContext = {
+        ...ctx,
+        ...(change === "workspace"
+          ? { workspaceIdentity: "workspace2" }
+          : change === "session"
+            ? { sessionId: "s2" }
+            : change === "branch"
+              ? { branchGeneration: 1 }
+              : {}),
+      };
+      const nextRow =
+        change === "operation" || change === "ref"
+          ? ({
+              ...row,
+              marker: {
+                ...row.marker,
+                ...(change === "operation" ? { operationId: "op2" } : { summaryRef: "summary2" }),
+              },
+            } as TimelineMarkerRow)
+          : row;
+      view.rerender(element(nextContext, nextRow));
+      await act(async () => finish({ status: "available", markdown: "SECRET OLD SUMMARY" }));
+      expect(view.container.textContent).not.toContain("SECRET OLD SUMMARY");
+      expect(view.getByRole("button", { expanded: false })).toBeTruthy();
+    },
+  );
+
+  it("ignores late read errors on reused rows and exposes retryable current errors", async () => {
+    let fail!: (reason: Error) => void;
+    const read = vi
+      .fn()
+      .mockImplementationOnce(
+        () =>
+          new Promise((_resolve, reject) => {
+            fail = reject;
+          }),
+      )
+      .mockRejectedValue(new Error("private storage failure"));
+    const view = render(element(context({ readCompactSummary: read })));
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(read).toHaveBeenCalledTimes(1));
+    view.rerender(element(context({ sessionId: "s2", readCompactSummary: read })));
+    await act(async () => fail(new Error("old private error")));
+    expect(view.container.textContent).not.toContain("Unable to load");
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.container.textContent).toContain("Unable to load"));
+    expect(view.container.textContent).not.toContain("private");
+    expect(view.getByRole("button", { name: "Retry" })).toBeTruthy();
+  });
+
+  it("shows unavailable legacy summaries and unknown post-context estimates", async () => {
+    const old = {
+      ...row,
+      marker: { type: "compact", origin: "auto", status: "success", tokensBefore: 10000 },
+    } as TimelineMarkerRow;
+    const view = render(element(context(), old));
+    expect(view.container.textContent).toContain("10,000 → Unknown");
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    expect(view.container.textContent).toContain("Summary unavailable");
+  });
+
+  it.each(["running", "failed", "noop", "cancelled", "interrupted"] as const)(
+    "never offers a summary for %s",
+    (status) => {
+      const read = vi.fn();
+      const markerRow = { ...row, marker: { ...row.marker, status } } as TimelineMarkerRow;
+      const view = render(element(context({ readCompactSummary: read }), markerRow));
+      expect(view.queryByRole("button", { expanded: false })).toBeNull();
+      expect(read).not.toHaveBeenCalled();
+    },
+  );
+});
