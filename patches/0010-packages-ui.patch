diff --git a/packages/ui/test/codexConnectionOrdering.test.ts b/packages/ui/test/codexConnectionOrdering.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a751676ec2869d918f7c2ada37af11e8838f06c9
--- /dev/null
+++ b/packages/ui/test/codexConnectionOrdering.test.ts
@@ -0,0 +1,110 @@
+// @vitest-environment jsdom
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { useCodexConnection } from "../src/codex-provider/useCodexConnection.js";
+
+const service = vi.hoisted(() => ({
+  status: vi.fn(),
+  cancel: vi.fn(),
+  disconnect: vi.fn(),
+}));
+vi.mock("@/hooks/useServices.js", () => ({
+  useServices: () => ({ codexProviderService: service }),
+}));
+vi.mock("@/hooks/usePlatform.js", () => ({
+  usePlatform: () => ({ canOpenLocalFiles: true }),
+}));
+afterEach(() => {
+  cleanup();
+  vi.resetAllMocks();
+});
+const waiting = {
+  connected: true,
+  loginAvailable: true,
+  flow: { id: "flow", state: "waiting" },
+};
+const idle = { connected: false, loginAvailable: true };
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+describe("Codex same-scope projection ordering", () => {
+  it.each(["cancel", "disconnect"] as const)(
+    "ignores older waiting after %s",
+    async (action) => {
+      service.status.mockResolvedValue(waiting);
+      service[action].mockResolvedValue(undefined);
+      const { result } = renderHook(() => useCodexConnection("codex"));
+      await act(async () => {});
+      const old = deferred<typeof waiting>();
+      service.status.mockReturnValueOnce(old.promise).mockResolvedValue(idle);
+      let poll!: Promise<void>;
+      act(() => {
+        poll = result.current.reload();
+      });
+      await act(async () => {
+        await result.current[action]();
+      });
+      expect(result.current.status).toEqual(idle);
+      await act(async () => {
+        old.resolve(waiting);
+        await poll;
+      });
+      expect(result.current.status).toEqual(idle);
+    },
+  );
+
+  it("invalidates reads at command admission, before cancellation finishes", async () => {
+    service.status.mockResolvedValue(waiting);
+    const { result } = renderHook(() => useCodexConnection("codex"));
+    await act(async () => {});
+    const old = deferred<typeof waiting>();
+    const command = deferred<void>();
+    service.status.mockReturnValueOnce(old.promise).mockResolvedValue(idle);
+    service.cancel.mockReturnValueOnce(command.promise);
+    let poll!: Promise<void>, cancel!: Promise<void>;
+    act(() => {
+      poll = result.current.reload();
+      cancel = result.current.cancel();
+    });
+    await act(async () => {
+      old.reject(new Error("stale status failure"));
+      await poll;
+    });
+    expect(result.current.error).toBe(false);
+    await act(async () => {
+      command.resolve();
+      await cancel;
+    });
+    expect(result.current.status).toEqual(idle);
+  });
+
+  it("latest status request wins even if a newer request fails", async () => {
+    service.status.mockResolvedValue(waiting);
+    const { result } = renderHook(() => useCodexConnection("codex"));
+    await act(async () => {});
+    const old = deferred<typeof waiting>();
+    service.status
+      .mockReturnValueOnce(old.promise)
+      .mockRejectedValueOnce(new Error("offline"));
+    let poll!: Promise<void>;
+    act(() => {
+      poll = result.current.reload();
+    });
+    await act(async () => {
+      await result.current.reload();
+    });
+    await act(async () => {
+      old.resolve(waiting);
+      await poll;
+    });
+    expect(result.current.error).toBe(true);
+  });
+});
