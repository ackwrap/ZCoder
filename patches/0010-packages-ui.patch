+import { useStatusCapsuleCompact } from "@/v4/status-capsule/StatusCapsuleContext.js";
+import type { StatusCapsuleMetricProps } from "@/v4/status-capsule/contract.js";
+
+export function StatusCapsuleMetric({ icon, children }: StatusCapsuleMetricProps) {
+  const compact = useStatusCapsuleCompact();
+  return (
+    <div
+      data-status-capsule="true"
+      data-status-capsule-compact={compact ? "true" : "false"}
+      className={[
+        "flex h-8 max-w-full min-w-0 items-center text-ui-base text-[var(--color-foreground)]",
+        "transition-[padding,gap] duration-300 ease-in-out motion-reduce:transition-none",
+        compact ? "w-8 justify-center gap-0 pl-0 pr-0" : "w-max gap-1.5 pl-2 pr-3",
+      ].join(" ")}
+    >
+      {icon}
+      <span data-status-capsule-content="true" className={compact ? "sr-only" : "contents"}>
+        {children}
+      </span>
+    </div>
+  );
+}
