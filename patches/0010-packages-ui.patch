+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, render } from "@testing-library/react";
+import { afterEach, describe, expect, it } from "vitest";
+import type {
+  ContextSourceUpdateProjection,
+  TimelineMarkerRow,
+} from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+import { ConversationRowView } from "@/v4/ConversationRowView.js";
+
+function renderNotice(
+  kind: ContextSourceUpdateProjection["kind"],
+  changes: ContextSourceUpdateProjection["changes"],
+) {
+  const row: TimelineMarkerRow = {
+    rowId: 12,
+    turnId: "turn1",
+    kind: "timelineMarker",
+    createdAt: 1,
+    createdAtSeq: 1,
+    marker: {
+      type: "contextSourceUpdate",
+      update: {
+        version: 1,
+        kind,
+        sourceKey: "PRIVATE CATALOG KEY",
+        revision: "a".repeat(64),
+        changes,
+      },
+    },
+  };
+  return render(
+    createElement(ZCodeIntlProvider, {
+      initialLocale: "en-US",
+      children: createElement(ConversationRowView, {
+        row,
+        context: {
+          workspacePath: "/repo",
+          theme: "light",
+          codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+        },
+      }),
+    }),
+  );
+}
+
+afterEach(cleanup);
+describe("context source update notice", () => {
+  it.each(["skills", "agents", "mcp_tools", "instructions"] as const)(
+    "shows %s changes without a user bubble or body",
+    (kind) => {
+      const view = renderNotice(kind, [
+        { sourceKey: "PRIVATE ITEM KEY", label: "Safe item", change: "added" },
+        { sourceKey: "two", label: "Second", change: "replaced" },
+        { sourceKey: "three", label: "Old", change: "removed" },
+      ]);
+      expect(view.container.textContent).toContain("Safe item");
+      expect(view.container.textContent).toContain("Added");
+      expect(view.container.textContent).toContain("Changed");
+      expect(view.container.textContent).toContain("Removed");
+      expect(view.container.textContent).not.toContain("PRIVATE");
+      expect(view.container.textContent).not.toContain("a".repeat(64));
+      expect(view.container.querySelector('[data-row-kind="userInput"]')).toBeNull();
+      expect(view.container.querySelector('[data-marker-type="contextSourceUpdate"]')).toBeTruthy();
+      expect(view.container.querySelector("details")).toBeNull();
+    },
+  );
+
+  it("keeps a long item list collapsed behind a native disclosure", () => {
+    const view = renderNotice(
+      "skills",
+      Array.from({ length: 6 }, (_, index) => ({
+        sourceKey: `skills:${index}`,
+        label: `Item ${index}`,
+        change: "added" as const,
+      })),
+    );
+    const details = view.container.querySelector("details");
+    expect(details).not.toBeNull();
+    expect(details?.open).toBe(false);
+    expect(details?.hasAttribute("open")).toBe(false);
+    expect(details?.querySelector("summary")?.textContent).toBeTruthy();
+    expect(details?.querySelectorAll("li")).toHaveLength(6);
+  });
+});
