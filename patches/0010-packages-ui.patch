index 0000000000000000000000000000000000000000..ff2b7d8e9fbfe337564a61e96db08787ba2c49a7
--- /dev/null
+++ b/packages/ui/src/v4/composer/mode-switch/runtime.ts
@@ -0,0 +1,266 @@
+/**
+ * 权限模式切换：草稿只决定下一轮提交，运行中的会话必须同时下发
+ * switchCollaborationMode，后续工具准入才会读取新模式（core 每次工具准入都取
+ * 实时 getMode）。plan 由 preservePlan 在服务端保留，不走客户端旧快照。
+ */
+export const SWITCHABLE_COLLABORATION_MODES = ["build", "edit", "guarded", "yolo"] as const;
+
+export type SwitchableCollaborationMode = (typeof SWITCHABLE_COLLABORATION_MODES)[number];
+
+export const MODE_SWITCH_UNCONFIRMED_MESSAGE =
+  "权限切换未确认，当前生效模式待确认，请刷新或重试";
+
+export function isSwitchableCollaborationMode(
+  mode: string,
+): mode is SwitchableCollaborationMode {
+  return (SWITCHABLE_COLLABORATION_MODES as readonly string[]).includes(mode);
+}
+
+export interface ImmediateModeCommandInput {
+  mode: string;
+  sessionId: string | null;
+  /** 快照对应的会话；与 sessionId 不同说明投影还没切换到当前会话。 */
+  liveSessionId: string | null | undefined;
+  /** 本地已知的服务端生效模式；null/未知时不得据此去重。 */
+  acknowledgedMode: string | null | undefined;
+  /**
+   * 已有在途切换意图时，不能用陈旧的 acknowledgedMode 去重：
+   * guarded→yolo→guarded 的最后一次必须保留，等前一条 ACK 后再判断。
+   */
+  hasPendingIntent?: boolean;
+  /** 上次失败后当前生效模式未知；同值选择也不能被旧基线吞掉。 */
+  unknown?: boolean;
+  readOnly: boolean;
+}
+
+/**
+ * 返回需要立即下发的模式；null 表示只更新草稿（草稿态、只读、会话未就绪、
+ * plan 切换、已确认同值且无在途意图、或当前未知但目标已被新的权威状态确认）。
+ */
+export function resolveImmediateModeCommand(
+  input: ImmediateModeCommandInput,
+): SwitchableCollaborationMode | null {
+  if (input.readOnly || !input.sessionId) return null;
+  if (input.liveSessionId !== input.sessionId) return null;
+  if (!isSwitchableCollaborationMode(input.mode)) return null;
+  if (
+    !input.hasPendingIntent &&
+    !input.unknown &&
+    (input.acknowledgedMode ?? "build") === input.mode
+  ) {
+    return null;
+  }
+  return input.mode;
+}
+
+/** UI 侧最小的命令 ACK 视图；与 CommandAck 结构兼容，避免把协议包带进本模块。 */
+export interface ModeSwitchAck {
+  status: string;
+  reasonCode?: string;
+  revisionAtDecision?: number;
+}
+
+export interface ModeSwitchSnapshot {
+  sessionId: string;
+  revision: number;
+  logEpoch: string;
+  mode: string;
+}
+
+export interface ModeSwitchSendInput {
+  sessionId: string;
+  mode: SwitchableCollaborationMode;
+  baseRevision: number;
+  baseLogEpoch: string;
+}
+
+export interface ModeSwitchSequencerOptions {
+  sendMode(input: ModeSwitchSendInput): Promise<ModeSwitchAck>;
+  getSnapshot(): ModeSwitchSnapshot | null;
+  getSessionId(): string | null;
+  getDraftMode(): string | null | undefined;
+  applyDraftMode(mode: string): void;
+  /** 失败时的可见提示；文案由本模块持有，SessionPane 只注入 toast/error 呈现。 */
+  notifyUnconfirmed(message: string): void;
+  warn(message: string): void;
+  maxAttempts?: number;
+}
+
+export interface ModeSwitchSequencer {
+  /** 草稿先回显；运行中会话按最新意图串行下发。 */
+  request(mode: string, options: { readOnly: boolean }): void;
+  /** 会话切换/卸载时丢弃旧会话的在途结果。 */
+  reset(sessionId: string | null): void;
+}
+
+interface SequencerState {
+  sessionId: string | null;
+  acknowledged: string | null;
+  observedSnapshotMode: string;
+  /** 最近一次已确认命令的 base revision/epoch；更旧或同期的快照不能覆盖确认结果。 */
+  snapshotFloorRevision: number;
+  snapshotFloorLogEpoch: string;
+  latest: SwitchableCollaborationMode | null;
+  draining: boolean;
+  unknown: boolean;
+}
+
+/**
+ * 与 React 无关的模式切换编排：串行 CAS、最新意图合并、stale 重基准、跨会话隔离。
+ * 失败后不猜测当前生效模式：草稿保留用户意图，去重基线转为 unknown；unknown 只能由
+ * 用户显式请求实际下发后、以 accepted/noop/duplicate 明确成功重新确认。普通 snapshot
+ * 的 revision/logEpoch/mode 前进不自动解除 unknown。
+ */
+export function createModeSwitchSequencer(
+  options: ModeSwitchSequencerOptions,
+): ModeSwitchSequencer {
+  const maxAttempts = options.maxAttempts ?? 4;
+  const initialState = (sessionId: string | null): SequencerState => {
+    const snapshot = options.getSnapshot();
+    const mode =
+      snapshot && snapshot.sessionId === sessionId ? snapshot.mode : "build";
+    return {
+      sessionId,
+      acknowledged: mode,
+      observedSnapshotMode: mode,
+      snapshotFloorRevision: -1,
+      snapshotFloorLogEpoch: "",
+      latest: null,
+      draining: false,
+      unknown: false,
+    };
+  };
+  let state = initialState(options.getSessionId());
+
+  const request = (mode: string, requestOptions: { readOnly: boolean }): void => {
+    options.applyDraftMode(mode);
+    const sessionId = options.getSessionId();
+    if (!sessionId) return;
+    const snapshot = options.getSnapshot();
+    if (!snapshot || snapshot.sessionId !== sessionId) return;
+    if (state.sessionId !== sessionId) state = initialState(sessionId);
+    else if (!state.draining && state.latest === null && !state.unknown) {
+      const authoritative =
+        snapshot.logEpoch !== state.snapshotFloorLogEpoch ||
+        snapshot.revision > state.snapshotFloorRevision;
+      if (authoritative && snapshot.mode !== state.observedSnapshotMode) {
+        // 空闲时只跟随“快照模式发生变化”这一事实；确认前的旧快照不能回退。
+        state.observedSnapshotMode = snapshot.mode;
+        state.acknowledged = snapshot.mode;
+      }
+    }
+    const commandMode = resolveImmediateModeCommand({
+      mode,
+      sessionId,
+      liveSessionId: snapshot.sessionId,
+      acknowledgedMode: state.acknowledged,
+      hasPendingIntent: state.draining || state.latest !== null,
+      unknown: state.unknown,
+      readOnly: requestOptions.readOnly,
+    });
+    if (!commandMode) return;
+    state.latest = commandMode;
+    if (!state.draining) void drain(sessionId);
+  };
+
+  const reset = (sessionId: string | null): void => {
+    state = initialState(sessionId);
+  };
+
+  async function drain(targetSessionId: string): Promise<void> {
+    const current = state;
+    if (current.draining || current.sessionId !== targetSessionId) return;
+    current.draining = true;
+    try {
+      while (
+        current.sessionId === targetSessionId &&
+        options.getSessionId() === targetSessionId &&
+        current.latest
+      ) {
+        const requested = current.latest;
+        if (!current.unknown && requested === current.acknowledged) {
+          if (current.latest === requested) current.latest = null;
+          continue;
+        }
+        let ack: ModeSwitchAck | null = null;
+        let failure: unknown = null;
+        let lastSnapshot: ModeSwitchSnapshot | null = null;
+        let lastBaseRevision: number | undefined;
+        let lastBaseLogEpoch: string | undefined;
+        let rebasedRevision: number | undefined;
+        let attemptLogEpoch: string | undefined;
+        for (let attempt = 0; attempt < maxAttempts; attempt++) {
+          const snapshot = options.getSnapshot();
+          if (!snapshot || snapshot.sessionId !== targetSessionId) {
+            failure = new Error("session snapshot unavailable");
+            break;
+          }
+          lastSnapshot = snapshot;
+          // stale 后优先用最新快照；快照尚未追平时用 ACK 的 revisionAtDecision 收敛。
+          // logEpoch 变化说明换了一段日志，旧 revision 不能再参与 max。
+          if (attemptLogEpoch !== undefined && attemptLogEpoch !== snapshot.logEpoch) {
+            rebasedRevision = snapshot.revision;
+          }
+          const baseRevision = Math.max(snapshot.revision, rebasedRevision ?? 0);
+          const baseLogEpoch = snapshot.logEpoch;
+          attemptLogEpoch = baseLogEpoch;
+          lastBaseRevision = baseRevision;
+          lastBaseLogEpoch = baseLogEpoch;
+          try {
+            ack = await options.sendMode({
+              sessionId: targetSessionId,
+              mode: requested,
+              baseRevision,
+              baseLogEpoch,
+            });
+          } catch (error) {
+            failure = error;
+            ack = null;
+            break;
+          }
+          if (ack.status !== "stale") break;
+          rebasedRevision = Math.max(baseRevision, ack.revisionAtDecision ?? baseRevision);
+        }
+        // 会话切换/卸载/替换状态后的迟到结果不得写回当前草稿。
+        if (
+          state !== current ||
+          current.sessionId !== targetSessionId ||
+          options.getSessionId() !== targetSessionId
+        ) {
+          return;
+        }
+        if (
+          ack &&
+          (ack.status === "accepted" || ack.status === "noop" || ack.status === "duplicate")
+        ) {
+          current.acknowledged = requested;
+          current.observedSnapshotMode = requested;
+          // 确认结果高于用于命令的 base 快照；后续更旧的快照不能把它改回去。
+          current.snapshotFloorRevision =
+            lastBaseRevision ?? lastSnapshot?.revision ?? -1;
+          current.snapshotFloorLogEpoch =
+            lastBaseLogEpoch ?? lastSnapshot?.logEpoch ?? "";
+          current.unknown = false;
+          if (current.latest === requested) current.latest = null;
+          continue;
+        }
+        const superseded = current.latest !== requested;
+        if (!superseded) current.latest = null;
+        // 不猜测旧 mode、不回改草稿，也不从普通 snapshot 自动恢复。
+        // 去重基线保持 unknown，直到用户再次显式请求并收到明确成功。
+        current.acknowledged = null;
+        current.unknown = true;
+        options.notifyUnconfirmed(MODE_SWITCH_UNCONFIRMED_MESSAGE);
+        options.warn(
+          `[v4-pane] 切换协作模式未确认: ${requested} ${
+            ack ? `${ack.status} ${ack.reasonCode ?? ""}` : String(failure)
+          }`,
+        );
+      }
+    } finally {
+      current.draining = false;
+    }
+  }
+
+  return { request, reset };
+}
