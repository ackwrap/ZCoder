diff --git a/packages/ui/src/v4/background-bash-output-dialog/BackgroundBashOutputDialog.tsx b/packages/ui/src/v4/background-bash-output-dialog/BackgroundBashOutputDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4da272700fd65ca94a85bbf5e2b578fce0c68709
--- /dev/null
+++ b/packages/ui/src/v4/background-bash-output-dialog/BackgroundBashOutputDialog.tsx
@@ -0,0 +1,92 @@
+import { memo } from "react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog.js";
+import { BackgroundBashOutputSidePane } from "@/app-shell/BackgroundBashOutputSidePane.js";
+import type { CodeViewerSource } from "@/lib/codeViewer.js";
+import type { BackgroundBashSidePaneTab } from "@/lib/workspaceSidePane.js";
+
+export interface BackgroundBashDialogScope {
+  sessionId: string | null;
+  workspacePath: string;
+  workspaceIdentity?: string;
+  remoteSessionId?: string;
+}
+
+export interface BackgroundBashOutputDialogProps {
+  tab: BackgroundBashSidePaneTab | null;
+  scope: BackgroundBashDialogScope;
+  onDismiss: () => void;
+  onOpenCodeViewer?: (source: CodeViewerSource) => void;
+}
+
+/**
+ * 作用域键必须逐项包含 session / path / identity / remote。不能退化成
+ * `identity || path`：identity 相同而 path 变化同样是另一份对话。
+ */
+export function backgroundBashScopeKey(scope: BackgroundBashDialogScope): string {
+  return JSON.stringify([
+    scope.sessionId ?? null,
+    scope.workspacePath,
+    scope.workspaceIdentity?.trim() ?? null,
+    scope.remoteSessionId?.trim() ?? null,
+  ]);
+}
+
+/**
+ * 弹窗只属于打开它的会话作用域。session / workspace identity / path / remote 任一变化
+ * 都视为另一份对话：不渲染旧 tab，避免旧输出或旧回调进入新会话；调用方同时清除
+ * tab 状态，从而卸载 side pane 并停止轮询。
+ */
+export function backgroundBashTabInScope(
+  tab: BackgroundBashSidePaneTab | null,
+  scope: BackgroundBashDialogScope,
+): BackgroundBashSidePaneTab | null {
+  if (!tab || !scope.sessionId) return null;
+  if (tab.ownerTaskId !== scope.sessionId) return null;
+  if (tab.workspacePath !== scope.workspacePath) return null;
+  if ((tab.workspaceIdentity?.trim() ?? "") !== (scope.workspaceIdentity?.trim() ?? "")) {
+    return null;
+  }
+  if ((tab.remoteSessionId ?? "") !== (scope.remoteSessionId ?? "")) return null;
+  return tab;
+}
+
+/**
+ * 后台 Bash 输出模态框。刻意渲染在 SessionPane 的只读分支之外：子智能体只读 pane
+ * 也能查看后台输出；写操作仍由 SessionPane 的 readOnly 门禁控制。
+ * 完整文件入口先关闭弹窗，再把查看焦点交给右侧 code viewer，避免文件被遮罩挡住。
+ */
+export const BackgroundBashOutputDialog = memo(function BackgroundBashOutputDialog({
+  tab,
+  scope,
+  onDismiss,
+  onOpenCodeViewer,
+}: BackgroundBashOutputDialogProps) {
+  const scopedTab = backgroundBashTabInScope(tab, scope);
+  const openFullFile = (source: CodeViewerSource): void => {
+    onDismiss();
+    onOpenCodeViewer?.(source);
+  };
+  return (
+    <Dialog
+      open={scopedTab !== null}
+      onOpenChange={(open) => {
+        if (!open) onDismiss();
+      }}
+    >
+      <DialogContent className="flex h-[min(70vh,640px)] max-w-3xl flex-col gap-0 overflow-hidden p-0">
+        <DialogHeader className="border-b border-border px-4 py-3 pr-12 text-left">
+          <DialogTitle className="truncate text-ui-base">{scopedTab?.title ?? ""}</DialogTitle>
+        </DialogHeader>
+        <div className="min-h-0 flex-1">
+          {scopedTab ? (
+            <BackgroundBashOutputSidePane
+              tab={scopedTab}
+              visible
+              onOpenCodeViewer={onOpenCodeViewer ? openFullFile : undefined}
+            />
+          ) : null}
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+});
