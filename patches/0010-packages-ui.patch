@@ -0,0 +1,333 @@
+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { PreviewPane } from "@/PreviewPane.js";
+
+const mocks = vi.hoisted(() => {
+  const fileService = {
+    readTextFile: vi.fn(async () => ({
+      path: "/workspace/src/app.ts",
+      content: "export const value = 1;",
+      offset: 0,
+      bytesRead: 23,
+      totalBytes: 23,
+      truncated: false,
+      isBinary: false,
+    })),
+  };
+  return {
+    fileService,
+    services: { fileService },
+    platform: {
+      getInstalledEditors: vi.fn(async () => []),
+      openInEditor: vi.fn(async () => ({ success: false })),
+      openInFileManager: vi.fn(async () => ({ success: false })),
+    },
+  };
+});
+
+vi.mock("@/hooks/usePlatform.js", () => ({
+  usePlatform: () => mocks.platform,
+}));
+
+vi.mock("@/hooks/useWorkspaceServices.js", () => ({
+  useWorkspaceServices: () => mocks.services,
+}));
+
+vi.mock("@/hooks/useWorkspaceOpenInEditorTarget.js", () => ({
+  useWorkspaceOpenInEditorTarget: () => ({
+    isRemoteWorkspace: false,
+    remoteTarget: undefined,
+  }),
+}));
+
+vi.mock("@/hooks/useFileContextActions.js", () => ({
+  useFileContextActions: () => ({
+    copyAbsolutePath: vi.fn(),
+    copyRelativePath: vi.fn(),
+  }),
+}));
+
+vi.mock("@/store/StoreProvider.js", () => ({
+  useZCodeStore: <T,>(selector: (state: Record<string, unknown>) => T) =>
+    selector({
+      codePreviewSettings: {
+        darkTheme: "github-dark",
+        fontSizePx: 12,
+        lightTheme: "github-light",
+        showLineNumbers: true,
+        wrapLongLines: false,
+      },
+      theme: "light",
+    }),
+}));
+
+vi.mock("@/previewPaneMarkdownContent.js", () => ({
+  MarkdownPreviewContent: () => createElement("div", { "data-testid": "markdown-preview" }),
+}));
+
+vi.mock("@pierre/diffs/react", () => ({
+  File: ({
+    file,
+    lineAnnotations,
+    options,
+    renderAnnotation,
+    selectedLines,
+  }: {
+    file?: { contents?: string };
+    lineAnnotations?: unknown[];
+    options?: { onLineSelectionEnd?: (range: { start: number; end: number }) => void };
+    renderAnnotation?: (annotation: unknown) => unknown;
+    selectedLines?: { start: number; end: number } | null;
+  }) =>
+    createElement(
+      "div",
+      {
+        "data-testid": "diffs-file",
+        "data-code": file?.contents,
+        "data-selected-lines": selectedLines ? `${selectedLines.start}-${selectedLines.end}` : "",
+      },
+      createElement(
+        "button",
+        {
+          type: "button",
+          "data-testid": "select-line",
+          onClick: () => options?.onLineSelectionEnd?.({ start: 1, end: 1 }),
+        },
+        "select",
+      ),
+      ...(lineAnnotations?.map((annotation, index) =>
+        createElement("div", { key: index }, renderAnnotation?.(annotation)),
+      ) ?? []),
+    ),
+  MultiFileDiff: () => createElement("diffs-multi-file"),
+  PatchDiff: () => createElement("diffs-patch"),
+}));
+
+function source() {
+  return {
+    type: "file" as const,
+    title: "app.ts",
+    path: "/workspace/src/app.ts",
+    workspacePath: "/workspace",
+  };
+}
+
+function markdownSource() {
+  return {
+    type: "file" as const,
+    title: "README.md",
+    path: "/workspace/README.md",
+    workspacePath: "/workspace",
+  };
+}
+
+function fileSlice(path: string, content: string) {
+  return {
+    path,
+    content,
+    offset: 0,
+    bytesRead: content.length,
+    totalBytes: content.length,
+    truncated: false,
+    isBinary: false,
+  };
+}
+
+function previewElement(
+  nextSource: ReturnType<typeof source>,
+  onDirtyChange?: (dirty: boolean) => void,
+) {
+  return createElement(
+    ZCodeIntlProvider,
+    { initialLocale: "en-US" },
+    createElement(PreviewPane, {
+      onClose: vi.fn(),
+      source: nextSource,
+      onCodeCommentDraftDirtyChange: onDirtyChange,
+    }),
+  );
+}
+
+function renderPreviewPane(
+  nextSource: ReturnType<typeof source>,
+  onDirtyChange?: (dirty: boolean) => void,
+) {
+  return render(previewElement(nextSource, onDirtyChange));
+}
+
+beforeEach(() => {
+  mocks.fileService.readTextFile = vi.fn(async () =>
+    fileSlice("/workspace/src/app.ts", "export const value = 1;"),
+  );
+  mocks.services.fileService = mocks.fileService;
+});
+
+afterEach(() => {
+  cleanup();
+});
+
+describe("PreviewPane dirty file reopen", () => {
+  it("keeps a same-file draft and selected range when a new source object reopens it", async () => {
+    const dirtyValues: boolean[] = [];
+    const view = renderPreviewPane(source(), (dirty) => dirtyValues.push(dirty));
+
+    await waitFor(() => expect(mocks.fileService.readTextFile).toHaveBeenCalledTimes(1));
+    fireEvent.click(await view.findByTestId("select-line"));
+    const textarea = await view.findByRole("textbox");
+    fireEvent.change(textarea, { target: { value: "please check this line" } });
+    await waitFor(() => expect(dirtyValues).toContain(true));
+
+    expect(view.getByTestId("diffs-file").getAttribute("data-selected-lines")).toBe("1-1");
+
+    // 新对象、同一文件：不能清空 filePreview 进入 loading，否则 CodeViewer 卸载丢草稿。
+    view.rerender(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "en-US" },
+        createElement(PreviewPane, {
+          onClose: vi.fn(),
+          source: source(),
+          onCodeCommentDraftDirtyChange: (dirty: boolean) => dirtyValues.push(dirty),
+        }),
+      ),
+    );
+
+    await waitFor(() => {
+      expect((view.getByRole("textbox") as HTMLTextAreaElement).value).toBe(
+        "please check this line",
+      );
+      expect(view.getByTestId("diffs-file").getAttribute("data-selected-lines")).toBe("1-1");
+    });
+    expect(mocks.fileService.readTextFile).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps markdown code mode and its draft when the same file reopens", async () => {
+    mocks.fileService.readTextFile.mockResolvedValueOnce(
+      fileSlice("/workspace/README.md", "# Title\n\nbody"),
+    );
+    const view = renderPreviewPane(markdownSource());
+
+    await waitFor(() => expect(mocks.fileService.readTextFile).toHaveBeenCalledTimes(1));
+    const moreButton = view.getByRole("button", { name: "More" });
+    fireEvent.pointerDown(moreButton, { button: 0, ctrlKey: false, pointerType: "mouse" });
+    fireEvent.click(moreButton);
+    fireEvent.click(await view.findByRole("menuitemradio", { name: "Source" }));
+
+    fireEvent.click(await view.findByTestId("select-line"));
+    const textarea = await view.findByRole("textbox");
+    fireEvent.change(textarea, { target: { value: "markdown draft" } });
+    await waitFor(() =>
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("# Title"),
+    );
+
+    view.rerender(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "en-US" },
+        createElement(PreviewPane, {
+          onClose: vi.fn(),
+          source: markdownSource(),
+        }),
+      ),
+    );
+
+    await waitFor(() => {
+      expect((view.getByRole("textbox") as HTMLTextAreaElement).value).toBe("markdown draft");
+    });
+    expect(mocks.fileService.readTextFile).toHaveBeenCalledTimes(1);
+  });
+
+  it("ignores a late result from a replaced file service for the same source", async () => {
+    let resolveOld: (value: ReturnType<typeof fileSlice>) => void = () => {};
+    const oldRead = vi.fn(
+      () =>
+        new Promise<ReturnType<typeof fileSlice>>((resolve) => {
+          resolveOld = resolve;
+        }),
+    );
+    mocks.services.fileService = { readTextFile: oldRead };
+    const stableSource = source();
+    const view = renderPreviewPane(stableSource);
+
+    await waitFor(() => expect(oldRead).toHaveBeenCalledTimes(1));
+
+    const newRead = vi.fn(async () =>
+      fileSlice("/workspace/src/app.ts", "export const value = 'NEW';"),
+    );
+    mocks.services.fileService = { readTextFile: newRead };
+    view.rerender(previewElement(stableSource));
+
+    await waitFor(() =>
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("NEW"),
+    );
+    resolveOld(fileSlice("/workspace/src/app.ts", "export const value = 'OLD';"));
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("NEW");
+  });
+
+  it("keeps a dirty draft while a replaced file service refreshes the same document", async () => {
+    const stableSource = source();
+    const onDirty = vi.fn();
+    mocks.fileService.readTextFile.mockResolvedValueOnce(
+      fileSlice("/workspace/src/app.ts", "export const value = 'BASE';"),
+    );
+    const view = renderPreviewPane(stableSource, onDirty);
+
+    await waitFor(() =>
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("BASE"),
+    );
+    fireEvent.click(await view.findByTestId("select-line"));
+    const textarea = await view.findByRole("textbox");
+    fireEvent.change(textarea, { target: { value: "keep this draft" } });
+    await waitFor(() => expect(onDirty).toHaveBeenCalledWith(true));
+
+    let resolveRefresh: (value: ReturnType<typeof fileSlice>) => void = () => {};
+    const refreshRead = vi.fn(
+      () =>
+        new Promise<ReturnType<typeof fileSlice>>((resolve) => {
+          resolveRefresh = resolve;
+        }),
+    );
+    mocks.services.fileService = { readTextFile: refreshRead };
+    view.rerender(previewElement(stableSource, onDirty));
+
+    await waitFor(() => expect(refreshRead).toHaveBeenCalledTimes(1));
+    expect((view.getByRole("textbox") as HTMLTextAreaElement).value).toBe("keep this draft");
+
+    resolveRefresh(fileSlice("/workspace/src/app.ts", "export const value = 'REFRESHED';"));
+    await waitFor(() =>
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("REFRESHED"),
+    );
+    expect((view.getByRole("textbox") as HTMLTextAreaElement).value).toBe("keep this draft");
+  });
+
+  it("refreshes a clean same-file reopen from disk", async () => {
+    mocks.fileService.readTextFile
+      .mockResolvedValueOnce(fileSlice("/workspace/src/app.ts", "export const value = 'OLD';"))
+      .mockResolvedValueOnce(fileSlice("/workspace/src/app.ts", "export const value = 'NEW';"));
+    const view = renderPreviewPane(source());
+
+    await waitFor(() =>
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("OLD"),
+    );
+
+    view.rerender(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "en-US" },
+        createElement(PreviewPane, {
+          onClose: vi.fn(),
+          source: source(),
+        }),
+      ),
+    );
+
+    await waitFor(() => {
+      expect(mocks.fileService.readTextFile).toHaveBeenCalledTimes(2);
+      expect(view.getByTestId("diffs-file").getAttribute("data-code")).toContain("NEW");
+    });
+  });
+});
