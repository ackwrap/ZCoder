@@ -0,0 +1,898 @@
+/**
+ * 阿里云验证码（aliyunCaptcha）控制器 —— 从官方 3.16.3 的 `request-security-edition` 逐条还原。
+ *
+ * 官方行为（关键点，全部保留）：
+ *   - 脚本：https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js（单例加载）
+ *   - 全局握手：window.AliyunRequestVerificationConfig = { region, prefix }
+ *   - init：initAliyunCaptcha({ SceneId, mode, language, captchaLogoImg, showErrorTip:false,
+ *           element:"#zcode-aliyun-captcha-element", button:"#zcode-aliyun-captcha-button",
+ *           getInstance, success, fail, onError })
+ *   - 优先无感：instance.startTracelessVerification()；不可用/失败且允许交互时点隐藏 button
+ *   - 结果判定：success===true && verifyResult===true 或 verifyCode==="T006" 视为通过；
+ *           success && !verifyResult 且 verifyCode 为 F015/空 视为"等待升级"（不当失败）；
+ *           F008 = 重复提交
+ *   - 超时：实例 10s、脚本就绪后 2s 触发延迟、整体 120s
+ *   - 串行队列：同时只允许一次验证码交互（多 provider 串行）
+ *   - 配置缓存：getRequestVerificationConfig() 结果缓存 60s
+ */
+
+import type { RequestVerificationConfig } from "@zcode/shared";
+
+import { logger } from "@/logger.js";
+
+const CAPTCHA_SCRIPT_URL = "https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js";
+const CAPTCHA_INIT_TIMEOUT_MS = 10_000;
+const CAPTCHA_SCRIPT_SETTLE_MS = 2_000;
+const CAPTCHA_VERIFY_TIMEOUT_MS = 120_000;
+const CAPTCHA_CONFIG_TTL_MS = 60_000;
+const CAPTCHA_INIT_REUSE_MS = 120_000;
+
+export const CAPTCHA_CONTAINER_ID = "zcode-aliyun-captcha-container";
+export const CAPTCHA_MOUNT_ID = "zcode-aliyun-captcha-element";
+export const CAPTCHA_BUTTON_ID = "zcode-aliyun-captcha-button";
+
+/** 验证码需要交互（弹窗）时抛出的类型化错误。 */
+export class CaptchaInteractiveRequiredError extends Error {
+  readonly code = "CAPTCHA_INTERACTIVE_REQUIRED";
+  constructor(message = "Captcha requires interactive verification.") {
+    super(message);
+    this.name = "CaptchaInteractiveRequiredError";
+  }
+}
+
+export interface CaptchaRuntimeConfig {
+  region: string;
+  prefix: string;
+  sceneId: string;
+  language?: string;
+  mode?: string;
+  captchaLogoImg?: string;
+}
+
+interface AliyunCaptchaInstance {
+  startTracelessVerification?: () => void;
+  show?: () => void;
+}
+
+interface AliyunCaptchaSdkResult {
+  success?: boolean;
+  verifyResult?: boolean;
+  verifyCode?: string;
+  VerifyCode?: string;
+  certifyId?: string;
+  captchaVerifyParam?: string;
+  CaptchaVerifyParam?: string;
+  [key: string]: unknown;
+}
+
+interface AliyunCaptchaSdkOptions {
+  SceneId: string;
+  mode?: string;
+  language?: string;
+  captchaLogoImg?: string;
+  showErrorTip?: boolean;
+  element: string;
+  button: string;
+  getInstance: (instance: AliyunCaptchaInstance) => void;
+  success: (captchaVerifyParam: string) => void;
+  fail: (result: AliyunCaptchaSdkResult) => void;
+  onError: (error: unknown) => void;
+}
+
+declare global {
+  interface Window {
+    initAliyunCaptcha?: (options: AliyunCaptchaSdkOptions) => Promise<unknown> | undefined;
+    AliyunRequestVerificationConfig?: { region: string; prefix: string };
+  }
+}
+
+// ───────────────────────────────────────────────────────────── 配置
+
+/** 验证码配置是否可用；缺 region/prefix/sceneId 或显式 disabled 都视为不可用。 */
+export function isCaptchaVerificationUnavailable(config: RequestVerificationConfig | null | undefined): boolean {
+  if (!config || config.enabled === false) return true;
+  return !config.region || !config.prefix || !config.sceneId;
+}
+
+function resolveCaptchaLanguage(): string {
+  try {
+    const preference = localStorage.getItem("zcode-locale-preference");
+    if (preference === "zh-CN") return "cn";
+    if (preference === "en-US") return "en";
+  } catch {
+    // localStorage 不可用时按浏览器语言
+  }
+  return typeof navigator !== "undefined" && navigator.language.toLowerCase().startsWith("zh")
+    ? "cn"
+    : "en";
+}
+
+function toRuntimeConfig(config: RequestVerificationConfig): CaptchaRuntimeConfig {
+  return {
+    region: String(config.region),
+    prefix: String(config.prefix),
+    sceneId: String(config.sceneId),
+    language: resolveCaptchaLanguage(),
+    ...(config.mode ? { mode: config.mode } : {}),
+    ...(config.captchaLogoImg ? { captchaLogoImg: config.captchaLogoImg } : {}),
+  };
+}
+
+// ────────────────────────────────────────────────────── 结果解析（官方语义）
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : null;
+}
+
+function readSdkResult(value: unknown): AliyunCaptchaSdkResult | null {
+  const record = asRecord(value);
+  if (!record) return null;
+  const verifyCode =
+    typeof record.verifyCode === "string"
+      ? record.verifyCode
+      : typeof record.VerifyCode === "string"
+        ? record.VerifyCode
+        : undefined;
+  return {
+    ...record,
+    success: typeof record.success === "boolean" ? record.success : undefined,
+    verifyResult: typeof record.verifyResult === "boolean" ? record.verifyResult : undefined,
+    verifyCode,
+    certifyId: typeof record.certifyId === "string" ? record.certifyId : undefined,
+  };
+}
+
+function terminalPass(value: unknown): boolean {
+  const result = readSdkResult(value);
+  if (!result) return false;
+  return (result.success === true && result.verifyResult === true) || result.verifyCode === "T006";
+}
+
+function awaitingUpgrade(value: unknown): boolean {
+  const result = readSdkResult(value);
+  if (!result) return false;
+  return (
+    result.success === true &&
+    result.verifyResult === false &&
+    (!result.verifyCode || result.verifyCode === "F015")
+  );
+}
+
+function duplicateSubmission(value: unknown): boolean {
+  return readSdkResult(value)?.verifyCode === "F008";
+}
+
+function readCaptchaParam(value: unknown): string | undefined {
+  const record = asRecord(value);
+  if (!record) return undefined;
+  const raw =
+    typeof record.captchaVerifyParam === "string"
+      ? record.captchaVerifyParam
+      : typeof record.CaptchaVerifyParam === "string"
+        ? record.CaptchaVerifyParam
+        : undefined;
+  return raw?.trim() || undefined;
+}
+
+function readCertifyId(value: unknown): string | undefined {
+  const text = typeof value === "string" ? value.trim() : "";
+  if (!text.startsWith("{")) return undefined;
+  try {
+    const parsed = JSON.parse(text) as { certifyId?: unknown };
+    return typeof parsed.certifyId === "string" ? parsed.certifyId : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+// ───────────────────────────────────────────────────────── 诊断 / 上报
+
+export type CaptchaArmsResult = "traceless_passed" | "interactive_displayed" | "interactive_passed";
+
+interface CaptchaReporter {
+  reportArmsCustomEvent(payload: {
+    name: string;
+    group: string;
+    value?: number;
+    properties?: Record<string, string | number | boolean | undefined>;
+  }): Promise<void>;
+}
+
+let captchaReporter: CaptchaReporter | null = null;
+
+/** Root 挂载时注入 platform（ARMS 上报出口）。 */
+export function setCaptchaReporter(reporter: CaptchaReporter | null): void {
+  captchaReporter = reporter;
+}
+
+function reportCaptchaOutcome(input: {
+  result: CaptchaArmsResult;
+  source: string;
+  providerId?: string;
+}): void {
+  const traceless = input.result === "traceless_passed";
+  const interactive =
+    input.result === "interactive_displayed" || input.result === "interactive_passed";
+  void captchaReporter
+    ?.reportArmsCustomEvent({
+      name: "aliyun_captcha_verification",
+      group: "captcha",
+      value: 1,
+      properties: {
+        result: input.result,
+        source: input.source,
+        provider_id: input.providerId ?? "",
+        traceless_passed: traceless,
+        captcha_displayed: interactive,
+        traceless_passed_count: traceless ? 1 : 0,
+        captcha_displayed_count: interactive ? 1 : 0,
+      },
+    })
+    .catch((error: unknown) => {
+      logger.warn("[captcha] ARMS 自定义事件上报失败", {
+        result: input.result,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    });
+}
+
+function errorKindOf(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  if (message.startsWith("Captcha instance timed out after ")) return "instance_timeout";
+  if (message.startsWith("Captcha initialization timed out.")) return "initialization_timeout";
+  if (message === "Failed to load captcha script.") return "script_load_failed";
+  if (message.startsWith("Captcha verification timed out after ")) return "verification_timeout";
+  if (message.startsWith("Traceless captcha timed out after ")) return "traceless_timeout";
+  return "unknown";
+}
+
+function createDiagnostics(context: { requestId?: string; providerId?: string; source: string }) {
+  const attemptId =
+    globalThis.crypto?.randomUUID?.() ??
+    `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
+  const startedAt = Date.now();
+  let emitted = 0;
+  let stage = "start";
+  const emit = (event: string, extra: Record<string, unknown> = {}, force = false) => {
+    if (!force && emitted++ >= 32) return;
+    logger.lifecycle.info("[captcha-diagnostics]", {
+      event,
+      attemptId,
+      requestId: context.requestId,
+      providerId: context.providerId,
+      source: context.source,
+      elapsedMs: Date.now() - startedAt,
+      stage,
+      ...extra,
+    });
+  };
+  emit("attempt.start");
+  return {
+    event: emit,
+    stage(next: string) {
+      stage = next;
+      emit("attempt.stage");
+    },
+    end(outcome: string, error?: unknown) {
+      emit(
+        "attempt.end",
+        { outcome, ...(error ? { errorKind: errorKindOf(error) } : {}) },
+        true,
+      );
+    },
+  };
+}
+
+// ─────────────────────────────────────────────────────── 脚本 / 实例管理
+
+let scriptPromise: Promise<void> | null = null;
+let scriptLoadedAt = 0;
+let controller: ControllerState | null = null;
+let initializing: { drain?: Promise<void>; completion: Promise<void> } | null = null;
+let verificationInFlight = false;
+let session: VerificationSession | null = null;
+let verifyQueue: Promise<unknown> = Promise.resolve();
+
+interface ControllerState {
+  configKey: string;
+  buttonElement: HTMLButtonElement;
+  buttonSelector: string;
+  instancePromise: Promise<AliyunCaptchaInstance>;
+  initStartedAt: number;
+}
+
+interface VerificationSession {
+  resolve: (param: string) => void;
+  reject: (error: unknown) => void;
+  allowInteractive: boolean;
+  awaitingDeferredSdkSuccess?: boolean;
+  onInteractiveChallenge?: () => void;
+}
+
+function withAbort<T>(promise: Promise<T>, signal: AbortSignal | undefined): Promise<T> {
+  if (!signal) return promise;
+  return new Promise<T>((resolve, reject) => {
+    const onAbort = () => {
+      cleanup();
+      reject(signal.reason);
+    };
+    const cleanup = () => signal.removeEventListener("abort", onAbort);
+    promise.then(
+      (value) => {
+        cleanup();
+        resolve(value);
+      },
+      (error) => {
+        cleanup();
+        reject(error);
+      },
+    );
+    if (signal.aborted) onAbort();
+    else signal.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+function loadCaptchaScript(): Promise<void> {
+  if (scriptPromise) return scriptPromise;
+  scriptPromise = new Promise<void>((resolve, reject) => {
+    if (typeof window === "undefined" || typeof document === "undefined") {
+      reject(new Error("Captcha requires browser environment."));
+      return;
+    }
+    if (typeof window.initAliyunCaptcha === "function") {
+      resolve();
+      return;
+    }
+    const fail = (node: HTMLScriptElement) => {
+      node.remove();
+      reject(new Error("Failed to load captcha script."));
+    };
+    const existing = document.querySelector<HTMLScriptElement>(
+      `script[src="${CAPTCHA_SCRIPT_URL}"]`,
+    );
+    if (existing) {
+      existing.addEventListener("load", () => resolve(), { once: true });
+      existing.addEventListener("error", () => fail(existing), { once: true });
+      return;
+    }
+    const script = document.createElement("script");
+    script.src = CAPTCHA_SCRIPT_URL;
+    script.async = true;
+    script.onload = () => {
+      scriptLoadedAt = Date.now();
+      resolve();
+    };
+    script.onerror = () => fail(script);
+    document.head.appendChild(script);
+  }).catch((error) => {
+    scriptPromise = null;
+    throw error;
+  });
+  return scriptPromise;
+}
+
+function requireHostElements(): { mountElement: HTMLElement; buttonElement: HTMLButtonElement } {
+  if (typeof document === "undefined") throw new Error("Captcha host container is not mounted.");
+  const mountElement = document.getElementById(CAPTCHA_MOUNT_ID);
+  const buttonElement = document.getElementById(CAPTCHA_BUTTON_ID);
+  if (!(mountElement instanceof HTMLElement)) {
+    throw new Error("Captcha host element is not mounted.");
+  }
+  if (!(buttonElement instanceof HTMLButtonElement)) {
+    throw new Error("Captcha host button is not mounted.");
+  }
+  return { mountElement, buttonElement };
+}
+
+function resetController(): void {
+  session = null;
+  controller = null;
+  if (typeof document !== "undefined") {
+    document.getElementById(CAPTCHA_MOUNT_ID)?.replaceChildren();
+  }
+}
+
+function configKeyOf(config: CaptchaRuntimeConfig): string {
+  return [
+    config.region,
+    config.prefix,
+    config.sceneId,
+    config.mode ?? "popup",
+    config.language ?? "",
+    config.captchaLogoImg,
+  ].join("::");
+}
+
+function handleSdkFail(
+  result: unknown,
+  rejectInit: (error: unknown) => void,
+  diagnostics: { event: (name: string, extra?: Record<string, unknown>) => void },
+): void {
+  const parsed = readSdkResult(result);
+  const active = session;
+  diagnostics.event("sdk.fail", { verifyCode: parsed?.verifyCode ?? null });
+  logger.info("[captcha] aliyun sdk fail", parsed ?? result);
+
+  if (terminalPass(result)) {
+    const param = readCaptchaParam(result);
+    if (param) {
+      session = null;
+      active?.resolve(param);
+      return;
+    }
+    if (active) active.awaitingDeferredSdkSuccess = true;
+    return;
+  }
+  if (awaitingUpgrade(result)) {
+    if (!active) {
+      rejectInit(new CaptchaInteractiveRequiredError());
+      return;
+    }
+    if (!active.allowInteractive) {
+      session = null;
+      active.reject(new CaptchaInteractiveRequiredError());
+      return;
+    }
+    active.awaitingDeferredSdkSuccess = true;
+    active.onInteractiveChallenge?.();
+    return;
+  }
+  if (duplicateSubmission(result)) {
+    logger.warn("[captcha] aliyun sdk duplicate submission", parsed ?? result);
+    resetController();
+    active?.reject(result ?? new Error("Captcha verification data was already submitted."));
+    return;
+  }
+  if (active && !active.allowInteractive) {
+    session = null;
+    active.reject(new CaptchaInteractiveRequiredError());
+    return;
+  }
+  rejectInit(result ?? new Error("Captcha failed before instance ready."));
+  session = null;
+  active?.reject(result ?? new Error("Captcha failed."));
+}
+
+async function drainInitialization(signal: AbortSignal | undefined): Promise<void> {
+  while (initializing) {
+    const pending = initializing;
+    pending.drain ??= new Promise<void>((resolve, reject) => {
+      const timer = window.setTimeout(() => {
+        reject(
+          new Error("Captcha initialization timed out. Please restart the app or reload the page and try again."),
+        );
+      }, CAPTCHA_INIT_TIMEOUT_MS);
+      pending.completion.then(
+        () => {
+          window.clearTimeout(timer);
+          resolve();
+        },
+        () => {
+          window.clearTimeout(timer);
+          resolve();
+        },
+      );
+    });
+    await withAbort(pending.drain, signal);
+  }
+}
+
+async function ensureController(
+  config: CaptchaRuntimeConfig,
+  diagnostics: { event: (name: string, extra?: Record<string, unknown>) => void; stage: (name: string) => void },
+  signal: AbortSignal | undefined,
+  reuseOnly = false,
+): Promise<ControllerState | null> {
+  signal?.throwIfAborted();
+  const key = configKeyOf(config);
+  const reusable = () =>
+    controller !== null &&
+    controller.configKey === key &&
+    Date.now() - controller.initStartedAt < CAPTCHA_INIT_REUSE_MS;
+
+  if (reusable()) return controller;
+  if (controller) resetController();
+  if (initializing) {
+    diagnostics.stage("initialization_drain");
+    await drainInitialization(signal);
+  }
+  if (reuseOnly) return null;
+  if (reusable()) return controller;
+
+  window.AliyunRequestVerificationConfig = { region: config.region, prefix: config.prefix };
+  diagnostics.stage("script_load");
+  await withAbort(loadCaptchaScript(), signal);
+  diagnostics.event("script.ready");
+  signal?.throwIfAborted();
+  if (initializing) {
+    diagnostics.stage("initialization_drain");
+    await drainInitialization(signal);
+  }
+  if (reusable()) return controller;
+
+  const initAliyunCaptcha = window.initAliyunCaptcha;
+  if (typeof initAliyunCaptcha !== "function") throw new Error("Captcha SDK is unavailable.");
+  const { buttonElement } = requireHostElements();
+  window.AliyunRequestVerificationConfig = { region: config.region, prefix: config.prefix };
+
+  let resolveInstance!: (instance: AliyunCaptchaInstance) => void;
+  let rejectInstance!: (error: unknown) => void;
+  const state: ControllerState = {
+    configKey: key,
+    buttonElement,
+    buttonSelector: `#${CAPTCHA_BUTTON_ID}`,
+    instancePromise: new Promise<AliyunCaptchaInstance>((resolve, reject) => {
+      resolveInstance = resolve;
+      rejectInstance = reject;
+    }),
+    initStartedAt: Date.now(),
+  };
+  controller = state;
+  const isCurrent = () => controller === state;
+  let resolveInitDone!: () => void;
+  const initDone = new Promise<void>((resolve) => {
+    resolveInitDone = resolve;
+  });
+
+  try {
+    logger.info("[captcha] aliyun sdk init start", {
+      configKey: key,
+      mode: config.mode ?? "popup",
+      language: config.language ?? null,
+    });
+    diagnostics.stage("sdk_init");
+    const started = initAliyunCaptcha({
+      SceneId: config.sceneId,
+      mode: config.mode ?? "popup",
+      language: config.language,
+      ...(config.captchaLogoImg ? { captchaLogoImg: config.captchaLogoImg } : {}),
+      showErrorTip: false,
+      element: `#${CAPTCHA_MOUNT_ID}`,
+      button: `#${CAPTCHA_BUTTON_ID}`,
+      getInstance: (instance) => {
+        diagnostics.event("sdk.callback", { callback: "getInstance", accepted: isCurrent() });
+        if (isCurrent()) resolveInstance(instance);
+      },
+      success: (param: string) => {
+        diagnostics.event("sdk.callback", { callback: "success", accepted: isCurrent() });
+        if (!isCurrent()) return;
+        const active = session;
+        session = null;
+        active?.resolve(param);
+      },
+      fail: (result: unknown) => {
+        diagnostics.event("sdk.callback", { callback: "fail", accepted: isCurrent() });
+        if (isCurrent()) handleSdkFail(result, rejectInstance, diagnostics);
+      },
+      onError: (error: unknown) => {
+        resolveInitDone();
+        diagnostics.event("sdk.callback", { callback: "onError", accepted: isCurrent() });
+        if (!isCurrent()) return;
+        logger.warn("[captcha] aliyun sdk onError", {
+          configKey: key,
+          error: error instanceof Error ? error.message : String(error),
+        });
+        const active = session;
+        if (active && !active.allowInteractive) {
+          session = null;
+          active.reject(new CaptchaInteractiveRequiredError());
+        } else {
+          session = null;
+          active?.reject(error ?? new Error("Captcha errored."));
+        }
+        rejectInstance(error ?? new Error("Captcha errored before instance ready."));
+      },
+    });
+    if (started) {
+      const completion = Promise.race([Promise.resolve(started), initDone]).then(
+        () => undefined,
+        (error: unknown) => {
+          if (isCurrent()) {
+            const active = session;
+            session = null;
+            active?.reject(error);
+            rejectInstance(error);
+          }
+        },
+      );
+      const drainState = { completion } as { drain?: Promise<void>; completion: Promise<void> };
+      initializing = drainState;
+      completion.then(() => {
+        if (initializing === drainState) initializing = null;
+      });
+    }
+  } catch (error) {
+    controller = null;
+    logger.warn("[captcha] aliyun sdk init threw", {
+      configKey: key,
+      error: error instanceof Error ? error.message : String(error),
+    });
+    throw error;
+  }
+  return state;
+}
+
+async function waitForInstance(
+  state: ControllerState,
+  signal: AbortSignal | undefined,
+): Promise<AliyunCaptchaInstance> {
+  return await new Promise<AliyunCaptchaInstance>((resolve, reject) => {
+    const timer = window.setTimeout(() => {
+      logger.warn("[captcha] aliyun sdk instance wait timed out", {
+        configKey: state.configKey,
+        timeoutMs: CAPTCHA_INIT_TIMEOUT_MS,
+      });
+      reject(new Error(`Captcha instance timed out after ${CAPTCHA_INIT_TIMEOUT_MS}ms.`));
+    }, CAPTCHA_INIT_TIMEOUT_MS);
+    withAbort(state.instancePromise, signal).then(
+      (instance) => {
+        window.clearTimeout(timer);
+        resolve(instance);
+      },
+      (error) => {
+        window.clearTimeout(timer);
+        reject(error);
+      },
+    );
+  });
+}
+
+async function waitScriptSettle(signal: AbortSignal | undefined): Promise<void> {
+  if (!scriptLoadedAt) return;
+  const elapsed = Date.now() - scriptLoadedAt;
+  if (elapsed >= CAPTCHA_SCRIPT_SETTLE_MS) return;
+  await withAbort(
+    new Promise<void>((resolve) => {
+      window.setTimeout(() => resolve(), CAPTCHA_SCRIPT_SETTLE_MS - elapsed);
+    }),
+    signal,
+  );
+}
+
+/** 跑一次验证码：先无感，失败再按需弹交互。返回 `captchaVerifyParam`。 */
+async function runCaptcha(
+  config: CaptchaRuntimeConfig,
+  options: {
+    signal?: AbortSignal;
+    allowInteractive?: boolean;
+    preferInteractive?: boolean;
+    timeoutMs?: number;
+    onInteractiveChallenge?: () => void;
+    diagnostics: ReturnType<typeof createDiagnostics>;
+  },
+): Promise<string> {
+  const { signal, diagnostics } = options;
+  if (typeof window === "undefined" || typeof document === "undefined") {
+    throw new Error("Captcha requires browser environment.");
+  }
+  if (session || verificationInFlight) {
+    throw new Error("Captcha verification is already in progress.");
+  }
+  signal?.throwIfAborted();
+  verificationInFlight = true;
+  const allowInteractive = options.allowInteractive !== false;
+  const preferInteractive = options.preferInteractive === true;
+  let controllerState: ControllerState | null = null;
+  let outcome = "success";
+  let error: unknown;
+
+  try {
+    controllerState = await ensureController(config, diagnostics, signal);
+    if (!controllerState) throw new Error("Captcha SDK is unavailable.");
+    diagnostics.event("controller.bound", { controllerId: controllerState.configKey });
+    signal?.throwIfAborted();
+    diagnostics.stage("trigger_delay");
+    await waitScriptSettle(signal);
+    signal?.throwIfAborted();
+
+    const state = controllerState;
+    const promise = new Promise<string>((resolve, reject) => {
+      const active: VerificationSession = {
+        resolve,
+        reject,
+        allowInteractive,
+        ...(allowInteractive ? { onInteractiveChallenge: options.onInteractiveChallenge } : {}),
+      };
+      session = active;
+      void (async () => {
+        let instance: AliyunCaptchaInstance;
+        try {
+          diagnostics.stage("instance_wait");
+          instance = await waitForInstance(state, signal);
+        } catch (instanceError) {
+          if (controller !== state) return;
+          if (!allowInteractive) {
+            session = null;
+            reject(
+              instanceError instanceof CaptchaInteractiveRequiredError
+                ? instanceError
+                : new CaptchaInteractiveRequiredError(
+                    "Captcha instance was not ready for traceless verification.",
+                  ),
+            );
+            return;
+          }
+          session = null;
+          reject(instanceError);
+          return;
+        }
+        if (controller !== state) return;
+        diagnostics.stage("verification");
+        try {
+          if (!preferInteractive && typeof instance.startTracelessVerification === "function") {
+            logger.info("[captcha] aliyun start traceless verification");
+            instance.startTracelessVerification();
+            return;
+          }
+          if (!allowInteractive) {
+            session = null;
+            reject(new CaptchaInteractiveRequiredError("Traceless verification is unavailable for this captcha instance."));
+            return;
+          }
+          options.onInteractiveChallenge?.();
+          logger.info("[captcha] aliyun trigger button click", {
+            buttonSelector: state.buttonSelector,
+          });
+          state.buttonElement.click();
+        } catch (triggerError) {
+          session = null;
+          reject(triggerError);
+        }
+      })();
+    });
+
+    const timeoutMs = options.timeoutMs ?? CAPTCHA_VERIFY_TIMEOUT_MS;
+    if (timeoutMs > 0) {
+      let timer: number | undefined;
+      const timeout = new Promise<never>((_resolve, reject) => {
+        timer = window.setTimeout(() => {
+          const active = session;
+          if (!active) return;
+          // 无感已受理但 SDK 还没回成功：不判超时，等 SDK 的 success/fail。
+          if (!allowInteractive && active.awaitingDeferredSdkSuccess) return;
+          session = null;
+          reject(
+            allowInteractive
+              ? new Error(`Captcha verification timed out after ${timeoutMs}ms.`)
+              : new CaptchaInteractiveRequiredError(`Traceless captcha timed out after ${timeoutMs}ms.`),
+          );
+        }, timeoutMs);
+      });
+      try {
+        return await Promise.race([promise, timeout]);
+      } finally {
+        if (timer !== undefined) window.clearTimeout(timer);
+      }
+    }
+    return await promise;
+  } catch (caught) {
+    error = caught;
+    outcome = signal?.aborted ? "cancelled" : "error";
+    session = null;
+    throw caught;
+  } finally {
+    diagnostics.end(outcome, error);
+    if (controllerState && controller === controllerState) resetController();
+    verificationInFlight = false;
+  }
+}
+
+// ─────────────────────────────────────────────── 对外入口（策略 + 队列 + 缓存）
+
+let configCache: { value: RequestVerificationConfig | null; expiresAt: number } | null = null;
+let configInFlight: Promise<RequestVerificationConfig | null> | null = null;
+
+interface VerificationConfigSource {
+  getRequestVerificationConfig(): Promise<RequestVerificationConfig | null>;
+}
+
+async function loadConfig(
+  source: VerificationConfigSource | undefined,
+  signal: AbortSignal | undefined,
+): Promise<RequestVerificationConfig | null> {
+  const now = Date.now();
+  if (configCache && configCache.expiresAt > now) return configCache.value;
+  if (configInFlight) return await withAbort(configInFlight, signal);
+  configInFlight = (async () => {
+    try {
+      const value = (await source?.getRequestVerificationConfig()) ?? null;
+      configCache = { value, expiresAt: now + CAPTCHA_CONFIG_TTL_MS };
+      return value;
+    } catch {
+      return null;
+    } finally {
+      configInFlight = null;
+    }
+  })();
+  return await withAbort(configInFlight, signal);
+}
+
+function enqueue<T>(providerId: string | undefined, run: () => Promise<T>, signal: AbortSignal | undefined): Promise<T> {
+  const previous = verifyQueue;
+  let release!: () => void;
+  const slot = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  verifyQueue = previous.then(() => slot);
+  return (async () => {
+    try {
+      await withAbort(previous, signal);
+      signal?.throwIfAborted();
+      logger.debug("[captcha] zcode-plan verification queue slot acquired", {
+        providerId: providerId ?? null,
+      });
+      return await run();
+    } finally {
+      release();
+    }
+  })();
+}
+
+/**
+ * 执行一次验证并返回 `captchaVerifyParam`；配置不可用/关闭时返回 undefined。
+ *
+ * 与官方一致：串行队列、允许交互、整体 120s 预算、ARMS 记录 traceless/interactive。
+ */
+export async function prepareCaptchaVerification(
+  source: VerificationConfigSource | undefined,
+  options: {
+    providerId?: string;
+    requestId?: string;
+    source?: string;
+    signal?: AbortSignal;
+  } = {},
+): Promise<string | undefined> {
+  options.signal?.throwIfAborted();
+  const config = await loadConfig(source, options.signal);
+  options.signal?.throwIfAborted();
+  if (!config || isCaptchaVerificationUnavailable(config)) return undefined;
+  const runtimeConfig = toRuntimeConfig(config);
+  const providerId = options.providerId?.trim();
+  const sourceLabel = options.source ?? "send_preflight";
+
+  return await enqueue(
+    providerId,
+    async () => {
+      let interactive = false;
+      const diagnostics = createDiagnostics({
+        requestId: options.requestId,
+        providerId,
+        source: sourceLabel,
+      });
+      const param = await runCaptcha(runtimeConfig, {
+        signal: options.signal,
+        allowInteractive: true,
+        timeoutMs: CAPTCHA_VERIFY_TIMEOUT_MS,
+        onInteractiveChallenge: () => {
+          interactive = true;
+        },
+        diagnostics,
+      });
+      options.signal?.throwIfAborted();
+      reportCaptchaOutcome({
+        result: interactive ? "interactive_displayed" : "traceless_passed",
+        source: sourceLabel,
+        providerId,
+      });
+      return param;
+    },
+    options.signal,
+  );
+}
+
+/** 预热：只做脚本加载 + SDK init，不触发验证。 */
+export async function prewarmCaptchaVerification(
+  source: VerificationConfigSource | undefined,
+): Promise<void> {
+  const config = await loadConfig(source, undefined);
+  if (!config || isCaptchaVerificationUnavailable(config)) return;
+  const diagnostics = createDiagnostics({ source: "prewarm" });
+  try {
+    await ensureController(toRuntimeConfig(config), diagnostics, undefined, true);
+    diagnostics.end("init_dispatched");
+  } catch (error) {
+    diagnostics.end("error", error);
+    throw error;
+  }
+}
+
