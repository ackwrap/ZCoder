+    expect(fields.modelSystemPromptEnabled).toBe(true);
+    const wireText = fields.modelSystemPrompt?.text ?? "";
+    expect(wireText.length).toBeGreaterThan(8_000);
+    expect(wireText).toBe(LONG_TEXT.replace(/\r\n?/g, "\n").trim());
+
+    const attached = attachModelSystemPromptToSubmission(
+      { modelSelection: { providerId: "provider-a", modelId: "model-a" }, mode: "build" },
