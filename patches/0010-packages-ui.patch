diff --git a/packages/ui/src/v4/focus-mode/focusGroups.ts b/packages/ui/src/v4/focus-mode/focusGroups.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e78c957e5c5d4908aba6d9e146f9fffa66cbc2ef
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/focusGroups.ts
@@ -0,0 +1,178 @@
+import type { ConversationRow, TurnHeaderRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  FOCUS_LOGICAL_GROUP_PAGE_SIZE,
+  type FocusDataRequirement,
+  type FocusLogicalGroup,
+  type FocusPhysicalTurn,
+  type FocusTimelineWindow,
+  type FocusTurnTerminalState,
+} from "./types.js";
+
+function isTurnHeaderRow(row: ConversationRow): row is TurnHeaderRow {
+  return row.kind === "turnHeader";
+}
+
+function resolveTerminalState(header: TurnHeaderRow | null): FocusTurnTerminalState {
+  if (!header) return "unknown";
+  switch (header.state) {
+    case "running":
+    case "completedSuccess":
+    case "completedInterrupted":
+    case "failed":
+      return header.state;
+    default:
+      return "unknown";
+  }
+}
+
+/**
+ * Group rows by the authoritative protocol turnId. Rows stay in projection order;
+ * no role/text sniffing is allowed here.
+ */
+export function buildFocusPhysicalTurns(rows: readonly ConversationRow[]): FocusPhysicalTurn[] {
+  interface DraftTurn {
+    turnId: string;
+    rows: ConversationRow[];
+    header: TurnHeaderRow | null;
+    firstRowId: number;
+    lastRowId: number;
+  }
+  const drafts: DraftTurn[] = [];
+  const turnById = new Map<string, DraftTurn>();
+
+  for (const row of rows) {
+    let entry = turnById.get(row.turnId);
+    if (!entry) {
+      entry = {
+        turnId: row.turnId,
+        rows: [],
+        header: null,
+        firstRowId: row.rowId,
+        lastRowId: row.rowId,
+      };
+      turnById.set(row.turnId, entry);
+      drafts.push(entry);
+    }
+    if (isTurnHeaderRow(row)) {
+      entry.header = row;
+      continue;
+    }
+    entry.rows.push(row);
+    entry.lastRowId = row.rowId;
+  }
+
+  return drafts.map((entry) => ({
+    turnId: entry.turnId,
+    rows: entry.rows,
+    header: entry.header,
+    state: resolveTerminalState(entry.header),
+    firstRowId: entry.firstRowId,
+    lastRowId: entry.lastRowId,
+  }));
+}
+
+/**
+ * Logical conversation groups are split after every completedSuccess turn.
+ * Interrupted/failed/unknown/running turns merge into the next success group or
+ * remain the trailing current group; they never become standalone window slots.
+ */
+export function buildFocusLogicalGroups(turns: readonly FocusPhysicalTurn[]): FocusLogicalGroup[] {
+  const groups: FocusLogicalGroup[] = [];
+  let current: FocusPhysicalTurn[] = [];
+
+  const flush = (complete: boolean) => {
+    if (current.length === 0) return;
+    const rows = current.flatMap((turn) => turn.rows);
+    const firstTurn = current[0]!;
+    const lastTurn = current.at(-1)!;
+    groups.push({
+      // A completed group is anchored by the success turn that closes it; a loaded
+      // interrupted prefix can change the first turn but never the ending success.
+      id: complete ? lastTurn.turnId : firstTurn.turnId,
+      turnIds: current.map((turn) => turn.turnId),
+      rows,
+      firstRowId: firstTurn.firstRowId,
+      lastRowId: lastTurn.lastRowId,
+      state: lastTurn.state,
+      complete,
+      startsWithHeader: firstTurn.header !== null,
+    });
+    current = [];
+  };
+
+  for (const turn of turns) {
+    current.push(turn);
+    if (turn.state === "completedSuccess") flush(true);
+  }
+  flush(false);
+  return groups;
+}
+
+export function buildFocusLogicalGroupsFromRows(
+  rows: readonly ConversationRow[],
+): FocusLogicalGroup[] {
+  return buildFocusLogicalGroups(buildFocusPhysicalTurns(rows));
+}
+
+/** Select the latest logical groups; expanded history bypasses this window. */
+export function selectFocusTimelineWindow(
+  groups: readonly FocusLogicalGroup[],
+  canLoadOlder: boolean,
+  pageSize: number = FOCUS_LOGICAL_GROUP_PAGE_SIZE,
+): FocusTimelineWindow {
+  const startIndex = Math.max(0, groups.length - pageSize);
+  const windowGroups = groups.slice(startIndex);
+  return {
+    groups: windowGroups,
+    leadingBoundaryProven: groups.length === 0 || startIndex > 0 || !canLoadOlder,
+    turnIds: windowGroups.flatMap((group) => group.turnIds),
+  };
+}
+
+/**
+ * Decide whether the renderer still needs older projection data. The wrapper only
+ * asks for enough to complete the selected two logical groups.
+ */
+export function resolveFocusDataRequirement(input: {
+  groups: readonly FocusLogicalGroup[];
+  window: FocusTimelineWindow;
+  canLoadOlder: boolean;
+  pageSize?: number;
+}): FocusDataRequirement {
+  const pageSize = input.pageSize ?? FOCUS_LOGICAL_GROUP_PAGE_SIZE;
+  if (!input.canLoadOlder) return { needsOlderData: false, reason: null };
+  if (input.window.groups.length === 0) {
+    return { needsOlderData: true, reason: "fewer-than-page" };
+  }
+  if (input.window.groups.length < pageSize) {
+    return { needsOlderData: true, reason: "fewer-than-page" };
+  }
+  if (!input.window.leadingBoundaryProven) {
+    // A leading header is not proof: an interrupted prefix may still belong to this
+    // success group. Fetch until one preceding success boundary or the history start.
+    return { needsOlderData: true, reason: "leading-boundary" };
+  }
+  return { needsOlderData: false, reason: null };
+}
+
+/** Progress signature for no-progress load guards. */
+export interface FocusLoadProgress {
+  readonly firstRowId: number | null;
+  readonly groupCount: number;
+}
+
+export function readFocusLoadProgress(groups: readonly FocusLogicalGroup[]): FocusLoadProgress {
+  return { firstRowId: groups[0]?.firstRowId ?? null, groupCount: groups.length };
+}
+
+export function didFocusLoadProgress(
+  previous: FocusLoadProgress,
+  next: FocusLoadProgress,
+): boolean {
+  if (next.groupCount > previous.groupCount) return true;
+  return (
+    previous.firstRowId !== null &&
+    next.firstRowId !== null &&
+    next.firstRowId < previous.firstRowId
+  );
+}
