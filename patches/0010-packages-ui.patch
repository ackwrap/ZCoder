+// @vitest-environment jsdom
+import { createElement, type ReactNode } from "react";
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { CompactionSettingsSection } from "./contract.js";
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({ intl: { formatMessage: ({ id }: { id: string }) => id } }),
+}));
+vi.mock("@/settings/SettingsPageParts.js", () => ({
+  SettingsGroupCard: ({ children }: { children?: ReactNode }) =>
+    createElement("section", null, children),
+  SettingsRow: ({ control, detail }: { control?: ReactNode; detail?: ReactNode }) =>
+    createElement("div", null, control, detail),
+}));
+const servicesMock = vi.hoisted(() => ({
+  modelSelectionService: {
+    getView: async () => ({
+      revision: 1,
+      providers: [
+        {
+          providerId: "provider-a",
+          providerName: "Provider A",
+          models: [{ modelId: "model-a", config: {} }],
+        },
+      ],
+    }),
+  },
+}));
+vi.mock("@/hooks/useServices.js", () => ({
+  useServices: () => servicesMock,
+  ServiceProvider: ({ children }: { children?: ReactNode }) => children,
+}));
+afterEach(cleanup);
+
+describe("compaction settings injected patch contract", () => {
+  it("keeps defaults and sends only the selected profile patch", async () => {
+    const update = vi.fn(async () => {});
+    render(createElement(CompactionSettingsSection, { onUpdateSettings: update }));
+    expect(screen.getByTestId("compaction-profile-detailed").getAttribute("aria-checked")).toBe(
+      "true",
+    );
+    expect((screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement).disabled).toBe(
+      true,
+    );
+    await act(async () => {
+      fireEvent.click(screen.getByTestId("compaction-profile-compact"));
+    });
+    expect(update).toHaveBeenCalledExactlyOnceWith({ compactionProfile: "compact" });
+  });
+
+  it("preserves failed drafts, retries, and accepts authoritative projections", async () => {
+    const update = vi.fn(async () => {}).mockRejectedValueOnce(new Error("host sync failed"));
+    const view = render(
+      createElement(CompactionSettingsSection, {
+        settings: { compactionProfile: "compact" },
+        onUpdateSettings: update,
+      }),
+    );
+    const input = screen.getByTestId("compaction-summary-max-output-input") as HTMLInputElement;
+    fireEvent.change(input, { target: { value: "12000" } });
+    await act(async () => {
+      fireEvent.blur(input);
+    });
+    expect(input.value).toBe("12000");
+    expect(screen.getByRole("alert").textContent).toBe("settings.advanced.saveFailed");
+    await act(async () => {
+      fireEvent.keyDown(input, { key: "Enter" });
+    });
+    expect(update).toHaveBeenNthCalledWith(2, { compactionSummaryMaxOutputTokens: 12000 });
+    view.rerender(
+      createElement(CompactionSettingsSection, {
+        settings: { compactionProfile: "compact", compactionSummaryMaxOutputTokens: 13000 },
+        onUpdateSettings: update,
+      }),
+    );
+    expect(input.value).toBe("13000");
+  });
+
+  it("defaults the title model to inherit and sends explicit selections", async () => {
+    const update = vi.fn(async () => {});
+    render(createElement(CompactionSettingsSection, { onUpdateSettings: update }));
+    const select = screen.getByTestId("title-generation-model-select") as HTMLSelectElement;
+    expect(select.value).toBe("");
+    expect(select.options[0]?.textContent).toBe("settings.advanced.titleGenerationModelInherit");
+    await screen.findByText("Provider A · model-a");
+    expect(select.options).toHaveLength(2);
+    await act(async () => {
+      fireEvent.change(select, { target: { value: "provider-a|model-a" } });
+    });
+    expect(update).toHaveBeenCalledExactlyOnceWith({
+      titleGenerationModel: { providerId: "provider-a", modelId: "model-a" },
+    });
+  });
+
+  it("clears the title model back to inherit", async () => {
+    const update = vi.fn(async () => {});
+    render(
+      createElement(CompactionSettingsSection, {
+        settings: { titleGenerationModel: { providerId: "provider-a", modelId: "model-a" } },
+        onUpdateSettings: update,
+      }),
+    );
+    const select = screen.getByTestId("title-generation-model-select") as HTMLSelectElement;
+    await screen.findByText("Provider A · model-a");
+    expect(select.value).toBe("provider-a|model-a");
+    await act(async () => {
+      fireEvent.change(select, { target: { value: "" } });
+    });
+    expect(update).toHaveBeenCalledExactlyOnceWith({
+      titleGenerationModel: { providerId: "", modelId: "" },
+    });
+  });
+
+  it("deduplicates Enter and blur while an injected save is pending", async () => {
+    let finish!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+    const update = vi.fn(() => pending);
+    render(
+      createElement(CompactionSettingsSection, {
+        settings: { compactionProfile: "compact" },
+        onUpdateSettings: update,
+      }),
+    );
+    const input = screen.getByTestId("compaction-tail-budget-input") as HTMLInputElement;
+    fireEvent.change(input, { target: { value: "25000" } });
+    await act(async () => {
+      fireEvent.keyDown(input, { key: "Enter" });
+      fireEvent.blur(input);
+    });
+    expect(update).toHaveBeenCalledExactlyOnceWith({ compactionTailBudgetTokens: 25000 });
+    expect(input.disabled).toBe(true);
+    await act(async () => {
+      finish();
+      await pending;
+    });
+    expect(input.disabled).toBe(false);
+  });
+});
