+import { describe, expect, it } from "vitest";
+import type { BackgroundBashSidePaneTab } from "@/lib/workspaceSidePane.js";
+import { backgroundBashDialogScopeExample } from "./contract.example.js";
+import {
+  backgroundBashScopeKey,
+  backgroundBashTabInScope,
+  type BackgroundBashDialogScope,
+} from "./contract.js";
+import { backgroundBashOutputDialogModule } from "./module.js";
+
+const scope: BackgroundBashDialogScope = {
+  sessionId: "session-1",
+  workspacePath: "/workspace",
+  workspaceIdentity: "ssh:a",
+  remoteSessionId: "remote-a",
+};
+
+function tab(overrides: Partial<BackgroundBashSidePaneTab> = {}): BackgroundBashSidePaneTab {
+  return {
+    id: "bash-output:session-1:work-1",
+    type: "bash-output",
+    workspacePath: "/workspace",
+    workspaceIdentity: "ssh:a",
+    remoteSessionId: "remote-a",
+    rootSessionId: "root",
+    sessionId: "session-1",
+    workId: "work-1",
+    title: "build",
+    workspaceKey: "ssh:a",
+    ownerTaskId: "session-1",
+    ...overrides,
+  };
+}
+
+describe("background-bash-output-dialog contract", () => {
+  it("declares its module manifest", () => {
+    expect(backgroundBashOutputDialogModule.id).toBe("background-bash-output-dialog-ui");
+  });
+
+  it("treats the same identity with a different path as another scope", () => {
+    expect(backgroundBashTabInScope(tab(), scope)).not.toBeNull();
+    expect(backgroundBashTabInScope(tab(), { ...scope, workspacePath: "/workspace-2" })).toBeNull();
+    expect(
+      backgroundBashScopeKey(scope) ===
+        backgroundBashScopeKey({ ...scope, workspacePath: "/workspace-2" }),
+    ).toBe(false);
+  });
+
+  it("keeps effect key and render guard on the same four fields", () => {
+    expect(backgroundBashDialogScopeExample(scope).scopeKey).toBe(backgroundBashScopeKey(scope));
+    for (const patch of [
+      { sessionId: "session-2" },
+      { workspacePath: "/workspace-2" },
+      { workspaceIdentity: "ssh:b" },
+      { remoteSessionId: "remote-b" },
+    ] satisfies Array<Partial<BackgroundBashDialogScope>>) {
+      expect(backgroundBashScopeKey({ ...scope, ...patch })).not.toBe(
+        backgroundBashScopeKey(scope),
+      );
+      expect(backgroundBashTabInScope(tab(), { ...scope, ...patch })).toBeNull();
+    }
+  });
+});
