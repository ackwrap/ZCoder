+import type { Locale } from "@zcode/shared";
+import type { AppSlashCommand } from "@/slashCommandHelpers.js";
+import { getCompatMessages } from "../messages.js";
+
+/** fork 与 branch 在协议层是同一个 `forkAssistant`，这里只区分菜单文案。 */
+export type ForkCommandKind = "fork" | "branch";
+
+export function createForkCommand(
+  kind: ForkCommandKind,
+  forkLatest: (() => boolean) | null,
+  locale: Locale,
+  notify: (message: string) => void,
+): AppSlashCommand {
+  const messages = getCompatMessages(locale);
+  const text = kind === "branch" ? messages.branch : messages.fork;
+  return {
+    value: text.value,
+    label: `/${text.value}`,
+    description: text.description,
+    keywords: text.keywords,
+    run: () => {
+      if (!forkLatest || !forkLatest()) {
+        notify(messages.forkUnavailable);
+      }
+    },
+  };
+}
