index 0000000000000000000000000000000000000000..ee4edbd09d03aeb9dd8bd4227816abc21b8a8363
--- /dev/null
+++ b/packages/ui/src/v4/composer/model-system-prompt/contract.example.ts
@@ -0,0 +1,63 @@
+/**
+ * composer-model-system-prompt 标准调用示例：
+ * 设置里有当前模型条目 → 会话开关默认关闭 → 用户点亮 → 发送时冻结一份 entry。
+ * 首发送成功后 promotion 把草稿值迁到真实 session，并清掉草稿值。
+ */
+import type { ModelSystemPromptEntry } from "@zcode/shared";
+import {
+  attachModelSystemPromptToSubmission,
+  isModelSystemPromptEnabled,
+  promoteModelSystemPromptDraftFlag,
+  readModelSystemPromptDraftState,
+  resolveModelSystemPromptScope,
+  resolveModelSystemPromptSubmissionForHost,
+  setModelSystemPromptEnabled,
+} from "./index.js";
+
+export function exampleComposerModelSystemPrompt(input: {
+  workspacePath: string;
+  modelId: string;
+  entries: ModelSystemPromptEntry[];
+  targetSessionId: string;
+}) {
+  const draftScope = resolveModelSystemPromptScope(input.workspacePath, undefined, null);
+  if (!draftScope) return null;
+
+  // 新会话/新草稿默认关闭；用户点亮只写本地状态。
+  setModelSystemPromptEnabled(draftScope, true);
+  const enabled = isModelSystemPromptEnabled(draftScope);
+  const fields = resolveModelSystemPromptSubmissionForHost({
+    hostSupported: true,
+    entries: input.entries,
+    enabled,
+    selection: { providerId: "provider-a", modelId: input.modelId },
+  });
+  const baseSubmission = {
+    mode: "build" as const,
+    planEnabled: false,
+    modelSelection: { providerId: "provider-a", modelId: input.modelId },
+  };
+  // 旧 Host 的 fields 为 undefined：完全省略字段，保持旧 schema 可解析。
+  const submission = fields
+    ? attachModelSystemPromptToSubmission(baseSubmission, fields)
+    : baseSubmission;
+
+  // accepted 后 promotion：只消费提交时冻结的 owner/intent，不读当前 root。
+  promoteModelSystemPromptDraftFlag({
+    binding: {
+      workspacePath: input.workspacePath,
+      draftOwnerKey: "__draft__",
+      enabled,
+      revision: readModelSystemPromptDraftState(draftScope)?.revision ?? 0,
+    },
+    targetSessionId: input.targetSessionId,
+  });
+
+  return {
+    submission,
+    realSessionEnabled: isModelSystemPromptEnabled(
+      resolveModelSystemPromptScope(input.workspacePath, undefined, input.targetSessionId)!,
+    ),
+    nextDraftEnabled: isModelSystemPromptEnabled(draftScope),
+  };
+}
