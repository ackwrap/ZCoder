+++ b/packages/ui/test/browser/manual-review/pending/context-results.fixture.tsx
@@ -0,0 +1,161 @@
+import { useCallback, useState } from "react";
+import { createRoot } from "react-dom/client";
+import type {
+  TimelineMarkerRow,
+  V4ConversationCompactSummaryResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { TooltipProvider } from "@/components/ui/tooltip.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+import { ConversationRowView } from "@/v4/ConversationRowView.js";
+import type { ConversationRowRenderContext } from "@/v4/conversationRowContext.js";
+import "@/styles.css";
+
+const params = new URLSearchParams(location.search);
+const theme = params.get("theme") === "dark" ? "dark" : "light";
+document.documentElement.className = `${theme} theme-zai-${theme}`;
+const summary =
+  "## Saved summary\n\n**Durable result** from this session.\n\n- Preserve user choices.\n- Continue the current task.\n\n```ts\nconst ready = true;\n```";
+const baseRow = { turnId: "fixture-turn", createdAt: 1, createdAtSeq: 1 };
+const notice: TimelineMarkerRow = {
+  ...baseRow,
+  rowId: 20,
+  kind: "timelineMarker",
+  marker: {
+    type: "contextSourceUpdate",
+    update: {
+      version: 1,
+      kind: "skills",
+      sourceKey: "skills:catalog",
+      revision: "a".repeat(64),
+      changes: Array.from({ length: 6 }, (_, index) => ({
+        sourceKey: `skills:${index}`,
+        label: `project:long-skill-label-${index}-for-narrow-layout-verification`,
+        change: index === 0 ? "removed" : index === 1 ? "replaced" : "added",
+      })),
+    },
+  },
+};
+
+function Fixture() {
+  const [sessionId, setSessionId] = useState("session-one");
+  const [generation, setGeneration] = useState(0);
+  const [reads, setReads] = useState(0);
+  const [fail, setFail] = useState(false);
+  const [pending, setPending] = useState(false);
+  const [release, setRelease] = useState<(() => void) | null>(null);
+  const read = useCallback<
+    NonNullable<ConversationRowRenderContext["readCompactSummary"]>
+  >(async () => {
+    setReads((value) => value + 1);
+    if (fail) throw new Error("private-storage-error-must-not-render");
+    const value: V4ConversationCompactSummaryResult = {
+      status: "available",
+      markdown: `${summary}\n\nSession: ${sessionId}`,
+    };
+    if (!pending) return value;
+    return new Promise((resolve) => setRelease(() => () => resolve(value)));
+  }, [fail, pending, sessionId]);
+  const context: ConversationRowRenderContext = {
+    workspacePath: "/fixture-project",
+    workspaceIdentity: "fixture-workspace",
+    sessionId,
+    logEpoch: "fixture-epoch",
+    branchGeneration: generation,
+    theme,
+    codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+    readCompactSummary: read,
+  };
+  const compact: TimelineMarkerRow = {
+    ...baseRow,
+    rowId: 12,
+    entityId: "fixture-operation",
+    kind: "timelineMarker",
+    marker: {
+      type: "compact",
+      origin: "manual",
+      status: "success",
+      operationId: "fixture-operation",
+      summaryRef: "fixture-summary",
+      tokensBefore: 10000,
+      tokensAfter: 2000,
+    },
+  };
+  const rows: TimelineMarkerRow[] = [
+    compact,
+    notice,
+    ...(["running", "failed", "noop", "cancelled", "interrupted"] as const).map(
+      (status, index): TimelineMarkerRow => ({
+        ...baseRow,
+        rowId: 30 + index,
+        kind: "timelineMarker",
+        marker: { type: "compact", origin: "auto", status },
+      }),
+    ),
+    {
+      ...baseRow,
+      rowId: 40,
+      kind: "timelineMarker",
+      marker: { type: "compact", origin: "auto", status: "success", tokensBefore: 10000 },
+    },
+  ];
+  return (
+    <main className="min-h-screen bg-background py-4 text-ui-base text-foreground">
+      <div className="mx-auto max-w-3xl" data-testid="context-results-fixture">
+        <h1 className="px-4 text-ui-lg">Context results interaction fixture</h1>
+        <div className="m-4 flex flex-wrap items-center gap-2">
+          <button
+            type="button"
+            onClick={() =>
+              setSessionId((value) => (value === "session-one" ? "session-two" : "session-one"))
+            }
+          >
+            Switch session
+          </button>
+          <button type="button" onClick={() => setGeneration((value) => value + 1)}>
+            Rewind branch
+          </button>
+          <label>
+            <input
+              type="checkbox"
+              checked={fail}
+              onChange={(event) => setFail(event.target.checked)}
+            />
+            Fail reads
+          </label>
+          <label>
+            <input
+              type="checkbox"
+              checked={pending}
+              onChange={(event) => setPending(event.target.checked)}
+            />
+            Delay reads
+          </label>
+          <button
+            type="button"
+            disabled={!release}
+            onClick={() => {
+              release?.();
+              setRelease(null);
+            }}
+          >
+            Release delayed read
+          </button>
+          <output aria-label="Read count">{reads}</output>
+          <output aria-label="Current session">{sessionId}</output>
+        </div>
+        {rows.map((row) => (
+          <ConversationRowView key={row.rowId} row={row} context={context} />
+        ))}
+      </div>
+    </main>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(
+  <ZCodeIntlProvider initialLocale={params.get("locale") === "zh-CN" ? "zh-CN" : "en-US"}>
+    <TooltipProvider>
+      <Fixture />
+    </TooltipProvider>
+  </ZCodeIntlProvider>,
+);
