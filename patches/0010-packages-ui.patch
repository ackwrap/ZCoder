+    getView: async () => ({
+      providers: [{ providerId: "p", models: [{ modelId: "a" }, { modelId: "b" }] }],
+    }),
+  },
+}));
+vi.mock("@/hooks/useServices.js", () => ({ useServices: () => services }));
+afterEach(cleanup);
+
+it("shows an independent model selector and fixed multiline editor with empty-save removal", async () => {
+  const update = vi.fn(async () => {});
+  render(
+    createElement(ModelSystemPromptsSettingsSection, {
+      settings: { modelSystemPromptAppends: [{ providerId: "p", modelId: "b", text: "old" }] },
+      onUpdateSettings: update,
+    }),
+  );
+  const card = screen.getByTestId("model-system-prompt-settings-card");
+  const select = within(card).getByTestId("model-system-prompt-model-select");
+  const configureButton = within(card).getByTestId("model-system-prompt-open-dialog");
+  expect(select.className).toContain("h-9");
+  expect(configureButton.className).toContain("h-9");
+  expect(configureButton.className).toContain("shrink-0");
+  expect(configureButton.parentElement?.className).toContain("items-end");
+  await waitFor(() =>
+    expect(
+      (screen.getByTestId("model-system-prompt-open-dialog") as HTMLButtonElement).disabled,
+    ).toBe(false),
+  );
+  fireEvent.change(select, { target: { value: modelSystemPromptEntryKey("p", "b") } });
+  fireEvent.click(screen.getByTestId("model-system-prompt-open-dialog"));
+  const dialog = screen.getByTestId("model-system-prompt-dialog");
+  expect(within(dialog).queryByTestId("model-system-prompt-model-select")).toBeNull();
+  const text = within(dialog).getByTestId("model-system-prompt-textarea") as HTMLTextAreaElement;
+  expect(text.value).toBe("old");
+  expect(text.className).toContain("field-sizing-fixed");
+  expect(text.className).toContain("resize-none");
+  expect(text.className).toContain("overflow-y-auto");
+  expect(text.className).toContain("leading-6");
+  expect(within(dialog).queryByTestId("model-system-prompt-delete")).toBeNull();
+  fireEvent.change(text, { target: { value: "" } });
+  await act(async () => fireEvent.click(within(dialog).getByTestId("model-system-prompt-save")));
+  expect(update).toHaveBeenCalledExactlyOnceWith({ modelSystemPromptAppends: [] });
+});
