new file mode 100644
index 0000000000000000000000000000000000000000..52833c21a1db4f253f35cb3ba1b2826b14bf6b0e
--- /dev/null
+++ b/packages/ui/src/settings/model-system-prompts/entry.ts
@@ -0,0 +1,116 @@
+import {
+  MODEL_SYSTEM_PROMPT_MAX_ENTRIES,
+  normalizeModelSystemPromptText,
+  type ModelSystemPromptEntry,
+} from "@zcode/shared";
+
+export type ModelSystemPromptEntryTarget = Pick<ModelSystemPromptEntry, "providerId" | "modelId">;
+
+export type ModelSystemPromptDraftError = "too-many";
+
+export type BuildModelSystemPromptEntriesResult =
+  | { ok: true; entries: ModelSystemPromptEntry[]; text: string }
+  | { ok: false; error: ModelSystemPromptDraftError };
+
+/** 精确 pair 的身份键；大小写与字符都不归一，只用于本地选择/去重。 */
+export function modelSystemPromptEntryKey(providerId: string, modelId: string): string {
+  return JSON.stringify([providerId, modelId]);
+}
+
+export function parseModelSystemPromptEntryKey(key: string): ModelSystemPromptEntryTarget | null {
+  if (!key) return null;
+  try {
+    const parsed: unknown = JSON.parse(key);
+    if (
+      Array.isArray(parsed) &&
+      parsed.length === 2 &&
+      typeof parsed[0] === "string" &&
+      typeof parsed[1] === "string" &&
+      parsed[0] &&
+      parsed[1]
+    ) {
+      return { providerId: parsed[0], modelId: parsed[1] };
+    }
+  } catch {
+    return null;
+  }
+  return null;
+}
+
+/**
+ * 读取侧只过滤空/重复条目，不因一条坏值丢掉其余条目。
+ * 同 pair 后出现的记录覆盖先出现的记录；保持首次出现顺序。
+ */
+export function normalizeModelSystemPromptEntries(
+  input: readonly ModelSystemPromptEntry[] | null | undefined,
+): ModelSystemPromptEntry[] {
+  if (!input?.length) return [];
+  const byTarget = new Map<string, ModelSystemPromptEntry>();
+  for (const raw of input) {
+    if (!raw) continue;
+    const providerId = raw.providerId.trim();
+    const modelId = raw.modelId.trim();
+    const text = normalizeModelSystemPromptText(raw.text);
+    if (!providerId || !modelId || !text) {
+      continue;
+    }
+    byTarget.set(modelSystemPromptEntryKey(providerId, modelId), {
+      providerId,
+      modelId,
+      text,
+    });
+  }
+  return [...byTarget.values()].slice(0, MODEL_SYSTEM_PROMPT_MAX_ENTRIES);
+}
+
+export function findModelSystemPromptEntry(
+  entries: readonly ModelSystemPromptEntry[],
+  target: ModelSystemPromptEntryTarget | null | undefined,
+): ModelSystemPromptEntry | undefined {
+  if (!target) return undefined;
+  return entries.find(
+    (entry) => entry.providerId === target.providerId && entry.modelId === target.modelId,
+  );
+}
+
+/**
+ * 用 textarea 的当前文本构造完整数组：
+ * - 空文本删除该 pair；
+ * - 已有 pair 原位替换；
+ * - 新 pair 追加，超过 20 条时本地拒绝；
+ * - 本功能不设固定字数上限（实际可用长度仍受模型上下文与请求限制）。
+ * 返回 normalized 文本供调用方同步草稿，不让 UI 与持久化值分叉。
+ */
+export function buildModelSystemPromptEntries(
+  entries: readonly ModelSystemPromptEntry[],
+  target: ModelSystemPromptEntryTarget,
+  text: string,
+): BuildModelSystemPromptEntriesResult {
+  const normalizedText = normalizeModelSystemPromptText(text);
+  const existingIndex = entries.findIndex(
+    (entry) => entry.providerId === target.providerId && entry.modelId === target.modelId,
+  );
+
+  if (!normalizedText) {
+    return {
+      ok: true,
+      entries: entries.filter(
+        (entry) => entry.providerId !== target.providerId || entry.modelId !== target.modelId,
+      ),
+      text: "",
+    };
+  }
+  if (existingIndex < 0 && entries.length >= MODEL_SYSTEM_PROMPT_MAX_ENTRIES) {
+    return { ok: false, error: "too-many" };
+  }
+
+  const nextEntry: ModelSystemPromptEntry = {
+    providerId: target.providerId,
+    modelId: target.modelId,
+    text: normalizedText,
+  };
+  const next = [...entries];
+  if (existingIndex >= 0) next[existingIndex] = nextEntry;
+  else next.push(nextEntry);
+  return { ok: true, entries: next, text: normalizedText };
+}
