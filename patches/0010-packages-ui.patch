+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { ReadScopeSource } from "./types.js";
+import { formatReadScope } from "./messages.js";
+import { resolveReadScope } from "./scope.js";
+
+export function ReadScopeLabel({ toolCall }: { toolCall: ReadScopeSource }) {
+  const { locale } = useZCodeIntl();
+  const scope = resolveReadScope(toolCall);
+  if (!scope) return null;
+  const label = formatReadScope(scope, locale);
+  return (
+    <span
+      data-testid="read-scope-label"
+      className="shrink-0 whitespace-nowrap text-ui-xs text-foreground-subtle"
+      title={label}
+    >
+      {label}
+    </span>
+  );
+}
