@@ -0,0 +1,145 @@
+import type { RefObject } from "react";
+import { Button } from "@/components/ui/button.js";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { SettingsFormTextarea } from "@/settings/SettingsFormTextarea.js";
+
+/** 弹窗内的固定测试锚点；与卡片上的入口按钮共用同一组用户动作。 */
+export const MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS = {
+  dialog: "model-system-prompt-dialog",
+  model: "model-system-prompt-dialog-model",
+  textarea: "model-system-prompt-textarea",
+  save: "model-system-prompt-save",
+  cancel: "model-system-prompt-cancel",
+  error: "model-system-prompt-error",
+} as const;
+
+export interface ModelSystemPromptDialogError {
+  id: string;
+  values?: Record<string, string | number>;
+}
+
+export interface ModelSystemPromptDialogProps {
+  open: boolean;
+  /** 当前卡片的 provider · model 显示名；弹窗打开时由外层按精确 pair 解析。 */
+  modelLabel: string;
+  /** 外部入口不是 Radix Trigger 时，关闭后把焦点还给仍挂载的按钮。 */
+  returnFocusRef?: RefObject<HTMLElement | null>;
+  draft: string;
+  pending: boolean;
+  error: ModelSystemPromptDialogError | null;
+  /** Esc、遮罩、右上关闭和取消按钮都走这里；不提交未保存修改。 */
+  onCancel: () => void;
+  onDraftChange: (value: string) => void;
+  onSave: () => void;
+}
+
+/**
+ * 模型级自定义系统 Agent 提示词弹窗。只承载受控草稿与操作按钮，
+ * 写入队列、外部刷新与迟到结果守卫仍由 ModelSystemPromptsSettingsSection 持有。
+ */
+export function ModelSystemPromptDialog({
+  open,
+  modelLabel,
+  returnFocusRef,
+  draft,
+  pending,
+  error,
+  onCancel,
+  onDraftChange,
+  onSave,
+}: ModelSystemPromptDialogProps) {
+  const { intl } = useZCodeIntl();
+
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(nextOpen) => {
+        if (!nextOpen) onCancel();
+      }}
+    >
+      <DialogContent
+        data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.dialog}
+        className="gap-0 overflow-hidden p-0 sm:max-w-2xl"
+        onCloseAutoFocus={(event) => {
+          const target = returnFocusRef?.current;
+          if (!target?.isConnected) return;
+          event.preventDefault();
+          target.focus({ preventScroll: true });
+        }}
+      >
+        <div className="flex max-h-[calc(100vh-2rem)] min-w-0 flex-col gap-4 overflow-y-auto p-6">
+          <DialogHeader className="pr-8">
+            <DialogTitle>
+              {intl.formatMessage({ id: "settings.advanced.modelSystemPrompts.title" })}
+            </DialogTitle>
+            <DialogDescription data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.model}>
+              {intl.formatMessage(
+                { id: "settings.advanced.modelSystemPrompts.dialogModel" },
+                { model: modelLabel },
+              )}
+            </DialogDescription>
+          </DialogHeader>
+          <p className="text-ui-sm text-foreground-subtle">
+            {intl.formatMessage({ id: "settings.advanced.modelSystemPrompts.emptyRemoves" })}
+          </p>
+          <SettingsFormTextarea
+            data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.textarea}
+            aria-label={intl.formatMessage({
+              id: "settings.advanced.modelSystemPrompts.editorLabel",
+            })}
+            placeholder={intl.formatMessage({
+              id: "settings.advanced.modelSystemPrompts.editorPlaceholder",
+            })}
+            rows={12}
+            value={draft}
+            className="h-64 min-h-64 field-sizing-fixed resize-none overflow-y-auto leading-6 md:leading-6"
+            onChange={(event) => onDraftChange(event.currentTarget.value)}
+            onKeyDown={(event) => {
+              if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
+                event.preventDefault();
+                onSave();
+              }
+            }}
+          />
+          {error ? (
+            <p
+              role="alert"
+              data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.error}
+              className="text-ui-sm text-destructive"
+            >
+              {intl.formatMessage({ id: error.id }, error.values)}
+            </p>
+          ) : null}
+          <DialogFooter className="flex-wrap items-center justify-end gap-2 sm:flex-row">
+            <Button
+              type="button"
+              variant="secondary"
+              size="lg"
+              data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.cancel}
+              onClick={onCancel}
+            >
+              {intl.formatMessage({ id: "common.cancel" })}
+            </Button>
+            <Button
+              type="button"
+              size="lg"
+              data-testid={MODEL_SYSTEM_PROMPT_DIALOG_TEST_IDS.save}
+              disabled={pending}
+              onClick={onSave}
+            >
+              {intl.formatMessage({ id: "settings.advanced.modelSystemPrompts.save" })}
+            </Button>
+          </DialogFooter>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
