diff --git a/packages/ui/src/v4/focus-mode/sessionFocusModeStore.ts b/packages/ui/src/v4/focus-mode/sessionFocusModeStore.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ae56c22788548055e2a7c0c204fd1de5beb18aa9
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/sessionFocusModeStore.ts
@@ -0,0 +1,117 @@
+import { useCallback, useSyncExternalStore } from "react";
+
+/** Renderer-local view preference; only stable real sessions are persisted. */
+const STORAGE_PREFIX = "zcode-v4-session-focus-mode:v1:";
+const memory = new Map<string, boolean>();
+const listeners = new Set<() => void>();
+let listeningForStorage = false;
+
+export function resolveSessionFocusModeScopeKey(input: {
+  workspaceIdentity?: string | null;
+  workspacePath?: string | null;
+  sessionId?: string | null;
+}): string {
+  const workspace = input.workspaceIdentity?.trim() || input.workspacePath?.trim() || "";
+  const session = input.sessionId?.trim() || null;
+  return JSON.stringify([workspace, session]);
+}
+
+function storageKey(scopeKey: string): string | null {
+  try {
+    const value: unknown = JSON.parse(scopeKey);
+    if (
+      !Array.isArray(value) ||
+      typeof value[0] !== "string" ||
+      !value[0] ||
+      typeof value[1] !== "string" ||
+      !value[1]
+    )
+      return null;
+    return `${STORAGE_PREFIX}${scopeKey}`;
+  } catch {
+    return null;
+  }
+}
+
+export function getSessionFocusModeEnabled(scopeKey: string): boolean {
+  if (!listeningForStorage && typeof window !== "undefined") {
+    window.addEventListener("storage", onStorage);
+    listeningForStorage = true;
+  }
+  const cached = memory.get(scopeKey);
+  if (cached !== undefined) return cached;
+  const key = storageKey(scopeKey);
+  if (!key || typeof window === "undefined") return false;
+  try {
+    return window.localStorage.getItem(key) === "1";
+  } catch {
+    return false;
+  }
+}
+
+function emit(): void {
+  for (const listener of listeners) listener();
+}
+
+export function setSessionFocusModeEnabled(scopeKey: string, enabled: boolean): void {
+  if (getSessionFocusModeEnabled(scopeKey) === enabled) return;
+  const key = storageKey(scopeKey);
+  memory.set(scopeKey, enabled);
+  if (key && typeof window !== "undefined") {
+    try {
+      window.localStorage.setItem(key, enabled ? "1" : "0");
+    } catch {
+      // Keep the local choice even when storage is unavailable.
+    }
+  }
+  emit();
+}
+
+/** Returns the new state so command feedback matches the committed toggle. */
+export function toggleSessionFocusMode(scopeKey: string): boolean {
+  const next = !getSessionFocusModeEnabled(scopeKey);
+  setSessionFocusModeEnabled(scopeKey, next);
+  return next;
+}
+
+function onStorage(event: StorageEvent): void {
+  try {
+    if (event.storageArea && event.storageArea !== window.localStorage) return;
+  } catch {
+    return;
+  }
+  if (event.key !== null && !event.key.startsWith(STORAGE_PREFIX)) return;
+  if (event.key === null) {
+    for (const key of memory.keys()) if (storageKey(key)) memory.delete(key);
+  } else {
+    memory.delete(event.key.slice(STORAGE_PREFIX.length));
+  }
+  emit();
+}
+
+export function subscribeSessionFocusMode(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function resetSessionFocusModeStoreForTest(): void {
+  memory.clear();
+  listeners.clear();
+  if (typeof window !== "undefined") window.removeEventListener("storage", onStorage);
+  listeningForStorage = false;
+}
+
+export function useSessionFocusMode(scopeKey: string): {
+  enabled: boolean;
+  toggle: () => boolean;
+} {
+  const enabled = useSyncExternalStore(
+    subscribeSessionFocusMode,
+    () => getSessionFocusModeEnabled(scopeKey),
+    () => getSessionFocusModeEnabled(scopeKey),
+  );
+  const toggle = useCallback(() => toggleSessionFocusMode(scopeKey), [scopeKey]);
+  return { enabled, toggle };
+}
diff --git a/packages/ui/src/v4/focus-mode/types.ts b/packages/ui/src/v4/focus-mode/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04a42dd246cdb8ef41026bb00af00c9aa768ec10
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/types.ts
@@ -0,0 +1,62 @@
+import type { ConversationRow, TurnHeaderRow } from "@zcode/shared/zcode-protocol-v4";
+
+/** Latest focus view shows two logical conversations. */
+export const FOCUS_LOGICAL_GROUP_PAGE_SIZE = 2;
+
+export type FocusTurnTerminalState =
+  | "running"
+  | "completedSuccess"
+  | "completedInterrupted"
+  | "failed"
+  | "unknown";
+
+/** A physical product turn: rows sharing the authoritative protocol turnId. */
+export interface FocusPhysicalTurn {
+  readonly turnId: string;
+  readonly rows: readonly ConversationRow[];
+  readonly header: TurnHeaderRow | null;
+  readonly state: FocusTurnTerminalState;
+  readonly firstRowId: number;
+  readonly lastRowId: number;
+}
+
+/**
+ * A logical display group. `completedSuccess` is the only complete boundary:
+ * interrupted/failed retry fragments join the following turns instead of
+ * consuming a window slot, and a trailing non-success group stays current.
+ */
+export interface FocusLogicalGroup {
+  /**
+   * Stable search anchor. Complete groups use the success turn that closes them;
+   * the trailing incomplete group uses its first turn. Anchor resolution also
+   * matches any member turnId, so a loaded prefix never invalidates the window.
+   */
+  readonly id: string;
+  readonly turnIds: readonly string[];
+  readonly rows: readonly ConversationRow[];
+  readonly firstRowId: number;
+  readonly lastRowId: number;
+  readonly state: FocusTurnTerminalState;
+  readonly complete: boolean;
+  /** False when a cold snapshot cut off this group's leading turnHeader. */
+  readonly startsWithHeader: boolean;
+}
+
+export interface FocusTimelineWindow {
+  readonly groups: readonly FocusLogicalGroup[];
+  /**
+   * True only with a known group boundary before the window: either an earlier
+   * loaded group or the true start of history. A leading turnHeader alone is not proof.
+   */
+  readonly leadingBoundaryProven: boolean;
+  readonly turnIds: readonly string[];
+}
+
+export type FocusOlderLoadReason = "fewer-than-page" | "leading-boundary";
+
+export interface FocusDataRequirement {
+  readonly needsOlderData: boolean;
+  readonly reason: FocusOlderLoadReason | null;
+}
+
+export type FocusOlderLoadStatus = "idle" | "loading" | "exhausted" | "error";
diff --git a/packages/ui/src/v4/focus-mode/useComposerNavigationAlignment.ts b/packages/ui/src/v4/focus-mode/useComposerNavigationAlignment.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f8f7da0a746d307f6e54231656e387e7cebcaabc
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/useComposerNavigationAlignment.ts
@@ -0,0 +1,79 @@
+import { useLayoutEffect, type RefObject } from "react";
+
+/** Align the fixed navigation slot with the actual visible composer, including dock transitions. */
+export function useComposerNavigationAlignment(
+  rootRef: RefObject<HTMLDivElement | null>,
+  slotRef: RefObject<HTMLDivElement | null>,
+  sessionKey: string,
+  hasBottomDock: boolean,
+): void {
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    const slot = slotRef.current;
+    if (!root || !slot) return;
+    const dock = root.querySelector<HTMLElement>('[data-v4-composer-dock-content="true"]');
+    const input = dock?.querySelector<HTMLElement>(".chat-composer-input-surface") ?? null;
+    if (!dock) return;
+    const target = input ?? dock;
+    const sync = () => {
+      const slotRect = slot.getBoundingClientRect();
+      const inputRect = input?.getBoundingClientRect();
+      const targetRect =
+        inputRect && inputRect.width > 0 ? inputRect : dock.getBoundingClientRect();
+      if (slotRect.width <= 0 || targetRect.width <= 0) {
+        slot.style.removeProperty("--focus-composer-center");
+        return;
+      }
+      slot.style.setProperty(
+        "--focus-composer-center",
+        `${targetRect.left + targetRect.width / 2 - slotRect.left}px`,
+      );
+    };
+    sync();
+    const observer = typeof ResizeObserver === "undefined" ? null : new ResizeObserver(sync);
+    observer?.observe(slot);
+    observer?.observe(target);
+    // Individual CSS translate can change on a class update without a resize or transition.
+    const mutationObserver =
+      typeof MutationObserver === "undefined" ? null : new MutationObserver(sync);
+    mutationObserver?.observe(dock, { attributes: true, attributeFilter: ["class", "style"] });
+    let frame: number | null = null;
+    const activeTransitions = new Set<string>();
+    const tick = () => {
+      sync();
+      frame = activeTransitions.size > 0 ? requestAnimationFrame(tick) : null;
+    };
+    const onStart = (event: TransitionEvent) => {
+      if (
+        event.target !== dock ||
+        !["transform", "width", "max-width"].includes(event.propertyName)
+      )
+        return;
+      activeTransitions.add(event.propertyName);
+      if (frame === null) frame = requestAnimationFrame(tick);
+    };
+    const onEnd = (event: TransitionEvent) => {
+      if (event.target !== dock) return;
+      activeTransitions.delete(event.propertyName);
+      if (activeTransitions.size === 0 && frame !== null) {
+        cancelAnimationFrame(frame);
+        frame = null;
+        sync();
+      }
+    };
+    dock.addEventListener("transitionrun", onStart);
+    dock.addEventListener("transitionend", onEnd);
+    dock.addEventListener("transitioncancel", onEnd);
+    window.addEventListener("resize", sync);
+    return () => {
+      observer?.disconnect();
+      mutationObserver?.disconnect();
+      dock.removeEventListener("transitionrun", onStart);
+      dock.removeEventListener("transitionend", onEnd);
+      dock.removeEventListener("transitioncancel", onEnd);
+      window.removeEventListener("resize", sync);
+      if (frame !== null) cancelAnimationFrame(frame);
+      slot.style.removeProperty("--focus-composer-center");
+    };
+  }, [rootRef, slotRef, sessionKey, hasBottomDock]);
+}
diff --git a/packages/ui/src/v4/focus-mode/useFocusTimelineWindow.ts b/packages/ui/src/v4/focus-mode/useFocusTimelineWindow.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d3c48e2fa0bb1f07e62a5527e01729cdd5edc067
--- /dev/null
+++ b/packages/ui/src/v4/focus-mode/useFocusTimelineWindow.ts
@@ -0,0 +1,175 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { ConversationRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  buildFocusLogicalGroupsFromRows,
+  didFocusLoadProgress,
+  readFocusLoadProgress,
+  resolveFocusDataRequirement,
+  selectFocusTimelineWindow,
+} from "./focusGroups.js";
+import type { FocusOlderLoadStatus, FocusTimelineWindow } from "./types.js";
+
+const FOCUS_MAX_AUTO_OLDER_LOADS = 8;
+
+export interface UseFocusTimelineWindowOptions {
+  readonly rows: readonly ConversationRow[];
+  readonly sessionKey: string;
+  readonly canLoadOlder: boolean;
+  readonly loadingOlder: boolean;
+  readonly onLoadOlder?: (() => Promise<void> | void) | undefined;
+  readonly active?: boolean;
+}
+
+export interface UseFocusTimelineWindowResult {
+  readonly window: FocusTimelineWindow;
+  readonly visibleRows: readonly ConversationRow[];
+  readonly loadStatus: FocusOlderLoadStatus;
+  readonly needsOlderData: boolean;
+  readonly focusLoading: boolean;
+  readonly retryLoadOlder: () => void;
+}
+
+export function useFocusTimelineWindow({
+  rows,
+  sessionKey,
+  canLoadOlder,
+  loadingOlder,
+  onLoadOlder,
+  active = true,
+}: UseFocusTimelineWindowOptions): UseFocusTimelineWindowResult {
+  const groups = useMemo(() => buildFocusLogicalGroupsFromRows(rows), [rows]);
+  const window = useMemo(
+    () => selectFocusTimelineWindow(groups, canLoadOlder),
+    [groups, canLoadOlder],
+  );
+  const visibleRows = useMemo(() => {
+    const turnIds = new Set(window.turnIds);
+    return rows.filter((row) => turnIds.has(row.turnId));
+  }, [rows, window.turnIds]);
+  const requirement = useMemo(
+    () => resolveFocusDataRequirement({ groups, window, canLoadOlder }),
+    [groups, window, canLoadOlder],
+  );
+  const [state, setState] = useState({
+    sessionKey,
+    failed: false,
+    exhausted: false,
+    loading: false,
+  });
+  const [retryRevision, setRetryRevision] = useState(0);
+  const tracker = useRef<{
+    attempts: number;
+    progress: ReturnType<typeof readFocusLoadProgress>;
+  } | null>(null);
+  const inFlight = useRef(false);
+  const flightToken = useRef(0);
+  const generation = useRef(0);
+  const previous = useRef({ sessionKey, active });
+  if (previous.current.sessionKey !== sessionKey || previous.current.active !== active) {
+    generation.current += 1;
+    if (previous.current.sessionKey !== sessionKey) {
+      tracker.current = null;
+      inFlight.current = false;
+      flightToken.current += 1;
+    }
+    previous.current = { sessionKey, active };
+  }
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  useEffect(() => {
+    setState((current) =>
+      current.sessionKey === sessionKey
+        ? current
+        : { sessionKey, failed: false, exhausted: false, loading: false },
+    );
+  }, [sessionKey]);
+
+  const failed = state.sessionKey === sessionKey && state.failed;
+  const exhausted = state.sessionKey === sessionKey && state.exhausted;
+  const focusLoading = state.sessionKey === sessionKey && state.loading;
+
+  useEffect(() => {
+    if (!active || loadingOlder || inFlight.current) return;
+    if (!requirement.needsOlderData || !onLoadOlder) {
+      tracker.current = null;
+      return;
+    }
+    if (failed || exhausted) return;
+    const progress = readFocusLoadProgress(groups);
+    let current = tracker.current;
+    if (!current) {
+      current = { attempts: 0, progress };
+      tracker.current = current;
+    } else if (current.attempts > 0) {
+      if (!didFocusLoadProgress(current.progress, progress)) {
+        setState((value) => ({ ...value, exhausted: true }));
+        return;
+      }
+      current.progress = progress;
+    }
+    if (current.attempts >= FOCUS_MAX_AUTO_OLDER_LOADS) {
+      setState((value) => ({ ...value, exhausted: true }));
+      return;
+    }
+    current.attempts += 1;
+    inFlight.current = true;
+    const requestGeneration = generation.current;
+    const requestToken = ++flightToken.current;
+    setState((value) => ({ ...value, loading: true }));
+    let operation: Promise<void>;
+    try {
+      operation = Promise.resolve(onLoadOlder());
+    } catch (error) {
+      operation = Promise.reject(error);
+    }
+    void operation
+      .catch(() => {
+        if (mounted.current && generation.current === requestGeneration) {
+          setState((value) => ({ ...value, failed: true }));
+        }
+      })
+      .finally(() => {
+        if (flightToken.current !== requestToken) return;
+        inFlight.current = false;
+        if (mounted.current) setState((value) => ({ ...value, loading: false }));
+      });
+  }, [
+    active,
+    canLoadOlder,
+    exhausted,
+    failed,
+    focusLoading,
+    groups,
+    loadingOlder,
+    onLoadOlder,
+    requirement.needsOlderData,
+    retryRevision,
+    sessionKey,
+  ]);
+
+  const retryLoadOlder = useCallback(() => {
+    tracker.current = null;
+    setState((value) => ({ ...value, failed: false, exhausted: false }));
+    setRetryRevision((value) => value + 1);
+  }, []);
+
+  return {
+    window,
+    visibleRows,
+    loadStatus: failed
+      ? "error"
+      : exhausted
+        ? "exhausted"
+        : loadingOlder || focusLoading
+          ? "loading"
+          : "idle",
+    needsOlderData: requirement.needsOlderData,
+    focusLoading,
+    retryLoadOlder,
+  };
+}
