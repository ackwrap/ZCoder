+import { memo, useEffect, useId, useState, type ReactNode } from "react";
+import { ChevronDownIcon, ChevronRightIcon } from "lucide-react";
+import type {
+  TimelineMarkerRow,
+  V4ConversationCompactSummaryResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import { TID_V4_ROW, testId } from "@zcode/shared/test-ids";
+import { MessageResponse } from "@/components/ai-elements/message.js";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { ConversationRowRenderContext } from "@/v4/conversationRowContext.js";
+
+type Props = {
+  row: TimelineMarkerRow;
+  context: ConversationRowRenderContext;
+  label: ReactNode;
+  icon: ReactNode;
+};
+type ReadState = { status: "loading" | "error" } | V4ConversationCompactSummaryResult;
+
+/** No global summary cache: identity changes synchronously unmount all old data and errors. */
+export const CompactResultMarker = memo(function CompactResultMarker(props: Props) {
+  const { row, context } = props;
+  if (row.marker.type !== "compact") return null;
+  const identity = JSON.stringify([
+    context.workspacePath,
+    context.workspaceIdentity,
+    context.workspaceRemoteSessionId,
+    context.sessionId,
+    context.logEpoch,
+    context.branchGeneration ?? 0,
+    row.rowId,
+    row.marker.operationId,
+    row.marker.summaryRef,
+    row.marker.status,
+  ]);
+  return <CompactResultMarkerContent key={identity} {...props} />;
+});
+
+function CompactResultMarkerContent({ row, context, label, icon }: Props) {
+  const { intl, locale } = useZCodeIntl();
+  const panelId = useId();
+  const [open, setOpen] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  const [result, setResult] = useState<ReadState>({ status: "loading" });
+  const marker = row.marker;
+  const read = context.readCompactSummary;
+  const sessionId = context.sessionId;
+  const logEpoch = context.logEpoch;
+  const generation = context.branchGeneration ?? 0;
+  const operationId = marker.type === "compact" ? marker.operationId : undefined;
+  const summaryRef = marker.type === "compact" ? marker.summaryRef : undefined;
+  const success = marker.type === "compact" && marker.status === "success";
+
+  useEffect(() => {
+    if (!open || !success) return;
+    let ignore = false;
+    if (!read || !sessionId || !logEpoch || !operationId || !summaryRef) {
+      setResult({ status: "unavailable", reason: "missingBody" });
+      return;
+    }
+    setResult({ status: "loading" });
+    void Promise.resolve()
+      .then(() =>
+        read({
+          sessionId,
+          baseLogEpoch: logEpoch,
+          branchGeneration: generation,
+          rowId: row.rowId,
+          operationId,
+          summaryRef,
+        }),
+      )
+      .then(
+        (value) => {
+          if (!ignore) setResult(value);
+        },
+        () => {
+          if (!ignore) setResult({ status: "error" });
+        },
+      );
+    return () => {
+      ignore = true;
+    };
+  }, [
+    open,
+    success,
+    read,
+    sessionId,
+    logEpoch,
+    generation,
+    row.rowId,
+    operationId,
+    summaryRef,
+    attempt,
+  ]);
+
+  if (marker.type !== "compact") return null;
+  const running = marker.status === "running";
+  const origin = intl.formatMessage({ id: `chat.contextCompaction.origin.${marker.origin}` });
+  const unknown = intl.formatMessage({ id: "chat.contextCompaction.tokensUnknown" });
+  const numberFormat = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
+  const tokens = (value: number | undefined) =>
+    value !== undefined && Number.isFinite(value) && value >= 0
+      ? numberFormat.format(value)
+      : unknown;
+  const heading = (
+    <>
+      <span className={running ? "animated-gradient-text font-medium" : undefined}>
+        {origin} · {label}
+      </span>
+      {success ? (
+        <span className="text-ui-sm text-foreground-subtle">
+          {intl.formatMessage(
+            { id: "chat.contextCompaction.estimatedTokens" },
+            { before: tokens(marker.tokensBefore), after: tokens(marker.tokensAfter) },
+          )}
+        </span>
+      ) : null}
+      {success ? (
+        open ? (
+          <ChevronDownIcon aria-hidden className="size-3.5 shrink-0" />
+        ) : (
+          <ChevronRightIcon aria-hidden className="size-3.5 shrink-0" />
+        )
+      ) : null}
+    </>
+  );
+  const divider = (
+    <>
+      <span aria-hidden className="h-px min-w-4 flex-1 bg-border/50" />
+      <span className="inline-flex min-w-0 shrink flex-wrap items-center justify-center gap-1.5 text-center leading-5">
+        {running ? null : icon}
+        {heading}
+      </span>
+      <span aria-hidden className="h-px min-w-4 flex-1 bg-border/50" />
+    </>
+  );
+  const headingClass =
+    "flex w-full items-center gap-3 px-4 py-2 text-ui-base text-foreground-subtle";
+  return (
+    <div
+      data-row-id={row.rowId}
+      data-row-kind="timelineMarker"
+      data-marker-type="compact"
+      data-status={marker.status}
+      data-origin={marker.origin}
+      data-source-command-id={row.sourceCommandId}
+      data-testid={testId(TID_V4_ROW, String(row.rowId))}
+    >
+      {success ? (
+        <button
+          type="button"
+          className={`${headingClass} transition-colors hover:text-foreground`}
+          aria-expanded={open}
+          aria-controls={panelId}
+          onClick={() => setOpen((value) => !value)}
+        >
+          {divider}
+        </button>
+      ) : (
+        <div className={headingClass}>{divider}</div>
+      )}
+      {success && open ? (
+        <div
+          id={panelId}
+          data-testid={`v4-compact-details-${row.rowId}`}
+          className="mx-4 mb-2 min-w-0 rounded-xl border border-border bg-surface p-3"
+          aria-busy={result.status === "loading"}
+        >
+          {result.status === "available" ? (
+            <MessageResponse
+              streaming={false}
+              theme={context.theme}
+              codePreviewSettings={context.codePreviewSettings}
+              workspacePath={context.workspacePath}
+              workspaceHomePath={context.workspaceHomePath}
+              workspaceIdentity={context.workspaceIdentity}
+              workspaceRemoteSessionId={context.workspaceRemoteSessionId}
+              sessionId={sessionId ?? undefined}
+              onOpenFileLink={context.onOpenFileLink}
+              onOpenCodeViewer={context.onOpenCodeViewer}
+              onOpenExternalUrl={context.onOpenBrowserUrl}
+            >
+              {result.markdown}
+            </MessageResponse>
+          ) : (
+            <div
+              className="flex flex-wrap items-center gap-2 text-ui-sm text-foreground-subtle"
+              role="status"
+            >
+              <span>
+                {intl.formatMessage({
+                  id:
+                    result.status === "loading"
+                      ? "chat.contextCompaction.summaryLoading"
+                      : result.status === "error"
+                        ? "chat.contextCompaction.summaryError"
+                        : "chat.contextCompaction.summaryUnavailable",
+                })}
+              </span>
+              {result.status === "error" ? (
+                <Button
+                  type="button"
+                  variant="ghost"
+                  size="sm"
+                  onClick={() => setAttempt((value) => value + 1)}
+                >
+                  {intl.formatMessage({ id: "chat.contextCompaction.retry" })}
+                </Button>
+              ) : null}
+            </div>
+          )}
+        </div>
+      ) : null}
+    </div>
+  );
+}
