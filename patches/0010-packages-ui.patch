+
+afterEach(cleanup);
+
+describe("context diagnostics presentation", () => {
+  it("separates current configuration from runtime budget", () => {
+    const view = render(
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "en-US" },
+        createElement(ContextDiagnostics, {
+          configured: { model: "gpt-6-astra", size: 272000, source: "codex-fallback" },
+          usage: { size: 64000, used: 10000, autoCompactThresholdTokens: 50000 },
+        }),
+      ),
+    );
+    expect(view.getByText("272K")).toBeTruthy();
+    expect(view.getByText("gpt-6-astra · Codex offline fallback")).toBeTruthy();
+    expect(view.getByText("50K")).toBeTruthy();
+    expect(view.getByText("40K")).toBeTruthy();
+    expect(view.container.querySelector("p")).toBeNull();
+  });
+
+  it("updates provenance and does not make up usage or a threshold", () => {
+    const renderContent = (source: "personal" | "discovered") =>
+      createElement(
+        ZCodeIntlProvider,
+        { initialLocale: "zh-CN" },
+        createElement(ContextDiagnostics, {
+          configured: { model: "m", size: 272000, source },
+        }),
+      );
+    const view = render(renderContent("personal"));
+    expect(view.getByText("m · 个人覆盖")).toBeTruthy();
