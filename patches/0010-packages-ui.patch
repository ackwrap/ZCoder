+      createElement(ConversationFocusModeTimeline, {
+        ...commonProps,
+        rows,
+        canLoadOlder: true,
+        onLoadOlder,
+      }),
+    );
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(screen.getByTestId(TID_FOCUS_MODE_RETRY)).not.toBeNull();
+
+    await act(async () => {
+      fireEvent.click(screen.getByTestId(TID_FOCUS_MODE_RETRY));
+    });
+    expect(onLoadOlder).toHaveBeenCalledTimes(2);
+  });
+
+  it("ignores a late load failure from the previous session", async () => {
+    let rejectLoad!: (error: Error) => void;
+    const deferred = new Promise<void>((_, reject) => {
+      rejectLoad = reject;
+    });
+    const onLoadOlder = vi.fn(() => deferred);
+    const view = render(
+      createElement(ConversationFocusModeTimeline, {
+        ...commonProps,
+        rows: successTurn("a"),
+        canLoadOlder: true,
+        onLoadOlder,
+      }),
+    );
+
+    view.rerender(
+      createElement(ConversationFocusModeTimeline, {
+        ...commonProps,
+        sessionKey: "session-2",
+        rows: [...successTurn("z"), ...successTurn("x"), ...successTurn("y")],
+        canLoadOlder: true,
+        onLoadOlder,
+      }),
+    );
+    await act(async () => {
+      rejectLoad(new Error("late failure"));
+      await deferred.catch(() => {});
+    });
+
+    expect(screen.queryByTestId(TID_FOCUS_MODE_RETRY)).toBeNull();
+    expectTurns(["x", "y"], ["a", "z"]);
+  });
+
+  it("resets to the latest window when the session changes", () => {
+    const rows = ["a", "b", "c", "d", "e", "f"].flatMap((id) => successTurn(id));
+    const view = render(createElement(ConversationFocusModeTimeline, { ...commonProps, rows }));
+    act(() => fireEvent.click(screen.getByTestId(TID_FOCUS_MODE_OLDER)));
+    expectTurns(["a", "b", "c", "d", "e", "f"], []);
+
+    const nextRows = ["x", "y", "z"].flatMap((id) => successTurn(id));
+    view.rerender(
+      createElement(ConversationFocusModeTimeline, {
+        ...commonProps,
+        sessionKey: "session-2",
+        rows: nextRows,
+      }),
+    );
+    expectTurns(["y", "z"], ["x", "a", "b", "c", "d", "e", "f"]);
+  });
+});
+
+describe("focus mode off", () => {
+  it("keeps the original timeline mounting every group", () => {
+    const rows = ["a", "b", "c", "d", "e", "f"].flatMap((id) => successTurn(id));
+    const view = render(createElement(ConversationFocusModeTimeline, { ...commonProps, rows }));
+    fireEvent.click(screen.getByTestId(TID_FOCUS_MODE_OLDER));
+    view.rerender(createElement(ConversationTimeline, { ...commonProps, rows }));
+    expectTurns(["a", "b", "c", "d", "e", "f"], []);
+    expect(screen.queryByTestId(TID_FOCUS_MODE_OLDER)).toBeNull();
+    expect(screen.queryByTestId(TID_FOCUS_MODE_NEWER)).toBeNull();
+  });
+});
