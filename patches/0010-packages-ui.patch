@@ -0,0 +1,79 @@
+import { type ComponentProps, type ReactNode } from "react";
+import { ChevronDownIcon } from "lucide-react";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "@/components/ui/collapsible.js";
+import { cn } from "@/components/lib/utils.js";
+
+export interface InspectorCardProps extends Omit<
+  ComponentProps<typeof Collapsible>,
+  "children" | "defaultOpen" | "onOpenChange" | "open"
+> {
+  id: string;
+  title: string;
+  children: ReactNode;
+  /** 折叠触发器内的非交互状态内容（例如后台任务总数）。 */
+  trailing?: ReactNode;
+  /** 与折叠触发器同级的标题行操作。 */
+  actions?: ReactNode;
+  /** 展开内容的附加类名（例如滚动上限）。 */
+  contentClassName?: string;
+  /** 受控开合；省略时默认展开。 */
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+  /** 非受控时的初始开合；省略时默认展开。 */
+  defaultOpen?: boolean;
+}
+
+/**
+ * 信息栏卡片外壳。上下文、连接器、改动与后台任务共用同一套容器和标题行，
+ * 避免各卡随时间长出不同的圆角、内边距或折叠箭头。
+ */
+export function InspectorCard({
+  actions,
+  children,
+  className,
+  contentClassName,
+  defaultOpen = true,
+  id,
+  onOpenChange,
+  open,
+  title,
+  trailing,
+  ...collapsibleProps
+}: InspectorCardProps) {
+  return (
+    <Collapsible
+      {...collapsibleProps}
+      data-inspector-card={id}
+      defaultOpen={open === undefined ? defaultOpen : undefined}
+      open={open}
+      onOpenChange={onOpenChange}
+      className={cn("min-w-0 rounded-xl border border-card-border bg-card p-3", className)}
+    >
+      <div className="flex min-w-0 items-center gap-1">
+        <CollapsibleTrigger
+          data-testid={`inspector-${id}-trigger`}
+          className="group flex min-w-0 flex-1 items-center gap-1 text-left text-ui-sm text-foreground-subtle"
+        >
+          <span>{title}</span>
+          {trailing ? <span className="shrink-0 tabular-nums">{trailing}</span> : null}
+          <ChevronDownIcon
+            aria-hidden="true"
+            className="size-3.5 shrink-0 transition-transform group-data-[state=closed]:-rotate-90"
+          />
+        </CollapsibleTrigger>
+        {actions ? (
+          <div className="inline-flex shrink-0 items-center gap-1 text-ui-sm text-foreground-subtle">
+            {actions}
+          </div>
+        ) : null}
+      </div>
+      <CollapsibleContent>
+        <div className={cn("min-w-0 space-y-2 pt-2", contentClassName)}>{children}</div>
+      </CollapsibleContent>
+    </Collapsible>
+  );
+}
