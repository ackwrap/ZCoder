+            {active && <rect x={node.x - 4} y={node.y - 4} width={node.width + 8} height={node.height + 8} rx="16" fill={color} opacity="0.12" />}
+            <rect x={node.x} y={node.y} width={node.width} height={node.height} rx="12" fill="#131c26" />
