@@ -0,0 +1,87 @@
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/autocompact.fixture.tsx";
+let server, browser, origin, cacheDir;
+before(async () => {
+  cacheDir = await mkdtemp(join(tmpdir(), "autocompact-vite-"));
+  server = await createServer({
+    root,
+    cacheDir,
+    configFile: false,
+    plugins: [
+      react(),
+      {
+        name: "autocompact-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (req.url !== "/fixture") return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<html><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0, hmr: false, watch: null },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  server?.httpServer?.closeAllConnections();
+  await Promise.all([browser?.close(), server?.close(), server?.watcher.close()]);
+  if (cacheDir) await rm(cacheDir, { recursive: true, force: true });
+});
+
+test("autocompact accepts units, queries, resets and preserves invalid input", async () => {
+  const page = await browser.newPage();
+  try {
+    await page.goto(`${origin}fixture`);
+    const input = page.getByRole("textbox", { name: "Command" });
+    const send = page.getByRole("button", { name: "Send", exact: true });
+    await send.click();
+    await page.waitForFunction(() =>
+      document.querySelector("output").textContent.includes("100,000"),
+    );
+    assert.equal(await input.inputValue(), "");
+    await input.fill("/autocompact 1m");
+    await send.click();
+    await page.waitForFunction(() =>
+      document.querySelector("output").textContent.includes("1000000"),
+    );
+    assert.match(await page.locator("output").textContent(), /166,000/);
+    const feedbackBeforeSelection = await page.locator("output").textContent();
+    await page.getByRole("button", { name: "autocompact", exact: true }).click();
+    assert.equal(await input.inputValue(), "/autocompact ");
+    assert.equal(await page.locator("output").textContent(), feedbackBeforeSelection);
+    await input.fill("/autocompact reset");
+    await send.click();
+    await page.waitForFunction(() => document.querySelector("output").textContent.includes("默认"));
+    await input.fill("/autocompact invalid");
+    await send.click();
+    await page.waitForFunction(() => document.querySelector("output").textContent.includes("用法"));
+    assert.equal(await input.inputValue(), "/autocompact invalid");
+  } finally {
+    await page.close();
+  }
+});
