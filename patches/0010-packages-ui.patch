@@ -0,0 +1,70 @@
+import { useCallback, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { TooltipProvider } from "@/components/ui/tooltip.js";
+import {
+  SessionResourceControls,
+  type SessionResourceControlsProps,
+} from "@/session-resource-controls/contract.js";
+import type { SessionResourcesState } from "@zcode/shared/zcode-protocol-v4";
+import "@/styles.css";
+
+const params = new URLSearchParams(location.search);
+document.documentElement.className =
+  params.get("theme") === "light" ? "light theme-zai-light" : "dark theme-zai-dark";
+const initial: SessionResourcesState = {
+  policy: { revision: 0, disabledSkills: [], disabledMcpServers: [] },
+  skills: [
+    {
+      id: "plugin:skill",
+      label: "plugin:skill-with-a-long-name-for-layout-checking",
+      available: true,
+      enabled: true,
+    },
+  ],
+  mcpServers: [
+    { id: "fixture", label: "fixture-server", available: true, enabled: true },
+    { id: "config-disabled", label: "config-disabled", available: false, enabled: false },
+  ],
+};
+function Fixture() {
+  const [state, setState] = useState(initial);
+  const [fail, setFail] = useState(false);
+  const send: SessionResourceControlsProps["send"] = useCallback(
+    async (type, payload) => {
+      if (fail) throw new Error("private-service-error-must-not-render");
+      if (type === "setSessionResource")
+        setState((previous) => {
+          const key = payload.kind === "skill" ? "skills" : "mcpServers";
+          return {
+            ...previous,
+            [key]: previous[key].map((item) =>
+              item.id === payload.id ? { ...item, enabled: Boolean(payload.enabled) } : item,
+            ),
+          };
+        });
+      return { status: "accepted" } as never;
+    },
+    [fail],
+  );
+  return (
+    <main className="@container/conversation relative h-screen bg-background text-foreground">
+      <button data-testid="fixture-fail" onClick={() => setFail((value) => !value)}>
+        fail
+      </button>
+      <aside
+        data-testid="chat-summary-panel"
+        className="absolute right-4 top-12 w-80 max-w-[calc(100%-2rem)] rounded-2xl border border-border bg-popover p-2"
+      >
+        <SessionResourceControls state={state} ready readOnly={false} send={send} />
+      </aside>
+    </main>
+  );
+}
+createRoot(document.getElementById("root")!).render(
+  <ZCodeIntlProvider initialLocale={params.get("locale") === "zh-CN" ? "zh-CN" : "en-US"}>
+    <TooltipProvider>
+      <Fixture />
+    </TooltipProvider>
+  </ZCodeIntlProvider>,
+);
