+
+function gitSummary(overrides: Partial<GitRepositorySummary> = {}): GitRepositorySummary {
+  return {
+    workspacePath: "/repo",
+    repoRoot: "/repo",
+    workspaceInRepoPath: "",
+    autoRefreshWatchPaths: [],
+    branchName: "main",
+    trackingBranchName: "origin/main",
+    headRefType: "branch",
+    ahead: 0,
+    behind: 0,
+    isDirty: true,
+    isGitAvailable: true,
+    isRepository: true,
+    ...overrides,
+  };
+}
+
+function planState(overrides: Partial<PlanState> = {}): PlanState {
+  return {
+    updatedAt: 1_700_000_000_000,
+    items: [
+      { id: "1", content: "Ship the capsule", status: "completed" },
+      { id: "2", content: "Verify compact metrics", status: "inProgress" },
+    ],
+    ...overrides,
+  };
+}
+
+function panelProps(
+  overrides: Partial<ConversationStatusPanelProps> = {},
+): ConversationStatusPanelProps {
+  return {
+    workspacePath: "/repo",
+    gitSummary: gitSummary(),
+    gitDirtyFileCount: 2,
+    gitWorktreeChangeSummary: { added: 4286, removed: 1678 },
+    onRefreshGit: vi.fn(),
+    summaryPanelVariantOverride: "mini",
+    ...overrides,
+  };
+}
+
+function renderPanel(overrides: Partial<ConversationStatusPanelProps> = {}, compact?: boolean) {
+  const content = createElement(ConversationStatusPanel, panelProps(overrides));
+  return render(
+    compact === undefined ? content : createElement(StatusCapsuleProvider, { compact }, content),
+  );
+}
+
+function capsuleRoot(container: HTMLElement): HTMLElement {
+  const root = container.querySelector<HTMLElement>('[data-status-capsule="true"]');
+  expect(root).not.toBeNull();
+  return root as HTMLElement;
+}
+
+function capsuleContent(container: HTMLElement): HTMLElement {
+  const content = container.querySelector<HTMLElement>('[data-status-capsule-content="true"]');
+  expect(content).not.toBeNull();
+  return content as HTMLElement;
+}
+
+describe("status capsule side-pane compact scope", () => {
+  it("defaults to the full capsule when no scope provider is present", () => {
+    const { container } = renderPanel();
+    const root = capsuleRoot(container);
+    const content = capsuleContent(container);
+
+    expect(root.getAttribute("data-status-capsule-compact")).toBe("false");
+    expect(root.className).toContain("pl-2");
+    expect(root.className).not.toMatch(/(^|\s)w-8(\s|$)/);
+    expect(content.className).toContain("contents");
+    expect(content.className).not.toContain("sr-only");
+    expect(container.textContent).toContain("chat.statusPanel.changes");
+    expect(container.textContent).toContain("+4286");
+    expect(container.textContent).toContain("-1678");
+  });
+
+  it("shrinks to an icon-only capsule while keeping the summary in the accessibility tree", () => {
+    const { container } = renderPanel({}, true);
+    const root = capsuleRoot(container);
+    const content = capsuleContent(container);
+    const expand = screen.getByRole("button", { name: "chat.summaryPanel.showPanel" });
+
+    expect(root.getAttribute("data-status-capsule-compact")).toBe("true");
+    expect(root.className).toMatch(/(^|\s)w-8(\s|$)/);
+    expect(root.className).toContain("pl-0");
+    expect(root.className).toContain("pr-0");
+    expect(root.className).toContain("gap-0");
+    expect(content.className).toContain("sr-only");
+    expect(container.querySelector('[data-status-capsule-icon="true"]')).not.toBeNull();
+    // The full Git summary survives visually-hidden semantics; only its layout is clipped.
+    expect(container.textContent).toContain("chat.statusPanel.changes");
+    expect(container.textContent).toContain("+4286");
+    expect(container.textContent).toContain("-1678");
+    expect(expand.getAttribute("aria-label")).toBe("chat.summaryPanel.showPanel");
+    const describedBy = expand.getAttribute("aria-describedby");
+    expect(describedBy).toBeTruthy();
+    const describedSummary = document.getElementById(describedBy!);
+    expect(describedSummary?.textContent).toContain("+4286");
+    expect(describedSummary?.textContent).toContain("-1678");
+    expect(
+      screen.getByRole("button", {
+        name: "chat.summaryPanel.showPanel",
+        description: /\+4286.*-1678/,
+      }),
+    ).toBe(expand);
+  });
+
+  it("restores the same full summary after repeated open/close cycles", () => {
+    const view = renderPanel({}, false);
+
+    let root = capsuleRoot(view.container);
+    expect(root.getAttribute("data-status-capsule-compact")).toBe("false");
+    expect(capsuleContent(view.container).className).toContain("contents");
+
+    for (const compact of [true, false, true, false]) {
+      view.rerender(
+        createElement(
+          StatusCapsuleProvider,
+          { compact },
+          createElement(ConversationStatusPanel, panelProps()),
+        ),
+      );
+      root = capsuleRoot(view.container);
+      expect(root.getAttribute("data-status-capsule-compact")).toBe(compact ? "true" : "false");
+      expect(capsuleContent(view.container).className).toContain(compact ? "sr-only" : "contents");
+      expect(view.container.textContent).toContain("+4286");
+      expect(view.container.textContent).toContain("-1678");
+    }
+  });
+
+  it("scopes compactness to each conversation tree", () => {
+    const { container } = render(
+      createElement(
+        "div",
+        null,
+        createElement(
+          StatusCapsuleProvider,
+          { compact: true },
+          createElement(ConversationStatusPanel, panelProps()),
+        ),
+        createElement(
+          StatusCapsuleProvider,
+          { compact: false },
+          createElement(ConversationStatusPanel, panelProps()),
+        ),
+        createElement(ConversationStatusPanel, panelProps()),
+      ),
+    );
+    const roots = container.querySelectorAll<HTMLElement>('[data-status-capsule="true"]');
+    expect(roots).toHaveLength(3);
+    expect(roots[0]?.getAttribute("data-status-capsule-compact")).toBe("true");
+    expect(roots[1]?.getAttribute("data-status-capsule-compact")).toBe("false");
+    // Outside every scope (for example the Side Pane tree) the capsule stays full.
+    expect(roots[2]?.getAttribute("data-status-capsule-compact")).toBe("false");
+  });
+
+  it("keeps the wrapped conversation mounted across side-pane toggles", () => {
+    let mounts = 0;
+    function Probe() {
+      useEffect(() => {
+        mounts += 1;
+      }, []);
+      const compact = useStatusCapsuleCompact();
+      return createElement("span", {
+        "data-testid": "mount-probe",
+        "data-compact": compact ? "true" : "false",
+      });
+    }
+    const ScopedProbe = withSidePaneCapsuleScope(Probe);
+
+    const view = render(createElement(ScopedProbe, { sidePaneOpen: false }));
+    expect(mounts).toBe(1);
+    view.rerender(createElement(ScopedProbe, { sidePaneOpen: true }));
+    expect(screen.getByTestId("mount-probe").getAttribute("data-compact")).toBe("true");
+    view.rerender(createElement(ScopedProbe, { sidePaneOpen: false }));
+    expect(screen.getByTestId("mount-probe").getAttribute("data-compact")).toBe("false");
+    expect(mounts).toBe(1);
+  });
+
+  it("keeps todo summary text and counts while compact", () => {
+    const { container } = renderPanel({ plan: planState() }, true);
+    // Current todo takes the same priority branch in both presentations.
+    expect(container.textContent).toContain("Verify compact metrics");
+    expect(capsuleContent(container).className).toContain("sr-only");
+  });
+
+  it("still expands to the full panel when the compact capsule is clicked", () => {
+    const onVariantChange = vi.fn();
+    renderPanel({ onVariantChange }, true);
+
+    fireEvent.click(screen.getByRole("button", { name: "chat.summaryPanel.showPanel" }));
+
+    expect(onVariantChange).toHaveBeenCalledWith("panel");
+  });
+
+  it("does not collapse a user-pinned expanded panel", () => {
+    const { container } = renderPanel({ summaryPanelVariantOverride: "panel" }, true);
+    const panel = container.querySelector<HTMLElement>(`[data-testid="${TID_CHAT_SUMMARY_PANEL}"]`);
+
+    expect(panel?.getAttribute("data-state")).toBe("expanded");
+    expect(panel?.getAttribute("data-display-mode")).toBe("panel");
+  });
+
+  it("wraps a tree with a stable module-level HOC and injects only sidePaneOpen as scope", () => {
+    const seen: Array<Record<string, unknown>> = [];
+    function Probe(props: { label: string }) {
+      seen.push(props);
+      const compact = useStatusCapsuleCompact();
+      return createElement("span", {
+        "data-testid": "probe",
+        "data-compact": compact ? "true" : "false",
+      });
+    }
+    const ScopedProbe = withSidePaneCapsuleScope(Probe);
+
+    const view = render(createElement(ScopedProbe, { sidePaneOpen: false, label: "scope" }));
+    const probe = screen.getByTestId("probe");
+    expect(probe.getAttribute("data-compact")).toBe("false");
+    expect(seen.at(-1)).toEqual({ label: "scope" });
+
+    view.rerender(createElement(ScopedProbe, { sidePaneOpen: true, label: "scope" }));
+    expect(screen.getByTestId("probe").getAttribute("data-compact")).toBe("true");
+    expect(seen.at(-1)).toEqual({ label: "scope" });
+    expect(ScopedProbe.displayName).toBe("withSidePaneCapsuleScope(Probe)");
+  });
+});
