@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+import { readCompleteTaskOutput, readTaskOutputCopySource } from "./contract.js";
+
+describe("complete task output copy contract", () => {
+  it("reads exact chunks and EOF before decoding", async () => {
+    const bytes = new TextEncoder().encode("中".repeat(100_000));
+    const calls: number[] = [];
+    const result = await readTaskOutputCopySource(
+      { path: "output", bytes: bytes.length },
+      async ({ offset, length }) => {
+        calls.push(length);
+        return bytes.slice(offset, offset + length);
+      },
+    );
+    expect(result).toBe("中".repeat(100_000));
+    expect(calls).toEqual([262144, 37856, 1]);
+  });
+  it("rejects stale and malformed output", async () => {
+    await expect(
+      readTaskOutputCopySource(
+        { path: "x", bytes: 1 },
+        async () => new Uint8Array(),
+        () => false,
+      ),
+    ).rejects.toThrow("Stale copy");
+    await expect(
+      readTaskOutputCopySource({ path: "x", bytes: 1 }, async ({ offset }) =>
+        offset ? new Uint8Array() : new Uint8Array([255]),
+      ),
+    ).rejects.toThrow();
+  });
+  it("accepts only complete matching non-agent envelopes", () => {
+    const envelope =
+      "<retrieval_status>success</retrieval_status>\n\n<task_id>t</task_id>\n\n<task_type>local_bash</task_type>\n\n<status>completed</status>\n\n<output>\nhello\n</output>";
+    expect(readCompleteTaskOutput(envelope, "t", false)).toBe("hello");
+    expect(readCompleteTaskOutput(envelope, "other", false)).toBeUndefined();
+    expect(readCompleteTaskOutput(envelope, "t", true)).toBeUndefined();
+    expect(
+      readCompleteTaskOutput(envelope.replace("local_bash", "local_agent"), "t", false),
+    ).toBeUndefined();
+  });
+});
