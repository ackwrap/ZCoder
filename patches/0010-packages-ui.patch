+const BACKGROUND_RUN_NOTICE_START =
+  /(?:^|\n)Command (?:(?:running in background)|(?:was manually backgrounded by user)|(?:exceeded the assistant-mode blocking budget))/u;
+
+export interface BackgroundRunNotice {
+  body: string;
+  taskId: string;
+  outputPath?: string;
+}
+
+/**
+ * Bash 后台结果正文是给模型的任务 ID/输出路径提示；卡片只展示「后台运行」摘要，
+ * 避免把模型指令当命令输出铺在前端。正文里的真实 stdout 仍保留。
+ */
+export function splitBackgroundRunNotice(text: string): BackgroundRunNotice | null {
+  const match = BACKGROUND_RUN_NOTICE_START.exec(text);
+  if (!match) return null;
+  const noticeStart = match[0].startsWith("\n") ? match.index + 1 : match.index;
+  const noticeSegment = text.slice(noticeStart);
+  const taskId = /with ID: ([A-Za-z0-9_-]+)/u.exec(noticeSegment)?.[1];
+  if (!taskId) return null;
+  const outputPath = /Output is being written to: (.+?)\.(?:\s|$)/u
+    .exec(noticeSegment)?.[1]
+    ?.trim();
+  return {
+    body: text.slice(0, match.index).trimEnd(),
+    taskId,
+    ...(outputPath ? { outputPath } : {}),
+  };
+}
