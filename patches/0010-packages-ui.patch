+      .then((view) => {
+        if (!current) return;
+        setCatalog(
+          view.providers.map((provider) => ({
+            providerId: provider.providerId,
+            providerName: provider.providerName,
+            models: provider.models.map((model) => ({ modelId: model.modelId })),
