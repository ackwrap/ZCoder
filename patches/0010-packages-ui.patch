diff --git a/packages/ui/test/v4ExploreRunSummary.test.ts b/packages/ui/test/v4ExploreRunSummary.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1e51a6d593a3078e3b890961d2bba39beaba6237
--- /dev/null
+++ b/packages/ui/test/v4ExploreRunSummary.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from "vitest";
+import zhCN from "@/i18n/locales/zh-CN.js";
+import { formatExploreRunSummary } from "@/ToolCallBlocks/renderers/explore.js";
+
+// 用真实中文词条拼装，既验证次数文案，也保证新增 key 与 locale 保持同步。
+const intl = {
+  formatMessage: ({ id }: { id: string }, values?: Record<string, string>) => {
+    const template = zhCN[id];
+    if (template === undefined) {
+      throw new Error(`missing i18n key: ${id}`);
+    }
+    return template.replace(/\{(\w+)\}/g, (_match, key: string) => values?.[key] ?? `{${key}}`);
+  },
+};
+
+describe("formatExploreRunSummary", () => {
+  it("lists lookups, thoughts and non-zero buckets in a stable order", () => {
+    expect(
+      formatExploreRunSummary(intl, {
+        exploreCount: 3,
+        reasoningCount: 2,
+        counts: { search: 2, fetch: 0, list: 1, file: 1 },
+      }),
+    ).toBe("查阅 3 次, 思考 2 次, 搜索 2 次, 列表 1 次, 文件 1 次");
+  });
+
+  it("omits reasoning and buckets that never occurred", () => {
+    expect(
+      formatExploreRunSummary(intl, {
+        exploreCount: 2,
+        reasoningCount: 0,
+        counts: { search: 0, fetch: 1, list: 0, file: 0 },
+      }),
+    ).toBe("查阅 2 次, 网页抓取 1 次");
+  });
+});
