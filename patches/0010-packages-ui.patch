+    expect(commands.map(({ value, description }) => [value, description])).toEqual([
+      ["model", "切换模型"],
+      ["effort", "设置推理强度"],
+    ]);
+    commands.forEach((command) => command.run());
+    expect(open).toHaveBeenCalledTimes(2);
+  });
+  it("omits commands without admission and reports unavailable menu", () => {
+    expect(createModelEffortCommands("en-US", null, vi.fn())).toEqual([]);
+    const notify = vi.fn();
+    createModelEffortCommands("en-US", () => false, notify)[0].run();
+    expect(notify).toHaveBeenCalledWith("The model menu is currently unavailable");
+  });
+  it("uses only the current pane trigger and respects disabled", () => {
+    const pane = document.createElement("div");
+    pane.innerHTML = '<button data-testid="chat-model-select-trigger">Model</button>';
+    const trigger = pane.querySelector("button")!;
+    const click = vi.fn();
+    trigger.addEventListener("keydown", click);
+    expect(openComposerModelMenu(pane)).toBe(true);
+    expect(click).toHaveBeenCalledOnce();
+    trigger.disabled = true;
+    expect(openComposerModelMenu(pane)).toBe(false);
+    trigger.disabled = false;
+    trigger.setAttribute("aria-disabled", "true");
+    expect(openComposerModelMenu(pane)).toBe(false);
+    expect(openComposerModelMenu(document.createElement("div"))).toBe(false);
+    expect(openComposerModelMenu(null)).toBe(false);
+    expect(click).toHaveBeenCalledOnce();
+  });
+  it("is included by the compatibility builder only when enabled", () => {
