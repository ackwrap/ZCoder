+// @vitest-environment jsdom
+import { createElement, type ComponentProps } from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, expectTypeOf, it, vi } from "vitest";
+import {
+  CompactResultMarker,
+  ContextSourceUpdateNotice,
+  type CompactResultMarkerProps,
+  type ContextSourceUpdateNoticeProps,
+} from "@/v4/context-artifacts/contract.js";
+import {
+  exampleCompactResultMarker,
+  exampleContextSourceUpdateNotice,
+} from "@/v4/context-artifacts/contract.example.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { DEFAULT_CODE_PREVIEW_SETTINGS } from "@/lib/codePreviewSettings.js";
+
+type ReadSummary = NonNullable<CompactResultMarkerProps["context"]["readCompactSummary"]>;
+
+function compactProps(readCompactSummary?: ReadSummary): CompactResultMarkerProps {
+  return {
+    row: {
+      rowId: 12,
+      turnId: "turn-1",
+      kind: "timelineMarker",
+      createdAt: 1,
+      createdAtSeq: 1,
+      marker: {
+        type: "compact",
+        status: "success",
+        origin: "manual",
+        operationId: "compact-1",
+        summaryRef: "summary-1",
+      },
+    },
+    context: {
+      workspacePath: "/repo",
+      workspaceIdentity: "workspace-1",
+      sessionId: "session-1",
+      logEpoch: "epoch-1",
+      branchGeneration: 2,
+      theme: "light",
+      codePreviewSettings: DEFAULT_CODE_PREVIEW_SETTINGS,
+      readCompactSummary,
+    },
+    label: "Saved context",
+    icon: null,
+  };
+}
+
+function localized(children: ReturnType<typeof createElement>) {
+  return createElement(ZCodeIntlProvider, { initialLocale: "en-US", children });
+}
+
+afterEach(cleanup);
+
+describe("v4 context artifacts UI contract", () => {
+  it("derives props from the original components and forwards them without a second owner", () => {
+    expectTypeOf<CompactResultMarkerProps>().toEqualTypeOf<
+      ComponentProps<typeof CompactResultMarker>
+    >();
+    expectTypeOf<ContextSourceUpdateNoticeProps>().toEqualTypeOf<
+      ComponentProps<typeof ContextSourceUpdateNotice>
+    >();
+    expectTypeOf<keyof CompactResultMarkerProps>().toEqualTypeOf<
+      "row" | "context" | "label" | "icon"
+    >();
+    expectTypeOf<keyof ContextSourceUpdateNoticeProps>().toEqualTypeOf<"row">();
+    const props = compactProps();
+    const compact = exampleCompactResultMarker(props);
+    const notice = exampleContextSourceUpdateNotice({ row: props.row });
+    expect(compact.type).toBe(CompactResultMarker);
+    expect(compact.props.context).toBe(props.context);
+    expect(compact.props.row).toBe(props.row);
+    expect(notice.type).toBe(ContextSourceUpdateNotice);
+    expect(notice.props.row).toBe(props.row);
+  });
+
+  it("reads only through the injected callback, lazily passing the exact projected identity", async () => {
+    const read = vi.fn<ReadSummary>().mockResolvedValue({
+      status: "unavailable",
+      reason: "notAuthorized",
+    });
+    const view = render(localized(exampleCompactResultMarker(compactProps(read))));
+    expect(read).not.toHaveBeenCalled();
+    expect(view.container.textContent).toContain("Saved context");
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.container.textContent).toContain("Summary unavailable"));
+    expect(read).toHaveBeenCalledExactlyOnceWith({
+      sessionId: "session-1",
+      baseLogEpoch: "epoch-1",
+      branchGeneration: 2,
+      rowId: 12,
+      operationId: "compact-1",
+      summaryRef: "summary-1",
+    } satisfies Parameters<ReadSummary>[0]);
+    expect(view.container.querySelectorAll('[data-row-kind="timelineMarker"]')).toHaveLength(1);
+  });
+
+  it("does not fall back to a service when the host omits the read capability", async () => {
+    const view = render(localized(createElement(CompactResultMarker, compactProps())));
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.container.textContent).toContain("Summary unavailable"));
+    expect(view.queryByRole("button", { name: "Retry" })).toBeNull();
+  });
+
+  it("keeps host read errors out of rendered output", async () => {
+    const secret = "PRIVATE /session.db credential=secret";
+    const read = vi.fn<ReadSummary>().mockRejectedValue(new Error(secret));
+    const view = render(localized(createElement(CompactResultMarker, compactProps(read))));
+    fireEvent.click(view.getByRole("button", { expanded: false }));
+    await waitFor(() => expect(view.getByRole("button", { name: "Retry" })).toBeTruthy());
+    expect(view.container.innerHTML).not.toContain(secret);
+    expect(view.container.textContent).not.toContain("PRIVATE");
+  });
+
+  it("renders notice labels as text without keys, revisions, prompt bodies or checkpoints", () => {
+    const label = '<img src=x onerror="alert(1)">';
+    const update = {
+      version: 1 as const,
+      kind: "instructions" as const,
+      sourceKey: "PRIVATE CATALOG KEY",
+      revision: "a".repeat(64),
+      content: "PRIVATE PROMPT BODY",
+      runtimeCheckpoint: { token: "PRIVATE TOKEN" },
+      changes: [
+        { sourceKey: "PRIVATE ITEM KEY", label, change: "replaced" as const, body: "PRIVATE BODY" },
+      ],
+    };
+    const props: ContextSourceUpdateNoticeProps = {
+      row: {
+        rowId: 13,
+        turnId: "turn-1",
+        kind: "timelineMarker",
+        createdAt: 1,
+        createdAtSeq: 1,
+        marker: { type: "contextSourceUpdate", update },
+      },
+    };
+    const view = render(localized(exampleContextSourceUpdateNotice(props)));
+    expect(view.container.textContent).toContain(label);
+    expect(view.container.textContent).toContain("Changed");
+    expect(view.container.innerHTML).not.toContain("PRIVATE");
+    expect(view.container.innerHTML).not.toContain(update.revision);
+    expect(view.container.querySelector("img, script")).toBeNull();
+    expect(view.container.querySelector('[data-row-kind="userInput"]')).toBeNull();
+    expect(
+      view.container.querySelectorAll('[data-marker-type="contextSourceUpdate"]'),
+    ).toHaveLength(1);
+  });
+});
