+    expect(onTailChange).toHaveBeenCalledTimes(1);
+
+    await act(async () => {
+      fireEvent.blur(input);
+      fireEvent.keyDown(input, { key: "Enter" });
+    });
+    expect(onTailChange).toHaveBeenCalledTimes(1);
+
+    await act(async () => {
+      resolveSave?.();
+      await pendingSave;
+    });
+    await waitFor(() => expect(input.disabled).toBe(false));
+  });
+});
