++// Local extension: OpenAI Responses returns URL citations inside
++// `output_text.annotations`, which the baseline parser previously discarded.
++// Keep only http(s) links and expose them through finish providerMetadata so
++// streaming and generate() consumers observe the same references.
++const httpCitationUrl = (value) => {
++    if (typeof value !== "string" || value.length === 0)
++        return undefined;
++    try {
++        const parsed = new URL(value);
++        return parsed.protocol === "http:" || parsed.protocol === "https:" ? value : undefined;
++    }
++    catch {
++        return undefined;
++    }
++};
++const urlCitationsFromResponseOutput = (output) => {
++    if (!Array.isArray(output))
++        return [];
++    const seen = new Set();
++    const citations = [];
++    for (const item of output) {
++        if (!ProviderShared.isRecord(item) || item.type !== "message" || !Array.isArray(item.content))
++            continue;
++        for (const part of item.content) {
++            if (!ProviderShared.isRecord(part) || part.type !== "output_text" || !Array.isArray(part.annotations))
++                continue;
++            for (const annotation of part.annotations) {
++                if (!ProviderShared.isRecord(annotation) || annotation.type !== "url_citation")
++                    continue;
++                const url = httpCitationUrl(annotation.url);
++                if (!url || seen.has(url))
++                    continue;
++                seen.add(url);
++                citations.push({
++                    url,
++                    ...(typeof annotation.title === "string" && annotation.title.length > 0
++                        ? { title: annotation.title }
++                        : {}),
++                });
++            }
++        }
++    }
++    return citations;
++};
