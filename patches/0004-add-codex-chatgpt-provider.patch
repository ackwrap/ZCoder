@@ -0,0 +1,593 @@
+// Protocol reference: anomalyco/opencode c93aaae, provider/chatgpt.ts (MIT).
+// ZCode owns its client registration and credentials; it never impersonates OpenCode.
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { createServer, type Server, type ServerResponse } from "node:http";
+import { createRemoteJWKSet, customFetch, jwtVerify } from "jose";
+import { z } from "zod";
+import {
+  DEVICE_CLIENT_ID,
+  DEVICE_VERIFICATION_URL,
+  requestDeviceCode,
+  pollDeviceTokens,
+  requestDeviceTokens,
+} from "./device.js";
+import type {
+  CodexConnectionStatus,
+  CodexRequestAuthResolver,
+  ICodexProviderService,
+} from "./contract.js";
+
+const ISSUER = "https://auth.openai.com";
+const RESOURCE = "https://api.openai.com/v1";
+const SHARING_SCOPE = "chatgpt.tokens.use.direct";
+const FLOW_TIMEOUT_MS = 10 * 60_000;
+const HTTP_TIMEOUT_MS = 20_000;
+const REFRESH_MARGIN_MS = 60_000;
+const providerIdSchema = z.string().trim().min(1).max(200);
+const tokenSchema = z.object({
+  access_token: z.string().min(1),
+  refresh_token: z.string().min(1),
+  id_token: z.string().optional(),
+  expires_in: z.number().positive().optional(),
+  scope: z.string().optional(),
+});
+const storedSchema = z
+  .object({
+    hostID: z.string().min(1),
+    revision: z.string().min(1),
+    clientID: z.string().min(1).optional(),
+    tokens: z
+      .object({
+        access: z.string().min(1),
+        refresh: z.string().min(1),
+        expires: z.number().finite(),
+        scopes: z.array(z.string()),
+        method: z.literal("device").optional(),
+        accountID: z.string().min(1).optional(),
+      })
+      .optional(),
+  })
+  .strict();
+type Stored = z.infer<typeof storedSchema>;
+type Tokens = z.infer<typeof tokenSchema>;
+interface Flow {
+  id: string;
+  state: "waiting" | "connected" | "cancelled" | "failed";
+  error?: string;
+  server?: Server;
+  device?: { verificationUrl: string; userCode: string; expiresAt: number };
+  abort: AbortController;
+  timer?: ReturnType<typeof setTimeout>;
+  completing: boolean;
+}
+interface Options {
+  onConnected?(providerId: string): void;
+  beforeIdentityChange?(providerId: string): Promise<void>;
+  credentials: {
+    load(key: string): Promise<string | null>;
+    save(key: string, value: string, assertCurrent?: () => void): Promise<void>;
+    delete(key: string): Promise<void>;
+  };
+  assertProvider(providerId: string): Promise<void>;
+  withLock<T>(providerId: string, run: () => Promise<T>): Promise<T>;
+  fetch: typeof globalThis.fetch;
+  /** Only the owning local desktop Host can start a loopback flow. */
+  canLogin: boolean;
+}
+
+export function createCodexProviderService(
+  options: Options,
+): ICodexProviderService &
+  CodexRequestAuthResolver & { dispose(): void; forget(providerId: string): Promise<void> } {
+  const flows = new Map<string, Flow>();
+  let disposed = false;
+  // 同一 Host 先排队，再进入跨进程锁，避免同窗并发 refresh 轮换同一令牌。
+  let queue: Promise<unknown> = Promise.resolve();
+  const locked = <T>(id: string, run: () => Promise<T>): Promise<T> => {
+    const result = queue.then(() => options.withLock(id, run));
+    queue = result.catch(() => {});
+    return result;
+  };
+  const key = (id: string) => `codex:${createHash("sha256").update(id).digest("hex")}`;
+  const load = async (id: string): Promise<Stored | null> => {
+    const raw = await options.credentials.load(key(id));
+    if (raw === null) return null;
+    // 不吞掉损坏记录，也不把可能含 token 的 schema issues 暴露给 UI / 日志。
+    try {
+      return storedSchema.parse(JSON.parse(raw));
+    } catch {
+      throw new Error("codex-credential-invalid");
+    }
+  };
+  const save = (id: string, record: Stored, assertCurrent?: () => void) =>
+    options.credentials.save(key(id), JSON.stringify(record), assertCurrent);
+  const assertLive = () => {
+    if (disposed) throw new Error("codex-host-closed");
+  };
+  const stop = (flow: Flow) => {
+    if (flow.timer) clearTimeout(flow.timer);
+    flow.abort.abort();
+    flow.server?.close();
+    flow.server?.closeIdleConnections();
+    delete flow.device;
+  };
+  const cancelFlow = (id: string) => {
+    const flow = flows.get(id);
+    if (flow?.state === "waiting") {
+      flow.state = "cancelled";
+      stop(flow);
+    }
+  };
+  const request = async (body: URLSearchParams, signal?: AbortSignal): Promise<Tokens> => {
+    const timeout = AbortSignal.timeout(HTTP_TIMEOUT_MS);
+    const response = await options.fetch(`${ISSUER}/api/accounts/oauth/token`, {
+      method: "POST",
+      redirect: "error",
+      headers: { "Content-Type": "application/x-www-form-urlencoded", "User-Agent": "ZCode" },
+      body: body.toString(),
+      signal: signal ? AbortSignal.any([signal, timeout]) : timeout,
+    });
+    if (!response.ok) throw new Error(`codex-token-http-${response.status}`);
+    const parsed = tokenSchema.safeParse(await response.json());
+    if (!parsed.success) throw new Error("codex-token-invalid");
+    return parsed.data;
+  };
+  const jwks = createRemoteJWKSet(new URL(`${ISSUER}/.well-known/jwks.json`), {
+    timeoutDuration: HTTP_TIMEOUT_MS,
+    [customFetch]: (url, init) => options.fetch(url, init),
+  });
+  const material = (tokens: Tokens, scopes?: string[]): NonNullable<Stored["tokens"]> => ({
+    access: tokens.access_token,
+    refresh: tokens.refresh_token,
+    expires: Date.now() + (tokens.expires_in ?? 3600) * 1000,
+    scopes: tokens.scope?.split(" ").filter(Boolean) ?? scopes ?? [],
+  });
+  const deviceAccount = async (token: string | undefined): Promise<string> => {
+    if (!token) throw new Error("codex-id-token-invalid");
+    try {
+      const { payload } = await jwtVerify(token, jwks, {
+        issuer: ISSUER,
+        audience: DEVICE_CLIENT_ID,
+        algorithms: ["RS256"],
+        requiredClaims: ["exp", "sub"],
+      });
+      const auth = z
+        .object({ chatgpt_account_id: z.string().trim().min(1).max(300) })
+        .safeParse(payload["https://api.openai.com/auth"] ?? payload);
+      if (!auth.success || typeof payload.sub !== "string" || !payload.sub.trim())
+        throw new Error();
+      return auth.data.chatgpt_account_id;
+    } catch {
+      throw new Error("codex-id-token-invalid");
+    }
+  };
+
+  return {
+    async status(rawId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      await options.assertProvider(id);
+      const record = await load(id);
+      const flow = flows.get(id);
+      return {
+        connected: Boolean(
+          record?.tokens?.method === "device"
+            ? record.tokens.accountID
+            : record?.clientID && record.tokens?.scopes.includes(SHARING_SCOPE),
+        ),
+        ...(record?.tokens
+          ? {
+              method:
+                record.tokens.method === "device" ? ("device" as const) : ("browser" as const),
+            }
+          : {}),
+        loginAvailable: options.canLogin,
+        ...(flow
+          ? {
+              flow: {
+                id: flow.id,
+                state: flow.state,
+                ...(flow.error ? { error: flow.error } : {}),
+                ...(flow.state === "waiting" && flow.device ? { device: { ...flow.device } } : {}),
+              },
+            }
+          : {}),
+      } satisfies CodexConnectionStatus;
+    },
+    async start(rawId) {
+      assertLive();
+      if (!options.canLogin) throw new Error("codex-local-desktop-required");
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await options.assertProvider(id);
+      return locked(id, async () => {
+        assertLive();
+        cancelFlow(id);
+        const previous = await load(id);
+        const record: Stored = {
+          ...previous,
+          hostID: previous?.hostID ?? `urn:uuid:${randomUUID()}`,
+          revision: randomUUID(),
+        };
+        await save(id, record);
+        const state = randomBytes(32).toString("base64url");
+        const nonce = randomBytes(32).toString("base64url");
+        const verifier = randomBytes(32).toString("base64url");
+        const challenge = createHash("sha256").update(verifier).digest("base64url");
+        let redirect = "";
+        const flow: Flow = {
+          id: record.revision,
+          state: "waiting",
+          completing: false,
+          abort: new AbortController(),
+          server: createServer((req, res) => {
+            const url = new URL(req.url ?? "/", "http://127.0.0.1");
+            if (req.method !== "GET" || url.pathname !== "/auth/callback") {
+              res.writeHead(404).end();
+              return;
+            }
+            // 必须先校验 state，错误回调同样受 CSRF 约束。
+            if (url.searchParams.get("state") !== state) {
+              respond(res, false);
+              return;
+            }
+            if (flow.state !== "waiting" || flow.completing) {
+              res.writeHead(409).end();
+              return;
+            }
+            flow.completing = true;
+            void (async () => {
+              try {
+                if (url.searchParams.has("error")) throw new Error("codex-authorization-denied");
+                const code = url.searchParams.get("code");
+                const returnedID = url.searchParams.get("client_id");
+                if (record.clientID && returnedID && record.clientID !== returnedID)
+                  throw new Error("codex-client-mismatch");
+                const clientID = record.clientID ?? returnedID;
+                if (!code || !clientID) throw new Error("codex-callback-incomplete");
+                const tokens = await request(
+                  new URLSearchParams({
+                    grant_type: "authorization_code",
+                    client_id: clientID,
+                    code,
+                    code_verifier: verifier,
+                    redirect_uri: redirect,
+                    resource: RESOURCE,
+                  }),
+                  flow.abort.signal,
+                );
+                if (!tokens.scope?.split(" ").includes(SHARING_SCOPE))
+                  throw new Error("codex-token-sharing-required");
+                if (!tokens.id_token) throw new Error("codex-id-token-invalid");
+                try {
+                  const { payload } = await jwtVerify(tokens.id_token, jwks, {
+                    issuer: ISSUER,
+                    audience: clientID,
+                    algorithms: ["RS256"],
+                    requiredClaims: ["exp", "nonce", "sub"],
+                  });
+                  if (
+                    typeof payload.sub !== "string" ||
+                    !payload.sub.trim() ||
+                    payload.nonce !== nonce
+                  )
+                    throw new Error();
+                } catch {
+                  throw new Error("codex-id-token-invalid");
+                }
+                await locked(id, async () => {
+                  assertLive();
+                  const current = await load(id);
+                  if (
+                    flow.state !== "waiting" ||
+                    flows.get(id) !== flow ||
+                    current?.revision !== record.revision
+                  )
+                    throw new Error("codex-login-cancelled");
+                  const assertAttempt = () => {
+                    assertLive();
+                    if (flow.state !== "waiting" || flows.get(id) !== flow)
+                      throw new Error("codex-login-cancelled");
+                  };
+                  await options.assertProvider(id);
+                  assertAttempt();
+                  try {
+                    // CredentialService 在其文件锁内复核代次；外层锁同时排除跨 Host 刷新。
+                    await save(
+                      id,
+                      { ...current, clientID, tokens: material(tokens) },
+                      assertAttempt,
+                    );
+                    assertAttempt();
+                  } catch (error) {
+                    // 原子写入期间的取消无法撤回 IO；仍持有外层锁时恢复本次提交前的凭据，
+                    // 不用开始登录时的旧快照覆盖等待期间已经轮换过的 refresh token。
+                    if (flow.state !== "waiting" || disposed) await save(id, current);
+                    throw error;
+                  }
+                });
+                flow.state = "connected";
+                options.onConnected?.(id);
+                respond(res, true);
+              } catch (error) {
+                if (flow.state === "waiting") {
+                  flow.state = "failed";
+                  flow.error =
+                    error instanceof Error && /^codex-[a-z-]+(?:-\d{3})?$/.test(error.message)
+                      ? error.message
+                      : "codex-login-failed";
+                }
+                respond(res, false);
+              } finally {
+                stop(flow);
+              }
+            })();
+          }),
+        };
+        await new Promise<void>((resolve, reject) => {
+          flow.server!.once("error", reject);
+          flow.server!.listen(0, "127.0.0.1", () => {
+            flow.server!.off("error", reject);
+            resolve();
+          });
+        });
+        if (disposed) {
+          stop(flow);
+          throw new Error("codex-host-closed");
+        }
+        const address = flow.server!.address();
+        if (!address || typeof address === "string") {
+          stop(flow);
+          throw new Error("codex-loopback-unavailable");
+        }
+        redirect = `http://127.0.0.1:${address.port}/auth/callback`;
+        flows.set(id, flow);
+        flow.timer = setTimeout(() => {
+          if (flow.state === "waiting") {
+            flow.state = "failed";
+            flow.error = "codex-login-timeout";
+            stop(flow);
+          }
+        }, FLOW_TIMEOUT_MS);
+        flow.timer.unref();
+        const params = new URLSearchParams({
+          client_id: record.clientID ?? "dynamic_agent_client",
+          ...(record.clientID ? {} : { agent_name_hint: "ZCode" }),
+          ext_agent_host_id: record.hostID,
+          response_type: "code",
+          redirect_uri: redirect,
+          scope: `openid profile email offline_access resource.invoke ${SHARING_SCOPE}`,
+          resource: RESOURCE,
+          state,
+          nonce,
+          code_challenge_method: "S256",
+          code_challenge: challenge,
+        });
+        return { flowId: flow.id, authorizeUrl: `${ISSUER}/api/accounts/authorize?${params}` };
+      });
+    },
+    async startDevice(rawId) {
+      assertLive();
+      if (!options.canLogin) throw new Error("codex-local-desktop-required");
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await options.assertProvider(id);
+      const flow = await locked(id, async () => {
+        assertLive();
+        cancelFlow(id);
+        const previous = await load(id);
+        const revision = randomUUID();
+        await save(id, {
+          ...previous,
+          hostID: previous?.hostID ?? `urn:uuid:${randomUUID()}`,
+          revision,
+        });
+        const next: Flow = {
+          id: revision,
+          state: "waiting",
+          abort: new AbortController(),
+          completing: false,
+        };
+        flows.set(id, next);
+        next.timer = setTimeout(() => {
+          if (next.state === "waiting") {
+            next.state = "failed";
+            next.error = "codex-device-expired";
+            stop(next);
+          }
+        }, 900_000);
+        next.timer.unref();
+        return next;
+      });
+      const assertAttempt = () => {
+        assertLive();
+        if (flow.state !== "waiting" || flows.get(id) !== flow)
+          throw new Error("codex-login-cancelled");
+      };
+      const fail = (error: unknown) => {
+        if (flow.state === "waiting") {
+          flow.state = "failed";
+          flow.error =
+            error instanceof Error && /^codex-[a-z-]+$/.test(error.message)
+              ? error.message
+              : "codex-device-login-failed";
+        }
+        stop(flow);
+      };
+      try {
+        const device = await requestDeviceCode(options.fetch, flow.abort.signal);
+        assertAttempt();
+        if (flow.timer) clearTimeout(flow.timer);
+        flow.device = {
+          verificationUrl: DEVICE_VERIFICATION_URL,
+          userCode: device.user_code,
+          expiresAt: Date.now() + device.expiresMs,
+        };
+        flow.timer = setTimeout(() => {
+          if (flow.state === "waiting") {
+            flow.state = "failed";
+            flow.error = "codex-device-expired";
+            stop(flow);
+          }
+        }, device.expiresMs);
+        flow.timer.unref();
+        const result = { flowId: flow.id, ...flow.device };
+        void (async () => {
+          try {
+            const tokens = await pollDeviceTokens(options.fetch, device, flow.abort.signal);
+            assertAttempt();
+            const accountID = await deviceAccount(tokens.id_token);
+            await locked(id, async () => {
+              assertAttempt();
+              await options.assertProvider(id);
+              const current = await load(id);
+              if (!current || current.revision !== flow.id)
+                throw new Error("codex-login-cancelled");
+              try {
+                await save(
+                  id,
+                  { ...current, tokens: { ...material(tokens), method: "device", accountID } },
+                  assertAttempt,
+                );
+                assertAttempt();
+              } catch (error) {
+                if (flow.state !== "waiting" || disposed) await save(id, current);
+                throw error;
+              }
+            });
+            flow.state = "connected";
+            options.onConnected?.(id);
+            stop(flow);
+          } catch (error) {
+            fail(error);
+          }
+        })();
+        return result;
+      } catch (error) {
+        fail(error);
+        throw new Error(flow.error ?? "codex-device-login-failed");
+      }
+    },
+    async cancel(rawId, flowId) {
+      const id = providerIdSchema.parse(rawId);
+      const flow = flows.get(id);
+      if (!flow || flow.id !== flowId || flow.state !== "waiting") return;
+      cancelFlow(id);
+      await locked(id, async () => {
+        const record = await load(id);
+        if (record?.revision === flowId) await save(id, { ...record, revision: randomUUID() });
+      });
+    },
+    async disconnect(rawId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await locked(id, async () => {
+        const record = await load(id);
+        if (!record) return;
+        const { tokens: _, ...identity } = record;
+        await save(id, { ...identity, revision: randomUUID() });
+      });
+    },
+    async forget(rawId) {
+      const id = providerIdSchema.parse(rawId);
+      cancelFlow(id);
+      await options.beforeIdentityChange?.(id);
+      await locked(id, () => options.credentials.delete(key(id)));
+    },
+    async resolve(rawId, sessionId) {
+      assertLive();
+      const id = providerIdSchema.parse(rawId);
+      await options.assertProvider(id);
+      return locked(id, async (): ReturnType<CodexRequestAuthResolver["resolve"]> => {
+        assertLive();
+        const record = await load(id);
+        if (
+          !record?.tokens ||
+          (record.tokens.method === "device"
+            ? !record.tokens.accountID
+            : !record.clientID || !record.tokens.scopes.includes(SHARING_SCOPE))
+        )
+          throw new Error("codex-login-required");
+        if (record.tokens.method === "device") {
+          if (record.tokens.expires <= Date.now() + REFRESH_MARGIN_MS) {
+            const tokens = await requestDeviceTokens(
+              options.fetch,
+              new URLSearchParams({
+                grant_type: "refresh_token",
+                refresh_token: record.tokens.refresh,
+              }),
+              AbortSignal.timeout(HTTP_TIMEOUT_MS),
+            );
+            const accountID = tokens.id_token
+              ? await deviceAccount(tokens.id_token)
+              : record.tokens.accountID!;
+            if (accountID !== record.tokens.accountID)
+              throw new Error("codex-device-account-mismatch");
+            assertLive();
+            await options.assertProvider(id);
+            record.tokens = { ...material(tokens), method: "device", accountID };
+            await save(id, record);
+          }
+          return {
+            apiKey: record.tokens.access,
+            codexMode: "device" as const,
+            headers: {
+              "chatgpt-account-id": record.tokens.accountID!,
+              originator: "zcode",
+              "session-id": sessionId,
+              "thread-id": sessionId,
+              "x-client-request-id": sessionId,
+            },
+          };
+        }
+        if (record.tokens.expires <= Date.now() + REFRESH_MARGIN_MS) {
+          const tokens = await request(
+            new URLSearchParams({
+              grant_type: "refresh_token",
+              client_id: record.clientID!,
+              refresh_token: record.tokens.refresh,
+              resource: RESOURCE,
+            }),
+          );
+          assertLive();
+          await options.assertProvider(id);
+          record.tokens = material(tokens, record.tokens.scopes);
+          if (!record.tokens.scopes.includes(SHARING_SCOPE))
+            throw new Error("codex-token-sharing-required");
+          await save(id, record);
+        }
+        return {
+          apiKey: record.tokens.access,
+          headers: {
+            "session-id": sessionId,
+            "thread-id": sessionId,
+            "x-client-request-id": sessionId,
+          },
+        };
+      });
+    },
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      for (const id of flows.keys()) cancelFlow(id);
+      flows.clear();
+    },
+  };
+}
+
+function respond(response: ServerResponse, success: boolean) {
+  response
+    .writeHead(success ? 200 : 400, {
+      "Content-Type": "text/html; charset=utf-8",
+      "Cache-Control": "no-store",
+      "Content-Security-Policy": "default-src 'none'; frame-ancestors 'none'",
+      "Referrer-Policy": "no-referrer",
+    })
+    .end(
+      `<!doctype html><title>ZCode Codex</title><p>${success ? "Authorization complete. Return to ZCode." : "Authorization failed. Return to ZCode and try again."}</p>`,
+    );
+}
