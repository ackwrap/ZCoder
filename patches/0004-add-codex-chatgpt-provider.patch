diff --git a/packages/services/test/codexDeviceLogin.test.ts b/packages/services/test/codexDeviceLogin.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e6ab1142b0bda03671eabe95e57ccf746896cc3
--- /dev/null
+++ b/packages/services/test/codexDeviceLogin.test.ts
@@ -0,0 +1,238 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createHash } from "node:crypto";
+import { exportJWK, generateKeyPair, SignJWT } from "jose";
+import { createCodexProviderService } from "../src/codex-provider/index.js";
+
+const owners: Array<ReturnType<typeof createCodexProviderService>> = [];
+afterEach(() => {
+  for (const owner of owners.splice(0)) owner.dispose();
+  vi.useRealTimers();
+});
+async function fixture() {
+  const pair = await generateKeyPair("RS256");
+  const jwk = await exportJWK(pair.publicKey);
+  const values = new Map<string, string>();
+  const calls: Array<{ path: string; body: string }> = [];
+  const connected = vi.fn();
+  let pending = false;
+  let denied = false;
+  let wrongAudience = false;
+  let expires = 900;
+  let slow = false;
+  let exchangeGate: Promise<void> | undefined;
+  const owner = createCodexProviderService({
+    canLogin: true,
+    onConnected: connected,
+    assertProvider: async (id) => {
+      if (id !== "device-fixture") throw new Error("not-codex");
+    },
+    withLock: async (_id, run) => run(),
+    credentials: {
+      load: async (id) => values.get(id) ?? null,
+      save: async (id, value, assert) => {
+        assert?.();
+        values.set(id, value);
+      },
+      delete: async (id) => {
+        values.delete(id);
+      },
+    },
+    fetch: async (input, init) => {
+      const url = new URL(String(input));
+      expect(url.origin).toBe("https://auth.openai.com");
+      if (url.pathname.endsWith("jwks.json"))
+        return Response.json({ keys: [{ ...jwk, kid: "device-test", alg: "RS256" }] });
+      expect(init?.redirect).toBe("error");
+      calls.push({ path: url.pathname, body: String(init?.body) });
+      if (url.pathname.endsWith("/deviceauth/usercode"))
+        return Response.json({
+          device_auth_id: "private-device-id",
+          user_code: "ABCD-EFGH",
+          interval: "1",
+          expires_in: expires,
+        });
+      if (url.pathname.endsWith("/deviceauth/token")) {
+        if (slow)
+          return Response.json(
+            { error: "slow_down" },
+            { status: 429, headers: { "retry-after": "30" } },
+          );
+        if (denied) return Response.json({ error: "access_denied" }, { status: 403 });
+        if (pending) return Response.json({ error: "authorization_pending" }, { status: 403 });
+        return Response.json({
+          authorization_code: "private-auth-code",
+          code_verifier: "private-verifier",
+        });
+      }
+      expect(url.pathname).toBe("/oauth/token");
+      await exchangeGate;
+      const idToken = await new SignJWT({
+        sub: "fixture-subject",
+        "https://api.openai.com/auth": { chatgpt_account_id: "fixture-account" },
+      })
+        .setProtectedHeader({ alg: "RS256", kid: "device-test" })
+        .setIssuer("https://auth.openai.com")
+        .setAudience(wrongAudience ? "wrong-client" : "app_EMoamEEZ73f0CkXaXp7hrann")
+        .setExpirationTime("1h")
+        .sign(pair.privateKey);
+      return Response.json({
+        access_token: "fixture-device-token",
+        refresh_token: "fixture-device-refresh",
+        id_token: idToken,
+        expires_in: 3600,
+      });
+    },
+  });
+  owners.push(owner);
+  return {
+    owner,
+    values,
+    calls,
+    connected,
+    slow: (v: boolean) => {
+      slow = v;
+    },
+    pending: (v: boolean) => {
+      pending = v;
+    },
+    denied: () => {
+      denied = true;
+    },
+    wrongAudience: () => {
+      wrongAudience = true;
+    },
+    expires: (v: number) => {
+      expires = v;
+    },
+    gate: (v: Promise<void>) => {
+      exchangeGate = v;
+    },
+  };
+}
+describe("Codex explicit device login", () => {
+  it("retains an existing browser connection when device authorization is denied", async () => {
+    const f = await fixture();
+    const key = `codex:${createHash("sha256").update("device-fixture").digest("hex")}`;
+    f.values.set(
+      key,
+      JSON.stringify({
+        hostID: "fixture-host",
+        revision: "previous",
+        clientID: "fixture-browser-client",
+        tokens: {
+          access: "fixture-browser-token",
+          refresh: "fixture-browser-refresh",
+          expires: Date.now() + 3600000,
+          scopes: ["chatgpt.tokens.use.direct"],
+        },
+      }),
+    );
+    f.denied();
+    await f.owner.startDevice("device-fixture");
+    await vi.waitFor(async () =>
+      expect((await f.owner.status("device-fixture")).flow?.state).toBe("failed"),
+    );
+    expect(await f.owner.resolve("device-fixture", "session-fixture")).toMatchObject({
+      apiKey: "fixture-browser-token",
+    });
+    expect((await f.owner.resolve("device-fixture", "session-fixture")).codexMode).toBeUndefined();
+    expect(JSON.parse(f.values.get(key)!).clientID).toBe("fixture-browser-client");
+  });
+  it("uses the device flow, signed account identity, and a separate refresh endpoint", async () => {
+    const f = await fixture();
+    const started = await f.owner.startDevice("device-fixture");
+    expect(started).toMatchObject({
+      verificationUrl: "https://auth.openai.com/codex/device",
+      userCode: "ABCD-EFGH",
+    });
+    expect(JSON.stringify(started)).not.toContain("private-device-id");
+    await vi.waitFor(async () =>
+      expect((await f.owner.status("device-fixture")).connected).toBe(true),
+    );
+    const status = await f.owner.status("device-fixture");
+    expect(status.method).toBe("device");
+    expect(status.flow?.device).toBeUndefined();
+    expect(f.connected).toHaveBeenCalledOnce();
+    expect(await f.owner.resolve("device-fixture", "session-fixture")).toMatchObject({
+      apiKey: "fixture-device-token",
+      codexMode: "device",
+      headers: { "chatgpt-account-id": "fixture-account", originator: "zcode" },
+    });
+    const exchange = new URLSearchParams(f.calls.find((c) => c.path === "/oauth/token")!.body);
+    expect(exchange.get("redirect_uri")).toBe("https://auth.openai.com/deviceauth/callback");
+    expect(exchange.has("resource")).toBe(false);
+    for (const [key, raw] of f.values) {
+      const value = JSON.parse(raw);
+      value.tokens.expires = 0;
+      f.values.set(key, JSON.stringify(value));
+    }
+    await f.owner.resolve("device-fixture", "session-fixture");
+    expect(new URLSearchParams(f.calls.at(-1)!.body).get("grant_type")).toBe("refresh_token");
+    expect(JSON.stringify(status)).not.toContain("fixture-device-token");
+  });
+  it("respects pending intervals and hides the user code on cancellation", async () => {
+    const f = await fixture();
+    f.pending(true);
+    vi.useFakeTimers();
+    const started = await f.owner.startDevice("device-fixture");
+    await vi.advanceTimersByTimeAsync(0);
+    expect(f.calls.filter((c) => c.path.endsWith("/deviceauth/token"))).toHaveLength(1);
+    await vi.advanceTimersByTimeAsync(3999);
+    expect(f.calls.filter((c) => c.path.endsWith("/deviceauth/token"))).toHaveLength(1);
+    await f.owner.cancel("device-fixture", started.flowId);
+    await vi.advanceTimersByTimeAsync(10000);
+    expect((await f.owner.status("device-fixture")).flow).toMatchObject({ state: "cancelled" });
+    expect((await f.owner.status("device-fixture")).flow?.device).toBeUndefined();
+    expect(f.calls.filter((c) => c.path.endsWith("/deviceauth/token"))).toHaveLength(1);
+  });
+  it.each(["denied", "wrong-audience"])("rejects %s without saving tokens", async (mode) => {
+    const f = await fixture();
+    if (mode === "denied") f.denied();
+    else f.wrongAudience();
+    await f.owner.startDevice("device-fixture");
+    await vi.waitFor(async () =>
+      expect((await f.owner.status("device-fixture")).flow?.state).toBe("failed"),
+    );
+    expect([...f.values.values()].some((v) => v.includes("fixture-device-token"))).toBe(false);
+    expect(f.connected).not.toHaveBeenCalled();
+  });
+  it("honors Retry-After instead of shortening provider rate limits", async () => {
+    const f = await fixture();
+    f.slow(true);
+    vi.useFakeTimers();
+    const started = await f.owner.startDevice("device-fixture");
+    await vi.advanceTimersByTimeAsync(29999);
+    expect(f.calls.filter((c) => c.path.endsWith("/deviceauth/token"))).toHaveLength(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(f.calls.filter((c) => c.path.endsWith("/deviceauth/token"))).toHaveLength(2);
+    await f.owner.cancel("device-fixture", started.flowId);
+  });
+  it("expires the attempt and does not commit late exchanges after deletion", async () => {
+    const f = await fixture();
+    f.pending(true);
+    f.expires(1);
+    vi.useFakeTimers();
+    await f.owner.startDevice("device-fixture");
+    await vi.advanceTimersByTimeAsync(1001);
+    expect((await f.owner.status("device-fixture")).flow).toMatchObject({
+      state: "failed",
+      error: "codex-device-expired",
+    });
+    f.pending(false);
+    f.expires(900);
+    vi.useRealTimers();
+    let release!: () => void;
+    f.gate(
+      new Promise<void>((resolve) => {
+        release = resolve;
+      }),
+    );
+    await f.owner.startDevice("device-fixture");
+    await vi.waitFor(() => expect(f.calls.some((c) => c.path === "/oauth/token")).toBe(true));
+    await f.owner.forget("device-fixture");
+    release();
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    expect(f.values.size).toBe(0);
+    expect(f.connected).not.toHaveBeenCalled();
+  });
+});
