diff --git a/packages/ui/src/codex-provider/CONTRACT.md b/packages/ui/src/codex-provider/CONTRACT.md
new file mode 100644
index 0000000000000000000000000000000000000000..f7a947d832586fb2ecfd13c280b76f4cd01c1643
