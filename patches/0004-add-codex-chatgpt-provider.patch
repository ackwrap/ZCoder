diff --git a/packages/ui/test/browser/manual-review/pending/codex-device.fixture.tsx b/packages/ui/test/browser/manual-review/pending/codex-device.fixture.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3237d1a2291903006e5e35bbc2575d04f6969f71
--- /dev/null
+++ b/packages/ui/test/browser/manual-review/pending/codex-device.fixture.tsx
@@ -0,0 +1,75 @@
+import { useState } from "react";
+import { createRoot } from "react-dom/client";
+import type { IPlatformService } from "@zcode/shared";
+import type { IServiceAccessor, CodexConnectionStatus } from "@zcode/services";
+import { ServiceProvider } from "@/hooks/useServices.js";
+import { PlatformProvider } from "@/hooks/usePlatform.js";
+import { ZCodeIntlProvider } from "@/i18n/IntlProvider.js";
+import { CodexConnectionCard } from "@/codex-provider/contract.js";
+import "@/styles.css";
+
+const params = new URLSearchParams(location.search);
+document.documentElement.className =
+  params.get("theme") === "light" ? "light theme-zai-light" : "dark theme-zai-dark";
+const states = new Map<string, CodexConnectionStatus>();
+let starts = 0;
+const device = {
+  verificationUrl: "https://auth.openai.com/codex/device",
+  userCode: "ABCD-EFGH",
+  expiresAt: Date.now() + 900000,
+};
+const service: IServiceAccessor["codexProviderService"] = {
+  status: async (id) => states.get(id) ?? { connected: false, loginAvailable: true },
+  start: async () => ({
+    flowId: "browser-fixture",
+    authorizeUrl: "https://auth.openai.com/api/accounts/authorize?fixture=true",
+  }),
+  startDevice: async (id) => {
+    starts++;
+    document.getElementById("starts")!.textContent = String(starts);
+    states.set(id, {
+      connected: false,
+      loginAvailable: true,
+      flow: { id: "device-fixture", state: "waiting", device },
+    });
+    return { flowId: "device-fixture", ...device };
+  },
+  cancel: async (id) => {
+    states.set(id, {
+      connected: false,
+      loginAvailable: true,
+      flow: { id: "device-fixture", state: "cancelled" },
+    });
+  },
+  disconnect: async (id) => {
+    states.delete(id);
+  },
+};
+const platform = {
+  canOpenLocalFiles: params.get("mobile") !== "true",
+  openExternal: (url: string) => {
+    document.getElementById("opened")!.textContent = url;
+  },
+} as unknown as IPlatformService;
+function Fixture() {
+  const [id, setId] = useState("first");
+  return (
+    <main className="min-h-screen bg-background p-4 text-foreground">
+      <button onClick={() => setId(id === "first" ? "second" : "first")}>Switch provider</button>
+      <CodexConnectionCard providerId={id} />
+      <output id="starts" data-testid="starts">
+        0
+      </output>
+      <output id="opened" data-testid="opened" className="break-all" />
+    </main>
+  );
+}
+createRoot(document.getElementById("root")!).render(
+  <ServiceProvider services={{ codexProviderService: service } as IServiceAccessor}>
+    <PlatformProvider platform={platform}>
+      <ZCodeIntlProvider initialLocale={params.get("locale") === "zh-CN" ? "zh-CN" : "en-US"}>
+        <Fixture />
+      </ZCodeIntlProvider>
+    </PlatformProvider>
+  </ServiceProvider>,
+);
diff --git a/packages/ui/test/browser/manual-review/pending/codex-device.test.mjs b/packages/ui/test/browser/manual-review/pending/codex-device.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..41f3802cad6b17ab9ef180311f3c502143005abe
--- /dev/null
+++ b/packages/ui/test/browser/manual-review/pending/codex-device.test.mjs
@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { createServer } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { chromium } from "playwright-core";
+
+const root = fileURLToPath(new URL("../../../../../../", import.meta.url));
+const entry = "/packages/ui/test/browser/manual-review/pending/codex-device.fixture.tsx";
+let server, browser, origin;
+before(async () => {
+  server = await createServer({
+    root,
+    configFile: false,
+    plugins: [
+      react(),
+      tailwindcss(),
+      {
+        name: "codex-device-fixture",
+        configureServer(vite) {
+          vite.middlewares.use(async (req, res, next) => {
+            if (!req.url?.startsWith("/fixture?")) return next();
+            res.setHeader("Content-Type", "text/html");
+            res.end(
+              await vite.transformIndexHtml(
+                req.url,
+                `<html><head><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="root"></div><script type="module" src="${entry}"></script></body></html>`,
+              ),
+            );
+          });
+        },
+      },
+    ],
+    resolve: { alias: { "@": `${root}packages/ui/src` } },
+    optimizeDeps: { entries: [entry.slice(1)] },
+    server: { host: "127.0.0.1", port: 0 },
+  });
+  await server.listen();
+  origin = server.resolvedUrls.local[0];
+  browser = await chromium.launch(
+    process.env.CHROME_EXECUTABLE_PATH
+      ? { executablePath: process.env.CHROME_EXECUTABLE_PATH }
+      : { channel: "chrome" },
+  );
+});
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+for (const width of [320, 1200])
+  for (const locale of ["zh-CN", "en-US"])
+    for (const theme of ["light", "dark"]) {
+      test(`device code UI ${width}/${locale}/${theme}`, async () => {
+        const page = await browser.newPage({ viewport: { width, height: 800 } });
+        const errors = [];
+        page.on("pageerror", (error) => errors.push(String(error)));
+        try {
+          await page.goto(`${origin}fixture?${new URLSearchParams({ locale, theme })}`);
+          await page.getByTestId("codex-device-login").waitFor();
+          assert.equal(await page.getByTestId("starts").textContent(), "0");
+          assert.equal(await page.getByTestId("codex-login").count(), 1);
+          await page.getByTestId("codex-device-login").click();
+          await page.getByTestId("codex-device-code").waitFor();
+          assert.equal(await page.getByTestId("codex-device-code").textContent(), "ABCD-EFGH");
+          assert.equal(await page.getByTestId("starts").textContent(), "1");
+          assert.equal(await page.getByTestId("opened").textContent(), "");
+          await page.getByTestId("codex-device-open").click();
+          assert.equal(
+            await page.getByTestId("opened").textContent(),
+            "https://auth.openai.com/codex/device",
+          );
+          assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
+          await page.getByTestId("codex-cancel").click();
+          await page.getByTestId("codex-device-details").waitFor({ state: "hidden" });
+          await page.getByRole("button", { name: "Switch provider" }).click();
+          assert.equal(await page.getByTestId("codex-device-code").count(), 0);
+          assert.deepEqual(errors, []);
+        } finally {
+          await page.close();
+        }
+      });
+    }
+test("mobile Web does not acquire a Host device code", async () => {
+  const page = await browser.newPage();
+  try {
+    await page.goto(`${origin}fixture?mobile=true`);
+    await page.getByTestId("codex-device-login").waitFor();
+    assert.equal(await page.getByTestId("codex-device-login").isDisabled(), true);
+    assert.equal(await page.getByTestId("starts").textContent(), "0");
+  } finally {
+    await page.close();
+  }
+});
