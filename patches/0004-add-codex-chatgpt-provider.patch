+    },
+    assertProvider: async (id) => {
+      if (id !== "test-codex") throw new Error("not-codex");
+    },
+    withLock: async (_id, run) => run(),
+    fetch: async (url, init) => {
+      if (String(url).endsWith("jwks.json"))
+        return Response.json({ keys: [{ ...jwk, kid: "test", alg: "RS256" }] });
+      const body = new URLSearchParams(String(init?.body));
+      calls.push(body);
+      await gate;
+      const id = await new SignJWT({ nonce, sub: "test-subject" })
+        .setProtectedHeader({ alg: "RS256", kid: "test" })
+        .setIssuer("https://auth.openai.com")
+        .setAudience(clientID)
+        .setExpirationTime("1h")
+        .sign(pair.privateKey);
+      return Response.json({
+        access_token: "test-access",
+        refresh_token: "test-refresh",
+        id_token: id,
+        expires_in: 3600,
+        scope,
+      });
+    },
+  });
+  services.push(service);
+  return {
+    service,
+    values,
+    calls,
+    async start() {
+      const result = await service.start("test-codex");
+      const url = new URL(result.authorizeUrl);
+      nonce = url.searchParams.get("nonce")!;
+      return { ...result, url };
+    },
+    setScope(value: string) {
+      scope = value;
+    },
+    setAudience(value: string) {
+      clientID = value;
+    },
+    holdTokens(value: Promise<void>) {
+      gate = value;
+    },
+    callback(url: URL, params: Record<string, string> = {}) {
+      const callback = new URL(url.searchParams.get("redirect_uri")!);
+      callback.search = new URLSearchParams({
+        state: url.searchParams.get("state")!,
+        code: "test-code",
+        client_id: "issued-test-client",
+        ...params,
+      }).toString();
+      return fetch(callback);
+    },
+  };
+}
+
+describe("Codex token-sharing OAuth", () => {
+  it("does not start loopback authorization on non-local Hosts", async () => {
+    const f = await fixture(false);
+    await expect(f.start()).rejects.toThrow("codex-local-desktop-required");
+    expect(f.values.size).toBe(0);
+  });
+  it("registers a ZCode client with PKCE, state, nonce and the exact resource", async () => {
+    const f = await fixture();
+    const { url } = await f.start();
+    expect(url.origin + url.pathname).toBe("https://auth.openai.com/api/accounts/authorize");
+    expect(url.searchParams.get("client_id")).toBe("dynamic_agent_client");
+    expect(url.searchParams.get("agent_name_hint")).toBe("ZCode");
+    expect(url.searchParams.get("resource")).toBe("https://api.openai.com/v1");
+    expect(url.searchParams.get("code_challenge_method")).toBe("S256");
+    expect(url.searchParams.get("code_challenge")).toHaveLength(43);
+    expect(url.searchParams.get("state")).not.toBe(url.searchParams.get("nonce"));
+    expect(new URL(url.searchParams.get("redirect_uri")!).hostname).toBe("127.0.0.1");
+  });
+
+  it("verifies the ID token before storing tokens and reuses the issued client", async () => {
+    const f = await fixture();
+    const { url } = await f.start();
+    expect((await f.callback(url)).status).toBe(200);
+    expect((await f.service.status("test-codex")).connected).toBe(true);
+    expect(f.calls[0]!.get("code_verifier")).toBeTruthy();
+    expect(f.calls[0]!.get("resource")).toBe("https://api.openai.com/v1");
+    expect(await f.service.resolve("test-codex", "session-test")).toMatchObject({
+      apiKey: "test-access",
+      headers: { "session-id": "session-test", "thread-id": "session-test" },
+    });
+    expect(JSON.stringify(await f.service.status("test-codex"))).not.toContain("test-access");
+    const next = await f.start();
+    expect(next.url.searchParams.get("client_id")).toBe("issued-test-client");
+    expect(next.url.searchParams.has("agent_name_hint")).toBe(false);
+  });
+
+  it("does not exchange a code or accept an error with the wrong state", async () => {
+    const f = await fixture();
+    const { url } = await f.start();
+    expect((await f.callback(url, { state: "wrong", error: "access_denied" })).status).toBe(400);
+    expect(f.calls).toHaveLength(0);
+    expect((await f.service.status("test-codex")).connected).toBe(false);
+    expect((await f.callback(url)).status).toBe(200);
+  });
+
+  it.each(["missing-scope", "invalid-audience"])(
+    "rejects %s without saving tokens",
+    async (failure) => {
+      const f = await fixture();
+      const { url } = await f.start();
+      if (failure === "missing-scope") f.setScope("openid");
+      else f.setAudience("different-client");
+      expect((await f.callback(url)).status).toBe(400);
+      expect((await f.service.status("test-codex")).connected).toBe(false);
+      expect([...f.values.values()].some((value) => value.includes("test-access"))).toBe(false);
+    },
+  );
+
+  it("cancels the listener and disconnects without losing client registration", async () => {
+    const f = await fixture();
+    const first = await f.start();
+    await f.service.cancel("test-codex", first.flowId);
+    expect((await f.service.status("test-codex")).flow?.state).toBe("cancelled");
+    const next = await f.start();
+    await f.callback(next.url);
+    await f.service.disconnect("test-codex");
+    await expect(f.service.resolve("test-codex", "session-test")).rejects.toThrow(
+      "codex-login-required",
+    );
+    expect((await f.start()).url.searchParams.get("client_id")).toBe("issued-test-client");
+  });
+
+  it("refuses to resolve another provider", async () => {
+    const f = await fixture();
+    await expect(f.service.resolve("other-provider", "session-test")).rejects.toThrow("not-codex");
+  });
+
+  it("forgets tokens and client identity before a deleted provider ID is reused", async () => {
+    const f = await fixture();
+    await f.callback((await f.start()).url);
+    await f.service.forget("test-codex");
+    expect(f.values.size).toBe(0);
+    expect((await f.start()).url.searchParams.get("client_id")).toBe("dynamic_agent_client");
+  });
+
+  it("serializes concurrent refreshes and includes the registered client and resource", async () => {
+    const f = await fixture();
+    await f.callback((await f.start()).url);
+    for (const [key, value] of f.values) {
+      const record = JSON.parse(value);
+      if (record.tokens) {
+        record.tokens.expires = 0;
+        f.values.set(key, JSON.stringify(record));
+      }
+    }
+    await Promise.all([
+      f.service.resolve("test-codex", "s1"),
+      f.service.resolve("test-codex", "s2"),
+    ]);
+    expect(f.calls).toHaveLength(2);
+    expect(f.calls[1]!.get("grant_type")).toBe("refresh_token");
+    expect(f.calls[1]!.get("client_id")).toBe("issued-test-client");
+    expect(f.calls[1]!.get("resource")).toBe("https://api.openai.com/v1");
+  });
+
+  it("cannot save a late token exchange after cancellation", async () => {
+    const f = await fixture();
+    const attempt = await f.start();
+    let release!: () => void;
+    f.holdTokens(
+      new Promise<void>((resolve) => {
+        release = resolve;
+      }),
+    );
+    const response = f.callback(attempt.url);
+    await vi.waitFor(() => expect(f.calls).toHaveLength(1));
+    await f.service.cancel("test-codex", attempt.flowId);
+    release();
+    expect((await response).status).toBe(400);
+    expect((await f.service.status("test-codex")).connected).toBe(false);
+    expect([...f.values.values()].some((value) => value.includes("test-access"))).toBe(false);
+  });
+});
